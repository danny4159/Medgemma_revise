{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "approach_status",
    "approach_note",
    "valid_experiment",
    "reusable_code",
    "code_assets",
    "failure_scope",
    "goal_progress",
    "blocking_issues",
    "reuse_issues",
    "deferred_issues",
    "limitation_updates",
    "commit_worthy",
    "commit_message",
    "one_line_summary",
    "next_task",
    "next_plan_tier",
    "reason",
    "review_markdown",
    "paper_recommendation",
    "milestone"
  ],
  "properties": {
    "limitation_updates": {
      "type": "array",
      "description": "이번 결과로 갱신할 한계 주장. 변경 없으면 빈 배열. 과거 주장은 같은 id로 정정",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "claim", "status", "evidence", "usage_checks", "remaining_questions"],
        "properties": {
          "id": {"type": "string", "description": "영문 소문자·숫자·하이픈, 최대 60자"},
          "claim": {"type": "string", "description": "조건·범위를 명시한 한계 주장"},
          "status": {"type": "string", "enum": ["candidate", "observed", "validated", "rejected"]},
          "evidence": {"type": "array", "items": {"type": "string"}, "description": "실제 결과 파일·수치·독립 평가 범위 및 문헌 출처"},
          "usage_checks": {"type": "array", "items": {"type": "string"}, "description": "공식 사용법·prompt·전처리·출력 길이·parser·정답·metric 검증 근거"},
          "remaining_questions": {"type": "array", "items": {"type": "string"}, "description": "남은 원인 가설·불확실성·후속 검증"}
        }
      }
    },
    "valid_experiment": {"type": "boolean", "description": "해석 가능한 가설 검증을 실제 완료했는지. 준비·코드 검사·실행 무효는 false"},
    "reusable_code": {"type": "boolean", "description": "전체 코드 스냅샷을 다음 접근법의 기반으로 재사용 승인하는지"},
    "code_assets": {
      "type": "array", "description": "리뷰 대상 commit.json의 SHA에 있는 모듈별 재사용 판정. 전체 실패여도 유용한 모듈은 따로 승인",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["paths", "status", "reason", "checks"],
        "properties": {
          "paths": {"type": "array", "items": {"type": "string"}, "description": "research/ 기준 개별 소스 파일. 의존 파일 포함"},
          "status": {"type": "string", "enum": ["approved", "needs_fix", "rejected"]},
          "reason": {"type": "string", "description": "승인 범위·미해결 결함·사용 조건"},
          "checks": {"type": "array", "items": {"type": "string"}, "description": "실제로 수행한 관련 테스트·결과 파일 근거. 미검증이면 빈 배열, approved는 근거 필수"}
        }
      }
    },
    "failure_scope": {"type": "string", "description": "실패·불확정이 적용되는 데이터·설계·학습 조건. 해당 없으면 빈 문자열"},
    "goal_progress": {"type": "string", "description": "실행 유효성·성능 개선·가설 지지·신규 기여 가능성을 구분한 목표 진전과 미검증 범위. 성능 개선은 자동으로 신규 기여가 아님"},
    "blocking_issues": {"type": "array", "items": {"type": "string"}, "description": "현재 결론을 무효화하는 문제"},
    "reuse_issues": {"type": "array", "items": {"type": "string"}, "description": "다음 재사용 전에 해결할 문제"},
    "deferred_issues": {"type": "array", "items": {"type": "string"}, "description": "추후 견고성 개선. 현재 결과 무효 사유가 아님"},
    "verdict": {
      "type": "string",
      "enum": [
        "CONTINUE",
        "DONE",
        "NEEDS_HUMAN"
      ]
    },
    "approach_status": {
      "type": "string",
      "enum": [
        "success",
        "improve",
        "inconclusive",
        "execution_failed",
        "abandon"
      ],
      "description": "이번 접근법의 판정"
    },
    "approach_note": {
      "type": "string",
      "description": "approach_status 근거 한 줄. improve면 무엇을 개선할지, abandon이면 왜 포기하는지"
    },
    "commit_worthy": {
      "type": "boolean",
      "description": "호환용 필드: 검증된 기준점으로 가치가 있는지. false여도 코드 체크포인트는 이미 보존됨"
    },
    "commit_message": {
      "type": "string",
      "description": "호환용 필드: 검증된 기준점 설명. 실제 체크포인트 생성 여부를 제어하지 않음"
    },
    "one_line_summary": {
      "type": "string",
      "description": "이번 반복 결과 한 줄 요약"
    },
    "next_task": {
      "type": "string",
      "description": "다음 반복의 계속·진단·전환 권고와 이유·판단 조건. success/improve여도 자동 연장 아님. DONE이면 빈 문자열"
    },
    "next_plan_tier": {
      "type": "string",
      "enum": [
        "deep",
        "normal",
        "light"
      ],
      "description": "다음 계획에 필요한 사고 수준"
    },
    "reason": {
      "type": "string",
      "description": "verdict를 고른 이유. NEEDS_HUMAN이면 사람에게 묻는 질문"
    },
    "review_markdown": {
      "type": "string",
      "description": "전체 리뷰 (마크다운)"
    },
    "paper_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "description": "실제 실험에서 더 깊이 탐구할 유망성이 확인된 방향의 논문 최대 1편. 가설만 있거나 불확정 결과만 있으면 추천하지 않는다. 문서 인용 여부가 아니라 PAPERS.md의 사용자 추천 이력으로 중복을 판단한다. 추천하지 않으면 recommend=false, 나머지는 빈 문자열",
      "required": [
        "recommend",
        "title",
        "authors_year",
        "url",
        "current_work",
        "why",
        "what_to_read"
      ],
      "properties": {
        "recommend": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "authors_year": {
          "type": "string",
          "description": "예: Kim et al., 2025"
        },
        "url": {
          "type": "string",
          "description": "웹 검색으로 확인한 arXiv/DOI/학회 페이지 링크"
        },
        "current_work": {
          "type": "string",
          "description": "검증한 질문과 실제 결과: 비교군·핵심 수치·표본·근거 파일. PAPERS.md와 Telegram에 함께 표시된다"
        },
        "why": {
          "type": "string",
          "description": "어떤 실제 근거로 더 파볼 만한지, 논문이 다음 판단에 주는 도움과 아직 미검증인 범위"
        },
        "what_to_read": {
          "type": "string",
          "description": "읽어볼 섹션/그림/방법과 그 안에서 볼 점"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "description": "연구 목표에 의미 있는 진전이 있을 때만 is_milestone=true. 아니면 false와 빈 문자열",
      "required": [
        "is_milestone",
        "title",
        "story"
      ],
      "properties": {
        "is_milestone": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "description": "마일스톤 제목 한 줄"
        },
        "story": {
          "type": "string",
          "description": "고민 → 시도(실패한 대안 포함) → 개발 → 결과(수치) → 의미. 마크다운 5~12줄"
        }
      }
    }
  }
}
