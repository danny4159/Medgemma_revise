{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "approach_status",
    "approach_note",
    "commit_worthy",
    "commit_message",
    "one_line_summary",
    "next_task",
    "next_plan_tier",
    "reason",
    "review_markdown",
    "paper_recommendation",
    "milestone"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "CONTINUE",
        "DONE",
        "NEEDS_HUMAN"
      ]
    },
    "approach_status": {
      "type": "string",
      "enum": [
        "success",
        "improve",
        "abandon"
      ],
      "description": "이번 접근법의 판정"
    },
    "approach_note": {
      "type": "string",
      "description": "approach_status 근거 한 줄. improve면 무엇을 개선할지, abandon이면 왜 포기하는지"
    },
    "commit_worthy": {
      "type": "boolean",
      "description": "이번 구현을 git에 커밋으로 남길 가치가 있는지"
    },
    "commit_message": {
      "type": "string",
      "description": "커밋 메시지 한 줄 (영문 또는 한국어). commit_worthy가 false면 빈 문자열"
    },
    "one_line_summary": {
      "type": "string",
      "description": "이번 반복 결과 한 줄 요약"
    },
    "next_task": {
      "type": "string",
      "description": "다음 반복에서 할 과제. DONE이면 빈 문자열"
    },
    "next_plan_tier": {
      "type": "string",
      "enum": [
        "deep",
        "normal",
        "light"
      ],
      "description": "다음 계획에 필요한 사고 수준"
    },
    "reason": {
      "type": "string",
      "description": "verdict를 고른 이유. NEEDS_HUMAN이면 사람에게 묻는 질문"
    },
    "review_markdown": {
      "type": "string",
      "description": "전체 리뷰 (마크다운)"
    },
    "paper_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "description": "사용자가 꼭 읽어야 할 논문 1편. 추천하지 않으면 recommend=false, 나머지는 빈 문자열",
      "required": [
        "recommend",
        "title",
        "authors_year",
        "url",
        "current_work",
        "why",
        "what_to_read"
      ],
      "properties": {
        "recommend": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "authors_year": {
          "type": "string",
          "description": "예: Kim et al., 2025"
        },
        "url": {
          "type": "string",
          "description": "웹 검색으로 확인한 arXiv/DOI/학회 페이지 링크"
        },
        "current_work": {
          "type": "string",
          "description": "지금 무엇을 하고 있고 어떤 결과가 나왔는지 (사용자가 맥락을 잡을 수 있게)"
        },
        "why": {
          "type": "string",
          "description": "왜 지금 이 논문을 읽어야 하는지, 우리 결과와 어떻게 연결되는지"
        },
        "what_to_read": {
          "type": "string",
          "description": "읽어볼 섹션/그림/방법과 그 안에서 볼 점"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "description": "연구 목표에 의미 있는 진전이 있을 때만 is_milestone=true. 아니면 false와 빈 문자열",
      "required": [
        "is_milestone",
        "title",
        "story"
      ],
      "properties": {
        "is_milestone": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "description": "마일스톤 제목 한 줄"
        },
        "story": {
          "type": "string",
          "description": "고민 → 시도(실패한 대안 포함) → 개발 → 결과(수치) → 의미. 마크다운 5~12줄"
        }
      }
    }
  }
}
