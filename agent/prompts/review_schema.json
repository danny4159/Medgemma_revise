{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "approach_status",
    "approach_note",
    "one_line_summary",
    "next_task",
    "next_plan_tier",
    "reason",
    "review_markdown"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "CONTINUE",
        "DONE",
        "NEEDS_HUMAN"
      ]
    },
    "approach_status": {
      "type": "string",
      "enum": [
        "success",
        "improve",
        "abandon"
      ],
      "description": "이번 접근법의 판정"
    },
    "approach_note": {
      "type": "string",
      "description": "approach_status 근거 한 줄. improve면 무엇을 개선할지, abandon이면 왜 포기하는지"
    },
    "one_line_summary": {
      "type": "string",
      "description": "이번 반복 결과 한 줄 요약"
    },
    "next_task": {
      "type": "string",
      "description": "다음 반복에서 할 과제. DONE이면 빈 문자열"
    },
    "next_plan_tier": {
      "type": "string",
      "enum": [
        "deep",
        "normal",
        "light"
      ],
      "description": "다음 계획에 필요한 사고 수준"
    },
    "reason": {
      "type": "string",
      "description": "verdict를 고른 이유. NEEDS_HUMAN이면 사람에게 묻는 질문"
    },
    "review_markdown": {
      "type": "string",
      "description": "전체 리뷰 (마크다운)"
    }
  }
}
