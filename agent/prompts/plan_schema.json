{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "next_action",
    "research_notes",
    "open_questions",
    "plan_summary",
    "approach",
    "approach_id",
    "alternatives",
    "decision",
    "decision_reason",
    "claude_tier",
    "tier_reason",
    "review_mode",
    "review_reason",
    "plan_markdown"
  ],
  "properties": {
    "next_action": {
      "type": "string",
      "enum": [
        "think_more",
        "implement"
      ],
      "description": "더 조사·사고할지, 구현으로 넘어갈지"
    },
    "research_notes": {
      "type": "string",
      "description": "이번 라운드에서 조사·사고한 내용 (근거, 링크, 수치). 마크다운"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "think_more면 다음 라운드에서 답할 구체 질문 2~5개. implement면 빈 배열"
    },
    "plan_summary": {
      "type": "string",
      "description": "이번 계획 한 줄 요약: 무엇을 왜 하는지"
    },
    "approach": {
      "type": "string",
      "description": "이번 반복에서 시도하는 접근법의 짧은 이름. 같은 접근법을 이어가면 이전과 똑같은 이름을 쓴다"
    },
    "approach_id": {
      "type": "string",
      "description": "접근법의 영문 id (소문자, 숫자, 하이픈, 30자 이내). git 브랜치 이름이 된다. 같은 접근법이면 이전과 똑같은 id"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "현재 풀려는 문제에 대한 대안 순위. '이름: 한 줄 설명' 형식. 첫 번째가 이번 approach"
    },
    "decision": {
      "type": "string",
      "enum": [
        "proceed",
        "ask_human"
      ]
    },
    "decision_reason": {
      "type": "string",
      "description": "proceed면 1순위를 고른 근거, ask_human이면 사람에게 묻는 질문"
    },
    "claude_tier": {
      "type": "string",
      "enum": [
        "creative",
        "heavy",
        "light"
      ]
    },
    "tier_reason": {
      "type": "string",
      "description": "claude_tier를 고른 이유 한 줄"
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "full",
        "skip"
      ],
      "description": "Claude 작업 후 GPT 리뷰를 할지"
    },
    "review_reason": {
      "type": "string",
      "description": "review_mode를 고른 이유 한 줄"
    },
    "plan_markdown": {
      "type": "string",
      "description": "전체 연구 계획 (마크다운)"
    }
  }
}
