+++ b/rsna_diag/prompts.py
@@ -0,0 +1,45 @@
+"""세 prompt의 원문 고정 (iter_009 계획).
+
+- official_long: 보존한 공식 notebook 셀 11의 f-string을 그대로 평가하여 object_name만 치환한다.
+- concise: 계획서에 고정된 원문.
+- legacy_detect: legacy/scripts/04_official_format/rerun_localization_official.py의 DETECT 문자열을 ast로 추출하고 동일 target을 치환한다.
+"""
+import ast
+import hashlib
+import json
+import re
+
+TARGET = "pulmonary opacity suspicious for pneumonia"
+NOTEBOOK = "results/iter_009/source/official/cxr_anatomy_localization_with_hugging_face.ipynb"
+LEGACY_SCRIPT = "/SSD1_1TB/home/milab/daniel/08_medgemma/legacy/scripts/04_official_format/rerun_localization_official.py"
+
+CONCISE = ('Localize all pulmonary opacities suspicious for pneumonia in this chest radiograph. Return only a JSON list. '
+           'Each entry must contain "box_2d": [y_min, x_min, y_max, x_max] and a nonempty "label" string. '
+           'Coordinates must be between 0 and 1000 relative to the entire square-padded image, with y before x. '
+           'Return [] if no such opacity is visible.')
+
+
+def official_long(target=TARGET, notebook=NOTEBOOK):
+    nb = json.load(open(notebook))
+    for c in nb["cells"]:
+        src = "".join(c["source"])
+        if c["cell_type"] == "code" and 'prompt = f"""' in src:
+            m = re.search(r'prompt = f"""(.*?)"""', src, re.S)
+            return eval('f"""' + m.group(1) + '"""', {"object_name": target})
+    raise RuntimeError("official prompt cell not found")
+
+
+def legacy_detect(target=TARGET, script=LEGACY_SCRIPT):
+    tree = ast.parse(open(script).read())
+    for n in tree.body:
+        if isinstance(n, ast.Assign) and getattr(n.targets[0], "id", None) == "DETECT":
+            return ast.literal_eval(n.value).format(obj=target)
+    raise RuntimeError("DETECT not found")
+
+
+def all_prompts():
+    return {"official_long": official_long(), "concise": CONCISE, "legacy_detect": legacy_detect()}
+
+
+def digest(text):
+    return hashlib.sha256(text.encode()).hexdigest()
diff --git a/rsna_diag/qa_data.py b/rsna_diag/qa_data.py
new file mode 100644
index 0000000..d87ce2f
--- /dev/null
+++ b/rsna_diag/qa_data.py
@@ -0,0 +1,139 @@
+"""iter_015: 원본 Calculated label audit, D36/E180/E600/P60/P180 고정 split, 일반 inference manifest(정답 없음)와 별도 label 파일.
+
+사용: python -m rsna_diag.qa_data --out results/iter_015/manifests
+- 순서는 sha256(scope-v1|20260927|category|patient). D36은 validation, E는 confirm에서만 뽑는다. reserve는 읽지 않는다.
+- P180 = 각 category 앞 60명 = E180 전체 (계획의 'E600에서 category별 60명'을 순서 접두어로 구현하면 E180과 같은 집합이다).
+"""
+import argparse
+import hashlib
+import json
+import os
+
+from . import qa_spec as S, rsna_data as R
+
+RAW = "results/iter_009/source/raw"
+ANN = f"{RAW}/pneumonia-challenge-annotations-adjudicated-kaggle_2018.json"
+SEED_TAG = "scope-v1|20260927"
+GT = "results/iter_010/manifests/gt_manifest.json"
+MAN = "results/iter_010/manifests/infer_manifest.jsonl"
+SIZES = {"D36": ("validation", 12), "E180": ("confirm", 60), "E600": ("confirm", 200)}
+
+
+def order_key(category, patient):
+    return hashlib.sha256(f"{SEED_TAG}|{category}|{patient}".encode()).hexdigest()
+
+
+def sha_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def audit(gt):
+    """gt_manifest의 validation/confirm 항목을 원본 annotation의 Calculated label·bbox와 SOP 단위로 대조한다. returns (report, problems)."""
+    prov = json.load(open(ANN + ".provenance.json"))
+    cur = sha_file(ANN)
+    _, ann = R.load_annotations(ANN)
+    probs, n, per_cat = [], 0, {}
+    for i, g in gt.items():
+        if g["split"] not in ("validation", "confirm"):
+            continue
+        n += 1
+        a = ann.get(g["sop"])
+        if a is None:
+            probs.append((i, "sop_not_in_annotations"))
+            continue
+        cats = sorted(a["cats"])
+        if cats != [g["category"]]:
+            probs.append((i, f"category {g['category']} != Calculated {cats}"))
+        if a["exclude"]:
+            probs.append((i, "exclude_label"))
+        if len(a["boxes"]) != len(g["boxes"]):
+            probs.append((i, f"n_boxes {len(g['boxes'])} != {len(a['boxes'])}"))
+        if g["category"] != "opacity" and (a["boxes"] or g["boxes"]):
+            probs.append((i, "negative_with_box"))
+        if g["category"] == "opacity" and not g["boxes"]:
+            probs.append((i, "opacity_without_box"))
+        k = (g["split"], g["category"])
+        per_cat[f"{k[0]}/{k[1]}"] = per_cat.get(f"{k[0]}/{k[1]}", 0) + 1
+    return {"annotation_sha256": cur, "provenance_sha256": prov.get("sha256"), "annotation_hash_match": cur == prov.get("sha256"),
+            "n_checked": n, "n_problems": len(probs), "per_split_category": per_cat,
+            "note": "NoOpacity/NotNormal(Calculated 'No Lung Opacity / Not Normal')과 Normal은 별도 category로 유지된다. NIH label로 정답을 대체하지 않는다."}, probs
+
+
+def ranked(gt, split):
+    by = {c: [] for c in S.CATEGORIES}
+    for i, g in gt.items():
+        if g["split"] == split:
+            by[g["category"]].append(i)
+    return {c: sorted(v, key=lambda i: order_key(c, gt[i]["patient"])) for c, v in by.items()}
+
+
+def build(gt, man):
+    val, conf = ranked(gt, "validation"), ranked(gt, "confirm")
+    sets = {}
+    for name, (split, n) in SIZES.items():
+        pool = val if split == "validation" else conf
+        sets[name] = {c: pool[c][:n] for c in S.CATEGORIES}
+    sets["P60"] = {c: sets["E180"][c][:20] for c in S.CATEGORIES}
+    sets["P180"] = {c: sets["E600"][c][:60] for c in S.CATEGORIES}
+    sets["D12"] = {c: sets["D36"][c][:4] for c in S.CATEGORIES}
+    return sets
+
+
+def checks(sets, gt, man):
+    """중복·교집합·pixel hash 충돌 검사. 문제가 있으면 예외."""
+    flat = lambda s: [i for c in S.CATEGORIES for i in sets[s][c]]
+    out = {}
+    for s in sets:
+        ids = flat(s)
+        assert len(ids) == len(set(ids)), f"duplicate ids in {s}"
+        out[s] = len(ids)
+    assert set(flat("E180")) <= set(flat("E600")) and set(flat("P60")) <= set(flat("P180")) and set(flat("P60")) <= set(flat("E180"))
+    assert set(flat("P180")) == set(flat("E180"))
+    assert not set(flat("D36")) & set(flat("E600")), "D36/E overlap"
+    mid = {m["id"]: m for m in man}
+    pd, pe = {gt[i]["patient"] for i in flat("D36")}, {gt[i]["patient"] for i in flat("E600")}
+    assert not pd & pe, "patient overlap D36/E600"
+    ph = {mid[i]["pixel_sha256"] for i in flat("D36")} & {mid[i]["pixel_sha256"] for i in flat("E600")}
+    assert not ph, "pixel hash overlap D36/E600"
+    assert len({mid[i]["pixel_sha256"] for i in flat("E600")}) == len(flat("E600")), "duplicate pixel within E600"
+    assert len({gt[i]["patient"] for i in flat("E600")}) == len(flat("E600")), "duplicate patient within E600"
+    for s in ("D36", "E180", "E600"):
+        for c in S.CATEGORIES:
+            assert all(gt[i]["category"] == c and gt[i]["split"] == SIZES[s][0] for i in sets[s][c]), f"{s}/{c} mapping"
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    gt = json.load(open(GT))
+    man = [json.loads(ln) for ln in open(MAN) if ln.strip()]
+    rep, probs = audit(gt)
+    rep["problems_head"] = probs[:10]
+    sets = build(gt, man)
+    rep["set_sizes"] = checks(sets, gt, man)
+    rep["order"] = f"sha256({SEED_TAG}|category|patient)"
+    json.dump(rep, open(f"{a.out}/audit.json", "w"), indent=1)
+    if probs or not rep["annotation_hash_match"]:
+        raise SystemExit(f"audit failed: {len(probs)} problems; see {a.out}/audit.json")
+    json.dump(sets, open(f"{a.out}/sets.json", "w"), indent=1)
+    # 일반 inference manifest: 정답·category 없음. label 파일은 평가에서만 읽는다.
+    mid = {m["id"]: m for m in man}
+    used = sorted({i for s in ("D36", "E600") for c in S.CATEGORIES for i in sets[s][c]})
+    with open(f"{a.out}/infer_manifest.jsonl", "w") as f:
+        for i in used:
+            m = mid[i]
+            f.write(json.dumps({k: m[k] for k in ("id", "split", "image", "file_sha256", "pixel_sha256")}) + "\n")
+    json.dump({i: {"category": gt[i]["category"], "patient": gt[i]["patient"], "boxes": gt[i]["boxes"]} for i in used},
+              open(f"{a.out}/labels.json", "w"))
+    print(json.dumps(rep["set_sizes"]), "audit ok")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/qa_eval.py b/rsna_diag/qa_eval.py
new file mode 100644
index 0000000..5c04e69
--- /dev/null
+++ b/rsna_diag/qa_eval.py
@@ -0,0 +1,237 @@
+"""iter_015 QA/target-scope 평가. 점수는 검증을 통과한(완료·요청 집합 일치) stage에서만 계산한다 (qa_run.verify_job).
+
+- 답 표: (checkpoint, condition, fmt, id) -> {target: (status, answer)}. invalid/truncated는 전체 분모에서 실패로 센다.
+- S_scope: 환자에서 두 target을 모두 맞힘. category별 비율 후 3 category 균등 평균.
+- paired bootstrap: category 내 환자를 재표집하고 한 환자의 모든 질문·형식·조건을 함께 유지한다 (10,000회, seed 20260927).
+사용: python -m rsna_diag.qa_eval d36 --out results/iter_015/d36
+      python -m rsna_diag.qa_eval e --set E180 ... (analysis는 아래 함수 사용)
+"""
+import argparse
+import json
+import os
+
+import numpy as np
+
+from . import metrics as M, parse as PA, qa_gen, qa_requests as Q, qa_run, qa_spec as S, sft_eval
+
+OUT = Q.OUT
+BOOT_N, BOOT_SEED = 10000, 20260927
+
+
+def load_stage(stage, ckpt, protocol, gen_root="gen"):
+    """완료된 stage/ckpt를 검증하고 record를 반환한다. 미완료·불일치면 예외."""
+    from . import qa_protocol
+    pdig = qa_protocol.verify(protocol)
+    rp, rows, cfg = qa_run.load_job(stage, ckpt, protocol)
+    tab = json.load(open(f"{OUT}/manifests/checkpoints.json"))
+    d = f"{OUT}/{gen_root}/{stage}__{ckpt}"
+    if not os.path.exists(f"{d}/completion.json"):
+        raise qa_gen.QAError(f"completion.json missing in {d}")
+    done, missing = qa_run.verify_job(d, rows, cfg, pdig, tab[ckpt]["dir"])
+    if missing:
+        raise qa_gen.QAError(f"{len(missing)} requests missing in {d}")
+    by = {r["request_id"]: r for r in rows}
+    return [(by[k], v) for k, v in done.items()]
+
+
+def answer_table(pairs):
+    """pairs: [(row, record)] -> {(ckpt, cond, fmt, id): {target: (status, answer, ended_eos, n_out)}}"""
+    t = {}
+    for row, rec in pairs:
+        if row["target"] not in S.TARGETS:
+            continue
+        st, ans = S.parse_answer(row["fmt"], rec["suffix_text_raw"], rec["ended_eos"])
+        t.setdefault((row["checkpoint"], row["condition"], row["fmt"], row["id"]), {})[row["target"]] = (st, ans, rec["ended_eos"], rec["n_output_tokens"])
+    return t
+
+
+def patient_correct(tab, key, cat):
+    """(Q_O 정답, Q_A 정답, 둘 다 정답)  -- 요청 누락은 예외, invalid는 False."""
+    r = tab[key]
+    want = S.GT_PAIR[cat]
+    ok = {t: (r[t][0] == "valid" and r[t][1] == want[k]) for k, t in enumerate(S.TARGETS)}
+    return ok["O"], ok["A"], ok["O"] and ok["A"]
+
+
+def cat_ids(sets, name):
+    return {c: list(sets[name][c]) for c in S.CATEGORIES}
+
+
+def score_vectors(tab, ckpt, cond, fmt, ids_by_cat):
+    """{cat: array of 0/1 (both correct)}."""
+    return {c: np.array([patient_correct(tab, (ckpt, cond, fmt, i), c)[2] for i in ids], dtype=float) for c, ids in ids_by_cat.items()}
+
+
+def s_scope(vec):
+    per = {c: float(v.mean()) for c, v in vec.items()}
+    return float(np.mean(list(per.values()))), per
+
+
+def bootstrap_diff(vec_a, vec_b, n=BOOT_N, seed=BOOT_SEED, ci=0.95):
+    """S_scope(a)-S_scope(b) 및 category별 차이의 paired 환자 bootstrap. returns dict with point, ci, per-category."""
+    rng = np.random.default_rng(seed)
+    cats = list(vec_a)
+    diffs = {c: np.empty(n) for c in cats}
+    for c in cats:
+        m = len(vec_a[c])
+        idx = rng.integers(0, m, size=(n, m))
+        diffs[c] = vec_a[c][idx].mean(1) - vec_b[c][idx].mean(1)
+    tot = np.mean([diffs[c] for c in cats], axis=0)
+    lo, hi = (1 - ci) / 2 * 100, (1 + ci) / 2 * 100
+    f = lambda x, p0: {"point": float(p0), "ci": [float(np.percentile(x, lo)), float(np.percentile(x, hi))], "level": ci}
+    pa, pb = s_scope(vec_a)[0], s_scope(vec_b)[0]
+    return {"S_scope": f(tot, pa - pb), "per_category": {c: f(diffs[c], vec_a[c].mean() - vec_b[c].mean()) for c in cats}}
+
+
+def boot_ci(vec, n=BOOT_N, seed=BOOT_SEED, ci=0.95):
+    rng = np.random.default_rng(seed)
+    per = []
+    for c, v in vec.items():
+        idx = rng.integers(0, len(v), size=(n, len(v)))
+        per.append(v[idx].mean(1))
+    tot = np.mean(per, axis=0)
+    return [float(np.percentile(tot, (1 - ci) / 2 * 100)), float(np.percentile(tot, (1 + ci) / 2 * 100))]
+
+
+def format_stats(tab, ckpt, cond, fmt, ids):
+    """valid rate, EOS/truncation, 상태 분포 (target별)."""
+    out = {}
+    for t in S.TARGETS:
+        st = [tab[(ckpt, cond, fmt, i)][t][0] for i in ids]
+        out[t] = {"n": len(st), "valid": sum(s == "valid" for s in st), "valid_rate": sum(s == "valid" for s in st) / len(st),
+                  "truncated": sum(s == "truncated" for s in st),
+                  "status": {s: st.count(s) for s in sorted(set(st))}}
+    return out
+
+
+def balanced_accuracy(tab, ckpt, cond, fmt, target, gt_cat):
+    """target별 balanced accuracy (invalid=오답). 양성 정답: O=opacity만 yes, A=opacity+NoOpacity/NotNormal이 yes."""
+    k = S.TARGETS.index(target)
+    pos, neg = [], []
+    for i, c in gt_cat.items():
+        r = tab.get((ckpt, cond, fmt, i))
+        if r is None:
+            continue
+        ok = r[target][0] == "valid" and r[target][1] == S.GT_PAIR[c][k]
+        (pos if S.GT_PAIR[c][k] == "yes" else neg).append(ok)
+    return {"sensitivity": float(np.mean(pos)), "specificity": float(np.mean(neg)), "balanced_accuracy": float((np.mean(pos) + np.mean(neg)) / 2),
+            "n_pos": len(pos), "n_neg": len(neg)}
+
+
+def pair_confusion(tab, ckpt, cond, fmt, gt_cat):
+    """category별 (Q_O,Q_A) 답 쌍 분포. invalid는 'invalid'."""
+    out = {c: {} for c in S.CATEGORIES}
+    for i, c in gt_cat.items():
+        r = tab.get((ckpt, cond, fmt, i))
+        if r is None:
+            continue
+        k = tuple((r[t][1] if r[t][0] == "valid" else "invalid") for t in S.TARGETS)
+        out[c]["/".join(k)] = out[c].get("/".join(k), 0) + 1
+    return out
+
+
+def agreement(tab, ckpt, cond, ids):
+    """plain·json 두 형식에서 유효한 답이 일치하는 비율 (양쪽 모두 유효한 (환자,target)만)."""
+    n = k = nb = 0
+    for i in ids:
+        a, b = tab.get((ckpt, cond, "plain", i)), tab.get((ckpt, cond, "json", i))
+        if a is None or b is None:
+            continue
+        for t in S.TARGETS:
+            nb += 1
+            if a[t][0] == "valid" and b[t][0] == "valid":
+                n += 1
+                k += a[t][1] == b[t][1]
+    return {"n_both_valid": n, "agree": k, "rate": k / n if n else None, "n_pairs": nb}
+
+
+def constant_baselines(gt_cat_ids):
+    """category와 무관한 고정 답 쌍의 S_scope (질문 prior). gt_cat_ids: {cat: [ids]}."""
+    out = {}
+    for pair in [("yes", "yes"), ("yes", "no"), ("no", "yes"), ("no", "no")]:
+        per = {c: float(S.GT_PAIR[c] == pair) for c in S.CATEGORIES}
+        out["/".join(pair)] = {"S_scope": float(np.mean(list(per.values()))), "per_category": per}
+    return out
+
+
+def bbox_preds(ckpt, ids):
+    recs = Q.bbox_records(ckpt)
+    miss = [i for i in ids if i not in recs]
+    if miss:
+        raise KeyError(f"{ckpt} bbox missing for {len(miss)} ids e.g. {miss[:2]}")
+    return {i: PA.parse_response(recs[i]["suffix_text_raw"], recs[i]["ended_eos"]) for i in ids}
+
+
+def bbox_summary(ckpt, ids, labels):
+    gt = {i: {"category": labels[i]["category"], "boxes": labels[i]["boxes"]} for i in ids}
+    return sft_eval.summarize(bbox_preds(ckpt, ids), gt, ids)
+
+
+def detector_rule(ckpt, ids_by_cat):
+    """bbox+규칙: 유효 비어 있지 않은 bbox -> (yes,yes). 빈 유효 bbox -> Q_O=no, Q_A 판단 불가. invalid -> 실패.
+    S_scope(fail): 판단 불가·invalid를 실패로. coverage/covered accuracy 별도."""
+    allids = [i for v in ids_by_cat.values() for i in v]
+    pr = bbox_preds(ckpt, allids)
+    vec_fail, cov = {}, {}
+    for c, ids in ids_by_cat.items():
+        want = S.GT_PAIR[c]
+        ok, decided, correct_dec = [], 0, 0
+        qo = 0
+        for i in ids:
+            st = pr[i]["status"]
+            if st == "valid_nonempty":
+                pair = ("yes", "yes")
+            elif st == "valid_empty":
+                pair = ("no", None)
+            else:
+                pair = (None, None)
+            qo += pair[0] == want[0]
+            full = pair[0] == want[0] and pair[1] == want[1]
+            ok.append(full)
+            if pair[1] is not None:
+                decided += 1
+                correct_dec += full
+        vec_fail[c] = np.array(ok, dtype=float)
+        cov[c] = {"n": len(ids), "q_a_decided": decided, "coverage": decided / len(ids), "pair_correct_among_decided": (correct_dec / decided if decided else None),
+                  "q_o_accuracy": qo / len(ids)}
+    return {"S_scope_undecided_as_fail": s_scope(vec_fail)[0], "per_category_fail": {c: float(v.mean()) for c, v in vec_fail.items()},
+            "coverage": cov}, vec_fail
+
+
+def d36_format_gate(protocol, out):
+    """D36 형식 gate: 모든 (ckpt,target)에서 valid rate >= 0.95면 plain. plain 실패 & json 통과면 json. 둘 다 실패면 format_problem.
+    정답 정확도는 보지 않는다 (형식 준수만)."""
+    sets = json.load(open(f"{OUT}/manifests/sets.json"))
+    ids = [i for c in S.CATEGORIES for i in sets["D36"][c]]
+    tabs = {}
+    for fmt in ("plain", "json"):
+        for ck in ("M0", "B0", "C"):
+            tabs.update(answer_table(load_stage(f"d36_{fmt}", ck, protocol)))
+    fs = {fmt: {ck: format_stats(tabs, ck, "direct", fmt, ids) for ck in ("M0", "B0", "C")} for fmt in ("plain", "json")}
+    okf = {fmt: all(fs[fmt][ck][t]["valid_rate"] >= 0.95 for ck in fs[fmt] for t in S.TARGETS) for fmt in fs}
+    primary = "plain" if okf["plain"] else ("json" if okf["json"] else None)
+    d = {"format_stats": fs, "gate_pass": okf, "primary_format": primary,
+         "alternate_format": None if primary is None else ("json" if primary == "plain" else "plain"),
+         "rule": "valid rate >= 0.95 for every checkpoint x target; plain first; format compliance only, no accuracy used",
+         "n_patients": len(ids)}
+    json.dump(d, open(out, "w"), indent=1)
+    return d
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    g = sp.add_parser("d36")
+    g.add_argument("--protocol", required=True)
+    g.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if a.cmd == "d36":
+        d = d36_format_gate(a.protocol, a.out)
+        print(json.dumps({"gate_pass": d["gate_pass"], "primary_format": d["primary_format"]}))
+        for fmt in d["format_stats"]:
+            for ck, v in d["format_stats"][fmt].items():
+                print(fmt, ck, {t: (round(x["valid_rate"], 3), x["status"]) for t, x in v.items()})
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/qa_gen.py b/rsna_diag/qa_gen.py
new file mode 100644
index 0000000..0f99f3c
--- /dev/null
+++ b/rsna_diag/qa_gen.py
@@ -0,0 +1,195 @@
+"""iter_015 요청 행렬(qa_requests) 전용 생성 worker. generate.py의 모델 로더·adapter 로더·run_request(cap 래더 1000/2000/4000)를 재사용하고,
+요청 식별·재개 검증·claim만 request 단위로 새로 구현한다 (환자마다 prompt/evidence가 달라 전역 prompt 이름으로 식별할 수 없다).
+
+- 시작 시: qa_protocol.verify, 요청 파일이 protocol에 잠긴 파일과 같은지, 각 행의 request_id 재계산·config digest, 모든 영상의 현재 file/pixel hash.
+- adapter digest(tensor 재계산)가 모든 행의 adapter_digest와 같아야 한다 (base면 None).
+- 재개: 완료 record를 포함해 모든 worker 파일을 요청 행과 대조한다. 중복·잉여·id/prompt/adapter/config/protocol 불일치·입력 hash 변경·잘린 JSONL은 중단.
+  --repair-tail: 마지막 줄이 개행 없이 잘렸을 때만 그 줄을 *.partial로 옮기고 계속한다 (기록을 지우지 않는다).
+사용: CUDA_VISIBLE_DEVICES=<gpu> python -m rsna_diag.qa_gen --requests R --out-dir D --worker K --protocol P [--adapter DIR]
+"""
+import argparse
+import glob
+import json
+import os
+import sys
+import time
+
+from . import generate, qa_protocol, qa_requests as Q, queue_lock
+
+
+class QAError(RuntimeError):
+    pass
+
+
+def read_strict(path, repair_tail=False, tolerate_tail=False):
+    """JSONL을 읽는다. 잘린/깨진 줄은 QAError (repair_tail이면 개행 없는 마지막 줄만 격리)."""
+    if not os.path.exists(path):
+        return []
+    raw = open(path, "rb").read()
+    lines = raw.split(b"\n")
+    tail = lines[-1]
+    recs = []
+    body = lines[:-1]
+    if tail.strip() and tolerate_tail:
+        pass  # 다른 살아 있는 worker가 쓰는 중인 마지막 줄 (개행 전)은 아직 완료 요청이 아니다
+    elif tail.strip():
+        if repair_tail:
+            with open(path + ".partial", "ab") as f:
+                f.write(tail + b"\n")
+            with open(path, "wb") as f:
+                f.write(b"\n".join(body) + (b"\n" if body else b""))
+        else:
+            raise QAError(f"truncated last line (no newline) in {path}; rerun with --repair-tail to quarantine it")
+    for k, ln in enumerate(body):
+        if ln.strip():
+            try:
+                recs.append(json.loads(ln))
+            except ValueError as e:
+                raise QAError(f"corrupt JSON line {k} in {path}") from e
+    return recs
+
+
+def validate_records(files_records, rows, cdig, adapter_digest, protocol_digest, pixel_sha):
+    """모든 기존 record를 현재 요청 행과 대조. returns {request_id: record}. 누락은 허용, 중복·잉여·불일치는 QAError."""
+    by = {r["request_id"]: r for r in rows}
+    done = {}
+    for fn, recs in files_records.items():
+        for r in recs:
+            rid = r.get("request_id")
+            row = by.get(rid)
+            if row is None:
+                raise QAError(f"unexpected record {rid} in {fn}: not in current request set")
+            if rid in done:
+                raise QAError(f"duplicate record {rid} in {fn}")
+            for k, want in (("prompt_sha256", row["prompt_sha256"]), ("adapter_digest", adapter_digest), ("config_digest", cdig),
+                            ("protocol_digest", protocol_digest), ("id", row["id"]), ("condition", row["condition"]),
+                            ("checkpoint", row["checkpoint"]), ("target", row["target"]), ("fmt", row["fmt"]),
+                            ("image_file_sha256", row["file_sha256"])):
+                if r.get(k) != want:
+                    raise QAError(f"{k} mismatch for {rid} in {fn}: {r.get(k)!r} != {want!r}")
+            if r.get("input_pixel_sha256") != pixel_sha(row["image"]):
+                raise QAError(f"input image changed since generation for {rid}")
+            done[rid] = r
+    return done
+
+
+def check_inputs(rows):
+    """현재 영상의 raw pixel/file sha를 요청 행과 대조한다 (전처리 전 원본 uint8 hash)."""
+    from . import inputs
+    seen = {}
+    for r in rows:
+        key = r["image"]
+        if key in seen:
+            continue
+        if generate.sha(open(key, "rb").read()) != r["file_sha256"]:
+            raise QAError(f"file sha changed for {r['id']}")
+        if inputs.raw_pixel_sha(key) != r["pixel_sha256"]:
+            raise QAError(f"pixel sha changed for {r['id']}")
+        seen[key] = 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--worker", type=int, required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--adapter", default=None)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--max-requests", type=int, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    a = ap.parse_args()
+    pdig = qa_protocol.verify(a.protocol)
+    if json.load(open(a.protocol))["locked"]["files"].get(a.requests) != generate.sha(open(a.requests, "rb").read()):
+        sys.exit(f"request file {a.requests} is not locked in {a.protocol} (or changed)")
+    cfg, _ = qa_protocol.static_cfg()
+    rows = Q.load_rows(a.requests, cfg)
+    if len({(r["checkpoint"], r["adapter_digest"]) for r in rows}) != 1:
+        sys.exit("one run must contain one checkpoint")
+    check_inputs(rows)
+    os.makedirs(a.out_dir, exist_ok=True)
+    info = queue_lock.my_info(worker=a.worker)
+    lk, own, _ = queue_lock.try_lock(os.path.join(a.out_dir, f"worker{a.worker}.lock"), info)
+    if lk is None:
+        sys.exit(f"worker {a.worker} already running: {own}")
+    try:
+        run_worker(a, rows, pdig, cfg, info)
+    finally:
+        lk.release()
+
+
+def run_worker(a, rows, pdig, cfg, info):
+    torch, proc, model = generate.load_model()
+    adapter_digest = generate.load_adapter(torch, model, a.adapter) if a.adapter else None
+    if adapter_digest != rows[0]["adapter_digest"]:
+        raise QAError(f"loaded adapter digest {adapter_digest} != requests {rows[0]['adapter_digest']}")
+    env = generate.env_info(torch, proc, model)
+    cdig, core = generate.config_digest(env, {})
+    if cdig != cfg:
+        raise QAError("runtime generation config digest != protocol config digest")
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    with open(os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl.env.json"), "w") as f:
+        json.dump({"env": env, "config_digest": cdig, "adapter_digest": adapter_digest, "protocol_digest": pdig,
+                   "worker": a.worker, "requests": a.requests}, f, indent=1, default=str)
+    cache = {}
+
+    def px(path):
+        if path not in cache:
+            cache[path] = generate.load_image(path)[2]
+        return cache[path]
+
+    def read_all(repair, live=False):
+        return {f: read_strict(f, repair, tolerate_tail=live and f != out)
+                for f in sorted(glob.glob(os.path.join(a.out_dir, "gen_worker*.jsonl")))}
+
+    done = validate_records(read_all(a.repair_tail), rows, cdig, adapter_digest, pdig, px)
+    out = os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl")
+    claim_dir = os.path.join(a.out_dir, "claims")
+    os.makedirs(claim_dir, exist_ok=True)
+    log = open(out + ".log", "a")
+    t0, n_done = time.time(), 0
+    # id 순서 고정 (worker 간 충돌을 줄이기 위해 worker 번호로 시작 위치를 나누지 않고 claim으로만 경쟁한다)
+    for row in sorted(rows, key=lambda r: r["request_id"]):
+        if row["request_id"] in done:
+            continue
+        if (a.time_limit and time.time() - t0 > a.time_limit) or (a.max_requests is not None and n_done >= a.max_requests):
+            log.write(json.dumps({"event": "stop", "done_this_run": n_done}) + "\n")
+            break
+        clk, prev, reclaimed = queue_lock.try_lock(os.path.join(claim_dir, row["request_id"] + ".claim"), info)
+        if clk is None:
+            continue
+        try:
+            if reclaimed:
+                log.write(json.dumps({"event": "claim_reclaimed_from_dead_owner", "request_id": row["request_id"], "prev_owner": prev}) + "\n")
+            done = validate_records(read_all(False, live=True), rows, cdig, adapter_digest, pdig, px)  # claim 뒤 재검증 (다른 worker가 방금 끝냈을 수 있다)
+            if row["request_id"] in done:
+                continue
+            try:
+                rec = generate.run_request(torch, proc, model, eos_ids, {"id": row["id"], "image": row["image"], "file_sha256": row["file_sha256"]},
+                                           row["condition"], row["prompt"])
+            except torch.cuda.OutOfMemoryError as e:
+                log.write(json.dumps({"event": "oom", "request_id": row["request_id"], "err": str(e)[:200]}) + "\n")
+                log.flush()
+                raise
+            rec.update({"request_id": row["request_id"], "split": row["split"], "checkpoint": row["checkpoint"], "target": row["target"],
+                        "fmt": row["fmt"], "condition": row["condition"], "adapter_digest": adapter_digest, "protocol_digest": pdig,
+                        "config_digest": cdig, "worker": a.worker, "ts": time.time(), "gpu_uuid": env.get("gpu_uuid"),
+                        "stage": row["stage"]})
+            with open(out, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            done[row["request_id"]] = rec
+            n_done += 1
+            log.write(json.dumps({"event": "done", "request_id": row["request_id"], "n_out": rec["n_output_tokens"], "finish": rec["finish_reason"],
+                                  "runtime_s": round(rec["runtime_s_total"], 2), "peak_gb": round(rec["peak_mem_alloc_gb_max"], 2),
+                                  "elapsed": round(time.time() - t0, 1)}) + "\n")
+            log.flush()
+        finally:
+            clk.release()
+    print(f"worker {a.worker}: finished; {n_done} new requests this run", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/qa_pilot.py b/rsna_diag/qa_pilot.py
new file mode 100644
index 0000000..2cf5070
--- /dev/null
+++ b/rsna_diag/qa_pilot.py
@@ -0,0 +1,71 @@
+"""iter_015 처리량 pilot 보조: D36 요청에서 대표 48개(M0 QA 24[plain 12+json 12], B0 bbox 12, C bbox 12)를 고르고, 두 실행 구성의 출력을 대조한다.
+
+사용: python -m rsna_diag.qa_pilot build | compare A_DIR B_DIR STAGE
+- 선택은 D36 category 균형(4/4/4)의 앞쪽 요청 순서(hash 순 patient)로 고정한다. 정확도를 보고 고르지 않는다.
+"""
+import glob
+import json
+import os
+import sys
+
+from . import qa_gen, qa_requests as Q
+
+OUT = Q.OUT
+
+
+def load(stage_dir):
+    recs = {}
+    for f in glob.glob(f"{stage_dir}/gen_worker*.jsonl"):
+        for r in qa_gen.read_strict(f):
+            recs[r["request_id"]] = r
+    return recs
+
+
+def build():
+    sets = json.load(open(f"{OUT}/manifests/sets.json"))
+    d12 = {i for c in sets["D12"] for i in sets["D12"][c]}
+    order = {i: k for k, i in enumerate([i for c in sets["D36"] for i in sets["D36"][c]])}
+    sel = {"M0": [], "B0": [], "C": []}
+    for fmt in ("plain", "json"):
+        rows = [json.loads(ln) for ln in open(f"{OUT}/requests/d36_{fmt}__M0.jsonl")]
+        rows = [r for r in rows if r["id"] in d12]  # D12 (category당 4명) x 2 target = 24 -> 12개씩
+        rows.sort(key=lambda r: (order[r["id"]], r["target"]))
+        sel["M0"] += rows[:12]
+    for c in ("B0", "C"):
+        sel[c] = [json.loads(ln) for ln in open(f"{OUT}/requests/d12_bbox__{c}.jsonl")]
+    for c, rows in sel.items():
+        p = f"{OUT}/requests/pilot48__{c}.jsonl"
+        if os.path.exists(p):
+            raise SystemExit(f"{p} exists")
+        with open(p, "w") as f:
+            for r in rows:
+                f.write(json.dumps(r) + "\n")
+    print({c: len(r) for c, r in sel.items()}, "total", sum(len(r) for r in sel.values()))
+
+
+def compare(a_dir, b_dir, stage):
+    out = {"stage": stage, "ckpts": {}}
+    ok = True
+    for c in ("M0", "B0", "C"):
+        A, B = load(f"{a_dir}/{stage}__{c}"), load(f"{b_dir}/{stage}__{c}")
+        same_keys = set(A) == set(B)
+        same_tokens = same_keys and all(A[k]["suffix_ids"] == B[k]["suffix_ids"] for k in A)
+        out["ckpts"][c] = {"n_A": len(A), "n_B": len(B), "same_request_set": same_keys, "identical_greedy_tokens": same_tokens,
+                           "n_token_mismatch": sum(A[k]["suffix_ids"] != B[k]["suffix_ids"] for k in A if k in B),
+                           "wall_A": json.load(open(f"{a_dir}/{stage}__{c}/last_run.json"))["wall_s"],
+                           "wall_B": json.load(open(f"{b_dir}/{stage}__{c}/last_run.json"))["wall_s"],
+                           "peak_alloc_gb_max_A": max(r["peak_mem_alloc_gb_max"] for r in A.values()),
+                           "peak_alloc_gb_max_B": max(r["peak_mem_alloc_gb_max"] for r in B.values()),
+                           "max_runtime_s_A": max(r["runtime_s_total"] for r in A.values()),
+                           "max_runtime_s_B": max(r["runtime_s_total"] for r in B.values())}
+        ok &= same_tokens
+    out["all_identical"] = ok
+    print(json.dumps(out, indent=1))
+    return out
+
+
+if __name__ == "__main__":
+    if sys.argv[1] == "build":
+        build()
+    else:
+        compare(*sys.argv[2:5])
diff --git a/rsna_diag/qa_protocol.py b/rsna_diag/qa_protocol.py
new file mode 100644
index 0000000..a290c0d
--- /dev/null
+++ b/rsna_diag/qa_protocol.py
@@ -0,0 +1,82 @@
+"""iter_015 protocol 잠금. 기존 lock_protocol과 달리 필수 파일이 없으면 조용히 생략하지 않고 실패한다.
+
+- create: 코드(REQUIRED_CODE 전부 존재해야 함) + 명시한 extra 파일(요청·manifest 등)의 sha256과 생성 config digest를 잠근다. 기존 파일은 덮어쓰지 않는다.
+- verify: 잠긴 모든 파일이 존재하고 sha가 같으며 config digest가 현재 processor/generation_config와 같아야 통과. returns protocol digest.
+- locked_file_sha(path, file): 잠긴 파일 목록에서 특정 파일의 sha (runner가 자신의 요청 파일이 잠겨 있는지 확인).
+사용: python -m rsna_diag.qa_protocol --out P --extra F ... [--note TEXT]
+"""
+import argparse
+import json
+import os
+import sys
+
+from . import generate, lock_protocol
+
+SCHEMA = "iter015_qa_protocol_v1"
+# 반입한 16개 파일 + 이번 반복의 신규 모듈. 하나라도 없으면 실패한다.
+REQUIRED_CODE = [
+    "rsna_diag/__init__.py", "rsna_diag/geometry.py", "rsna_diag/parse.py", "rsna_diag/metrics.py", "rsna_diag/sft_eval.py",
+    "rsna_diag/lora.py", "rsna_diag/generate.py", "rsna_diag/prompts.py", "rsna_diag/queue_lock.py", "rsna_diag/lock_protocol.py",
+    "rsna_diag/inputs.py", "rsna_diag/eval_gate.py", "rsna_diag/run_shards.py", "rsna_diag/on_gpu.py", "rsna_diag/rsna_data.py",
+    "rsna_diag/dicom_min.py",
+    "rsna_diag/qa_spec.py", "rsna_diag/qa_data.py", "rsna_diag/qa_protocol.py", "rsna_diag/qa_requests.py", "rsna_diag/qa_gen.py",
+    "rsna_diag/qa_run.py",
+]
+
+
+def static_cfg():
+    d, core = generate.config_digest(generate.static_env(), {})
+    return d, core
+
+
+def current(extra=()):
+    missing = [f for f in list(REQUIRED_CODE) + list(extra) if not os.path.isfile(f)]
+    if missing:
+        raise RuntimeError(f"required protocol files missing: {missing}")
+    d, core = static_cfg()
+    return {"schema": SCHEMA, "files": {f: lock_protocol.sha(f) for f in list(REQUIRED_CODE) + list(extra)},
+            "generation_config_digest": d, "generation_config": core}
+
+
+def create(out, extra=(), note=""):
+    if os.path.exists(out):
+        raise RuntimeError(f"protocol exists (not overwriting): {out}")
+    cur = current(extra)
+    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
+    json.dump({"locked": cur, "note": note}, open(out, "w"), indent=1, default=str)
+    return lock_protocol.locked_digest(cur)
+
+
+def verify(path):
+    if not path or not os.path.exists(path):
+        raise RuntimeError(f"protocol file missing: {path!r}")
+    old = json.load(open(path))
+    lk = old["locked"]
+    if lk.get("schema") != SCHEMA:
+        raise RuntimeError(f"protocol schema {lk.get('schema')!r} != {SCHEMA}")
+    missing_req = [f for f in REQUIRED_CODE if f not in lk["files"]]
+    if missing_req:
+        raise RuntimeError(f"protocol does not lock required files: {missing_req}")
+    extra = [f for f in lk["files"] if f not in REQUIRED_CODE]
+    cur = current(extra)
+    diff = {k: (lk["files"].get(k), v) for k, v in cur["files"].items() if lk["files"].get(k) != v}
+    if diff or lk["generation_config_digest"] != cur["generation_config_digest"]:
+        raise RuntimeError("LOCK MISMATCH " + json.dumps(diff, indent=1)[:2000])
+    return lock_protocol.locked_digest(lk)
+
+
+def locked_file_sha(path, f):
+    return json.load(open(path))["locked"]["files"].get(f)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--extra", nargs="*", default=[])
+    ap.add_argument("--note", default="")
+    a = ap.parse_args()
+    print("locked", a.out, create(a.out, a.extra, a.note))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/rsna_diag/qa_report.py b/rsna_diag/qa_report.py
new file mode 100644
index 0000000..148a445
--- /dev/null
+++ b/rsna_diag/qa_report.py
@@ -0,0 +1,133 @@
+"""iter_015 stage 결과 요약: D36 형식 gate 서술(개발 자료), D12 evidence 구현 확인, E180 concise bbox 비교(M0/B0 재사용 + C 신규).
+
+사용: python -m rsna_diag.qa_report --protocol results/iter_015/protocols/protocol_stage2.json --out results/iter_015/e180/report.json
+- D36의 lenient 매핑('Normal'/'Abnormal' 단어를 yes/no로 옮김)은 사후 서술이며 primary 지표가 아니다. 결과 선택·확대 판단에 쓰지 않는다.
+"""
+import argparse
+import collections
+import json
+import os
+
+import numpy as np
+
+from . import parse as PA, qa_eval as E, qa_requests as Q, qa_spec as S, sft_eval
+
+OUT = Q.OUT
+
+
+def raw_breakdown(protocol):
+    """D36 direct 요청의 정규화된 원문(형식 실패의 실제 내용)."""
+    out = {}
+    for fmt in ("plain", "json"):
+        for ck in ("M0", "B0", "C"):
+            c = {"O": collections.Counter(), "A": collections.Counter()}
+            for row, rec in E.load_stage(f"d36_{fmt}", ck, protocol):
+                t = rec["suffix_text_raw"].replace("<end_of_turn>", "").strip().lower()
+                c[row["target"]][t[:40]] += 1
+            out[f"{fmt}/{ck}"] = {t: dict(c[t].most_common(8)) for t in c}
+    return out
+
+
+def lenient_post_hoc(protocol):
+    """사후 서술: Q_A의 'normal'->no, 'abnormal'->yes, JSON 지시를 무시한 bare yes/no와 {"answer":..}를 허용. primary 아님. D36은 12명/category라 추정이 아니다."""
+    sets = json.load(open(f"{OUT}/manifests/sets.json"))
+    cats = {c: sets["D36"][c] for c in S.CATEGORIES}
+    res = {}
+    import re
+    for fmt in ("plain", "json"):
+        for ck in ("M0", "B0", "C"):
+            ans = {}
+            for row, rec in E.load_stage(f"d36_{fmt}", ck, protocol):
+                if not rec["ended_eos"]:
+                    a = None
+                else:
+                    t = rec["suffix_text_raw"].replace("<end_of_turn>", "").strip().lower()
+                    m = re.fullmatch(r'[{"\s:]*(?:answer[":\s]*)?(yes|no|normal|abnormal)[\s."}]*', t)
+                    w = m.group(1) if m else None
+                    a = {"yes": "yes", "no": "no", "abnormal": "yes", "normal": "no"}.get(w)
+                ans[(row["id"], row["target"])] = a
+            per = {}
+            for c, ids in cats.items():
+                want = S.GT_PAIR[c]
+                per[c] = float(np.mean([ans[(i, "O")] == want[0] and ans[(i, "A")] == want[1] for i in ids]))
+            res[f"{fmt}/{ck}"] = {"S_scope_lenient_posthoc": float(np.mean(list(per.values()))), "per_category": per,
+                                  "n_per_category": 12, "n_none": sum(v is None for v in ans.values())}
+    return res
+
+
+def d12_evidence(protocol):
+    """D12 evidence 구현 확인 (M0 plain). accuracy는 일반화 근거가 아니다. 유효 rate와 evidence 문장 연결만 본다."""
+    pairs = E.load_stage("d12_evidence", "M0", protocol)
+    tab = E.answer_table(pairs)
+    st = collections.defaultdict(collections.Counter)
+    src = collections.Counter()
+    for row, rec in pairs:
+        s_, _ = S.parse_answer(row["fmt"], rec["suffix_text_raw"], rec["ended_eos"])
+        st[row["condition"] + "/" + row["target"]][s_] += 1
+        if row["condition"] == "ev_predicted":
+            src[row["extra"].get("source_status")] += 1
+    return {"status_by_condition_target": {k: dict(v) for k, v in st.items()}, "predicted_source_status": dict(src),
+            "n_requests": len(pairs),
+            "note": "구현·연결 확인용(12명). format gate 실패 상태이므로 정확도를 해석하지 않는다."}
+
+
+def boot_f1(pa, pb, ids, labels, n=E.BOOT_N, seed=E.BOOT_SEED):
+    gt = {i: {"category": labels[i]["category"], "boxes": labels[i]["boxes"]} for i in ids}
+    pos, A = sft_eval.per_patient(pa, gt, ids)
+    _, B = sft_eval.per_patient(pb, gt, ids)
+    res = {}
+    for k in ("f1@0.3", "f1@0.5"):
+        d = A[k] - B[k]
+        rng = np.random.default_rng(seed)
+        idx = rng.integers(0, len(d), size=(n, len(d)))
+        bs = d[idx].mean(1)
+        res[k] = {"point": float(d.mean()), "ci95": [float(np.percentile(bs, 2.5)), float(np.percentile(bs, 97.5))], "n_positive": len(d)}
+    return res
+
+
+def e180_bbox(protocol):
+    sets = json.load(open(f"{OUT}/manifests/sets.json"))
+    labels = json.load(open(f"{OUT}/manifests/labels.json"))
+    ids = [i for c in S.CATEGORIES for i in sets["E180"][c]]
+    ids_by_cat = {c: sets["E180"][c] for c in S.CATEGORIES}
+    E.load_stage("e180_bbox", "C", protocol)  # 완료·provenance 검증
+    out = {"n_patients": len(ids)}
+    preds = {}
+    for ck in ("M0", "B0", "C"):
+        preds[ck] = E.bbox_preds(ck, ids)
+        s = E.bbox_summary(ck, ids, labels)
+        keep = ("n_positive", "f1@0.3", "f1@0.5", "precision@0.3", "recall@0.3", "valid_rate_all", "positive_valid_empty", "status_all", "truncated_all",
+                "neg_Normal", "neg_NoOpacity/NotNormal", "by_n_gt", "utility")
+        out[ck] = {k: s[k] for k in keep}
+    out["C_minus_B0"] = boot_f1(preds["C"], preds["B0"], ids, labels)
+    out["B0_minus_M0"] = boot_f1(preds["B0"], preds["M0"], ids, labels)
+    rule = {}
+    for ck in ("M0", "B0", "C"):
+        rule[ck], _ = E.detector_rule(ck, ids_by_cat)
+    out["detector_rule"] = rule
+    out["constant_pair_baselines"] = E.constant_baselines(ids_by_cat)
+    out["provenance"] = {"M0/B0": "results/iter_015/reuse/reuse_report.json (iter_012 confirm, 검증 후 재사용)", "C": "gen/e180_bbox__C (이번 반복 신규, protocol_stage2)"}
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--protocol-d36", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    rep = {"d36_raw_breakdown": raw_breakdown(a.protocol_d36), "d36_lenient_posthoc_not_primary": lenient_post_hoc(a.protocol_d36),
+           "d12_evidence_impl_check": d12_evidence(a.protocol), "e180_bbox": e180_bbox(a.protocol)}
+    json.dump(rep, open(a.out, "w"), indent=1)
+    print(json.dumps({k: (v if k != "d36_raw_breakdown" else "...") for k, v in rep.items() if k in ("d36_lenient_posthoc_not_primary", "d12_evidence_impl_check")}, indent=0)[:3500])
+    b = rep["e180_bbox"]
+    for ck in ("M0", "B0", "C"):
+        print(ck, {k: (round(b[ck][k], 4) if isinstance(b[ck][k], float) else None) for k in ("f1@0.3", "f1@0.5", "utility")},
+              "valid_all", b[ck]["valid_rate_all"]["rate"], "posEmpty", b[ck]["positive_valid_empty"]["rate"])
+    print("C-B0", b["C_minus_B0"], "B0-M0", b["B0_minus_M0"])
+    print("rule", json.dumps(b["detector_rule"]["B0"]))
+
+
+if __name__ == "__main__":
+    main()
