new file mode 100644
index 0000000..f865e47
--- /dev/null
+++ b/rsna_diag/qa_requests.py
@@ -0,0 +1,203 @@
+"""iter_015 요청 행렬. 요청 행(row)은 실제 prompt 원문과 evidence digest를 포함하고, request_id는 모델 revision·adapter digest·영상 identity·
+target·format·condition·실제 prompt·evidence·config digest·전처리 버전 전체의 hash다 (하나라도 바뀌면 id가 바뀐다).
+
+- 일반 요청 파일에는 category·정답이 없다. oracle 요청만 GT bbox를 prompt로 받으며 별도 stage(condition=ev_oracle)로 생성한다.
+- 사용:
+  python -m rsna_diag.qa_requests checkpoints                     # checkpoint table(adapter tensor digest) 생성
+  python -m rsna_diag.qa_requests build --stage S --kind qa|bbox|evidence --set D36 --ckpts M0,B0 --fmt plain [--exclude-set E180] [--conds ...]
+"""
+import argparse
+import glob
+import json
+import os
+
+from . import generate, parse as PA, prompts as P, qa_spec as S
+
+OUT = "results/iter_015"
+CKPT_SPEC = {
+    "M0": None,
+    "B0": "results/iter_012/train/lr2e-4_s17/epoch_05",
+    "C": "results/iter_014/full/C_lr2e-05/epoch_03",
+    "B29": "results/iter_012/train/lr2e-4_s29/epoch_05",
+    "B43": "results/iter_012/train/lr2e-4_s43/epoch_05",
+}
+ID_FIELDS = ("model_revision", "adapter_digest", "id", "split", "file_sha256", "pixel_sha256", "target", "fmt", "condition",
+             "prompt_sha256", "evidence_digest", "config_digest", "preprocess")
+
+
+class RequestError(RuntimeError):
+    pass
+
+
+def compute_id(row):
+    return S.request_key({k: row.get(k) for k in ID_FIELDS})
+
+
+def make_row(item, ckpt, adapter_digest, target, fmt, condition, prompt, evidence_digest, cfg_digest, stage, extra=None):
+    row = {"id": item["id"], "split": item["split"], "image": item["image"], "file_sha256": item["file_sha256"],
+           "pixel_sha256": item["pixel_sha256"], "checkpoint": ckpt, "adapter_digest": adapter_digest, "target": target,
+           "fmt": fmt, "condition": condition, "prompt": prompt, "prompt_sha256": P.digest(prompt),
+           "evidence_digest": evidence_digest, "model_revision": generate.MODEL_REVISION, "config_digest": cfg_digest,
+           "preprocess": generate.PREPROC_VERSION, "stage": stage}
+    if extra:
+        row["extra"] = extra
+    row["request_id"] = compute_id(row)
+    return row
+
+
+def verify_row(row, cfg_digest):
+    """행 변조(prompt·evidence·adapter·영상 hash·config 등)를 감지한다."""
+    if row.get("prompt_sha256") != P.digest(row["prompt"]):
+        raise RequestError(f"prompt_sha256 != sha(prompt) for {row.get('request_id')}")
+    if row.get("config_digest") != cfg_digest:
+        raise RequestError(f"config_digest differs from protocol for {row.get('request_id')}")
+    if row.get("model_revision") != generate.MODEL_REVISION:
+        raise RequestError("model revision differs")
+    if row.get("request_id") != compute_id(row):
+        raise RequestError(f"request_id != recomputed for {row.get('request_id')}")
+    ev = row.get("evidence_digest")
+    if ev is not None and row["condition"] == "direct":
+        raise RequestError("direct request has evidence digest")
+    return True
+
+
+def load_rows(path, cfg_digest=None):
+    rows = [json.loads(ln) for ln in open(path) if ln.strip()]
+    ids = [r["request_id"] for r in rows]
+    if len(set(ids)) != len(ids):
+        raise RequestError(f"duplicate request_id in {path}")
+    if cfg_digest:
+        for r in rows:
+            verify_row(r, cfg_digest)
+    return rows
+
+
+def checkpoints(out=f"{OUT}/manifests/checkpoints.json"):
+    import torch
+    from . import eval_gate
+    tab = {}
+    for k, d in CKPT_SPEC.items():
+        if d is None:
+            tab[k] = {"dir": None, "digest": None}
+            continue
+        b = torch.load(os.path.join(d, "adapter.pt"), map_location="cpu", weights_only=True)
+        tab[k] = {"dir": d, "digest": eval_gate.adapter_digest(d), "epoch": b.get("epoch"), "step": b.get("step"),
+                  "train_digest": b.get("train_digest"), "lora": b["config"]}
+    tab["_note"] = {"C": "B0(seed17) 위의 추가 SFT single trajectory. 독립 seed가 아니다. V200 선택 기준 통과 최적 모델이 아니다."}
+    if os.path.exists(out):
+        old = json.load(open(out))
+        if old != tab:
+            raise RequestError("checkpoint table exists and differs")
+    json.dump(tab, open(out, "w"), indent=1)
+    return tab
+
+
+def patients(sets, name, exclude=None):
+    ids = [i for c in S.CATEGORIES for i in sets[name][c]]
+    if exclude:
+        ex = {i for c in S.CATEGORIES for i in sets[exclude][c]}
+        ids = [i for i in ids if i not in ex]
+    return ids
+
+
+def bbox_records(ckpt):
+    """ckpt의 concise bbox 원시 record: 검증된 재사용 파일 + 이번 반복 신규 생성 결과. returns {id: record dict(suffix_text_raw, ended_eos)}."""
+    out = {}
+    for p in glob.glob(f"{OUT}/reuse/bbox_{ckpt}_concise.jsonl"):
+        for ln in open(p):
+            if ln.strip():
+                r = json.loads(ln)
+                out[r["id"]] = r
+    for d in glob.glob(f"{OUT}/gen/*__{ckpt}"):
+        for f in glob.glob(f"{d}/gen_worker*.jsonl"):
+            for r in generate.read_records(f):
+                if r.get("condition") == "bbox" and r.get("checkpoint") == ckpt:
+                    out[r["id"]] = r
+    return out
+
+
+def predicted_boxes(rec):
+    """returns (boxes or None, status). 유효 출력만 boxes를 가진다 (빈 목록은 []). 형식 실패·잘림·누락은 None."""
+    if rec is None:
+        return None, "missing"
+    pr = PA.parse_response(rec["suffix_text_raw"], rec["ended_eos"])
+    if pr["status"] in PA.VALID:
+        return [[int(round(v)) for v in b] for b in pr["boxes"]], pr["status"]
+    return None, pr["status"]
+
+
+def build(a):
+    sets = json.load(open(f"{OUT}/manifests/sets.json"))
+    man = {}
+    for ln in open(f"{OUT}/manifests/infer_manifest.jsonl"):
+        r = json.loads(ln)
+        man[r["id"]] = r
+    labels = json.load(open(f"{OUT}/manifests/labels.json")) if a.kind == "evidence" and "oracle" in a.conds.split(",") else None
+    tab = json.load(open(f"{OUT}/manifests/checkpoints.json"))
+    from . import qa_protocol
+    cfg, _ = qa_protocol.static_cfg()
+    ids = patients(sets, a.set, a.exclude_set)
+    os.makedirs(f"{OUT}/requests", exist_ok=True)
+    counts = {}
+    ckpts = a.ckpts.split(",")
+    per = {c: [] for c in ckpts}
+    for c in ckpts:
+        ad = tab[c]["digest"]
+        if a.kind == "qa":
+            for i in ids:
+                for t in S.TARGETS:
+                    per[c].append(make_row(man[i], c, ad, t, a.fmt, "direct", S.qa_prompt(t, a.fmt), None, cfg, a.stage))
+        elif a.kind == "bbox":
+            for i in ids:
+                per[c].append(make_row(man[i], c, ad, "bbox", "concise", "bbox", P.CONCISE, None, cfg, a.stage))
+        else:  # evidence: reader는 base(M0)
+            src = bbox_records(a.evidence_source)
+            for i in ids:
+                for cond in a.conds.split(","):
+                    if cond == "oracle":
+                        boxes = [b["yxyx_norm"] for b in labels[i]["boxes"]]
+                        txt, meta = S.evidence_text("oracle", boxes), {"source": "gt"}
+                    elif cond == "unavailable":
+                        txt, meta = S.evidence_text("unavailable"), {"source": None}
+                    else:
+                        if i not in src:
+                            raise RequestError(f"no {a.evidence_source} bbox record for {i}")
+                        boxes, st = predicted_boxes(src[i])
+                        txt = S.evidence_text("predicted", boxes)
+                        meta = {"source": a.evidence_source, "source_request_id": src[i].get("request_id"), "source_status": st}
+                    for t in S.TARGETS:
+                        per[c].append(make_row(man[i], c, ad, t, a.fmt, f"ev_{cond}", S.qa_prompt(t, a.fmt, txt), S.sha(txt), cfg,
+                                               a.stage, extra=meta))
+    for c, rows in per.items():
+        p = f"{OUT}/requests/{a.stage}__{c}.jsonl"
+        if os.path.exists(p):
+            raise RequestError(f"{p} exists (not overwriting)")
+        with open(p, "w") as f:
+            for r in rows:
+                f.write(json.dumps(r) + "\n")
+        counts[c] = len(rows)
+    print(json.dumps({"stage": a.stage, "n_patients": len(ids), "rows": counts}))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    sp.add_parser("checkpoints")
+    b = sp.add_parser("build")
+    b.add_argument("--stage", required=True)
+    b.add_argument("--kind", required=True, choices=["qa", "bbox", "evidence"])
+    b.add_argument("--set", required=True)
+    b.add_argument("--exclude-set", default=None)
+    b.add_argument("--ckpts", required=True)
+    b.add_argument("--fmt", default="plain")
+    b.add_argument("--conds", default="predicted,unavailable,oracle")
+    b.add_argument("--evidence-source", default="B0")
+    a = ap.parse_args()
+    if a.cmd == "checkpoints":
+        print(json.dumps({k: v.get("digest") for k, v in checkpoints().items() if k != "_note"}))
+    else:
+        build(a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/qa_reuse.py b/rsna_diag/qa_reuse.py
new file mode 100644
index 0000000..388b551
--- /dev/null
+++ b/rsna_diag/qa_reuse.py
@@ -0,0 +1,74 @@
+"""iter_015: 과거 iter_012 confirm concise bbox 출력(M0, B0=seed17 epoch05)을 provenance 검증 후 E600 환자 subset으로 추출한다.
+
+검증(record별): request_id 재계산(모델 revision·adapter digest·split·id·prompt sha), prompt sha == 현재 CONCISE, config_digest == 과거 env 기록 ==
+현재 static config(concise 단독)의 재계산, adapter digest == checkpoint table, protocol digest == 과거 protocol 파일 digest, 현재 영상의 file/pixel hash.
+과거 protocol은 새 코드로 통과했다고 소급 표시하지 않는다: 원본 protocol digest와 출처 경로를 그대로 기록한다.
+사용: python -m rsna_diag.qa_reuse
+"""
+import glob
+import json
+import os
+
+from . import generate, lock_protocol, prompts as P, qa_data, qa_gen, qa_requests as Q
+
+SRC = {"M0": "results/iter_012/confirm_base", "B0": "results/iter_012/confirm_sft_seed17"}
+OLD_PROTOCOL = "results/iter_012/protocols/main_protocol.json"
+
+
+def extract():
+    sets = json.load(open(f"{Q.OUT}/manifests/sets.json"))
+    ids = {i for c in sets["E600"] for i in sets["E600"][c]}
+    man = {}
+    for ln in open(f"{Q.OUT}/manifests/infer_manifest.jsonl"):
+        r = json.loads(ln)
+        man[r["id"]] = r
+    tab = json.load(open(f"{Q.OUT}/manifests/checkpoints.json"))
+    pdig_old = lock_protocol.digest_of(OLD_PROTOCOL)
+    psha = P.digest(P.CONCISE)
+    os.makedirs(f"{Q.OUT}/reuse", exist_ok=True)
+    report = {}
+    for ck, d in SRC.items():
+        adg = tab[ck]["digest"]
+        comp = json.load(open(f"{d}/completion.json"))
+        assert comp["n_expected"] == comp["n_actual_unique"] and comp["n_missing"] == 0 and comp["n_duplicate"] == 0 and "concise" in comp["prompts"] and comp["adapter_digest"] == adg
+        assert comp["protocol_digest"] == pdig_old
+        allp = P.all_prompts()
+        cdig_now, _ = generate.config_digest(generate.static_env(), {k: allp[k] for k in comp["prompts"]})
+        envs = [json.load(open(f)) for f in sorted(glob.glob(f"{d}/gen_worker*.jsonl.env.json"))]
+        assert all(e["config_digest"] == cdig_now and e["adapter_digest"] == adg for e in envs), "env config/adapter differ from current"
+        recs = {}
+        for f in sorted(glob.glob(f"{d}/gen_worker*.jsonl")):
+            for r in generate.read_records(f):
+                if r["prompt_name"] != "concise":
+                    continue
+                assert r["id"] not in recs, f"duplicate {r['id']}"
+                recs[r["id"]] = r
+        assert len(recs) == 800, len(recs)
+        out = []
+        for i in sorted(ids):
+            r = recs[i]
+            rid = generate.request_id(generate.MODEL_REVISION, adg, "confirm", i, psha)
+            checks = {"request_id": r["request_id"] == rid, "prompt": r["prompt_sha256"] == psha, "config": r["config_digest"] == cdig_now,
+                      "adapter": r["adapter_digest"] == adg, "protocol": r["protocol_digest"] == pdig_old,
+                      "file": r["image_file_sha256"] == man[i]["file_sha256"],
+                      "pixel": r["input_pixel_sha256"] == generate.load_image(man[i]["image"])[2]}
+            if not all(checks.values()):
+                raise qa_gen.QAError(f"{ck} {i}: provenance check failed {checks}")
+            out.append({"id": i, "checkpoint": ck, "condition": "bbox", "request_id": r["request_id"], "suffix_text_raw": r["suffix_text_raw"],
+                        "ended_eos": r["ended_eos"], "finish_reason": r["finish_reason"], "n_output_tokens": r["n_output_tokens"],
+                        "source_dir": d, "source_worker": r["worker"], "old_protocol_digest": pdig_old, "adapter_digest": adg})
+        p = f"{Q.OUT}/reuse/bbox_{ck}_concise.jsonl"
+        if os.path.exists(p):
+            raise SystemExit(f"{p} exists (not overwriting)")
+        with open(p, "w") as f:
+            for r in out:
+                f.write(json.dumps(r) + "\n")
+        report[ck] = {"n_extracted": len(out), "source_total": len(recs), "source_dir": d, "old_protocol_digest": pdig_old,
+                      "old_protocol_path": OLD_PROTOCOL, "adapter_digest": adg, "config_digest_recomputed": cdig_now, "run_prompts": comp["prompts"],
+                      "note": "과거 protocol을 새 코드로 재검증한 것이 아니다. 출력 provenance만 현재 입력·prompt·adapter와 대조했다."}
+    json.dump(report, open(f"{Q.OUT}/reuse/reuse_report.json", "w"), indent=1)
+    print(json.dumps(report, indent=1))
+
+
+if __name__ == "__main__":
+    extract()
diff --git a/rsna_diag/qa_run.py b/rsna_diag/qa_run.py
new file mode 100644
index 0000000..14f8bc2
--- /dev/null
+++ b/rsna_diag/qa_run.py
@@ -0,0 +1,213 @@
+"""iter_015 stage 실행기: worker 수와 GPU 수를 분리하고, 허용 GPU 집합·메모리 여유·완료 검증·자식 종료 코드를 강제한다.
+
+- 허용 집합 = 상속된 CUDA_VISIBLE_DEVICES(정수 목록). --gpus는 그 부분집합. worker k -> gpus[k % len(gpus)] (같은 GPU에 여러 worker 가능).
+- 실행 전 nvidia-smi를 조회한다. 조회 실패·파싱 실패는 실행하지 않는다. GPU별 (다른 프로세스 점유 + worker 수 x (측정 peak + 2GiB 여유)) <= 총 용량이어야 한다.
+- 이미 완료된 job은 모델을 올리지 않고 현재 입력·config·protocol·adapter와 다시 대조한 뒤 건너뛴다.
+- job 종료 후 모든 자식 종료 코드 수집, 요청 집합 == record 집합(누락·중복·잉여 0)이고 record 검증을 통과할 때만 completion.json을 원자적으로 쓴다.
+사용: python -m rsna_diag.qa_run --stage S --ckpts M0,B0 --protocol P --workers 4 --peak-gb 10
+"""
+import argparse
+import glob
+import json
+import os
+import subprocess
+import sys
+import time
+
+from . import eval_gate, generate, qa_gen, qa_protocol, qa_requests as Q, queue_lock
+
+OUT = Q.OUT
+MIB_PER_GIB = 1024
+
+
+class GpuError(RuntimeError):
+    pass
+
+
+def atomic_json(obj, path):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f, indent=1, default=str)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
+
+
+def allowed_gpus():
+    raw = os.environ.get("CUDA_VISIBLE_DEVICES")
+    if not raw:
+        raise GpuError("CUDA_VISIBLE_DEVICES not set (allowed GPU set unknown)")
+    try:
+        return [int(x) for x in raw.split(",")]
+    except ValueError:
+        raise GpuError(f"non-integer CUDA_VISIBLE_DEVICES {raw!r}")
+
+
+def query_gpus(idx):
+    """returns {index: {uuid, used_mib, total_mib}}; nvidia-smi 실패·누락이면 GpuError."""
+    r = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,memory.used,memory.total", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True)
+    if r.returncode != 0:
+        raise GpuError(f"nvidia-smi failed rc={r.returncode}: {r.stderr[:200]}")
+    rows = {}
+    try:
+        for ln in r.stdout.strip().splitlines():
+            i, u, mu, mt = [x.strip() for x in ln.split(",")]
+            rows[int(i)] = {"uuid": u, "used_mib": int(mu), "total_mib": int(mt)}
+    except ValueError as e:
+        raise GpuError(f"cannot parse nvidia-smi output: {r.stdout[:200]}") from e
+    missing = [i for i in idx if i not in rows]
+    if missing:
+        raise GpuError(f"gpus {missing} not reported by nvidia-smi")
+    return {i: rows[i] for i in idx}
+
+
+def plan_gpus(gpus, workers, peak_gb, allowed, snapshot):
+    """허용 집합 검사와 GPU별 메모리 합산. returns 배정 list[(worker, gpu)]. 위반 시 GpuError."""
+    if not gpus or not set(gpus) <= set(allowed):
+        raise GpuError(f"gpus {gpus} not within allowed {allowed}")
+    assign = [(k, gpus[k % len(gpus)]) for k in range(workers)]
+    for g in gpus:
+        n = sum(1 for _, x in assign if x == g)
+        need = n * (peak_gb + 2.0) * MIB_PER_GIB
+        free = snapshot[g]["total_mib"] - snapshot[g]["used_mib"]
+        if n and need > free:
+            raise GpuError(f"gpu {g}: {n} workers x ({peak_gb}+2) GiB = {need:.0f} MiB > free {free} MiB")
+    return assign
+
+
+def load_job(stage, ckpt, protocol):
+    rp = f"{OUT}/requests/{stage}__{ckpt}.jsonl"
+    cfg, _ = qa_protocol.static_cfg()
+    rows = Q.load_rows(rp, cfg)
+    if json.load(open(protocol))["locked"]["files"].get(rp) != generate.sha(open(rp, "rb").read()):
+        raise RuntimeError(f"{rp} not locked in {protocol}")
+    return rp, rows, cfg
+
+
+def verify_job(out_dir, rows, cfg, pdig, adapter_dir, require_complete=True):
+    """out_dir의 모든 record를 요청 행·현재 입력·adapter·config·protocol과 대조. returns (done dict, missing list)."""
+    adg = eval_gate.adapter_digest(adapter_dir) if adapter_dir else None
+    if adg != rows[0]["adapter_digest"]:
+        raise qa_gen.QAError(f"adapter digest {adg} != requests {rows[0]['adapter_digest']}")
+    files = {f: qa_gen.read_strict(f) for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl")))}
+    cache = {}
+    px = lambda p: cache.setdefault(p, generate.load_image(p)[2])
+    done = qa_gen.validate_records(files, rows, cfg, adg, pdig, px)
+    missing = [r["request_id"] for r in rows if r["request_id"] not in done]
+    return done, missing
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--ckpts", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--workers", type=int, required=True)
+    ap.add_argument("--gpus", default=None)
+    ap.add_argument("--peak-gb", type=float, required=True, help="worker당 측정 peak GiB (pilot 실측값). 각 worker에 2GiB 여유를 더해 검사한다")
+    ap.add_argument("--max-requests", type=int, default=None, help="worker별 (pilot/test 전용)")
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    ap.add_argument("--poll-s", type=float, default=20.0)
+    ap.add_argument("--out-suffix", default="", help="pilot 등 별도 경로용 (기본: 정식 gen 경로)")
+    a = ap.parse_args()
+    pdig = qa_protocol.verify(a.protocol)
+    tab = json.load(open(f"{OUT}/manifests/checkpoints.json"))
+    allowed = allowed_gpus()
+    gpus = [int(x) for x in a.gpus.split(",")] if a.gpus else allowed
+    summary = []
+    for ckpt in a.ckpts.split(","):
+        rp, rows, cfg = load_job(a.stage, ckpt, a.protocol)
+        out_dir = f"{OUT}/gen{a.out_suffix}/{a.stage}__{ckpt}"
+        os.makedirs(out_dir, exist_ok=True)
+        adapter = tab[ckpt]["dir"]
+        cp = os.path.join(out_dir, "completion.json")
+        if os.path.exists(cp):
+            done, missing = verify_job(out_dir, rows, cfg, pdig, adapter)
+            c = json.load(open(cp))
+            if not missing and c.get("protocol_digest") == pdig and c.get("n_expected") == len(rows):
+                print(f"[{ckpt}] already complete & re-verified ({len(rows)} requests); skip", flush=True)
+                summary.append({"ckpt": ckpt, "status": "verified_complete", "n": len(rows)})
+                continue
+        snap = query_gpus(gpus)
+        assign = plan_gpus(gpus, a.workers, a.peak_gb, allowed, snap)
+        info = queue_lock.my_info(role="qa_run")
+        rlk, own, _ = queue_lock.try_lock(os.path.join(out_dir, "run.lock"), info)
+        if rlk is None:
+            sys.exit(f"another qa_run owns {out_dir}: {own}")
+        aid = f"{time.strftime('%Y%m%d_%H%M%S')}_{os.getpid()}"
+        att_dir = os.path.join(out_dir, "attempts")
+        os.makedirs(att_dir, exist_ok=True)
+        att_path = os.path.join(att_dir, f"attempt_{aid}.json")
+        att = {"attempt_id": aid, "status": "running", "pid": os.getpid(), "t_start": time.time(), "workers": a.workers,
+               "assign_worker_gpu": assign, "gpu_uuid": {g: snap[g]["uuid"] for g in gpus}, "peak_gb_assumed": a.peak_gb,
+               "gpu_snapshot_before": snap, "allowed": allowed}
+        procs = []
+        try:
+            if os.path.exists(cp):  # 새 시도 시작: 이전 completion은 현재 성공 근거가 아니다 (삭제하지 않고 보존)
+                os.replace(cp, os.path.join(att_dir, f"completion_superseded_by_{aid}.json"))
+            atomic_json(att, att_path)
+            for k, g in assign:
+                cmd = [sys.executable, "-m", "rsna_diag.qa_gen", "--requests", rp, "--out-dir", out_dir, "--worker", str(k),
+                       "--protocol", a.protocol]
+                if adapter:
+                    cmd += ["--adapter", adapter]
+                if a.max_requests is not None:
+                    cmd += ["--max-requests", str(a.max_requests)]
+                if a.time_limit:
+                    cmd += ["--time-limit", str(a.time_limit)]
+                if a.repair_tail:
+                    cmd += ["--repair-tail"]
+                env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(g), CUDA_DEVICE_ORDER="PCI_BUS_ID")
+                procs.append(subprocess.Popen(cmd, env=env, stdout=open(f"{out_dir}/worker{k}.stdout.log", "a"),
+                                              stderr=open(f"{out_dir}/worker{k}.stderr.log", "a")))
+            t0 = time.time()
+            rl = open(f"{out_dir}/resource_log.jsonl", "a")
+            while any(p.poll() is None for p in procs):
+                try:
+                    q = query_gpus(gpus)
+                    apps = subprocess.run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory", "--format=csv,noheader,nounits"],
+                                          capture_output=True, text=True).stdout.strip().splitlines()
+                except GpuError as e:
+                    q, apps = {"error": str(e)}, []
+                rl.write(json.dumps({"t": time.time() - t0, "gpus": q, "apps": apps}) + "\n")
+                rl.flush()
+                time.sleep(a.poll_s)
+            codes = [p.returncode for p in procs]
+            wall = time.time() - t0
+            err = None
+            try:
+                done, missing = verify_job(out_dir, rows, cfg, pdig, adapter)
+            except (qa_gen.QAError, eval_gate.GateError) as e:
+                done, missing, err = {}, [r["request_id"] for r in rows], str(e)[:500]
+            per_file = {os.path.basename(f): len(qa_gen.read_strict(f)) for f in sorted(glob.glob(f"{out_dir}/gen_worker*.jsonl"))}
+            rep = {"stage": a.stage, "checkpoint": ckpt, "n_expected": len(rows), "n_actual_unique": len(done), "n_missing": len(missing),
+                   "n_duplicate": 0, "n_extra": 0, "returncodes": codes, "wall_s": wall, "per_file": per_file, "protocol_digest": pdig,
+                   "adapter_digest": rows[0]["adapter_digest"], "worker_gpu": assign, "gpu_uuid": att["gpu_uuid"], "verify_error": err,
+                   "requests": rp, "attempt_id": aid}
+            atomic_json(rep, f"{out_dir}/last_run.json")
+            ok = not missing and err is None and all(c == 0 for c in codes)
+            att.update({"status": "complete" if ok else "failed_or_incomplete", "returncodes": codes, "t_end": time.time(), "report": rep})
+            atomic_json(att, att_path)
+            if ok:
+                atomic_json(rep, cp)
+            elif a.max_requests is None:
+                summary.append({"ckpt": ckpt, "status": "FAILED", "rc": codes, "missing": len(missing), "err": err})
+            print(f"[{ckpt}] rc={codes} wall={wall:.0f}s n={len(done)}/{len(rows)} ok={ok}", flush=True)
+            summary.append({"ckpt": ckpt, "status": "complete" if ok else "incomplete", "n": len(done), "of": len(rows), "wall_s": wall})
+        finally:
+            if att["status"] == "running":
+                att.update({"status": "interrupted", "t_end": time.time(),
+                            "children": [{"pid": p.pid, "returncode": p.poll()} for p in procs]})
+                try:
+                    atomic_json(att, att_path)
+                except OSError:
+                    pass
+            rlk.release()
+    print(json.dumps(summary))
+    sys.exit(0 if all(s["status"] in ("complete", "verified_complete") for s in summary) else 2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/qa_spec.py b/rsna_diag/qa_spec.py
new file mode 100644
index 0000000..2a82d51
--- /dev/null
+++ b/rsna_diag/qa_spec.py
@@ -0,0 +1,112 @@
+"""iter_015 target-scope 진단의 질문·출력 형식·evidence 문장·QA parser·정답 mapping (결과를 보기 전에 고정).
+
+- Q_O: 폐렴 의심 pulmonary opacity 존재. Q_A: RSNA 판독 규약상 Normal이 아닌가(abnormal). 둘은 별도 대화로 실행한다.
+- 정답 쌍 (Q_O, Q_A): opacity=(yes,yes), normal=(no,no), not_normal_no_opacity=(no,yes).
+- parser는 공백·대소문자·단일 문장부호(plain)만 정규화한다. bbox 목록, 모순, 설명만 있는 답, truncation은 별도 실패로 구분한다.
+  빈 목록 []는 no로 바꾸지 않는다.
+"""
+import hashlib
+import json
+import re
+
+Q_O = "Is there a pulmonary opacity suspicious for pneumonia in this chest radiograph?"
+Q_A = ("Under the RSNA chest-radiograph labeling convention, is this image abnormal rather than Normal? "
+       "An abnormal image need not contain an opacity suspicious for pneumonia. A healed rib fracture alone counts as Normal.")
+QUESTIONS = {"O": Q_O, "A": Q_A}
+FORMATS = {"plain": "Answer only yes or no.", "json": 'Return only {"answer":"yes"} or {"answer":"no"}.'}
+TARGETS = ("O", "A")
+CATEGORIES = ("opacity", "normal", "not_normal_no_opacity")
+GT_PAIR = {"opacity": ("yes", "yes"), "normal": ("no", "no"), "not_normal_no_opacity": ("no", "yes")}
+
+BBOX_FMT = "yxyx integers in [0,1000] relative to the entire square-padded image, y before x"
+EVIDENCE_HEAD = "A separate localization step examined this chest radiograph for pulmonary opacities suspicious for pneumonia. "
+EVIDENCE_TEXT = {
+    "predicted_nonempty": "It proposed these boxes as JSON [y_min, x_min, y_max, x_max] (" + BBOX_FMT + "): {boxes}. The proposal may be wrong.",
+    "predicted_empty": "It proposed no boxes. An empty proposal does not mean the image is Normal; it only means no such opacity was localized.",
+    "unavailable": "No localization proposal is available for this image. This does not mean the image is Normal.",
+    "oracle_nonempty": "Reference annotation boxes for pulmonary opacity, JSON [y_min, x_min, y_max, x_max] (" + BBOX_FMT + "): {boxes}.",
+    "oracle_empty": "The reference annotation contains no pulmonary opacity box. This does not mean the image is Normal.",
+}
+
+
+def sha(b):
+    return hashlib.sha256(b if isinstance(b, bytes) else b.encode()).hexdigest()
+
+
+def qa_prompt(target, fmt, evidence_text=None):
+    """evidence_text가 있으면 질문 앞에 붙는다 (원본 영상은 항상 함께 제공)."""
+    core = f"{QUESTIONS[target]} {FORMATS[fmt]}"
+    return core if evidence_text is None else f"{EVIDENCE_HEAD}{evidence_text}\n\n{core}"
+
+
+def boxes_json(boxes):
+    return json.dumps([{"box_2d": [int(round(v)) for v in b]} for b in boxes], separators=(",", ":"))
+
+
+def evidence_text(kind, boxes=None):
+    """kind: predicted|unavailable|oracle. boxes: 유효한 bbox 목록(빈 목록 가능). predicted에서 boxes=None이면 unavailable."""
+    if kind == "unavailable" or (kind == "predicted" and boxes is None):
+        return EVIDENCE_TEXT["unavailable"]
+    key = f"{kind}_{'nonempty' if boxes else 'empty'}"
+    return EVIDENCE_TEXT[key].format(boxes=boxes_json(boxes)) if boxes else EVIDENCE_TEXT[key]
+
+
+EOT = "<end_of_turn>"
+_PUNCT = ".!"
+
+
+def parse_plain(raw, ended_eos):
+    """returns (status, answer). status: valid | truncated | empty | bbox_list | contradictory | explanation."""
+    if not ended_eos:
+        return "truncated", None
+    t = raw[:-len(EOT)] if raw.endswith(EOT) else raw
+    t = t.strip()
+    if not t:
+        return "empty", None
+    core = t.lower()
+    if core and core[-1] in _PUNCT:
+        core = core[:-1]
+    if core in ("yes", "no"):
+        return "valid", core
+    if "box_2d" in t or re.fullmatch(r"\s*\[.*\]\s*", t, re.S):
+        return "bbox_list", None
+    words = set(re.findall(r"[a-z]+", t.lower()))
+    if "yes" in words and "no" in words:
+        return "contradictory", None
+    return "explanation", None
+
+
+def _pairs(pairs):
+    keys = [k for k, _ in pairs]
+    if len(set(keys)) != len(keys):
+        raise ValueError("duplicate key")
+    return dict(pairs)
+
+
+def parse_json(raw, ended_eos):
+    """단일 answer 키와 yes/no 값만 허용 (fence·추가 키·중복 키 불허)."""
+    if not ended_eos:
+        return "truncated", None
+    t = raw[:-len(EOT)] if raw.endswith(EOT) else raw
+    t = t.strip()
+    if not t:
+        return "empty", None
+    if "box_2d" in t:
+        return "bbox_list", None
+    try:
+        v = json.loads(t, object_pairs_hook=_pairs)
+    except ValueError:
+        words = set(re.findall(r"[a-z]+", t.lower()))
+        return ("contradictory" if {"yes", "no"} <= words else "explanation"), None
+    if isinstance(v, dict) and list(v) == ["answer"] and v["answer"] in ("yes", "no"):
+        return "valid", v["answer"]
+    return "schema_error", None
+
+
+def parse_answer(fmt, raw, ended_eos):
+    return (parse_plain if fmt == "plain" else parse_json)(raw, ended_eos)
+
+
+def request_key(fields):
+    """request_id 재계산용. fields 전부(모델 revision, adapter digest, 영상 identity, target, format, condition, prompt sha, evidence digest, config digest)가 포함된다."""
+    return sha(json.dumps(fields, sort_keys=True, default=str))[:32]
diff --git a/rsna_diag/queue_lock.py b/rsna_diag/queue_lock.py
new file mode 100644
index 0000000..cbfbbbf
--- /dev/null
+++ b/rsna_diag/queue_lock.py
@@ -0,0 +1,72 @@
+"""실행 lock과 원자적 작업 claim (iter_010). flock 기반: 소유 프로세스가 종료되어야만 커널이 lock을 놓는다.
+
+- try_lock은 원자적이다 (경쟁하는 여러 프로세스 중 하나만 성공). 살아 있는 소유자의 lock은 절대 빼앗지 않는다.
+- 소유자가 죽으면 커널이 lock을 해제하므로, 다음 acquire가 '종료가 확인된 소유자의 claim 회수'가 된다.
+  파일에 남은 이전 소유자 정보(pid/host/시작시각)는 prev로 반환해 로그에 남긴다 (파일은 삭제하지 않는다).
+- 같은 host의 로컬 파일시스템을 가정한다 (NFS 등 flock 의미가 다른 곳에서는 쓰지 않는다).
+"""
+import fcntl
+import json
+import os
+import socket
+import time
+
+
+def proc_start(pid):
+    """/proc/<pid>/stat의 starttime (clock ticks). 없으면 None."""
+    try:
+        with open(f"/proc/{pid}/stat") as f:
+            s = f.read()
+        return int(s[s.rindex(")") + 2:].split()[19])
+    except (FileNotFoundError, ProcessLookupError, ValueError, IndexError):
+        return None
+
+
+def my_info(**extra):
+    pid = os.getpid()
+    return {"pid": pid, "start": proc_start(pid), "host": socket.gethostname(), "ts": time.time(), **extra}
+
+
+def _read(fd):
+    os.lseek(fd, 0, os.SEEK_SET)
+    txt = os.read(fd, 65536).decode(errors="replace")
+    try:
+        return json.loads(txt) if txt.strip() else None
+    except ValueError:
+        return None
+
+
+class Lock:
+    def __init__(self, path, fd, info):
+        self.path, self.fd, self.info = path, fd, info
+
+    def release(self):
+        if self.fd is not None:
+            os.ftruncate(self.fd, 0)
+            os.lseek(self.fd, 0, os.SEEK_SET)
+            os.write(self.fd, json.dumps({"released": True, "by": self.info}).encode())
+            fcntl.flock(self.fd, fcntl.LOCK_UN)
+            os.close(self.fd)
+            self.fd = None
+
+
+def try_lock(path, info):
+    """returns (Lock 또는 None, prev, reclaimed).
+
+    None이면 다른 살아 있는 프로세스가 보유 중이다 (prev=현재 파일의 소유자 정보, 읽을 수 있으면).
+    reclaimed=True: 이전 소유자가 release 없이 종료(kill 등)한 lock을 이어받았다 (prev=그 소유자 정보).
+    """
+    fd = os.open(path, os.O_CREAT | os.O_RDWR)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError:
+        prev = _read(fd)
+        os.close(fd)
+        return None, prev, False
+    prev = _read(fd)
+    reclaimed = isinstance(prev, dict) and not prev.get("released") and "pid" in prev
+    os.ftruncate(fd, 0)
+    os.lseek(fd, 0, os.SEEK_SET)
+    os.write(fd, json.dumps(info).encode())
+    os.fsync(fd)
+    return Lock(path, fd, info), prev, reclaimed
