+"""iter_014 학습기: C(직접 추가 SFT) / U(GT 질량을 맞춘 균등 pseudo-box) / G(GIoU 가중 pseudo-box). 손실 정의는 geo_loss.py 참조. 사용:
+CUDA_VISIBLE_DEVICES=<gpu> python -m rsna_diag.adapt_geo --run-dir D --stage-config S.json --loss C|U|G --lr 2e-5 --protocol P --microbatch 2 --branch-microbatch 4
+
+- adapt.py(iter_013)의 재개·validation·lock 동작을 그대로 따른다 (train.py helper 재사용). 달라지는 것은 (1) GT sequence의 token별 가중치, (2) 후보 branch의
+  순차 forward/backward 누적(같은 optimizer update 안, 모든 branch 뒤에만 optimizer.step), (3) 추가 provenance(후보 manifest digest, branch digest).
+- C는 가중치가 전부 1이고 branch가 없어 iter_013 C와 같은 손실이다 (수치 환원 검사: tests).
+- 후보 branch의 prefix hidden state/KV cache는 재사용하지 않는다 (LoRA를 통과하는 값을 detach하지 않으며 branch마다 전체 forward).
+"""
+import argparse
+import hashlib
+import json
+import math
+import os
+import sys
+import time
+
+import numpy as np
+
+from . import adapt as A, coord_loss as CL, generate, geo_loss as GL, inputs, lock_protocol, lora, migrate, prompts as P, queue_lock, select, sft_data, sft_eval
+from . import train as T
+
+STAGE_KEYS = A.STAGE_KEYS + ("cand_manifest", "cand_manifest_sha256")
+
+
+class GeoDataset:
+    def __init__(self, tok, proc, items, gt, prompt, order, dig_ids, mode, cands):
+        self.tok, self.proc, self.items, self.gt, self.prompt, self.order, self.dig, self.mode, self.cands = tok, proc, items, gt, prompt, order, dig_ids, mode, cands
+
+    def __len__(self):
+        return len(self.order)
+
+    def __getitem__(self, k):
+        import torch
+        it = self.items[self.order[k]]
+        image, _, _ = inputs.load_verified(it)
+        boxes = sft_data.target_boxes([b["yxyx_norm"] for b in self.gt[it["id"]]["boxes"]])
+        tgt = sft_data.target_text([b["yxyx_norm"] for b in self.gt[it["id"]]["boxes"]])
+        ex = sft_data.build_example(self.proc, image, self.prompt, tgt)
+        fid, npf = ex["input_ids"].tolist(), ex["n_prefix"]
+        tokw = torch.ones(len(fid), dtype=torch.float32)
+        branches = []
+        if boxes:
+            ent = self.cands.get(it["id"]) if self.mode != "C" else None
+            if self.mode != "C":
+                if ent is None or [e["gt"] for e in ent] != boxes:
+                    raise GL.GeoError(f"{it['id']}: candidate manifest GT boxes != training target boxes")
+                cl = [e["cands"] for e in ent]
+            else:
+                cl = [[{"giou": 0.5, "box": [0, 0, 1, 1]}] * GL.K_CAND for _ in boxes]  # C: q만 필요 (1,0,..), 후보 미사용
+            bd = GL.build_branches(self.tok, tgt, self.dig, cl, self.mode)
+            if list(fid[npf:npf + len(bd["gt_ids"])]) != bd["gt_ids"]:
+                raise GL.GeoError("assistant tokens in chat sequence != standalone tokenization")
+            tokw[npf:npf + len(bd["gt_ids"])] = torch.tensor(GL.gt_token_weights(len(bd["gt_ids"]), bd["gt_spans"], bd["q0"]), dtype=torch.float32)
+            pre = fid[:npf]
+            tt = ex["token_type_ids"][:npf] if "token_type_ids" in ex else None
+            for br in bd["branches"]:
+                ids = torch.tensor(pre + br["ids"], dtype=torch.long)
+                lab = torch.full_like(ids, -100)
+                w = torch.zeros(len(ids), dtype=torch.float32)
+                lab[npf + br["span"][0]:npf + br["span"][1] + 1] = ids[npf + br["span"][0]:npf + br["span"][1] + 1]
+                w[npf + br["span"][0]:npf + br["span"][1] + 1] = br["w_per_token"]
+                d = {"input_ids": ids, "labels": lab, "tokw": w, "box": br["box"], "m": br["m"], "cand": br["cand"], "span": br["span"], "w_per_token": br["w_per_token"],
+                     "giou": br["giou"], "n_b": br["n_b"], "n_bm": br["n_bm"]}
+                if tt is not None:
+                    d["token_type_ids"] = torch.cat([tt, torch.zeros(len(ids) - npf, dtype=torch.long)])
+                branches.append(d)
+        ex["tokw"] = tokw
+        ex["branches"] = branches
+        ex["sample_pos"] = int(k)
+        return ex
+
+
+def collate(ex, pad_id):
+    import torch
+    br = [e["branches"] for e in ex]
+    tw = [e["tokw"] for e in ex]
+    out = sft_data.collate([{k: v for k, v in e.items() if k not in ("tokw", "branches")} for e in ex], pad_id)
+    t = torch.zeros((len(ex), out["input_ids"].shape[1]), dtype=torch.float32)
+    for i, w in enumerate(tw):
+        t[i, :len(w)] = w
+    out["tokw"] = t
+    out["branches"] = br
+    return out
+
+
+def branch_batch(torch, per_ex_branches, pixel_values, pad_id, sel):
+    """sel: [(example index, branch)] -> 모델 입력 dict (같은 영상의 pixel_values를 branch마다 복제)."""
+    L = max(len(b["input_ids"]) for _, b in sel)
+    B = len(sel)
+    ids = torch.full((B, L), pad_id, dtype=torch.long)
+    att = torch.zeros((B, L), dtype=torch.long)
+    lab = torch.full((B, L), -100, dtype=torch.long)
+    tw = torch.zeros((B, L), dtype=torch.float32)
+    has_tt = "token_type_ids" in sel[0][1]
+    tt = torch.zeros((B, L), dtype=torch.long) if has_tt else None
+    for r, (ei, b) in enumerate(sel):
+        n = len(b["input_ids"])
+        ids[r, :n], att[r, :n], lab[r, :n], tw[r, :n] = b["input_ids"], 1, b["labels"], b["tokw"]
+        if has_tt:
+            tt[r, :n] = b["token_type_ids"]
+    out = {"input_ids": ids, "attention_mask": att, "labels": lab, "tokw": tw, "pixel_values": torch.cat([pixel_values[ei:ei + 1] for ei, _ in sel], 0)}
+    if has_tt:
+        out["token_type_ids"] = tt
+    return out
+
+
+def geo_forward(torch, model, batch, softcap_unused=None):
+    """batch(cuda): labels/tokw 포함. returns (weighted_ce_sum(grad), unweighted_ce_sum(detached), n_tok). 전체 vocabulary softmax + 모델 softcap."""
+    b = dict(batch)
+    tw, labels = b.pop("tokw"), b.pop("labels")
+    b["pixel_values"] = b["pixel_values"].to(torch.bfloat16)
+    out = model.model(**b, use_cache=False)
+    h = out.last_hidden_state[:, :-1]
+    lab = labels[:, 1:]
+    sel = lab != -100
+    logits = model.lm_head(h[sel]).float()
+    sc = getattr(model.config.get_text_config(), "final_logit_softcapping", None)
+    if sc:
+        logits = torch.tanh(logits / sc) * sc
+    y, w = lab[sel], tw[:, 1:][sel]
+    if bool((w <= 0).any()):
+        raise RuntimeError("label position with non-positive weight")
+    ce = torch.logsumexp(logits, dim=-1) - logits.gather(1, y[:, None]).squeeze(1)
+    return (ce * w).sum(), ce.detach().sum(), int(sel.sum())
+
+
+def load_stage(path, protocol):
+    st = json.load(open(path))
+    miss = [k for k in STAGE_KEYS if k not in st]
+    if miss:
+        sys.exit(f"stage config missing keys {miss}")
+    locked = json.load(open(protocol))["locked"]["files"]
+    for k in (path, st["parent_adapter"], st["train_ids"], st["val_ids"], st["cand_manifest"]):
+        if os.path.relpath(k) not in locked:
+            sys.exit(f"{k} is not a locked protocol file")
+    if hashlib.sha256(open(st["parent_adapter"], "rb").read()).hexdigest() != st["parent_adapter_sha256"]:
+        sys.exit("parent adapter file sha256 != stage config")
+    if hashlib.sha256(open(st["cand_manifest"], "rb").read()).hexdigest() != st["cand_manifest_sha256"]:
+        sys.exit("candidate manifest sha256 != stage config")
+    return st
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--run-dir", required=True)
+    ap.add_argument("--stage-config", required=True)
+    ap.add_argument("--loss", required=True, choices=["C", "U", "G"])
+    ap.add_argument("--lr", type=float, required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--microbatch", type=int, default=2)
+    ap.add_argument("--branch-microbatch", type=int, default=4)
+    ap.add_argument("--ckpt-every", type=int, default=50)
+    ap.add_argument("--workers", type=int, default=3)
+    ap.add_argument("--max-steps", type=int, default=None, help="test: 이 optimizer step까지만 (checkpoint 저장 후 종료)")
+    ap.add_argument("--stop-after-step", type=int, default=None, help="test: 정기 checkpoint step 직후 비정상 종료 (재개 검사)")
+    ap.add_argument("--deterministic", action="store_true", help="검사 전용: 결정적 kernel (선택·본실험 금지)")
+    ap.add_argument("--stop-in-validation", type=int, default=None)
+    a = ap.parse_args()
+    if a.deterministic:
+        os.environ["CUBLAS_WORKSPACE_CONFIG"] = ":4096:8"
+    pdig = lock_protocol.verify(a.protocol)
+    st = load_stage(a.stage_config, a.protocol)
+    if a.lr not in st["allowed_lrs"]:
+        sys.exit(f"lr {a.lr} not in stage allowed_lrs {st['allowed_lrs']}")
+    os.makedirs(a.run_dir, exist_ok=True)
+    lk, own, reclaimed = queue_lock.try_lock(os.path.join(os.path.realpath(a.run_dir), "train.lock"), queue_lock.my_info(role="adapt_geo"))
+    if lk is None:
+        sys.exit(f"run-dir {a.run_dir} is owned by another live process: {own}")
+    T.LOCK_FD[0] = lk.fd
+    try:
+        run(a, st, pdig, reclaimed)
+    finally:
+        lk.release()
+
+
+def run(a, st, pdig, reclaimed_lock):
+    import torch
+    train_items, gt = inputs.load_items(T.MANIFEST, T.GT, st["train_ids"], "train", exact=False)
+    val_items = inputs.load_items(T.MANIFEST, T.GT, st["val_ids"], "validation", exact=False)[0] if st["validate"] else []
+    t_in = inputs.inputs_digest(train_items, gt)
+    v_in = inputs.inputs_digest(val_items, gt) if val_items else None
+    cands = json.load(open(st["cand_manifest"]))
+    edges = sft_eval.area_edges(gt, [i for i in gt if gt[i]["split"] == "train"])
+    if a.deterministic:
+        T.set_deterministic(torch)
+    seed = st["seed"]
+    T.seed_all(torch, seed)
+    _, proc, model, names = T.setup_model(seed)
+    tok = proc.tokenizer
+    dig_ids = CL.digit_ids(tok)
+    softcap = getattr(model.config.get_text_config(), "final_logit_softcapping", None)
+    pblob = torch.load(st["parent_adapter"], map_location="cpu", weights_only=True)
+    if lora.state_digest(pblob["state"]) != st["parent_adapter_digest"] or pblob.get("digest") != st["parent_adapter_digest"]:
+        sys.exit("parent adapter digest != stage config")
+    if pblob["config"] != {"r": T.CFG["r"], "alpha": T.CFG["alpha"]}:
+        sys.exit("parent adapter rank/alpha != trainer config")
+    lora.load_lora_state(model, pblob["state"])
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+    model.config.use_cache = False
+    params = list(lora.lora_params(model).values())
+    env = generate.env_info(torch, proc, model)
+    cdig, _ = generate.config_digest(env, {"concise": P.CONCISE})
+    full_cd, _ = generate.config_digest(env, P.all_prompts())
+    if full_cd != json.load(open(a.protocol))["locked"]["generation_config_digest"]:
+        sys.exit("runtime generation config digest != protocol")
+    eb = st["eff_batch"]
+    n_tr = len(train_items)
+    spe = math.ceil(n_tr / eb)
+    total = spe * st["epochs"]
+    cfg = dict(T.CFG, lr=a.lr, seed=seed, microbatch=a.microbatch, branch_microbatch=a.branch_microbatch, eff_batch=eb, n_train=n_tr, n_val=len(val_items), stage=st,
+               stage_config_sha256=migrate.file_sha(a.stage_config), loss_mode=a.loss, total_updates=total, steps_per_epoch=spe,
+               geo={"gamma": GL.GAMMA, "giou_min": GL.GIOU_MIN, "k": GL.K_CAND, "seed_tag": GL.SEED_TAG, "cand_manifest_sha256": st["cand_manifest_sha256"],
+                    "norm": "L=[CE_outside_spans + sum_b n_b sum_m q_bm ell_bm]/N", "q": {"C": "q0=1", "U": "q0=1/Z,q_m=(1-q0)/4", "G": "q=r/Z"}},
+               model_revision=generate.MODEL_REVISION, protocol_digest=pdig, n_lora_targets=len(names), n_trainable=sum(p.numel() for p in params),
+               train_inputs_digest=t_in, val_inputs_digest=v_in, deterministic=bool(a.deterministic), optimizer_init="fresh AdamW (parent optimizer not resumed)",
+               dataloader_rng="torch.Generator seeded seed*1000+epoch")
+    tdig = migrate.cfg_digest(cfg)
+    cfg_path = os.path.join(a.run_dir, "train_config.json")
+    if os.path.exists(cfg_path):
+        if json.load(open(cfg_path))["train_digest"] != tdig:
+            sys.exit("train config differs from existing run_dir (refusing to resume/overwrite)")
+    else:
+        json.dump({"train_digest": tdig, "config": cfg, "env": env}, open(cfg_path, "w"), indent=1, default=str)
+    opt = torch.optim.AdamW(params, lr=a.lr, betas=tuple(T.CFG["betas"]), eps=T.CFG["eps"], weight_decay=T.CFG["weight_decay"])
+    step, epoch0, pos0 = 0, 0, 0
+    ck = os.path.join(a.run_dir, "ckpt_latest.pt")
+    logf = open(os.path.join(a.run_dir, "train_log.jsonl"), "a")
+
+    def log_event(**kw):
+        logf.write(json.dumps({"ts": time.time(), **kw}) + "\n")
+        logf.flush()
+
+    def save_ckpt(epoch, pos, val_pending=None):
+        dg = T.live_digests(torch, model, opt)
+        T.atomic_save(torch, {"lora": lora.lora_state_dict(model), "optimizer": opt.state_dict(), "step": step, "epoch": epoch, "pos_in_epoch": pos,
+                              "rng": T.rng_state(torch), "train_digest": tdig, "val_pending_epoch": val_pending, "loss_mode": a.loss,
+                              "base_revision": generate.MODEL_REVISION, "protocol_digest": pdig, "digests": dg}, ck)
+        log_event(event="checkpoint", step=step, epoch=epoch, pos=pos, digests=dg)
+
+    if os.path.exists(ck):
+        blob = torch.load(ck, map_location="cpu", weights_only=False)
+        if blob["train_digest"] != tdig or blob["base_revision"] != generate.MODEL_REVISION or blob["protocol_digest"] != pdig or blob["loss_mode"] != a.loss:
+            sys.exit("checkpoint provenance mismatch")
+        lora.load_lora_state(model, blob["lora"])
+        opt.load_state_dict(blob["optimizer"])
+        step, epoch0, pos0 = blob["step"], blob["epoch"], blob["pos_in_epoch"]
+        T.set_rng_state(torch, blob["rng"])
+        restored = T.live_digests(torch, model, opt)
+        if restored != blob["digests"]:
+            sys.exit(f"restored state != saved checkpoint state: saved {blob['digests']} restored {restored}")
+        print(f"resumed step={step} epoch={epoch0} pos={pos0}", flush=True)
+        log_event(event="resume", step=step, epoch=epoch0, pos=pos0, stale_lock_reclaimed=bool(reclaimed_lock), restored_digests=restored, restored_equals_saved=True)
+    t0 = time.time()
+
+    def verify_existing_val(e):
+        select.verify_epoch(a.run_dir, e, json.load(open(cfg_path)), v_in, a.protocol, val_items, gt)
+
+    def validate_epoch(e, from_file, stop_after=None):
+        epoch_dir = os.path.join(a.run_dir, f"epoch_{e:02d}")
+        vm = os.path.join(epoch_dir, "val_metrics.json")
+        if os.path.exists(vm):
+            verify_existing_val(e)
+            return
+        rng_before = T.rng_state(torch)
+        pre = T.live_digests(torch, model, opt)
+        snap = lora.lora_state_dict(model) if from_file else None
+        if from_file:
+            ba = torch.load(os.path.join(epoch_dir, "adapter.pt"), map_location="cpu", weights_only=True)
+            if lora.state_digest(ba["state"]) != ba["digest"]:
+                raise RuntimeError(f"epoch {e} adapter file digest mismatch")
+            lora.load_lora_state(model, ba["state"])
+        adig = lora.state_digest(lora.lora_state_dict(model))
+        torch.cuda.reset_peak_memory_stats()
+        vl, vn = T.val_loss(torch, model, proc, val_items, gt, softcap, P.CONCISE)
+        summ = T.run_validation(torch, proc, model, env, cdig, pdig, val_items, gt, edges, os.path.join(epoch_dir, "val_gen"), e, adig,
+                                os.path.basename(a.run_dir), v_in, stop_after)
+        summ.update({"val_loss": vl, "val_loss_tokens": vn, "epoch": e, "step": e * spe, "adapter_digest": adig, "lr": a.lr, "seed": seed,
+                     "train_digest": tdig, "val_inputs_digest": v_in, "protocol_digest": pdig})
+        T.atomic_json(summ, vm)
+        if from_file:
+            lora.load_lora_state(model, snap)
+        T.set_rng_state(torch, rng_before)
+        post = T.live_digests(torch, model, opt)
+        if post != pre:
+            raise RuntimeError(f"validation changed training state: before {pre} after {post}")
+        log_event(event="validation_done", epoch=e, val_loss=vl, utility=summ["utility"], recovered_from_file=from_file, state_unchanged=True, digests=post)
+        print(f"epoch {e}: val_loss {vl:.4f} f1@.3 {summ['f1@0.3']:.4f} f1@.5 {summ['f1@0.5']:.4f}", flush=True)
+
+    mil = set(st.get("milestone_epochs") or range(1, st["epochs"] + 1))
+    if val_items:
+        for e in sorted(mil):
+            if e > epoch0:
+                continue
+            ed = os.path.join(a.run_dir, f"epoch_{e:02d}")
+            if not os.path.exists(os.path.join(ed, "adapter.pt")):
+                raise RuntimeError(f"epoch {e} adapter missing although checkpoint is at epoch {epoch0}")
+            if not os.path.exists(os.path.join(ed, "val_metrics.json")):
+                print(f"recovering pending validation for epoch {e}", flush=True)
+                validate_epoch(e, from_file=True)
+            else:
+                verify_existing_val(e)
+    for epoch in range(epoch0, st["epochs"]):
+        order = np.random.default_rng(seed * 1000 + epoch).permutation(n_tr)
+        start_pos = pos0 if epoch == epoch0 else 0
+        ds = GeoDataset(tok, proc, train_items, gt, P.CONCISE, order, dig_ids, a.loss, cands)
+        dl_gen = torch.Generator()
+        dl_gen.manual_seed(seed * 1000 + epoch)
+        dl = torch.utils.data.DataLoader(torch.utils.data.Subset(ds, list(range(start_pos * eb, n_tr))), batch_size=a.microbatch, shuffle=False,
+                                         num_workers=a.workers, collate_fn=lambda ex: collate(ex, tok.pad_token_id), prefetch_factor=2 if a.workers else None,
+                                         worker_init_fn=T.close_lock_fd, generator=dl_gen)
+        model.train()
+        it = iter(dl)
+        for s in range(start_pos, spe):
+            grp = order[s * eb:(s + 1) * eb]
+            tot_tok = sum(T.label_count(tok, sft_data.target_text([b["yxyx_norm"] for b in gt[train_items[j]["id"]]["boxes"]])) for j in grp)
+            lr = A.lr_at(step, total, a.lr, st["warmup_frac"])
+            for g in opt.param_groups:
+                g["lr"] = lr
+            rng_before, opt_step_before = T.rng_digest(torch), T.opt_step_count(opt)
+            if not model.training:
+                raise RuntimeError("model not in train mode at optimizer step")
+            acc = {"gt_w": 0.0, "gt_ce": 0.0, "br_w": 0.0, "br_ce": 0.0}
+            ntok_seen = n_branch = n_branch_tok = 0
+            seen_pos, tok_h, br_h = [], hashlib.sha256(), hashlib.sha256()
+            for _ in range(math.ceil(len(grp) / a.microbatch)):
+                b = next(it)
+                seen_pos += b.pop("sample_pos").tolist()
+                per_ex = b.pop("branches")
+                tok_h.update(T.batch_token_digest({k: v for k, v in b.items() if k != "tokw"}).digest())
+                tok_h.update(b["tokw"].contiguous().numpy().tobytes())
+                flat = [(ei, br) for ei, lst in enumerate(per_ex) for br in lst]
+                for _, br in flat:
+                    br_h.update(json.dumps([br["box"], br["m"], br["cand"], br["span"], round(br["w_per_token"], 12)]).encode())
+                    br_h.update(br["input_ids"].numpy().tobytes())
+                pv_cpu = b["pixel_values"]
+                bg = {k: v.cuda() for k, v in b.items()}
+                w_sum, ce_sum, nt = geo_forward(torch, model, bg, softcap)
+                (w_sum / tot_tok).backward()
+                acc["gt_w"] += float(w_sum.detach()) / tot_tok
+                acc["gt_ce"] += float(ce_sum) / tot_tok
+                ntok_seen += nt
+                del bg, w_sum, ce_sum
+                for c0 in range(0, len(flat), a.branch_microbatch):
+                    chunk = flat[c0:c0 + a.branch_microbatch]
+                    bb = {k: v.cuda() for k, v in branch_batch(torch, per_ex, pv_cpu, tok.pad_token_id, chunk).items()}
+                    w_sum, ce_sum, nt = geo_forward(torch, model, bb, softcap)
+                    (w_sum / tot_tok).backward()
+                    acc["br_w"] += float(w_sum.detach()) / tot_tok
+                    acc["br_ce"] += float(ce_sum) / tot_tok
+                    n_branch += len(chunk)
+                    n_branch_tok += nt
+                    del bb, w_sum, ce_sum
+            if ntok_seen != tot_tok:
+                raise RuntimeError(f"label token count mismatch {ntok_seen} != {tot_tok}")
+            planned = [train_items[j]["id"] for j in grp]
+            actual = [train_items[order[p]]["id"] for p in seen_pos]
+            if actual != planned or seen_pos != list(range(s * eb, s * eb + len(grp))):
+                raise RuntimeError(f"step {step + 1}: DataLoader batch != planned batch")
+            gn = float(torch.nn.utils.clip_grad_norm_(params, T.CFG["grad_clip"]))
+            loss_total = acc["gt_w"] + acc["br_w"]
+            if not math.isfinite(gn) or not math.isfinite(loss_total):
+                raise RuntimeError(f"non-finite loss/grad at step {step}: {loss_total} {gn}")
+            opt.step()
+            opt.zero_grad(set_to_none=True)
+            step += 1
+            logf.write(json.dumps({"step": step, "epoch": epoch + 1, "pos": s + 1, "loss": loss_total, "gt_weighted_ce": acc["gt_w"], "gt_unweighted_ce": acc["gt_ce"],
+                                   "branch_weighted_ce": acc["br_w"], "branch_unweighted_ce": acc["br_ce"], "n_branches": n_branch, "n_branch_label_tokens": n_branch_tok,
+                                   "n_label_tokens": tot_tok, "grad_norm": gn, "lr": lr, "n_examples": len(grp), "elapsed_s": time.time() - t0,
+                                   "peak_mem_gb": torch.cuda.max_memory_allocated() / 2 ** 30, "batch_ids": actual, "batch_token_sha": tok_h.hexdigest()[:24],
+                                   "branch_sha": br_h.hexdigest()[:24], "rng_before": rng_before, "opt_step_before": opt_step_before, "train_mode": True}) + "\n")
+            logf.flush()
+            saved = False
+            if step % a.ckpt_every == 0 and (s + 1) < spe:
+                save_ckpt(epoch, s + 1)
+                saved = True
+            if a.stop_after_step is not None and step == a.stop_after_step:
+                if not saved:
+                    raise RuntimeError("--stop-after-step must coincide with a regular mid-epoch checkpoint step")
+                print("test stop after mid-epoch step checkpoint", flush=True)
+                os._exit(5)
+            if a.max_steps is not None and step >= a.max_steps:
+                save_ckpt(epoch, s + 1)
+                print("max-steps reached", flush=True)
+                return
+        del dl, it
+        ed = os.path.join(a.run_dir, f"epoch_{epoch + 1:02d}")
+        T.save_adapter(torch, model, os.path.join(ed, "adapter.pt"), {"epoch": epoch + 1, "step": step, "train_digest": tdig})
+        do_val = bool(val_items) and (epoch + 1) in mil
+        save_ckpt(epoch + 1, 0, val_pending=epoch + 1 if do_val else None)
+        if do_val:
+            validate_epoch(epoch + 1, from_file=False, stop_after=a.stop_in_validation)
+        pos0 = 0
+    print("training complete", flush=True)
+    T.atomic_json({"status": "complete", "steps": step, "loss_mode": a.loss, "train_digest": tdig, "wall_s": time.time() - t0}, os.path.join(a.run_dir, "done.json"))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/gen_compare.py b/rsna_diag/gen_compare.py
new file mode 100644
index 0000000..8a2fd5b
--- /dev/null
+++ b/rsna_diag/gen_compare.py
@@ -0,0 +1,37 @@
+"""1-worker vs 2-worker 생성 pilot 비교 요약. 사용: python -m rsna_diag.gen_compare W1_DIR W2_DIR OUT"""
+import glob
+import json
+import sys
+
+
+def load(d):
+    out = {}
+    for f in glob.glob(f"{d}/gen_worker*.jsonl"):
+        for line in open(f):
+            r = json.loads(line)
+            out[r["id"]] = r
+    return out
+
+
+def peak(d):
+    m = 0
+    for line in open(f"{d}/resource_log.jsonl"):
+        for g in json.loads(line)["gpus"]:
+            m = max(m, g["mem_used_mib"])
+    return m
+
+
+def main():
+    d1, d2, out = sys.argv[1:4]
+    a, b = load(d1), load(d2)
+    w1, w2 = (json.load(open(f"{d}/last_run.json"))["wall_s"] for d in (d1, d2))
+    res = {"n_requests": len(a), "w1_wall_s": w1, "w2_wall_s": w2, "req_per_min_w1": len(a) / w1 * 60, "req_per_min_w2": len(b) / w2 * 60,
+           "greedy_token_identical": sum(a[k]["suffix_ids"] == b[k]["suffix_ids"] for k in a if k in b), "id_set_mismatch": len(set(a) ^ set(b)),
+           "gpu_peak_used_mib_w1": peak(d1), "gpu_peak_used_mib_w2": peak(d2), "worker_peak_alloc_gb_max_w2": max(r["peak_mem_alloc_gb_max"] for r in b.values()),
+           "max_output_tokens_w2": max(r["n_output_tokens"] for r in b.values()), "all_eos_w2": all(r["ended_eos"] for r in b.values())}
+    json.dump(res, open(out, "w"), indent=1)
+    print(res)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/geo_cands.py b/rsna_diag/geo_cands.py
new file mode 100644
index 0000000..9e6e300
--- /dev/null
+++ b/rsna_diag/geo_cands.py
@@ -0,0 +1,101 @@
+"""iter_014 후보(pseudo-box) manifest. 사용: python -m rsna_diag.geo_cands --out-dir results/iter_014/candidates
+
+train 2,400 전체의 양성 환자 GT box(sft_data.target_boxes의 정렬 순서 = 학습 target의 box index)마다 4개 후보를 결정적으로 만들고
+확보율·GIoU·변위·면적비·token 길이 분포를 GT box 크기 삼분위(train 기준)별로 보고한다. 4개를 못 얻으면 준비 gate 중단.
+U/G가 같은 manifest를 쓴다 (환자 ID·box index·고정 seed로 RNG).
+"""
+import argparse
+import hashlib
+import json
+import os
+
+import numpy as np
+
+from . import coord_loss as CL, geo_loss as GL, sft_data
+
+GT = "results/iter_010/manifests/gt_manifest.json"
+TRAIN_IDS = "results/iter_010/manifests/train_ids.json"
+
+
+def build(gt, ids, tok=None):
+    man, fails, stats = {}, [], []
+    for pid in ids:
+        if gt[pid]["category"] != "opacity":
+            continue
+        boxes = sft_data.target_boxes([b["yxyx_norm"] for b in gt[pid]["boxes"]])
+        ent = []
+        for b, gb in enumerate(boxes):
+            try:
+                cands, n = GL.gen_candidates(pid, b, gb)
+            except GL.GeoError as e:
+                fails.append({"id": pid, "box": b, "gt": gb, "error": str(e)})
+                continue
+            recs = [GL.cand_record(gb, c) for c in cands]
+            ent.append({"gt": gb, "cands": recs, "n_proposals": n})
+            stats.append((pid, b, gb, n, recs))
+        man[pid] = ent
+    return man, fails, stats
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out-dir", required=True)
+    a = ap.parse_args()
+    gt = json.load(open(GT))
+    ids = sorted(json.load(open(TRAIN_IDS)))
+    man, fails, stats = build(gt, ids)
+    os.makedirs(a.out_dir, exist_ok=True)
+    rep = {"seed_tag": GL.SEED_TAG, "k": GL.K_CAND, "giou_min": GL.GIOU_MIN, "shift_frac": GL.SHIFT_FRAC, "scale_range": GL.SCALE_RANGE,
+           "max_proposals": GL.MAX_PROPOSALS, "grid": "1/1000 integer (R-VLM original: 1/100)", "n_patients": len(man), "n_boxes": len(stats), "n_failed_boxes": len(fails),
+           "failed": fails}
+    if fails:
+        json.dump(rep, open(os.path.join(a.out_dir, "candidate_report_FAILED.json"), "w"), indent=1)
+        raise SystemExit(f"candidate gate FAILED: {len(fails)} boxes lack {GL.K_CAND} candidates (see candidate_report_FAILED.json)")
+    areas = np.array([(g[2] - g[0]) * (g[3] - g[1]) / 1e6 for _, _, g, _, _ in stats])
+    edges = [float(np.quantile(areas, 1 / 3)), float(np.quantile(areas, 2 / 3))]
+    tier = np.digitize(areas, edges)
+    rep["box_area_tertile_edges"] = edges
+
+    def dist(x):
+        x = np.asarray(x, float)
+        return {"mean": float(x.mean()), "min": float(x.min()), "q05": float(np.quantile(x, .05)), "median": float(np.median(x)), "q95": float(np.quantile(x, .95)), "max": float(x.max())}
+
+    by = {}
+    for t, name in enumerate(("small", "medium", "large")):
+        sel = [s for s, k in zip(stats, tier) if k == t]
+        by[name] = {"n_boxes": len(sel), "acceptance_rate": dist([4 / s[3] for s in sel]), "n_proposals": dist([s[3] for s in sel]),
+                    "giou": dist([c["giou"] for s in sel for c in s[4]]), "area_ratio": dist([c["area_ratio"] for s in sel for c in s[4]]),
+                    "disp_units": dist([c["disp"] for s in sel for c in s[4]]),
+                    "r_weight": dist([1 + GL.GAMMA * np.log(c["giou"]) for s in sel for c in s[4]])}
+    rep["by_gt_box_size"] = by
+    # token 길이 (span n_bm vs n_b): tokenizer 필요
+    from transformers import AutoTokenizer
+    from . import generate
+    tok = AutoTokenizer.from_pretrained("google/medgemma-1.5-4b-it", revision=generate.MODEL_REVISION)
+    dig = CL.digit_ids(tok)
+    lens = {"same": 0, "cand_longer": 0, "cand_shorter": 0}
+    dl = []
+    for pid in list(man)[:]:
+        tgt = sft_data.target_text([b["yxyx_norm"] for b in gt[pid]["boxes"]])
+        ids_, spans = GL.box_token_spans(tok, tgt, dig)
+        for b, e in enumerate(man[pid]):
+            assert e["gt"] == json.loads(tgt)[b]["box_2d"]
+            nb = spans[b][1] - spans[b][0] + 1
+            for c in e["cands"]:
+                ctext = GL.replace_box_text(tgt, b, c["box"])
+                cids, cs = GL.box_token_spans(tok, ctext, dig)
+                nbm = cs[b][1] - cs[b][0] + 1
+                dl.append(nbm - nb)
+                lens["same" if nbm == nb else "cand_longer" if nbm > nb else "cand_shorter"] += 1
+    rep["token_span_length"] = {"cand_vs_gt": lens, "delta_dist": dist(dl), "note": "n_bm - n_b (tokens, incl. bracket/whitespace tokens)"}
+    blob = json.dumps(man, sort_keys=True)
+    rep["manifest_sha256"] = hashlib.sha256(blob.encode()).hexdigest()
+    json.dump(man, open(os.path.join(a.out_dir, "train_candidates.json"), "w"), sort_keys=True)
+    json.dump(rep, open(os.path.join(a.out_dir, "candidate_report.json"), "w"), indent=1)
+    print(json.dumps({k: rep[k] for k in ("n_patients", "n_boxes", "n_failed_boxes", "manifest_sha256")}), json.dumps(rep["token_span_length"]))
+    for k, v in by.items():
+        print(k, v["n_boxes"], "accept", v["acceptance_rate"]["mean"], "min-accept", v["acceptance_rate"]["min"], "giou", v["giou"]["median"])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/geo_decide.py b/rsna_diag/geo_decide.py
new file mode 100644
index 0000000..1864f50
--- /dev/null
+++ b/rsna_diag/geo_decide.py
@@ -0,0 +1,100 @@
+"""iter_014 사전 고정 판정 규칙 (report.json -> decision.json). 결과를 본 뒤 규칙을 바꾸지 않는다. 사용: python -m rsna_diag.geo_decide explore|full --report R --out O
+
+비교 기준(baseline) checkpoint: G는 V200 선택 checkpoint(guardrail 통과 최대 S_loc)만 쓴다. 선택이 없으면 selected=null, selection_eligible=false이며
+final 점수는 별도 필드이고 확대 판정에 대체 사용하지 않는다. C·U에 선택 후보가 없을 때만 보수적 대체(V200 최고 S_loc checkpoint, guardrail 무시; G에는 불리한 기준)를 쓰고
+대체 사실을 표시한다.
+
+일반 확대: G 선택 checkpoint의 V400 guardrail 통과 AND G-C S_loc >= 0.03 AND G-U S_loc >= 0.01 AND G-C F1@0.5 > 0 (모두 V400 선택 checkpoint 기준).
+  최종 대 최종 결과의 G-C, G-U 부호가 선택 결과와 반대(선택 >0 인데 최종 <= 0)이면 자동 확대를 보류한다.
+보완 확대(1회): G가 V200·V400 guardrail을 통과(선택 존재), G-U 점추정 > 0, G-C F1@0.5 > 0, G-C paired 95% CI 상한 >= 0.03, G의 V200 마지막 milestone 간 S_loc 상승 >= 0.01
+  (explore: update150->225, full: update300->450)이면 full-train으로 한 번 확대할 수 있다. 선택 부재·guardrail 실패는 이 경로로 우회하지 않는다.
+"""
+import argparse
+import json
+
+from . import select as SEL
+
+GAP_C, GAP_U, LAST_GAIN = 0.03, 0.01, 0.01
+
+
+def baseline_point(t):
+    """trajectory entry -> dict(S_loc, f1@0.5, tag, substituted). 선택이 있으면 선택, 없으면 V200 최고 S_loc checkpoint의 V400 결과가 있어야 한다(없으면 None)."""
+    if t.get("selected"):
+        e = t["selected"]
+        return {"S_loc": e["v400"]["S_loc"], "f1@0.5": e["v400"]["f1@0.5"], "tag": "selected", "substituted": False, "epoch": e["epoch"]}
+    b = t.get("v200_best_fallback")
+    if b:
+        return {"S_loc": b["v400"]["S_loc"], "f1@0.5": b["v400"]["f1@0.5"], "tag": "v200_best_no_guardrail(fallback)", "substituted": True, "epoch": b["epoch"]}
+    return None
+
+
+def final_point(t):
+    e = t.get("final")
+    return {"S_loc": e["v400"]["S_loc"], "f1@0.5": e["v400"]["f1@0.5"], "epoch": e["epoch"]} if e else None
+
+
+def decide(rep, mode, tags=("C", "U", "G")):
+    tr = rep["trajectories"]
+    key = lambda c: next((k for k in tr if k.split("@")[0] == c), None)
+    kc, ku, kg = (key(c) for c in tags)
+    out = {"rule": __doc__.split("\n")[2:14], "mode": mode, "trajectories": {"C": kc, "U": ku, "G": kg}}
+    if not (kc and ku and kg):
+        return {**out, "error": "C, U or G trajectory missing", "expand": False}
+    C, U, G = tr[kc], tr[ku], tr[kg]
+    g_sel = G.get("selected")
+    out["G_selected"] = None if not g_sel else {"epoch": g_sel["epoch"], "update": g_sel["update"], "S_loc_v400": g_sel["v400"]["S_loc"]}
+    out["G_selection_eligible"] = bool(g_sel)
+    out["G_final"] = final_point(G)
+    out["G_final_guardrail_v400_ok"] = G["final"]["guardrail_v400"]["ok"] if G.get("final") else None
+    out["G_selected_guardrail_v400_ok"] = g_sel["guardrail_v400"]["ok"] if g_sel else None
+    cb, ub, gb = baseline_point(C), baseline_point(U), baseline_point(G)
+    out["C_baseline"], out["U_baseline"] = cb, ub
+    out["C_final"], out["U_final"] = final_point(C), final_point(U)
+    if not g_sel or cb is None or ub is None:
+        out.update({"expand": False, "reason": "G has no eligible selected checkpoint (or C/U reference unavailable): no automatic expansion, no substitution by final"})
+        return out
+    ci = rep["pairwise_v400_paired_bootstrap"]["selected"].get(f"{kg}-{kc}")
+    d_gc, d_gu = gb["S_loc"] - cb["S_loc"], gb["S_loc"] - ub["S_loc"]
+    d_f05 = gb["f1@0.5"] - cb["f1@0.5"]
+    g_guard = bool(g_sel["guardrail_v400"]["ok"])
+    fin = {}
+    if out["G_final"] and out["C_final"] and out["U_final"]:
+        fin = {"G-C": out["G_final"]["S_loc"] - out["C_final"]["S_loc"], "G-U": out["G_final"]["S_loc"] - out["U_final"]["S_loc"],
+               "G-C_f1@0.5": out["G_final"]["f1@0.5"] - out["C_final"]["f1@0.5"]}
+    v = G["v200_detail_by_epoch"]
+    eps = sorted(int(e) for e in v)
+    last_gain = v[str(eps[-1])]["S_loc"] - v[str(eps[-2])]["S_loc"]
+    out.update({"G_minus_C": d_gc, "G_minus_U": d_gu, "G_minus_C_f1@0.5": d_f05, "paired_ci_G_minus_C": ci, "G_v200_last_interval_gain": last_gain, "G_guardrail_v400_ok": g_guard,
+                "final_vs_final": fin, "U_minus_C": ub["S_loc"] - cb["S_loc"]})
+    general = g_guard and d_gc >= GAP_C and d_gu >= GAP_U and d_f05 > 0
+    opposite = bool(fin) and (fin["G-C"] <= 0 or fin["G-U"] <= 0)
+    supplement = g_guard and d_gu > 0 and d_f05 > 0 and ci is not None and ci["ci95"][1] >= GAP_C and last_gain >= LAST_GAIN
+    out["general_criteria_met"] = bool(general)
+    out["supplement_criteria_met"] = bool(supplement)
+    out["final_opposes_selected"] = opposite
+    if general and opposite:
+        out.update({"expand": False, "reason": "general criteria met on selected checkpoints but final-vs-final has opposite sign: automatic expansion held, review checkpoint trend"})
+    elif general:
+        out.update({"expand": True, "expand_path": "general", "reason": f"G-C {d_gc:.4f} >= 0.03, G-U {d_gu:.4f} >= 0.01, G-C F1@0.5 {d_f05:.4f} > 0, guardrail ok"})
+    elif supplement and mode == "explore":
+        out.update({"expand": True, "expand_path": "supplement(once)", "reason": f"G-C {d_gc:.4f} < 0.03 but CI upper {ci['ci95'][1]:.4f} >= 0.03, G-U {d_gu:.4f} > 0, F1@0.5 {d_f05:.4f} > 0, last-interval gain {last_gain:.4f} >= 0.01"})
+    else:
+        out.update({"expand": False, "reason": f"G-C {d_gc:.4f}, G-U {d_gu:.4f}, G-C F1@0.5 {d_f05:.4f}, guardrail {g_guard}, CI upper {ci['ci95'][1] if ci else None}, last gain {last_gain:.4f}: below criteria"})
+    if mode == "full":
+        out["next"] = "C_compute" if out["expand"] and out.get("expand_path") == "general" else "stop"
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("mode", choices=["explore", "full"])
+    ap.add_argument("--report", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    rep = json.load(open(a.report))
+    dec = {"mode": a.mode, "report": a.report, "report_sha256": SEL.file_sha(a.report), "decision": decide(rep, a.mode)}
+    print(SEL.write_or_verify(a.out, json.loads(json.dumps(dec))), json.dumps(dec["decision"], indent=1)[:2500])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/geo_loss.py b/rsna_diag/geo_loss.py
new file mode 100644
index 0000000..c310611
--- /dev/null
+++ b/rsna_diag/geo_loss.py
@@ -0,0 +1,223 @@
+"""iter_014: R-VLM 계열 GIoU 가중 pseudo-box supervision(G), GT 질량을 맞춘 균등 대조(U), 직접 SFT(C)의 후보·span·가중치·branch 구성.
+
+GT box b 하나마다 pseudo-box 4개(m=1..4)를 만들고, m=0은 GT다. 손실(모든 조건 공통):
+    L = [ CE_outside_GT_spans + sum_b n_b * sum_m q_bm * ell_bm ] / N
+  ell_bm = 후보 m의 `box_2d` 배열 span 평균 NLL(전체 vocabulary softmax, softcap 유지), n_b = GT span token 수, N = GT assistant token 수.
+  r_b0 = 1, r_bm = 1 + 0.5 ln GIoU(cand, GT_b), Z_b = sum_m r_bm.  G: q = r/Z.  U: q_b0 = 1/Z, q_bm = (1 - q_b0)/4.  C: q_b0 = 1.
+GT branch는 원래 GT 전체 sequence에 token별 가중치(span 밖 1, span b 안 q_b0)를 곱한 CE다 (n_b * q_b0 * mean = q_b0 * sum).
+후보 branch는 [prompt + GT의 box b 이전 token prefix + 후보 span]까지의 sequence이고 span token에만 가중치 n_b*q_bm/n_bm을 준다.
+후보 span 뒤 suffix는 loss에 쓰지 않으며 causal attention 때문에 span logit에 영향이 없으므로 잘라서 계산한다 (실제 모델로 검증: 테스트).
+
+span 규약: `box_2d` 좌표 배열의 시작 `[`부터 끝 `]`까지. tokenizer가 앞 공백(" [")과 뒤 쉼표("],")를 같은 token으로 합치므로,
+그 token들은 span에 포함하되 경계 걸침이 정확히 그 두 문자(앞 공백 최대 1, 뒤 쉼표 1)일 때만 허용하고 그 외는 예외다 (조용히 자르지 않는다).
+"""
+import hashlib
+import json
+import math
+
+import numpy as np
+
+SEED_TAG = "iter014-cand-v1"
+K_CAND = 4
+GIOU_MIN = 0.3
+GAMMA = 0.5
+SHIFT_FRAC = 0.3
+SCALE_RANGE = (0.8, 1.2)
+MAX_PROPOSALS = 10000
+
+
+class GeoError(RuntimeError):
+    pass
+
+
+# ---------- 기하 ----------
+def giou(a, b):
+    """[y0,x0,y1,x1] 정수 box 두 개의 GIoU (float64, 정수 면적 계산)."""
+    ay0, ax0, ay1, ax1 = a
+    by0, bx0, by1, bx1 = b
+    ia = max(0, min(ay1, by1) - max(ay0, by0)) * max(0, min(ax1, bx1) - max(ax0, bx0))
+    aa, ab = (ay1 - ay0) * (ax1 - ax0), (by1 - by0) * (bx1 - bx0)
+    u = aa + ab - ia
+    c = (max(ay1, by1) - min(ay0, by0)) * (max(ax1, bx1) - min(ax0, bx0))
+    if u <= 0 or c <= 0:
+        raise GeoError(f"degenerate box {a} {b}")
+    return ia / u - (c - u) / c
+
+
+def _rng(pid, b):
+    h = hashlib.sha256(f"{SEED_TAG}|{pid}|{b}".encode()).digest()
+    return np.random.default_rng(int.from_bytes(h[:8], "little"))
+
+
+def gen_candidates(pid, b, gt_box, k=K_CAND):
+    """GT box(정수 yxyx) 하나에 대한 결정적 후보 k개. returns (cands, n_proposals). 10,000 proposal 안에 k개가 안 나오면 GeoError (대체 금지).
+    proposal: 폭·높이에 비례한 shift U(-0.3,0.3) 및 scale U(0.8,1.2)(축별 독립), [0,1000] clipping, 1/1000 격자 반올림 뒤 GIoU>=0.3, GT·중복 제외."""
+    rng = _rng(pid, b)
+    y0, x0, y1, x1 = gt_box
+    cy, cx, h, w = (y0 + y1) / 2, (x0 + x1) / 2, y1 - y0, x1 - x0
+    out, seen = [], {tuple(gt_box)}
+    for n in range(1, MAX_PROPOSALS + 1):
+        dy, dx = rng.uniform(-SHIFT_FRAC, SHIFT_FRAC, 2) * (h, w)
+        sy, sx = rng.uniform(*SCALE_RANGE, 2)
+        ny0, ny1 = cy + dy - sy * h / 2, cy + dy + sy * h / 2
+        nx0, nx1 = cx + dx - sx * w / 2, cx + dx + sx * w / 2
+        c = [int(min(1000, max(0, v)) + 0.5) for v in (ny0, nx0, ny1, nx1)]
+        if not (c[0] < c[2] and c[1] < c[3]) or tuple(c) in seen:
+            continue
+        if giou(c, gt_box) < GIOU_MIN:
+            continue
+        seen.add(tuple(c))
+        out.append(c)
+        if len(out) == k:
+            return out, n
+    raise GeoError(f"could not obtain {k} candidates for {pid} box {b} {gt_box} within {MAX_PROPOSALS} proposals")
+
+
+def cand_record(gt_box, cand):
+    gi = giou(cand, gt_box)
+    g_h, g_w = gt_box[2] - gt_box[0], gt_box[3] - gt_box[1]
+    return {"box": cand, "giou": gi, "area_ratio": (cand[2] - cand[0]) * (cand[3] - cand[1]) / (g_h * g_w),
+            "disp": math.hypot((cand[0] + cand[2] - gt_box[0] - gt_box[2]) / 2, (cand[1] + cand[3] - gt_box[1] - gt_box[3]) / 2)}
+
+
+# ---------- 가중치 ----------
+def r_weights(gious):
+    """gious: 후보 GIoU 리스트 -> [1, r_1..r_k]. 각 r은 양수·유한이어야 한다."""
+    r = [1.0] + [1.0 + GAMMA * math.log(g) for g in gious]
+    if not all(math.isfinite(v) and v > 0 for v in r):
+        raise GeoError(f"non-positive/non-finite weight {r} for giou {gious}")
+    return r
+
+
+def q_weights(mode, gious):
+    r = r_weights(gious)
+    if mode == "C":
+        return [1.0] + [0.0] * len(gious)
+    z = sum(r)
+    if mode == "G":
+        return [v / z for v in r]
+    if mode == "U":
+        q0 = 1.0 / z
+        return [q0] + [(1 - q0) / len(gious)] * len(gious)
+    raise ValueError(mode)
+
+
+# ---------- token span ----------
+def array_char_spans(text):
+    """target JSON의 각 `box_2d` 배열의 (시작 '[' 위치, 끝 ']' 위치, 4개 정수)를 문서 순서로 반환. 값은 json.loads와 대조한다."""
+    from . import coord_loss as CL
+    sp = CL.coord_spans(text)
+    if len(sp) % 4:
+        raise GeoError("coordinate count not multiple of 4")
+    want = [e["box_2d"] for e in json.loads(text)]
+    res = []
+    for b in range(len(sp) // 4):
+        s0, e3 = sp[4 * b][0], sp[4 * b + 3][1]
+        if text[s0 - 1] != "[" or text[e3] != "]":
+            raise GeoError(f"box {b}: array brackets not adjacent to coordinates")
+        vals = [v for _, _, v in sp[4 * b:4 * b + 4]]
+        if vals != want[b]:
+            raise GeoError(f"box {b}: scanned values {vals} != json {want[b]}")
+        res.append((s0 - 1, e3, vals))
+    return res
+
+
+def encode(tok, text):
+    enc = tok(text + "<end_of_turn>", add_special_tokens=False, return_offsets_mapping=True)
+    return list(enc["input_ids"]), [tuple(o) for o in enc["offset_mapping"]]
+
+
+def box_token_spans(tok, text, dig_ids):
+    """returns (ids, [(t_start, t_end_inclusive)] per box). 경계 걸침은 앞 공백/뒤 쉼표만 허용하고 좌표 숫자는 모두 한 자리 digit token이어야 한다."""
+    ids, offs = encode(tok, text)
+    dset = set(dig_ids)
+    res = []
+    for (a, z, _vals) in array_char_spans(text):
+        ts = [t for t, (s, e) in enumerate(offs) if s <= a < e]
+        te = [t for t, (s, e) in enumerate(offs) if s <= z < e]
+        if len(ts) != 1 or len(te) != 1:
+            raise GeoError("bracket not covered by exactly one token")
+        ts, te = ts[0], te[0]
+        s_off, e_off = offs[ts]
+        s2, e2 = offs[te]
+        if e_off != a + 1 or text[s_off:a] not in ("", " "):
+            raise GeoError(f"opening token straddles unexpected chars {text[s_off:e_off]!r}")
+        if s2 != z or text[z + 1:e2] not in ("", ","):
+            raise GeoError(f"closing token straddles unexpected chars {text[s2:e2]!r}")
+        for t in range(ts + 1, te):
+            s, e = offs[t]
+            seg = text[s:e]
+            if seg.isdigit():
+                if ids[t] not in dset or e - s != 1:
+                    raise GeoError(f"non single-digit token {seg!r} inside box span")
+            elif seg not in (",", " ", ", "):
+                raise GeoError(f"unexpected token {seg!r} inside box span")
+        res.append((ts, te))
+    return ids, res
+
+
+def replace_box_text(text, b, new_box):
+    """text의 b번째 box_2d 배열을 new_box(정수 4개)로 교체한 문자열 (json.dumps와 같은 서식 '[a, b, c, d]')."""
+    a, z, _ = array_char_spans(text)[b]
+    return text[:a] + "[" + ", ".join(str(int(v)) for v in new_box) + "]" + text[z + 1:]
+
+
+def build_branches(tok, text, dig_ids, cand_lists, mode):
+    """text: GT target. cand_lists: [[cand_record x4] per box] (GT box 순서). returns dict:
+    gt_ids, gt_spans, gt_tokw_by_box(q_b0), branches=[{box, m, ids(assistant part), span=(ts,te), q, w_per_token, n_b, n_bm, giou}].
+    C에서는 branch 없이 q_b0=1이다."""
+    gt_ids, gt_spans = box_token_spans(tok, text, dig_ids)
+    if len(cand_lists) != len(gt_spans):
+        raise GeoError("candidate list count != box count")
+    branches, q0s = [], []
+    for b, cl in enumerate(cand_lists):
+        q = q_weights(mode, [c["giou"] for c in cl])
+        q0s.append(q[0])
+        ts, te = gt_spans[b]
+        n_b = te - ts + 1
+        if mode == "C":
+            continue
+        for m, c in enumerate(cl, start=1):
+            ctext = replace_box_text(text, b, c["box"])
+            cids, cspans = box_token_spans(tok, ctext, dig_ids)
+            cts, cte = cspans[b]
+            if cts != ts or cids[:ts + 1] != gt_ids[:ts + 1]:
+                raise GeoError(f"box {b} cand {m}: GT prefix (incl. opening bracket token) differs")
+            n_bm = cte - cts + 1
+            branches.append({"box": b, "m": m, "ids": cids[:cte + 1], "span": (cts, cte), "q": q[m], "n_b": n_b, "n_bm": n_bm,
+                             "w_per_token": q[m] * n_b / n_bm, "giou": c["giou"], "cand": c["box"]})
+    return {"gt_ids": gt_ids, "gt_spans": gt_spans, "q0": q0s, "branches": branches}
+
+
+def gt_token_weights(gt_len, gt_spans, q0s):
+    """assistant 부분(길이 gt_len) token별 가중치: span 밖 1, box b span 안 q_b0."""
+    w = [1.0] * gt_len
+    for (ts, te), q0 in zip(gt_spans, q0s):
+        for t in range(ts, te + 1):
+            w[t] = q0
+    return w
+
+
+def branch_digest(br):
+    """branch 목록의 결정적 지문 (batch ID·후보 ID 대조용)."""
+    h = hashlib.sha256()
+    for b in br:
+        h.update(json.dumps([b["box"], b["m"], b["ids"], b["span"], round(b["w_per_token"], 12)]).encode())
+    return h.hexdigest()[:16]
+
+
+# ---------- 독립 기준(테스트용, float64) ----------
+def reference_loss(nll_gt, gt_spans, nll_cands, q):
+    """FP64 기준 손실 합. nll_gt: GT assistant token별 NLL(list). nll_cands: {(b,m): span token별 NLL list}. q: {(b,m): q_bm}.
+    returns sum (분모 N으로 나누기 전) = CE_outside + sum_b n_b * sum_m q_bm * mean(NLL_bm)."""
+    inside = set()
+    for ts, te in gt_spans:
+        inside.update(range(ts, te + 1))
+    total = sum(v for t, v in enumerate(nll_gt) if t not in inside)
+    for b, (ts, te) in enumerate(gt_spans):
+        n_b = te - ts + 1
+        total += n_b * q[(b, 0)] * (sum(nll_gt[ts:te + 1]) / n_b)
+    for (b, m), nll in nll_cands.items():
+        n_b = gt_spans[b][1] - gt_spans[b][0] + 1
+        total += n_b * q[(b, m)] * (sum(nll) / len(nll))
+    return total
