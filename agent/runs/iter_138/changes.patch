@@ -0,0 +1,29 @@
+"""iter_138 자료 재연결 (CPU): iter_137이 만든 D6/E45 manifest·요청을 새로 선정하지 않고 재연결한다.
+i137_data.link()로 iter_136 PNG의 hash·역할·D/E 비중복·annotation 면적·원 NIfTI hash를 다시 검사하고, 결과 rows가 iter_137 manifest와 같고
+make_requests 결과가 iter_137 요청 파일과 byte 수준으로 같은지 확인한 뒤 iter_138 경로에 새 파일로 저장한다. 새 표본 선정·재렌더 없음."""
+import sys
+from i138_common import RES, DATA, OLD137, sha, read, save, now
+import i137_data as D137
+
+
+def main():
+    m, rows, checks = D137.link()
+    old = read(OLD137 / 'data/manifest.json')
+    problems = list(checks['problems'])
+    if rows != old['rows']: problems.append('rows_differ_from_iter137_manifest')
+    for s, f in (('D', 'technical'), ('E', 'main')):
+        mine = D137.make_requests(rows[s]); theirs = read(OLD137 / ('requests/%s.json' % f))
+        if mine != theirs: problems.append('requests_differ_from_iter137_' + f)
+    checks = dict(checks, problems=problems)
+    run = not problems
+    save(DATA / 'manifest.json', dict(created_at=now(), source='results/iter_137/data/manifest.json + results/iter_136/data/manifest.json(읽기 전용)', iter137_manifest_sha256=sha(OLD137 / 'data/manifest.json'),
+                                       checks=checks, run_models=run, rows=rows,
+                                       note='반복 개발 자료(MSD Task01 FLAIR). 독립 test 아님. N1은 annotation 면적 0 slice이며 임상 정상이 아니다. P는 GT 기반 선택이다.'))
+    if run:
+        save(RES / 'requests/technical.json', read(OLD137 / 'requests/technical.json')); save(RES / 'requests/main.json', read(OLD137 / 'requests/main.json'))
+    print('run', run, {k: v for k, v in checks.items() if k != 'excluded_in_iter136'})
+    return 0 if run else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/i138_eval.py b/i138_eval.py
new file mode 100644
index 0000000..b811905
--- /dev/null
+++ b/i138_eval.py
@@ -0,0 +1,107 @@
+"""iter_138 평가기: 출력 생성 전에 잠근다. strict 상태(UNKNOWN·invalid·절단은 오답, 분모 유지), annotation-defined BA, B−A 환자 paired bootstrap(10,000회, seed137, percentile 95%),
+사전 판정 분기(positive / negative / inconclusive / invalid_output_conditions). 정답은 annotation-defined이며 임상 진단이 아니다.
+입력: completion이 검증된 main job(verify_job: 요청 완전성·protocol·provenance 재검증). 자유 설명의 임상 정확성은 채점하지 않는다."""
+import glob, json, sys
+from pathlib import Path
+import numpy as np
+from i138_common import RES, OLD136, BOOT_SEED, read, save, now, sha
+from i138_spec import parse, audit, repetition, first_line, extra_text, TRUTH, IFACES
+
+N_BOOT = 10000
+THR = dict(ba=0.75, sens=0.65, spec=0.65, diff=0.15, valid=0.95, neg_ba=0.60)
+
+
+def states_of(records):
+    st = {}
+    for r in records:
+        s = parse(r['final_text'], r['eos'], r['boundary_status'])
+        st[r['id']] = dict(state=s, eos=r['eos'], n_tokens=r['n_tokens'], wall_s=r['wall_s'], boundary=r['boundary_status'], text=r['text'], audit=audit(r['final_text'], s),
+                           rep=repetition(r['final_text']), extra=extra_text(r['final_text']), peak_reserved_mib=r['peak_reserved_mib'], n_image_tokens=r['n_image_tokens'], input_len=r['input_len'])
+    return st
+
+
+def patient_table(st, pids):
+    T = {}
+    for p in pids:
+        row = {}
+        for i in IFACES:
+            for c, truth in TRUTH.items():
+                row['ok_%s_%s' % (c, i)] = float(st['%s__%s__%s' % (p, c, i)]['state'] == truth)
+            row['ba_%s' % i] = (row['ok_P_%s' % i] + row['ok_N1_%s' % i]) / 2
+            row['both_%s' % i] = float(row['ok_P_%s' % i] == 1.0 and row['ok_N1_%s' % i] == 1.0)
+        row['diff_ba'] = row['ba_B'] - row['ba_A']
+        T[p] = row
+    return T
+
+
+def mean(T, k): return float(np.mean([v[k] for v in T.values()]))
+
+
+def boot(T, f, n=N_BOOT, seed=BOOT_SEED):
+    pids = sorted(T); rng = np.random.default_rng(seed); arr = np.array([f(T[p]) for p in pids]); idx = rng.integers(0, len(pids), (n, len(pids)))
+    b = arr[idx].mean(1); return float(arr.mean()), [float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))]
+
+
+def decide(rep):
+    """사전 규칙(plan Evaluation). 출력 조건이 valid하지 않으면 과학적 양성/음성으로 쓰지 않는다."""
+    v = rep['output_validity']; ok_valid = all(v[i]['eos_rate'] >= THR['valid'] and v[i]['boundary_valid_rate'] >= THR['valid'] and v[i]['first_line_valid_rate'] >= THR['valid'] for i in IFACES)
+    if not ok_valid: return 'invalid_output_conditions'
+    B, d, ci = rep['B'], rep['diff_B_minus_A'], rep['diff_ci95']
+    if B['BA'] >= THR['ba'] and B['sensitivity'] >= THR['sens'] and B['specificity'] >= THR['spec'] and d >= THR['diff'] and ci[0] > 0: return 'positive_limited_recovery'
+    if B['BA'] <= THR['neg_ba'] or ci[1] < THR['diff']: return 'negative_no_recovery'
+    return 'inconclusive'
+
+
+def repro_vs_iter136(rec):
+    """A 재실행 대 iter_136 저장 출력(같은 prompt·pixels·설정): 재현성 점검용이며 주판정에 쓰지 않는다."""
+    old = {}
+    for f in sorted(glob.glob(str(OLD136 / 'jobs/main/worker*.jsonl'))):
+        for l in open(f):
+            r = json.loads(l); old[r['id']] = r
+    n = same = same_state = 0; cmp_ = []
+    for r in rec:
+        if not r['id'].endswith('__A'): continue
+        o = old.get(r['id'][:-3])
+        if o is None: continue
+        n += 1; same += int(o['tokens'] == r['tokens'])
+        so = parse(o['final_text'], o['eos'], o['boundary_status']); sn = parse(r['final_text'], r['eos'], r['boundary_status']); same_state += int(so == sn)
+        if o['tokens'] != r['tokens']: cmp_.append(r['id'])
+    return dict(n_compared=n, identical_tokens=same, identical_state=same_state, differing_ids=cmp_)
+
+
+def report(job, stage='main'):
+    import i138_run as R
+    rec = R.verify_job(job, stage); st = states_of(rec)
+    pids = sorted(set(r['id'].split('__')[0] for r in rec)); assert len(rec) == 4 * len(pids)
+    T = patient_table(st, pids)
+    diff, ci = boot(T, lambda v: v['diff_ba'])
+    out = dict(created_at=now(), stage=stage, n_patients=len(pids), always_PRESENT_BA=0.5, thresholds=THR)
+    per = {}; validity = {}; confusion = {}
+    for i in IFACES:
+        sens, spec = mean(T, 'ok_P_%s' % i), mean(T, 'ok_N1_%s' % i)
+        bm, bci = boot(T, lambda v, i=i: v['ba_%s' % i])
+        out[i] = dict(BA=(sens + spec) / 2, BA_ci95=bci, sensitivity=sens, specificity=spec, both_correct_rate=mean(T, 'both_%s' % i))
+        rows = {c: [st['%s__%s__%s' % (p, c, i)] for p in pids] for c in TRUTH}
+        allr = rows['P'] + rows['N1']
+        validity[i] = dict(n=len(allr), eos_rate=float(np.mean([r['eos'] for r in allr])), non_eos=sum(not r['eos'] for r in allr), boundary_valid_rate=float(np.mean([r['boundary'] != 'invalid_boundary' for r in allr])),
+                           first_line_valid_rate=float(np.mean([r['state'] is not None for r in allr])), invalid=sum(r['state'] is None for r in allr), truncated_non_eos=sum(not r['eos'] for r in allr),
+                           unknown=sum(r['state'] == 'UNKNOWN' for r in allr), repetition=sum(r['rep'] for r in allr), extra_explanation=sum(r['extra'] for r in allr),
+                           audit_contradiction=sum(r['audit'] == 'contradiction' for r in allr), audit_unresolved=sum(r['audit'] == 'unresolved' for r in allr))
+        confusion[i] = {c: {k: sum(r['state'] == k for r in rows[c]) for k in ('PRESENT', 'ABSENT', 'UNKNOWN')} | dict(invalid=sum(r['state'] is None for r in rows[c])) for c in TRUTH}
+        per[i] = dict(mean_tokens=float(np.mean([r['n_tokens'] for r in allr])), sum_tokens=int(sum(r['n_tokens'] for r in allr)), mean_request_wall_s=float(np.mean([r['wall_s'] for r in allr])), sum_request_wall_s=float(sum(r['wall_s'] for r in allr)),
+                      max_peak_reserved_mib=float(max(r['peak_reserved_mib'] for r in allr)), n_image_tokens=sorted({r['n_image_tokens'] for r in allr}), input_len=sorted({r['input_len'] for r in allr}))
+    out.update(diff_B_minus_A=diff, diff_ci95=ci, output_validity=validity, confusion=confusion, cost=per,
+               cost_ratio_B_over_A=dict(tokens=per['B']['sum_tokens'] / per['A']['sum_tokens'], request_wall=per['B']['sum_request_wall_s'] / per['A']['sum_request_wall_s']),
+               transitions=dict(A_right_B_wrong=float(sum(max(0, v['ba_A'] - v['ba_B']) for v in T.values())), A_wrong_B_right=float(sum(max(0, v['ba_B'] - v['ba_A']) for v in T.values()))),
+               sec_both_correct_diff=dict(zip(('mean', 'ci95'), boot(T, lambda v: v['both_B'] - v['both_A']))),
+               repro_vs_iter136_A=repro_vs_iter136(rec), bootstrap=dict(n=N_BOOT, seed=BOOT_SEED, unit='patient', ci='percentile95'), job=str(job),
+               note='annotation-defined 정답이며 임상 진단이 아니다. 반복 개발 E45. 설명의 임상 정확성은 채점하지 않는다. audit_*는 보조 정규식 감사.')
+    out['decision'] = decide(out)
+    return out, T
+
+
+if __name__ == '__main__':
+    job = Path(sys.argv[1]).resolve(); outp = Path(sys.argv[2]).resolve(); assert str(outp).startswith(str(RES) + '/')
+    o, T = report(job, sys.argv[3] if len(sys.argv) > 3 else 'main')
+    save(outp, o); save(outp.with_name(outp.stem + '_per_patient.json'), T)
+    print(json.dumps({k: o[k] for k in ('A', 'B', 'diff_B_minus_A', 'diff_ci95', 'decision')}, indent=1))
diff --git a/i138_gate.py b/i138_gate.py
new file mode 100644
index 0000000..c227c06
--- /dev/null
+++ b/i138_gate.py
@@ -0,0 +1,92 @@
+"""iter_138 기술 gate: 단일 구현 (i137의 i137_tech.gate / i137_gate.py 이중 구현과 사후 분리를 대체). 생성 전에 코드를 protocol에 잠그고 main 진입 전에 한 번만 실행한다.
+
+사전 규칙 (plan iter_138 amendment):
+- 진입 조건(하나라도 실패하면 passed=False): 새 D24 job의 완료·provenance·EOS 100%·경계 유효 100%·A/B 각 12·return code 0, 재사용 iter_137 D24 job 3개의 원시 재검증,
+  구성 간(w2/w4/resume, iter_137 w2 대 iter_138 w2) token 동일, 실제 SIGKILL 재개 기록, 경계/tensor(technical·main)/negative/cpu 검사 통과,
+  측정 누락·빈 자원 로그·여유 부족을 통과시키지 않는 메모리 판정.
+- 관찰 항목(진입 조건이 아님): 첫 줄 형식 유효율(인터페이스별). 분모 12에서 95% 기준은 전건 유효를 요구하므로, iter_137의 원 실패(A 11/12)는 보존하고
+  E 출력 생성 전에 이 amendment로 분리한다. E 조건별 95% 기준은 i138_eval.decide에서 그대로 유지된다. 정확도는 gate에 쓰지 않는다.
+모든 입력은 원시 job·kill_record·resources에서 읽는다."""
+import sys, inspect
+from i138_common import RES, OLD137, sha, read, save, now
+from i138_spec import parse
+import i138_run as R
+
+T = RES / 'tests'
+MARGIN = R.MARGIN_MIB
+OLD_JOBS = [OLD137 / 'jobs' / n for n in ('tb1024_w2', 'tb1024_w4', 'tb1024_resume')]
+NEW_JOB = RES / 'jobs' / 'd24_w2'
+UNCHANGED_FUNCS = ['worker', 'load_records', '_load_records', 'check_records', 'verify_job', 'requests', 'messages', 'input_tensor', 'admission', 'boundary_ids', 'smi', 'allowed']
+
+
+def memory_ok(samples, mapping, total):
+    """samples: resources 로그의 gpu 행 목록(각 [{'index','used'}...]). mapping: worker→물리 GPU index. total: GPU별 총 메모리(MiB).
+    측정이 없거나(빈 로그) 일부 GPU 측정이 누락되거나 used+worker당 여유가 용량을 넘으면 False. 누락을 0으로 대체하지 않는다."""
+    if not samples or not mapping: return False, 'no_samples'
+    peak = {}
+    for row in samples:
+        for g in row:
+            peak[g['index']] = max(peak.get(g['index'], 0), int(g['used']))
+    for g in set(mapping):
+        if g not in peak or g not in total: return False, 'missing_measurement_gpu_' + g
+        if peak[g] + MARGIN * mapping.count(g) > int(total[g]): return False, 'insufficient_margin_gpu_' + g
+    return True, 'ok'
+
+
+def tokens_of(job): return {r['id']: r['tokens'] for r in R.load_records(job)}
+
+
+def source_equal():
+    """i137_run과 i138_run에서 생성·claim·record·검증 함수 소스가 같은지 (같다면 iter_137의 재개·4 worker 기록을 알고리즘 근거로 재사용)."""
+    import i137_run as O
+    return {f: inspect.getsource(getattr(O, f)) == inspect.getsource(getattr(R, f)) for f in UNCHANGED_FUNCS}
+
+
+def gate():
+    import i137_run as O
+    t = {s: read(T / ('tensor_check_%s.json' % s)) for s in ('technical', 'main')}; n = read(T / 'negative_tests.json'); b = read(T / 'boundary_check.json'); c = read(T / 'cpu_tests.json')
+    n_expected = len(R.requests('technical'))
+    rec = R.verify_job(NEW_JOB, 'technical')   # 새 D24: 완료·protocol·provenance 재검증
+    old = [O.verify_job(j, 'technical') for j in OLD_JOBS]   # 재사용 증거: iter_137 원 protocol로 원시 재검증
+    base = tokens_of(NEW_JOB); old_t = [{r['id']: r['tokens'] for r in x} for x in old]
+    identical_old = all(o == old_t[0] for o in old_t)   # w2/w4/resume 내부 정합
+    same_as_old = base == old_t[0]                       # 새 runner 대 iter_137 token
+    parsed = [parse(r['final_text'], r['eos'], r['boundary_status']) for r in rec]
+    ifc = {i: [p for r, p in zip(rec, parsed) if r['id'].endswith('__' + i)] for i in ('A', 'B')}
+    n_by = {i: len(v) for i, v in ifc.items()}; valid = {i: sum(p is not None for p in v) / len(v) for i, v in ifc.items()}
+    old_parsed = [parse(r['final_text'], r['eos'], r['boundary_status']) for r in old[0]]
+    old_valid = {i: sum(p is not None for r, p in zip(old[0], old_parsed) if r['id'].endswith('__' + i)) / 12 for i in ('A', 'B')}
+    launch = sorted(NEW_JOB.glob('launch_*.json')); assert len(launch) == 1, 'exactly one launch expected'
+    mapping = read(launch[0])['mapping']; comp = read(NEW_JOB / 'completion.json')
+    samples = []
+    for rp in sorted(NEW_JOB.glob('resources_*.jsonl')):
+        samples += [__import__('json').loads(l)['gpu'] for l in open(rp) if l.strip()]
+    total = {g['index']: int(g['total']) for g in R.smi()}
+    mem, mem_reason = memory_ok(samples, mapping, total)
+    mem = mem and max(r['peak_reserved_mib'] for r in rec) < min(total.values())
+    kr = [read(p) for p in sorted((OLD137 / 'jobs/tb1024_resume').glob('kill_record_*.json'))]
+    resume_valid = bool(kr) and all(k['killed_while_running'] and 0 < k['lines_at_kill'] < n_expected and not k['completion_exists'] for k in kr)
+    old_comp = [read(j / 'completion.json') for j in OLD_JOBS]
+    same_src = source_equal()
+    checks = dict(boundary=b['passed'], tensor_technical=t['technical']['passed'], tensor_main=t['main']['passed'], negative=n['all_rejected'], cpu_tests=c['passed'],
+                  new_job_complete_expected=len(rec) == n_expected and n_by == {'A': n_expected // 2, 'B': n_expected // 2}, new_job_rc_zero=all(x == 0 for x in comp['returncodes']),
+                  new_job_all_eos=all(r['eos'] for r in rec), new_job_boundary_valid=all(r['boundary_status'] != 'invalid_boundary' for r in rec),
+                  reused_jobs_internal_identical=identical_old, new_runner_tokens_identical_to_iter137=same_as_old, reused_jobs_rc_zero=all(all(x == 0 for x in cc['returncodes']) for cc in old_comp),
+                  reused_resume_was_interrupted_midrun=resume_valid, unchanged_algorithm_sources=all(same_src.values()),
+                  memory_measured_and_within_capacity=mem)
+    passed = all(checks.values())
+    ev = {str(p): sha(p) for p in [T / 'tensor_check_technical.json', T / 'tensor_check_main.json', T / 'negative_tests.json', T / 'boundary_check.json', T / 'cpu_tests.json', NEW_JOB / 'completion.json', launch[0],
+                                    *[j / 'completion.json' for j in OLD_JOBS], *sorted((OLD137 / 'jobs/tb1024_resume').glob('kill_record_*.json')), RES / 'requests/technical.json']}
+    save(T / 'technical_gate.json', dict(created_at=now(), final_stage='technical', passed=passed, checks=checks, memory_reason=mem_reason, n_resource_samples=len(samples), mapping=mapping, total_mib=total,
+                                         observed_not_gating=dict(first_line_valid_rate_new_d24=valid, first_line_valid_rate_iter137_d24=old_valid, n_invalid_new=sum(p is None for p in parsed),
+                                                                  invalid_ids_new=[r['id'] for r, p in zip(rec, parsed) if p is None],
+                                                                  note='iter_137 원 gate는 이 값(A 11/12)으로 중단됐다. 이 기록은 보존되며 이번 gate는 형식률을 진입 조건에서 분리한 사전 amendment이다(E 생성 전).'),
+                                         unchanged_function_sources=same_src, main_max_new_tokens=R.config_for('technical')['max_new_tokens'], main_workers=2,
+                                         main_workers_reason='GPU당 1 worker. iter_137 loading 포함 처리량 w2 41.88/w4 29.85 req/min이지만 w4는 두 worker가 0건 처리해 일반 결론이 아니므로 새 병렬 탐색은 하지 않는다.',
+                                         evidence_sha256=ev, n_expected=n_expected))
+    print({k: v for k, v in checks.items()}, 'valid_observed', valid, 'passed', passed)
+    return 0 if passed else 1
+
+
+if __name__ == '__main__':
+    sys.exit(gate())
diff --git a/i138_lock.py b/i138_lock.py
