+    # 단일 writer lock: run-dir 안의 파일은 이 프로세스만 쓴다. lock 파일은 지우지 않으며 소유자가 종료되어야 커널이 푼다.
+    lk, own, reclaimed = queue_lock.try_lock(os.path.join(os.path.realpath(a.run_dir), "train.lock"), queue_lock.my_info(role="train"))
