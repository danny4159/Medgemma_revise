+"""paired 비용 block 실행기. 사용: python g71_costrun.py OUT_ROOT BLOCK_IDS(예: 1,3) ORDER_PARITY
+각 block은 같은 GPU(현재 프로세스의 CUDA_VISIBLE_DEVICES)에서 vlm과 det를 순서를 번갈아(홀수 block: vlm->det, 짝수 block: det->vlm) 한 프로세스씩 실행한다."""
+import json, os, subprocess, sys
+
+root, blocks = sys.argv[1], [int(x) for x in sys.argv[2].split(',')]
+lock = json.load(open('results/iter_071/decide/e24_lock.json'))
+adapter = lock['vlm']['D']['adapter_dir']  # 최종 VLM: V8에서 선택된 D8 (사전 선택, E24 결과와 무관)
+for b in blocks:
+    order = ['vlm', 'det'] if b % 2 == 1 else ['det', 'vlm']
+    for s in order:
+        out = f'{root}/block{b}_{s}'
+        if os.path.exists(f'{out}/timing.json'):
+            continue
+        cmd = [sys.executable, 'g71_cost.py', s, out] + (['--adapter', adapter] if s == 'vlm' else ['--ckpt', lock['detector']['ckpt'], '--thr', str(lock['detector']['threshold'])])
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        open(f'{out}.log', 'w').write(r.stdout[-3000:] + r.stderr[-3000:])
+        if r.returncode != 0:
+            sys.exit(f'block {b} {s} failed rc={r.returncode}')
+        print('done', b, s, flush=True)
diff --git a/g71_data.py b/g71_data.py
new file mode 100644
index 0000000..67175a1
--- /dev/null
+++ b/g71_data.py
@@ -0,0 +1,202 @@
+"""iter_071 SPIDER T2 sagittal anatomy-grounding 자료: 분할 잠금, mask-free 중앙 slice 선택·렌더, instance bbox GT, 입력 검증.
+
+- 영상/mask 읽기·canonical 축·SimpleITK 물리좌표 대조는 sp67_data.load_pair(iter_067, 선별 반입)를 사용한다. Modic/IVD crop/sequence 비교 함수는 호출하지 않는다.
+- 선택 slice: canonical 좌우축 길이 n에서 j=floor((n-1)/2)와 j-1, j, j+1. mask·GT를 보지 않는다 (render/select 함수는 mask 인자가 없다).
+- 렌더: volume 유한값 min/max uint8, spacing 보정(더 촘촘한 간격 기준 PIL bilinear), 추가 crop 없음. PNG는 square padding 전(L mode)이며
+  모델 입력은 rsna_diag.generate.load_image가 값 보존 RGB + 중앙 square padding으로 만든다 (RSNA source adapter와 같은 경로).
+- GT: slice의 label instance(1..99=vertebra, 201+=disc, 100=canal 제외)별 mask bbox, 분리 성분은 union bbox. float 정규화 yxyx(0-1000, padding canvas 기준).
+  학습 정수 target은 lower=floor/upper=ceil. F139 환자는 어떤 함수에서도 열지 않는다(assert).
+"""
+import csv, hashlib, io, json, math, os, sys
+
+import numpy as np
+from PIL import Image
+
+import sp67_data as S
+from rsna_diag import geometry as G
+from rsna_diag import mi19_render as R
+
+OUT = 'results/iter_071'
+DATA = f'{OUT}/data'
+SPLIT_SRC = 'results/iter_021/data/split.json'
+SALT = 'iter071-split-v1'
+SEQ = 't2'
+OFFSETS = (-1, 0, 1)
+OFF_NAME = {-1: 'm1', 0: 'c', 1: 'p1'}
+CATS = ('vertebra', 'disc')
+LABEL_STR = {'vertebra': 'vertebra', 'disc': 'intervertebral disc'}
+PROMPTS = {
+    'vertebra': ('Localize all vertebrae visible in this sagittal spine MRI slice. Return only a JSON list. '
+                 'Each entry must contain "box_2d": [y_min, x_min, y_max, x_max] and a nonempty "label" string. '
+                 'Each box must enclose one whole vertebra including its posterior arch. '
+                 'Coordinates must be between 0 and 1000 relative to the entire square-padded image, with y before x. '
+                 'Return [] if no such vertebra is visible.'),
+    'disc': ('Localize all intervertebral discs visible in this sagittal spine MRI slice. Return only a JSON list. '
+             'Each entry must contain "box_2d": [y_min, x_min, y_max, x_max] and a nonempty "label" string. '
+             'Coordinates must be between 0 and 1000 relative to the entire square-padded image, with y before x. '
+             'Return [] if no such disc is visible.'),
+}
+S.TMP = f'{OUT}/tmp'  # iter_067 경로에 쓰지 않는다
+FORBIDDEN = None  # F139 id 집합 (load_split에서 채움)
+
+
+def sha_bytes(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def prompt_sha(cat):
+    return sha_bytes(PROMPTS[cat].encode())
+
+
+def split_hash(pid):
+    return hashlib.sha256(f'{SALT}|{pid}'.encode()).hexdigest()
+
+
+def make_split():
+    """기존 D8/E48(F139 제외)에서 T8/train16/V8/E24를 hash 순으로 고정한다. 기관 metadata는 overview.csv에 없다(제조사/모델만) -> 층화 미실행."""
+    src = json.load(open(SPLIT_SRC))
+    D, E, F = list(src['D']), list(src['E']), list(src['F'])
+    assert not (set(D) | set(E)) & set(F)
+    order = sorted(E, key=lambda p: (split_hash(p), p))
+    sp = {'T8': sorted(D, key=int), 'extra_train16': sorted(order[:16], key=int), 'V8': sorted(order[16:24], key=int), 'E24': sorted(order[24:], key=int)}
+    sp['T24'] = sorted(sp['T8'] + sp['extra_train16'], key=int)
+    v_order = [p for p in order[16:24]]  # hash 순
+    sp['V4'] = sorted(v_order[:4], key=int)
+    allp = [sp['T8'], sp['extra_train16'], sp['V8'], sp['E24']]
+    flat = [p for g in allp for p in g]
+    assert len(flat) == 56 == len(set(flat)) and not set(flat) & set(F)
+    sp.update({'salt': SALT, 'institution_stratification': 'not_executed: overview.csv has no institution field (only Manufacturer/ManufacturerModelName/DeviceSerialNumber)',
+               'F139_ids_blocked': len(F), 'prior_exposure': 'D8 and E48 were used in iter_019-021 (reference-instance tasks) and parts in iter_067; E24 is a fixed development evaluation, '
+               'not a new independent confirmation.'})
+    return sp, set(F)
+
+
+def load_split():
+    global FORBIDDEN
+    p = f'{DATA}/split_lock.json'
+    if os.path.exists(p):
+        sp = json.load(open(p))
+        src = json.load(open(SPLIT_SRC))
+        FORBIDDEN = set(src['F'])
+        want, _ = make_split()
+        for k in ('T8', 'extra_train16', 'V8', 'E24', 'T24', 'V4'):
+            assert sp[k] == want[k], f'split lock mismatch {k}'
+        return sp
+    sp, F = make_split()
+    FORBIDDEN = F
+    os.makedirs(DATA, exist_ok=True)
+    json.dump(sp, open(p, 'w'), indent=1)
+    return sp
+
+
+def guard(pid):
+    assert FORBIDDEN is not None, 'call load_split() first'
+    if pid in FORBIDDEN:
+        raise PermissionError(f'F139 patient {pid} is blocked')
+
+
+def select_slices(n_lr):
+    """mask-free: canonical 좌우축 slice 수만 사용."""
+    j = (n_lr - 1) // 2
+    return [j + o for o in OFFSETS]
+
+
+def render_slice(V, spacing, idx):
+    """V[lr,si,pa], 선택 slice idx -> (L-mode uint8 2D(위=superior), meta). volume 전체 finite min/max window. mask 인자 없음."""
+    fin = V[np.isfinite(V)]
+    if fin.size != V.size:
+        raise ValueError('non-finite voxel in volume')
+    lo, hi = float(V.min()), float(V.max())
+    if hi <= lo:
+        raise ValueError('flat volume')
+    sl = V[idx][::-1]  # row 0 = superior
+    u8 = R.to_uint8(sl, lo, hi)
+    nrow, ncol = u8.shape
+    srow, scol = R.resize_scale(spacing[1], spacing[2])
+    nh, nw = max(1, round(nrow * srow)), max(1, round(ncol * scol))
+    im = Image.fromarray(u8, mode='L').resize((nw, nh), resample=Image.BILINEAR)
+    arr = np.asarray(im)
+    return arr, {'window': [lo, hi], 'native_hw': [nrow, ncol], 'resized_hw': [nh, nw], 'scale_row_col': [nh / nrow, nw / ncol],
+                 'pad_top_left_side': list(G.pad_offsets(nh, nw))}
+
+
+def gt_instances(Lslice, meta):
+    """Lslice[si,pa] canonical label slice -> {cat: [ {label, bbox_native_rc, xyxy_px(render), yxyx_norm} ]}. 분리 성분은 같은 label의 union bbox."""
+    M = Lslice[::-1]
+    sr, sc = meta['scale_row_col']
+    nh, nw = meta['resized_hw']
+    top, left, side = meta['pad_top_left_side']
+    out = {c: [] for c in CATS}
+    for lab in [int(x) for x in np.unique(M) if x != 0]:
+        if lab == 100:
+            continue
+        cat = 'vertebra' if 1 <= lab <= 99 else ('disc' if lab >= 200 else None)
+        if cat is None:
+            raise ValueError(f'unexpected label {lab}')
+        rr, cc = np.nonzero(M == lab)
+        r0, c0, r1, c1 = int(rr.min()), int(cc.min()), int(rr.max()) + 1, int(cc.max()) + 1
+        xyxy = [c0 * sc, r0 * sr, c1 * sc, r1 * sr]
+        out[cat].append({'label': lab, 'bbox_native_rc': [r0, c0, r1, c1], 'n_vox': int(len(rr)), 'xyxy_px': xyxy,
+                         'yxyx_norm': G.canvas_to_norm(xyxy, top, left, side)})
+    for c in CATS:
+        out[c].sort(key=lambda b: ((b['yxyx_norm'][0] + b['yxyx_norm'][2]) / 2, (b['yxyx_norm'][1] + b['yxyx_norm'][3]) / 2, b['label']))
+    return out
+
+
+def target_boxes(boxes_norm):
+    """float GT -> 정수 학습 target: lower=floor, upper=ceil, [0,1000] 안으로 고정. 순서는 입력 순서(상->하)를 유지."""
+    res = []
+    for y0, x0, y1, x1 in boxes_norm:
+        b = [int(math.floor(y0)), int(math.floor(x0)), int(math.ceil(y1)), int(math.ceil(x1))]
+        b = [max(0, min(1000, v)) for v in b]
+        if not (b[0] < b[2] and b[1] < b[3]):
+            raise ValueError(f'invalid integer box {boxes_norm}')
+        res.append(b)
+    return res
+
+
+def target_text(cat, boxes_norm):
+    return json.dumps([{'box_2d': b, 'label': LABEL_STR[cat]} for b in target_boxes(boxes_norm)])
+
+
+def item_id(pid, off, cat):
+    return f'{pid}_{OFF_NAME[off]}_{cat}'
+
+
+def build_patient(pid, outdir=None):
+    guard(pid)
+    outdir = outdir or f'{DATA}/images'
+    d = S.load_pair(pid, SEQ)
+    V, L, spc = d['V'], d['L'], d['spacing']
+    n = V.shape[0]
+    rows, imgs = [], {}
+    for off, idx in zip(OFFSETS, select_slices(n)):
+        arr, meta = render_slice(V, spc, idx)
+        path = f'{outdir}/{pid}_{OFF_NAME[off]}.png'
+        buf = io.BytesIO()
+        Image.fromarray(arr, mode='L').save(buf, format='PNG')
+        os.makedirs(outdir, exist_ok=True)
+        with open(path, 'wb') as f:
+            f.write(buf.getvalue())
+        inst = gt_instances(L[idx], meta)
+        rgb, aff, pxsha = None, None, None
+        from rsna_diag import generate as GEN
+        _, aff, pxsha = GEN.load_image(path)
+        imgs[off] = {'path': path, 'file_sha256': sha_bytes(buf.getvalue()), 'pixel_sha256_padded': pxsha, 'slice_index': int(idx), **meta}
+        assert list(aff) == meta['pad_top_left_side']
+        for cat in CATS:
+            rows.append({'id': item_id(pid, off, cat), 'patient': pid, 'offset': off, 'category': cat, 'image': path, 'file_sha256': imgs[off]['file_sha256'],
+                         'gt': inst[cat]})
+    info = {'patient': pid, 'n_lr': int(n), 'selected': select_slices(n), 'spacing_canon': [float(x) for x in spc], 'direction': d['direction'], 'origin': d['origin'],
+            'header_orientation': d['header'], 'src_sha': d['src_sha'], 'size_xyz': d['size_xyz'], 'tilt_deg': d['tilt_deg'],
+            'physical_check_max_rel_err': d['physical_check_max_rel_err'], 'images': {OFF_NAME[k]: v for k, v in imgs.items()}}
+    return rows, info
+
+
+def build_all(pids):
+    all_rows, infos = [], {}
+    for pid in pids:
+        rows, info = build_patient(pid)
+        all_rows += rows
+        infos[pid] = info
+    return all_rows, infos
diff --git a/g71_det.py b/g71_det.py
new file mode 100644
index 0000000..453bec2
--- /dev/null
+++ b/g71_det.py
@@ -0,0 +1,190 @@
+"""iter_071 모듈형 detector 대조군: torchvision Faster R-CNN ResNet50-FPN v2 (COCO_V1) -> background/vertebra/disc predictor 재학습.
+
+- 같은 PNG·같은 float bbox annotation(VLM과 동일 slice/GT). mask 전체를 supervision으로 쓰지 않는다. augmentation 없음.
+- 학습: SGD momentum0.9 wd1e-4, effective batch4, 첫 2 epoch warmup, epoch20/28 후 LR x0.1. BatchNorm running stats 고정(affine 학습). 32 epoch(연장 시 64).
+- 재개: 25 step 및 epoch 경계 checkpoint(model·optimizer·scheduler·RNG·step/epoch/pos), 단일 writer lock, config digest 검사.
+- 추론: score floor 0.001, NMS 0.5, detections_per_img 100. 원시 후보(픽셀 xyxy, score, label)를 저장하고 threshold는 평가 단계에서 적용한다.
+사용: python g71_det.py train --run-dir D --lr 0.005 --train-key T8 --epochs 32 [--stop-after-step N]
+      python g71_det.py infer --ckpt model.pt --key V8 --out out.json
+"""
+import argparse, hashlib, json, math, os, random, sys, time
+
+sys.path.insert(0, 'results/environments/tv071')
+os.environ.setdefault('TORCH_HOME', os.path.abspath('results/environments/torch_home071'))
+
+import numpy as np
+import torch
+from PIL import Image
+
+import g71_data as D
+import g71_train as TR
+from rsna_diag import det_lib as DL, queue_lock
+from rsna_diag import geometry as G
+
+CLASS = {'vertebra': 1, 'disc': 2}
+CFG = {'lr_peak_note': 'SGD', 'momentum': 0.9, 'weight_decay': 1e-4, 'batch': 4, 'warmup_epochs': 2, 'milestones_epochs': [20, 28], 'gamma': 0.1,
+       'min_size': 800, 'max_size': 1333, 'score_floor': 0.001, 'nms': 0.5, 'detections': 100, 'num_classes': 3}
+
+
+def image_groups(key):
+    """key의 (patient, offset) 영상별 GT: [{path, boxes_xyxy_px, labels}]. 두 category 질의가 같은 영상을 공유한다."""
+    rows = TR.load_items(key)
+    imgs = {}
+    for r in rows:
+        k = (r['patient'], r['offset'])
+        d = imgs.setdefault(k, {'patient': r['patient'], 'offset': r['offset'], 'path': r['image'], 'file_sha256': r['file_sha256'], 'boxes': [], 'labels': []})
+        for g in r['gt']:
+            d['boxes'].append(g['xyxy_px'])
+            d['labels'].append(CLASS[r['category']])
+    return [imgs[k] for k in sorted(imgs, key=lambda x: (int(x[0]), x[1]))]
+
+
+class DS(torch.utils.data.Dataset):
+    def __init__(self, groups):
+        self.g = groups
+
+    def __len__(self):
+        return len(self.g)
+
+    def __getitem__(self, i):
+        d = self.g[i]
+        arr = np.asarray(Image.open(d['path']))
+        if hashlib.sha256(open(d['path'], 'rb').read()).hexdigest() != d['file_sha256']:
+            raise RuntimeError('image changed')
+        rgb = G.to_uint8_rgb_preserving(arr)
+        img = torch.from_numpy(rgb).permute(2, 0, 1).float() / 255.0
+        b = torch.tensor(d['boxes'], dtype=torch.float32).reshape(-1, 4)
+        l = torch.tensor(d['labels'], dtype=torch.int64)
+        return img, {'boxes': b, 'labels': l}, rgb.shape[:2]
+
+
+def collate(b):
+    return [x[0] for x in b], [x[1] for x in b], [x[2] for x in b]
+
+
+def build_model():
+    return DL.build_model(num_classes=CFG['num_classes'], min_size=CFG['min_size'], max_size=CFG['max_size'])
+
+
+def sha_file(p):
+    return hashlib.sha256(open(p, 'rb').read()).hexdigest()
+
+
+def cmd_train(a):
+    os.makedirs(a.run_dir, exist_ok=True)
+    lk, own, rec = queue_lock.try_lock(os.path.join(os.path.realpath(a.run_dir), 'train.lock'), queue_lock.my_info(role='g71_det'))
+    if lk is None:
+        sys.exit(f'run-dir owned by live process {own}')
+    try:
+        train(a, rec)
+    finally:
+        lk.release()
+
+
+def train(a, reclaimed):
+    dev = torch.device('cuda')
+    groups = image_groups(a.train_key)
+    N = len(groups)
+    spe = math.ceil(N / CFG['batch'])
+    weights = os.path.join(os.environ['TORCH_HOME'], 'hub/checkpoints/fasterrcnn_resnet50_fpn_v2_coco-dd69338a.pth')
+    code = {f: sha_file(f) for f in ['g71_det.py', 'g71_data.py', 'g71_train.py', 'rsna_diag/det_lib.py']}
+    cfg = dict(CFG, lr=a.lr, seed=a.seed, train_key=a.train_key, n_images=N, steps_per_epoch=spe, coco_weights_sha256=sha_file(weights), code=code,
+               inputs=hashlib.sha256(json.dumps([(g['path'], g['file_sha256'], g['boxes'], g['labels']) for g in groups]).encode()).hexdigest())
+    tdig = hashlib.sha256(json.dumps(cfg, sort_keys=True).encode()).hexdigest()
+    cp = os.path.join(a.run_dir, 'train_config.json')
+    if os.path.exists(cp):
+        if json.load(open(cp))['train_digest'] != tdig:
+            sys.exit('config differs from existing run-dir; refusing to resume')
+    else:
+        json.dump({'train_digest': tdig, 'config': cfg, 'torch': torch.__version__}, open(cp, 'w'), indent=1)
+    random.seed(a.seed); np.random.seed(a.seed); torch.manual_seed(a.seed); torch.cuda.manual_seed_all(a.seed)
+    model = build_model().to(dev)
+    opt = DL.build_optimizer(model, lr=a.lr, momentum=CFG['momentum'], weight_decay=CFG['weight_decay'])
+    sched = DL.linear_warmup_then_multistep(opt, CFG['warmup_epochs'] * spe, [m * spe for m in CFG['milestones_epochs']], CFG['gamma'])
+    ck = os.path.join(a.run_dir, 'ckpt_latest.pt')
+    logf = open(os.path.join(a.run_dir, 'train_log.jsonl'), 'a')
+    step, epoch0, pos0 = 0, 0, 0
+
+    def lg(**kw):
+        logf.write(json.dumps({'ts': time.time(), **kw}) + '\n'); logf.flush()
+
+    def save(epoch, pos):
+        DL.atomic_save({'model': model.state_dict(), 'opt': opt.state_dict(), 'sched': sched.state_dict(), 'rng': DL.full_rng_state(), 'step': step, 'epoch': epoch,
+                        'pos': pos, 'train_digest': tdig}, ck)
+        lg(event='checkpoint', step=step, epoch=epoch, pos=pos)
+
+    if os.path.exists(ck):
+        b = torch.load(ck, map_location='cpu', weights_only=False)
+        if b['train_digest'] != tdig:
+            sys.exit('checkpoint provenance mismatch')
+        model.load_state_dict(b['model']); opt.load_state_dict(b['opt']); sched.load_state_dict(b['sched'])
+        DL.optimizer_state_to_device(opt, dev)
+        DL.restore_rng_state(b['rng'], cuda_map=(0, 0) if len(b['rng']['torch_cuda'] or []) else None)
+        step, epoch0, pos0 = b['step'], b['epoch'], b['pos']
+        lg(event='resume', step=step, epoch=epoch0, pos=pos0, stale_lock_reclaimed=bool(reclaimed))
+    save_eps = {int(x) for x in a.save_epochs.split(',')}
+    ds = DS(groups)
+    for epoch in range(epoch0, a.epochs):
+        order = np.random.default_rng(a.seed * 1000 + epoch).permutation(N)
+        DL.set_train_mode(model)
+        for s in range(pos0 if epoch == epoch0 else 0, spe):
+            idx = order[s * CFG['batch']:(s + 1) * CFG['batch']]
+            imgs, tg, _ = collate([ds[int(i)] for i in idx])
+            imgs = [x.to(dev) for x in imgs]
+            tg = [{k: v.to(dev) for k, v in t.items()} for t in tg]
+            losses = model(imgs, tg)
+            loss = sum(losses.values())
+            if not torch.isfinite(loss):
+                raise RuntimeError(f'non-finite loss at step {step}')
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            opt.step(); sched.step(); step += 1
+            lg(step=step, epoch=epoch + 1, pos=s + 1, loss=float(loss), lr=opt.param_groups[0]['lr'], ids=[f"{groups[int(i)]['patient']}_{groups[int(i)]['offset']}" for i in idx],
+               parts={k: float(v) for k, v in losses.items()})
+            if step % 25 == 0 and s + 1 < spe:
+                save(epoch, s + 1)
+                if a.stop_after_step == step:
+                    print('test stop', flush=True); os._exit(5)
+        e = epoch + 1
+        if e in save_eps or e == a.epochs:
+            os.makedirs(os.path.join(a.run_dir, f'epoch_{e:02d}'), exist_ok=True)
+            DL.atomic_save({'model': model.state_dict(), 'epoch': e, 'step': step, 'train_digest': tdig}, os.path.join(a.run_dir, f'epoch_{e:02d}', 'model.pt'))
+        save(e, 0)
+    print('training complete', flush=True)
+
+
+@torch.no_grad()
+def infer(ckpt, key, out_path, batch=1):
+    dev = torch.device('cuda')
+    model = build_model().to(dev)
+    b = torch.load(ckpt, map_location='cpu', weights_only=False)
+    model.load_state_dict(b['model'])
+    model.eval()
+    groups = image_groups(key)
+    ds = DS(groups)
+    res, t0 = {}, time.time()
+    for i, g in enumerate(groups):
+        img, _, hw = ds[i]
+        torch.cuda.synchronize(); t = time.time()
+        pr = model([img.to(dev)])[0]
+        torch.cuda.synchronize()
+        res[f"{g['patient']}_{D.OFF_NAME[g['offset']]}"] = {'boxes_xyxy_px': pr['boxes'].cpu().numpy().tolist(), 'scores': pr['scores'].cpu().numpy().tolist(),
+                                                       'labels': pr['labels'].cpu().numpy().tolist(), 'img_hw': list(hw), 'runtime_s': time.time() - t}
+    json.dump({'ckpt': ckpt, 'ckpt_sha256': sha_file(ckpt), 'train_digest': b['train_digest'], 'key': key, 'epoch': b['epoch'], 'n_images': len(groups), 'preds': res,
+               'wall_s': time.time() - t0}, open(out_path, 'w'))
+
+
+if __name__ == '__main__':
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest='cmd', required=True)
+    t = sub.add_parser('train')
+    t.add_argument('--run-dir', required=True); t.add_argument('--lr', type=float, required=True); t.add_argument('--seed', type=int, default=17)
+    t.add_argument('--train-key', required=True); t.add_argument('--epochs', type=int, required=True); t.add_argument('--save-epochs', default='8,16,24,32,48,64')
+    t.add_argument('--stop-after-step', type=int, default=None)
+    i = sub.add_parser('infer')
+    i.add_argument('--ckpt', required=True); i.add_argument('--key', required=True); i.add_argument('--out', required=True)
+    a = ap.parse_args()
+    if a.cmd == 'train':
+        cmd_train(a)
+    else:
+        infer(a.ckpt, a.key, a.out)
