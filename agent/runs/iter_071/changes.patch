+"""미완료 V4 gen 디렉터리의 F1@0.5 상한(미생성 항목을 모두 1.0으로 가정)과 현재 status를 출력. 사용: python g71_bound.py GEN_DIR"""
+import sys
+
+import numpy as np
+
+import g71_eval as E
+import g71_train as TR
+
+rows = {r['id']: r for r in TR.load_items('V4')}
+by = {r['id']: r for r in E.read_jsonl_dir(sys.argv[1])}
+sc = {}
+for i, row in rows.items():
+    if i in by:
+        st, b = E.parse_record(by[i], row['category'])
+        sc[i] = E.score_item(st, b, [g['yxyx_norm'] for g in row['gt']])
+    else:
+        sc[i] = {'f1@0.5': 1.0, 'status': 'MISSING'}
+pats = sorted({r['patient'] for r in rows.values()}, key=int)
+print(len(by), 'upper bound', float(np.mean(list(E.per_patient(sc, pats).values()))))
+print([sc[i]['status'] for i in by])
diff --git a/g71_build.py b/g71_build.py
new file mode 100644
index 0000000..d94f4f9
--- /dev/null
+++ b/g71_build.py
@@ -0,0 +1,92 @@
+"""iter_071 자료 생성·검증: 분할 잠금 -> 56명 중앙 slice PNG·GT -> manifest, 기술 검사(물리좌표 방향·mask 독립·분할 중복·왕복) -> 결과 JSON.
+사용: python g71_build.py
+"""
+import hashlib, json, os, sys, zipfile
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+import g71_data as D
+import sp67_data as S
+from rsna_diag import geometry as G
+
+
+def main():
+    sp = D.load_split()
+    pids = sp['T8'] + sp['extra_train16'] + sp['V8'] + sp['E24']
+    os.makedirs(D.DATA, exist_ok=True)
+    rows, infos = D.build_all(pids)
+    man = {'rows': rows, 'patients': infos, 'split': {k: sp[k] for k in ('T8', 'extra_train16', 'T24', 'V8', 'V4', 'E24')}}
+    json.dump(man, open(f'{D.DATA}/manifest.json', 'w'))
+    print('built', len(rows), 'rows', len(infos), 'patients')
+
+    checks = {}
+    # 1. 분할 중복: 환자, source member hash, decoded pixel hash, F139 교집합
+    groups = {'T8': sp['T8'], 'extra_train16': sp['extra_train16'], 'V8': sp['V8'], 'E24': sp['E24']}
+    inter = {f'{a}&{b}': sorted(set(groups[a]) & set(groups[b])) for a in groups for b in groups if a < b}
+    checks['patient_overlap'] = {k: v for k, v in inter.items() if v}
+    img_sha = [infos[p]['src_sha']['image'] for p in pids]
+    msk_sha = [infos[p]['src_sha']['mask'] for p in pids]
+    px = [infos[p]['images'][o]['pixel_sha256_padded'] for p in pids for o in ('m1', 'c', 'p1')]
+    checks['dup_source_image_sha'] = len(img_sha) - len(set(img_sha))
+    checks['dup_source_mask_sha'] = len(msk_sha) - len(set(msk_sha))
+    checks['dup_decoded_pixel_sha'] = len(px) - len(set(px))
+    F = set(json.load(open(D.SPLIT_SRC))['F'])
+    checks['F139_intersection'] = sorted(set(pids) & F)
+    # 2. PNG 재읽기 hash 일치
+    bad = 0
+    for p in pids:
+        for o, im in infos[p]['images'].items():
+            if hashlib.sha256(open(im['path'], 'rb').read()).hexdigest() != im['file_sha256']:
+                bad += 1
+    checks['png_file_hash_mismatch'] = bad
+    # 3. bbox 왕복: render xyxy -> norm -> canvas -> 원 native mask pixel 범위, 그리고 독립 SimpleITK 물리 방향 검사
+    maxerr, nbox = 0.0, 0
+    orient = {}
+    phys = []
+    for p in pids:
+        info = infos[p]
+        d = S.load_pair(p, D.SEQ)
+        ca = d['ca']
+        orient[info['header_orientation']] = orient.get(info['header_orientation'], 0) + 1
+        for o, idx in zip(D.OFFSETS, info['selected']):
+            im = info['images'][D.OFF_NAME[o]]
+            meta = {'scale_row_col': im['scale_row_col'], 'resized_hw': im['resized_hw'], 'pad_top_left_side': im['pad_top_left_side']}
+            inst = D.gt_instances(d['L'][idx], meta)
+            top, left, side = im['pad_top_left_side']
+            for cat in D.CATS:
+                for b in inst[cat]:
+                    x0, y0, x1, y1 = G.norm_to_canvas(b['yxyx_norm'], top, left, side)
+                    r0, c0, r1, c1 = b['bbox_native_rc']
+                    sr, sc = im['scale_row_col']
+                    maxerr = max(maxerr, abs(x0 - c0 * sc), abs(y0 - r0 * sr), abs(x1 - c1 * sc), abs(y1 - r1 * sr))
+                    nbox += 1
+        # 독립 물리 검사(SimpleITK): label 1(가장 아래 vertebra)의 물리 z(S+) 중심 < 최상위 label의 물리 z 중심,
+        # 그리고 표시 row 중심은 반대 순서(위=superior)여야 한다. canonical -> sitk index -> physical.
+        idx = info['selected'][1]
+        imgs = S.read_sitk(S.IMG_ZIP, f'images/{p}_{D.SEQ}.mha')[0]
+        Lc = d['L'][idx]
+        labs = sorted(int(x) for x in np.unique(Lc) if 0 < x < 100)
+        def cen(lab):
+            pts = np.argwhere(Lc == lab)
+            sel = pts[:: max(1, len(pts) // 200)]
+            zs, ys = [], []
+            for si, pa in sel:
+                oi = S.canon_to_orig_index(ca, d['V'].shape, (idx, int(si), int(pa)))
+                ph = imgs.TransformIndexToPhysicalPoint(oi)
+                zs.append(ph[2]); ys.append(ph[1])
+            return float(np.mean(zs)), float(np.mean(ys)), float((d['V'].shape[1] - 1 - pts[:, 0]).mean())
+        lo, hi = cen(labs[0]), cen(labs[-1])
+        phys.append({'patient': p, 'orientation': info['header_orientation'], 'z_low': lo[0], 'z_high': hi[0], 'row_low': lo[2], 'row_high': hi[2],
+                     'ok': bool(lo[0] < hi[0] and lo[2] > hi[2])})
+    checks['bbox_roundtrip_max_abs_err_px'] = maxerr
+    checks['n_gt_boxes_checked'] = nbox
+    checks['physical_orientation_check'] = {'n': len(phys), 'n_ok': sum(x['ok'] for x in phys), 'failures': [x for x in phys if not x['ok']]}
+    json.dump(phys, open(f'{D.DATA}/physical_check.json', 'w'), indent=1)
+    checks['header_orientation_counts'] = orient
+    json.dump(checks, open(f'{D.DATA}/build_checks.json', 'w'), indent=1)
+    print(json.dumps(checks, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/g71_cost.py b/g71_cost.py
new file mode 100644
index 0000000..076b0df
--- /dev/null
+++ b/g71_cost.py
@@ -0,0 +1,129 @@
+"""iter_071 같은 workload(V8 8명 x 3 slice x 2 category) 비용 측정: 원본 T2 읽기 -> canonical -> render(PNG 저장) -> 추론 -> 답변 JSON 저장까지.
+annotation mask는 읽지 않는다. 한 프로세스가 한 system(vlm|det)의 한 block을 수행하고 단조 시계로 단계별 시간을 기록한다.
+- t_total_incl_load: 프로세스 시작 직후(import 이후) ~ 마지막 답변 저장까지(모델 적재 포함).
+- t_resident: 모델 적재 이후 ~ 마지막 답변 저장까지(read/render 포함, 상주 모델 가정).
+사용: python g71_cost.py vlm OUT_DIR --adapter DIR | python g71_cost.py det OUT_DIR --ckpt PATH --thr 0.85
+"""
+import argparse, hashlib, io, json, os, sys, time
+
+import numpy as np
+from PIL import Image
+
+import g71_data as D
+import sp67_data as S
+
+t_proc = time.perf_counter()
+
+
+def read_render_patient(pid, outdir):
+    """mask 없이: 영상만 읽고 선택 slice를 렌더해 PNG로 저장. returns {offset: path}, ms 단위 세부."""
+    img, ibytes, arr = S.read_sitk(S.IMG_ZIP, f'images/{pid}_{D.SEQ}.mha')
+    ca = S.canon_axes(img.GetDirection())
+    V, spc = S.to_canonical(arr, img.GetSpacing(), ca)
+    paths = {}
+    for off, idx in zip(D.OFFSETS, D.select_slices(V.shape[0])):
+        a, meta = D.render_slice(V, spc, idx)
+        buf = io.BytesIO()
+        Image.fromarray(a, mode='L').save(buf, format='PNG')
+        p = f'{outdir}/{pid}_{D.OFF_NAME[off]}.png'
+        with open(p, 'wb') as f:
+            f.write(buf.getvalue())
+        paths[off] = (p, hashlib.sha256(buf.getvalue()).hexdigest())
+    return paths
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('system', choices=['vlm', 'det'])
+    ap.add_argument('out_dir')
+    ap.add_argument('--adapter', default=None)
+    ap.add_argument('--ckpt', default=None)
+    ap.add_argument('--thr', type=float, default=0.85)
+    ap.add_argument('--key', default='V8')
+    a = ap.parse_args()
+    os.makedirs(a.out_dir, exist_ok=True)
+    sp = D.load_split()
+    man = json.load(open(f'{D.DATA}/manifest.json'))
+    pids = sp[a.key]
+    img_dir = os.path.join(a.out_dir, 'png')
+    os.makedirs(img_dir, exist_ok=True)
+    ev = {'system': a.system, 'key': a.key, 'gpu_env': os.environ.get('CUDA_VISIBLE_DEVICES')}
+    answers = {}
+    if a.system == 'vlm':
+        from rsna_diag import generate as GEN
+        t0 = time.perf_counter()
+        torch, proc, model = GEN.load_model()
+        adig = GEN.load_adapter(torch, model, a.adapter)
+        env = GEN.env_info(torch, proc, model)
+        eos = env['eos_token_id']
+        eos_ids = set(eos if isinstance(eos, list) else [eos])
+        import torch as _t
+        _t.cuda.synchronize()
+        ev['t_load_model'] = time.perf_counter() - t0
+        t_res0 = time.perf_counter()
+        t_rr = t_inf = 0.0
+        for pid in pids:
+            t = time.perf_counter()
+            paths = read_render_patient(pid, img_dir)
+            t_rr += time.perf_counter() - t
+            for off, (p, h) in paths.items():
+                if h != man['patients'][pid]['images'][D.OFF_NAME[off]]['file_sha256']:
+                    raise RuntimeError(f'rendered PNG differs from manifest for {pid} {off}')
+                for cat in D.CATS:
+                    t = time.perf_counter()
+                    rec = GEN.run_request(torch, proc, model, eos_ids, {'id': D.item_id(pid, off, cat), 'image': p}, cat, D.PROMPTS[cat])
+                    t_inf += time.perf_counter() - t
+                    answers[rec['id']] = {'suffix_ids': rec['suffix_ids'], 'ended_eos': rec['ended_eos'], 'n_out': rec['n_output_tokens'], 'text': rec['suffix_text_raw']}
+        with open(os.path.join(a.out_dir, 'answers.json'), 'w') as f:
+            json.dump(answers, f)
+        torch.cuda.synchronize()
+        t_end = time.perf_counter()
+        ev.update({'adapter_digest': adig, 'peak_gb': torch.cuda.max_memory_allocated() / 2 ** 30})
+    else:
+        sys.path.insert(0, 'results/environments/tv071')
+        os.environ.setdefault('TORCH_HOME', os.path.abspath('results/environments/torch_home071'))
+        import torch
+        import g71_det as X
+        from rsna_diag import geometry as G
+        t0 = time.perf_counter()
+        model = X.build_model().to('cuda')
+        b = torch.load(a.ckpt, map_location='cpu', weights_only=False)
+        model.load_state_dict(b['model'])
+        model.eval()
+        torch.cuda.synchronize()
+        ev['t_load_model'] = time.perf_counter() - t0
+        t_res0 = time.perf_counter()
+        t_rr = t_inf = 0.0
+        for pid in pids:
+            t = time.perf_counter()
+            paths = read_render_patient(pid, img_dir)
+            t_rr += time.perf_counter() - t
+            for off, (p, h) in paths.items():
+                if h != man['patients'][pid]['images'][D.OFF_NAME[off]]['file_sha256']:
+                    raise RuntimeError(f'rendered PNG differs from manifest for {pid} {off}')
+                t = time.perf_counter()
+                arr = np.asarray(Image.open(p))
+                rgb = G.to_uint8_rgb_preserving(arr)
+                x = torch.from_numpy(rgb).permute(2, 0, 1).float().div(255.0).cuda()
+                with torch.no_grad():
+                    pr = model([x])[0]
+                h_, w_ = rgb.shape[:2]
+                top, left, side = G.pad_offsets(h_, w_)
+                for cat, lab in (('vertebra', 1), ('disc', 2)):
+                    bx = [G.canvas_to_norm(bb, top, left, side) for bb, s, l in zip(pr['boxes'].cpu().tolist(), pr['scores'].cpu().tolist(), pr['labels'].cpu().tolist())
+                          if l == lab and s >= a.thr]
+                    answers[D.item_id(pid, off, cat)] = {'boxes': bx}
+                t_inf += time.perf_counter() - t
+        with open(os.path.join(a.out_dir, 'answers.json'), 'w') as f:
+            json.dump(answers, f)
+        torch.cuda.synchronize()
+        t_end = time.perf_counter()
+        ev['peak_gb'] = torch.cuda.max_memory_allocated() / 2 ** 30
+    ev.update({'t_total_incl_load': t_end - t_proc, 't_resident': t_end - t_res0, 't_read_render': t_rr, 't_infer': t_inf, 'n_answers': len(answers), 'n_expected': len(pids) * 6})
+    assert len(answers) == len(pids) * 6
+    json.dump(ev, open(os.path.join(a.out_dir, 'timing.json'), 'w'), indent=1)
+    print(json.dumps(ev))
+
+
+if __name__ == '__main__':
+    main()
