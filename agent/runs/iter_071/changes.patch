+        rng_before = rng_state(torch)
+        pre = live_digests(torch, model, opt)
+        snap = lora.lora_state_dict(model) if from_file else None
+        if from_file:
+            blob_a = torch.load(os.path.join(epoch_dir, "adapter.pt"), map_location="cpu", weights_only=True)
