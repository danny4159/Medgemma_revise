new file mode 100644
index 0000000..322b101
--- /dev/null
+++ b/ar70_patch.py
@@ -0,0 +1,60 @@
+"""iter_070: build a minimally patched copy of the official AutoRG-Brain source (pinned SHA).
+
+Patches (everything else is untouched):
+ 1. inferenceSdk.AutoRG_Brain.__init__: do not overwrite CUDA_VISIBLE_DEVICES (keep inherited GPU set).
+ 2. GPT-2 base 'healx/gpt-2-pubmed-medium' -> local pinned snapshot via env AR70_GPT2.
+ 3. generate(max_length=300) -> env AR70_MAXLEN (default 300), to allow the pre-registered single cap doubling.
+Writes a unified diff to <out>/ar70_patch.diff.
+"""
+import difflib
+import os
+import shutil
+import sys
+
+SHA = '9670703c88e8f599c0c7edc472a5ffce4dd72b0e'
+SRC = f'results/iter_070/external/src/AutoRG-Brain-{SHA}'
+DST = 'results/iter_070/external/patched'
+
+EDITS = [
+    ('AutoRG_Brain/inference/inferenceSdk.py',
+     '        os.environ["CUDA_VISIBLE_DEVICES"] = str(gpu_id[0])\n',
+     '        # ar70: inherited CUDA_VISIBLE_DEVICES is kept (original overwrote it); gpu_id[0] is the logical index\n'),
+    ('AutoRG_Brain/inference/inferenceSdk.py',
+     'max_length=300,',
+     "max_length=int(os.environ.get('AR70_MAXLEN', '300')),"),
+    ('AutoRG_Brain/network/language_model_patchwise.py',
+     'self.checkpoint = "healx/gpt-2-pubmed-medium"',
+     "self.checkpoint = __import__('os').environ.get('AR70_GPT2', 'healx/gpt-2-pubmed-medium')"),
+    ('AutoRG_Brain/network_training/nnUNetTrainerV2_llm_resize_new.py',
+     'checkpoint = "healx/gpt-2-pubmed-medium"',
+     "checkpoint = __import__('os').environ.get('AR70_GPT2', 'healx/gpt-2-pubmed-medium')"),
+    # 4. transformers moved BeamSearchScorer; same class, new module path (unused in greedy decoding)
+    ('AutoRG_Brain/network/language_model_patchwise.py',
+     'from transformers.generation_beam_search import BeamSearchScorer',
+     'from transformers.generation.beam_search import BeamSearchScorer'),
+]
+
+
+def main():
+    # --reapply: re-derive edited files from the pinned SRC into an existing DST (derived copy only)
+    reapply = len(sys.argv) > 1 and sys.argv[1] == '--reapply'
+    if os.path.exists(DST) and not reapply:
+        sys.exit('refusing to overwrite ' + DST)
+    if not os.path.exists(DST):
+        shutil.copytree(SRC, DST, ignore=shutil.ignore_patterns('__pycache__', 'results'))
+    diff = []
+    for f in dict.fromkeys(e[0] for e in EDITS):
+        orig = open(os.path.join(SRC, f)).read()
+        t = orig
+        for ef, old, new in EDITS:
+            if ef == f:
+                assert t.count(old) == 1, (f, old, t.count(old))
+                t = t.replace(old, new)
+        open(os.path.join(DST, f), 'w').write(t)
+        diff += list(difflib.unified_diff(orig.splitlines(True), t.splitlines(True), f'a/{f}', f'b/{f}'))
+    open(os.path.join(DST, 'ar70_patch.diff'), 'w').write(''.join(diff))
+    print(''.join(diff))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ar70_run.py b/ar70_run.py
new file mode 100644
index 0000000..b04843d
--- /dev/null
+++ b/ar70_run.py
@@ -0,0 +1,147 @@
+"""iter_070 worker: AutoRG-Brain RGv2, FLAIR, P (predicted mask) vs G (annotation mask), same given_mask path.
+
+Run with the isolated env python (results/environments/autorg70). One worker processes its cases sequentially:
+  seg (official SegModel, saves *_ab/*_ana) -> P report (label=pred_ab,label2=pred_ana)
+                                             -> G report (label=GT whole-lesion mask, label2=pred_ana)
+Per (case, cond) atomic JSON in <out>/results/. Resume: existing results with same protocol hash are skipped.
+Generation: official greedy (max_length=300); a cap-reached output is re-run once with AR70_MAXLEN=600
+(both attempts are kept).
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+import traceback
+
+ROOT = os.path.abspath(os.path.dirname(__file__))
+PATCHED = os.path.join(ROOT, 'results/iter_070/external/patched/AutoRG_Brain')
+MODELS = os.path.join(ROOT, 'results/iter_070/models')
+BRATS = os.path.join(ROOT, 'results/iter_070/data/brats/ASNR-MICCAI-BraTS2023-GLI-Challenge-TrainingData')
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for ch in iter(lambda: f.read(1 << 22), b''):
+            h.update(ch)
+    return h.hexdigest()
+
+
+def protocol_hash():
+    keys = [os.path.join(MODELS, 'weights_manifest.json'), os.path.join(os.path.dirname(PATCHED), 'ar70_patch.diff'), os.path.abspath(__file__)]
+    return hashlib.sha256(b''.join(open(k, 'rb').read() for k in keys)).hexdigest()[:16]
+
+
+def atomic_json(path, obj):
+    tmp = path + '.tmp.%d' % os.getpid()
+    with open(tmp, 'w') as f:
+        json.dump(obj, f, indent=1, ensure_ascii=False)
+    os.replace(tmp, path)
+
+
+def make_gt_mask(case, out_dir):
+    import nibabel as nib
+    import numpy as np
+    p = f'{BRATS}/{case}/{case}-seg.nii.gz'
+    img = nib.load(p)
+    m = (np.asarray(img.dataobj) > 0).astype(np.uint8)
+    hdr = img.header.copy()
+    hdr.set_data_dtype(np.uint8)
+    o = os.path.join(out_dir, f'{case}_gt_whole.nii.gz')
+    if not os.path.exists(o):
+        nib.save(nib.Nifti1Image(m, img.affine, hdr), o)
+    return o, int(m.sum())
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--cases', required=True)
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--conds', default='P,G')
+    a = ap.parse_args()
+    out = os.path.abspath(a.out)
+    for d in ['results', 'masks', 'gt', 'log']:
+        os.makedirs(os.path.join(out, d), exist_ok=True)
+    os.environ['AR70_GPT2'] = os.path.join(MODELS, 'gpt2pm')
+    os.environ['HF_HUB_OFFLINE'] = '1'
+    os.chdir(PATCHED)
+    sys.path.insert(0, PATCHED)
+    import torch
+    from inference.inferenceSdk import AutoRG_Brain
+
+    ph = protocol_hash()
+    t_load = time.time()
+    cfg = {'llm_folder': os.path.join(MODELS, 'autorg/RG_v2'), 'seg_folder': os.path.join(MODELS, 'autorg'),
+           'llm_chk': 'AutoRG_Brain_RGv2', 'seg_chk': 'AutoRG_Brain_SEG', 'output_dir': os.path.join(out, 'masks'),
+           'eval_mode': 'given_mask'}
+    model = AutoRG_Brain(gpu_id=[0], config=cfg)
+    load_s = time.time() - t_load
+    gen_log = []
+    orig_gen = model.trainer.llm_model.generate
+
+    def gen_wrap(*args, **kw):
+        o = orig_gen(*args, **kw)
+        eos = model.trainer.tokenizer.eos_token_id
+        gen_log.append({'max_length': kw.get('max_length'), 'shape': list(o.shape),
+                        'has_eos': [bool((row == eos).any().item()) for row in o[:, 1:]] if o.shape[1] > 1 else []})
+        return o
+    model.trainer.llm_model.generate = gen_wrap
+    meta = {'protocol_hash': ph, 'load_s': load_s, 'cuda_visible': os.environ.get('CUDA_VISIBLE_DEVICES'),
+            'device': torch.cuda.get_device_name(0), 'pid': os.getpid(), 'torch': torch.__version__}
+    atomic_json(os.path.join(out, 'log', f'worker_{os.getpid()}.json'), meta)
+
+    for case in a.cases.split(','):
+        img = f'{BRATS}/{case}/{case}-t2f.nii.gz'
+        stem = f'{case}-t2f'
+        need = [c for c in a.conds.split(',') if not os.path.exists(os.path.join(out, 'results', f'{case}__{c}.json'))]
+        if not need:
+            continue
+        torch.cuda.reset_peak_memory_stats()
+        t0 = time.time()
+        gt_path, gt_vox = make_gt_mask(case, os.path.join(out, 'gt'))
+        ab = os.path.join(out, 'masks', f'{stem}_ab.nii.gz')
+        ana = os.path.join(out, 'masks', f'{stem}_ana.nii.gz')
+        seg_s = None
+        if not (os.path.exists(ab) and os.path.exists(ana)):
+            ts = time.time()
+            try:
+                model.segmodel.seg([[img]], [None], [None], ['T2FLAIR'])
+            except Exception:
+                atomic_json(os.path.join(out, 'results', f'{case}__SEGFAIL.json'), {'case': case, 'err': traceback.format_exc()})
+                continue
+            seg_s = time.time() - ts
+        seg_peak = torch.cuda.max_memory_reserved() / 2**20
+        for cond in need:
+            label = ab if cond == 'P' else gt_path
+            rec = {'case': case, 'cond': cond, 'protocol_hash': ph, 'image': img, 'image_sha256': sha(img),
+                   'label_path': label, 'ana_path': ana, 'gt_whole_voxels': gt_vox, 'seg_s_case': seg_s,
+                   'attempts': [], 'status': 'ok'}
+            for maxlen in (300, 600):
+                os.environ['AR70_MAXLEN'] = str(maxlen)
+                del gen_log[:]
+                tg = time.time()
+                try:
+                    res = model.report([{'image': img, 'modal': 'T2FLAIR', 'label': label, 'label2': ana}])
+                    err = None
+                except Exception:
+                    res, err = None, traceback.format_exc()
+                att = {'max_length': maxlen, 'wall_s': time.time() - tg, 'gen': list(gen_log), 'error': err,
+                       'report': res[0]['pred_report'] if res else None}
+                cap = any((not all(g['has_eos'])) and g['shape'][1] >= maxlen - 1 for g in gen_log)
+                att['cap_hit'] = bool(cap)
+                rec['attempts'].append(att)
+                if err or not cap:
+                    break
+            if rec['attempts'][-1]['error']:
+                rec['status'] = 'error'
+            rec['peak_reserved_MiB'] = torch.cuda.max_memory_reserved() / 2**20
+            rec['seg_peak_reserved_MiB'] = seg_peak
+            rec['case_wall_s'] = time.time() - t0
+            atomic_json(os.path.join(out, 'results', f'{case}__{cond}.json'), rec)
+            print(case, cond, rec['status'], round(rec['case_wall_s'], 1), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/i142_checks.py b/i142_checks.py
new file mode 100644
index 0000000..c542bd2
--- /dev/null
+++ b/i142_checks.py
@@ -0,0 +1,55 @@
+"""실제 기술 산출물의 완료 재사용과 오류·변조·누락 거부를 검사한다."""
+import copy
+import subprocess
+import time
+from i142_common import *
+
+def main():
+    proto=verify_protocol(RES/'protocol_technical_v2.json')
+    row=next(r for r in read(RES/'inference_inputs.json') if r['role']=='technical')
+    result=RES/'jobs/tech_equivalence_v2'/row['patient_id']/'result.json'
+    original=verify_result(result,proto,row)
+    root=RES/'tests'/('runtime_'+str(time.time_ns()))
+    root.mkdir()
+    checks={}
+    for label,change in [('error_status',lambda r:r.update(status='error')),
+                          ('wrong_protocol',lambda r:r.update(protocol_digest='wrong')),
+                          ('wrong_input',lambda r:r['input'].update(image_sha256='wrong')),
+                          ('wrong_output',lambda r:r['outputs'].update({next(iter(r['outputs'])):'wrong'}))]:
+        r=copy.deepcopy(original)
+        change(r)
+        r['record_digest']=digest({k:v for k,v in r.items() if k!='record_digest'})
+        p=root/(label+'.json')
+        save(p,r)
+        try:
+            verify_result(p,proto,row)
+        except AssertionError:
+            checks[label+'_rejected']=True
+    p=root/'corrupt.json'
+    p.write_text('{"truncated":')
+    try:
+        verify_result(p,proto,row)
+    except ValueError:
+        checks['corruption_rejected']=True
+    try:
+        verify_result(root/'missing.json',proto,row)
+    except FileNotFoundError:
+        checks['missing_rejected']=True
+    before=sha(result)
+    # 실제 worker 진입에서 같은 완료 작업을 재사용하며 새 GPU forward는 없다.
+    command=[str(ENV),str(ROOT/'i142_worker.py'),'--patient',row['patient_id'],'--protocol',str(RES/'protocol_technical_v2.json'),
+             '--out',str(result.parent),'--max-length','300','--direct','--equivalence']
+    r=subprocess.run(command,cwd=ROOT,capture_output=True,text=True)
+    save(root/'completed_reentry.json',{'command':command,'exit_code':r.returncode,'stdout':r.stdout,'stderr':r.stderr})
+    checks['completed_reentry_immutable']=r.returncode==0 and before==sha(result) and '완료 출력 재사용' in r.stdout
+    # 같은 출력 소유권을 다른 실제 worker가 인계받을 수 없어야 한다.
+    with ownership(result.parent/'owner.lock'):
+        r=subprocess.run(command,cwd=ROOT,capture_output=True,text=True)
+    checks['concurrent_worker_rejected']=r.returncode!=0 and 'BlockingIOError' in r.stderr and before==sha(result)
+    save(root/'concurrent_reentry.json',{'command':command,'exit_code':r.returncode,'stderr':r.stderr})
+    save(RES/'tests/runtime_checks_v2.json',{'created_at':now(),'checks':checks,'all_pass':all(checks.values()),'source_sha256':sha(__file__)})
+    assert len(checks)==8 and all(checks.values())
+    print(checks)
+
+if __name__=='__main__':
+    main()
diff --git a/i142_common.py b/i142_common.py
new file mode 100644
index 0000000..51387b0
--- /dev/null
+++ b/i142_common.py
@@ -0,0 +1,79 @@
+"""iter_142의 고정 자산 연결, 배타적 소유권과 보존 저장."""
+import contextlib
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent
+RES = ROOT / 'results/iter_142'
+OLD = ROOT / 'results/iter_141'
+ENV = ROOT / 'results/environments/autorg70/bin/python'
+MODELS = ROOT / 'results/iter_070/models'
+SRC = ROOT / 'results/iter_070/external/src/AutoRG-Brain-9670703c88e8f599c0c7edc472a5ffce4dd72b0e'
+SDK = RES / 'external/AutoRG_Brain'
+
+def now():
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+def sha(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(4 << 20), b''):
+            h.update(b)
+    return h.hexdigest()
+
+def digest(x):
+    return hashlib.sha256(json.dumps(x, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()
+
+def read(p):
+    def pairs(items):
+        d = {}
+        for k, v in items:
+            if k in d:
+                raise ValueError('duplicate key: ' + k)
+            d[k] = v
+        return d
+    return json.loads(Path(p).read_text(), object_pairs_hook=pairs)
+
+def save(p, x):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    if p.exists():
+        raise FileExistsError(p)
+    tmp = p.with_name(p.name + '.tmp.' + str(os.getpid()))
+    with open(tmp, 'x') as f:
+        json.dump(x, f, ensure_ascii=False, indent=2)
+        f.flush()
+        os.fsync(f.fileno())
+    # 배타 link는 존재 확인과 rename 사이 경합도 거부한다.
+    os.link(tmp, p)
+    tmp.unlink()
+
+@contextlib.contextmanager
+def ownership(p):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with open(p, 'a+') as f:
+        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        yield
+
+def verify_protocol(p):
+    x = read(p)
+    assert x['digest'] == digest({k:v for k,v in x.items() if k != 'digest'})
+    for path, h in x['files'].items():
+        assert sha(path) == h, 'protocol hash mismatch: ' + path
+    return x
+
+def verify_result(p, protocol, expected):
+    x = read(p)
+    assert x['status'] == 'ok'
+    assert x['record_digest'] == digest({k:v for k,v in x.items() if k != 'record_digest'})
+    assert x['protocol_digest'] == protocol['digest']
+    assert x['input'] == expected
+    for path, h in x['outputs'].items():
+        assert sha(path) == h
+    assert sha(expected['image']) == expected['image_sha256']
+    return x
