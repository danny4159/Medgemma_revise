@@ -0,0 +1,66 @@
+"""실제 재사용용 로더: 가중치 경로와 SDK가 쓰는 trainer 로그 경로를 분리한다."""
+from i142_common import *
+
+def config(output_dir):
+    view=RES/'model_view'
+    assert view.is_dir()
+    for name in ('AutoRG_Brain_SEG.model','AutoRG_Brain_SEG.model.pkl','RG_v2/AutoRG_Brain_RGv2.model','RG_v2/AutoRG_Brain_RGv2.model.pkl'):
+        link=view/'autorg'/name
+        source=MODELS/'autorg'/name
+        assert link.is_symlink() and link.resolve()==source.resolve()
+    return {'llm_folder':str(view/'autorg/RG_v2'),'seg_folder':str(view/'autorg'),
+        'llm_chk':'AutoRG_Brain_RGv2','seg_chk':'AutoRG_Brain_SEG','output_dir':str(output_dir),'eval_mode':'region_segtool'}
+
+def check(out,patient=None):
+    import sys
+    out=Path(out).resolve()
+    assert out.is_relative_to(RES)
+    out.mkdir()
+    old_logs={str(p):sha(p) for p in (MODELS/'autorg').rglob('*.txt')}
+    os.environ.update(AR70_GPT2=str(MODELS/'gpt2pm'),HF_HUB_OFFLINE='1',TRANSFORMERS_OFFLINE='1')
+    os.chdir(SDK)
+    sys.path.insert(0,str(SDK))
+    from inference.inferenceSdk import AutoRG_Brain
+    model=AutoRG_Brain([0],config(out))
+    checks={'old_logs_unchanged':old_logs=={str(p):sha(p) for p in (MODELS/'autorg').rglob('*.txt')},
+         'seg_log_under_iter142':Path(model.segmodel.trainer.log_file).resolve().is_relative_to(RES),
+         'new_seg_log_exists':Path(model.segmodel.trainer.log_file).is_file(),
+         'seg_folder_under_iter142':Path(model.segmodel.trainer.output_folder).resolve().is_relative_to(RES)}
+    generated=None
+    if patient:
+        from inference.inferenceSdk import setup_seed
+        import torch
+        row=next(r for r in read(RES/'inference_inputs.json') if r['patient_id']==patient)
+        assert row['role']=='technical'
+        setup_seed(42)
+        torch.backends.cudnn.benchmark=False
+        os.environ['AR70_MAXLEN']='300'
+        generated_tokens=[]
+        original=model.trainer.llm_model.generate
+        def observe(*args,**kwargs):
+            value=original(*args,**kwargs)
+            generated_tokens.append(value.detach().cpu().tolist())
+            return value
+        model.trainer.llm_model.generate=observe
+        payload=[{'image':row['image'],'modal':'DWI'}]
+        result=model.report(payload)
+        previous=read(RES/'jobs/tech_equivalence_v2'/patient/'result.json')
+        checks['safe_report_matches_prior']=result[0]['pred_report']==previous['report']
+        checks['safe_tokens_match_prior']=generated_tokens==[g['tokens'] for g in previous['observations']['generation']]
+        checks['safe_masks_match_prior']=all(sha(result[0][key])==previous['masks'][key]['sha256'] for key in ['ab_mask','ana_mask'])
+        checks['old_logs_unchanged_after_generation']=old_logs=={str(p):sha(p) for p in (MODELS/'autorg').rglob('*.txt')}
+        generated={'patient_id':patient,'actual_call':payload,'report':result[0]['pred_report'],'tokens':generated_tokens,
+                   'mask_hashes':{key:sha(result[0][key]) for key in ['ab_mask','ana_mask']}}
+    save(out/'check.json',{'created_at':now(),'checks':checks,'all_pass':all(checks.values()),
+        'old_logs':old_logs,'config':config(out),'source_sha256':sha(__file__),'generated':generated,
+        'scope':'실제 GPU 로딩·로그 분리와 선택한 기술 사례의 전체 예측/판독 경로 검사. 개발 6명 본출력은 재생성하지 않음.'})
+    assert all(checks.values())
+    print(checks)
+
+if __name__=='__main__':
+    import argparse
+    p=argparse.ArgumentParser()
+    p.add_argument('--out',required=True)
+    p.add_argument('--patient')
+    a=p.parse_args()
+    check(a.out,a.patient)
diff --git a/i142_verify.py b/i142_verify.py
new file mode 100644
index 0000000..ba1059d
--- /dev/null
+++ b/i142_verify.py
@@ -0,0 +1,102 @@
+"""생산 평가기를 호출하지 않고 원문 연결과 주 수치·bootstrap을 검산한다."""
+import hashlib
+import json
+from pathlib import Path
+import numpy as np
+
+ROOT=Path(__file__).resolve().parent
+RES=ROOT/'results/iter_142'
+OLD=ROOT/'results/iter_141'
+
+def sha(p):
+    h=hashlib.sha256()
+    with open(p,'rb') as f:
+        for b in iter(lambda:f.read(4<<20),b''):
+            h.update(b)
+    return h.hexdigest()
+
+def load(p):
+    def unique(pairs):
+        d={}
+        for k,v in pairs:
+            if k in d:
+                raise ValueError(k)
+            d[k]=v
+        return d
+    return json.loads(Path(p).read_text(),object_pairs_hook=unique)
+
+def main():
+    judges=load(RES/'eval/judgments.json')
+    refs={r['patient_id']:r for r in load(OLD/'reference_locked.json')['rows']}
+    inputs=[r for r in load(RES/'inference_inputs.json') if r['role']=='main']
+    ids=[r['patient_id'] for r in inputs]
+    assert len(ids)==6 and len(set(ids))==6 and set(judges)==set(ids)
+    old={(r['patient_id'],r['condition']):r for r in load(OLD/'eval/per_patient.json')}
+    report=load(RES/'eval/report.json')
+    per={r['patient_id']:r for r in load(RES/'eval/per_patient.json')}
+    computed=[]
+    quotes=0
+    for pid in ids:
+        rec=load(RES/'jobs/main'/pid/'result.json')
+        assert rec['status']=='ok' and rec['patient_id']==pid
+        assert set(rec['actual_call'][0])=={'image','modal'} and rec['actual_call'][0]['modal']=='DWI'
+        assert rec['seg_call']['ab']==[None] and rec['seg_call']['ana']==[None]
+        for path,h in rec['outputs'].items():
+            assert sha(path)==h
+        final=judges[pid]['final']
+        atoms=final['atoms']
+        assert set(atoms)==set(a['id'] for a in refs[pid]['positive_atoms'])
+        matched=sum(j['state']=='matched' for j in atoms.values())
+        unknown=sum(j['state']=='unresolved' or (not rec['complete'] and j['state']=='unmentioned') for j in atoms.values())
+        n=len(atoms)
+        cc=final['reference_contradictions']
+        values={'recall':matched/n,'recall_min':matched/n,'recall_max':(matched+unknown)/n,
+            'reference_contradiction_min':int(any(j['status']=='confirmed' for j in cc)),
+            'reference_contradiction_max':int(not rec['complete'] or bool(cc))}
+        assert all(abs(per[pid][k]-v)<1e-12 for k,v in values.items())
+        for mode,text in [('final',rec['report']),('raw',' '.join(s for g in rec['observations']['generation'] for s in g['decoded']))]:
+            j=judges[pid][mode]
+            for a in j['atoms'].values():
+                assert a['state'] not in ('matched','contradicted') or a['quotes']
+                for q in a['quotes']:
+                    assert q and q in text
+                    quotes+=1
+            for field in ('reference_contradictions','internal_contradictions'):
+                for item in j[field]:
+                    assert item['quotes'] and all(q in text for q in item['quotes'])
+                    quotes+=len(item['quotes'])
+            for item in j['report_unverified']:
+                assert item['quote'] in text
+                quotes+=1
+        computed.append(values)
+    assert abs(report['recall']-sum(r['recall'] for r in computed)/6)<1e-12
+    independent={}
+    for c in ('S','A'):
+        dif=np.array([r['recall']-old[(pid,c)]['recall'] for pid,r in zip(ids,computed)])
+        rng=np.random.default_rng(142)
+        boot=dif[rng.integers(0,6,(10000,6))].mean(axis=1)
+        lo=sum(r['recall_min']-old[(pid,c)]['recall_max'] for pid,r in zip(ids,computed))/6
+        hi=sum(r['recall_max']-old[(pid,c)]['recall_min'] for pid,r in zip(ids,computed))/6
+        ci=np.percentile(boot,[2.5,97.5]).tolist()
+        saved=report['comparisons'][c]
+        assert abs(float(dif.mean())-saved['delta'])<1e-12
+        assert np.allclose(ci,saved['bootstrap95'],atol=1e-12,rtol=0)
+        assert np.allclose([lo,hi],saved['recall_range'],atol=1e-12,rtol=0)
+        independent[c]={'delta':float(dif.mean()),'ci95':ci,'range':[lo,hi]}
+    all_sources=load(RES/'asset_manifest.json')
+    for p,h in all_sources['source_files'].items():
+        assert sha(p)==h
+    # 기존 141 평가를 계산하지 않고, 계획 잠금에 연결된 원 파일이 그대로인지 검사한다.
+    protocol=load(RES/'protocol_main.json')
+    for p,h in protocol['files'].items():
+        assert sha(p)==h
+    result={'all_pass':True,'patients':6,'quote_connections':quotes,'independent':independent,
+       'source_sha256':sha(__file__),'meaning_scope':'산술·원문 연결 검증. 같은 assistant의 의미 판정에 대한 독립 전문의 검증은 아님',
+       'verified_files':{str(p):sha(p) for p in [RES/'eval/report.json',RES/'eval/per_patient.json',RES/'eval/judgments.json',RES/'protocol_main.json']}}
+    path=RES/'eval/independent_verification.json'
+    with open(path,'x') as f:
+        json.dump(result,f,ensure_ascii=False,indent=2)
+    print(result)
+
+if __name__=='__main__':
+    main()
