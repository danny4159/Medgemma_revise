+            continue
+        e = man_v96[r["patient"]]
+        t = r["targets"][0]
+        row = rows[r["request_id"]]
+        if row["prompt_sha256"] != R.sha_bytes(S39.prompt_I_short(e["sentences"][t], t).encode()) or r["prompt_sha256"] != row["prompt_sha256"]:
+            raise R.RunError(f"import {model}: prompt != manifest sentence")
