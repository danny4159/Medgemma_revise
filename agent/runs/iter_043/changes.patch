+"""iter_043 CPU fixture/regression 검사. python test_pg43.py --out results/iter_043/tests/fixtures_pg43.json
+GPU 산출물(D8 resume/tamper)은 저장된 결과를 읽어 검사한다 (모델 로드 없음)."""
+import argparse
