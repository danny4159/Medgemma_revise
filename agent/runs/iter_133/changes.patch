index 0000000..801aed0
--- /dev/null
+++ b/i133_post.py
@@ -0,0 +1,22 @@
+"""사후(post hoc) 기술 집계: 원 판정과 별개. 첫 줄은 EOS 무관 집계, 설명문의 low/mixed 언급은 단순 키워드(임상 판정 아님)."""
+import re, glob, json
+from collections import Counter
+from i133_common import RES, read, save, now, sha
+
