+    joined = df[['item_id', 'patient_id_anon', 'study_uid']].merge(
+        cs[['study_uid', 'patient_uid']], on='study_uid', how='left', validate='many_to_one')
+    joined = joined.merge(sp[['study_uid', 'patient_uid', 'split', 'batch_id']], on='study_uid',
