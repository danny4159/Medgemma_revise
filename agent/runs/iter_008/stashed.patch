new file mode 100644
index 0000000..01d675b
--- /dev/null
+++ b/extract_pooling_features_iter007.py
@@ -0,0 +1,207 @@
+"""iter_007: MedGemma 1.5 vision feature Z(pooling 전) 추출 + 정렬·pooling 검증 (GPU 1장).
+
+실행 (pilot: train 4장):
+  python research/extract_pooling_features_iter007.py --gpu 1 --split train --limit 4 --out research/results/iter_007/pilot
+실행 (전체 160장):
+  python research/extract_pooling_features_iter007.py --gpu 1 --out research/results/iter_007/features
+
+- backbone은 eval·no_grad·bf16. 공식 processor(resize 896 bilinear, rescale, normalize)만 쓰고 crop·flip·augmentation 없음.
+- Z는 multi_modal_projector 입력(= vision_tower last_hidden_state)을 forward pre-hook으로 잡는다.
+  projector 안의 AvgPool2d 출력도 hook으로 잡아 재구현 P(Z)와 비교한다.
+- 산출물: Z_bf16.npy(uint16 view, N×64×64×1152), P_model_bf16.npy(N×16×16×1152), cache_meta.json, extract_checks.json.
+- gate_iter007.json의 exploratory_probe_allowed가 true가 아니면 시작하지 않는다.
+"""
+import argparse
+import json
+import os
+import sys
+import time
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--gpu", default="1")
+ap.add_argument("--split", default=None)
+ap.add_argument("--limit", type=int, default=None)
+ap.add_argument("--batch", type=int, default=4)
+ap.add_argument("--out", required=True)
+ap.add_argument("--gate", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "results/iter_007/gate_iter007.json"))
+ap.add_argument("--targets", default=os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                                                  "results/iter_006/nih_class_targets.npz"))
+ap.add_argument("--src", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "results/iter_005"))
+args = ap.parse_args()
+os.environ["CUDA_VISIBLE_DEVICES"] = args.gpu
+os.environ["HF_HUB_OFFLINE"] = "1"
+
+import numpy as np  # noqa: E402
+import torch  # noqa: E402
+import transformers  # noqa: E402
+from PIL import Image  # noqa: E402
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from pooling_probe import features as F  # noqa: E402
+
+
+def spatial_transform_check(proc):
+    """1024 합성 영상의 직사각형이 896 출력에서 0.875배 위치에 있는지 (crop·padding 탐지)."""
+    a = np.zeros((1024, 1024), np.uint8)
+    x0, x1, y0, y1 = 256, 512, 640, 768
+    a[y0:y1, x0:x1] = 255
+    pv = proc(images=Image.fromarray(a).convert("RGB"), return_tensors="np")["pixel_values"][0]
+    m = pv[0] > 0.0
+    ys, xs = np.where(m)
+    got = [int(xs.min()), int(xs.max()) + 1, int(ys.min()), int(ys.max()) + 1]
+    want = [x0 * 0.875, x1 * 0.875, y0 * 0.875, y1 * 0.875]
+    err = max(abs(g - w) for g, w in zip(got, want))
+    return {"shape": list(pv.shape), "rect_1024_xxyy": [x0, x1, y0, y1], "rect_896_expected": want, "rect_896_got": got,
+            "max_edge_err_px": float(err), "pass": bool(list(pv.shape) == [3, 896, 896] and err <= 1.0),
+            "transform": "isotropic scale 896/1024=0.875, no crop, no padding"}
+
+
+def token_order_check(vt, device):
+    """patch (r,c)만 다른 두 입력 → embeddings 출력에서 token r*64+c만 달라야 한다 (row-major)."""
+    emb = vt.vision_model.embeddings if hasattr(vt, "vision_model") else vt.embeddings
+    res = []
+    for r, c in [(0, 0), (5, 37), (63, 1), (40, 63)]:
+        x = torch.zeros(2, 3, 896, 896, device=device, dtype=torch.bfloat16)
+        x[1, :, r * 14:(r + 1) * 14, c * 14:(c + 1) * 14] = 1.0
+        with torch.no_grad():
+            e = emb(x).float()
+        d = (e[1] - e[0]).abs().amax(dim=-1)
+        idx = torch.nonzero(d > 0).flatten().tolist()
+        res.append({"patch": [r, c], "changed_tokens": idx, "expected": [r * 64 + c], "pass": idx == [r * 64 + c]})
+    return {"cases": res, "pass": all(x["pass"] for x in res)}
+
+
+def projector_synthetic_check(proj, device):
+    """합성 token 패턴(token t 채널0=row, 채널1=col)을 실제 projector에 넣고 AvgPool 출력 위치를 확인."""
+    got = {}
+    h = proj.avg_pool.register_forward_hook(lambda m, i, o: got.__setitem__("p", o.detach().float()))
+    z = torch.zeros(1, 4096, F.C, device=device, dtype=torch.float32)
+    t = torch.arange(4096, device=device)
+    z[0, :, 0] = (t // 64).float()
+    z[0, :, 1] = (t % 64).float()
+    z[0, :, 2] = torch.randn(4096, generator=torch.Generator().manual_seed(0)).to(device)
+    with torch.no_grad():
+        proj(z.to(proj.mm_input_projection_weight.dtype))
+    h.remove()
+    p = got["p"][0]  # (C,16,16)
+    i = torch.arange(16, device=device).float()
+    exp_row = (4 * i + 1.5)[:, None].expand(16, 16)
+    exp_col = (4 * i + 1.5)[None, :].expand(16, 16)
+    re = F.pool_tokens(z[0].to(proj.mm_input_projection_weight.dtype).float())  # 재구현 (16,16,C)
+    return {"row_err": float((p[0] - exp_row).abs().max()), "col_err": float((p[1] - exp_col).abs().max()),
+            "reimpl_vs_model_max_abs": float((re.permute(2, 0, 1)[:3] - p[:3]).abs().max()),
+            "pass": bool((p[0] - exp_row).abs().max() < 0.02 and (p[1] - exp_col).abs().max() < 0.02)}
+
+
+def main():
+    t_start = time.time()
+    os.makedirs(args.out, exist_ok=True)
+    gate = json.load(open(args.gate))
+    if gate.get("exploratory_probe_allowed") is not True:
+        raise SystemExit(f"gate blocks GPU entry: {gate.get('blocking_reasons')}")
+    tg = np.load(args.targets)
+    manifest = {r["image"]: r for r in json.load(open(os.path.join(args.src, "nih_manifest.json")))}
+    sel = np.arange(len(tg["image_id"]))
+    if args.split:
+        sel = sel[tg["split"] == args.split]
+    if args.limit:
+        sel = sel[:args.limit]
+    img_dir = os.path.join(args.src, "data/nih/images")
+
+    device = "cuda"
+    proc = transformers.AutoProcessor.from_pretrained(F.MODEL_DIR).image_processor
+    t0 = time.time()
+    model = transformers.Gemma3ForConditionalGeneration.from_pretrained(F.MODEL_DIR, dtype=torch.bfloat16).to(device)
+    model.eval()
+    t_load = time.time() - t0
+    core = model.model
+    vt, proj = core.vision_tower, core.multi_modal_projector
+    checks = {"env": {"python": sys.version, "executable": sys.executable, "torch": torch.__version__,
+                      "cuda": torch.version.cuda, "transformers": transformers.__version__,
+                      "transformers_path": transformers.__file__, "device_name": torch.cuda.get_device_name(0),
+                      "CUDA_VISIBLE_DEVICES": args.gpu},
+              "model_digest": F.model_digest(), "processor_class": type(proc).__name__,
+              "processor_config": proc.to_dict(),
+              "feature_point": "Gemma3Model.get_image_features: vision_tower(...).last_hidden_state → multi_modal_projector "
+                               "(pre-hook input = Z); AvgPool2d(kernel=stride=4) 출력 = P(Z). RMSNorm·projection 제외.",
+              "projector_kernel_size": proj.kernel_size, "patches_per_image": proj.patches_per_image,
+              "tokens_per_side": proj.tokens_per_side, "model_load_seconds": t_load}
+    checks["spatial_transform"] = spatial_transform_check(proc)
+    checks["token_order"] = token_order_check(vt, device)
+    checks["projector_synthetic"] = projector_synthetic_check(proj, device)
+    if not (checks["spatial_transform"]["pass"] and checks["token_order"]["pass"] and checks["projector_synthetic"]["pass"]):
+        F.dump(os.path.join(args.out, "extract_checks.json"), checks)
+        raise SystemExit("alignment check failed: extraction stopped")
+
+    cap = {}
+    h1 = proj.register_forward_pre_hook(lambda m, a: cap.__setitem__("z", a[0].detach()))
+    h2 = proj.avg_pool.register_forward_hook(lambda m, i, o: cap.__setitem__("p", o.detach()))
+    N = len(sel)
+    Z = np.zeros((N, 64, 64, F.C), np.uint16)
+    Pm = np.zeros((N, 16, 16, F.C), np.uint16)
+    rows, pool_exact, pool_f32 = [], [], []
+    ref_diff = []
+    t_ext = time.time()
+    for b0 in range(0, N, args.batch):
+        idx = sel[b0:b0 + args.batch]
+        ims = []
+        for i in idx:
+            img = str(tg["image_id"][i])
+            path = os.path.join(img_dir, img)
+            fsha = F.sha256_file(path)
+            if fsha != manifest[img]["file_sha256"]:
+                raise SystemExit(f"input hash mismatch {img}")
+            rgb, info = F.load_rgb(path)
+            ims.append(rgb)
+            rows.append({"image_id": img, "patient_id": str(tg["patient_id"][i]), "split": str(tg["split"][i]),
+                         "file_sha256": fsha, "input": info})
+        pv = proc(images=ims, return_tensors="pt")["pixel_values"]
+        for j, rgb in enumerate(ims):
+            ref_diff.append(float(np.abs(pv[j].numpy() - F.reference_pixel_values(rgb)).max()))
+            rows[b0 + j]["pixel_values_sha256"] = F.tensor_sha256(pv[j].numpy().astype(np.float32).view(np.uint32))
+        with torch.no_grad():
+            core.get_image_features(pixel_values=pv.to(device, torch.bfloat16))
+        z, p = cap["z"], cap["p"]  # (B,4096,C) bf16, (B,C,16,16) bf16
+        assert z.shape[1:] == (4096, F.C) and z.dtype == torch.bfloat16, z.shape
+        B = z.shape[0]
+        # 실제 P와 재구현 비교: (a) 같은 reshape에 F.avg_pool2d(bf16) → bit 일치 기대, (b) float32 재구현
+        zz = z.transpose(1, 2).reshape(B, F.C, 64, 64)
+        pa = torch.nn.functional.avg_pool2d(zz, 4)
+        pool_exact.append(float((pa.float() - p.float()).abs().max()))
+        pr = F.pool_tokens(z.float()).permute(0, 3, 1, 2)
+        pool_f32.append(float((pr - p.float()).abs().max() / p.float().abs().max()))
+        Z[b0:b0 + B] = z.reshape(B, 64, 64, F.C).view(torch.int16).cpu().numpy().view(np.uint16)
+        Pm[b0:b0 + B] = p.permute(0, 2, 3, 1).contiguous().view(torch.int16).cpu().numpy().view(np.uint16)
+    h1.remove()
+    h2.remove()
+    torch.cuda.synchronize()
+    t_ext = time.time() - t_ext
+    checks["pool_model_vs_avgpool2d_same_reshape_max_abs"] = max(pool_exact)
+    checks["pool_model_vs_f32_reimpl_max_rel"] = max(pool_f32)
+    checks["processor_vs_pil_reference_max_abs"] = max(ref_diff)
+    checks["processor_vs_pil_reference_note"] = "resize 구현 차이 허용; 공간 정렬은 spatial_transform으로 판정"
+    checks["pool_pass"] = bool(max(pool_exact) == 0.0 and max(pool_f32) < 1e-2)
+    checks["rgba_images"] = [r for r in rows if r["input"]["mode"] == "RGBA"]
+    checks["n_nonopaque"] = sum(1 for r in rows if r["input"]["mode"] == "RGBA" and not r["input"]["alpha_all_opaque"])
+    checks["peak_gpu_mem_gb"] = torch.cuda.max_memory_allocated() / 1e9
+    checks["extract_seconds"] = t_ext
+    checks["seconds_per_image"] = t_ext / N
+    checks["wall_seconds"] = time.time() - t_start
+    np.save(os.path.join(args.out, "Z_bf16.npy"), Z)
+    np.save(os.path.join(args.out, "P_model_bf16.npy"), Pm)
+    meta = {"images": rows, "shape": list(Z.shape), "dtype": "bfloat16", "storage": "uint16 view of bf16",
+            "feature_sha256": F.tensor_sha256(Z), "P_model_sha256": F.tensor_sha256(Pm),
+            "model_digest": checks["model_digest"], "processor_digest": F.processor_digest(),
+            "targets_sha256": F.sha256_file(args.targets), "selection": {"split": args.split, "limit": args.limit}}
+    F.dump(os.path.join(args.out, "cache_meta.json"), meta)
+    F.dump(os.path.join(args.out, "extract_checks.json"), checks)
+    print(json.dumps({k: checks[k] for k in ("pool_model_vs_avgpool2d_same_reshape_max_abs", "pool_model_vs_f32_reimpl_max_rel",
+                                             "processor_vs_pil_reference_max_abs", "pool_pass", "n_nonopaque",
+                                             "peak_gpu_mem_gb", "extract_seconds", "seconds_per_image",
+                                             "model_load_seconds", "wall_seconds")}, indent=1))
+    print("spatial", checks["spatial_transform"]["pass"], "token", checks["token_order"]["pass"],
+          "proj", checks["projector_synthetic"])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/fetch_nih_official_iter007.py b/fetch_nih_official_iter007.py
new file mode 100644
index 0000000..3a6a830
--- /dev/null
+++ b/fetch_nih_official_iter007.py
@@ -0,0 +1,111 @@
+"""iter_007: NIH 공식 Box 배포본(README·FAQ·LOG·BBox CSV·Data_Entry) 공개 조회 (CPU, 네트워크 소량).
+
+실행: python research/fetch_nih_official_iter007.py --page research/results/iter_006/coord_evidence/nih_box_official_page.html \
+          --out research/results/iter_007/official
+
+- 예산: 누적 20 MiB, ledger 계상 15분 (grounding_data/net.DownloadLedger). 인증·대용량이 필요하면 받지 않고 기록만 한다.
+- 파일 ID는 iter_006이 저장한 공식 Box 폴더 목록(공개 shared link 페이지)에서 읽는다. 공개 shared-file 다운로드 URL만 쓴다.
+- 받은 각 파일의 URL·HTTP 상태·bytes·sha256·Box 목록 크기(itemSize)·갱신 시각을 기록한다. PDF는 쪽별 text를 저장한다.
+- 응답이 로그인/HTML 페이지이거나 크기가 목록과 다르면 실패로 기록한다(자료로 쓰지 않음).
+"""
+import argparse
+import datetime
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from grounding_data import net  # noqa: E402
+
+BUDGET_BYTES = 20 * 1024 * 1024
+BUDGET_SECONDS = 15 * 60
+WANT = ["README_CHESTXRAY.pdf", "FAQ_CHESTXRAY.pdf", "LOG_CHESTXRAY.pdf", "BBox_List_2017.csv",
+        "Data_Entry_2017_v2020.csv"]
+BOX_HOST = "https://nihcc.app.box.com"
+
+
+def listing(page_path):
+    t = open(page_path, encoding="utf-8", errors="replace").read()
+    shared = re.search(r'"sharedName":"(\w+)"', t).group(1)
+    items = {}
+    for m in re.finditer(r'"typedID":"(f_\d+)","type":"file".{0,200}?"name":"([^"]+)","itemSize":(\d+),.{0,200}?'
+                         r'"contentUpdated":(\d+)', t):
+        items[m.group(2)] = {"typed_id": m.group(1), "itemSize": int(m.group(3)),
+                             "contentUpdated_utc": datetime.datetime.fromtimestamp(
+                                 int(m.group(4)), datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S")}
+    return shared, items
+
+
+def pdf_pages(path):
+    info = subprocess.run(["pdfinfo", path], capture_output=True, text=True).stdout
+    n = next((int(ln.split()[1]) for ln in info.splitlines() if ln.startswith("Pages:")), 0)
+    out = []
+    for p in range(1, n + 1):
+        out.append(subprocess.run(["pdftotext", "-f", str(p), "-l", str(p), path, "-"],
+                                  capture_output=True, text=True).stdout)
+    return info, out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--page", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    ledger = net.DownloadLedger(os.path.join(args.out, "download_ledger.json"), budget_bytes=BUDGET_BYTES,
+                                budget_seconds=BUDGET_SECONDS)
+    t0 = time.time()
+    shared, items = listing(args.page)
+    recs = {}
+    for name in WANT:
+        it = items.get(name)
+        rec = {"name": name, "listing": it, "fetched_at": time.strftime("%Y-%m-%d %H:%M:%S")}
+        if it is None:
+            recs[name] = {**rec, "ok": False, "error": "not_in_listing"}
+            continue
+        url = f"{BOX_HOST}/index.php?rm=box_download_shared_file&shared_name={shared}&file_id={it['typed_id']}"
+        rec["url"] = url
+        local = os.path.join(args.out, name)
+        try:
+            if os.path.exists(local) and os.path.getsize(local) == it["itemSize"]:
+                body, rec["fetch"] = open(local, "rb").read(), "cached"
+            else:
+                if time.time() - t0 > BUDGET_SECONDS:
+                    raise net.BudgetExceeded("wall budget")
+                body = ledger.get(url, name, expect_bytes=it["itemSize"])
+                rec["fetch"] = "downloaded"
+            head = body[:64]
+            if body[:15].lower().startswith(b"<!doctype html") or body[:6].lower() == b"<html>":
+                rec.update({"ok": False, "error": "html_response (login/interstitial?)", "bytes": len(body)})
+            elif len(body) != it["itemSize"]:
+                rec.update({"ok": False, "error": "size_differs_from_listing", "bytes": len(body)})
+            else:
+                with open(local, "wb") as f:
+                    f.write(body)
+                rec.update({"ok": True, "bytes": len(body), "sha256": net.sha256_bytes(body),
+                            "git_blob_sha1": net.git_blob_sha1(body), "local": local, "head": repr(head[:20])})
+                if name.endswith(".pdf"):
+                    info, pages = pdf_pages(local)
+                    rec["pdfinfo"] = info
+                    rec["n_pages"] = len(pages)
+                    for i, txt in enumerate(pages, start=1):
+                        with open(os.path.join(args.out, f"{name[:-4]}_p{i:02d}.txt"), "w") as f:
+                            f.write(txt)
+        except Exception as e:  # 접근 실패는 기록만 한다
+            rec.update({"ok": False, "error": repr(e)[:300]})
+        recs[name] = rec
+        print(name, rec.get("ok"), rec.get("bytes"), rec.get("n_pages"), rec.get("error"))
+    summary = {"shared_name": shared, "files": recs, "ledger_bytes_total": ledger.data["bytes_total"],
+               "ledger_network_seconds": ledger.data["seconds_total"], "ledger_n_requests": ledger.data["n_requests"],
+               "wall_seconds": time.time() - t0, "budget_bytes": BUDGET_BYTES, "budget_seconds": BUDGET_SECONDS,
+               "access": "공개 shared link만 사용 (인증 없음)",
+               "network_accounting_note": "ledger는 이 스크립트의 GET 본문만 계상한다. DNS·TLS·header 제외."}
+    with open(os.path.join(args.out, "fetch_summary.json"), "w") as f:
+        json.dump(summary, f, indent=1, ensure_ascii=False)
+
+
+if __name__ == "__main__":
+    main()
