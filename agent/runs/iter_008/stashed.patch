new file mode 100644
index 0000000..73935d5
--- /dev/null
+++ b/gate_pooling_probe_iter007.py
@@ -0,0 +1,119 @@
+"""iter_007 GPU 진입 gate: 13개 무결성 재검사 + 공식 배포본 대조 + 탐색 허용 정책 (CPU, 네트워크 없음).
+
+실행: python research/gate_pooling_probe_iter007.py --src research/results/iter_005 \
+          --evidence research/results/iter_006/coord_evidence --official research/results/iter_007/official \
+          --out research/results/iter_007
+
+- iter_005/006 산출물은 읽기 전용. 엄격한 lesion_probe_ready는 재계산만 하고 덮어쓰지 않는다.
+- 결과: results/iter_007/gate_iter007.json (exploratory_probe_allowed, 가정·근거 digest).
+"""
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from audit_grounding_iter006 import tree_digest  # noqa: E402
+from grounding_data import coord_evidence, nih_audit  # noqa: E402
+from pooling_probe import gate as G  # noqa: E402
+
+
+def pdf_pages_plain(path):
+    info = subprocess.run(["pdfinfo", path], capture_output=True, text=True).stdout
+    n = next((int(ln.split()[1]) for ln in info.splitlines() if ln.startswith("Pages:")), 0)
+    return [subprocess.run(["pdftotext", "-f", str(p), "-l", str(p), path, "-"], capture_output=True,
+                           text=True).stdout for p in range(1, n + 1)], info
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--src", required=True)
+    ap.add_argument("--evidence", required=True)
+    ap.add_argument("--official", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+    t0 = time.time()
+    before = tree_digest(args.src)
