@@ -0,0 +1,114 @@
+"""Pointwise head 학습과 coarse loss (iter_007, torch).
+
+- 조건: "Z" = pooling 전 feature (B,64,64,C), "UPZ" = U(P(Z)) (4×4 평균 후 nearest upsampling).
+- head: linear C→4, MLP C→128→4 (GELU, dropout 없음). 두 조건에서 같은 seed → 같은 초기 가중치.
+- 주분석 loss: BCEWithLogits(P(head(feature)), coarse_target). 관측 image–class 쌍마다 공간 평균 → 쌍 평균.
+  unknown(observed=False) 쌍은 제외 (gradient 0).
+- 예측: fine = sigmoid(head(feature)), coarse = sigmoid(P(head(feature))).
+"""
+import numpy as np
+import torch
+import torch.nn as nn
+import torch.nn.functional as TF
+
+K = 4
+HIDDEN = 128
+
+
+def make_head(kind, C, seed, dtype=torch.float32):
+    g = torch.Generator().manual_seed(int(seed))
+    if kind == "linear":
+        m = nn.Linear(C, K)
+        layers = [m]
+    elif kind == "mlp":
+        layers = [nn.Linear(C, HIDDEN), nn.GELU(), nn.Linear(HIDDEN, K)]
+        m = nn.Sequential(*layers)
+    else:
+        raise ValueError(kind)
+    # nn.Linear 기본 초기화(kaiming_uniform a=√5, bias uniform)와 같은 분포를 전용 generator로 재현
+    for l in layers:
+        if isinstance(l, nn.Linear):
+            bound = 1.0 / np.sqrt(l.in_features)
+            with torch.no_grad():
+                l.weight.uniform_(-bound, bound, generator=g)
+                l.bias.uniform_(-bound, bound, generator=g)
+    return m.to(dtype)
+
+
+def n_params(m):
+    return int(sum(p.numel() for p in m.parameters()))
+
+
+def pool_grid(x, pool=4):
+    """x (B,h,w,C) → (B,h/pool,w/pool,C) 평균."""
+    B, h, w, C = x.shape
+    return x.reshape(B, h // pool, pool, w // pool, pool, C).mean(dim=(2, 4))
+
+
+def upsample_grid(x, pool=4):
+    return x.repeat_interleave(pool, dim=1).repeat_interleave(pool, dim=2)
+
+
+def condition_input(feat, cond, pool=4):
+    """feat (B,64,64,C) float → 조건 입력. UPZ는 같은 feature에서 P 후 U."""
+    if cond == "Z":
+        return feat
+    if cond == "UPZ":
+        return upsample_grid(pool_grid(feat, pool), pool)
+    raise ValueError(cond)
+
+
+def forward_logits(head, x, pool=4):
+    """x (B,h,w,C) → fine logits (B,K,h,w), coarse logits (B,K,h/pool,w/pool) = P(fine logits)."""
+    fine = head(x).permute(0, 3, 1, 2)
+    coarse = TF.avg_pool2d(fine, pool)
+    return fine, coarse
+
+
+def masked_pair_bce(coarse_logits, target, observed):
+    """(B,K,h,w) logits/target, observed (B,K) bool → 관측 쌍별 공간 평균 BCE의 평균."""
+    per = TF.binary_cross_entropy_with_logits(coarse_logits, target, reduction="none").mean(dim=(2, 3))
+    m = observed.bool()
+    if not m.any():
+        raise ValueError("no observed pair in batch")
+    return per[m].mean()
+
+
+def batch_schedule(n_train, n_updates, batch, seed):
+    """epoch별 permutation을 이어 붙인 고정 batch 순서 (n_updates, batch). 두 조건이 공유한다."""
+    rng = np.random.default_rng(int(seed))
+    need = n_updates * batch
+    order = []
+    while len(order) < need:
+        order.extend(rng.permutation(n_train).tolist())
+    return np.array(order[:need]).reshape(n_updates, batch)
+
+
+def train_head(kind, cond, feats, targets, observed, schedule, lr, seed, device, pool=4, C=None, log_every=1):
+    """feats: callable(idx)->(B,64,64,C) float32 on device. 반환 (head, losses list)."""
+    C = C or feats(np.array([0])).shape[-1]
+    head = make_head(kind, C, seed).to(device)
+    opt = torch.optim.AdamW(head.parameters(), lr=lr, weight_decay=0.0)
+    losses = []
+    for u, idx in enumerate(schedule):
+        x = condition_input(feats(idx), cond, pool)
+        _, co = forward_logits(head, x, pool)
+        loss = masked_pair_bce(co, targets[idx], observed[idx])
+        opt.zero_grad(set_to_none=True)
+        loss.backward()
+        opt.step()
+        if u % log_every == 0 or u == len(schedule) - 1:
+            losses.append(float(loss.detach()))
+    return head, losses
+
+
+@torch.no_grad()
+def predict(head, cond, feats, n, device, pool=4, bs=8):
+    """모든 영상 예측: coarse prob (N,K,16,16) float32, fine prob (N,K,64,64) float16."""
+    co_all, fi_all = [], []
+    for b in range(0, n, bs):
+        idx = np.arange(b, min(n, b + bs))
+        fine, co = forward_logits(head, condition_input(feats(idx), cond, pool), pool)
+        co_all.append(torch.sigmoid(co).float().cpu())
+        fi_all.append(torch.sigmoid(fine).half().cpu())
+    return torch.cat(co_all).numpy(), torch.cat(fi_all).numpy()
