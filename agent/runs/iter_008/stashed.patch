+"""평가 집계 (iter_007): seed별 patient 점수 → 같은 patient의 seed 평균 → 공유 patient bootstrap.
+
+seed를 독립 patient처럼 쌓지 않는다: bootstrap은 항상 길이 n_patients 벡터에 적용한다.
+"""
+import numpy as np
+
+from grounding_data import class_targets as CT
+
+
+def run_scores(pred, target, observed, patient_id, sel):
+    """한 run(seed)의 split sel 점수. 반환: per_patient 벡터(정렬된 patient 순), 쌍 점수 행렬, patients."""
+    S = CT.score_matrix(pred[sel], target[sel], observed[sel])
+    ag = CT.aggregate(S, observed[sel], patient_id[sel])
+    return {"per_patient": ag["per_patient"], "patients": ag["patients"], "pair_scores": S,
+            "patient_macro": ag["patient_macro"], "per_class": ag["per_class"]}
+
+
+def swap_pred(pred, donor):
+    """image-swap 예측: out[i,k] = pred[donor[i,k], k] (donor -1이면 NaN으로 두어 평가 제외 확인)."""
+    out = np.full_like(pred, np.nan, dtype=np.float64)
+    N, K = donor.shape
+    for i in range(N):
+        for k in range(K):
+            if donor[i, k] >= 0:
+                out[i, k] = pred[donor[i, k], k]
+    return out
+
+
+def seed_average(runs):
+    """runs: seed별 run_scores 결과 리스트 → patient별 seed 평균(길이 n_patients)과 쌍별 seed 평균."""
+    pats = runs[0]["patients"]
+    for r in runs:
+        if r["patients"] != pats:
+            raise ValueError("patient order differs across seeds")
+    pp = np.mean([r["per_patient"] for r in runs], axis=0)
+    pair = np.mean([r["pair_scores"] for r in runs], axis=0)  # NaN(unknown) 위치는 seed 간 동일
+    return {"per_patient": pp, "patients": pats, "pair_scores": pair, "patient_macro": float(pp.mean()),
+            "per_seed_macro": [float(r["patient_macro"]) for r in runs]}
+
+
+def per_class_means(pair_scores, observed_sel):
+    K = observed_sel.shape[1]
+    return [float(pair_scores[observed_sel[:, k], k].mean()) for k in range(K)]
+
+
+def paired(a, b, idx):
+    if len(a) != idx.shape[1] or len(b) != idx.shape[1]:
+        raise ValueError("bootstrap index length must equal number of patients")
+    return CT.paired_bootstrap_ci(a, b, idx)
