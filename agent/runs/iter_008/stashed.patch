+"""iter_007: Z 대 U(P(Z)) pointwise head probe — 학습 24개, validation LR 선택, test 평가, 대조군, bootstrap.
+
+실행 (pilot, 추출 pilot 4장으로 비용 실측):
+  python research/run_pooling_probe_iter007.py --gpu 1 --features research/results/iter_007/pilot --pilot \
+      --out research/results/iter_007/pilot_train
+실행 (본 실험):
+  python research/run_pooling_probe_iter007.py --gpu 1 --features research/results/iter_007/features \
+      --out research/results/iter_007/probe
+
+고정 설정 (계획 iter_007, 결과를 보고 바꾸지 않음)
+- head: linear 1152→4, MLP 1152→128→4 GELU. AdamW wd=0, batch 8, 200 updates, lr ∈ {1e-3, 3e-4}, seed ∈ {0,1,2}.
+- loss: BCEWithLogits(P(head(feature)), coarse_target), 관측 쌍별 공간 평균 → 쌍 평균.
+- LR 선택: head 종류별로 두 조건 × 3 seed의 validation coarse soft-IoU(patient macro) 평균 최대, 동률이면 작은 lr.
+  마지막 update를 평가. selection 파일을 먼저 쓰고 그 뒤에만 test 점수를 계산한다.
+- linear 대조군 허용오차(test 전 고정): LIN_TOL_PROB, LIN_TOL_MACRO.
+- 예산: 추출 포함 45 device-min. 초과 예상이면 시작하지 않고, 도달하면 partial로 중단한다.
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--gpu", default="1")
+ap.add_argument("--features", required=True)
+ap.add_argument("--out", required=True)
+ap.add_argument("--pilot", action="store_true")
+ap.add_argument("--extract-device-min", type=float, default=None, help="추출에 쓴 device-min (예산 합산)")
+_here = os.path.dirname(os.path.abspath(__file__))
+ap.add_argument("--gate", default=os.path.join(_here, "results/iter_007/gate_iter007.json"))
+ap.add_argument("--tests", default=os.path.join(_here, "results/iter_007/tests_iter007.json"))
+ap.add_argument("--targets", default=os.path.join(_here, "results/iter_006/nih_class_targets.npz"))
+args = ap.parse_args()
+os.environ["CUDA_VISIBLE_DEVICES"] = args.gpu
+
+import numpy as np  # noqa: E402
+import torch  # noqa: E402
+
+sys.path.insert(0, _here)
+from grounding_data import class_targets as CT  # noqa: E402
+from pooling_probe import evaluate as E  # noqa: E402
+from pooling_probe import features as F  # noqa: E402
+from pooling_probe import probe as PR  # noqa: E402
+
+KINDS = ["linear", "mlp"]
+CONDS = ["Z", "UPZ"]
+LRS = [3e-4, 1e-3]  # 오름차순 (동률이면 작은 lr)
+SEEDS = [0, 1, 2]
+N_UPDATES = 200
+BATCH = 8
+BUDGET_DEVICE_MIN = 45.0
+LIN_TOL_PROB = 5e-3   # linear: 두 조건의 coarse prob 최대 절대 차이
+LIN_TOL_MACRO = 1e-3  # linear: 두 조건의 patient macro soft-IoU 차이
+MARGIN = 0.03
+B_BOOT = 2000
+
+
+def sha(path):
+    return F.sha256_file(path)
+
+
+def dump(path, obj):
+    F.dump(path, obj)
+
+
+def main():
+    t_start = time.time()
+    os.makedirs(args.out, exist_ok=True)
+    status_path = os.path.join(args.out, "status.json")
+    status = {"state": "running", "eval_complete": False, "started": time.strftime("%Y-%m-%d %H:%M:%S")}
+    dump(status_path, status)
+
+    gate = json.load(open(args.gate))
+    if gate.get("exploratory_probe_allowed") is not True:
+        raise SystemExit("gate blocks")
+    tests = json.load(open(args.tests)) if os.path.exists(args.tests) else None
+    if not args.pilot and not (tests and tests.get("all_pass") is True):
+        raise SystemExit("verification tests not passed; run test_pooling_probe_iter007.py first")
+
+    tg = np.load(args.targets)
+    meta = json.load(open(os.path.join(args.features, "cache_meta.json")))
+    ids = [r["image_id"] for r in meta["images"]]
+    tidx = {str(x): i for i, x in enumerate(tg["image_id"])}
+    rows = np.array([tidx[i] for i in ids])  # cache 순서 → target index
+    if not args.pilot:
+        if len(rows) != len(tg["image_id"]) or not (rows == np.arange(len(rows))).all():
+            raise SystemExit("full cache must cover all targets in order")
+    Zu = np.load(os.path.join(args.features, "Z_bf16.npy"))
+    F.verify_cache(meta, Zu, [str(x) for x in tg["image_id"][rows]], [str(x) for x in tg["patient_id"][rows]])
+    coarse = tg["coarse"][rows]
+    fine = tg["fine"][rows]
+    obs = tg["observed"][rows]
+    split = tg["split"][rows]
+    pid = tg["patient_id"][rows]
+    N = len(rows)
+
+    device = "cuda"
+    Zg = torch.from_numpy(Zu.view(np.int16)).view(torch.bfloat16).to(device)
+    del Zu
+    tgt_c = torch.from_numpy(coarse).float().to(device)
+    obs_t = torch.from_numpy(obs).to(device)
+    feats = lambda idx: Zg[torch.as_tensor(idx, device=device)].float()  # noqa: E731
+    train_idx = np.where(split == "train")[0]
+    feats_train = lambda j: feats(train_idx[j])  # noqa: E731
+    tgt_train, obs_train = tgt_c[train_idx], obs_t[train_idx]
+
+    prior_min = args.extract_device_min or 0.0
+    runs, times = {}, {}
+    plan = [(k, lr, s, c) for k in KINDS for lr in LRS for s in SEEDS for c in CONDS]
+    if args.pilot:
+        plan = [(k, 1e-3, 0, c) for k in KINDS for c in CONDS]
+    pred_dir = os.path.join(args.out, "predictions")
+    os.makedirs(pred_dir, exist_ok=True)
+    partial = None
+    for (k, lr, s, c) in plan:
+        used = prior_min + (time.time() - t_start) / 60
+        if used > BUDGET_DEVICE_MIN:
+            partial = f"budget reached at {used:.1f} device-min before {k}/{c}/lr{lr}/s{s}"
+            break
+        sched = PR.batch_schedule(len(train_idx), N_UPDATES, BATCH, s)
+        torch.cuda.synchronize()
+        t0 = time.time()
+        head, losses = PR.train_head(k, c, feats_train, tgt_train, obs_train, sched, lr, s, device, C=F.C)
+        torch.cuda.synchronize()
+        t_tr = time.time() - t0
+        cp, fp = PR.predict(head, c, feats, N, device)
+        t_all = time.time() - t0
+        key = f"{k}|{c}|{lr:g}|{s}"
+        name = f"{k}_{c}_lr{lr:g}_s{s}"
+        np.savez_compressed(os.path.join(pred_dir, name + ".npz"), coarse_prob=cp, fine_prob=fp,
+                            image_id=np.array(ids), losses=np.array(losses))
+        runs[key] = {"coarse": cp, "fine": fp.astype(np.float32), "losses": losses, "n_params": PR.n_params(head),
+                     "file": name + ".npz"}
+        times[key] = {"train_s": t_tr, "train_plus_predict_s": t_all}
+        print(key, f"loss {losses[0]:.4f}->{losses[-1]:.4f}", f"{t_tr:.1f}s", flush=True)
+    device_min = prior_min + (time.time() - t_start) / 60
+    peak = torch.cuda.max_memory_allocated() / 1e9
+
+    if args.pilot:
+        per = {k: np.mean([times[f"{k}|{c}|0.001|0"]["train_plus_predict_s"] for c in CONDS]) for k in KINDS}
+        est = sum(per[k] * len(LRS) * len(SEEDS) * len(CONDS) for k in KINDS) / 60
+        out = {"pilot": True, "n_images": N, "times": times, "peak_gpu_mem_gb": peak,
+               "est_24_runs_device_min": est,
+               "note": "학습 비용은 update 수·batch에 비례(영상 수와 무관); predict는 160장으로 늘어 증가(추정치)",
+               "params": {k: runs[f"{k}|Z|0.001|0"]["n_params"] for k in KINDS}}
+        dump(os.path.join(args.out, "pilot_cost.json"), out)
+        print(json.dumps(out, indent=1))
+        return
+
+    losses_all = {k: v["losses"] for k, v in runs.items()}
+    dump(os.path.join(args.out, "train_losses.json"), losses_all)
+    if partial:
+        status.update({"state": "partial", "reason": partial, "n_runs_done": len(runs), "device_min": device_min})
+        dump(status_path, status)
+        raise SystemExit(partial)
+
+    # ---------------- validation 선택 (test 점수 계산 전)
+    val = split == "validation"
+    val_scores, sel_tab = {}, {}
+    for key, r in runs.items():
+        val_scores[key] = E.run_scores(r["coarse"], coarse, obs, pid, val)["patient_macro"]
+    selection = {}
+    for k in KINDS:
+        tab = {f"{lr:g}": float(np.mean([val_scores[f"{k}|{c}|{lr:g}|{s}"] for c in CONDS for s in SEEDS])) for lr in LRS}
+        best = max(tab.values())
+        chosen = min(lr for lr in LRS if tab[f"{lr:g}"] == best)  # 동률이면 작은 lr
+        selection[k] = {"val_mean_by_lr": tab, "chosen_lr": chosen}
+        sel_tab[k] = {key: v for key, v in val_scores.items() if key.startswith(k + "|")}
+    # linear 대조군 (train·validation에서 먼저 확인)
+    lin = {}
+    for lr in LRS:
+        for s in SEEDS:
+            a, b = runs[f"linear|Z|{lr:g}|{s}"], runs[f"linear|UPZ|{lr:g}|{s}"]
+            nt = ~(split == "test")
+            lin[f"{lr:g}|{s}"] = {
+                "max_abs_coarse_prob_diff_trainval": float(np.abs(a["coarse"][nt] - b["coarse"][nt]).max()),
+                "max_abs_loss_diff": float(np.abs(np.array(a["losses"]) - np.array(b["losses"])).max()),
+                "val_macro_diff": float(val_scores[f"linear|Z|{lr:g}|{s}"] - val_scores[f"linear|UPZ|{lr:g}|{s}"])}
+    lin_pass_pre = all(v["max_abs_coarse_prob_diff_trainval"] <= LIN_TOL_PROB and abs(v["val_macro_diff"]) <= LIN_TOL_MACRO
+                       for v in lin.values())
+    selection_doc = {"selection": selection, "val_scores": sel_tab, "rule": "두 조건×3 seed 평균 최대, 동률이면 작은 lr, 마지막 update",
+                     "linear_control_pre_test": lin, "linear_tol": {"prob": LIN_TOL_PROB, "macro": LIN_TOL_MACRO},
+                     "linear_control_pre_test_pass": lin_pass_pre, "written_before_test_scoring": True,
+                     "time": time.strftime("%Y-%m-%d %H:%M:%S")}
+    sel_path = os.path.join(args.out, "validation_selection.json")
+    dump(sel_path, selection_doc)
+    sel_hash = sha(sel_path)
+
+    # ---------------- test 평가 (선택된 lr만)
+    test = split == "test"
+    obs_te = obs[test]
+    donor = CT.image_swap_derangement(pid, split, obs)
+    prior = CT.location_prior(coarse, obs, split)
+    prior_f = CT.location_prior(fine, obs, split)
+    idx = CT.bootstrap_indices(int(test.sum()), B_BOOT)
+    np.save(os.path.join(args.out, "bootstrap_indices.npy"), idx)
+    res = {"selection_sha256": sel_hash, "methods": {}, "per_seed": {}}
+    seedavg = {}
+    for k in KINDS:
+        lr = selection[k]["chosen_lr"]
+        for c in CONDS:
+            for res_name, tgt, pkey in (("coarse", coarse, "coarse"), ("fine", fine, "fine")):
+                rs = [E.run_scores(runs[f"{k}|{c}|{lr:g}|{s}"][pkey], tgt, obs, pid, test) for s in SEEDS]
+                sa = E.seed_average(rs)
+                seedavg[(k, c, res_name)] = sa
+                sw = [E.run_scores(E.swap_pred(runs[f"{k}|{c}|{lr:g}|{s}"][pkey], donor), tgt, obs, pid, test) for s in SEEDS]
+                seedavg[(k, c, res_name, "swap")] = E.seed_average(sw)
+    patients = seedavg[("mlp", "Z", "coarse")]["patients"]
+    for res_name, tgt, pr in (("coarse", coarse, prior), ("fine", fine, prior_f)):
+        pp = np.broadcast_to(pr, tgt.shape)
+        r0 = E.run_scores(pp, tgt, obs, pid, test)
+        if r0["patients"] != patients:
+            raise SystemExit("patient order mismatch")
+        seedavg[("prior", res_name)] = {"per_patient": r0["per_patient"], "pair_scores": r0["pair_scores"],
+                                        "patient_macro": r0["patient_macro"], "patients": r0["patients"]}
+
+    def summ(sa):
+        return {"patient_macro": sa["patient_macro"], "per_seed_macro": sa.get("per_seed_macro"),
+                "per_class": E.per_class_means(sa["pair_scores"], obs_te),
+                "per_patient": [float(x) for x in sa["per_patient"]]}
+
+    for key, sa in seedavg.items():
+        res["methods"]["/".join(key)] = summ(sa)
+    comps = {}
+    for res_name in ("coarse", "fine"):
+        for k in KINDS:
+            z, u = seedavg[(k, "Z", res_name)], seedavg[(k, "UPZ", res_name)]
+            comps[f"{res_name}/{k}: Z - UPZ"] = E.paired(z["per_patient"], u["per_patient"], idx)
+            comps[f"{res_name}/{k}: Z - prior"] = E.paired(z["per_patient"], seedavg[("prior", res_name)]["per_patient"], idx)
+            comps[f"{res_name}/{k}: Z - swap(Z)"] = E.paired(z["per_patient"], seedavg[(k, "Z", res_name, "swap")]["per_patient"], idx)
+            comps[f"{res_name}/{k}: UPZ - prior"] = E.paired(u["per_patient"], seedavg[("prior", res_name)]["per_patient"], idx)
+            comps[f"{res_name}/{k}: UPZ - swap(UPZ)"] = E.paired(u["per_patient"], seedavg[(k, "UPZ", res_name, "swap")]["per_patient"], idx)
+            comps[f"{res_name}/{k}: Z - UPZ per-seed macro diff"] = [a - b for a, b in zip(z["per_seed_macro"], u["per_seed_macro"])]
+            comps[f"{res_name}/{k}: Z - UPZ per-class"] = [a - b for a, b in zip(E.per_class_means(z["pair_scores"], obs_te),
+                                                                                 E.per_class_means(u["pair_scores"], obs_te))]
+    res["comparisons"] = comps
+
+    # linear 대조군 test 확인 (허용오차는 위에서 고정)
+    lr_l = selection["linear"]["chosen_lr"]
+    lin_test = {s: float(np.abs(runs[f"linear|Z|{lr_l:g}|{s}"]["coarse"][test] - runs[f"linear|UPZ|{lr_l:g}|{s}"]["coarse"][test]).max())
+                for s in SEEDS}
+    lin_macro = comps["coarse/linear: Z - UPZ"]["mean_diff"]
+    lin_pass = bool(lin_pass_pre and max(lin_test.values()) <= LIN_TOL_PROB and abs(lin_macro) <= LIN_TOL_MACRO)
+
+    m = comps["coarse/mlp: Z - UPZ"]
+    crit = {
+        "mlp_Z_minus_UPZ_ge_0.03": m["mean_diff"] >= MARGIN,
+        "mlp_Z_minus_UPZ_ci_low_gt_0": m["ci_low"] > 0,
+        "mlp_Z_minus_prior_ge_0.03": comps["coarse/mlp: Z - prior"]["mean_diff"] >= MARGIN,
+        "mlp_Z_minus_swap_ge_0.03": comps["coarse/mlp: Z - swap(Z)"]["mean_diff"] >= MARGIN,
+        "mlp_Z_minus_UPZ_positive_in_ge2_classes": sum(d > 0 for d in comps["coarse/mlp: Z - UPZ per-class"]) >= 2,
+        "integrity_alignment_linear_complete": None,  # 아래에서 채움
+    }
+    ext = json.load(open(os.path.join(args.features, "extract_checks.json")))
+    integ = {"gate_exploratory_allowed": gate["exploratory_probe_allowed"] is True,
+             "tests_all_pass": tests["all_pass"] is True,
+             "spatial_transform": ext["spatial_transform"]["pass"], "token_order": ext["token_order"]["pass"],
+             "projector_synthetic": ext["projector_synthetic"]["pass"], "pool_pass": ext["pool_pass"],
+             "linear_control": lin_pass, "all_24_runs": len(runs) == len(plan)}
+    crit["integrity_alignment_linear_complete"] = all(integ.values())
+    res.update({"criteria": crit, "all_criteria_pass": all(crit.values()), "integrity": integ,
+                "linear_control_test": {"max_abs_coarse_prob_diff": lin_test, "macro_diff": lin_macro,
+                                        "tol": {"prob": LIN_TOL_PROB, "macro": LIN_TOL_MACRO}, "pass": lin_pass},
+                "selection": selection, "n_test_patients": int(test.sum()),
+                "test_observed_per_class": obs_te.sum(axis=0).tolist(), "classes": CT.MAIN_CLASSES,
+                "params": {k: runs[f"{k}|Z|{LRS[0]:g}|0"]["n_params"] for k in KINDS},
+                "times": times, "device_min_train_eval": (time.time() - t_start) / 60,
+                "device_min_total_incl_extract": prior_min + (time.time() - t_start) / 60, "peak_gpu_mem_gb": peak,
+                "swap_donor": donor.tolist(), "patients": patients,
+                "interpretation_limits": ["assumed canvas: 조건부 탐색 신호이며 확증 아님",
+                                          "공식 test를 재분할한 개발 split, 공식 benchmark 아님",
+                                          "bbox occupancy는 segmentation GT 아님; 4클래스 한정",
+                                          "양성이어도 정보의 완전 소실이나 LLM 인과 병목을 증명하지 않음"]})
+    res_path = os.path.join(args.out, "probe_results.json")
+    dump(res_path, res)
+    hashes = {f: sha(os.path.join(pred_dir, f)) for f in sorted(os.listdir(pred_dir))}
+    for f in ("probe_results.json", "validation_selection.json", "train_losses.json", "bootstrap_indices.npy"):
+        hashes[f] = sha(os.path.join(args.out, f))
+    complete = bool(len(runs) == len(plan) and integ["tests_all_pass"] and integ["gate_exploratory_allowed"]
+                    and len(hashes) == len(plan) + 4)
+    status.update({"state": "complete" if complete else "incomplete", "eval_complete": complete,
+                   "all_criteria_pass": res["all_criteria_pass"], "output_sha256": hashes,
+                   "device_min_total_incl_extract": res["device_min_total_incl_extract"],
+                   "finished": time.strftime("%Y-%m-%d %H:%M:%S")})
+    dump(status_path, status)
+    print(json.dumps({"selection": selection, "criteria": crit, "integrity": integ,
+                      "mlp": {k: comps[f"coarse/mlp: {k}"] for k in ("Z - UPZ", "Z - prior", "Z - swap(Z)")},
+                      "linear Z-UPZ": comps["coarse/linear: Z - UPZ"]}, indent=1, default=str))
+
+
+if __name__ == "__main__":
