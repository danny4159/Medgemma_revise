+++ b/pooling_probe/features.py
@@ -0,0 +1,113 @@
+"""입력 전처리·feature 추출 지점·pooling 재구현·cache 무결성 (iter_007).
+
+Feature 지점 (transformers Gemma3Model.get_image_features 확인):
+  Z = vision_tower(pixel_values).last_hidden_state  (B, 4096, 1152), token t ↔ (row t//64, col t%64)
+  projector: Z.transpose(1,2).reshape(B,1152,64,64) → AvgPool2d(4) → RMSNorm → projection
+  → 비교는 AvgPool2d 출력(P)까지만 쓴다. RMSNorm·projection은 섞지 않는다.
+"""
+import hashlib
+import json
+import os
+
+import numpy as np
+from PIL import Image
+
+GRID = 64
+POOL = 4
+C = 1152
+MODEL_DIR = ("/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache/hub/models--google--medgemma-1.5-4b-it/"
+             "snapshots/91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b")
+MODEL_REVISION = "91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b"
+
+
+def sha256_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for c in iter(lambda: f.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def load_rgb(path):
+    """L → 같은 값을 RGB 3채널로 복제. RGBA → 검정 배경 alpha composite. 그 외 mode는 거부.
+
+    반환: (RGB PIL, 기록용 dict). RGBA가 모두 opaque면 RGB 채널 drop과 같은지 확인한다.
+    """
+    im = Image.open(path)
+    im.load()
+    info = {"mode": im.mode, "size": list(im.size)}
+    if im.mode == "L":
+        a = np.asarray(im)
+        rgb = np.repeat(a[..., None], 3, axis=2)
+    elif im.mode == "RGBA":
+        a = np.asarray(im).astype(np.float64)
+        alpha = a[..., 3] / 255.0
+        comp = np.round(a[..., :3] * alpha[..., None]).astype(np.uint8)  # 검정(0) 배경
+        info.update({"alpha_min": int(a[..., 3].min()), "alpha_max": int(a[..., 3].max()),
+                     "alpha_all_opaque": bool((a[..., 3] == 255).all()),
+                     "rgb_channels_equal": bool((a[..., 0] == a[..., 1]).all() and (a[..., 1] == a[..., 2]).all()),
+                     "channel_mean": [float(a[..., i].mean()) for i in range(4)]})
+        info["composite_equals_rgb_drop"] = bool((comp == a[..., :3].astype(np.uint8)).all())
+        rgb = comp
+    else:
+        raise ValueError(f"unsupported mode {im.mode}")
+    return Image.fromarray(np.ascontiguousarray(rgb), "RGB"), info
+
+
+def reference_pixel_values(rgb, size=896):
+    """processor 설정(resize bilinear 896, /255, (x-0.5)/0.5)을 PIL로 직접 재현한 비교 기준 (C,H,W)."""
+    r = rgb.resize((size, size), resample=Image.BILINEAR)
+    x = np.asarray(r).astype(np.float32) / 255.0
+    return ((x - 0.5) / 0.5).transpose(2, 0, 1)
+
+
+def pool_tokens(z, pool=POOL, grid=GRID):
+    """재구현 P: token (…, 4096, C) → (…, 16, 16, C) 4×4 평균 (row-major token 순서)."""
+    s = z.shape
+    x = z.reshape(s[:-2] + (grid // pool, pool, grid // pool, pool, s[-1]))
+    return x.mean(axis=(-4, -2)) if isinstance(x, np.ndarray) else x.mean(dim=(-4, -2))
+
+
+def model_digest(model_dir=MODEL_DIR):
+    files = ["config.json", "model.safetensors.index.json", "preprocessor_config.json", "processor_config.json"]
+    d = {f: sha256_file(os.path.join(model_dir, f)) for f in files}
+    # LFS blob 이름 = 가중치 파일 sha256 (symlink 대상)
+    for f in ("model-00001-of-00002.safetensors", "model-00002-of-00002.safetensors"):
+        d[f + "_blob"] = os.path.basename(os.path.realpath(os.path.join(model_dir, f)))
+    d["revision"] = MODEL_REVISION
+    return d
+
+
+def processor_digest(model_dir=MODEL_DIR):
+    return {f: sha256_file(os.path.join(model_dir, f)) for f in ("preprocessor_config.json", "processor_config.json")}
+
+
+def tensor_sha256(arr_u16):
+    """bf16 텐서를 uint16 view(np)로 받아 byte hash."""
+    return hashlib.sha256(np.ascontiguousarray(arr_u16).tobytes()).hexdigest()
+
+
+class CacheError(RuntimeError):
+    pass
+
+
+def verify_cache(meta, Z_u16, target_ids, target_patients):
+    """cache를 쓰기 전 검사: ID·patient 순서 일치, shape·dtype, feature hash. 하나라도 틀리면 CacheError."""
+    ids = [r["image_id"] for r in meta["images"]]
+    pats = [r["patient_id"] for r in meta["images"]]
+    if ids != list(target_ids):
+        raise CacheError("image_id order/content differs from targets")
+    if pats != list(target_patients):
+        raise CacheError("patient_id differs from targets")
+    if list(Z_u16.shape) != meta["shape"] or str(Z_u16.dtype) != "uint16" or meta["dtype"] != "bfloat16":
+        raise CacheError(f"shape/dtype mismatch {Z_u16.shape} {Z_u16.dtype} vs {meta['shape']} {meta['dtype']}")
+    if tensor_sha256(Z_u16) != meta["feature_sha256"]:
+        raise CacheError("feature tensor hash mismatch (tampered?)")
+    return True
+
+
+def dump(path, obj):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f, indent=1, ensure_ascii=False, default=str)
+    os.replace(tmp, path)
