@@ -0,0 +1,131 @@
+"""공식 배포본 대조와 탐색 probe 허용 정책 (iter_007, CPU).
+
+- 엄격한 `lesion_probe_ready`(integrity AND documented_direct)는 그대로 두고 덮어쓰지 않는다.
+- `exploratory_probe_allowed` = 13개 필수 검사 통과 AND canvas status == "assumed" AND 새 모순 없음.
+  새 모순: 공식본 README/FAQ에서 좌표 규약과 충돌하는 문장, 선택 160장의 annotation·patient·finding 차이,
+  공식 BBox CSV의 좌표가 가정 canvas를 벗어남. 하나라도 있으면 GPU 진입을 막는다.
+- canvas status가 undocumented이거나 integrity 실패면 막는다. documented_direct면 엄격 gate를 재평가한다.
+"""
+import hashlib
+import json
+import os
+import re
+
+from grounding_data import nih, nih_audit
+
+# 공식 문서에서 직접 canvas 문장 후보를 찾는 패턴 (찾으면 원문 확인 전까지 판정을 바꾸지 않고 보고만 한다)
+DIRECT_HINT = re.compile(r"(bbox|bounding box|b-box)[^.]{0,120}(pixel|1024|coordinate system|image coordinate)", re.I)
+
+
+def _norm(s):
+    return " ".join(s.replace(" ", " ").split())
+
+
+def pdf_text_diff(official_pages, mirror_pages):
+    """쪽별 정규화 text 비교. 반환: 같은 쪽 수 여부, 다른 쪽 번호, 공식본에만 있는 줄(최대 40개)."""
+    o = [_norm(t) for t in official_pages]
+    m = [_norm(t) for t in mirror_pages]
+    diff_pages = [i + 1 for i in range(max(len(o), len(m))) if (o[i] if i < len(o) else None) != (m[i] if i < len(m) else None)]
+    ol = {ln.strip() for t in official_pages for ln in t.splitlines() if ln.strip()}
+    ml = {ln.strip() for t in mirror_pages for ln in t.splitlines() if ln.strip()}
+    return {"n_pages_official": len(o), "n_pages_mirror": len(m), "pages_text_differ": diff_pages,
+            "lines_only_in_official": sorted(ol - ml)[:40], "lines_only_in_mirror": sorted(ml - ol)[:40],
+            "normalized_text_identical": o == m}
+
+
+def direct_canvas_hints(pages_by_doc):
+    out = []
+    for doc, pages in pages_by_doc.items():
+        for i, t in enumerate(pages, start=1):
+            for m in DIRECT_HINT.finditer(_norm(t)):
+                out.append({"doc": doc, "page": i, "text": m.group(0)[:300]})
+    return out
+
+
+def bbox_compare(official_text, mirror_text, selected_images):
+    ob, orep = nih.parse_bbox_csv(official_text)
+    mb, mrep = nih.parse_bbox_csv(mirror_text)
+    key = lambda b: (b["image"], b["label"], tuple(b["xywh"]))  # noqa: E731
+    oset, mset = [key(b) for b in ob], [key(b) for b in mb]
+    sel = set(selected_images)
+    diff = sorted(set(oset) ^ set(mset))
+    sel_diff = [d for d in diff if d[0] in sel]
+    oob = [b["line"] for b in ob if b["xyxy"][2] > nih_audit.CANVAS[0] or b["xyxy"][3] > nih_audit.CANVAS[1]]
+    return {"bytes_identical": official_text == mirror_text, "n_boxes_official": len(ob), "n_boxes_mirror": len(mb),
+            "n_box_set_differences": len(diff), "selected_image_box_differences": [list(map(str, d)) for d in sel_diff],
+            "official_header": orep["raw_header"], "official_out_of_assumed_canvas_lines": oob}
+
+
+def entry_compare(official_text, mirror_text, selected_images):
+    oe, orep = nih.parse_data_entry(official_text)
+    me, mrep = nih.parse_data_entry(mirror_text)
+    ohead = [h.strip() for h in orep["raw_header"]]
+    mhead = [h.strip() for h in mrep["raw_header"]]
+    common = set(oe) & set(me)
+    changed_all = [i for i in common if oe[i] != me[i]]
+    sel = sorted(selected_images)
+    sel_changed = {}
+    for i in sel:
+        if i not in oe or i not in me:
+            sel_changed[i] = {"missing_in": "official" if i not in oe else "mirror"}
+            continue
+        d = {c: [oe[i].get(c), me[i].get(c)] for c in set(oe[i]) | set(me[i]) if oe[i].get(c) != me[i].get(c)}
+        if d:
+            sel_changed[i] = d
+    critical = {i: d for i, d in sel_changed.items()
+                if "missing_in" in d or "Patient ID" in d or "Finding Labels" in d}
+    # 전체 파일에서 바뀐 column 분포 (구조화된 차이 요약)
+    col_counts = {}
+    for i in changed_all:
+        for c in set(oe[i]) | set(me[i]):
+            if oe[i].get(c) != me[i].get(c):
+                col_counts[c] = col_counts.get(c, 0) + 1
+    raw_o, raw_m = official_text.encode(), mirror_text.encode()
+    # header 이름을 빼고 위치 기준으로 모든 행의 값을 비교 (column 이름 변경만 있는지 확인)
+    body_o = official_text.split("\n", 1)[1]
+    body_m = mirror_text.split("\n", 1)[1]
+    renamed = [[a, b] for a, b in zip(ohead, mhead) if a != b]
+    return {"bytes_identical": raw_o == raw_m, "body_after_header_bytes_identical": body_o == body_m,
+            "renamed_columns_official_vs_mirror": renamed, "bytes_official": len(raw_o), "bytes_mirror": len(raw_m),
+            "header_official": ohead, "header_mirror": mhead, "header_equal": ohead == mhead,
+            "n_rows_official": orep["n_rows"], "n_rows_mirror": mrep["n_rows"],
+            "only_in_official": len(set(oe) - set(me)), "only_in_mirror": len(set(me) - set(oe)),
+            "n_rows_changed": len(changed_all), "changed_columns_count": col_counts,
+            "changed_rows_examples": {i: {c: [oe[i].get(c), me[i].get(c)] for c in set(oe[i]) | set(me[i])
+                                          if oe[i].get(c) != me[i].get(c)} for i in sorted(changed_all)[:5]},
+            "line_ending_official_crlf": b"\r\n" in raw_o[:2000], "line_ending_mirror_crlf": b"\r\n" in raw_m[:2000],
+            "trailing_newline_official": raw_o.endswith(b"\n"), "trailing_newline_mirror": raw_m.endswith(b"\n"),
+            "selected_rows_changed": sel_changed, "selected_critical_changes": critical}
+
+
+def exploratory_policy(checks, canvas_status, contradictions):
+    rd = nih_audit.readiness(checks, canvas_status)
+    reasons = []
+    if not rd["integrity_gate_pass"]:
+        reasons.append({"what": "integrity_failed", "failed": rd["failed_required_checks"]})
+    if canvas_status == "undocumented":
+        reasons.append({"what": "canvas_undocumented"})
+    if contradictions:
+        reasons.append({"what": "new_contradictions", "items": contradictions})
+    if canvas_status == "documented_direct":
+        allowed = rd["lesion_probe_ready"] and not contradictions
+        mode = "strict"
+    else:
+        allowed = bool(rd["integrity_gate_pass"] and canvas_status == "assumed" and not contradictions)
+        mode = "exploratory_assumed"
+    return {**rd, "exploratory_probe_allowed": allowed, "gate_mode": mode, "blocking_reasons": reasons,
+            "exploratory_definition": "integrity_gate_pass AND canvas_status == assumed AND no new contradiction "
+                                      "(좌표 모순·선택 자료 annotation/patient/finding 차이·official 좌표 canvas 초과)",
+            "interpretation": "assumed 상태 통과는 조건부 탐색 신호이며 확증 결과가 아니다"}
+
+
+def digest(obj):
+    return hashlib.sha256(json.dumps(obj, sort_keys=True, ensure_ascii=False, default=str).encode()).hexdigest()
+
+
+def read_pages(dirname, stem):
+    pages, i = [], 1
+    while os.path.exists(os.path.join(dirname, f"{stem}_p{i:02d}.txt")):
+        pages.append(open(os.path.join(dirname, f"{stem}_p{i:02d}.txt"), encoding="utf-8", errors="replace").read())
+        i += 1
+    return pages
