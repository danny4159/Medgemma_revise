+        positive=[a for a in atoms.values() if a['polarity']=='positive' and a['certainty']=='definite']
+        selected={m['ref']:m for m in j['matches']}
+        def recall(den,accepted,unambiguous=False):
+            if not den:return None
+            total=0
+            for a in den:
+                m=selected.get(a['id'])
