@@ -0,0 +1,46 @@
+"""iter_123: 선택 study ZIP 다운로드(공식 revision 고정, 토큰 내용 미기록). usage: python mr123_fetch.py tech|explore|reserve"""
+import hashlib, json, os, sys, warnings
+warnings.filterwarnings('ignore')
+os.environ['HF_TOKEN_PATH'] = '/home/test/.cache/huggingface/token'
+from huggingface_hub import HfApi, hf_hub_download
+
+ROOT = '/home/test/.local/share/medgemma/mr_rate/'
+RES = '/SSD1_1TB/home/milab/daniel/08_medgemma/research/results/iter_123/data/'
+REV = 'f6e39794e7820c96c18465231a30da424e6d1c69'
+BUDGET = 10 * 1024 ** 3
+
+
+def sha(p):
+    d = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(1 << 22), b''):
+            d.update(b)
+    return d.hexdigest()
+
+
+def main(roles):
+    L = json.load(open(RES + 'selection_lock.json'))
+    items = [r for r in L['manifest'] if r['role'] in roles]
+    api = HfApi()
+    infos = api.get_paths_info('Forithmus/MR-RATE', [r['zip_path'] for r in items], repo_type='dataset', revision=REV)
+    size = {i.path: i.size for i in infos}
+    led_p = RES + 'fetch_ledger.json'
+    led = json.load(open(led_p)) if os.path.exists(led_p) else {}
+    used = sum(v['size'] for v in led.values())
+    need = sum(size[r['zip_path']] for r in items if r['study_uid'] not in led)
+    free = os.statvfs(ROOT).f_bavail * os.statvfs(ROOT).f_frsize
+    print(f'roles={roles} 새 다운로드 {need/1e6:.1f}MB, 누적 {used/1e6:.1f}MB, 예산 {BUDGET/1e9:.1f}GB, 여유 {free/1e9:.0f}GB')
+    assert used + need <= BUDGET and need * 3 < free
+    for r in items:
+        if r['study_uid'] in led:
+            continue
+        p = hf_hub_download('Forithmus/MR-RATE', r['zip_path'], repo_type='dataset', revision=REV, local_dir=ROOT + 'raw',
+                            cache_dir=ROOT + 'cache')
+        assert os.path.getsize(p) == size[r['zip_path']]
+        led[r['study_uid']] = dict(path=p, size=size[r['zip_path']], sha256=sha(p), revision=REV, role=r['role'])
+        json.dump(led, open(led_p, 'w'), indent=1)
+        print('ok', r['study_uid'], size[r['zip_path']])
+
+
+if __name__ == '__main__':
+    main(sys.argv[1:])
diff --git a/mr123_run.py b/mr123_run.py
new file mode 100644
index 0000000..1795167
--- /dev/null
+++ b/mr123_run.py
@@ -0,0 +1,214 @@
+"""iter_123: MedGemma 1.5 frozen 추론 요청 구성/worker/parser. 조건 C(중앙8), W(넓은8), P1/P2(W를 inferior4/superior4로 분할).
+usage:
+  python mr123_run.py requests <stage> <build_json> [<build_json>...]   # 요청 파일 생성(출력 전 잠금)
+  python mr123_run.py worker <stage> <worker_id> <max_new_tokens> [--limit N] [--batch B]
+"""
+import hashlib, json, os, re, sys, time
+import mr123_data as D
+
+MODEL = 'google/medgemma-1.5-4b-it'
+REV = '91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b'
+CACHE = '/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache'
+GEN = D.RES + 'gen/'
+STATES = ['PRESENT', 'ABSENT', 'UNCERTAIN']
+
+PROMPT = ('You are shown {n} axial FLAIR MRI slices from one brain MRI examination, {order}. '
+          'Question: Is there evidence of pathological hyperintense signal on FLAIR in the periventricular white matter in the images shown? '
+          'Answer on the first line with exactly one word: PRESENT, ABSENT, or UNCERTAIN. '
+          'Then give a brief justification (at most two sentences).')
+
+
+def sha(s):
+    return hashlib.sha256(s.encode()).hexdigest()
+
+
+def make_requests(builds):
+    reqs = []
+    for b in builds:
+        for sid, info in b.items():
+            if info.get('exclude') is not None:
+                continue
+            W = info['W_idx']
+            conds = {'C': (info['C_idx'], 'ordered from inferior to superior'), 'W': (W, 'ordered from inferior to superior'),
+                     'P1': (W[:4], 'ordered from inferior to superior (lower half of the covered range)'),
+                     'P2': (W[4:], 'ordered from inferior to superior (upper half of the covered range)')}
+            for c, (idx, order) in conds.items():
+                paths = [info['pngs'][str(k)]['path'] for k in idx]
+                hs = [info['pngs'][str(k)]['sha256'] for k in idx]
+                prompt = PROMPT.format(n=len(idx), order=order)
+                rid = sha('|'.join([str(info['patient_uid']), c, ','.join(hs), prompt, REV]))[:20]
+                reqs.append(dict(id=rid, patient_uid=info['patient_uid'], study_uid=sid, cond=c, slice_idx=idx, paths=paths, png_sha256=hs,
+                                 prompt=prompt, model=MODEL, revision=REV, label=info['label'], batch_id=info['batch_id'], role=info['role']))
+    return reqs
+
+
+def messages_for(r):
+    from PIL import Image
+    content = []
+    for i, p in enumerate(r['paths']):
+        content.append({'type': 'text', 'text': f'Image {i + 1}:'})
+        content.append({'type': 'image', 'image': Image.open(p).convert('RGB')})
+    content.append({'type': 'text', 'text': r['prompt']})
+    return [{'role': 'user', 'content': content}]
+
+
+def parse(text):
+    """첫 줄의 단일 상태. return (state, code). state in PRESENT/ABSENT/UNCERTAIN/INVALID"""
+    t = (text or '').strip()
+    lines = [l for l in t.split('\n') if l.strip()]
+    if not lines:
+        return 'INVALID', 'empty'
+    first = re.sub(r'[*_`#>\-:.\[\]()"]', ' ', lines[0]).strip()
+    found = [s for s in STATES if re.search(r'\b' + s + r'\b', first, re.I)]
+    if len(found) == 1:
+        strict = re.fullmatch(r'\s*' + found[0] + r'\s*', first, re.I) is not None
+        return found[0], 'ok_strict' if strict else 'ok_loose'
+    if len(found) > 1:
+        return 'INVALID', 'multi_state'
+    if re.search(r'cannot|unable|can\'?t|not able|I am sorry|sorry', t[:300], re.I):
+        return 'INVALID', 'refusal'
+    return 'INVALID', 'no_state'
+
+
+def agg_P(s1, s2):
+    if 'PRESENT' in (s1, s2):
+        return 'PRESENT'
+    if s1 == 'ABSENT' and s2 == 'ABSENT':
+        return 'ABSENT'
+    return 'UNCERTAIN'
+
+
+def read_jsonl(p):
+    out = []
+    if not os.path.exists(p):
+        return out
+    with open(p, 'rb') as f:
+        data = f.read()
+    for line in data.split(b'\n'):
+        if not line.strip():
+            continue
+        try:
+            out.append(json.loads(line))
+        except Exception:
+            break  # torn tail
+    return out
+
+
+def repair_tail(p):
+    if not os.path.exists(p):
+        return
+    with open(p, 'rb') as f:
+        data = f.read()
+    good = 0
+    pos = 0
+    for line in data.split(b'\n'):
+        end = pos + len(line) + 1
+        if line.strip():
+            try:
+                json.loads(line)
+            except Exception:
+                break
+        good = min(end, len(data))
+        pos = end
+    if good < len(data):
+        with open(p, 'rb+') as f:
+            f.truncate(good)
+
+
+def done_ids(stage):
+    d = GEN + stage
+    ids = set()
+    if os.path.isdir(d):
+        for fn in os.listdir(d):
+            if fn.startswith('worker_') and fn.endswith('.jsonl'):
+                ids |= {r['id'] for r in read_jsonl(os.path.join(d, fn))}
+    return ids
+
+
+def worker(stage, wid, max_new, limit=None, batch=1):
+    import torch
+    from transformers import AutoProcessor, AutoModelForImageTextToText
+    reqs = read_jsonl(GEN + stage + '/requests.jsonl')
+    out_p = GEN + stage + f'/worker_{wid}.jsonl'
+    repair_tail(out_p)
+    cdir = GEN + stage + '/claims'
+    os.makedirs(cdir, exist_ok=True)
+    t0 = time.perf_counter()
+    proc = AutoProcessor.from_pretrained(MODEL, revision=REV, cache_dir=CACHE)
+    model = AutoModelForImageTextToText.from_pretrained(MODEL, revision=REV, cache_dir=CACHE, torch_dtype=torch.bfloat16, device_map={'': 0})
+    model.eval()
+    load_s = time.perf_counter() - t0
+    print(json.dumps(dict(event='loaded', wid=wid, load_s=load_s, gpu=os.environ.get('CUDA_VISIBLE_DEVICES'))), flush=True)
+    done = done_ids(stage)
+    n = 0
+    f = open(out_p, 'a')
+    pending = [r for r in reqs if r['id'] not in done]
+    while pending:
+        group = []
+        for r in pending:
+            if len(group) >= batch:
+                break
+            try:
+                fd = os.open(os.path.join(cdir, r['id'] + '.claim'), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+                os.write(fd, f'{wid}:{os.getpid()}'.encode()); os.close(fd)
+                group.append(r)
+            except FileExistsError:
+                continue
+        pending = [r for r in pending if r not in group and r['id'] not in done]
+        if not group:
+            break
+        ts = time.perf_counter()
+        msgs = [messages_for(r) for r in group]
+        if batch == 1:
+            inp = proc.apply_chat_template(msgs[0], add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors='pt')
+        else:
+            proc.tokenizer.padding_side = 'left'
+            inp = proc.apply_chat_template(msgs, add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors='pt', padding=True)
+        inp = inp.to(model.device)
+        inp['pixel_values'] = inp['pixel_values'].to(torch.bfloat16)
+        plen = inp['input_ids'].shape[1]
+        te = time.perf_counter()
+        with torch.inference_mode():
+            gen = model.generate(**inp, max_new_tokens=max_new, do_sample=False)
+        tg = time.perf_counter()
+        eos_ids = set([proc.tokenizer.eos_token_id] + ([model.generation_config.eos_token_id] if isinstance(model.generation_config.eos_token_id, int) else list(model.generation_config.eos_token_id or [])))
+        for i, r in enumerate(group):
+            new = gen[i, plen:].tolist()
+            ended = any(t in eos_ids for t in new)
+            while new and new[-1] == proc.tokenizer.pad_token_id:
+                new.pop()
+            text = proc.tokenizer.decode(new, skip_special_tokens=True)
+            st, code = parse(text)
+            rec = dict(id=r['id'], study_uid=r['study_uid'], cond=r['cond'], text=text, state=st, parse_code=code, eos=bool(ended),
+                       n_new=len(new), prompt_tokens=int((inp['attention_mask'][i]).sum()), max_new=max_new, wid=wid, batch=batch,
+                       prep_s=te - ts, gen_s=tg - te, wall_s=tg - ts, n_img=len(r['paths']), t_end=time.time(),
+                       peak_mem_mib=torch.cuda.max_memory_allocated() / 2 ** 20, load_s=load_s, input_ids_sha=hashlib.sha256(inp['input_ids'][i].cpu().numpy().tobytes()).hexdigest())
+            f.write(json.dumps(rec) + '\n')
+        f.flush(); os.fsync(f.fileno())
+        n += len(group)
+        if limit and n >= limit:
+            break
+    f.close()
+    print(json.dumps(dict(event='done', wid=wid, n=n)), flush=True)
+
+
+if __name__ == '__main__':
+    cmd = sys.argv[1]
+    if cmd == 'requests':
+        stage = sys.argv[2]
+        builds = [json.load(open(p)) for p in sys.argv[3:]]
+        reqs = make_requests(builds)
+        d = GEN + stage
+        os.makedirs(d, exist_ok=True)
+        p = d + '/requests.jsonl'
+        assert not os.path.exists(p), 'requests 잠금 존재'
+        assert len({r['id'] for r in reqs}) == len(reqs)
+        with open(p, 'w') as f:
+            for r in reqs:
+                f.write(json.dumps(r) + '\n')
+        print(len(reqs), 'requests', hashlib.sha256(open(p, 'rb').read()).hexdigest())
+    elif cmd == 'worker':
+        stage, wid, mx = sys.argv[2], sys.argv[3], int(sys.argv[4])
+        lim = int(sys.argv[sys.argv.index('--limit') + 1]) if '--limit' in sys.argv else None
+        bs = int(sys.argv[sys.argv.index('--batch') + 1]) if '--batch' in sys.argv else 1
+        worker(stage, wid, mx, lim, bs)
diff --git a/mr125_build.py b/mr125_build.py
new file mode 100644
index 0000000..66aed26
--- /dev/null
+++ b/mr125_build.py
@@ -0,0 +1,147 @@
+"""iter_125: SynthSeg 결과 -> 원 T2 격자 변환, U/A slice 선택, 렌더링(896 canvas, brain p1-p99), 점수 S(측뇌실 부피/ICV), QC.
+mr123_data.py의 brain_range/intensity_window/render_slice/pick을 재사용(렌더 규칙 동일). usage: python mr125_build.py ROLE"""
+import hashlib, json, os, sys
+import numpy as np
+import nibabel as nib
+from PIL import Image
+import mr123_data as D
+
+RES = 'results/iter_125/'
+LV = (4, 43)  # SynthSeg left/right lateral ventricle (labels table 확인; inferior lateral 5/44 제외)
+FRAC = 0.05
+N = 8
+
+
+def sha(p):
+    return hashlib.sha256(open(p, 'rb').read()).hexdigest()
+
+
+def spread(lo, hi, n=N):
+    return [int(round(lo + (hi - lo) * i / (n - 1))) for i in range(n)]
+
+
+def resample_nn(vol, vaff, shape, aff):
+    """nearest-neighbor: 목표 격자 voxel -> world -> 원 seg voxel 인덱스 (scipy 없이)."""
+    M = np.linalg.inv(vaff) @ aff
+    out = np.zeros(shape, dtype=vol.dtype)
+    ii, jj = np.meshgrid(np.arange(shape[0]), np.arange(shape[1]), indexing='ij')
+    for k in range(shape[2]):
+        p = M[:3, 0, None] * ii.ravel()[None] + M[:3, 1, None] * jj.ravel()[None] + (M[:3, 2, None] * k + M[:3, 3, None])
+        q = np.rint(p).astype(np.int64)
+        ok = np.all((q >= 0) & (q < np.array(vol.shape)[:, None]), axis=0)
+        v = np.zeros(ii.size, dtype=vol.dtype)
+        v[ok] = vol[q[0, ok], q[1, ok], q[2, ok]]
+        out[:, :, k] = v.reshape(shape[0], shape[1])
+    return out
+
+
+def build(m, prov, out_png):
+    f = prov['files']
+    im = nib.load(f['img.nii.gz']['path'])
+    bm = nib.load(f['brain.nii.gz']['path'])
+    seg = nib.load(prov['seg'])
+    info = dict(study_uid=m['study_uid'], patient_uid=m['patient_uid'], label=m['label'], batch_id=m['batch_id'], role=m['role'], series_id=m['series_id'],
+                orig_axcodes=''.join(nib.aff2axcodes(im.affine)), shape=list(im.shape), zooms=[float(z) for z in im.header.get_zooms()[:3]],
+                seg_shape=list(seg.shape), seg_axcodes=''.join(nib.aff2axcodes(seg.affine)), seg_zooms=[float(z) for z in seg.header.get_zooms()[:3]])
+    if len(im.shape) != 3 or im.shape != bm.shape or not np.allclose(im.affine, bm.affine, atol=1e-3):
+        info['exclude'] = 'img_brain_mismatch'
+        return info
+    # 1mm seg -> 원 T2 격자 (nearest). 원 T2 grid 위 mask
+    sd_native = np.rint(np.asarray(seg.dataobj)).astype(np.int16)
+    sd = resample_nn(sd_native, seg.affine, im.shape, im.affine)
+    # canonical RAS 정렬
+    ic = nib.as_closest_canonical(im)
+    bc = nib.as_closest_canonical(bm)
+    sc = nib.as_closest_canonical(nib.Nifti1Image(sd, im.affine))
+    a = np.asarray(ic.dataobj).astype(np.float32)
+    b = np.asarray(bc.dataobj) > 0
+    s = np.asarray(sc.dataobj)
+    info['canon_axcodes'] = ''.join(nib.aff2axcodes(ic.affine))
+    info['canon_zooms'] = [float(z) for z in ic.header.get_zooms()[:3]]
+    if info['canon_axcodes'] != 'RAS' or not np.isfinite(a).all():
+        info['exclude'] = 'orientation_or_nonfinite'
+        return info
+    br = D.brain_range(b)
+    if br is None:
+        info['exclude'] = 'no_brain_range'
+        return info
+    lo, hi = br
+    info['brain_slice_range'] = [lo, hi]
+    vent = np.isin(s, LV)
+    # 부피(1mm native seg 기준) / ICV = native seg 비배경 voxel 합 (SynthSeg의 total intracranial 정의)
+    vz = float(np.prod(seg.header.get_zooms()[:3]))
+    v_vent = float(np.isin(sd_native, LV).sum() * vz)
+    icv = float((sd_native > 0).sum() * vz)
+    info['vent_mm3'] = v_vent
+    info['icv_mm3'] = icv
+    info['S'] = v_vent / icv if icv > 0 else None
+    info['vent_voxels_in_T2_grid'] = int(vent.sum())
+    info['vent_in_brainmask_frac'] = float((vent & b).sum() / max(vent.sum(), 1))
+    info['vent_vol_ratio_T2grid_vs_native'] = float(vent.sum() * np.prod(info['canon_zooms']) / max(v_vent, 1))
+    area = vent.sum(axis=(0, 1)).astype(float)
+    info['vent_area_by_slice'] = area.tolist()
+    # U
+    U = D.pick(lo, hi, 0.05, 0.95)
+    info['U_idx'] = U
+    # A
+    info['A_fallback'] = None
+    A = None
+    if area.max() > 0:
+        ok = np.where(area >= FRAC * area.max())[0]
+        alo, ahi = int(ok.min()), int(ok.max())
+        info['A_range'] = [alo, ahi]
+        A = spread(alo, ahi)
+        if len(set(A)) < N:
+            A = None
+            info['A_fallback'] = 'lt8_unique'
+    else:
+        info['A_fallback'] = 'no_ventricle_voxels'
+    if A is None:
+        A = list(U)
+    info['A_idx'] = A
+    if len(set(U)) < N:
+        info['exclude'] = 'U_lt8_unique'
+        return info
+    lo_v, hi_v = D.intensity_window(a, b)
+    info['window_p1_p99'] = [lo_v, hi_v]
+    os.makedirs(out_png, exist_ok=True)
+    pngs = {}
+    for k in sorted(set(U) | set(A)):
+        p = os.path.join(out_png, f'{m["study_uid"]}_s{k:03d}.png')
+        if not os.path.exists(p):
+            D.render_slice(a, k, lo_v, hi_v, info['canon_zooms']).save(p)
+        pngs[str(k)] = dict(path=p, sha256=sha(p))
+    info['pngs'] = pngs
+    # QC 확인용(모델 입력 아님): 측뇌실 outline overlay montage
+    ov = []
+    for k in A:
+        base = np.array(D.render_slice(a, k, lo_v, hi_v, info['canon_zooms']))
+        mk = D.render_slice(np.where(np.arange(a.shape[2])[None, None, :] == k, vent.astype(np.float32), 0), k, 0, 1, info['canon_zooms'])
+        mk = np.array(mk)[:, :, 0] > 127
+        base[mk, 0] = 255
+        ov.append(Image.fromarray(base).resize((224, 224)))
+    M = Image.new('RGB', (224 * 4, 224 * 2))
+    for i, x in enumerate(ov):
+        M.paste(x, ((i % 4) * 224, (i // 4) * 224))
+    M.save(os.path.join(RES, 'qc', f'overlayA_{m["study_uid"]}.png'))
+    info['exclude'] = None
+    return info
+
+
+def main(role):
+    L = json.load(open(RES + 'data/selection_lock.json'))
+    prov = json.load(open(RES + f'seg/prov_{role}.json'))
+    os.makedirs(RES + 'qc', exist_ok=True)
+    out = {}
+    for m in L['manifest']:
+        if m['role'] == role:
+            out[m['study_uid']] = build(m, prov[m['study_uid']], os.path.join('/home/test/.local/share/medgemma/mr_rate/png125', m['study_uid']))
+            i = out[m['study_uid']]
+            print(m['study_uid'], m['label'], i.get('exclude'), 'S=%.4f' % (i.get('S') or -1), 'A_fb', i.get('A_fallback'), 'U', i.get('U_idx'), 'A', i.get('A_idx'))
+    p = RES + f'seg/build_{role}.json'
+    assert not os.path.exists(p)
+    json.dump(out, open(p, 'w'), indent=1)
+
+
+if __name__ == '__main__':
+    main(sys.argv[1])
