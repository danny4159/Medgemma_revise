+from rsna_diag import train as T
+
+R = {}
+REAL_PROT = os.environ.get("ITER012_PROTOCOL", "results/iter_012/protocols/pilot_protocol.json")
+REAL_VERIFY = lock_protocol.verify
+
+
+def check(name, cond, detail=None):
