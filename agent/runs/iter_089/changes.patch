new file mode 100644
index 0000000..18f978c
--- /dev/null
+++ b/rsna_diag/lock_protocol.py
@@ -0,0 +1,86 @@
+"""실행 protocol 잠금 (iter_010): 코드·manifest·prompt·생성 config digest를 파일로 고정하고, 실행 진입점에서 강제 검증한다.
+
+- 경로는 항상 명시한다 (기본값 없음). 존재하면 현재 digest와 대조해 불일치 시 실패한다 (덮어쓰지 않음).
+- verify(path) -> protocol digest (sha256 of locked 내용). generate/train/run_shards는 시작 시 verify를 호출하며 실패하면 실행하지 않는다.
+사용: python -m rsna_diag.lock_protocol --out PATH [--extra FILE ...] [--check]
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+from . import prompts as P
+
+CODE = ["rsna_diag/generate.py", "rsna_diag/parse.py", "rsna_diag/metrics.py", "rsna_diag/evaluate.py", "rsna_diag/geometry.py",
+        "rsna_diag/prompts.py", "rsna_diag/rsna_data.py", "rsna_diag/dicom_min.py", "rsna_diag/run_shards.py",
+        "rsna_diag/queue_lock.py", "rsna_diag/lock_protocol.py", "rsna_diag/lora.py", "rsna_diag/sft_data.py", "rsna_diag/train.py",
+        "rsna_diag/baselines.py", "rsna_diag/launch.py", "rsna_diag/select.py", "rsna_diag/final_eval.py", "rsna_diag/sft_eval.py",
+        "rsna_diag/data_gate.py", "rsna_diag/build_data.py", "rsna_diag/inputs.py", "rsna_diag/eval_gate.py", "rsna_diag/migrate.py",
+        "rsna_diag/pipeline.py"]  # iter_012: 단계 순서·건너뛰기 검증을 담당하는 pipeline도 잠근다
+DATA = ["results/iter_010/manifests/infer_manifest.jsonl", "results/iter_010/manifests/gt_manifest.json",
+        "results/iter_010/manifests/exclusion_previous_patients.json", "results/iter_010/manifests/reserve_patients.json",
+        "results/iter_009/source/official/cxr_anatomy_localization_with_hugging_face.ipynb"]
+
+
+def sha(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def locked_digest(locked):
+    return hashlib.sha256(json.dumps(locked, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def digest_of(path):
+    """코드 상태를 검증하지 않고 protocol 파일의 digest만 계산한다 (부모 실행의 원본 protocol 식별용)."""
+    return locked_digest(json.load(open(path))["locked"])
+
+
+def locked_config_digest(path):
+    return json.load(open(path))["locked"]["generation_config_digest"]
+
+
+def current(extra=()):
+    from . import generate
+    files = [f for f in CODE + DATA + list(extra) if os.path.exists(f)]
+    d = {"files": {f: sha(f) for f in files}, "prompts": {k: P.digest(v) for k, v in P.all_prompts().items()}}
+    core, cdig = generate.static_config()
+    d["generation_config_digest"] = cdig
+    d["generation_config"] = core
+    return d
+
+
+def verify(path):
+    """protocol 파일이 없거나 현재 상태와 다르면 예외. returns protocol digest."""
+    if not path or not os.path.exists(path):
+        raise RuntimeError(f"protocol file missing: {path!r}")
+    old = json.load(open(path))
+    cur = current(extra=[f for f in old["locked"]["files"] if f not in CODE + DATA])
+    diff = {k: (old["locked"]["files"].get(k), v) for k, v in cur["files"].items() if old["locked"]["files"].get(k) != v}
+    diff.update({k: (v, None) for k, v in old["locked"]["files"].items() if k not in cur["files"]})
+    if diff or old["locked"]["prompts"] != cur["prompts"] or old["locked"]["generation_config_digest"] != cur["generation_config_digest"]:
+        raise RuntimeError("LOCK MISMATCH " + json.dumps(diff, indent=1)[:2000])
+    return locked_digest(old["locked"])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--extra", nargs="*", default=[])
+    ap.add_argument("--check", action="store_true")
+    ap.add_argument("--note", default="")
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        print("lock verified", verify(a.out))
+        return
+    if a.check:
+        print("no lock yet")
+        return
+    cur = current(a.extra)
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump({"locked": cur, "note": a.note}, open(a.out, "w"), indent=1, default=str)
+    print("locked", a.out, locked_digest(cur))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/rsna_diag/migrate.py b/rsna_diag/migrate.py
new file mode 100644
index 0000000..68a4e4f
--- /dev/null
+++ b/rsna_diag/migrate.py
@@ -0,0 +1,119 @@
+"""iter_010 -> iter_011 학습 checkpoint 이관 (제한된 부모 checkpoint 가져오기 경로).
+
+protocol이 바뀌면 protocol digest -> train digest가 바뀌므로 단순 digest 교체는 하지 않는다. 대신 아래를 명시적으로 검증한 migration manifest를
+만들고, train.py는 이 manifest와 부모 checkpoint 파일을 다시 검증한 뒤에만 새 run으로 가져온다.
+  - 부모 checkpoint 파일 sha256, 부모 train_digest/protocol digest, 부모 train_config 재계산 digest 일치
+  - 부모 config와 새 config가 protocol_digest·새 입력 digest 외에 동일 (학습 의미 불변)
+  - 부모 protocol이 잠근 manifest/GT sha == 현재 파일 sha (입력 대응), 현재 train ID 파일 == manifest의 train split 전체
+  - checkpoint 위치가 step == epoch*steps_per_epoch + pos 와 일치
+  - old -> new protocol 코드 파일 hash 변경 목록 (변경된 파일만; 학습 의미 불변은 변경 목록과 함께 서술)
+사용: python -m rsna_diag.migrate make --parent-run D --old-protocol P0 --new-protocol P1 --out FILE --semantics-note TXT
+"""
+import argparse
+import hashlib
+import json
+import math
+import os
+import sys
+
+from . import lock_protocol
+
+
+def cfg_digest(cfg):
+    return hashlib.sha256(json.dumps(cfg, sort_keys=True).encode()).hexdigest()
+
+
+def file_sha(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for ch in iter(lambda: f.read(1 << 20), b""):
+            h.update(ch)
+    return h.hexdigest()
+
+
+class MigrationError(RuntimeError):
+    pass
+
+
+NEW_ONLY_KEYS = ("protocol_digest", "train_inputs_digest", "val_inputs_digest")
+
+
+def make(parent_run, old_protocol, new_protocol, out, note, manifest_paths):
+    import torch
+    ck = os.path.join(parent_run, "ckpt_latest.pt")
+    blob = torch.load(ck, map_location="cpu", weights_only=False)
+    tc = json.load(open(os.path.join(parent_run, "train_config.json")))
+    old_dig = lock_protocol.digest_of(old_protocol)
+    new_dig = lock_protocol.verify(new_protocol)
+    if cfg_digest(tc["config"]) != tc["train_digest"] or blob["train_digest"] != tc["train_digest"]:
+        raise MigrationError("parent train digest inconsistent")
+    if blob["protocol_digest"] != old_dig or tc["config"]["protocol_digest"] != old_dig:
+        raise MigrationError("parent protocol digest != old protocol file")
+    old_files = json.load(open(old_protocol))["locked"]["files"]
+    new_files = json.load(open(new_protocol))["locked"]["files"]
+    data_match = {}
+    for f in manifest_paths:
+        cur = file_sha(f)
+        if old_files.get(f) != cur or new_files.get(f) != cur:
+            raise MigrationError(f"{f}: sha differs between old protocol / new protocol / current")
+        data_match[f] = cur
+    spe = math.ceil(tc["config"]["n_train"] / tc["config"]["eff_batch"])
+    if blob["step"] != blob["epoch"] * spe + blob["pos_in_epoch"]:
+        raise MigrationError(f"checkpoint position inconsistent: step {blob['step']} epoch {blob['epoch']} pos {blob['pos_in_epoch']}")
+    changed = {f: {"old": old_files.get(f), "new": new_files.get(f)} for f in sorted(set(old_files) | set(new_files))
+               if old_files.get(f) != new_files.get(f)}
+    man = {"parent_run": parent_run, "parent_ckpt": ck, "parent_ckpt_sha256": file_sha(ck), "parent_ckpt_bytes": os.path.getsize(ck),
+           "parent_step": blob["step"], "parent_epoch": blob["epoch"], "parent_pos_in_epoch": blob["pos_in_epoch"],
+           "parent_train_digest": tc["train_digest"], "parent_protocol_digest": old_dig, "parent_protocol_file": old_protocol,
+           "parent_config": tc["config"], "parent_train_log": os.path.join(parent_run, "train_log.jsonl"),
+           "parent_train_log_sha256_at_migration": file_sha(os.path.join(parent_run, "train_log.jsonl")),
+           "new_protocol_file": new_protocol, "new_protocol_digest": new_dig, "invariant_config_excludes": list(NEW_ONLY_KEYS),
+           "manifest_sha_old_new_current_equal": data_match, "protocol_file_changes_old_to_new": changed,
+           "semantics_note": note}
+    if os.path.exists(out):
+        sys.exit(f"{out} exists (not overwritten)")
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    json.dump(man, open(out, "w"), indent=1)
+    return man
+
+
+def verify_parent(migration_path, new_cfg, new_protocol_digest):
+    """train.py가 호출. 부모 checkpoint를 다시 읽어 manifest와 대조하고 blob을 반환한다."""
+    import torch
+    m = json.load(open(migration_path))
+    if m["new_protocol_digest"] != new_protocol_digest:
+        raise MigrationError("migration manifest was made for a different new protocol")
+    ck = m["parent_ckpt"]
+    if file_sha(ck) != m["parent_ckpt_sha256"]:
+        raise MigrationError("parent checkpoint file changed since migration manifest")
+    blob = torch.load(ck, map_location="cpu", weights_only=False)
+    if (blob["train_digest"] != m["parent_train_digest"] or blob["protocol_digest"] != m["parent_protocol_digest"]
+            or blob["step"] != m["parent_step"] or blob["epoch"] != m["parent_epoch"] or blob["pos_in_epoch"] != m["parent_pos_in_epoch"]):
+        raise MigrationError("parent checkpoint content differs from manifest")
+    old, new = dict(m["parent_config"]), dict(new_cfg)
+    for k in NEW_ONLY_KEYS:
+        old.pop(k, None)
+        new.pop(k, None)
+    if old != new:
+        diff = {k: (old.get(k), new.get(k)) for k in set(old) | set(new) if old.get(k) != new.get(k)}
+        raise MigrationError(f"training semantics differ between parent and new config: {diff}")
+    return blob, m
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    c = sp.add_parser("make")
+    c.add_argument("--parent-run", required=True)
+    c.add_argument("--old-protocol", required=True)
+    c.add_argument("--new-protocol", required=True)
+    c.add_argument("--out", required=True)
+    c.add_argument("--semantics-note", required=True)
+    a = ap.parse_args()
+    make(a.parent_run, a.old_protocol, a.new_protocol, a.out, a.semantics_note,
+         ["results/iter_010/manifests/infer_manifest.jsonl", "results/iter_010/manifests/gt_manifest.json"])
+    print("migration manifest", a.out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/select.py b/rsna_diag/select.py
new file mode 100644
index 0000000..6b674f1
--- /dev/null
+++ b/rsna_diag/select.py
@@ -0,0 +1,185 @@
+"""validation 규칙에 따른 학습 확장·learning rate·checkpoint 선택 (iter_010 사전 고정 규칙, iter_011 gate 추가).
+
+- 확장 규칙: epoch 5에서, 어느 한 learning rate라도 (utility(5) - utility(4) >= 0.01) and (val_loss(5) <= 0.99 * val_loss(4))이면
+  두 learning rate 모두 epoch 8까지 연장한다 ('마지막 두 epoch' = epoch 4 -> 5 변화로 고정 해석).
+- checkpoint: run별 epoch 중 utility 최대, 동률은 양성 F1@0.5, 그 다음 이른 epoch. learning rate: seed 17 run의 선택 utility 최대
+  (동률 F1@0.5, 그 다음 작은 lr).
+- iter_011: 예정된 epoch 1..E 전체의 val_metrics가 있고, 각 epoch의 원시 validation 요청 집합(400 ID x concise)·adapter digest·
+  protocol·입력 digest·train_digest가 실제 파일과 일치할 때만 선택/확장 판정을 한다 (하나라도 어긋나면 예외, 출력 파일 없음).
+사용: python -m rsna_diag.select extend|pick --runs DIR [DIR ...] --epochs E --protocol P --out FILE
+"""
+import argparse
+import glob
+import hashlib
+import json
+import os
+
+from . import eval_gate, inputs, lock_protocol, sft_eval
+
+MANIFEST = "results/iter_010/manifests/infer_manifest.jsonl"
+GT = "results/iter_010/manifests/gt_manifest.json"
+VAL_IDS = "results/iter_010/manifests/validation_ids.json"
+
+
+def verify_epoch(run_dir, e, tc, v_in, protocol, val_items, gt):
+    """한 epoch의 val_metrics가 이 run·입력·adapter·원시 validation 요청 집합·protocol과 연결되는지 검증하고,
+    생성 기반 점수(utility·F1 등 summarize 결과 전체)를 원시 응답에서 다시 계산해 기록값과 같은지 확인한다. returns metrics."""
+    ed = os.path.join(run_dir, f"epoch_{e:02d}")
+    vm = os.path.join(ed, "val_metrics.json")
+    if not os.path.exists(vm):
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} val_metrics missing")
+    m = json.load(open(vm))
+    if m.get("epoch") != e or m.get("train_digest") != tc["train_digest"] or m.get("val_inputs_digest") != v_in:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} metrics not linked to this run/inputs")
+    if m.get("seed") != tc["config"]["seed"] or m.get("lr") != tc["config"]["lr"]:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} seed/lr mismatch")
+    if m.get("protocol_digest") != lock_protocol.verify(protocol):
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} metrics protocol digest differs from current protocol")
+    adg = eval_gate.adapter_digest(ed)
+    if m["adapter_digest"] != adg:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} adapter digest differs from metrics")
+    done = eval_gate.verify_gen(os.path.join(ed, "val_gen"), val_items, ["concise"], ed, protocol)
+    c = json.load(open(os.path.join(ed, "val_gen", "completion.json")))
+    if c.get("val_inputs_digest") != v_in:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} completion input digest differs")
+    ids = [i["id"] for i in val_items]
+    edges = sft_eval.area_edges(gt, [i for i in gt if gt[i]["split"] == "train"])
+    rec = json.loads(json.dumps(sft_eval.summarize(sft_eval.parse_records(done, ids, "concise", strict=True), gt, ids, edges)))
+    bad = [k for k in rec if m.get(k) != rec[k]]
+    if bad:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} recorded scores differ from recomputation from raw responses: {bad[:5]}")
+    return m
+
+
+def load_epochs(run_dir, expected_epochs, protocol, val_items=None, gt=None):
+    """epoch 1..expected_epochs 전체를 검증해 {epoch: metrics}를 반환한다. 누락·불일치는 GateError."""
+    if not expected_epochs or expected_epochs < 1:
+        raise eval_gate.GateError("expected_epochs required")
+    tc = json.load(open(os.path.join(run_dir, "train_config.json")))
+    if val_items is None:
+        val_items, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    v_in = inputs.inputs_digest(val_items, gt)
+    if tc["config"].get("val_inputs_digest") != v_in:
+        raise eval_gate.GateError(f"{run_dir}: run was not trained/validated on the current validation inputs")
+    if tc["config"].get("deterministic"):
+        raise eval_gate.GateError(f"{run_dir}: deterministic check run cannot be used for selection")
+    out = {}
+    for e in range(1, expected_epochs + 1):
+        if not os.path.exists(os.path.join(run_dir, f"epoch_{e:02d}", "val_metrics.json")):
+            raise eval_gate.GateError(f"{run_dir}: epoch {e} val_metrics missing (planned epochs 1..{expected_epochs})")
+        out[e] = verify_epoch(run_dir, e, tc, v_in, protocol, val_items, gt)
+    return out
+
+
+def file_sha(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def evidence(run_dir, expected_epochs):
+    """선택 근거 파일의 내용 hash (val_metrics·completion·원시 요청 파일·adapter). load_epochs 통과 뒤에만 부른다."""
+    ev = {"train_config_sha256": file_sha(os.path.join(run_dir, "train_config.json")), "epochs": {}}
+    for e in range(1, expected_epochs + 1):
+        ed = os.path.join(run_dir, f"epoch_{e:02d}")
+        ev["epochs"][str(e)] = {"val_metrics_sha256": file_sha(os.path.join(ed, "val_metrics.json")),
+                                "completion_sha256": file_sha(os.path.join(ed, "val_gen", "completion.json")),
+                                "gen_files_sha256": {os.path.basename(f): file_sha(f) for f in sorted(glob.glob(os.path.join(ed, "val_gen", "gen_worker*.jsonl")))},
+                                "adapter_file_sha256": file_sha(os.path.join(ed, "adapter.pt"))}
+    return ev
+
+
+def should_extend(run_dirs, protocol, expected=5):
+    rep, ext = {}, False
+    vi, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    for d in run_dirs:
+        e = load_epochs(d, expected, protocol, vi, gt)
+        du = e[5]["utility"] - e[4]["utility"]
+        rl = e[5]["val_loss"] / e[4]["val_loss"]
+        hit = du >= 0.01 and rl <= 0.99
+        rep[d] = {"utility_4": e[4]["utility"], "utility_5": e[5]["utility"], "delta_utility": du, "val_loss_ratio_5_over_4": rl, "meets_rule": hit}
+        ext = ext or hit
+    return ext, rep
+
+
+def best_epoch(epochs):
+    best = max(epochs.values(), key=lambda m: (round(m["utility"], 12), round(m["f1@0.5"], 12), -m["epoch"]))
+    return best["epoch"], {k: {"utility": m["utility"], "f1@0.3": m["f1@0.3"], "f1@0.5": m["f1@0.5"], "val_loss": m["val_loss"]}
+                           for k, m in sorted(epochs.items())}
+
+
+def pick(run_dirs, protocol, expected):
+    res = {}
+    vi, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    for d in run_dirs:
+        ep_metrics = load_epochs(d, expected, protocol, vi, gt)
+        ep, table = best_epoch(ep_metrics)
+        cfg = json.load(open(os.path.join(d, "train_config.json")))["config"]
+        res[d] = {"best_epoch": ep, "lr": cfg["lr"], "seed": cfg["seed"], "n_epochs_validated": expected, "table": table,
+                  "utility": table[ep]["utility"], "f1@0.5": table[ep]["f1@0.5"],
+                  "adapter_dir": os.path.join(d, f"epoch_{ep:02d}"), "adapter_digest": ep_metrics[ep]["adapter_digest"]}
+    best = max(res, key=lambda d: (round(res[d]["utility"], 12), round(res[d]["f1@0.5"], 12), -res[d]["lr"]))
+    return res, best
+
+
+RULES = {"extend": "iter010 fixed: any LR with utility(5)-utility(4)>=0.01 and val_loss(5)<=0.99*val_loss(4) -> both LRs to 8 epochs",
+         "pick": "iter010 fixed: epoch max utility, tie F1@0.5, then earlier epoch; run max utility, tie F1@0.5, then smaller lr"}
+
+
+def payload(mode, runs, protocol, epochs):
+    """선택 결정 + provenance (protocol 내용 digest, 규칙, 예정 epoch, seed/lr, 입력 digest, 근거 파일 hash). 항상 원시 근거에서 재계산한다."""
+    if len(set(runs)) != len(runs):
+        raise eval_gate.GateError("duplicate --runs")
+    if mode == "extend" and epochs != 5:
+        raise eval_gate.GateError("extend decision is defined at epoch 5 only")
+    pdig = lock_protocol.verify(protocol)
+    vi, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    base = {"mode": mode, "rule": RULES[mode], "protocol_path": protocol, "protocol_digest": pdig, "planned_epochs": epochs,
+            "runs_in": list(runs), "val_inputs_digest": inputs.inputs_digest(vi, gt)}
+    if mode == "extend":
+        ext, rep = should_extend(runs, protocol, 5)
+        base.update({"extend": ext, "detail": rep})
+    else:
+        res, best = pick(runs, protocol, epochs)
+        base.update({"runs": res, "selected_run": best})
+    base["evidence"] = {d: evidence(d, epochs) for d in runs}
+    return base
+
+
+def write_or_verify(path, pl):
+    """없으면 원자적으로 쓰고, 있으면 재계산 결과와 완전히 같아야 한다 (오래되거나 바뀐 선택 파일은 조용히 믿지 않는다)."""
+    if os.path.exists(path):
+        old = json.load(open(path))
+        if old != json.loads(json.dumps(pl)):
+            raise eval_gate.GateError(f"{path}: existing selection differs from recomputation from current evidence")
+        return "verified_existing"
+    tmp = path + ".tmp"
+    json.dump(pl, open(tmp, "w"), indent=1)
+    os.replace(tmp, path)
+    return "written"
+
+
+def verify_file(path, mode, protocol):
+    """선택 파일을 그 파일에 적힌 runs·예정 epoch로 다시 계산해 동일한지 검증한다 (final_eval이 사용). returns 파일 내용."""
+    old = json.load(open(path))
+    if old.get("mode") != mode:
+        raise eval_gate.GateError(f"{path}: not a {mode} selection")
+    pl = payload(mode, old["runs_in"], protocol, old["planned_epochs"])
+    if old != json.loads(json.dumps(pl)):
+        raise eval_gate.GateError(f"{path}: selection no longer matches recomputation from current evidence")
+    return old
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("mode", choices=["extend", "pick"])
+    ap.add_argument("--runs", nargs="+", required=True)
+    ap.add_argument("--epochs", type=int, required=True, help="예정 epoch 수 (extend는 5 고정)")
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    pl = payload(a.mode, a.runs, a.protocol, a.epochs)
+    st = write_or_verify(a.out, pl)
+    print(a.mode, st, pl.get("extend", pl.get("selected_run")))
+
+
+if __name__ == "__main__":
+    main()
