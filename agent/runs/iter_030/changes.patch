+++ b/rsna_diag/risk30.py
@@ -0,0 +1,355 @@
+"""iter_030: RSNA B0(seed17) 비어 있지 않은 출력의 부분 누락 위험 score(O)와 단일 continuation 개입(F).
+
+O: B0 concise 원래 generation을 output_scores=True로 재현하며 위험 baseline과 Q(branch margin)를 추출한다.
+F: 같은 generation에서 마지막 opacity 직후 분기(index=branch_index)에 token 23179를 한 번만 강제한 뒤
+   원래 greedy decoding을 계속한다 (cap ladder 1000/2000/4000, EOS 판정 유지).
+
+GT는 이 모듈에 전혀 들어오지 않는다 (source manifest의 infer 쪽 item만 사용).
+"""
+import glob
+import hashlib
+import json
+import os
+import time
+
+from . import generate as G
+from . import risk30_source as RS
+from .risk28 import fp32_logsoftmax_stats, resolve_special_ids  # 범용 FP32 log-softmax/토큰 확인 재사용
+
+MODEL_ID = G.MODEL_ID
+MODEL_REVISION = G.MODEL_REVISION
+CAPS = G.CAPS
+RUNNER_VERSION = "iter030_risk_v1"
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def read_records(path):
+    out = []
+    if os.path.exists(path):
+        with open(path) as f:
+            for ln in f:
+                if ln.strip():
+                    out.append(json.loads(ln))
+    return out
+
+
+def _run_generate(torch, model, inp, cap, eos_ids, logits_processor=None):
+    dev = "cuda"
+    x = {k: (v.to(dev, dtype=torch.bfloat16) if k == "pixel_values" else v.to(dev)) for k, v in inp.items()}
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    t0 = time.time()
+    kw = dict(max_new_tokens=cap, do_sample=False, output_scores=True, return_dict_in_generate=True)
+    if logits_processor is not None:
+        from transformers import LogitsProcessorList
+        kw["logits_processor"] = LogitsProcessorList([logits_processor])
+    with torch.no_grad():
+        out = model.generate(**x, **kw)
+    torch.cuda.synchronize()
+    dt = time.time() - t0
+    n_in = x["input_ids"].shape[1]
+    seq = out.sequences[0, n_in:].tolist()
+    ended = len(seq) > 0 and seq[-1] in eos_ids
+    scores = [s[0].detach().to(torch.float32).cpu() for s in out.scores]
+    argmax_ok = all(int(scores[i].argmax()) == seq[i] for i in range(len(seq)))
+    return {"suffix_ids": seq, "ended_eos": bool(ended), "scores": scores, "runtime_s": dt,
+            "argmax_matches_greedy": bool(argmax_ok),
+            "peak_mem_alloc_gb": torch.cuda.max_memory_allocated() / 2**30}
+
+
+def _generate_with_cap_ladder(torch, proc, model, inp, eos_ids, logits_processor_factory=None):
+    """G.generate와 같은 cap ladder(1000->2000->4000)를 쓰되 output_scores/logits_processor를 지원한다.
+
+    logits_processor_factory: () -> LogitsProcessor 인스턴스(각 attempt마다 새 상태로 재생성; stateful 강제 1회용).
+    """
+    attempts = []
+    for cap in CAPS:
+        lp = logits_processor_factory() if logits_processor_factory else None
+        r = _run_generate(torch, model, inp, cap, eos_ids, logits_processor=lp)
+        attempts.append(r)
+        if r["ended_eos"]:
+            break
+    return attempts
+
+
+def make_force_processor(prompt_len, branch_step, force_id):
+    import torch as T
+    from transformers import LogitsProcessor
+
+    class ForceAt(LogitsProcessor):
+        def __init__(self):
+            self.done = False
+            self.fired_step = None
+
+        def __call__(self, input_ids, scores):
+            step = input_ids.shape[1] - prompt_len
+            if step == branch_step and not self.done:
+                self.done = True
+                self.fired_step = step
+                new_scores = T.full_like(scores, float("-inf"))
+                new_scores[:, force_id] = 0.0
+                return new_scores
+            return scores
+    return ForceAt()
+
+
+def score_O(torch, proc, model, image, item, eos_ids):
+    """원래 concise generation을 재현하며 전체 per-step score와 baseline 위험 지표를 추출한다."""
+    from . import prompts as P
+    inp = G.build_inputs(proc, image, P.CONCISE)
+    expect_suffix = item["seed17_suffix_ids"]
+    max_new = min(len(expect_suffix) + 4, CAPS[0])
+    r = _run_generate(torch, model, inp, max_new, eos_ids)
+    reproduced = r["suffix_ids"] == expect_suffix
+    n = len(r["scores"])
+    per_step = []
+    for i in range(n):
+        chosen = r["suffix_ids"][i]
+        nll, ent, logp = fp32_logsoftmax_stats(r["scores"][i], chosen)
+        per_step.append({"nll": nll, "entropy": ent})
+    bidx = item["branch_index"]
+    branch_scores = r["scores"][bidx] if bidx < n else None
+    q = close_logit = continue_logit = branch_nll = None
+    if branch_scores is not None:
+        close_logit = float(branch_scores[RS.CLOSE_TOKEN])
+        continue_logit = float(branch_scores[RS.CONTINUE_TOKEN])
+        q = continue_logit - close_logit
+        chosen_at_branch = r["suffix_ids"][bidx]
+        branch_nll, _, _ = fp32_logsoftmax_stats(branch_scores, chosen_at_branch)
+    nlls_excl_last = [s["nll"] for s in per_step[:-1]] if n >= 1 else []
+    ents_excl_last = [s["entropy"] for s in per_step[:-1]] if n >= 1 else []
+    eos_nll = per_step[-1]["nll"] if per_step else None
+    first_entropy = per_step[0]["entropy"] if per_step else None
+    return {
+        "task": "O", "id": item["id"],
+        "suffix_ids": r["suffix_ids"], "ended_eos": r["ended_eos"],
+        "reproduced_expected_suffix": bool(reproduced),
+        "argmax_matches_greedy": r["argmax_matches_greedy"],
+        "n_output_tokens": n, "n_pred_boxes": item["n_pred_boxes"],
+        "branch_index": bidx, "branch_close_logit": close_logit, "branch_continue_logit": continue_logit,
+        "Q_continue_minus_close": q, "branch_chosen_token_nll": branch_nll,
+        "mean_nll_excl_last": (sum(nlls_excl_last) / len(nlls_excl_last)) if nlls_excl_last else None,
+        "mean_entropy_excl_last": (sum(ents_excl_last) / len(ents_excl_last)) if ents_excl_last else None,
+        "eos_nll": eos_nll, "first_token_entropy": first_entropy,
+        "neg_n_output_tokens": -n, "neg_n_pred_boxes": -item["n_pred_boxes"],
+        "runtime_s": r["runtime_s"], "peak_mem_alloc_gb": r["peak_mem_alloc_gb"],
+    }
+
+
+def score_F(torch, proc, model, image, item, eos_ids):
+    """마지막 opacity 직후 분기에서 CONTINUE_TOKEN(23179)을 한 번 강제하고 계속 생성한다."""
+    from . import prompts as P
+    inp = G.build_inputs(proc, image, P.CONCISE)
+    prompt_len = inp["input_ids"].shape[1]
+    bidx = item["branch_index"]
+    expect_prefix = item["seed17_suffix_ids"][:bidx]
+
+    def factory():
+        return make_force_processor(prompt_len, bidx, RS.CONTINUE_TOKEN)
+
+    attempts = _generate_with_cap_ladder(torch, proc, model, inp, eos_ids, logits_processor_factory=factory)
+    fin = attempts[-1]
+    prefix_ok = fin["suffix_ids"][:bidx] == expect_prefix
+    forced_ok = len(fin["suffix_ids"]) > bidx and fin["suffix_ids"][bidx] == RS.CONTINUE_TOKEN
+    return {
+        "task": "F", "id": item["id"],
+        "suffix_ids": fin["suffix_ids"], "ended_eos": fin["ended_eos"],
+        "n_attempts": len(attempts), "final_cap": CAPS[len(attempts) - 1],
+        "prefix_matches_O": bool(prefix_ok), "forced_token_applied": bool(forced_ok),
+        "branch_index": bidx,
+        "runtime_s": sum(a["runtime_s"] for a in attempts),
+        "peak_mem_alloc_gb": max(a["peak_mem_alloc_gb"] for a in attempts),
+    }
+
+
+def request_id(task, split, item_id):
+    return sha(f"{MODEL_REVISION}|iter030|{task}|{split}|{item_id}".encode())[:32]
+
+
+def validate_existing(out_dir, adapter_digest, split, px_fn):
+    """out_dir의 모든 gen_worker*.jsonl을 현재 adapter/split/입력 pixel hash와 대조한다.
+
+    stale/foreign(다른 adapter·split)·입력 변경·파일 간 중복이면 RunError. returns {(id, task): record}.
+    px_fn: image path -> (image, aff, pixel_sha256) (테스트에서는 순수 함수로 주입 가능).
+    """
+    done = {}
+    for fn in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        for r in read_records(fn):
+            key = (r["id"], r["task"])
+            if r.get("adapter_digest") != adapter_digest or r.get("split") != split:
+                raise G.RunError(f"stale/foreign record in {fn}: {key}")
+            if r["input_pixel_sha256"] != px_fn(r["image"])[2]:
+                raise G.RunError(f"input image changed since completion for {key}")
+            if key in done:
+                raise G.RunError(f"duplicate request {key} across worker files")
+            done[key] = r
+    return done
+
+
+def run_worker(items, split, out_dir, worker_idx, protocol_path, adapter_dir, source_manifest,
+               tasks=("O", "F"), time_limit=None, max_patients=None):
+    from . import lock_protocol as LP, queue_lock as QL
+    pdig_protocol = LP.verify(protocol_path) if protocol_path else None
+    info = QL.my_info(worker=worker_idx, split=split)
+    wl = os.path.join(out_dir, f"worker_{worker_idx}.lock")
+    lk, own, _ = QL.try_lock(wl, info)
+    if lk is None:
+        raise G.RunError(f"worker {worker_idx} already running: {own}")
+    try:
+        import torch
+        torch, proc, model = G.load_model()
+        adapter_digest = G.load_adapter(torch, model, adapter_dir)
+        want = source_manifest["adapter_digest_seed17"]
+        if adapter_digest != want:
+            raise G.RunError(f"adapter digest mismatch: got {adapter_digest} want {want}")
+        ids_map = resolve_special_ids(proc)
+        for k, want_id in source_manifest["special_token_ids"].items():
+            if ids_map[k] != want_id:
+                raise G.RunError(f"tokenizer id for {k} changed: {ids_map[k]} != locked {want_id}")
+        env = G.env_info(torch, proc, model)
+        if env["model_revision"] != MODEL_REVISION:
+            raise G.RunError("model revision mismatch")
+        eos = env["eos_token_id"]
+        eos_ids = set(eos if isinstance(eos, list) else [eos])
+        env_path = os.path.join(out_dir, f"worker_{worker_idx}.env.json")
+        if not os.path.exists(env_path):
+            json.dump({"env": env, "adapter_digest": adapter_digest, "protocol_digest": pdig_protocol,
+                       "special_token_ids": ids_map, "worker": worker_idx},
+                      open(env_path, "w"), indent=1, default=str)
+
+        out_path = os.path.join(out_dir, f"gen_worker{worker_idx}.jsonl")
+        claim_dir = os.path.join(out_dir, "claims")
+        os.makedirs(claim_dir, exist_ok=True)
+        img_cache = {}
+
+        def px(path):
+            if path not in img_cache:
+                img_cache[path] = G.load_image(path)
+            return img_cache[path]
+
+        def existing_done():
+            return validate_existing(out_dir, adapter_digest, split, px)
+
+        done = existing_done()
+        log = open(out_path + ".log", "a")
+        t0, n_new, n_patients = time.time(), 0, 0
+        for it in items:
+            if max_patients is not None and n_patients >= max_patients:
+                break
+            if all((it["id"], t) in done for t in tasks):
+                continue
+            clk, prev, reclaimed = QL.try_lock(os.path.join(claim_dir, f"{it['id']}.claim"), info)
+            if clk is None:
+                continue
+            try:
+                done = existing_done()
+                if all((it["id"], t) in done for t in tasks):
+                    continue
+                image, aff, px_hash = px(it["image"])
+                if px_hash != it["expected_pixel_sha256"]:
+                    raise G.RunError(f"input pixel changed for {it['id']}")
+                for t in tasks:
+                    if (it["id"], t) in done:
+                        continue
+                    if time_limit and time.time() - t0 > time_limit:
+                        log.write(json.dumps({"event": "stop_time_limit", "n_new": n_new}) + "\n")
+                        log.flush()
+                        return {"n_new": n_new, "n_patients": n_patients}
+                    if t == "O":
+                        rec = score_O(torch, proc, model, image, it, eos_ids)
+                    elif t == "F":
+                        rec = score_F(torch, proc, model, image, it, eos_ids)
+                    else:
+                        raise G.RunError(f"unknown task {t}")
+                    rec.update({"variant": "sft", "split": split,
+                                "request_id": request_id(t, split, it["id"]),
+                                "adapter_digest": adapter_digest, "protocol_digest": pdig_protocol,
+                                "image": it["image"], "image_file_sha256": it.get("file_sha256"),
+                                "input_pixel_sha256": px_hash, "worker": worker_idx, "ts": time.time(),
+                                "runner": RUNNER_VERSION})
+                    with open(out_path, "a") as f:
+                        f.write(json.dumps(rec) + "\n")
+                        f.flush()
+                        os.fsync(f.fileno())
+                    done[(it["id"], t)] = rec
+                    n_new += 1
+                    log.write(json.dumps({"event": "done", "id": it["id"], "task": t,
+                                          "elapsed": round(time.time() - t0, 1)}) + "\n")
+                    log.flush()
+                n_patients += 1
+            finally:
+                clk.release()
+        return {"n_new": n_new, "n_patients": n_patients}
+    finally:
+        lk.release()
+
+
+def check_completion(out_dir, items, tasks=("O", "F")):
+    problems = []
+    expect = {(it["id"], t) for it in items for t in tasks}
+    got = {}
+    for fn in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        for r in read_records(fn):
+            key = (r["id"], r["task"])
+            if key in got:
+                problems.append(f"duplicate {key}")
+            got[key] = r
+    missing = expect - set(got)
+    extra = set(got) - expect
+    if missing:
+        problems.append(f"missing {len(missing)} e.g. {sorted(missing)[:3]}")
+    if extra:
+        problems.append(f"extra {len(extra)} e.g. {sorted(extra)[:3]}")
+    return {"ok": not problems, "problems": problems, "expected": len(expect), "got": len(got)}
+
+
+def load_all(out_dir):
+    out = {}
+    for fn in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        for r in read_records(fn):
+            out[(r["id"], r["task"])] = r
+    return out
+
+
+def main():
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--source-manifest", required=True)
+    ap.add_argument("--split", required=True, choices=["C", "E", "D24"])
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--worker", type=int, required=True)
+    ap.add_argument("--protocol", default=None)
+    ap.add_argument("--adapter", required=True)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--max-patients", type=int, default=None)
+    ap.add_argument("--ids", default=None)
+    ap.add_argument("--tasks", default="O,F")
+    ap.add_argument("--gpu", default=None, help="물리 GPU index; CUDA 초기화 전에 CUDA_VISIBLE_DEVICES로 설정한다 "
+                    "(셸에서 env var 접두사 대신 CLI 인자로 받아 승인 프롬프트를 피한다)")
+    a = ap.parse_args()
+    if a.gpu is not None:
+        os.environ["CUDA_VISIBLE_DEVICES"] = str(a.gpu)
+
+    sm = json.load(open(a.source_manifest))
+    if a.split == "D24":
+        d24 = RS.select_d24(sm)
+        items = d24["one_box"] + d24["two_box"]
+        src_split = "C"
+    else:
+        items = list(sm["patients"][a.split].values())
+        src_split = a.split
+    if a.ids:
+        keep = set(json.load(open(a.ids)))
+        items = [it for it in items if it["id"] in keep]
+    os.makedirs(a.out_dir, exist_ok=True)
+    tasks = tuple(a.tasks.split(","))
+    res = run_worker(items, src_split, a.out_dir, a.worker, a.protocol, a.adapter, sm,
+                      tasks=tasks, time_limit=a.time_limit, max_patients=a.max_patients)
+    print(json.dumps(res))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/risk30_eval.py b/rsna_diag/risk30_eval.py
new file mode 100644
index 0000000..178c44e
--- /dev/null
+++ b/rsna_diag/risk30_eval.py
@@ -0,0 +1,214 @@
+"""iter_030 평가: 위험 baseline·Q·seed baseline AUROC/Capture, H2 회복률, F1/FP 부작용, bootstrap CI."""
+import glob
+import json
+import math
+
+import numpy as np
+
+from . import metrics, parse
+from .risk28_eval import auroc, capture_at_k, bootstrap_indices  # 범용 AUROC/Capture/bootstrap 재사용
+
+BASELINE_ORDER = ["neg_n_pred_boxes", "neg_n_output_tokens", "first_token_entropy",
+                  "mean_nll_excl_last", "mean_entropy_excl_last", "eos_nll", "branch_chosen_token_nll"]
+SEED_BASELINES = ["seed_max_box_diff", "seed_geom_mismatch_mean"]
+ALL_RISK_SCORES = BASELINE_ORDER + SEED_BASELINES
+
+
+def load_all(out_dir):
+    out = {}
+    for fn in sorted(glob.glob(f"{out_dir}/gen_worker*.jsonl")):
+        for ln in open(fn):
+            if ln.strip():
+                r = json.loads(ln)
+                out[(r["id"], r["task"])] = r
+    return out
+
+
+def seed_geom_mismatch(seed_boxes, ref_boxes, thr=0.3):
+    """seed_boxes가 비어있으면 0. 아니면 ref_boxes에 IoU>=thr로 matching되지 않는 seed_boxes 비율."""
+    if not seed_boxes:
+        return 0.0
+    pairs = metrics.match(ref_boxes, seed_boxes, thr)  # gt=ref, pred=seed -> pairs (ref_idx, seed_idx)
+    matched_seed = {si for _, si in pairs}
+    return float(len(seed_boxes) - len(matched_seed)) / len(seed_boxes)
+
+
+def build_rows(source_manifest, source_audit, o_records, split):
+    rows = []
+    for pid, item in source_manifest["patients"][split].items():
+        o = o_records.get((pid, "O"))
+        if o is None:
+            raise RuntimeError(f"missing O record for {pid}")
+        a = source_audit["patients"][split][pid]
+        ev = a["event"]
+        s29 = a["pred_boxes_seed29"] or []
+        s43 = a["pred_boxes_seed43"] or []
+        n17 = item["n_pred_boxes"]
+        seed_max_diff = max(len(s29), len(s43)) - n17
+        geom_29 = seed_geom_mismatch(s29, a["pred_boxes_seed17"], 0.3)
+        geom_43 = seed_geom_mismatch(s43, a["pred_boxes_seed17"], 0.3)
+        rows.append({
+            "id": pid, "y_partial": int(ev["y_partial"]), "n_gt": ev["n_gt"], "n_pred": n17,
+            "category": a["category"],
+            "neg_n_pred_boxes": o["neg_n_pred_boxes"], "neg_n_output_tokens": o["neg_n_output_tokens"],
+            "first_token_entropy": o["first_token_entropy"], "mean_nll_excl_last": o["mean_nll_excl_last"],
+            "mean_entropy_excl_last": o["mean_entropy_excl_last"], "eos_nll": o["eos_nll"],
+            "branch_chosen_token_nll": o["branch_chosen_token_nll"],
+            "Q_continue_minus_close": o["Q_continue_minus_close"],
+            "seed_max_box_diff": float(seed_max_diff), "seed_geom_mismatch_mean": (geom_29 + geom_43) / 2.0,
+            "reproduced_expected_suffix": o["reproduced_expected_suffix"], "ended_eos_O": o["ended_eos"],
+        })
+    return rows
+
+
+def metric_ci(values_fn, n, B=10000, seed=30017, alpha_lo=2.5, alpha_hi=97.5):
+    idx = bootstrap_indices(n, B, seed)
+    vals = np.array([values_fn(row) for row in idx])
+    point = values_fn(np.arange(n))
+    return {"point": float(point), "lo": float(np.percentile(vals, alpha_lo)),
+            "hi": float(np.percentile(vals, alpha_hi)), "B": B, "seed": seed}
+
+
+def paired_diff_ci(a_fn, b_fn, n, B=10000, seed=30017, alpha_lo=2.5, alpha_hi=97.5):
+    idx = bootstrap_indices(n, B, seed)
+    a_vals = np.array([a_fn(row) for row in idx])
+    b_vals = np.array([b_fn(row) for row in idx])
+    d = a_vals - b_vals
+    point = a_fn(np.arange(n)) - b_fn(np.arange(n))
+    return {"point": float(point), "lo": float(np.percentile(d, alpha_lo)), "hi": float(np.percentile(d, alpha_hi)),
+            "B": B, "seed": seed}
+
+
+def wilson(k, n):
+    return metrics.wilson(k, n)
+
+
+def compute_baseline_aurocs(rows, score_names=ALL_RISK_SCORES):
+    y = [r["y_partial"] for r in rows]
+    out = {}
+    for name in score_names:
+        s = [r[name] for r in rows]
+        out[name] = auroc(s, y)
+    return out
+
+
+def pick_bstar(rows):
+    """C에서 Q를 제외한 baseline 중 엄격한 사건 AUROC 최대 항목을 계획서 순서로 동점 처리해 선택한다."""
+    aurocs = compute_baseline_aurocs(rows, ALL_RISK_SCORES)
+    best_name, best_val = None, -1.0
+    for name in ALL_RISK_SCORES:  # 목록 순서 = 동점 우선순위
+        v = aurocs[name]
+        if not math.isnan(v) and v > best_val + 1e-12:
+            best_name, best_val = name, v
+    return best_name, aurocs
+
+
+def one_box_layer(rows):
+    return [r for r in rows if r["n_pred"] == 1]
+
+
+def h1_report(rows, bstar_name):
+    y = np.array([r["y_partial"] for r in rows])
+    q = np.array([r["Q_continue_minus_close"] for r in rows])
+    bstar = np.array([r[bstar_name] for r in rows])
+    n = len(rows)
+
+    def auc_q(idx):
+        return auroc(q[idx], y[idx])
+
+    def auc_b(idx):
+        return auroc(bstar[idx], y[idx])
+    diff = paired_diff_ci(auc_q, auc_b, n, seed=30017, alpha_lo=2.5, alpha_hi=97.5)
+    auc_q_ci = metric_ci(auc_q, n, seed=30017)
+    auc_b_ci = metric_ci(auc_b, n, seed=30017)
+    cap_diff = capture_at_k(q.tolist(), y.tolist(), 0.2) - capture_at_k(bstar.tolist(), y.tolist(), 0.2)
+
+    one = one_box_layer(rows)
+    q1_ci = None
+    if one and len({r["y_partial"] for r in one}) > 1:
+        y1 = np.array([r["y_partial"] for r in one])
+        q1 = np.array([r["Q_continue_minus_close"] for r in one])
+        n1 = len(one)
+
+        def auc_q1(idx):
+            return auroc(q1[idx], y1[idx])
+        q1_ci = metric_ci(auc_q1, n1, seed=30017)
+    return {
+        "n": n, "n_events": int(y.sum()), "bstar": bstar_name,
+        "auroc_Q": auc_q_ci, "auroc_Bstar": auc_b_ci, "diff_Q_minus_Bstar": diff,
+        "capture20_Q": capture_at_k(q.tolist(), y.tolist(), 0.2),
+        "capture20_Bstar": capture_at_k(bstar.tolist(), y.tolist(), 0.2),
+        "capture20_diff": cap_diff,
+        "n_one_box": len(one), "n_one_box_events": int(sum(r["y_partial"] for r in one)),
+        "auroc_Q_one_box_layer": q1_ci,
+    }
+
+
+def f_new_boxes(o_boxes, f_boxes):
+    """F_boxes[:len(o_boxes)]가 O와 정확히 같아야 한다(강제 전 prefix 보존). 아니면 None(무효)."""
+    n = len(o_boxes)
+    if f_boxes[:n] != o_boxes:
+        return None
+    return f_boxes[n:]
+
+
+def decode_and_parse(tokenizer, suffix_ids, ended_eos):
+    text = tokenizer.decode(suffix_ids, skip_special_tokens=False)
+    return text, parse.parse_response(text, ended_eos)
+
+
+def h2_and_cost_report(source_manifest, source_audit, f_records, split, tokenizer):
+    """엄격한 사건의 회복률과 전체 모집단의 F1/FP/dup/invalid/길이 비용을 계산한다."""
+    events_detail, recovered_ids = [], []
+    cost_rows = []
+    for pid, item in source_manifest["patients"][split].items():
+        a = source_audit["patients"][split][pid]
+        ev = a["event"]
+        o_boxes = a["pred_boxes_seed17"]
+        gt = a["gt_boxes_norm"]
+        f = f_records.get((pid, "F"))
+        if f is None:
+            raise RuntimeError(f"missing F record for {pid}")
+        f_text, f_parsed = decode_and_parse(tokenizer, f["suffix_ids"], f["ended_eos"])
+        f_valid = f_parsed["status"] in parse.VALID
+        f_boxes = f_parsed["boxes"] if f_valid else []
+        new_boxes = f_new_boxes(o_boxes, f_boxes) if f_valid else None
+        prefix_preserved = new_boxes is not None
+        o_metrics = metrics.patient_metrics(o_boxes, gt, 0.3)
+        o_metrics5 = metrics.patient_metrics(o_boxes, gt, 0.5)
+        f_metrics = metrics.patient_metrics(f_boxes, gt, 0.3) if f_valid else None
+        f_metrics5 = metrics.patient_metrics(f_boxes, gt, 0.5) if f_valid else None
+        dup_f = parse.duplicates(f_boxes) if f_valid else None
+        cost_rows.append({
+            "id": pid, "category": a["category"], "n_gt": len(gt), "n_pred_O": len(o_boxes),
+            "f_valid": f_valid, "f_prefix_preserved": prefix_preserved, "f_status": f_parsed["status"],
+            "f_forced_applied": f.get("forced_token_applied"), "f_ended_eos": f["ended_eos"],
+            "o_f1_03": o_metrics["f1"], "o_f1_05": o_metrics5["f1"], "o_recall_03": o_metrics["recall"],
+            "f_f1_03": f_metrics["f1"] if f_metrics else None, "f_f1_05": f_metrics5["f1"] if f_metrics5 else None,
+            "f_recall_03": f_metrics["recall"] if f_metrics else None,
+            "f_n_pred": len(f_boxes) if f_valid else None, "f_dup": dup_f,
+            "f_new_box_count": len(new_boxes) if new_boxes is not None else None,
+            "f_runtime_s": f["runtime_s"], "f_n_attempts": f["n_attempts"], "f_final_cap": f["final_cap"],
+        })
+        if ev["y_partial"]:
+            recovered = False
+            if prefix_preserved and new_boxes:
+                missed_gt = [gt[i] for i in ev["zero_overlap_gt_idx"]]
+                pairs = metrics.match(new_boxes, missed_gt, 0.3)
+                recovered = len(pairs) >= 1
+            events_detail.append({"id": pid, "recovered": recovered, "f_valid": f_valid,
+                                  "prefix_preserved": prefix_preserved,
+                                  "n_new_boxes": len(new_boxes) if new_boxes is not None else None})
+            if recovered:
+                recovered_ids.append(pid)
+
+    n_events = len(events_detail)
+    n_recovered = len(recovered_ids)
+    wilson_lo, wilson_hi = wilson(n_recovered, n_events) if n_events else (float("nan"), float("nan"))
+    return {
+        "n_events": n_events, "n_recovered": n_recovered,
+        "recovery_rate": (n_recovered / n_events) if n_events else float("nan"),
+        "wilson_95_lo": wilson_lo, "wilson_95_hi": wilson_hi,
+        "events_detail": events_detail, "recovered_ids": recovered_ids,
+        "cost_rows": cost_rows,
+    }
diff --git a/rsna_diag/risk30_source.py b/rsna_diag/risk30_source.py
new file mode 100644
index 0000000..ec89a3e
--- /dev/null
+++ b/rsna_diag/risk30_source.py
@@ -0,0 +1,224 @@
+"""iter_030: 비어 있지 않은 B0(seed17) 출력 C201/E402의 read-only source manifest와 부분 누락 사건 계산.
+
+GT는 이 manifest의 audit 전용 필드에만 있고, GPU 추론에 넘기는 item(risk30.py가 읽는 부분)에는 넣지 않는다.
+"""
+import glob
+import hashlib
+import json
+import os
+
+from . import geometry, metrics, parse
+
+GT_MANIFEST = "results/iter_010/manifests/gt_manifest.json"
+VALIDATION_IDS = "results/iter_010/manifests/validation_ids.json"
+CONFIRM_IDS = "results/iter_010/manifests/confirm_ids.json"
+
+PATTERNS = {
+    ("C", 17): "results/iter_012/train/lr2e-4_s17/epoch_05/val_gen/gen_worker*.jsonl",
+    ("C", 29): "results/iter_012/train/lr2e-4_s29/epoch_05/val_gen/gen_worker*.jsonl",
+    ("C", 43): "results/iter_012/train/lr2e-4_s43/epoch_05/val_gen/gen_worker*.jsonl",
+    ("C", "M0"): "results/iter_012/base_val_full/gen_worker*.jsonl",
+    ("E", 17): "results/iter_012/confirm_sft_seed17/gen_worker*.jsonl",
+    ("E", 29): "results/iter_012/confirm_sft_seed29/gen_worker*.jsonl",
+    ("E", 43): "results/iter_012/confirm_sft_seed43/gen_worker*.jsonl",
+    ("E", "M0"): "results/iter_012/confirm_base/gen_worker*.jsonl",
+}
+ADAPTER_PATH = "results/iter_012/train/lr2e-4_s17/epoch_05/adapter.pt"
+ADAPTER_SHA256_KNOWN = "5f542af96df705e567bf4cfb000398b09313db2456c577e772bd76481799cf29"
+ADAPTER_TENSOR_DIGEST_KNOWN = "e13f3c4461b826a060c90dfe4e4ee4c2ebac36a08f84be1a45a37495816cec11"
+
+IOU_THR = 0.3
+LAST_OPACITY_TOKEN = 23131  # '_opacity'
+CLOSE_TOKEN = 236775        # '"'  (list-closing branch)
+CONTINUE_TOKEN = 23179      # '"},'  (list-continuation branch)
+LIST_CLOSE_TOKEN = 15947    # '}]'
+EOT_TOKEN = 106             # <end_of_turn>
+EMPTY_SUFFIX = [3805, 106]
+
+
+def sha256_file(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def load_concise(pattern):
+    by_id = {}
+    for f in sorted(glob.glob(pattern)):
+        for ln in open(f):
+            if not ln.strip():
+                continue
+            r = json.loads(ln)
+            if r.get("prompt_name") != "concise":
+                continue
+            if r["id"] in by_id:
+                raise RuntimeError(f"duplicate id {r['id']} in {pattern}")
+            by_id[r["id"]] = r
+    return by_id
+
+
+def gt_norm_boxes(gt_entries, aff, pixel_sha=None):
+    """gt_manifest의 각 항목은 이미 yxyx_norm(패딩 canvas 기준, 0-1000)을 담고 있다.
+    xyxy_px에서 canvas_to_norm으로 독립 재계산해 저장값과 대조한다(허용 오차 1e-6)."""
+    top, left, side = aff
+    out = []
+    for e in gt_entries:
+        recomputed = geometry.canvas_to_norm(e["xyxy_px"], top, left, side)
+        stored = e["yxyx_norm"]
+        if max(abs(a - b) for a, b in zip(recomputed, stored)) > 1e-6:
+            raise RuntimeError(f"gt yxyx_norm mismatch: stored={stored} recomputed={recomputed} pixel_sha={pixel_sha}")
+        out.append(stored)
+    return out
+
+
+def branch_index(suffix_ids):
+    """suffix_ids 내 마지막 LAST_OPACITY_TOKEN(23131)의 index+1 (다음 결정 지점). 없으면 None."""
+    idx = None
+    for i, t in enumerate(suffix_ids):
+        if t == LAST_OPACITY_TOKEN:
+            idx = i
+    if idx is None:
+        return None
+    return idx + 1
+
+
+def event_from_boxes(pred_boxes, gt_boxes, thr=IOU_THR):
+    """returns dict: tp, fn_034, any_gt_zero_overlap, y_partial(strict), n_pred, n_gt."""
+    pairs = metrics.match(pred_boxes, gt_boxes, thr)
+    tp = len(pairs)
+    matched_gt = {gi for gi, _ in pairs}
+    any_zero = any(all(metrics.inter(g, p) <= 0.0 for p in pred_boxes) for gi, g in enumerate(gt_boxes) if gi not in matched_gt) \
+        if len(gt_boxes) > len(matched_gt) else False
+    zero_overlap_gt = [gi for gi, g in enumerate(gt_boxes) if gi not in matched_gt and all(metrics.inter(g, p) <= 0.0 for p in pred_boxes)]
+    fn = len(gt_boxes) - tp
+    y_partial = (tp >= 1) and (len(zero_overlap_gt) >= 1)
+    return {"tp": tp, "n_pred": len(pred_boxes), "n_gt": len(gt_boxes), "fn": fn,
+            "zero_overlap_gt_idx": zero_overlap_gt, "any_gt_zero_overlap": len(zero_overlap_gt) >= 1,
+            "y_partial": bool(y_partial)}
+
+
+def build(out_path, audit_out_path):
+    gt = json.load(open(GT_MANIFEST))
+    val_ids = json.load(open(VALIDATION_IDS))
+    confirm_ids = json.load(open(CONFIRM_IDS))
+    assert len(val_ids) == 400 and len(set(val_ids)) == 400
+    assert len(confirm_ids) == 800 and len(set(confirm_ids)) == 800
+
+    recs = {key: load_concise(pat) for key, pat in PATTERNS.items()}
+    for split, ids_expected in (("C", val_ids), ("E", confirm_ids)):
+        for who in (17, 29, 43, "M0"):
+            got = recs[(split, who)]
+            missing = set(ids_expected) - set(got)
+            extra = set(got) - set(ids_expected)
+            if missing or extra:
+                raise RuntimeError(f"{split}/{who}: missing={len(missing)} extra={len(extra)}")
+
+    adapter_sha = sha256_file(ADAPTER_PATH)
+    if adapter_sha != ADAPTER_SHA256_KNOWN:
+        raise RuntimeError(f"adapter sha256 mismatch: {adapter_sha} != {ADAPTER_SHA256_KNOWN}")
+
+    def build_split(split, ids_expected):
+        c17, c29, c43, m0 = (recs[(split, w)] for w in (17, 29, 43, "M0"))
+        patients_infer = {}   # GT-free: fed to GPU code
+        patients_audit = {}   # includes GT; read-only, never passed to generation
+        for pid in ids_expected:
+            p17 = parse.parse_response(c17[pid]["suffix_text_raw"], c17[pid]["ended_eos"])
+            if p17["status"] != "valid_nonempty":
+                continue
+            if c17[pid]["adapter_digest"] != ADAPTER_TENSOR_DIGEST_KNOWN:
+                raise RuntimeError(f"{pid}: seed17 adapter_digest != known")
+            p29 = parse.parse_response(c29[pid]["suffix_text_raw"], c29[pid]["ended_eos"])
+            p43 = parse.parse_response(c43[pid]["suffix_text_raw"], c43[pid]["ended_eos"])
+            pm0 = parse.parse_response(m0[pid]["suffix_text_raw"], m0[pid]["ended_eos"])
+            g = gt[pid]
+            aff = tuple(c17[pid]["pad_affine_top_left_side"])
+            gt_boxes_norm = gt_norm_boxes(g["boxes"], aff, pixel_sha=c17[pid]["input_pixel_sha256"])
+            ev = event_from_boxes(p17["boxes"], gt_boxes_norm, IOU_THR)
+            bidx = branch_index(c17[pid]["suffix_ids"])
+            if bidx is None or bidx >= len(c17[pid]["suffix_ids"]):
+                raise RuntimeError(f"{pid}: could not locate branch index in suffix {c17[pid]['suffix_ids']}")
+            expect_last4 = c17[pid]["suffix_ids"][-4:]
+            if expect_last4 != [LAST_OPACITY_TOKEN, CLOSE_TOKEN, LIST_CLOSE_TOKEN, EOT_TOKEN]:
+                raise RuntimeError(f"{pid}: unexpected tail token structure {expect_last4}")
+            branch_chosen = c17[pid]["suffix_ids"][bidx]
+            if branch_chosen != CLOSE_TOKEN:
+                raise RuntimeError(f"{pid}: branch token at index {bidx} is {branch_chosen}, expected {CLOSE_TOKEN}")
+
+            patients_infer[pid] = {
+                "id": pid, "split": split, "image": c17[pid]["image"],
+                "file_sha256": c17[pid]["image_file_sha256"],
+                "expected_pixel_sha256": c17[pid]["input_pixel_sha256"],
+                "m0_expected_pixel_sha256": m0[pid]["input_pixel_sha256"],
+                "seed17_suffix_ids": c17[pid]["suffix_ids"],
+                "seed17_n_output_tokens": c17[pid]["n_output_tokens"],
+                "branch_index": bidx,
+                "n_pred_boxes": len(p17["boxes"]),
+            }
+            patients_audit[pid] = {
+                "category": g["category"], "gt_boxes_pixel_xyxy": [e["xyxy_px"] for e in g["boxes"]],
+                "gt_boxes_norm": gt_boxes_norm,
+                "pad_affine": list(aff),
+                "pred_boxes_seed17": p17["boxes"], "pred_labels_seed17": p17["labels"],
+                "pred_boxes_seed29": p29["boxes"] if p29["status"] in parse.VALID else None,
+                "pred_boxes_seed43": p43["boxes"] if p43["status"] in parse.VALID else None,
+                "seed29_status": p29["status"], "seed43_status": p43["status"],
+                "pred_boxes_m0": pm0["boxes"] if pm0["status"] in parse.VALID else None,
+                "m0_status": pm0["status"],
+                "event": ev,
+            }
+        return patients_infer, patients_audit
+
+    C_infer, C_audit = build_split("C", val_ids)
+    E_infer, E_audit = build_split("E", confirm_ids)
+
+    from . import generate as G
+    from . import risk28
+    os.environ.setdefault("HF_HOME", G.HF_HOME)
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    import transformers
+    proc = transformers.AutoProcessor.from_pretrained(G.MODEL_ID, revision=G.MODEL_REVISION)
+    special_token_ids = risk28.resolve_special_ids(proc)
+    branch_ids = {"opacity": LAST_OPACITY_TOKEN, "close": CLOSE_TOKEN, "continue": CONTINUE_TOKEN,
+                  "list_close": LIST_CLOSE_TOKEN, "eot": EOT_TOKEN}
+    decoded = {k: proc.tokenizer.decode([v]) for k, v in branch_ids.items()}
+
+    manifest = {
+        "model_revision": G.MODEL_REVISION,
+        "special_token_ids": special_token_ids,
+        "branch_token_ids": branch_ids, "branch_token_decoded": decoded,
+        "adapter_sha256": adapter_sha, "adapter_digest_seed17": ADAPTER_TENSOR_DIGEST_KNOWN,
+        "n_C": len(C_infer), "n_E": len(E_infer),
+        "patients": {"C": C_infer, "E": E_infer},
+    }
+    audit = {"patients": {"C": C_audit, "E": E_audit},
+             "n_events_C": sum(1 for p in C_audit.values() if p["event"]["y_partial"]),
+             "n_events_E": sum(1 for p in E_audit.values() if p["event"]["y_partial"])}
+    os.makedirs(os.path.dirname(out_path), exist_ok=True)
+    os.makedirs(os.path.dirname(audit_out_path), exist_ok=True)
+    json.dump(manifest, open(out_path, "w"), indent=1)
+    json.dump(audit, open(audit_out_path, "w"), indent=1)
+    return manifest, audit
+
+
+def token_ids_len(proc, text):
+    return len(proc.tokenizer(text, add_special_tokens=False)["input_ids"])
+
+
+def _h(pid):
+    return hashlib.sha256(pid.encode()).hexdigest()
+
+
+def select_d24(manifest):
+    """C에서 hash 순서로 1박스 12명 + 2박스 12명 (계획 2절)."""
+    C = manifest["patients"]["C"]
+    one = sorted((p for p in C.values() if p["n_pred_boxes"] == 1), key=lambda p: _h(p["id"]))[:12]
+    two = sorted((p for p in C.values() if p["n_pred_boxes"] == 2), key=lambda p: _h(p["id"]))[:12]
+    if len(one) != 12 or len(two) != 12:
+        raise RuntimeError(f"could not select D24: one={len(one)} two={len(two)}")
+    return {"one_box": one, "two_box": two}
+
+
+if __name__ == "__main__":
+    import sys
+    m, a = build(sys.argv[1] if len(sys.argv) > 1 else "results/iter_030/source_manifest.json",
+                 sys.argv[2] if len(sys.argv) > 2 else "results/iter_030/source_audit.json")
+    print("n_C", m["n_C"], "events_C", a["n_events_C"])
+    print("n_E", m["n_E"], "events_E", a["n_events_E"])
diff --git a/run_iter029_audit.py b/run_iter029_audit.py
new file mode 100644
index 0000000..fceb9f6
--- /dev/null
+++ b/run_iter029_audit.py
@@ -0,0 +1,187 @@
+"""iter_029 단계 1: iter_028 C/E raw 산출물을 read-only로 감사하고 provenance를 새 경로에 기록한다.
+
+과거 파일은 전혀 쓰지 않는다. 여기서 만드는 audit.json이 이번 교정 평가의 입력 완전성 근거다.
+"""
+import glob
+import hashlib
+import json
+import os
+
+from rsna_diag import risk28
+
+SRC_MANIFEST = "results/iter_028/source_manifest.json"
+PROTOCOL = "results/iter_028/protocol.json"
+OUT = "results/iter_029/audit"
+
+
+def sha256_file(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def check_protocol_locked_files():
+    proto = json.load(open(PROTOCOL))
+    problems = []
+    cur = {}
+    for path, want in proto["locked"]["files"].items():
+        if not os.path.exists(path):
+            problems.append(f"missing locked file: {path}")
+            continue
+        got = sha256_file(path)
+        cur[path] = got
+        if got != want:
+            problems.append(f"hash mismatch: {path} got={got} want={want}")
+    return {"n_locked": len(proto["locked"]["files"]), "problems": problems, "current_hashes": cur}
+
+
+def audit_split(sm, split):
+    """variant별 completion, 중복/누락/잉여, adapter/protocol/pixel 연결을 검사한다.
+
+    계획서 감사 대상: C는 실제로 전체 400명(빈+비빈)에 생성했고(400*5=2000),
+    주분석은 그중 빈 출력 199명(199*5=995)만 사용한다. E는 처음부터 빈 출력
+    398명에만 생성했다(398*5=1990, 여기에는 확장분이 없다). 두 split의 실제
+    생성 대상 모집단이 다르므로 completion 기대 행렬을 분리해서 검사한다.
+    """
+    all_items = list(sm["patients"][split].values())
+    empty_items = [p for p in all_items if p["seed17_empty"]]
+    out_dir = f"results/iter_028/{split}"
+    expect_items = all_items if split == "C" else empty_items
+    comp = risk28.check_completion(out_dir, expect_items, variants=("base", "sft"))
+    items = empty_items  # primary-analysis population used below
+
+    problems = list(comp["problems"])
+    # per-record cross-checks: adapter digest, protocol digest, pixel hash, duplicate across files
+    base_all = risk28.load_all(out_dir, "base")
+    sft_all = risk28.load_all(out_dir, "sft")
+
+    proto = json.load(open(PROTOCOL))
+    proto_digest_expect = None  # recorded protocol_digest in records; just check internal consistency
+    seen_protocol_digests = set()
+    for (pid, task), r in list(base_all.items()) + list(sft_all.items()):
+        seen_protocol_digests.add(r.get("protocol_digest"))
+        if r.get("adapter_digest") is not None and task in ("presence", "ptrue") and r["variant"] == "base":
+            problems.append(f"base record has non-null adapter_digest: {pid}/{task}")
+    if len(seen_protocol_digests) != 1:
+        problems.append(f"multiple distinct protocol_digest values in {split}: {seen_protocol_digests}")
+
+    adapter_digest_seed17 = sm["adapter_digest_seed17"]
+    for (pid, task), r in sft_all.items():
+        if r.get("adapter_digest") != adapter_digest_seed17:
+            problems.append(f"sft record adapter_digest mismatch: {pid}/{task}")
+
+    # exact expected request matrix from source+protocol (not from observed results); primary analysis
+    # population is always the empty-output patients, but C's actual generation covered all 400.
+    expect_base = {(p["id"], t) for p in expect_items for t in risk28.expected_tasks("base")}
+    expect_sft = {(p["id"], t) for p in expect_items for t in risk28.expected_tasks("sft")}
+    got_base = set(base_all)
+    got_sft = set(sft_all)
+    if got_base != expect_base:
+        problems.append(f"base matrix mismatch: missing={len(expect_base-got_base)} extra={len(got_base-expect_base)}")
+    if got_sft != expect_sft:
+        problems.append(f"sft matrix mismatch: missing={len(expect_sft-got_sft)} extra={len(got_sft-expect_sft)}")
+    n_primary_base = {(p["id"], t) for p in items for t in risk28.expected_tasks("base")}
+    n_primary_sft = {(p["id"], t) for p in items for t in risk28.expected_tasks("sft")}
+    if not (n_primary_base <= got_base and n_primary_sft <= got_sft):
+        problems.append("primary-analysis (empty-output) requests are not a subset of generated records")
+
+    return {
+        "split": split, "n_empty": len(items), "n_events": sum(1 for p in items if p["y_miss"]),
+        "n_base_records": len(base_all), "n_sft_records": len(sft_all),
+        "problems": problems, "protocol_digests_seen": sorted(str(d) for d in seen_protocol_digests),
+        "completion": comp,
+    }
+
+
+def check_pixel_hashes(sm, split):
+    """images의 현재 file/pixel hash를 manifest 저장값과 대조한다 (GPU 로드 없이 파일 hash만)."""
+    items = sm["patients"][split]
+    problems = []
+    n = 0
+    for pid, p in items.items():
+        path = p["image"]
+        if not os.path.exists(path):
+            problems.append(f"missing image file: {pid} {path}")
+            continue
+        file_sha = sha256_file(path)
+        if file_sha != p["file_sha256"]:
+            problems.append(f"file hash mismatch: {pid} got={file_sha} want={p['file_sha256']}")
+        n += 1
+    return {"split": split, "n_checked": n, "problems": problems}
+
+
+def protocol_digest_reconciliation():
+    """C와 E는 서로 다른 protocol_digest로 생성됐다(claude_stream.jsonl 라인 668/706/712에서 복원).
+    C 생성 완료 후 risk28.py main()의 분기가 'C/E 요청 전체(400/800명)'를 채점하던 버그를
+    '빈 출력만 채점'하도록 한 줄 수정했고, 그 직후 protocol을 재잠금해 E를 생성했다.
+    이 수정은 빈 출력 199/398명 각자의 score_token_original/score_yes_no 계산 경로를
+    바꾸지 않는다(호출 인자·prompt·max_new가 patient 단위로 동일하다). 따라서 두 protocol_digest
+    차이는 주분석 대상 population에 영향을 주지 않는 것으로 문서화하되, 과거 protocol.json bytes
+    자체(교체 전 버전)는 현재 파일로 복원할 수 없어 완전한 재실행 검증은 아니다."""
+    return {
+        "explanation": "C empty-199 records were generated before a one-line risk28.py fix "
+                       "(main(): item filter 'all patients' -> 'seed17_empty only') that only "
+                       "removes surplus nonempty-patient requests from being scored; it does not "
+                       "change how any individual patient (empty or not) is scored. E was generated "
+                       "after this fix and after re-locking protocol.json.",
+        "recovered_from": "agent/runs/iter_028/claude_stream.jsonl lines 668 (C launch), 701 (bug "
+                           "note), 706 (Edit diff), 712 (protocol re-lock), 748 (E launch)",
+        "edit_old": "items = list(sm[\"patients\"][a.split].values())",
+        "edit_new": "items = [p for p in sm[\"patients\"][a.split].values() if p[\"seed17_empty\"]]",
+        "affects_primary_empty_population_scoring": False,
+        "caveat": "past protocol.json bytes at C-generation-time are not independently recoverable; "
+                  "this is a documented code-diff reconciliation, not a byte-level replay.",
+    }
+
+
+def main():
+    os.makedirs(OUT, exist_ok=True)
+    sm = json.load(open(SRC_MANIFEST))
+
+    proto_check = check_protocol_locked_files()
+
+    sm_hash = sha256_file(SRC_MANIFEST)
+    proto = json.load(open(PROTOCOL))
+    sm_locked = proto["locked"]["files"].get(SRC_MANIFEST)
+
+    problems_all = list(proto_check["problems"])
+    if sm_locked is not None and sm_hash != sm_locked:
+        problems_all.append(f"source_manifest hash changed since protocol lock: {sm_hash} != {sm_locked}")
+
+    splits_report = {}
+    for split in ("C", "E"):
+        r = audit_split(sm, split)
+        px = check_pixel_hashes(sm, split)
+        r["pixel_audit"] = px
+        problems_all += [f"{split}: {p}" for p in r["problems"]]
+        problems_all += [f"{split}: {p}" for p in px["problems"]]
+        splits_report[split] = r
+
+    # cross-split patient/pixel-hash overlap check
+    c_ids = set(sm["patients"]["C"])
+    e_ids = set(sm["patients"]["E"])
+    overlap = c_ids & e_ids
+    if overlap:
+        problems_all.append(f"patient id overlap between C and E: {len(overlap)}")
+    c_px = {p["file_sha256"] for p in sm["patients"]["C"].values()}
+    e_px = {p["file_sha256"] for p in sm["patients"]["E"].values()}
+    px_overlap = c_px & e_px
+    if px_overlap:
+        problems_all.append(f"pixel hash overlap between C and E: {len(px_overlap)}")
+
+    out = {
+        "protocol_check": proto_check,
+        "protocol_digest_reconciliation": protocol_digest_reconciliation(),
+        "source_manifest_hash": sm_hash, "source_manifest_locked_hash": sm_locked,
+        "splits": splits_report,
+        "patient_id_overlap_C_E": len(overlap),
+        "pixel_hash_overlap_C_E": len(px_overlap),
+        "n_problems": len(problems_all), "problems": problems_all,
+        "ok": len(problems_all) == 0,
+    }
+    json.dump(out, open(os.path.join(OUT, "audit.json"), "w"), indent=1)
+    print(f"ok={out['ok']} n_problems={len(problems_all)}")
+    for p in problems_all:
+        print(" -", p)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/run_iter029_decide.py b/run_iter029_decide.py
new file mode 100644
index 0000000..874cf2a
--- /dev/null
+++ b/run_iter029_decide.py
@@ -0,0 +1,89 @@
+"""iter_029 계획의 Evaluation 기준으로 E 결과를 기계 판독 decision으로 정리한다.
+
+기준(plan.md Evaluation 절 그대로):
+- 단순 baseline 양성: E에서 고정 score가 AUROC>=0.75, 95% CI 하한>=0.65, Capture@20%>=0.50.
+  token 또는 seed로 충족하면 confidence head/loss는 보류.
+- 재질의 추가 정보 양성: C 선택 V-T AUROC 차이>=0.10, 97.5% CI 하한>0, Capture@20%도 같은 방향.
+- 음성: 모든 score의 95% CI 상한이 실용 목표 미달.
+- 불확정: CI가 기준을 가로지름.
+"""
+import json
+import os
+
+OUT = "results/iter_029/decide"
+
+
+def main():
+    e = json.load(open("results/iter_029/E_eval/e_eval.json"))
+    c = json.load(open("results/iter_029/C_eval/c_eval.json"))
+    verify = json.load(open(os.path.join(OUT, "independent_verify.json")))
+    if not verify["ok"]:
+        raise RuntimeError("independent verification failed; refusing to render a decision")
+
+    rep_T, rep_V = e["representative_T"], e["representative_V"]
+
+    simple_baseline_positive = {}
+    for name in e["raw_auroc"]:
+        if name == "random":
+            continue
+        auc = e["cis"][name]["auroc"]
+        cap = e["cis"][name]["capture20"]
+        pos = auc["point"] >= 0.75 and auc["lo"] >= 0.65 and cap["point"] >= 0.50
+        simple_baseline_positive[name] = {
+            "positive": pos, "auroc_point": auc["point"], "auroc_ci_lo": auc["lo"],
+            "capture20_point": cap["point"],
+        }
+    token_or_seed_positive = simple_baseline_positive["entropy"]["positive"] or \
+        simple_baseline_positive["token_nll"]["positive"] or \
+        simple_baseline_positive["seed_disagreement"]["positive"]
+
+    diff_VT_C = c["diff_V_minus_T_auroc"]
+    v_minus_t_auroc_diff = e["raw_auroc"][rep_V] - e["raw_auroc"][rep_T]
+    v_cap = e["capture_at_20pct"][rep_V]
+    t_cap = e["capture_at_20pct"][rep_T]
+    requery_positive = (diff_VT_C["point"] >= 0.10 and diff_VT_C["lo"] > 0.0 and v_cap > t_cap)
+
+    all_ci_upper_below_target = all(
+        (e["cis"][name]["auroc"]["hi"] < 0.75) and (e["cis"][name]["capture20"]["hi"] < 0.50)
+        for name in e["raw_auroc"] if name != "random"
+    )
+
+    any_ci_straddles = any(
+        (e["cis"][name]["auroc"]["lo"] < 0.75 < e["cis"][name]["auroc"]["hi"])
+        for name in e["raw_auroc"] if name != "random"
+    )
+
+    if token_or_seed_positive:
+        overall = "simple_baseline_positive_new_confidence_head_deferred"
+    elif all_ci_upper_below_target:
+        overall = "negative_limited_to_current_score_set"
+    elif any_ci_straddles:
+        overall = "inconclusive_ci_straddles_target"
+    else:
+        overall = "mixed"
+
+    decision = {
+        "representative_T": rep_T, "representative_V": rep_V,
+        "simple_baseline_positive_per_score": simple_baseline_positive,
+        "token_or_seed_meets_simple_baseline_positive": token_or_seed_positive,
+        "requery_additional_info_positive": {
+            "positive": requery_positive,
+            "C_diff_V_minus_T_point": diff_VT_C["point"], "C_diff_V_minus_T_ci_lo_975": diff_VT_C["lo"],
+            "E_diff_V_minus_T_point": v_minus_t_auroc_diff,
+            "E_capture20_V": v_cap, "E_capture20_T": t_cap,
+        },
+        "overall": overall,
+        "notes": [
+            "token_or_seed_positive=True는 entropy/token_nll/seed_disagreement 중 하나가 E에서 "
+            "사전 목표를 충족함을 뜻하며, 계획에 따라 새 confidence head/loss 투자는 보류 대상이다.",
+            "requery_positive=False는 presence_b0(교정된 V)가 C에서 사전 정한 추가 정보 이득 기준을 "
+            "충족하지 못했다는 뜻이다(diff_V-T point는 음수).",
+            "이 decision은 개발 자료(C/E)에서 나온 것이며 독립 확인(새 환자 집단)은 별도로 필요하다.",
+        ],
+    }
+    json.dump(decision, open(os.path.join(OUT, "decision.json"), "w"), indent=1, ensure_ascii=False)
+    print(json.dumps(decision, indent=1, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/run_iter029_eval_c.py b/run_iter029_eval_c.py
new file mode 100644
index 0000000..f51377c
--- /dev/null
+++ b/run_iter029_eval_c.py
@@ -0,0 +1,167 @@
+"""iter_029 C400(빈 출력 199명) 교정 평가.
+
+iter_028의 run_iter028_eval_c.py를 방향 오류만 고쳐 재사용한다. Presence는 logit_yes-logit_no
+(모델이 opacity가 있다고 답할수록 위험이 높다), P(True)는 logit_no-logit_yes(제안한 빈 응답이
+틀렸다는 답일수록 위험이 높다)이며, risk28.py가 저장한 값은 항상 risk_no_minus_yes(=logit_no-logit_yes)
+이므로 presence_*는 그 값을 부호 반전해서 사용해야 한다. 과거 run_iter028_eval_c.py는 둘 다
+risk_no_minus_yes를 그대로 썼다(presence 부호 오류). 원본 파일은 건드리지 않고 새 경로에만 쓴다.
+"""
+import json
+import os
+
+import numpy as np
+
+from rsna_diag import risk28, risk28_eval as E
+
+RESULTS_ROOT = "results/iter_028"  # read-only: C/E raw generations live here
+OUT = "results/iter_029/C_eval"
+
+SCORE_NAMES = ["token_nll", "token_nll_eos", "entropy", "seed_disagreement",
+               "presence_m0", "presence_b0", "ptrue_m0", "ptrue_b0"]
+TOKEN_FAMILY = ["token_nll", "token_nll_eos", "entropy"]
+IMAGE_FAMILY = ["presence_m0", "presence_b0", "ptrue_m0", "ptrue_b0"]
+
+
+def build_table(sm, split):
+    all_patients = list(sm["patients"][split].values())
+    patients = [p for p in all_patients if p["seed17_empty"]]
+
+    # completeness gate. C's actual generation covered all 400 patients (a pre-fix run scored the
+    # full split before risk28.py was restricted to empty-only; see run_iter029_audit.py's
+    # protocol_digest_reconciliation for the recovered code-diff). E only ever generated the empty
+    # subset. So we check completeness against the *actual* generation population (all patients for
+    # C, empty-only for E) to catch real missing/duplicate/extra problems without false-flagging the
+    # known, documented C surplus; then separately assert the primary (empty) population is a strict
+    # subset with no missing/duplicate entries.
+    expect_population = all_patients if split == "C" else patients
+    comp = risk28.check_completion(f"{RESULTS_ROOT}/{split}", expect_population, variants=("base", "sft"))
+    if not comp["ok"]:
+        raise RuntimeError(f"{split}: completion check against actual generation population failed: "
+                            f"{comp['problems']}")
+
+    expected_n_empty = {"C": 199, "E": 398}.get(split)
+    if expected_n_empty is not None and len(patients) != expected_n_empty:
+        raise RuntimeError(f"{split}: expected {expected_n_empty} empty-output patients, got {len(patients)}")
+
+    sft = risk28.load_all(f"{RESULTS_ROOT}/{split}", "sft")
+    base = risk28.load_all(f"{RESULTS_ROOT}/{split}", "base")
+    rows = []
+    for p in patients:
+        pid = p["id"]
+        ts = sft[(pid, "token_score")]
+        pres_b = sft[(pid, "presence")]
+        ptrue_b = sft[(pid, "ptrue")]
+        pres_m = base[(pid, "presence")]
+        ptrue_m = base[(pid, "ptrue")]
+        seed_dis = ((not p["seed29_empty"]) + (not p["seed43_empty"])) / 2.0
+        rows.append({
+            "id": pid, "y": int(p["y_miss"]), "category": p["category"],
+            "token_nll": ts["nll_bracket"], "token_nll_eos": (ts["nll_bracket"] + ts["nll_eos_step1"]) / 2.0,
+            "entropy": ts["entropy_bracket"], "seed_disagreement": seed_dis,
+            # Presence risk = logit_yes - logit_no = -(logit_no - logit_yes) = -risk_no_minus_yes
+            "presence_m0": -pres_m["risk_no_minus_yes"], "presence_b0": -pres_b["risk_no_minus_yes"],
+            # P(True) risk = logit_no - logit_yes = risk_no_minus_yes (already correct direction)
+            "ptrue_m0": ptrue_m["risk_no_minus_yes"], "ptrue_b0": ptrue_b["risk_no_minus_yes"],
+        })
+    return rows
+
+
+def main():
+    if os.path.exists(os.path.join(OUT, "c_eval.json")):
+        raise RuntimeError(f"refusing to overwrite existing {OUT}/c_eval.json")
+    os.makedirs(OUT, exist_ok=True)
+    sm = json.load(open(f"{RESULTS_ROOT}/source_manifest.json"))
+    rows = build_table(sm, "C")
+    y = [r["y"] for r in rows]
+    n = len(rows)
+    rng = np.random.default_rng(28017)
+    random_score = rng.uniform(size=n).tolist()
+
+    raw_auroc = {}
+    for name in SCORE_NAMES:
+        s = [r[name] for r in rows]
+        raw_auroc[name] = E.auroc(s, y)
+    raw_auroc["random"] = E.auroc(random_score, y)
+
+    rep_T = max(TOKEN_FAMILY, key=lambda k: raw_auroc[k])
+    rep_V = max(IMAGE_FAMILY, key=lambda k: raw_auroc[k])
+
+    calibrations = {}
+    for name in SCORE_NAMES:
+        s = np.array([r[name] for r in rows])
+        calibrations[name] = E.fit_platt(s, y)
+
+    capture20 = {name: E.capture_at_k([r[name] for r in rows], y, 0.2) for name in SCORE_NAMES}
+    capture20["random"] = E.capture_at_k(random_score, y, 0.2)
+
+    def ci_for(name):
+        s = np.array([r[name] for r in rows])
+        yy = np.array(y)
+
+        def auc_fn(idx):
+            return E.auroc(s[idx], yy[idx])
+
+        def cap_fn(idx):
+            return E.capture_at_k(s[idx], yy[idx], 0.2)
+        return {"auroc": E.metric_ci(auc_fn, n, B=10000, seed=28017, alpha_lo=2.5, alpha_hi=97.5),
+                "capture20": E.metric_ci(cap_fn, n, B=10000, seed=28017, alpha_lo=2.5, alpha_hi=97.5)}
+
+    cis = {name: ci_for(name) for name in SCORE_NAMES}
+
+    s_T = np.array([r[rep_T] for r in rows])
+    s_V = np.array([r[rep_V] for r in rows])
+    s_seed = np.array([r["seed_disagreement"] for r in rows])
+    yy = np.array(y)
+
+    def auc_T(idx):
+        return E.auroc(s_T[idx], yy[idx])
+
+    def auc_V(idx):
+        return E.auroc(s_V[idx], yy[idx])
+
+    def auc_seed(idx):
+        return E.auroc(s_seed[idx], yy[idx])
+
+    diff_VT = E.paired_diff_ci(auc_V, auc_T, n, B=10000, seed=28017, alpha_lo=2.5, alpha_hi=97.5)
+    diff_Vseed = E.paired_diff_ci(auc_V, auc_seed, n, B=10000, seed=28017, alpha_lo=2.5, alpha_hi=97.5)
+
+    enter_E = False
+    reasons = []
+    for name in SCORE_NAMES:
+        if cis[name]["auroc"]["hi"] >= 0.75:
+            enter_E = True
+            reasons.append(f"{name}: AUROC CI upper {cis[name]['auroc']['hi']:.3f} >= 0.75")
+        if cis[name]["capture20"]["hi"] >= 0.50:
+            enter_E = True
+            reasons.append(f"{name}: Capture@20 CI upper {cis[name]['capture20']['hi']:.3f} >= 0.50")
+    if diff_VT["lo"] <= 0.10 <= diff_VT["hi"] and (diff_VT["hi"] - diff_VT["lo"]) > 0.10:
+        enter_E = True
+        reasons.append(f"V-T AUROC diff CI [{diff_VT['lo']:.3f},{diff_VT['hi']:.3f}] contains 0.10 and width>0.10")
+    if diff_Vseed["lo"] <= 0.10 <= diff_Vseed["hi"] and (diff_Vseed["hi"] - diff_Vseed["lo"]) > 0.10:
+        enter_E = True
+        reasons.append(f"V-seed AUROC diff CI [{diff_Vseed['lo']:.3f},{diff_Vseed['hi']:.3f}] contains 0.10 and width>0.10")
+
+    out = {
+        "n": n, "n_events": int(sum(y)), "representative_T": rep_T, "representative_V": rep_V,
+        "raw_auroc": raw_auroc, "capture_at_20pct": capture20, "cis": cis,
+        "diff_V_minus_T_auroc": diff_VT, "diff_V_minus_seed_auroc": diff_Vseed,
+        "enter_E": enter_E, "reasons": reasons,
+        "calibrations": calibrations,
+        "sign_convention": "presence = logit_yes-logit_no (= -risk_no_minus_yes); "
+                            "ptrue = logit_no-logit_yes (= risk_no_minus_yes, unchanged from iter_028)",
+        "corrects": "iter_028's run_iter028_eval_c.py which used risk_no_minus_yes for presence too",
+    }
+    json.dump(out, open(os.path.join(OUT, "c_eval.json"), "w"), indent=1)
+    json.dump(rows, open(os.path.join(OUT, "c_table.json"), "w"), indent=1)
+    print(f"n={n} n_events={sum(y)} rep_T={rep_T} rep_V={rep_V}")
+    print("raw_auroc:", json.dumps(raw_auroc, indent=1))
+    print("capture20:", json.dumps(capture20, indent=1))
+    print("diff_V-T:", diff_VT)
+    print("diff_V-seed:", diff_Vseed)
+    print("enter_E:", enter_E)
+    for r in reasons:
+        print(" -", r)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/run_iter029_eval_e.py b/run_iter029_eval_e.py
new file mode 100644
index 0000000..fd65264
--- /dev/null
+++ b/run_iter029_eval_e.py
@@ -0,0 +1,100 @@
+"""iter_029 E800(빈 출력 398명) 확인 평가. C에서 고정한 대표 T/V·calibration을 그대로 적용, 재선택하지 않는다.
+
+iter_028의 run_iter028_eval_e.py를 그대로 따르되 build_table을 이번 교정본(run_iter029_eval_c)에서
+가져온다. C_eval/c_eval.json이 먼저 존재해야 한다(단계 2가 단계 3보다 먼저 실행돼야 함을 강제).
+"""
+import json
+import os
+
+import numpy as np
+
+from rsna_diag import risk28_eval as Ev
+from run_iter029_eval_c import build_table, SCORE_NAMES, RESULTS_ROOT
+
+OUT = "results/iter_029/E_eval"
+C_EVAL_PATH = "results/iter_029/C_eval/c_eval.json"
+
+
+def main():
+    if not os.path.exists(C_EVAL_PATH):
+        raise RuntimeError(f"missing {C_EVAL_PATH}: run run_iter029_eval_c.py first (C selects rep_T/rep_V/calibration)")
+    if os.path.exists(os.path.join(OUT, "e_eval.json")):
+        raise RuntimeError(f"refusing to overwrite existing {OUT}/e_eval.json")
+    os.makedirs(OUT, exist_ok=True)
+    sm = json.load(open(f"{RESULTS_ROOT}/source_manifest.json"))
+    c_eval = json.load(open(C_EVAL_PATH))
+    rep_T, rep_V = c_eval["representative_T"], c_eval["representative_V"]
+    calibrations = c_eval["calibrations"]
+
+    rows = build_table(sm, "E")
+    y = [r["y"] for r in rows]
+    n = len(rows)
+    print(f"E: n={n} n_events={sum(y)}")
+
+    raw_auroc = {name: Ev.auroc([r[name] for r in rows], y) for name in SCORE_NAMES}
+    capture20 = {name: Ev.capture_at_k([r[name] for r in rows], y, 0.2) for name in SCORE_NAMES}
+    remain20 = {name: Ev.remaining_after_review([r[name] for r in rows], y, 0.2) for name in SCORE_NAMES}
+
+    def ci_for(name):
+        s = np.array([r[name] for r in rows])
+        yy = np.array(y)
+
+        def auc_fn(idx):
+            return Ev.auroc(s[idx], yy[idx])
+
+        def cap_fn(idx):
+            return Ev.capture_at_k(s[idx], yy[idx], 0.2)
+        return {"auroc": Ev.metric_ci(auc_fn, n, B=10000, seed=28017),
+                "capture20": Ev.metric_ci(cap_fn, n, B=10000, seed=28017)}
+
+    cis = {name: ci_for(name) for name in SCORE_NAMES}
+
+    s_T = np.array([r[rep_T] for r in rows])
+    s_V = np.array([r[rep_V] for r in rows])
+    s_seed = np.array([r["seed_disagreement"] for r in rows])
+    yy = np.array(y)
+
+    def auc_T(idx):
+        return Ev.auroc(s_T[idx], yy[idx])
+
+    def auc_V(idx):
+        return Ev.auroc(s_V[idx], yy[idx])
+
+    def auc_seed(idx):
+        return Ev.auroc(s_seed[idx], yy[idx])
+
+    diff_VT = Ev.paired_diff_ci(auc_V, auc_T, n, B=10000, seed=28017, alpha_lo=1.25, alpha_hi=98.75)
+    diff_Vseed = Ev.paired_diff_ci(auc_V, auc_seed, n, B=10000, seed=28017, alpha_lo=1.25, alpha_hi=98.75)
+
+    calib_metrics = {}
+    for name in SCORE_NAMES:
+        s = np.array([r[name] for r in rows])
+        probs = Ev.apply_platt(calibrations[name], s)
+        calib_metrics[name] = {"brier": Ev.brier(probs, y), "ece": Ev.ece(probs, y)}
+
+    by_cat = {}
+    for cat in ("opacity", "normal", "not_normal_no_opacity"):
+        sub = [r for r in rows if r["category"] == cat]
+        by_cat[cat] = {"n": len(sub), "n_events": sum(r["y"] for r in sub)}
+
+    n_common3 = sum(1 for r in rows if r["seed_disagreement"] == 0.0)
+
+    single_class_subgroups = [cat for cat, d in by_cat.items() if d["n_events"] == 0 or d["n_events"] == d["n"]]
+
+    out = {
+        "n": n, "n_events": int(sum(y)), "representative_T": rep_T, "representative_V": rep_V,
+        "raw_auroc": raw_auroc, "capture_at_20pct": capture20, "remaining_after_review": remain20,
+        "cis": cis, "diff_V_minus_T_auroc_975": diff_VT, "diff_V_minus_seed_auroc_975": diff_Vseed,
+        "calibration_metrics": calib_metrics, "by_category": by_cat,
+        "n_common_empty_3seeds": n_common3,
+        "single_class_subgroups_auroc_undefined": single_class_subgroups,
+        "sign_convention": "same as C_eval (presence corrected, ptrue unchanged from iter_028)",
+        "corrects": "iter_028's run_iter028_eval_e.py which inherited the presence sign error via build_table",
+    }
+    json.dump(out, open(os.path.join(OUT, "e_eval.json"), "w"), indent=1)
+    json.dump(rows, open(os.path.join(OUT, "e_table.json"), "w"), indent=1)
+    print(json.dumps(out, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/run_iter029_verify.py b/run_iter029_verify.py
new file mode 100644
index 0000000..78b09fe
--- /dev/null
+++ b/run_iter029_verify.py
@@ -0,0 +1,151 @@
+"""iter_029 독립 검증: c_table/e_table 파생 표에 의존하지 않고 원시 JSONL과 GT/source에서
+방향·rank AUROC·동점 포착률·대표 선택을 별도로 계산해 저장 결과와 대조한다.
+"""
+import json
+import math
+import os
+
+import numpy as np
+
+from rsna_diag import risk28
+
+RESULTS_ROOT = "results/iter_028"
+OUT = "results/iter_029/decide"
+
+
+def rank_auroc(scores, y):
+    """Mann-Whitney rank 기반 AUROC (동점은 평균 순위)."""
+    s = np.asarray(scores, float)
+    yy = np.asarray(y, int)
+    order = np.argsort(s)
+    ranks = np.empty(len(s))
+    sv = s[order]
+    i = 0
+    while i < len(sv):
+        j = i
+        while j + 1 < len(sv) and sv[j + 1] == sv[i]:
+            j += 1
+        avg = (i + 1 + j + 1) / 2.0
+        ranks[order[i:j + 1]] = avg
+        i = j + 1
+    n_pos, n_neg = int(yy.sum()), int(len(yy) - yy.sum())
+    if n_pos == 0 or n_neg == 0:
+        return float("nan")
+    r_pos = ranks[yy == 1].sum()
+    return float((r_pos - n_pos * (n_pos + 1) / 2.0) / (n_pos * n_neg))
+
+
+def capture_at_k_tiebreak_expected(scores, y, frac=0.2):
+    """rsna_diag.risk28_eval.capture_at_k와 동일한 경계 동점 기대값 처리를 독립 구현한다."""
+    s = np.asarray(scores, float)
+    yy = np.asarray(y, int)
+    n = len(s)
+    k = int(round(n * frac))
+    if k <= 0 or yy.sum() == 0:
+        return 0.0
+    order = np.argsort(-s, kind="stable")
+    thresh = s[order[k - 1]]
+    above = s > thresh
+    tie = s == thresh
+    n_take_from_tie = k - int(above.sum())
+    captured = float(yy[above].sum())
+    if n_take_from_tie > 0 and tie.sum() > 0:
+        captured += n_take_from_tie * (yy[tie].sum() / tie.sum())
+    return float(captured / yy.sum())
+
+
+def build_rows_independent(sm, split):
+    """run_iter029_eval_c.build_table과 별도로, raw JSONL을 직접 읽어 부호를 적용한다."""
+    all_patients = list(sm["patients"][split].values())
+    patients = [p for p in all_patients if p["seed17_empty"]]
+    sft = risk28.load_all(f"{RESULTS_ROOT}/{split}", "sft")
+    base = risk28.load_all(f"{RESULTS_ROOT}/{split}", "base")
+    rows = []
+    for p in patients:
+        pid = p["id"]
+        ts = sft[(pid, "token_score")]
+        pres_b, ptrue_b = sft[(pid, "presence")], sft[(pid, "ptrue")]
+        pres_m, ptrue_m = base[(pid, "presence")], base[(pid, "ptrue")]
+        # independent re-derivation straight from logit_yes/logit_no, not from stored risk_no_minus_yes
+        presence_m0 = pres_m["logit_yes"] - pres_m["logit_no"]
+        presence_b0 = pres_b["logit_yes"] - pres_b["logit_no"]
+        ptrue_m0 = ptrue_m["logit_no"] - ptrue_m["logit_yes"]
+        ptrue_b0 = ptrue_b["logit_no"] - ptrue_b["logit_yes"]
+        seed_dis = ((not p["seed29_empty"]) + (not p["seed43_empty"])) / 2.0
+        rows.append({
+            "id": pid, "y": int(p["y_miss"]), "category": p["category"],
+            "token_nll": ts["nll_bracket"], "token_nll_eos": (ts["nll_bracket"] + ts["nll_eos_step1"]) / 2.0,
+            "entropy": ts["entropy_bracket"], "seed_disagreement": seed_dis,
+            "presence_m0": presence_m0, "presence_b0": presence_b0,
+            "ptrue_m0": ptrue_m0, "ptrue_b0": ptrue_b0,
+        })
+    return rows
+
+
+SCORE_NAMES = ["token_nll", "token_nll_eos", "entropy", "seed_disagreement",
+               "presence_m0", "presence_b0", "ptrue_m0", "ptrue_b0"]
+TOKEN_FAMILY = ["token_nll", "token_nll_eos", "entropy"]
+IMAGE_FAMILY = ["presence_m0", "presence_b0", "ptrue_m0", "ptrue_b0"]
+
+
+def main():
+    os.makedirs(OUT, exist_ok=True)
+    sm = json.load(open(f"{RESULTS_ROOT}/source_manifest.json"))
+    c_eval = json.load(open("results/iter_029/C_eval/c_eval.json"))
+    e_eval = json.load(open("results/iter_029/E_eval/e_eval.json"))
+    c_table_saved = json.load(open("results/iter_029/C_eval/c_table.json"))
+    e_table_saved = json.load(open("results/iter_029/E_eval/e_table.json"))
+
+    problems = []
+    report = {}
+    for split, saved_eval, saved_table in (("C", c_eval, c_table_saved), ("E", e_eval, e_table_saved)):
+        rows = build_rows_independent(sm, split)
+        y = [r["y"] for r in rows]
+        n = len(rows)
+
+        # cross-check independent rows against saved table (id-aligned, same values)
+        saved_by_id = {r["id"]: r for r in saved_table}
+        if set(saved_by_id) != {r["id"] for r in rows}:
+            problems.append(f"{split}: independent id set != saved table id set")
+        max_abs_diff = {}
+        for name in SCORE_NAMES:
+            diffs = [abs(r[name] - saved_by_id[r["id"]][name]) for r in rows]
+            max_abs_diff[name] = max(diffs)
+            if max_abs_diff[name] > 1e-9:
+                problems.append(f"{split}/{name}: independent vs saved max abs diff {max_abs_diff[name]}")
+
+        raw_auroc_indep = {name: rank_auroc([r[name] for r in rows], y) for name in SCORE_NAMES}
+        capture20_indep = {name: capture_at_k_tiebreak_expected([r[name] for r in rows], y) for name in SCORE_NAMES}
+        for name in SCORE_NAMES:
+            d = abs(raw_auroc_indep[name] - saved_eval["raw_auroc"][name])
+            if d > 1e-9:
+                problems.append(f"{split}/{name}: independent AUROC {raw_auroc_indep[name]} vs saved "
+                                 f"{saved_eval['raw_auroc'][name]} diff {d}")
+            dc = abs(capture20_indep[name] - saved_eval["capture_at_20pct"][name])
+            if dc > 1e-9:
+                problems.append(f"{split}/{name}: independent capture20 {capture20_indep[name]} vs saved "
+                                 f"{saved_eval['capture_at_20pct'][name]} diff {dc}")
+
+        rep_T_indep = max(TOKEN_FAMILY, key=lambda k: raw_auroc_indep[k])
+        rep_V_indep = max(IMAGE_FAMILY, key=lambda k: raw_auroc_indep[k])
+        if split == "C":
+            if rep_T_indep != saved_eval["representative_T"] or rep_V_indep != saved_eval["representative_V"]:
+                problems.append(f"C: independent representative selection ({rep_T_indep},{rep_V_indep}) != "
+                                 f"saved ({saved_eval['representative_T']},{saved_eval['representative_V']})")
+
+        report[split] = {
+            "n": n, "n_events": int(sum(y)),
+            "raw_auroc_independent": raw_auroc_indep, "capture20_independent": capture20_indep,
+            "max_abs_diff_vs_saved_table": max_abs_diff,
+            "representative_T_independent": rep_T_indep, "representative_V_independent": rep_V_indep,
+        }
+
+    out = {"ok": len(problems) == 0, "problems": problems, "per_split": report}
+    json.dump(out, open(os.path.join(OUT, "independent_verify.json"), "w"), indent=1)
+    print(f"ok={out['ok']} n_problems={len(problems)}")
+    for p in problems:
+        print(" -", p)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/run_iter030_correction029.py b/run_iter030_correction029.py
new file mode 100644
index 0000000..00f0219
--- /dev/null
+++ b/run_iter030_correction029.py
@@ -0,0 +1,120 @@
+"""iter_030 task 2: iter_029 decide의 결함을 새 경로에서만 교정한다 (원본 iter_029 파일/결과는 건드리지 않는다).
+
+수정 대상 결함 (reuse manifest에 적힌 필요 검증):
+1. run_iter029_decide.py의 requery_positive가 C의 95% CI(diff_V_minus_T_auroc, alpha 2.5/97.5)를 쓰면서
+   E의 97.5% paired CI(diff_V_minus_T_auroc_975, alpha 1.25/98.75)를 쓴다는 계획 문구와 어긋난다.
+   -> E의 diff_V_minus_T_auroc_975를 결정 기준에 사용한다.
+2. token_or_seed_positive가 TOKEN_FAMILY(token_nll, token_nll_eos, entropy) 중 token_nll_eos를 빼고
+   entropy/token_nll/seed_disagreement만 검사한다. -> token_nll_eos도 포함한다.
+3. E/C report·raw output·calibration·독립 검증 digest를 연결해 입력이 같은 실행에서 나왔는지 확인한다.
+4. 기존 경로 덮어쓰기 거부(이미 있으면 실패)를 유지한다.
+
+이 스크립트는 results/iter_029/*의 기존 산출물을 읽기 전용으로만 사용하고, 새 파일은
+results/iter_030/correction_029/에만 쓴다.
+"""
+import hashlib
+import json
+import os
+
+OUT = "results/iter_030/correction_029"
+E_EVAL_PATH = "results/iter_029/E_eval/e_eval.json"
+C_EVAL_PATH = "results/iter_029/C_eval/c_eval.json"
+VERIFY_PATH = "results/iter_029/decide/independent_verify.json"
+
+TOKEN_FAMILY = ["token_nll", "token_nll_eos", "entropy"]
+
+
+def sha256_file(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def decide(e, c, verify):
+    if not verify["ok"]:
+        raise RuntimeError("independent verification failed; refusing to render a corrected decision")
+
+    rep_T, rep_V = e["representative_T"], e["representative_V"]
+    if rep_T != c["representative_T"] or rep_V != c["representative_V"]:
+        raise RuntimeError(f"C/E representative mismatch: C={(c['representative_T'], c['representative_V'])} "
+                            f"E={(rep_T, rep_V)}")
+
+    simple_baseline_positive = {}
+    for name in e["raw_auroc"]:
+        if name == "random":
+            continue
+        auc = e["cis"][name]["auroc"]
+        cap = e["cis"][name]["capture20"]
+        pos = auc["point"] >= 0.75 and auc["lo"] >= 0.65 and cap["point"] >= 0.50
+        simple_baseline_positive[name] = {"positive": pos, "auroc_point": auc["point"], "auroc_ci_lo": auc["lo"],
+                                          "capture20_point": cap["point"]}
+    # 수정 1: 계획된 TOKEN_FAMILY 전체(token_nll_eos 포함)를 검사한다.
+    token_or_seed_positive = any(simple_baseline_positive[name]["positive"]
+                                 for name in TOKEN_FAMILY + ["seed_disagreement"])
+
+    # 수정 2: E의 97.5% paired CI(diff_V_minus_T_auroc_975)를 결정 기준으로 쓴다 (C의 95% CI가 아니다).
+    diff_VT_E975 = e["diff_V_minus_T_auroc_975"]
+    v_cap = e["capture_at_20pct"][rep_V]
+    t_cap = e["capture_at_20pct"][rep_T]
+    requery_positive = (diff_VT_E975["point"] >= 0.10 and diff_VT_E975["lo"] > 0.0 and v_cap > t_cap)
+
+    all_ci_upper_below_target = all(
+        (e["cis"][name]["auroc"]["hi"] < 0.75) and (e["cis"][name]["capture20"]["hi"] < 0.50)
+        for name in e["raw_auroc"] if name != "random"
+    )
+    any_ci_straddles = any(
+        (e["cis"][name]["auroc"]["lo"] < 0.75 < e["cis"][name]["auroc"]["hi"])
+        for name in e["raw_auroc"] if name != "random"
+    )
+
+    if token_or_seed_positive:
+        overall = "simple_baseline_positive_new_confidence_head_deferred"
+    elif all_ci_upper_below_target:
+        overall = "negative_limited_to_current_score_set"
+    elif any_ci_straddles:
+        overall = "inconclusive_ci_straddles_target"
+    else:
+        overall = "mixed"
+
+    return {
+        "representative_T": rep_T, "representative_V": rep_V,
+        "simple_baseline_positive_per_score": simple_baseline_positive,
+        "token_or_seed_meets_simple_baseline_positive": token_or_seed_positive,
+        "token_family_checked": TOKEN_FAMILY + ["seed_disagreement"],
+        "requery_additional_info_positive": {
+            "positive": requery_positive,
+            "E_diff_V_minus_T_975_point": diff_VT_E975["point"], "E_diff_V_minus_T_975_ci_lo": diff_VT_E975["lo"],
+            "E_capture20_V": v_cap, "E_capture20_T": t_cap,
+        },
+        "overall": overall,
+        "corrects": [
+            "run_iter029_decide.py used C's 95% CI (diff_V_minus_T_auroc) despite the plan requiring E's "
+            "97.5% paired CI (diff_V_minus_T_auroc_975) for the decision gate.",
+            "run_iter029_decide.py's token_or_seed_positive omitted token_nll_eos from TOKEN_FAMILY.",
+        ],
+        "note": "이 decision은 results/iter_029의 기존 GPU 출력·통계를 그대로 재사용하며 새 generation은 없다. "
+                "여전히 개발 자료(C/E)이며 독립 확인이 아니다.",
+    }
+
+
+def main():
+    out_decision = os.path.join(OUT, "decision.json")
+    if os.path.exists(out_decision):
+        raise RuntimeError(f"refusing to overwrite existing {out_decision}")
+    os.makedirs(OUT, exist_ok=True)
+
+    e = json.load(open(E_EVAL_PATH))
+    c = json.load(open(C_EVAL_PATH))
+    verify = json.load(open(VERIFY_PATH))
+
+    corrected = decide(e, c, verify)
+    provenance = {
+        "e_eval_sha256": sha256_file(E_EVAL_PATH), "c_eval_sha256": sha256_file(C_EVAL_PATH),
+        "independent_verify_sha256": sha256_file(VERIFY_PATH),
+        "e_eval_path": E_EVAL_PATH, "c_eval_path": C_EVAL_PATH, "verify_path": VERIFY_PATH,
+    }
+    out = {"decision": corrected, "input_provenance": provenance}
