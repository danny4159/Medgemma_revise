+            'prompts': [list(x) for x in prompts_for(system)], 'input_sha256': sha(st['inputs']), 'raw_sha256': sha(st['raw'])}
+
+
+def expected_ids(rows, system):
+    return {r['ImageID'] + '|' + system + '|' + n for r in rows for n, _ in prompts_for(system)}
+
