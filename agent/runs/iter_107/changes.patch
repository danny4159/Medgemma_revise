new file mode 100644
index 0000000..d0b6a95
--- /dev/null
+++ b/nr107_spec.py
@@ -0,0 +1,134 @@
+"""iter_107 고정 명세: 요청 구성(공식 CURE 단일 phrase grounding), 엄격 parser, 핵심 집단 규칙, 사건 정의.
+
+순수 함수만 둔다(모델·GPU 미사용). 정답(GT/extra)은 모델 요청에 들어가지 않는다.
+parser는 malformed bracket / 세 숫자 / nan·inf / 비양수 폭·높이 / 범위 밖 / 좌표 없는 prose를 구분한다. clipping으로 오류를 숨기지 않는다.
+"""
+import math
+import re
+
+import nr107_geom as G
+
+SYSTEM = "CURE"
+CORE_IOU_MATCH = 0.5
+COV_HIGH, COV_LOW = 0.5, 0.1
+GROUP_RE = re.compile(r"\[([^\[\]]*)\]")
+NUM_RE = re.compile(r"^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$|^[+-]?(?:nan|inf|infinity)$", re.I)
+
+
+def pg_prompt(sentence):
+    return f"Ground the phrase: {sentence}"
+
+
+def request_id(image_id, finding_index):
+    return f"{image_id}|{SYSTEM}|pg-f{finding_index}"
+
+
+def requests_for(items):
+    out = []
+    for it in items:
+        out.append({"id": request_id(it["ImageID"], it["finding_index"]), "ImageID": it["ImageID"], "system": SYSTEM, "kind": "pg",
+                    "modality": "image", "cond": "PG", "order": None, "item_key": it["item_key"], "prompt": pg_prompt(it["sentence"])})
+    assert len({q["id"] for q in out}) == len(out)
+    return out
+
+
+def parse_pg(text, ended_eos):
+    """returns dict(status, boxes(xyxy norm, 원본 좌표계), n_groups, n_bad). status:
+    truncated | no_box | malformed | coord_invalid | valid_nonempty.
+    부분 유효(일부 group만 유효)는 invalid로 처리하고 boxes=[] 로 둔다(valid_boxes는 별도 보존)."""
+    if not ended_eos:
+        return {"status": "truncated", "boxes": [], "valid_boxes": [], "n_groups": 0, "n_bad": 0}
+    groups = GROUP_RE.findall(text)
+    stripped = GROUP_RE.sub("", text)
+    unbalanced = "[" in stripped or "]" in stripped
+    boxes, bad_malformed, bad_coord = [], 0, 0
+    for g in groups:
+        parts = [p.strip() for p in g.split(",")]
+        if len(parts) != 4 or not all(NUM_RE.match(p) for p in parts):
+            bad_malformed += 1
+            continue
+        c = [float(p) for p in parts]
+        if not all(math.isfinite(v) for v in c):
+            bad_coord += 1
+            continue
+        if c[2] <= 0 or c[3] <= 0 or not all(0 <= v <= 1 for v in c):
+            bad_coord += 1
+            continue
+        xy = [c[0] - c[2] / 2, c[1] - c[3] / 2, c[0] + c[2] / 2, c[1] + c[3] / 2]
+        if xy[0] < 0 or xy[1] < 0 or xy[2] > 1 or xy[3] > 1:
+            bad_coord += 1
+            continue
+        boxes.append(xy)
+    n_bad = bad_malformed + bad_coord + (1 if unbalanced else 0)
+    if bad_malformed or unbalanced:
+        status = "malformed"
+    elif bad_coord:
+        status = "coord_invalid"
+    elif boxes:
+        status = "valid_nonempty"
+    else:
+        status = "no_box"
+    return {"status": status, "boxes": boxes if status == "valid_nonempty" else [], "valid_boxes": boxes, "n_groups": len(groups), "n_bad": n_bad}
+
+
+def core_status(gt, extra):
+    """핵심 집단 규칙: 공식·대체 주석이 각각 정확히 2 box, 집합 내부 서로 겹치지 않음, 두 집합 사이 일대일 대응 각 IoU>=0.5.
+    returns (is_core, pairing) — pairing[i] = extra box index matched to gt box i."""
+    if len(gt) != 2 or len(extra) != 2:
+        return False, None
+    if not (G.pairwise_disjoint(gt) and G.pairwise_disjoint(extra)):
+        return False, None
+    ok_id = G.iou(gt[0], extra[0]) >= CORE_IOU_MATCH and G.iou(gt[1], extra[1]) >= CORE_IOU_MATCH
+    ok_sw = G.iou(gt[0], extra[1]) >= CORE_IOU_MATCH and G.iou(gt[1], extra[0]) >= CORE_IOU_MATCH
+    if ok_id and ok_sw:  # 양쪽 대응이 모두 가능하면 IoU 합이 큰 쪽을 택한다(동률이면 핵심 제외 = 모호)
+        s_id = G.iou(gt[0], extra[0]) + G.iou(gt[1], extra[1])
+        s_sw = G.iou(gt[0], extra[1]) + G.iou(gt[1], extra[0])
+        if s_id == s_sw:
+            return False, None
+        return True, [0, 1] if s_id > s_sw else [1, 0]
+    if ok_id:
+        return True, [0, 1]
+    if ok_sw:
+        return True, [1, 0]
+    return False, None
+
+
+def cov_pair(pred, a, b):
+    return G.coverage(pred, a), G.coverage(pred, b)
+
+
+def classify_event(pred_boxes, gt, extra, pairing):
+    """핵심 소견의 '주석 일치 부분 누락' 판정. 근거 k = (gt[k], extra[pairing[k]]).
+    recovered(k): 두 주석 모두 coverage>=0.5 / missing(k): 두 주석 모두 coverage<=0.1.
+    한 근거 recovered & 다른 근거 missing -> 'partial_omission'. 둘 다 recovered -> 'both_retained', 둘 다 missing -> 'both_missing'.
+    그 외(0.1~0.5 사이 또는 주석별 방향 불일치) -> 'ambiguous'. 예측이 없거나 invalid면 coverage 0 이므로 both_missing."""
+    cov = []
+    for k in range(2):
+        cg = G.coverage(pred_boxes, gt[k])
+        ce = G.coverage(pred_boxes, extra[pairing[k]])
+        if cg >= COV_HIGH and ce >= COV_HIGH:
+            d = "recovered"
+        elif cg <= COV_LOW and ce <= COV_LOW:
+            d = "missing"
+        else:
+            d = "ambiguous"
+        cov.append({"cov_official": cg, "cov_alt": ce, "dir": d})
+    dirs = [c["dir"] for c in cov]
+    if "ambiguous" in dirs:
+        ev = "ambiguous"
+    elif dirs == ["recovered", "recovered"]:
+        ev = "both_retained"
+    elif dirs == ["missing", "missing"]:
+        ev = "both_missing"
+    else:
+        ev = "partial_omission"
+    return ev, cov
+
+
+def item_metrics(pred_boxes, gts):
+    """한 주석 집합(gts)에 대한 기술통계."""
+    covs = [G.coverage(pred_boxes, g) for g in gts]
+    mt, ng, npred = G.match_recall(pred_boxes, gts, 0.3)
+    return {"union_iou": G.union_iou(pred_boxes, gts), "cov": covs, "cov_min": min(covs), "cov_mean": sum(covs) / len(covs),
+            "all_cov_ge_0.5": all(c >= 0.5 for c in covs), "outside_frac": G.outside_fraction(pred_boxes, gts),
+            "match03": mt, "n_gt": ng, "n_pred": npred}
diff --git a/nr107_tech.py b/nr107_tech.py
new file mode 100644
index 0000000..2fa3aad
--- /dev/null
+++ b/nr107_tech.py
@@ -0,0 +1,115 @@
+"""iter_107 기술 확인(CPU 판정): T4 출력의 연결·재개 동등성·변조 거부·admission 실패 기록. 결과는 새 JSON으로만 저장한다."""
+import copy
+import json
+import shutil
+import sys
+from pathlib import Path
+
+import nr107_run as RUN
+import nr107_spec as S
+from report86_common import ROOT, sha, sha_obj, save, read_jsonl_complete, record_digest
+
+G = ROOT / "results/iter_107/gen"
+T = ROOT / "results/iter_107/tests"
+R = []
+
+
+def chk(name, cond, detail=None):
+    R.append({"name": name, "pass": bool(cond), "detail": detail})
+
+
+def recs_of(out, nshards):
+    d = {}
+    for k in range(nshards):
+        for r in read_jsonl_complete(Path(out) / "cure" / f"shard{k}" / "outputs.jsonl"):
+            assert r["id"] not in d
+            d[r["id"]] = r
+    return d
+
+
+def expect_fail(fn):
+    try:
+        fn()
+    except AssertionError as e:
+        return str(e)[:80]
+    return None
+
+
+def main():
+    sd2 = sha_obj(RUN.scientific_protocol("T4", 2))
+    sd1 = sha_obj(RUN.scientific_protocol("T4", 1))
+    w2 = recs_of(G / "T4_w2", 2)
+    rs = recs_of(G / "T4_resume", 1)
+    want = {q["id"] for q in RUN.requests("T4")}
+    chk("T4_w2 exact request set (4)", set(w2) == want and len(w2) == 4)
+    chk("T4_resume exact request set (4)", set(rs) == want)
+    for k in (0, 1):
+        RUN.verify_completion(G / "T4_w2" / "cure" / f"shard{k}", "T4", k, 2, sd2)
+    RUN.verify_completion(G / "T4_resume" / "cure" / "shard0", "T4", 0, 1, sd1)
+    chk("completion verify (w2 x2, resume x1)", True)
+    ev = [json.loads(l) for l in (G / "T4_resume/cure/shard0/executions.jsonl").read_text().splitlines()]
+    starts = [e for e in ev if e["event"] == "start"]
+    chk("resume: 2 executions, 2 then 2 todo", len(starts) == 2 and starts[0]["n_todo"] == 2 and starts[1]["n_done_before"] == 2, [(e["n_todo"], e["n_done_before"]) for e in starts])
+    same = all(w2[i]["attempts"][-1]["suffix_ids"] == rs[i]["attempts"][-1]["suffix_ids"] and w2[i]["input_ids"] == rs[i]["input_ids"]
+               and w2[i]["pixel_sha256"] == rs[i]["pixel_sha256"] for i in want)
+    chk("token+input+pixel identical: 2 workers vs interrupted-resumed 1 worker", same)
+    chk("all EOS, no cap retry", all(len(r["attempts"]) == 1 and r["attempts"][0]["ended_eos"] for r in w2.values()))
+    items = {it["item_key"]: it for it in RUN.all_items()}
+    for r in w2.values():
+        it = items[r["item_key"]]
+        assert r["prompt"] == "Ground the phrase: " + it["sentence"]
+        assert "gt" not in r["prompt"].lower()
+    chk("prompt == official 'Ground the phrase: {sentence}', no GT in prompt", True)
+    chk("raw image hash linked", all(r["image_sha256"] == RUN.raw_map()[r["ImageID"]]["sha256"] for r in w2.values()))
+    parsed = {i: S.parse_pg(r["text"], r["attempts"][-1]["ended_eos"]) for i, r in w2.items()}
+    chk("T4 parse statuses", all(p["status"] == "valid_nonempty" for p in parsed.values()), {i[-14:]: (p["status"], len(p["boxes"])) for i, p in parsed.items()})
+    peak = max(a["peak_mem_reserved_gb"] for r in w2.values() for a in r["attempts"])
+    chk("peak reserved GiB", True, peak)
+    ex = [json.loads(l) for k in (0, 1) for l in (G / "T4_w2/cure" / f"shard{k}" / "executions.jsonl").read_text().splitlines()]
+    chk("loading_s", True, [round(e["loading_s"], 1) for e in ex if e["event"] == "start"])
+
+    # 변조 거부 (사본 대상)
+    base = T / "mut_v2"
+    for name in ("drop_row", "dup_row", "text_edit", "prompt_edit_rehashed", "completion_hash", "control"):
+        dst = base / name
+        shutil.copytree(G / "T4_resume/cure/shard0", dst)
+        rows = read_jsonl_complete(dst / "outputs.jsonl")
+        if name == "drop_row":
+            rows = rows[:-1]
+        elif name == "dup_row":
+            rows = rows + [rows[0]]
+        elif name == "text_edit":
+            rows[0]["text"] += " x"
+        elif name == "prompt_edit_rehashed":
+            rows[0]["prompt"] += " x"
+            rows[0]["record_digest"] = record_digest(rows[0])
+        if name != "control":
+            with (dst / "outputs.jsonl").open("w") as f:
+                for r in rows:
+                    f.write(json.dumps(r, ensure_ascii=False) + "\n")
+        c = json.loads((dst / "completion.json").read_text())
+        if name == "completion_hash":
+            c["files"]["outputs.jsonl"] = "0" * 64
+        else:  # completion 을 재봉인해 변조가 더 깊은 검증 분기(요청 집합·record digest·prompt 대조)에서 걸리는지 본다
+            c["files"]["outputs.jsonl"] = sha(dst / "outputs.jsonl")
+        (dst / "completion.json").write_text(json.dumps(c))
+        res = expect_fail(lambda: RUN.verify_completion(dst, "T4", 0, 1, sd1))
+        if name == "control":
+            chk("mutation control accepted", res is None)
+        else:
+            chk("mutation rejected: " + name, res is not None, res)
+    # protocol 변경 거부: 다른 nshards digest
+    chk("wrong protocol digest rejected", expect_fail(lambda: RUN.verify_completion(G / "T4_resume/cure/shard0", "T4", 0, 1, sd2)) is not None)
+    # admission 실패 기록
+    la = json.loads(next((G / "T4_admission_refuse").glob("launch_*.json")).read_text())
+    chk("admission refusal recorded (status failed, memory admission refused, children terminated, no outputs)",
+        la["status"] == "failed" and "memory admission refused" in la["error"] and len(la["admission"]) == 2,
+        {"error": la["error"][:140], "wall_s": la["wall_s"]})
+    out = {"n": len(R), "n_pass": sum(r["pass"] for r in R), "all_pass": all(r["pass"] for r in R), "checks": R}
+    save(T / "tech_T4_v2.json", out)
+    print(out["n"], out["n_pass"], [r["name"] for r in R if not r["pass"]])
+    return 0 if out["all_pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
