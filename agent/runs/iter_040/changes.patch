+"""iter_040 단계 decision artifact 생성 (사전 규칙, 결과를 보고 규칙을 바꾸지 않는다). 기존 decision 파일은 덮어쓰지 않는다.
+
+  ext     : V48 epoch2/5 F1@0.3·V48 CE로 epoch8 연장 여부
+  select  : V48 평가된 (LR, epoch) 중 B 선택 (F1@0.3 -> F1@0.5 -> 낮은 invalid -> 이른 epoch)
+  bgate   : B의 V96 valid/truncation gate와 대조 적용 가능성
+  ratio   : 사전 측정한 M/C 학습 시간 비율 r -> C_compute update 수
+  cost    : M과 C_compute의 실제 누적 학습 시간 비교 (5% 규칙) -> 추가 update 수
+  v96     : M-C, M-C_compute 판정 (guardrail 포함) -> H192 run 여부
+"""
+import argparse
+import glob
+import json
+import math
+import os
+import sys
+
+import numpy as np
+
+Z975 = 2.2414027276  # 양측 97.5% (percentile CI의 정규 근사 반폭 계수)
+
+
+def load(p):
+    return json.load(open(p))
+
+
+def save(path, obj):
+    if os.path.exists(path):
+        sys.exit(f"decision exists: {path}")
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = path + f".{os.getpid()}.tmp"
+    json.dump(obj, open(tmp, "w"), indent=1)
+    os.replace(tmp, path)
+    print(json.dumps(obj, indent=1)[:3000])
+
+
+def f1(rep, name):
+    return rep["models"][name]["summary"]["f1_03"][0]
+
+
+def cmd_ext(a):
+    rep = load(a.v48)
+    out = {"rule": "each LR: (F1@0.3 epoch5 - epoch2 >= 0.02) and (V48 CE epoch5 <= 0.95*epoch2). If ANY LR satisfies, both LRs are extended once to epoch 8 "
+                   "(interpretation of 'each LR ... both LRs extend': recorded before results)", "per_lr": {}}
+    for lr in a.lrs:
+        e2, e5 = f1(rep, f"lr{lr}_e2"), f1(rep, f"lr{lr}_e5")
+        c2 = load(f"results/iter_040/train2/B_lr{lr}_s17/epoch_02/valce.json")["val_ce_V48"]
+        c5 = load(f"results/iter_040/train2/B_lr{lr}_s17/epoch_05/valce.json")["val_ce_V48"]
+        out["per_lr"][lr] = {"f1_e2": e2, "f1_e5": e5, "d_f1": e5 - e2, "ce_e2": c2, "ce_e5": c5, "ce_ratio": c5 / c2,
+                             "criterion_met": bool(e5 - e2 >= 0.02 and c5 <= 0.95 * c2)}
+    out["extend"] = any(v["criterion_met"] for v in out["per_lr"].values())
+    save(a.out, out)
+
+
+def cmd_select(a):
+    rep = load(a.v48)
+    cands = []
+    for lr in a.lrs:
+        for e in a.epochs:
+            n = f"lr{lr}_e{e}"
+            if n in rep["models"]:
+                s = rep["models"][n]["summary"]
+                cands.append({"name": n, "lr": lr, "epoch": e, "f1_03": s["f1_03"][0], "f1_05": s["f1_05"][0], "invalid": s["invalid_rate"]})
+    cands.sort(key=lambda c: (-round(c["f1_03"], 12), -round(c["f1_05"], 12), c["invalid"], c["epoch"]))
+    best = cands[0]
+    rising = None
+    if any(c["epoch"] == 8 for c in cands):
+        e5 = next(c for c in cands if c["lr"] == best["lr"] and c["epoch"] == 5)
+        e8 = next(c for c in cands if c["lr"] == best["lr"] and c["epoch"] == 8)
+        rising = bool(e8["f1_03"] - e5["f1_03"] >= 0.02)
+    out = {"selected": best, "adapter_dir": f"results/iter_040/train2/B_lr{best['lr']}_s17/epoch_{best['epoch']:02d}", "all_candidates": cands,
+           "baseline_still_rising_after_extension": rising,
+           "note": "selection on V48 (development, not independent); ties: F1@0.5, lower invalid, earlier epoch"}
+    save(a.out, out)
+
+
+def cmd_bgate(a):
+    rep = load(a.v96)
+    s = rep["models"]["B"]["summary"]
+    valid = 1 - s["invalid_rate"]
+    tr = s["unresolved_truncation_rate"]
+    man = [json.loads(l) for l in open("results/iter_040/data/manifest_train_private.jsonl")]
+    n_el = sum(r["contrast_eligible"] for r in man)
+    out = {"B_valid_rate": valid, "B_unresolved_truncation": tr, "valid_ge_0.95": valid >= 0.95, "truncation_le_0.02": tr <= 0.02,
+           "contrast_eligible_patients": n_el, "contrast_applicable": n_el > 0,
+           "proceed_to_M_C": bool(valid >= 0.95 and tr <= 0.02 and n_el > 0), "B_v96": {"f1_03": s["f1_03"], "f1_05": s["f1_05"]}}
+    save(a.out, out)
+
+
+def cmd_ratio(a):
+    def steps(d):
+        return [json.loads(l) for l in open(os.path.join(d, "train_log.jsonl")) if '"event": "step"' in l]
+    c, m = steps(a.c_dir), steps(a.m_dir)
+    tc, tm = [x["step_time_s"] for x in c][1:], [x["step_time_s"] for x in m][1:]
+    r = sum(tm) / sum(tc)
+    tokr = sum(x["fwd_tokens"] for x in m) / sum(x["fwd_tokens"] for x in c)
+    m_updates = a.m_updates
+    out = {"r_time": r, "r_time_median": float(np.median(tm) / np.median(tc)), "r_tokens": tokr, "n_steps_used_each": len(tc), "excluded": "first step (warmup)",
+           "source": {"C": a.c_dir, "M": a.m_dir, "note": "same T rows (first 64 patients by PatientID order), same GPU, mb=2, run sequentially before exploration"},
+           "M_updates": m_updates, "C_compute_total_updates": math.ceil(r * m_updates), "rule": "ceil(r * M_updates) applied to the total updates after B"}
+    save(a.out, out)
+
+
+def train_time(run_dir, upto_step=None):
+    xs = [json.loads(l) for l in open(os.path.join(run_dir, "train_log.jsonl")) if '"event": "step"' in l]
+    byk = {}
+    for x in xs:
+        byk[x["step"]] = x  # 재개 시 중복 step은 마지막 기록
+    xs = [byk[k] for k in sorted(byk) if upto_step is None or k <= upto_step]
+    return {"n_steps": len(xs), "train_time_s": sum(x["step_time_s"] for x in xs), "fwd_tokens": sum(x["fwd_tokens"] for x in xs)}
+
+
+def cmd_cost(a):
+    tm, tc = train_time(a.m_dir), train_time(a.c_dir)
+    ratio = tc["train_time_s"] / tm["train_time_s"]
+    need = None
+    if ratio < 0.95:
+        per = tc["train_time_s"] / tc["n_steps"]
+        need = math.ceil((tm["train_time_s"] - tc["train_time_s"]) / per)
+    out = {"M": tm, "C_compute_so_far": tc, "C_over_M_time": ratio, "within_5pct": abs(ratio - 1) <= 0.05,
+           "extra_C_updates_needed_if_cheaper_by_more_than_5pct": need,
+           "rule": "if C_compute is cheaper than M by >=5%, extend C by update units; if C is costlier, keep and mark conservative"}
+    save(a.out, out)
+
+
+def cmd_v96(a):
+    rep = load(a.v96)
+    P = rep["pairs"]
+    dC, dK = P["M:C"], P["M:C_compute"]
+    M, C, K = (rep["models"][n]["summary"] for n in ("M", "C", "C_compute"))
+    tM, tC, tK = train_time(a.m_dir), train_time(a.c_dir, a.m_updates), train_time(a.c_dir)
+    inf = {"M_generate_s": M["cost"]["mean_generate_s_per_request"], "C_generate_s": C["cost"]["mean_generate_s_per_request"],
+           "ratio": M["cost"]["mean_generate_s_per_request"] / C["cost"]["mean_generate_s_per_request"]}
+    tr = {"M_time_s": tM["train_time_s"], "C_time_s": tC["train_time_s"], "C_compute_time_s": tK["train_time_s"],
+          "M_over_C": tM["train_time_s"] / tC["train_time_s"], "C_compute_over_M": tK["train_time_s"] / tM["train_time_s"]}
+    res = {}
+    for nm, d in (("M-C", dC), ("M-C_compute", dK)):
+        res[nm] = {"f1_03_diff": d["f1_03"]["diff_mean_ci975"][0], "ci975": d["f1_03"]["diff_mean_ci975"][1:], "ci95": d["f1_03"]["diff_mean_ci95"][1:],
+                   "f1_05_diff": d["f1_05"]["diff_mean_ci95"][0], "fp_per_sentence_diff": d["fp_per_sentence_diff"],
+                   "invalid_diff_pp": d["invalid_rate_diff_pp"], "trunc_diff_pp": d["truncation_rate_diff_pp"], "sd_paired": d["f1_03"]["sd_paired"]}
+    g = {"f1_05_loss_le_0.02": all(r["f1_05_diff"] >= -0.02 for r in res.values()),
+         "fp_increase_le_0.05": all(r["fp_per_sentence_diff"] <= 0.05 for r in res.values()),
+         "invalid_trunc_increase_lt_2pp": all(r["invalid_diff_pp"] < 2 and r["trunc_diff_pp"] < 2 for r in res.values()),
+         "inference_cost_le_1.10": inf["ratio"] <= 1.10, "train_cost_le_3x_C": tr["M_over_C"] <= 3.0}
+    g["all"] = all(g.values())
+    diffs = [r["f1_03_diff"] for r in res.values()]
+    lo_min = min(r["ci975"][0] for r in res.values())
+    small = min(diffs)
+    cond_h = bool(all(d > 0 for d in diffs) and small >= 0.025 and all(r["ci975"][1] >= 0.05 for r in res.values()))
+    clear_pos = bool(all(d >= 0.05 for d in diffs) and all(r["ci975"][0] > 0 for r in res.values()) and g["all"])
+    hw = max(Z975 * r["sd_paired"] / math.sqrt(192) for r in res.values())
+    negative = bool(any(r["ci975"][1] < 0.05 for r in res.values()) or res["M-C_compute"]["f1_03_diff"] <= 0)
+    run = bool(g["all"] and (clear_pos or cond_h) and hw <= 0.05)
+    out = {"V96": res, "guardrails": g, "inference_cost": inf, "train_cost": tr, "condition_for_H192": cond_h, "clear_positive_on_V96": clear_pos,
+           "projected_ci975_halfwidth_H192_n192": hw, "halfwidth_le_0.05": hw <= 0.05, "negative_by_ci_upper_lt_0.05_or_no_gain": negative, "run": run,
+           "classification": "clear_positive" if clear_pos else ("negative" if negative else ("run_H192_for_precision" if run else
+                                                                                                        ("inconclusive_guardrail_fail" if not g["all"] else "inconclusive_no_H192"))),
+           "rule": "run iff guardrails pass and (clear positive or [both diffs>0, smaller>=0.025, both CI975 upper>=0.05]) and projected H192 CI975 half-width<=0.05",
+           "note": "V96 is development data incl. model selection; H192 (if run) is a separate report"}
+    save(a.out, out)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    for n in ("ext", "select", "bgate", "ratio", "cost", "v96"):
+        s = sub.add_parser(n)
+        s.add_argument("--out", required=True)
+    sub.choices["ext"].add_argument("--v48", required=True)
+    sub.choices["ext"].add_argument("--lrs", nargs="+", default=["1e-4", "2e-4"])
+    sub.choices["select"].add_argument("--v48", required=True)
+    sub.choices["select"].add_argument("--lrs", nargs="+", default=["1e-4", "2e-4"])
+    sub.choices["select"].add_argument("--epochs", nargs="+", type=int, default=[2, 5, 8])
+    sub.choices["bgate"].add_argument("--v96", required=True)
+    sub.choices["ratio"].add_argument("--c-dir", required=True)
+    sub.choices["ratio"].add_argument("--m-dir", required=True)
+    sub.choices["ratio"].add_argument("--m-updates", type=int, default=117)
+    sub.choices["cost"].add_argument("--m-dir", required=True)
+    sub.choices["cost"].add_argument("--c-dir", required=True)
+    sub.choices["v96"].add_argument("--v96", required=True)
+    sub.choices["v96"].add_argument("--m-dir", required=True)
+    sub.choices["v96"].add_argument("--c-dir", required=True, help="C 학습 run (update m-updates까지가 C, 전체가 C_compute)")
+    sub.choices["v96"].add_argument("--m-updates", type=int, default=117)
+    a = ap.parse_args()
+    {"ext": cmd_ext, "select": cmd_select, "bgate": cmd_bgate, "ratio": cmd_ratio, "cost": cmd_cost, "v96": cmd_v96}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg40_eval.py b/pg40_eval.py
new file mode 100644
index 0000000..6f06271
--- /dev/null
+++ b/pg40_eval.py
@@ -0,0 +1,171 @@
+"""iter_040 문장별 grounding 평가 (I-short 요청). 완료 검증(verify_completion)을 통과한 생성 결과 + 잠긴 eval manifest만 사용한다.
+
+python pg40_eval.py --subset V96 --model M0=results/iter_039/gen/E96,results/iter_039/requests_v2/requests_E96.jsonl,results/iter_039/protocol/protocol_E96.json,iter039 \
+    --model B=<gen_dir>,<requests>,<protocol>,iter040 --pairs M:C M:C_compute --out results/iter_040/eval/x.json
+- 주지표: 환자 평균(두 문장 평균) F1@IoU0.3, 문장별 maximum-cardinality one-to-one matching (pg39_spec.match_fast / sent_metrics).
+- 비교: 동일 환자 paired bootstrap 10,000회 seed 20260930, 95%와 97.5% CI.
+"""
+import argparse
+import json
+import os
+import sys
+
+import numpy as np
+
+import pg39_eval as E
+import pg39_run as R39
+import pg40_run as R40
+import pg39_spec as S
+from rsna_diag import parse
+
+EVAL_MANIFEST = "results/iter_040/data/manifest_eval_private.jsonl"
+SMALL_AREA = E.SMALL_AREA
+
+
+def load_eval_manifest(subset):
+    out = {}
+    for l in open(EVAL_MANIFEST):
+        r = json.loads(l)
+        if subset == "V96" and r["eval_set"] == "V96" or subset == "V48" and r["eval_set"] == "V96" and r["is_V48"] or subset == "H192" and r["eval_set"] == "H192":
+            out[r["PatientID"]] = r
+    return out
+
+
+def load_recs(spec, subset, man):
+    name, gen, req, proto, kind = spec
+    R = R39 if kind == "iter039" else R40
+    recs = R.verify_completion(gen, req, proto)
+    recs = [r for r in recs if r["cond"] == "I-short" and r["patient"] in man]
+    if {(r["patient"], tuple(r["targets"])) for r in recs} != {(p, (t,)) for p in man for t in ("qA", "qB")} or len(recs) != 2 * len(man):
+        raise SystemExit(f"{name}: I-short records do not cover subset {subset} exactly (missing/duplicate/extra)")
+    return recs
+
+
+def sent_table(recs, man):
+    """returns {patient: {qA: {...}, qB: {...}}} (문장별 F1@.3/.5, recall, fp, empty, union_iou, status, tokens ...)."""
+    tab = E.patient_table(recs, man)
+    out = {}
+    for p, conds in tab.items():
+        d = {}
+        for tg, e in conds["I-short"]:
+            t = tg[0]
+            sc = e["scores"][t]
+            d[t] = {"f1_03": sc["f1_03"], "f1_05": sc["f1_05"], "recall_03": sc["recall_03"], "fp_03": sc["fp_03"], "tp_03": sc["tp_03"],
+                    "n_pred": sc["n_pred"], "n_gt": sc["n_gt"], "empty": bool(sc["empty"]), "union_iou": sc["union_iou"], "status": e["status"],
+                    "valid": e["valid"], "eos": e["eos"], "n_out": e["n_out"], "wall": e["wall"], "peak_gb": e["peak_gb"], "caps_used": e["caps_used"],
+                    "groups": e["groups"]}
+        out[p] = d
+    return out
+
+
+def patient_vec(st, pids, key):
+    return np.array([np.mean([st[p][t][key] for t in ("qA", "qB")]) for p in pids])
+
+
+def summary(st, pids, man, recs):
+    keys = ["f1_03", "f1_05", "recall_03", "fp_03", "union_iou"]
+    d = {"n_patients": len(pids), "n_requests": 2 * len(pids)}
+    for k in keys:
+        d[k] = E.ci(patient_vec(st, pids, k))
+    sents = [st[p][t] for p in pids for t in ("qA", "qB")]
+    d["fp_per_sentence"] = float(np.mean([s["fp_03"] for s in sents]))
+    d["empty_pred_rate"] = float(np.mean([s["empty"] for s in sents]))
+    d["invalid_rate"] = float(np.mean([not s["valid"] for s in sents]))
+    d["unresolved_truncation_rate"] = float(np.mean([not s["eos"] for s in sents]))
+    d["status_counts"] = {}
+    for s in sents:
+        d["status_counts"][s["status"]] = d["status_counts"].get(s["status"], 0) + 1
+    d["cost"] = {"mean_wall_s_per_request": float(np.mean([r["wall_s"] for r in recs])),
+                 "mean_generate_s_per_request": float(np.mean([r["runtime_s_total"] for r in recs])),
+                 "mean_final_out_tokens": float(np.mean([r["n_output_tokens"] for r in recs])),
+                 "mean_new_tokens_all_attempts": float(np.mean([sum(a["n_new"] for a in r["attempts"]) for r in recs])),
+                 "retry_rate": float(np.mean([len(r["attempts"]) > 1 for r in recs])),
+                 "peak_alloc_gb_max": float(max(r["peak_mem_alloc_gb_max"] for r in recs))}
+    return d
+
+
+def strata(st, pids, man):
+    cross = {p: S.cross_iou_max(*(E.gt_canvas(man[p])[k] for k in ("qA", "qB"))) for p in pids}
+
+    def small(p):
+        return any((b[2] - b[0]) * (b[3] - b[1]) < SMALL_AREA for k in ("qA", "qB") for b in man[p]["gt_boxes_xyxy_norm"][k])
+    defs = {"multi_box": lambda p: any(len(man[p]["gt_boxes_xyxy_norm"][k]) > 1 for k in ("qA", "qB")),
+            "single_box": lambda p: all(len(man[p]["gt_boxes_xyxy_norm"][k]) == 1 for k in ("qA", "qB")),
+            "share_group": lambda p: man[p]["stratum"].startswith("share1"), "small_box": small,
+            "contrast_eligible(cross_iou<0.1)": lambda p: cross[p] < 0.1, "overlap(cross_iou>=0.1)": lambda p: cross[p] >= 0.1}
+    out = {}
+    for s, fn in defs.items():
+        keep = [p for p in pids if fn(p)]
+        out[s] = {"n": len(keep), "f1_03_mean": float(patient_vec(st, keep, "f1_03").mean()) if keep else None,
+                  "f1_05_mean": float(patient_vec(st, keep, "f1_05").mean()) if keep else None}
+    return out
+
+
+def discrimination(st, pids, man):
+    """서로 분리된 GT 쌍(cross-IoU<0.1) 환자에서: 자기 문장 GT 대비 F1 - 다른 문장 GT 대비 F1 (생성된 해당 문장 예측 기준)."""
+    gaps, own, oth = [], [], []
+    for p in pids:
+        gt = E.gt_canvas(man[p])
+        if S.cross_iou_max(gt["qA"], gt["qB"]) >= 0.1:
+            continue
+        for t, o in (("qA", "qB"), ("qB", "qA")):
+            pred = st[p][t]["groups"][t] if st[p][t]["valid"] else []
+            a = S.sent_metrics(pred, gt[t], 0.3)["f1"]
+            b = S.sent_metrics(pred, gt[o], 0.3)["f1"]
+            own.append(a)
+            oth.append(b)
+            gaps.append(a - b)
+    if not gaps:
+        return None
+    return {"n_sentences": len(gaps), "own_f1": float(np.mean(own)), "other_sentence_gt_f1": float(np.mean(oth)), "gap_mean": float(np.mean(gaps))}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--subset", required=True, choices=["V48", "V96", "H192"])
+    ap.add_argument("--model", action="append", required=True, help="NAME=gen_dir,requests,protocol,iter039|iter040")
+    ap.add_argument("--pairs", nargs="*", default=[], help="A:B  (A-B)")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("output exists")
+    man = load_eval_manifest(a.subset)
+    pids = sorted(man)
+    specs = []
+    for m in a.model:
+        n, rest = m.split("=", 1)
+        g, rq, pr, kind = rest.split(",")
+        specs.append((n, g, rq, pr, kind))
+    rep = {"subset": a.subset, "n_patients": len(pids), "models": {}, "pairs": {}, "sources": {n: {"gen": g, "requests": rq, "protocol": pr, "kind": k}
+                                                                                       for n, g, rq, pr, k in specs}}
+    tabs = {}
+    for spec in specs:
+        recs = load_recs(spec, a.subset, man)
+        st = sent_table(recs, man)
+        tabs[spec[0]] = st
+        rep["models"][spec[0]] = {"summary": summary(st, pids, man, recs), "strata": strata(st, pids, man), "discrimination": discrimination(st, pids, man),
+                                  "protocol_sha256": R40.file_sha(spec[3])}
+    for pr in a.pairs:
+        x, y = pr.split(":")
+        d = {}
+        for k in ("f1_03", "f1_05", "recall_03", "fp_03"):
+            va, vb = patient_vec(tabs[x], pids, k), patient_vec(tabs[y], pids, k)
+            d[k] = {"diff_mean_ci95": E.pci(va, vb, 0.95), "diff_mean_ci975": E.pci(va, vb, 0.975), "sd_paired": float(np.std(va - vb, ddof=1))}
+        d["fp_per_sentence_diff"] = rep["models"][x]["summary"]["fp_per_sentence"] - rep["models"][y]["summary"]["fp_per_sentence"]
+        d["invalid_rate_diff_pp"] = 100 * (rep["models"][x]["summary"]["invalid_rate"] - rep["models"][y]["summary"]["invalid_rate"])
+        d["truncation_rate_diff_pp"] = 100 * (rep["models"][x]["summary"]["unresolved_truncation_rate"] - rep["models"][y]["summary"]["unresolved_truncation_rate"])
+        va, vb = patient_vec(tabs[x], pids, "f1_03"), patient_vec(tabs[y], pids, "f1_03")
+        d["patients_a_better/equal/worse"] = [int((va > vb + 1e-12).sum()), int((abs(va - vb) <= 1e-12).sum()), int((va < vb - 1e-12).sum())]
+        rep["pairs"][pr] = d
+    rep["_per_patient_f1_03"] = {n: {p: float(np.mean([tabs[n][p][t]["f1_03"] for t in ("qA", "qB")])) for p in pids} for n in tabs}
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump(rep, open(a.out, "w"), indent=1)
+    print(json.dumps({n: {"f1_03": rep["models"][n]["summary"]["f1_03"], "f1_05": rep["models"][n]["summary"]["f1_05"][0],
+                          "invalid": rep["models"][n]["summary"]["invalid_rate"], "trunc": rep["models"][n]["summary"]["unresolved_truncation_rate"]}
+                     for n in rep["models"]}, indent=1))
+    for k, v in rep["pairs"].items():
+        print(k, "f1_03 diff", v["f1_03"]["diff_mean_ci975"], "f1_05", v["f1_05"]["diff_mean_ci95"][0], "fp/sent", v["fp_per_sentence_diff"])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg40_gen_test.py b/pg40_gen_test.py
new file mode 100644
index 0000000..28a6797
--- /dev/null
+++ b/pg40_gen_test.py
@@ -0,0 +1,160 @@
+"""iter_040 생성 runner(adapter·부분 행 복구·완료 검증) GPU 검사. GPU 두 장이 비어 있을 때만 실행한다.
+
+python pg40_gen_test.py --adapter <dir with adapter.pt> --out results/iter_040/tests/gen_test.json
+"""
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+import pg40_run as R
+
+BASE = "results/iter_040/tests/gen"
+RES = []
+
+
+def check(name, ok, detail=None):
+    RES.append({"name": name, "pass": bool(ok), "detail": detail})
+    print(("PASS " if ok else "FAIL ") + name, json.dumps(detail, default=str)[:400], flush=True)
+
+
+def run(cmd, **kw):
+    return subprocess.run([sys.executable, "pg40_run.py"] + cmd, capture_output=True, text=True, **kw)
+
+
+def toks(out_dir):
+    d = {}
+    import glob
+    for fn in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        for r in R.read_records(fn):
+            d[r["request_id"]] = r["suffix_ids"]
+    return d
+
+
+def resource_peak(out_dir):
+    mx = {}
+    p = os.path.join(out_dir, "resource_log.jsonl")
+    if os.path.exists(p):
+        for l in open(p):
+            for g in json.loads(l)["gpu"]:
+                i, u, _ = [x.strip() for x in g.split(",")]
+                mx[i] = max(mx.get(i, 0), int(u))
+    return mx
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--adapter", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--n", type=int, default=24)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("output exists")
+    os.makedirs(BASE, exist_ok=True)
+    rows = [json.loads(l) for l in open("results/iter_040/requests/requests_V48.jsonl")]
+    # 긴 문장·복수 box 사례를 포함하도록 multi-box/긴 문장 우선 + 나머지
+    man = {json.loads(l)["PatientID"]: json.loads(l) for l in open("results/iter_040/data/manifest_eval_private.jsonl")}
+    rows.sort(key=lambda r: (-(len(man[r["patient"]]["gt_boxes_xyxy_norm"][r["targets"][0]]) > 1), -len(r["prompt"])))
+    sub = rows[:a.n]
+    req = f"{BASE}/requests_test{a.n}.jsonl"
+    if os.path.exists(req):
+        sys.exit(f"{req} exists (new attempt path required)")
+    with open(req, "w") as f:
+        for r in sub:
+            f.write(json.dumps(r) + "\n")
+    proto = f"{BASE}/protocol_adapter.json"
+    R.make_protocol(req, proto, adapter=a.adapter)
+    # 1) 2 worker (GPU당 1)
+    d2, d4 = f"{BASE}/w2", f"{BASE}/w4"
+    t = time.time()
+    r2 = run(["launch", "--requests", req, "--protocol", proto, "--out-dir", d2, "--workers", "2", "--gpus", "0,1", "--peak-gb", "10"])
+    w2 = time.time() - t
+    check("launch_2_workers_completes_with_completion_json", r2.returncode == 0 and os.path.exists(f"{d2}/completion.json"), {"wall_s": w2, "err": r2.stderr[-300:]})
+    recs2 = R.verify_completion(d2, req, proto)
+    check("verify_completion_passes_adapter_records", len(recs2) == a.n and all(x["adapter_digest"] for x in recs2))
+    # 2) 4 worker (GPU당 2)
+    t = time.time()
+    r4 = run(["launch", "--requests", req, "--protocol", proto, "--out-dir", d4, "--workers", "4", "--gpus", "0,1", "--peak-gb", "10"])
+    w4 = time.time() - t
+    ok4 = r4.returncode == 0 and os.path.exists(f"{d4}/completion.json")
+    check("launch_4_workers_completes_or_refused_by_memory_margin", ok4 or "free" in (r4.stdout + r4.stderr), {"wall_s": w4, "out": (r4.stdout + r4.stderr)[-200:]})
+    same = None
+    if ok4:
+        t2, t4 = toks(d2), toks(d4)
+        same = t2 == t4
+        check("token_identical_2_vs_4_workers", same, {"n": len(t2)})
+        check("throughput_recorded", True, {"req_per_min_2w_wall": a.n / w2 * 60, "req_per_min_4w_wall": a.n / w4 * 60, "peak_mib_2w": resource_peak(d2),
+                                            "peak_mib_4w": resource_peak(d4)})
+    # 3) adapter 독립 로드 경로(학습기와 같은 apply_lora+load_lora_state, dropout 0.05 eval)로 생성한 token과 일치
+    import torch
+    from rsna_diag import generate as G, lora
+    torch_, proc, model = G.load_model()
+    blob = torch_.load(os.path.join(a.adapter, "adapter.pt"), map_location="cpu", weights_only=True)
+    lora.apply_lora(model, 16, 32, 0.05)
+    lora.load_lora_state(model, blob["state"])
+    model.eval()
+    env = G.env_info(torch_, proc, model)
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    ref = {}
+    for r in sub[:6]:
+        image, aff, px = G.load_image(r["image"])
+        inp = G.build_inputs(proc, image, r["prompt"])
+        at = G.generate(torch_, proc, model, inp, r["caps"][0], eos_ids)
+        ref[r["request_id"]] = at["suffix_ids"]
+    t2 = toks(d2)
+    check("adapter_generation_equals_trainer_style_load_path_tokens", all(ref[k] == t2[k] for k in ref), {"n": len(ref)})
+    del model
+    torch_.cuda.empty_cache()
+    # 4) 강제 종료 후 재개 + 부분 행 복구
+    d3 = f"{BASE}/kill"
+    cmd = [sys.executable, "pg40_run.py", "launch", "--requests", req, "--protocol", proto, "--out-dir", d3, "--workers", "2", "--gpus", "0,1", "--peak-gb", "10"]
+    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
+    t0 = time.time()
+    while time.time() - t0 < 900:
+        n = sum(len(R.read_records(os.path.join(d3, f))) for f in os.listdir(d3) if f.startswith("gen_worker") and f.endswith(".jsonl")) if os.path.isdir(d3) else 0
+        if n >= 6:
+            break
+        time.sleep(3)
+    os.killpg(p.pid, signal.SIGKILL)
+    p.wait()
+    time.sleep(3)
+    partial_files = [os.path.join(d3, f) for f in os.listdir(d3) if f.startswith("gen_worker") and f.endswith(".jsonl")]
+    n_before = sum(len(R.read_records(f)) for f in partial_files)
+    with open(partial_files[0], "a") as f:
+        f.write('{"request_id": "torn", "x": ')  # 부분 행 시뮬레이션
+    check("killed_before_completion", not os.path.exists(f"{d3}/completion.json") and 6 <= n_before < a.n, {"n_before": n_before})
+    r3 = subprocess.run(cmd, capture_output=True, text=True)
+    check("relaunch_after_kill_completes", r3.returncode == 0 and os.path.exists(f"{d3}/completion.json"), {"err": r3.stderr[-300:]})
+    recs3 = R.verify_completion(d3, req, proto)
+    tk3, tk2 = toks(d3), toks(d2)
+    check("resumed_run_no_duplicates_and_tokens_equal_baseline", len(recs3) == a.n == len(tk3) and tk3 == tk2)
+    check("partial_row_repaired_with_log", any(os.path.exists(f + ".repair.log") for f in partial_files))
+    # 5) 변조 거부
+    import shutil
+    dt = f"{BASE}/tamper"
+    shutil.copytree(d2, dt, ignore=shutil.ignore_patterns("*.lock", "claims"))
+    fn = os.path.join(dt, "gen_worker0.jsonl")
+    lines = open(fn).read().splitlines()
+    rec = json.loads(lines[0])
+    rec["suffix_text_raw"] = rec["suffix_text_raw"] + " "
+    lines[0] = json.dumps(rec)
+    open(fn, "w").write("\n".join(lines) + "\n")
+    try:
+        R.verify_completion(dt, req, proto)
+        rej = False
+    except R.RunError:
+        rej = True
+    check("modified_record_rejected_by_completion_verification", rej)
+    dt2 = f"{BASE}/rerun_completed"
+    r5 = run(["launch", "--requests", req, "--protocol", proto, "--out-dir", d2, "--workers", "2", "--gpus", "0,1"])
+    check("rerun_into_completed_dir_refused", r5.returncode != 0)
+    json.dump({"results": RES, "n_pass": sum(x["pass"] for x in RES), "n": len(RES)}, open(a.out, "w"), indent=1, default=str)
+    print(f"{sum(x['pass'] for x in RES)}/{len(RES)} PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg40_genjobs.py b/pg40_genjobs.py
new file mode 100644
index 0000000..97059ce
--- /dev/null
+++ b/pg40_genjobs.py
@@ -0,0 +1,50 @@
+"""iter_040 생성 작업 순차 실행기: 각 작업마다 protocol 잠금 -> launcher(4 worker, GPU당 2) -> completion 검증.
+python pg40_genjobs.py --jobs NAME=ADAPTER_DIR:REQUESTS [...] [--gate G] --workers 4 --peak-gb 9
+기존 protocol/gen 디렉터리는 덮어쓰지 않는다: protocol이 있으면 requests·adapter가 같은지 확인하고 재사용, gen 디렉터리가 completion을 가지면 검증만 한다.
+"""
+import argparse
+import json
+import os
+import subprocess
+import sys
+
+import pg40_run as R
+
+PROTO = "results/iter_040/protocol/protocol_{}.json"
+GEN = "results/iter_040/gen/{}"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--jobs", nargs="+", required=True)
+    ap.add_argument("--gate", default=None)
+    ap.add_argument("--workers", type=int, default=4)
+    ap.add_argument("--peak-gb", type=float, default=9.0)
+    ap.add_argument("--gpus", default="0,1")
+    a = ap.parse_args()
+    for j in a.jobs:
+        name, rest = j.split("=", 1)
+        adapter, req = rest.split(":", 1)
+        adapter = None if adapter == "none" else adapter
+        pp, gd = PROTO.format(name), GEN.format(name)
+        if os.path.exists(pp):
+            p = json.load(open(pp))
+            if p["requests_path"] != req or (p["adapter"] or {}).get("path") != adapter:
+                sys.exit(f"{name}: existing protocol differs from requested job")
+        else:
+            R.make_protocol(req, pp, adapter=adapter, gate=a.gate)
+        if os.path.exists(os.path.join(gd, "completion.json")):
+            R.verify_completion(gd, req, pp)
+            print(f"{name}: already complete (verified)", flush=True)
+            continue
+        cmd = [sys.executable, "pg40_run.py", "launch", "--requests", req, "--protocol", pp, "--out-dir", gd, "--workers", str(a.workers),
+               "--gpus", a.gpus, "--peak-gb", str(a.peak_gb)]
+        r = subprocess.run(cmd)
+        if r.returncode != 0:
+            sys.exit(f"{name}: launcher failed rc={r.returncode}")
+        R.verify_completion(gd, req, pp)
+        print(f"{name}: complete + verified", flush=True)
+
+
+if __name__ == "__main__":
+    main()
