+        if not (0 <= b[0] < b[2] <= 1000 and 0 <= b[1] < b[3] <= 1000):
+            return False, {}, 0
+        m = re.fullmatch(r"\s*q([abAB])\s*", lab)
+        if not m:
+            return False, {}, 0
+        pid = "q" + m.group(1).upper()
+        if pid in allowed:
+            out[pid].append([float(v) for v in b])
+    return True, out, 0
+
+
+def load_man(subset):
