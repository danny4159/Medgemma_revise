+        rc, msg = run_worker('V8', 'I', d, gpu, ['--ids', f'{T}/ids6.json'])
+        after = read(d)
+        return {'rc': rc, 'rejected': rc != 0, 'records_unchanged': len(after) == len(recs), 'msg_tail': msg[-200:]}
+
+    def m_pix(rs):
+        rs[0]['fields']['ref_pixel'][0][0] = '0' * 64
+    def m_rid(rs):
