new file mode 100644
index 0000000..4452efa
--- /dev/null
+++ b/pg42_data.py
@@ -0,0 +1,91 @@
+"""iter_042 후보 열거·적격성 (CPU only, 모델 출력 미사용). pg39_data의 loader만 재사용하고 적격성 함수는 별도다.
+
+- 음성: 원본 abnormal=false 문장에서 현재 영상의 pleural effusion 부재가 명시된 경우만 (regex는 후보 열거용, 최종 판단은 눈가림 검토 기록 review_private.json).
+- 양성: effusion 관련 모든 abnormal 문장이 labels==['pleural effusion'] + 유효 boxes + progression None + 시간 비교 문구 없음.
+- 환자당 한 영상은 sha256('iter042-v1|'+PatientID+'|'+ImageID) 최소 순. 결과 기반 교체 금지.
+"""
+import hashlib
+import json
+import re
+
+import pg39_data as D
+
+SEL_TAG = "iter042-v1"
+TARGET = "pleural effusion"
+EFF_RE = re.compile(r"effusion|pleural fluid", re.I)
+NEG_MENTION_RE = re.compile(r"effusion", re.I)
+EXCLUDE_MANIFESTS = ["results/iter_039/data/manifest_private.jsonl", "results/iter_040/data/manifest_train_private.jsonl",
+                     "results/iter_040/data/manifest_eval_private.jsonl"]
+
+
+def sel_hash(patient, image):
+    return hashlib.sha256(f"{SEL_TAG}|{patient}|{image}".encode()).hexdigest()
+
+
+def load_excluded():
+    pats, studies, images = set(), set(), set()
+    for p in EXCLUDE_MANIFESTS:
+        for ln in open(p):
+            d = json.loads(ln)
+            pats.add(d["PatientID"])
+            studies.add(d["StudyID"])
+            images.add(d["ImageID"])
+    return pats, studies, images
+
+
+def neg_sentences(r):
+    """영상의 abnormal=false 문장 중 effusion을 언급한 것들의 (index, en, es)."""
+    return [(i, f["sentence_en"], f.get("sentence_es")) for i, f in enumerate(r["findings"])
+            if f.get("abnormal") is False and NEG_MENTION_RE.search(f["sentence_en"])]
+
+
+def pos_target(r):
+    """양성 판정. returns (ok, reason, target_finding_indices, merged_boxes)."""
+    rel = [i for i, f in enumerate(r["findings"])
+           if f.get("abnormal") is True and (EFF_RE.search(f["sentence_en"]) or any(EFF_RE.search(l) for l in f.get("labels", [])))]
+    tgt = [i for i in rel if TARGET in r["findings"][i].get("labels", [])]
+    if not tgt:
+        return False, "no_target_label", [], []
+    for i in rel:
+        f = r["findings"][i]
+        if f["labels"] != [TARGET]:
+            return False, "mixed_or_other_effusion_label", tgt, []
+        if not f["boxes"] or not all(D.valid_box(b) for b in f["boxes"]):
+            return False, "no_or_invalid_box", tgt, []
+        if f.get("progression") is not None:
+            return False, "progression_field", tgt, []
+        if D.TEMPORAL_RE.search(f["sentence_en"]):
+            return False, "temporal_phrase", tgt, []
+    boxes, seen = [], set()
+    for i in tgt:
+        for b in r["findings"][i]["boxes"]:
+            k = tuple(b)
+            if k not in seen:
+                seen.add(k)
+                boxes.append(list(b))
+    return True, "", tgt, boxes
+
+
+def enumerate_candidates(reports, links, restrict_patients=None, exclude=None):
+    """split=='train' 영상의 음성/양성 후보 (영상 단위). exclude=(pats,studies,images)이면 제외, restrict_patients면 그 환자만."""
+    out = {"neg": [], "pos": []}
+    for r in reports:
+        iid = r["ImageID"]
+        if links["img2split"][iid] != "train":
+            continue
+        pid = links["img2patient"][iid]
+        if restrict_patients is not None and pid not in restrict_patients:
+            continue
+        if exclude is not None and (pid in exclude[0] or r["StudyID"] in exclude[1] or iid in exclude[2]):
+            continue
+        ns = neg_sentences(r)
+        ok, why, tgt, boxes = pos_target(r)
+        base = {"PatientID": pid, "ImageID": iid, "StudyID": r["StudyID"]}
+        if ns:
+            out["neg"].append({**base, "neg_sentences": ns,
+                               "other_findings": [(i, f["abnormal"], f["sentence_en"]) for i, f in enumerate(r["findings"])]})
+        if ok:
+            out["pos"].append({**base, "target_idx": tgt, "boxes": boxes,
+                               "target_sentences": [r["findings"][i]["sentence_en"] for i in tgt],
+                               "other_findings": [(i, f["abnormal"], f["sentence_en"]) for i, f in enumerate(r["findings"])]})
+    return out
diff --git a/pg42_dcheck.py b/pg42_dcheck.py
new file mode 100644
index 0000000..ebe70b5
--- /dev/null
+++ b/pg42_dcheck.py
@@ -0,0 +1,107 @@
+"""iter_042 D 동작 검사: 2w/4w 정합성, 변조·불일치 거부. 결과는 results/iter_042/tests/ 새 파일.
+python pg42_dcheck.py compare | tamper
+"""
+import glob
+import json
+import os
+import shutil
+import sys
+
+import pg41_run as R
+
+OUT = "results/iter_042"
+
+
+def recs(d):
+    out = {}
+    for f in sorted(glob.glob(f"{OUT}/gen/{d}/gen_worker*.jsonl")):
+        for l in open(f):
+            if l.strip():
+                r = json.loads(l)
+                out[r["request_id"]] = r
+    return out
+
+
+def peak(d):
+    mx = {}
+    for l in open(f"{OUT}/gen/{d}/resource_log.jsonl"):
+        for g in json.loads(l)["gpu"]:
+            i, u, _ = [int(x) for x in g.split(",")]
+            mx[i] = max(mx.get(i, 0), u)
+    return mx
+
+
+def compare():
+    res = {}
+    for m in ("M0", "C"):
+        a, b = recs(f"D_{m}_2w"), recs(f"D_{m}_4w")
+        same = set(a) == set(b)
+        mism = [k for k in a if k in b and a[k]["suffix_ids"] != b[k]["suffix_ids"]]
+        ca = json.load(open(f"{OUT}/gen/D_{m}_2w/completion.json"))
+        cb = json.load(open(f"{OUT}/gen/D_{m}_4w/completion.json"))
+        res[m] = {"same_request_set": same, "n": len(a), "token_mismatch": len(mism),
+                  "2w": {"wall_s": ca["wall_s"], "gen_union_s": ca["cost"]["device_seconds_generate_union"], "peak_mib": peak(f"D_{m}_2w"),
+                          "max_out_tokens": max(r["n_output_tokens"] for r in a.values()), "max_req_wall": max(r["wall_s"] for r in a.values())},
+                  "4w": {"wall_s": cb["wall_s"], "gen_union_s": cb["cost"]["device_seconds_generate_union"], "peak_mib": peak(f"D_{m}_4w"),
+                          "max_out_tokens": max(r["n_output_tokens"] for r in b.values()), "max_req_wall": max(r["wall_s"] for r in b.values())},
+                  "oom": any("oom" in open(f).read() for f in glob.glob(f"{OUT}/gen/D_{m}_4w/*.log"))}
+    tot2 = sum(res[m]["2w"]["wall_s"] for m in res)
+    tot4 = sum(res[m]["4w"]["wall_s"] for m in res)
+    ok = all(v["same_request_set"] and v["token_mismatch"] == 0 and not v["oom"] for v in res.values())
+    peak4 = max(max(res[m]["4w"]["peak_mib"].values()) for m in res)
+    res["decision"] = {"workers_total": 4 if ok and tot4 < tot2 and peak4 < 24576 - 2048 else 2, "total_wall_2w_s": tot2,
+                       "total_wall_4w_s": tot4, "peak4_mib": peak4, "note": "D 36요청/구성, 모델 로딩 포함 wall. E 정확도는 사용하지 않음."}
+    os.makedirs(f"{OUT}/decisions", exist_ok=True)
+    json.dump(res, open(f"{OUT}/decisions/d_worker_config.json", "x"), indent=1)
+    print(json.dumps(res["decision"]), {m: (res[m]["token_mismatch"], res[m]["oom"]) for m in ("M0", "C")})
+
+
+def tamper():
+    tdir = f"{OUT}/tests/tamper"
+    os.makedirs(tdir, exist_ok=True)
+    req, proto = f"{OUT}/requests/requests_D_C.jsonl", f"{OUT}/protocol/protocol_D_C_2w.json"
+    results = {}
+
+    def fresh(name):
+        d = f"{tdir}/{name}"
+        shutil.copytree(f"{OUT}/gen/D_C_2w", d)
+        return d
+
+    def expect_reject(name, d, rq=req, pr=proto):
+        try:
+            R.verify_completion(d, rq, pr)
+            results[name] = "NOT_REJECTED"
+        except Exception as e:
+            results[name] = f"rejected: {type(e).__name__}: {str(e)[:80]}"
+    R.verify_completion(f"{OUT}/gen/D_C_2w", req, proto)
+    results["baseline_ok"] = "verified"
+    # 1) 내용 변조 (record digest)
+    d = fresh("t_content")
+    f = sorted(glob.glob(f"{d}/gen_worker*.jsonl"))[0]
+    lines = open(f).read().split("\n")
+    r = json.loads(lines[0])
+    r["suffix_text_raw"] = "[]<end_of_turn>"
+    lines[0] = json.dumps(r)
+    open(f, "w").write("\n".join(lines))
+    expect_reject("tamper_record_content", d)
+    # 2) 누락 record
+    d = fresh("t_missing")
+    f = sorted(glob.glob(f"{d}/gen_worker*.jsonl"))[0]
+    lines = open(f).read().split("\n")
+    open(f, "w").write("\n".join(lines[1:]))
+    expect_reject("missing_record", d)
+    # 3) 다른 모델 protocol (M0 protocol로 C 결과 검증)
+    d = fresh("t_model")
+    expect_reject("wrong_model_protocol", d, rq=f"{OUT}/requests/requests_D_M0.jsonl", pr=f"{OUT}/protocol/protocol_D_M0_2w.json")
+    # 4) 중복 record
+    d = fresh("t_dup")
+    f = sorted(glob.glob(f"{d}/gen_worker*.jsonl"))[0]
+    s = open(f).read()
+    open(f, "a").write(s.split("\n")[0] + "\n")
+    expect_reject("duplicate_record", d)
+    json.dump(results, open(f"{OUT}/tests/tamper_result.json", "x"), indent=1)
+    print(json.dumps(results, indent=1))
+
+
+if __name__ == "__main__":
+    {"compare": compare, "tamper": tamper}[sys.argv[1]]()
diff --git a/pg42_driver.py b/pg42_driver.py
new file mode 100644
index 0000000..86e88fc
--- /dev/null
+++ b/pg42_driver.py
@@ -0,0 +1,66 @@
+"""iter_042 stage driver. pg41_run의 protocol/launch/verify_completion을 쓰되 completion 존재만으로 건너뛰지 않는다.
+
+python pg42_driver.py --kind E_C --name E_C --workers 4 [--peak-gb 9] [--gpus 0,1]
+- 호출자가 요구한 모델(kind의 _M0/_C)과 protocol의 adapter digest를 대조한다 (M0는 adapter 없음, C는 고정 digest).
+- protocol이 이미 있으면 새로 만들지 않고 요청 hash·잠금 파일과 대조한다(verify_protocol). completion이 있으면 launch하지 않고 verify_completion(현재 영상 hash 포함)만 수행한다.
+- 평가 GT manifest·selection lock·평가/스펙 소스를 protocol 잠금에 넣는다.
+"""
+import argparse
+import json
+import os
+import subprocess
+import sys
+
+import pg41_run as R
+
+C_ADAPTER = "results/iter_040/train2/C_s17/epoch_03"
+C_DIGEST = "419ae81f5ef455d39742b158537373da6e26061b362d13205ab28b4a50905ba8"
+OUT = "results/iter_042"
+LOCK = [f"{OUT}/data/manifest_private.jsonl", f"{OUT}/data/selection_lock.json", f"{OUT}/data/review_private.json",
+        "pg42_spec.py", "pg42_data.py", "pg42_build.py", "pg42_driver.py"]  # 평가 소스는 결과 digest에 기록(pg42_eval)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--kind", required=True, help="D_M0 D_C E_M0 E_C")
+    ap.add_argument("--name", required=True)
+    ap.add_argument("--workers", type=int, required=True)
+    ap.add_argument("--peak-gb", type=float, default=9.0)
+    ap.add_argument("--gpus", default=None)
+    ap.add_argument("--max-requests", type=int, default=None)
+    a = ap.parse_args()
+    model = a.kind.split("_")[1]
+    if model not in ("M0", "C"):
+        sys.exit("bad kind")
+    req = f"{OUT}/requests/requests_{a.kind}.jsonl"
+    out_dir = f"{OUT}/gen/{a.name}"
+    proto = f"{OUT}/protocol/protocol_{a.name}.json"
+    os.makedirs(f"{OUT}/protocol", exist_ok=True)
+    lock = json.load(open(f"{OUT}/data/selection_lock.json"))
+    if R.file_sha(req) != lock["request_files_sha256"][a.kind]:
+        sys.exit("requests file != selection_lock")
+    if not os.path.exists(proto):
+        R.make_protocol(req, proto, adapter=C_ADAPTER if model == "C" else None, lock=LOCK)
+    pdig, p = R.verify_protocol(proto, req)
+    ad = (p.get("adapter") or {}).get("digest")
+    if (model == "C" and ad != C_DIGEST) or (model == "M0" and ad is not None):
+        sys.exit(f"protocol adapter {ad} does not match requested model {model}")
+    if os.path.exists(os.path.join(out_dir, "completion.json")):
+        recs = R.verify_completion(out_dir, req, proto)
+        print(f"existing completion re-verified: {len(recs)} records")
+        return
+    cmd = [sys.executable, "pg41_run.py", "launch", "--requests", req, "--protocol", proto, "--out-dir", out_dir,
+           "--workers", str(a.workers), "--peak-gb", str(a.peak_gb)]
+    if a.gpus:
+        cmd += ["--gpus", a.gpus]
+    if a.max_requests is not None:
+        cmd += ["--max-requests", str(a.max_requests)]
+    rc = subprocess.run(cmd).returncode
+    if rc != 0:
+        sys.exit(f"launch rc={rc}")
+    recs = R.verify_completion(out_dir, req, proto)
+    print(f"completion verified: {len(recs)} records")
+
+
+if __name__ == "__main__":
+    main()
