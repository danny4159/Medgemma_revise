new file mode 100644
index 0000000..c596bdd
--- /dev/null
+++ b/rsna_diag/lora.py
@@ -0,0 +1,85 @@
+"""표준 LoRA (peft 미설치·설치 금지). y = W x + (alpha/r) B A x. 언어모델 attention/MLP 선형층만 (iter_010).
+
+- A: kaiming_uniform(a=sqrt(5)) (loralib 표준), B: 0 -> 초기 항등. base weight는 동결·불변.
+- LoRA 파라미터는 fp32 master, 연산은 fp32 후 base 출력 dtype으로 cast해 더한다.
+"""
+import hashlib
+import math
+
+import torch
+import torch.nn as nn
+
+TARGET_SUFFIXES = ("q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj")
+LM_LAYER_PREFIX = "model.language_model.layers."
+
+
+class LoRALinear(nn.Module):
+    def __init__(self, base: nn.Linear, r=16, alpha=32, dropout=0.05):
+        super().__init__()
+        self.base, self.r, self.alpha, self.scaling = base, r, alpha, alpha / r
+        dev = base.weight.device
+        self.lora_A = nn.Parameter(torch.empty(r, base.in_features, dtype=torch.float32, device=dev))
+        self.lora_B = nn.Parameter(torch.zeros(base.out_features, r, dtype=torch.float32, device=dev))
+        nn.init.kaiming_uniform_(self.lora_A, a=math.sqrt(5))
+        self.drop = nn.Dropout(dropout)
+
+    def forward(self, x):
+        y = self.base(x)
+        z = (self.drop(x).to(torch.float32) @ self.lora_A.t()) @ self.lora_B.t() * self.scaling
+        return y + z.to(y.dtype)
+
+
+def apply_lora(model, r=16, alpha=32, dropout=0.05, seed=None):
+    """LM layer의 대상 선형층을 LoRALinear로 교체하고 다른 모든 파라미터를 동결한다. returns 교체한 모듈 이름 목록."""
+    if seed is not None:
+        torch.manual_seed(seed)
+    for p in model.parameters():
+        p.requires_grad_(False)
+    names = []
+    for name, mod in list(model.named_modules()):
+        if name.startswith(LM_LAYER_PREFIX) and name.rsplit(".", 1)[-1] in TARGET_SUFFIXES and isinstance(mod, nn.Linear):
+            parent = model.get_submodule(name.rsplit(".", 1)[0])
+            setattr(parent, name.rsplit(".", 1)[1], LoRALinear(mod, r, alpha, dropout))
+            names.append(name)
+    if not names:
+        raise RuntimeError("no LoRA target modules found")
+    return names
+
+
+def lora_params(model):
+    return {n: p for n, p in model.named_parameters() if p.requires_grad}
+
+
+def lora_state_dict(model):
+    return {n: p.detach().to("cpu", torch.float32).clone() for n, p in model.named_parameters() if "lora_" in n}
+
+
+def load_lora_state(model, state, strict=True):
+    own = {n: p for n, p in model.named_parameters() if "lora_" in n}
+    if strict and set(own) != set(state):
+        raise ValueError(f"lora keys mismatch: missing {sorted(set(own) - set(state))[:3]} extra {sorted(set(state) - set(own))[:3]}")
+    with torch.no_grad():
+        for n, p in own.items():
+            p.copy_(state[n].to(p.device, p.dtype))
+
+
+def state_digest(state):
+    h = hashlib.sha256()
+    for n in sorted(state):
+        t = state[n].detach().to("cpu", torch.float32).contiguous()
+        h.update(n.encode())
+        h.update(str(tuple(t.shape)).encode())
+        h.update(t.numpy().tobytes())
+    return h.hexdigest()
+
+
+def base_digest(model):
+    """LoRA를 제외한 모든 파라미터의 (이름, shape, 첫/마지막 1M 원소 합 등이 아닌) 전체 hash. 동결 검증용 (느리지만 정확)."""
+    h = hashlib.sha256()
+    for n, p in model.named_parameters():
+        if "lora_" in n:
+            continue
+        h.update(n.replace(".base.", ".").encode())  # LoRA 적용 전후 이름을 같게 정규화
+        h.update(p.detach().to("cpu").contiguous().view(torch.uint8).numpy().tobytes() if p.dtype != torch.bfloat16
+                 else p.detach().to("cpu").contiguous().view(torch.int16).numpy().tobytes())
+    return h.hexdigest()
diff --git a/rsna_diag/metrics.py b/rsna_diag/metrics.py
new file mode 100644
index 0000000..33c5131
--- /dev/null
+++ b/rsna_diag/metrics.py
@@ -0,0 +1,136 @@
+"""bbox 평가 (iter_009). 모든 box는 [y0,x0,y1,x1] (0-1000, padding canvas)."""
+import itertools
+import math
+
+import numpy as np
+
+
+def area(b):
+    return max(0.0, b[2] - b[0]) * max(0.0, b[3] - b[1])
+
+
+def inter(a, b):
+    return max(0.0, min(a[2], b[2]) - max(a[0], b[0])) * max(0.0, min(a[3], b[3]) - max(a[1], b[1]))
+
+
+def iou(a, b):
+    i = inter(a, b)
+    u = area(a) + area(b) - i
+    return i / u if u > 0 else 0.0
+
+
+def union_area(boxes):
+    """겹친 면적을 한 번만 세는 직사각형 합집합 면적 (좌표 압축)."""
+    boxes = [b for b in boxes if area(b) > 0]
+    if not boxes:
+        return 0.0
+    ys = sorted({v for b in boxes for v in (b[0], b[2])})
+    tot = 0.0
+    for y0, y1 in zip(ys[:-1], ys[1:]):
+        iv = sorted((b[1], b[3]) for b in boxes if b[0] <= y0 and b[2] >= y1)
+        cur_s = cur_e = None
+        length = 0.0
+        for s, e in iv:
+            if cur_e is None or s > cur_e:
+                if cur_e is not None:
+                    length += cur_e - cur_s
+                cur_s, cur_e = s, e
+            else:
+                cur_e = max(cur_e, e)
+        if cur_e is not None:
+            length += cur_e - cur_s
+        tot += length * (y1 - y0)
+    return tot
+
+
+def union_iou(pred, gt):
+    if not pred and not gt:
+        return 0.0
+    up, ug = union_area(pred), union_area(gt)
+    # 교집합 면적 = up + ug - union(all)
+    ia = up + ug - union_area(list(pred) + list(gt))
+    u = up + ug - ia
+    return ia / u if u > 0 else 0.0
+
+
+def match(pred, gt, thr):
+    """threshold thr 이상 IoU 쌍의 최대 cardinality one-to-one matching.
+    동률은 총 IoU 최대, 이후 (gt index 순의) pred index tuple 사전순 최소. returns list[(gi, pi)]."""
+    mat = [[iou(p, g) for p in pred] for g in gt]
+    best = {"key": None, "pairs": []}
+
+    def rec(gi, used, pairs, tot):
+        if gi == len(gt):
+            key = (len(pairs), tot)
+            cur = best["key"]
+            if cur is None or key[0] > cur[0] or (key[0] == cur[0] and key[1] > cur[1] + 1e-12):
+                best["key"], best["pairs"] = key, list(pairs)
+            return
+        # 사전순 최소 tie-break: pred index 오름차순으로 탐색하고 엄격히 더 좋을 때만 갱신 (none 분기는 마지막)
+        for pi in range(len(pred)):
+            if pi not in used and mat[gi][pi] >= thr:
+                pairs.append((gi, pi))
+                rec(gi + 1, used | {pi}, pairs, tot + mat[gi][pi])
+                pairs.pop()
+        rec(gi + 1, used, pairs, tot)
+
+    rec(0, frozenset(), [], 0.0)
+    return best["pairs"]
+
+
+def patient_metrics(pred, gt, thr):
+    pairs = match(pred, gt, thr)
+    tp = len(pairs)
+    prec = tp / len(pred) if pred else 0.0
+    rec = tp / len(gt) if gt else 0.0
+    f1 = 2 * prec * rec / (prec + rec) if prec + rec > 0 else 0.0
+    return {"tp": tp, "n_pred": len(pred), "n_gt": len(gt), "precision": prec, "recall": rec, "f1": f1,
+            "unmatched_gt": len(gt) - tp, "unmatched_pred": len(pred) - tp}
+
+
+def max_iou_all(pred, gt):
+    return max((iou(p, g) for p in pred for g in gt), default=0.0)
+
+
+def wilson(k, n, z=1.959964):
+    if n == 0:
+        return (float("nan"), float("nan"))
+    p = k / n
+    d = 1 + z * z / n
+    c = (p + z * z / (2 * n)) / d
+    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+    return (c - h, c + h)
+
+
+def bootstrap_indices(n, B=10000, seed=20260924):
+    rng = np.random.default_rng(seed)
+    return rng.integers(0, n, size=(B, n), dtype=np.int32)
+
+
+def paired_boot_ci(a, b, idx):
+    """a,b: 같은 환자 순서의 값. 차이 a-b 평균의 percentile 95% CI. returns (mean_diff, lo, hi)."""
+    d = np.asarray(a, float) - np.asarray(b, float)
+    m = d[idx].mean(axis=1)
+    return float(d.mean()), float(np.percentile(m, 2.5)), float(np.percentile(m, 97.5))
+
+
+def derangement(n, seed):
+    """Sattolo: 고정점이 없는 순열 (단일 순환)."""
+    rng = np.random.default_rng(seed)
+    p = list(range(n))
+    for i in range(n - 1, 0, -1):
+        j = int(rng.integers(0, i))
+        p[i], p[j] = p[j], p[i]
+    assert all(p[i] != i for i in range(n))
+    return p
+
+
+def medoid_box(dev_gt_boxes_per_image):
+    """dev 양성 GT box 후보 중 (영상별 best IoU)의 평균이 최대인 실제 box. 동률은 입력 순서(고정 ID 순)."""
+    cands = [b for boxes in dev_gt_boxes_per_image for b in boxes]
+    best, best_s = None, -1.0
+    for c in cands:
+        s = float(np.mean([max(iou(c, g) for g in boxes) for boxes in dev_gt_boxes_per_image]))
+        if s > best_s + 1e-12:
+            best, best_s = c, s
+    return best, best_s
