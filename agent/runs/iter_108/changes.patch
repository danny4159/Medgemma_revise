+def shard_target(stage, system, s, nshards):
+    rows, _ = stage_rows(stage)
+    mine = {r["ImageID"] for i, r in enumerate(rows) if i % nshards == s}
+    return [q for q in requests(stage, system) if q["ImageID"] in mine]
