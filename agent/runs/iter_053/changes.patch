+            assert key not in out["diffs"], key
+            dd = samp(a, m) - samp(b, m)
+            lo, hi = E47.ci(dd, lev)
+            out["diffs"][key] = dict(mean=macro_mean(table, st, a, m) - macro_mean(table, st, b, m), lo=lo, hi=hi, level=lev,
