index 0000000..08de8cf
--- /dev/null
+++ b/rr53_run.py
@@ -0,0 +1,146 @@
+"""iter_053 실행 wrapper: pg43_run의 worker/launcher/verify_completion 재사용 + 이번 실험의 호출자 요구 대조.
+
+python rr53_run.py protocol --stage D|E|F --out P [--gate G]   # 코드·요청·자료·평가 소스 hash 잠금
+python rr53_run.py verify --out-dir D --stage D|E|F --protocol P
+생성: python pg43_run.py launch --requests results/iter_053/requests/requests_<S>.jsonl --protocol P --out-dir D --workers N --peak-gb G
+- E protocol은 D gate decision(run=true, stage=D), F protocol은 E decision(run=true, stage=E)을 요구하며, decision이 참조하는 모든 입력 파일의
+  현재 sha256을 다시 계산해 일치해야 한다 (run=true만 있는 JSON은 통과하지 못한다).
+- verify는 manifest에서 기대 요청 집합을 다시 구성해 요청 파일과 byte 단위로 비교하고(관측 출력 ID를 기대 집합으로 쓰지 않는다) completion을 재검증한다.
+"""
+import argparse
+import json
+import os
+
+import pg43_run as R
+import rr53_build as B
+import rr53_spec as S
+from rr53_data import OUT, file_sha
+from rsna_diag import generate as G
+
+LOCK = ["rr53_spec.py", "rr53_data.py", "rr53_build.py", "rr53_run.py", "rr53_eval.py", "rr53_verify.py", "rr53_gate.py", "rr53_decide.py",
+        "rr47_spec.py", "rr47_eval.py", "rsna_diag/cx18_data.py", "rsna_diag/cx18_spec.py", "rsna_diag/qa_spec.py",
+        f"{OUT}/data/data_check.json", "results/iter_018/manifests/labels.json", "results/iter_018/manifests/sets.json",
+        "results/iter_018/manifests/infer_manifest.jsonl"]
+EXPECT = {"P": dict(n=48, modality=dict(image=30, text=18)), "D": dict(n=448, modality=dict(image=272, text=176)), "E": dict(n=768, modality=dict(image=528, text=240)),
+          "F": dict(n=1680, modality=dict(image=1155, text=525))}
+GATE_STAGE = {"E": "D", "F": "E"}
+
+
+def check_gate_inputs(gate_path, want_stage):
+    g = json.load(open(gate_path))
+    if g.get("run") is not True or g.get("stage") != want_stage:
+        raise R.RunError(f"gate {gate_path}: run!=true or stage!={want_stage}")
+    if g.get("data_check_sha256") != file_sha(f"{OUT}/data/data_check.json"):
+        raise R.RunError("gate data_check digest != current data_check")
+    ins = g.get("inputs") or {}
+    if not ins:
+        raise R.RunError("gate has no input digests")
+    for name, d in ins.items():
+        if file_sha(d["path"]) != d["sha256"]:
+            raise R.RunError(f"gate input {name} changed since decision: {d['path']}")
+    return g
+
+
+def stage_files(stage):
+    return [f"{OUT}/data/manifest_{'D' if stage == 'P' else stage}.json"]
+
+
+def pilot_subset(reqs):
+    """D에서 사전 규칙으로 고른 처리량·정합성·재개 pilot (출력과 무관): 조건군(R1,R2,T,BJ,BT,BI,O,OT)마다 CheXpert D 요청 중 order_key가 앞선 6개."""
+    out = []
+    for base in ("R1", "R2", "T", "BJ", "BT", "BI", "O", "OT"):
+        cand = sorted((r for r in reqs if r["set"] == "D" and r["cond"].split("_")[0] == base), key=lambda r: r["order_key"])
+        out += cand[:6]
+    return out
+
+
+def make(stage, out, gate):
+    if stage in GATE_STAGE:
+        if not gate:
+            raise R.RunError(f"stage {stage} protocol requires the {GATE_STAGE[stage]} decision (--gate)")
+        check_gate_inputs(gate, GATE_STAGE[stage])
+    req = f"{OUT}/requests/requests_{stage}.jsonl"
+    check_requests(stage, req)
+    return R.make_protocol(req, out, adapter=None, gate=gate, lock=LOCK + stage_files(stage), extra={"stage": stage, "version": S.VERSION})
+
+
+def expected_requests(stage):
+    man = json.load(open(f"{OUT}/data/manifest_{'D' if stage == 'P' else stage}.json"))
+    cache = {}
+    if stage in ("D", "P"):
+        reqs = B.make_requests(man["rows"], "D", "with", cache)
+        reqs += B.make_requests(man["pc_oracle_rows"], "pc_D8", "only", cache)
+        if stage == "P":
+            reqs = pilot_subset(reqs)
+    else:
+        reqs = B.make_requests(man["rows"], stage, "none", cache)
+    return reqs
+
+
+def check_requests(stage, req_path):
+    got = R.read_requests(req_path)
+    exp = expected_requests(stage)
+    if len(got) != EXPECT[stage]["n"] or len(exp) != len(got):
+        raise R.RunError(f"{stage}: request count {len(got)} != plan {EXPECT[stage]['n']}")
+    key = lambda r: r["request_id"]
+    if {key(r): r for r in got} != {key(r): r for r in exp}:
+        raise R.RunError(f"{stage}: request file differs from manifest reconstruction")
+    mod = {m: sum(r["modality"] == m for r in got) for m in ("image", "text")}
+    if mod != EXPECT[stage]["modality"]:
+        raise R.RunError(f"{stage}: modality counts {mod}")
+    return got
+
+
+def verify(out_dir, stage, protocol):
+    req = f"{OUT}/requests/requests_{stage}.jsonl"
+    pdig, proto = R.verify_protocol(protocol, req)
+    if proto["requests_path"] != req:
+        raise R.RunError("protocol requests_path != requested stage requests")
+    if proto.get("adapter") is not None:
+        raise R.RunError("adapter must not be used in iter_053 (M0 only)")
+    if proto["generation_config"]["model_revision"] != G.MODEL_REVISION:
+        raise R.RunError("protocol model revision mismatch")
+    if proto["extra"].get("stage") != stage or proto["extra"].get("version") != S.VERSION:
+        raise R.RunError("protocol stage/version mismatch")
+    miss = [f for f in LOCK + stage_files(stage) if f not in proto["locked_files"]]
+    if miss:
+        raise R.RunError(f"protocol lacks required locked files: {miss}")
+    if stage in GATE_STAGE:
+        if not proto.get("gate"):
+            raise R.RunError("protocol lacks gate")
+        check_gate_inputs(proto["gate"]["decision_path"], GATE_STAGE[stage])
+    check_requests(stage, req)
+    recs = R.verify_completion(out_dir, req, protocol)
+    for r in recs:
+        if r["adapter_digest"] is not None:
+            raise R.RunError("record used an adapter")
+    return recs
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("protocol")
+    p.add_argument("--stage", required=True, choices=["P", "D", "E", "F"])
+    p.add_argument("--out", required=True)
+    p.add_argument("--gate", default=None)
+    w = sub.add_parser("write-pilot-requests")
+    v = sub.add_parser("verify")
+    v.add_argument("--stage", required=True, choices=["P", "D", "E", "F"])
+    v.add_argument("--out-dir", required=True)
+    v.add_argument("--protocol", required=True)
+    a = ap.parse_args()
+    if a.cmd == "write-pilot-requests":
+        from rr53_data import write_new
+        reqs = expected_requests("P")
+        write_new(f"{OUT}/requests/requests_P.jsonl", "".join(json.dumps(r, sort_keys=True) + "\n" for r in reqs))
+        print("pilot requests", len(reqs))
+    elif a.cmd == "protocol":
+        make(a.stage, a.out, a.gate)
+        print("protocol written", a.out)
+    else:
+        print("verified", len(verify(a.out_dir, a.stage, a.protocol)), "records")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rr53_sanity.py b/rr53_sanity.py
new file mode 100644
index 0000000..ceeea07
--- /dev/null
+++ b/rr53_sanity.py
@@ -0,0 +1,113 @@
+"""iter_053 공식 입력 구성 검사 (processor만 로드, 모델/GPU 불필요).
+
+운영 경로 G.build_inputs / G.build_inputs_text(apply_chat_template(tokenize=True))의 input_ids·pixel_values를, (a) 독립 디코드·중앙 square padding한 배열과
+(b) chat template을 문자열로 렌더링한 뒤 processor(text=..., images=...)를 직접 호출한 결과와 대조한다. text-only는 pixel_values와 image token이 없어야 한다.
+python rr53_sanity.py --stages D,E,F --out results/iter_053/tests/input_tensor.json   (기존 파일 덮어쓰기 금지)
+"""
+import argparse
+import json
+import os
+import sys
+import time
+
+import numpy as np
+from PIL import Image
+
+from rr53_data import OUT
+from rsna_diag import generate as G
+
+
+def independent_padded(path):
+    a = np.asarray(Image.open(path))
+    assert a.dtype == np.uint8
+    rgb = np.repeat(a[:, :, None], 3, axis=2) if a.ndim == 2 else a
+    h, w = rgb.shape[:2]
+    side = max(h, w)
+    top, left = (side - h) // 2, (side - w) // 2
+    out = np.zeros((side, side, 3), np.uint8)
+    out[top:top + h, left:left + w] = rgb
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--stages", default="D,E,F")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("refuse to overwrite")
+    os.environ.setdefault("HF_HOME", G.HF_HOME)
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    import torch
+    import transformers
+    proc = transformers.AutoProcessor.from_pretrained(G.MODEL_ID, revision=G.MODEL_REVISION)
+    img_tok = proc.tokenizer.convert_tokens_to_ids("<image_soft_token>")  # <start_of_image> 1개 + 이 token 256개가 영상 자리
+    assert img_tok is not None and img_tok != proc.tokenizer.unk_token_id
+    checks = dict(n=0, image=0, text=0, pad_array_mismatch=0, ids_mismatch=0, pixel_mismatch=0, text_has_image=0, image_token_count_bad=0,
+                  prompt_not_in_decoded=0, template_shape_bad=0)
+    bad = []
+    seen = set()
+    t0 = time.time()
+    for st in a.stages.split(","):
+        rows = [json.loads(l) for l in open(f"{OUT}/requests/requests_{st}.jsonl")]
+        for r in rows:
+            key = (r["image"], r["prompt_sha256"], r["modality"])
+            if key in seen:
+                continue
+            seen.add(key)
+            checks["n"] += 1
+            if r["modality"] == "image":
+                checks["image"] += 1
+                img, aff, px = G.load_image(r["image"])
+                ind = independent_padded(r["image"])
+                if not np.array_equal(np.asarray(img), ind) or px != r["input_pixel_sha256"]:
+                    checks["pad_array_mismatch"] += 1
+                    bad.append(("pad", r["request_id"]))
+                prod = G.build_inputs(proc, img, r["prompt"])
+                msgs = [{"role": "user", "content": [{"type": "image"}, {"type": "text", "text": r["prompt"]}]}]
+                txt = proc.apply_chat_template(msgs, add_generation_prompt=True, tokenize=False)
+                man = proc(text=txt, images=[Image.fromarray(ind)], return_tensors="pt", add_special_tokens=False)  # template 문자열이 이미 <bos>를 가진다
+                if not torch.equal(prod["input_ids"], man["input_ids"]):
+                    checks["ids_mismatch"] += 1
+                    bad.append(("ids", r["request_id"]))
+                if not torch.equal(prod["pixel_values"], man["pixel_values"]):
+                    checks["pixel_mismatch"] += 1
+                    bad.append(("pix", r["request_id"]))
+                n_img = int((prod["input_ids"] == img_tok).sum())
+                if n_img != proc.image_seq_length or tuple(prod["pixel_values"].shape) != (1, 3, 896, 896):
+                    checks["image_token_count_bad"] += 1
+                    bad.append(("imgtok", r["request_id"], n_img, tuple(prod["pixel_values"].shape)))
+                ids = prod["input_ids"][0].tolist()
+            else:
+                checks["text"] += 1
+                prod = G.build_inputs_text(proc, r["prompt"])
+                msgs = [{"role": "user", "content": [{"type": "text", "text": r["prompt"]}]}]
+                txt = proc.apply_chat_template(msgs, add_generation_prompt=True, tokenize=False)
+                man = proc(text=txt, return_tensors="pt", add_special_tokens=False)
+                if not torch.equal(prod["input_ids"], man["input_ids"]):
+                    checks["ids_mismatch"] += 1
+                    bad.append(("ids_text", r["request_id"]))
+                if "pixel_values" in prod or any(k.startswith("pixel") for k in prod) or int((prod["input_ids"] == img_tok).sum()) != 0:
+                    checks["text_has_image"] += 1
+                    bad.append(("text_image", r["request_id"]))
+                ids = prod["input_ids"][0].tolist()
+            dec = proc.tokenizer.decode(ids, skip_special_tokens=False)
+            if r["prompt"] not in dec:
+                checks["prompt_not_in_decoded"] += 1
+                bad.append(("prompt", r["request_id"]))
+            if not (dec.count("<start_of_turn>user") == 1 and dec.endswith("<start_of_turn>model\n") and "<end_of_turn>\n<start_of_turn>model\n" in dec):
+                checks["template_shape_bad"] += 1
+                bad.append(("template", r["request_id"]))
+    passed = all(v == 0 for k, v in checks.items() if k not in ("n", "image", "text"))
+    res = dict(passed=passed, checks=checks, bad=bad[:20], seconds=time.time() - t0, stages=a.stages, model_revision=G.MODEL_REVISION,
+               transformers=transformers.__version__, torch=torch.__version__, chat_template_sha256=G.sha((proc.chat_template or "").encode()),
+               image_seq_length=proc.image_seq_length, image_size=str(proc.image_processor.size))
+    tmp = a.out + ".tmp"
+    json.dump(res, open(tmp, "w"), indent=1)
+    os.replace(tmp, a.out)
+    print(json.dumps(res, indent=1))
+    sys.exit(0 if passed else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rr53_spec.py b/rr53_spec.py
new file mode 100644
index 0000000..02426bf
--- /dev/null
+++ b/rr53_spec.py
@@ -0,0 +1,66 @@
+"""iter_053 CheXpert 교정·보존 진단: 고정 상수·prompt·평가 규칙 (CPU only).
+
+rr47_spec의 상태 parser·finding 문장·R1/R2/BJ/BI prompt를 그대로 재사용한다(승인 범위: 상태 parser). 이 파일이 바꾸는 것:
+(1) T는 R2 텍스트와 byte-identical (영상만 제거; 영상 부재 안내·uncertain 유도 없음), (2) BT = BJ 텍스트 byte-identical 영상 제거,
+(3) oracle O2 = 기존 O + 출처 우선순위 문장, (4) 새 version/seed. GT/truth는 평가 함수에만 인자로 들어간다.
+"""
+import rr47_spec as B
+
+VERSION = "rr53_v1"
+SEED = 5301
+BOOT_SEED = 5302
+BOOT_B = 10000
+CAPS = B.CAPS
+IDS = B.IDS
+STATES = B.STATES
+DRAFT_CODES = B.DRAFT_CODES
+FINDING_PAIR = {"qA": "cardiomegaly", "qB": "effusion"}   # CheXpert 고정 두 finding (cardiomegaly / pleural effusion)
+FINDINGS = B.FINDINGS
+sha = B.sha
+canon = B.canon
+flip = B.flip
+code_states = B.code_states
+draft_code = B.draft_code
+draft_text = B.draft_text
+parse_state = B.parse_state
+final_state = B.final_state
+render_final = B.render_final
+
+AUTH_SENTENCE = ("For this consistency check, the verified final status is authoritative. Copy it exactly; "
+                 "do not infer a different status from the draft or image.")
+
+prompt_R1 = B.prompt_R1
+prompt_R2 = B.prompt_R2
+prompt_BJ = B.prompt_BJ
+prompt_BI = B.prompt_BI
+
+
+def prompt_T(items):
+    """R2와 byte-identical (영상만 요청에서 제거)."""
+    return B.prompt_R2(items)
+
+
+def prompt_BT(finding_pair):
+    """BJ와 byte-identical (영상만 요청에서 제거)."""
+    return B.prompt_BJ(finding_pair)
+
+
+def prompt_O2(items, truth_pair):
+    """기존 O prompt + 출처 우선순위 문장(사전 고정). 같은 텍스트를 image/text 두 modality에 쓴다."""
+    base = B.prompt_O(items, truth_pair)
+    marker = "Return the verified final status of each finding."
+    assert base.count(marker) == 1
+    return base.replace(marker, marker + " " + AUTH_SENTENCE)
+
+
+def request_id(kind, patient, cond, targets, prompt_sha, image_sha):
+    return sha(f"{VERSION}|{kind}|{patient}|{cond}|{','.join(targets)}|{prompt_sha}|{image_sha}")[:32]
+
+
+def code_of_category(cat):
+    """'present_absent' -> '10' (qA=cardiomegaly, qB=pleural effusion)."""
+    cm, pe = cat.split("_")
+    return f"{int(cm == 'present')}{int(pe == 'present')}"
+
+
+CATEGORY_OF_CODE = {"00": "absent_absent", "01": "absent_present", "10": "present_absent", "11": "present_present"}
diff --git a/rr53_verify.py b/rr53_verify.py
new file mode 100644
index 0000000..d652817
--- /dev/null
+++ b/rr53_verify.py
@@ -0,0 +1,295 @@
+"""iter_053 독립 검증기. production(rr53_eval/rr47_eval/rr53_spec의 parser·점수·bootstrap)을 호출하지 않고 원시 record·요청·manifest·labels에서
+다시 계산해 저장 report와 대조한다. 모든 조건·지표·diff·동시 보정 구간·공통 valid·oracle·valid율을 검사하고, 불일치 항목을 제외한 PASS를 만들지 않는다.
+
+python rr53_verify.py --stage D|E|F --out-dir D --protocol P --report REPORT --out verify.json
+(completion·요청 집합·hash 연결은 rr53_run.verify가 담당한다 — 점수 계산이 아니다.)
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+import sys
+
+import numpy as np
+
+import rr53_run
+from rr53_data import OUT
+
+ANS = {"present", "absent", "uncertain"}
+DRAFTS = ["00", "01", "10", "11"]
+IDS = ("qA", "qB")
+SIMULT_LEVEL = 1 - 0.05 / 8
+
+
+def sha_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def parse_raw(raw, eos, keys):
+    """독립 parser: 상태 dict 또는 None(invalid)."""
+    if not eos:
+        return None
+    t = raw
+    if t.endswith("<end_of_turn>"):
+        t = t[: -len("<end_of_turn>")]
+    if "<unused94>" in t or "<unused95>" in t:
+        i, j = t.find("<unused94>"), t.find("<unused95>")
+        if not (t.lstrip().startswith("<unused94>") and t.count("<unused94>") == 1 and t.count("<unused95>") == 1 and i < j):
+            return None
+        t = t[j + len("<unused95>"):]
+    t = t.strip()
+    m = re.fullmatch(r"```(?:json|JSON)?[ \t]*\n(.*?)\n?```", t, flags=re.S)
+    if m:
+        t = m.group(1).strip()
+    if "`" in t or not t.startswith("{") or not t.endswith("}"):
+        return None
+    pairs = []
+    try:
+        obj = json.loads(t, object_pairs_hook=lambda p: (pairs.extend(p), dict(p))[1])
+    except ValueError:
+        return None
+    if len([k for k, _ in pairs]) != len({k for k, _ in pairs}):
+        return None
+    if not isinstance(obj, dict) or set(obj) != set(keys) or len(obj) != len(keys):
+        return None
+    if any((not isinstance(v, str)) or v not in ANS for v in obj.values()):
+        return None
+    return obj
+
+
+def bits(code):
+    return ["present" if ch == "1" else "absent" for ch in code]
+
+
+def final_of(parsed, pid, cond, d, i, ds_k):
+    """(상태, valid). K는 초안 그대로."""
+    if cond == "K":
+        return ds_k, True
+    key = {"R1": f"R1_d{d}", "R2": f"R2_d{d}", "T": f"T_d{d}", "BJ": "BJ", "BT": "BT", "BI": f"BI_{i}"}[cond]
+    p = parsed[(pid, key)]
+    return (p[i] if p else "invalid"), p is not None
+
+
+def per_patient(manifest, parsed):
+    out = {}
+    for m in manifest["rows"]:
+        pid = m["PatientID"]
+        truth = [m["q"][i]["state"] for i in IDS]
+        res, sts = {}, {}
+        for cond in ["K", "R1", "R2", "T", "BJ", "BT", "BI"]:
+            fixed = harmed = hfail = corr = 0
+            clean = False
+            allok = True
+            seq = [[], []]
+            ss = []
+            for d in DRAFTS:
+                ds = bits(d)
+                fin = []
+                for k, i in enumerate(IDS):
+                    v, ok = final_of(parsed, pid, cond, d, i, ds[k])
+                    fin.append(v)
+                    seq[k].append(v)
+                    corr += v == truth[k]
+                    wrong = ds[k] != truth[k]
+                    if wrong:
+                        fixed += v == truth[k]
+                    else:
+                        harmed += v == ("absent" if truth[k] == "present" else "present")
+                        hfail += v != truth[k]
+                    ss.append((d, i, wrong, v == truth[k], ok))
+                both = all(fin[k] == truth[k] for k in range(2))
+                allok = allok and both
+                if ds == truth:
+                    clean = both
+            res[cond] = dict(r=fixed / 4, h=harmed / 4, h_fail=hfail / 4, acc=corr / 8, clean_exact=float(clean), robust_exact=float(allok),
+                             sens=sum(len(set(s)) > 1 for s in seq) / 2)
+            sts[cond] = ss
+        out[pid] = dict(stratum=m["truth_code"], metrics=res, states=sts, truth=truth)
+    return out
+
+
+def draws(strata, B=10000, seed=5302):
+    rng = np.random.default_rng(seed)
+    return [rng.integers(0, len(v), size=(B, len(v))) for v in strata]
+
+
+def compare(stage, reqs, recs, manifest, report, labels):
+    """원시 record에서 모든 수치를 다시 계산해 report와 대조한다. returns (mismatches, n_checked, parsed)."""
+    bad = []
+    # GT 독립 대조: manifest 상태 == labels.json (원천 HF label 대응은 data_check가 검증)
+    for m in manifest["rows"]:
+        L = labels[m["PatientID"]]
+        if (m["q"]["qA"]["state"], m["q"]["qB"]["state"]) != (L["cardiomegaly"], L["pleural_effusion"]):
+            bad.append(("manifest_truth_vs_labels", m["PatientID"]))
+    rec = {r["request_id"]: r for r in recs}
+    parsed = {}
+    for q in reqs:
+        r = rec[q["request_id"]]
+        parsed[(q["patient"], q["cond"])] = parse_raw(r["suffix_text_raw"], r["ended_eos"], q["targets"])
+    pp = per_patient(manifest, parsed)
+    byst = {}
+    for pid in sorted(pp):
+        byst.setdefault(pp[pid]["stratum"], []).append(pid)
+    skeys = sorted(byst)
+    strata = [byst[k] for k in skeys]
+    dr = draws(strata)
+    N = len(pp)
+    metrics = ["r", "h", "h_fail", "acc", "clean_exact", "robust_exact", "sens"]
+    n_checked = 0
+
+    def close(x, y, tol=1e-9):
+        return abs(x - y) <= tol
+
+    def samp(cond, m):
+        tot = 0
+        for pids, idx in zip(strata, dr):
+            v = np.array([pp[p]["metrics"][cond][m] for p in pids], float)
+            tot = tot + v[idx].mean(axis=1)
+        return tot / len(strata)
+
+    def macro(cond, m):
+        return sum(sum(pp[p]["metrics"][cond][m] for p in pids) / len(pids) for pids in strata) / len(strata)
+
+    for cond, md in report["conds"].items():
+        for m in metrics:
+            s = samp(cond, m)
+            lo, hi = np.percentile(s, 2.5), np.percentile(s, 97.5)
+            nat = sum(pp[p]["metrics"][cond][m] for p in pp) / N
+            n_checked += 1
+            if not (close(macro(cond, m), md[m]["mean"]) and close(nat, md[m]["natural_mean"]) and close(lo, md[m]["lo95"]) and close(hi, md[m]["hi95"])):
+                bad.append(("cond", cond, m, macro(cond, m), md[m]))
+            if "simult_lo" in md[m]:
+                slo, shi = np.percentile(s, (1 - SIMULT_LEVEL) / 2 * 100), np.percentile(s, 100 - (1 - SIMULT_LEVEL) / 2 * 100)
+                n_checked += 1
+                if not (close(slo, md[m]["simult_lo"]) and close(shi, md[m]["simult_hi"]) and close(md[m]["simult_level"], SIMULT_LEVEL)):
+                    bad.append(("simult", cond, m, slo, shi, md[m]))
+                # 퇴화 exact 경계
+                allzero = all((pp[p]["metrics"][cond]["h_fail"] == 0) if m == "h_fail" else (pp[p]["metrics"][cond]["r"] == 1) for p in pp)
+                n_checked += 1
+                dg = md[m].get("degenerate_exact")
+                if allzero != (dg is not None):
+                    bad.append(("degenerate_flag", cond, m, allzero, dg))
+                elif allzero:
+                    a_ = 0.05 / (len(strata) * 8)
+                    ub = sum(1 - a_ ** (1 / len(pids)) for pids in strata) / len(strata)
+                    if not close(ub, dg["any_event_patient_fraction_upper"]):
+                        bad.append(("degenerate_bound", cond, m, ub, dg))
+    for key, dd in report["diffs"].items():
+        ab, m = key.split(":")
+        x, y = ab.split("-")
+        s = samp(x, m) - samp(y, m)
+        al = (1 - dd["level"]) / 2 * 100
+        n_checked += 1
+        if not (close(macro(x, m) - macro(y, m), dd["mean"]) and close(np.percentile(s, al), dd["lo"]) and close(np.percentile(s, 100 - al), dd["hi"])
+                and bool(np.ptp(s) == 0) == dd["degenerate"]):
+            bad.append(("diff", key, macro(x, m) - macro(y, m), dd))
+    # 공통 valid 보조 분석
+    for key, cv in report["common_valid"].items():
+        x, y = key.split("-")
+        keep = {}
+        for p in pp:
+            for (d, i, _w, _ok, vx), (_d, _i, _w2, _ok2, vy) in zip(pp[p]["states"][x], pp[p]["states"][y]):
+                keep[(p, d, i)] = vx and vy
+
+        def rates(c):
+            rr, hh = [], []
+            for pids in strata:
+                fw = nw = hf = nr = 0
+                for p in pids:
+                    for (d, i, wrong, ok, _v) in pp[p]["states"][c]:
+                        if not keep[(p, d, i)]:
+                            continue
+                        if wrong:
+                            nw += 1
+                            fw += ok
+                        else:
+                            nr += 1
+                            hf += not ok
+                rr.append(fw / nw if nw else float("nan"))
+                hh.append(hf / nr if nr else float("nan"))
+            return float(np.nanmean(rr)), float(np.nanmean(hh))
+        ra, ha = rates(x)
+        rb, hb = rates(y)
+        n_checked += 1
+        if not (cv["n_common_valid_states"] == sum(keep.values()) and close(cv["r_diff"], ra - rb) and close(cv["hfail_diff"], ha - hb)):
+            bad.append(("common_valid", key, ra - rb, ha - hb, cv))
+    # valid율·형식·비EOS
+    nonO = [(c, v) for (p, c), v in parsed.items() if not c.startswith(("O_", "OT_"))]
+    n_checked += 1
+    if sum(v is not None for _, v in nonO) != report["n_valid_requests_nonoracle"] or len(nonO) != report["n_requests_nonoracle"]:
+        bad.append(("n_valid", sum(v is not None for _, v in nonO), report["n_valid_requests_nonoracle"]))
+    n_checked += 1
+    if sum(1 for q in reqs if not rec[q["request_id"]]["ended_eos"]) != report["n_non_eos_final"]:
+        bad.append(("non_eos", report["n_non_eos_final"]))
+    per_cond = {}
+    for (p, c), v in parsed.items():
+        if c.startswith(("O_", "OT_")):
+            continue
+        b = c.split("_")[0] if c.startswith(("R1", "R2", "T_", "BI")) else c
+        per_cond.setdefault(b, [0, 0])
+        per_cond[b][1] += 1
+        per_cond[b][0] += v is not None
+    for b, (k, n) in per_cond.items():
+        n_checked += 1
+        if not close(k / n, report["valid_rate_by_cond"][b]):
+            bad.append(("valid_rate", b, k / n, report["valid_rate_by_cond"][b]))
+    # oracle (D): 정답 상태와 결정론적 문장 렌더링
+    if stage == "D":
+        groups = {"chexpert_D16": manifest["rows"], "padchest_D8": manifest["pc_oracle_rows"]}
+        for name, rows in groups.items():
+            for pref, mod in (("O_d", "image"), ("OT_d", "text")):
+                n = ok = 0
+                for m in rows:
+                    truth = {i: m["q"][i]["state"] for i in IDS}
+                    for d in DRAFTS:
+                        n += 1
+                        ok += parsed[(m["PatientID"], pref + d)] == truth
+                n_checked += 1
+                ro = report["oracle"][f"{name}:{mod}"]
+                if not (ro["n"] == n and ro["ok"] == ok):
+                    bad.append(("oracle", name, mod, n, ok, ro["n"], ro["ok"]))
+    return bad, n_checked, parsed
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--report", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit(f"refuse to overwrite {a.out}")
+    recs = rr53_run.verify(a.out_dir, a.stage, a.protocol)
+    req_path = f"{OUT}/requests/requests_{a.stage}.jsonl"
+    reqs = [json.loads(l) for l in open(req_path)]
+    man_path = f"{OUT}/data/manifest_{a.stage}.json"
+    manifest = json.load(open(man_path))
+    report = json.load(open(a.report))
+    labels = json.load(open("results/iter_018/manifests/labels.json"))
+    bad, n_checked, parsed = compare(a.stage, reqs, recs, manifest, report, labels)
+    src_now = dict(protocol_sha256=sha_file(a.protocol), requests_sha256=sha_file(req_path), manifest_sha256=sha_file(man_path),
+                   eval_sha256=sha_file("rr53_eval.py"), data_check_sha256=sha_file(f"{OUT}/data/data_check.json"),
+                   worker_files_sha256={f: sha_file(os.path.join(a.out_dir, f)) for f in sorted(os.listdir(a.out_dir))
+                                        if f.startswith("gen_worker") and f.endswith(".jsonl")})
+    for k, v in src_now.items():
+        n_checked += 1
+        if report["source"][k] != v:
+            bad.append(("report_source_digest", k))
+    res = dict(stage=a.stage, n_checked=n_checked, mismatches=bad, passed=(not bad), n_records=len(recs), n_valid_parse=sum(v is not None for v in parsed.values()),
+               source_digests=dict(report=sha_file(a.report), verify_py=sha_file("rr53_verify.py"), **src_now))
+    tmp = a.out + ".tmp"
+    json.dump(res, open(tmp, "w"), indent=1, default=str)
+    os.replace(tmp, a.out)
+    print("PASS" if res["passed"] else "FAIL", n_checked, "checks;", len(bad), "mismatches")
+    sys.exit(0 if res["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
