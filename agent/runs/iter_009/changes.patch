index 0000000..1b813c4
--- /dev/null
+++ b/rsna_diag/diagnostics.py
@@ -0,0 +1,78 @@
+"""탐색적 오류 분해 진단 (iter_009). 주평가·주지표를 바꾸지 않는다. 결과는 exploratory로만 보고한다.
+
+- 좌표 규약 대안(x/y 뒤바뀜, 좌우/상하 반전)을 GT에 적용했을 때 max-IoU가 개선되는지: 사용법(축·좌우) 오류 vs 내용 오류 구분.
+- 예측 박스 크기/중심 분포, 반복 loop(박스 수 과다) 비율, 예측이 GT 좌/우 폐야 어느 쪽인지 (좌우 일치율).
+사용: python -m rsna_diag.diagnostics --gen ... --split development --out results/iter_009/dev/diagnostics.json
+"""
+import argparse
+import json
+
+import numpy as np
+
+from . import metrics as M, parse as PA
+from .evaluate import PROMPTS, gt_boxes, load_gen
+
+
+def transforms(b):
+    y0, x0, y1, x1 = b
+    return {"as_is": [y0, x0, y1, x1], "swap_xy": [x0, y0, x1, y1],
+            "mirror_lr": [y0, 1000 - x1, y1, 1000 - x0], "flip_ud": [1000 - y1, x0, 1000 - y0, x1],
+            "rot180": [1000 - y1, 1000 - x1, 1000 - y0, 1000 - x0]}
+
+
+def center(b):
+    return ((b[0] + b[2]) / 2, (b[1] + b[3]) / 2)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--gen", required=True)
+    ap.add_argument("--split", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--gt", default="results/iter_009/manifests/gt_manifest.json")
+    a = ap.parse_args()
+    gt = json.load(open(a.gt))
+    recs = load_gen(a.gen)
+    pos = sorted(i for i, g in gt.items() if g["split"] == a.split and g["category"] == "opacity")
+    out = {"split": a.split, "note": "exploratory; 주평가/주지표 변경 없음", "prompts": {}}
+    for p in PROMPTS:
+        ids, alt = [], {k: [] for k in transforms([0, 0, 1, 1])}
+        n_boxes, sizes, gsizes, cdist, side_match, side_n = [], [], [], [], 0, 0
+        loops = 0
+        for i in pos:
+            r = recs.get((i, p))
+            if r is None:
+                continue
+            pr = PA.parse_response(r["suffix_text_raw"], r["ended_eos"])
+            if r["n_output_tokens"] > 1000 or len(pr["boxes"]) > 10:
+                loops += 1
+            if pr["status"] != "valid_nonempty":
+                continue
+            g = gt_boxes(gt[i])
+            ids.append(i)
+            n_boxes.append(len(pr["boxes"]))
+            for name in alt:
+                alt[name].append(max(M.iou(transforms(b)[name], gb) for b in pr["boxes"] for gb in g))
+            sizes.append(M.union_area(pr["boxes"]) / 1e6)
+            gsizes.append(M.union_area(g) / 1e6)
+            pc = np.mean([center(b) for b in pr["boxes"]], axis=0)
+            gc = np.mean([center(b) for b in g], axis=0)
+            cdist.append(float(np.hypot(*(pc - gc))))
+            if len(pr["boxes"]) == 1 and len(g) == 1:  # 단일 박스끼리: 좌우 반쪽 일치
+                side_n += 1
+                side_match += int((center(pr["boxes"][0])[1] < 500) == (center(g[0])[1] < 500))
+        f = lambda v: float(np.mean(v)) if len(v) else None
+        out["prompts"][p] = {
+            "n_valid_nonempty_positive": len(ids),
+            "mean_max_iou_by_convention": {k: f(v) for k, v in alt.items()},
+            "frac_max_iou_ge_0.3_by_convention": {k: (float(np.mean(np.array(v) >= 0.3)) if v else None) for k, v in alt.items()},
+            "mean_n_pred": f(n_boxes), "pred_union_area_frac_mean": f(sizes), "gt_union_area_frac_mean": f(gsizes),
+            "center_distance_mean_(0-1000 units)": f(cdist), "center_distance_median": float(np.median(cdist)) if cdist else None,
+            "single_box_side_agreement": {"k": side_match, "n": side_n},
+            "n_looping_or_long_outputs": loops}
+    json.dump(out, open(a.out, "w"), indent=1)
+    print(json.dumps(out, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/dicom_min.py b/rsna_diag/dicom_min.py
new file mode 100644
index 0000000..425e140
--- /dev/null
+++ b/rsna_diag/dicom_min.py
@@ -0,0 +1,105 @@
+"""최소 DICOM 리더 (pydicom 미설치, pip 불가). RSNA 배포본(Explicit VR LE, JPEG baseline 1.2.840.10008.1.2.4.50)만 지원.
+
+지원하지 않는 전송 구문·태그 조합은 예외를 던져 입력 gate를 실패시킨다 (조용히 추정하지 않는다).
+"""
+import io
+import struct
+
+from PIL import Image
+
+EXPLICIT_LE = "1.2.840.10008.1.2.1"
+JPEG_BASELINE = "1.2.840.10008.1.2.4.50"
+LONG_VR = {"OB", "OW", "OF", "SQ", "UT", "UN", "OD", "OL", "UC", "UR"}
+WANT = {
+    (0x0002, 0x0010): "TransferSyntaxUID",
+    (0x0008, 0x0018): "SOPInstanceUID",
+    (0x0010, 0x0020): "PatientID",
+    (0x0028, 0x0002): "SamplesPerPixel",
+    (0x0028, 0x0004): "PhotometricInterpretation",
+    (0x0028, 0x0010): "Rows",
+    (0x0028, 0x0011): "Columns",
+    (0x0028, 0x0100): "BitsAllocated",
+    (0x0028, 0x0101): "BitsStored",
+    (0x0028, 0x0102): "HighBit",
+    (0x0028, 0x0103): "PixelRepresentation",
+    (0x0028, 0x1050): "WindowCenter",
+    (0x0028, 0x1051): "WindowWidth",
+    (0x0028, 0x1052): "RescaleIntercept",
+    (0x0028, 0x1053): "RescaleSlope",
+    (0x0028, 0x0030): "PixelSpacing",
+    (0x0028, 0x2110): "LossyImageCompression",
+    (0x0018, 0x5101): "ViewPosition",
+    (0x0008, 0x0060): "Modality",
+}
+
+
+def _val(vr, raw):
+    if vr in ("US",):
+        return struct.unpack("<H", raw[:2])[0]
+    if vr in ("UL",):
+        return struct.unpack("<I", raw[:4])[0]
+    return raw.decode("latin-1").rstrip("\x00 ").strip()
+
+
+def parse(data):
+    """returns (tags dict, pixel_fragments list[bytes] or native bytes)."""
+    if data[128:132] != b"DICM":
+        raise ValueError("not DICOM part-10")
+    pos, n = 132, len(data)
+    tags = {}
+    pixel = None
+    while pos + 8 <= n:
+        g, e = struct.unpack("<HH", data[pos:pos + 4])
+        vr = data[pos + 4:pos + 6].decode("latin-1")
+        if vr in LONG_VR:
+            ln = struct.unpack("<I", data[pos + 8:pos + 12])[0]
+            hdr = 12
+        else:
+            ln = struct.unpack("<H", data[pos + 6:pos + 8])[0]
+            hdr = 8
+        if g == 0x7FE0 and e == 0x0010:
+            body = pos + hdr
+            if ln == 0xFFFFFFFF:
+                frags, p = [], body
+                while True:
+                    tg, te, tl = struct.unpack("<HHI", data[p:p + 8])
+                    p += 8
+                    if (tg, te) == (0xFFFE, 0xE0DD):
+                        break
+                    if (tg, te) != (0xFFFE, 0xE000):
+                        raise ValueError("bad encapsulated item")
+                    frags.append(data[p:p + tl])
+                    p += tl
+                pixel = frags
+            else:
+                pixel = data[body:body + ln]
+            break
+        if ln == 0xFFFFFFFF:  # 정의 안 된 길이 시퀀스: 지원하지 않는다 (관심 태그 밖이면 전체 스캔 실패로 처리)
+            raise ValueError(f"undefined-length element ({g:04x},{e:04x}) unsupported")
+        if (g, e) in WANT:
+            tags[WANT[(g, e)]] = _val(vr, data[pos + hdr:pos + hdr + ln])
+        pos += hdr + ln
+    return tags, pixel
+
+
+def read_pixels(data):
+    """DICOM bytes -> (meta dict, np.uint8 array (H,W) 또는 (H,W,3))."""
+    import numpy as np
+    tags, pixel = parse(data)
+    if tags.get("TransferSyntaxUID") != JPEG_BASELINE:
+        raise ValueError(f"unsupported transfer syntax {tags.get('TransferSyntaxUID')}")
+    if not isinstance(pixel, list) or len(pixel) < 1:
+        raise ValueError("expected encapsulated pixel data")
+    # 첫 item은 basic offset table일 수 있다 (길이 0이면 빈 table). 단일 frame: JPEG SOI(FFD8)로 시작하는 fragment를 이어붙인다.
+    frames = [f for f in pixel if len(f) > 0]
+    jpeg = b"".join(frames)
+    if jpeg[:2] != b"\xff\xd8":
+        raise ValueError("no JPEG SOI")
+    im = Image.open(io.BytesIO(jpeg))
+    im.load()
+    arr = np.asarray(im)
+    meta = dict(tags)
+    meta["pil_mode"] = im.mode
+    meta["array_shape"] = list(arr.shape)
+    meta["array_dtype"] = str(arr.dtype)
+    return meta, arr
