+                      n_patients=len(grp), n_eligible_cross=len(pairs), pair_mean_over_eligible=float(np.mean(pairs)) if pairs else None,
+                      margin_mean=float(np.mean([m for i in infos if i["margin"] for m in i["margin"]])) if pairs else None,
