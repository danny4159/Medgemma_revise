+    return out
+
+
+def patient_f1(gen_dir, man, thr):
+    recs = []
+    for fn in sorted(glob.glob(os.path.join(gen_dir, "gen_worker*.jsonl"))):
+        for ln in open(fn):
+            if ln.strip():
