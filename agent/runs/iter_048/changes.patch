+"""iter_048 학습 run-dir 배타 lock 검사: 다른 live 프로세스가 같은 run-dir lock을 잡고 있을 때 pg48_train.py train이 모델 로딩 전에 거부하는지 확인한다 (GPU 불필요).
+python pg48_locktest.py --out results/iter_048/tests/lock_test.json
+"""
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+
+from rsna_diag import queue_lock
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    d = "results/iter_048/tests/lock_run"
+    os.makedirs(d, exist_ok=True)
+    lk, own, rec = queue_lock.try_lock(os.path.join(os.path.realpath(d), "train.lock"), queue_lock.my_info(role="locktest_holder"))
+    assert lk is not None
+    t0 = time.time()
+    r = subprocess.run([sys.executable, "pg48_train.py", "train", "--run-dir", d, "--protocol", "results/iter_048/protocol/train_protocol_v1.json", "--mode", "joint",
+                        "--init-adapter", "results/iter_040/train2/C_s17/epoch_03", "--epochs", "1", "--max-patients", "8"], capture_output=True, text=True, timeout=300)
+    dt = time.time() - t0
+    lk.release()
+    out = {"second_trainer_rc": r.returncode, "seconds": dt, "message": (r.stderr + r.stdout)[-250:],
+           "ok": r.returncode != 0 and "owned by another live process" in (r.stderr + r.stdout) and dt < 60 and not os.path.exists(os.path.join(d, "train_config.json"))}
+    json.dump(out, open(a.out, "w"), indent=1)
+    print(json.dumps(out, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_requests.py b/pg48_requests.py
new file mode 100644
index 0000000..37b172a
--- /dev/null
+++ b/pg48_requests.py
@@ -0,0 +1,90 @@
+"""iter_048 요청 행렬 생성 (CPU). 요청은 adapter와 무관하다(adapter는 protocol에 잠긴다). GT/labels는 읽지 않는다.
+
+  python pg48_requests.py --out-dir results/iter_048/requests
+환자 x {I-short qA, I-short qB, J-short AB(qA 먼저), J-short-rev BA(qB 먼저)}: D24 96 / V96 384 / D8(D24 앞 8 지정 환자) 32.
+기존 iter_041 요청(C의 V96 J, D24)과 prompt·caps·영상·hash가 같은지 대조해 summary에 남긴다(request_id 규칙 pg39_spec.request_id와 kind 동일 -> 같은 행은 같은 id).
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+import pg39_spec as S
+
+MAN = "results/iter_043/data/manifest_private.json"
+OLD = {"D24": "results/iter_041/requests/requests_D24_C.jsonl", "V96": ["results/iter_041/requests/requests_V96_JAB.jsonl",
+                                                                    "results/iter_041/requests/requests_V96_JBA.jsonl"]}
+
+
+def sha(s):
+    return hashlib.sha256(s.encode()).hexdigest()
+
+
+def rows_for(kind, ents):
+    out = []
+    for e in ents:
+        sents = e["sentences"]
+        okey = sha(e["PatientID"])
+        base = {"kind": kind, "patient": e["PatientID"], "image_id": e["ImageID"], "image": e["image"], "image_file_sha256": e["image_file_sha256"],
+                "input_pixel_sha256": e["input_pixel_sha256"], "modality": "image"}
+        for t in ("qA", "qB"):
+            p = S.prompt_I_short(sents[t], t)
+            out.append(dict(base, cond="I-short", targets=[t], prompt=p, prompt_sha256=sha(p), caps=list(S.CAPS_IC), order_key=f"{okey}_I_{t}"))
+        pab = S.prompt_J_short([("qA", sents["qA"]), ("qB", sents["qB"])])
+        pba = S.prompt_J_short([("qB", sents["qB"]), ("qA", sents["qA"])])
+        out.append(dict(base, cond="J-short", targets=["qA", "qB"], prompt=pab, prompt_sha256=sha(pab), caps=list(S.CAPS_J), order_key=f"{okey}_JAB"))
+        out.append(dict(base, cond="J-short-rev", targets=["qA", "qB"], prompt=pba, prompt_sha256=sha(pba), caps=list(S.CAPS_J), order_key=f"{okey}_JBA"))
+    for r in out:
+        r["request_id"] = S.request_id(r["kind"], r["patient"], r["cond"], r["targets"], r["prompt_sha256"], r["image_file_sha256"])
+    ids = [r["request_id"] for r in out]
+    if len(ids) != len(set(ids)):
+        raise RuntimeError("duplicate request ids")
+    return out
+
+
+def write_new(path, rows):
+    if os.path.exists(path):
+        raise RuntimeError(f"exists: {path}")
+    tmp = path + f".{os.getpid()}.tmp"
+    with open(tmp, "w") as f:
+        for r in sorted(rows, key=lambda r: r["order_key"]):
+            f.write(json.dumps(r) + "\n")
+    os.replace(tmp, path)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out-dir", required=True)
+    a = ap.parse_args()
+    os.makedirs(a.out_dir, exist_ok=True)
+    man = json.load(open(MAN))
+    d24, v96 = man["D24"], man["V96"]
+    d8set = set(man["D8"])
+    built = {"D24": rows_for("D24", d24), "V96": rows_for("V96", v96), "D8": rows_for("D8", [e for e in d24 if e["PatientID"] in d8set])}
+    summ = {"counts": {k: len(v) for k, v in built.items()}, "manifest_sha256": hashlib.sha256(open(MAN, "rb").read()).hexdigest()}
+    # iter_041 대조
+    cmpres = {}
+    for k, files in (("D24", [OLD["D24"]]), ("V96", OLD["V96"])):
+        old = [json.loads(l) for fn in files for l in open(fn) if l.strip()]
+        new = {(r["patient"], r["cond"], tuple(r["targets"])): r for r in built[k]}
+        mism, matched = [], 0
+        for o in old:
+            n = new.get((o["patient"], o["cond"], tuple(o["targets"])))
+            if n is None or any(n[f] != o[f] for f in ("prompt", "prompt_sha256", "caps", "image", "image_file_sha256", "input_pixel_sha256", "request_id")):
+                mism.append(o["request_id"])
+            else:
+                matched += 1
+        cmpres[k] = {"old_rows": len(old), "matched_identical_fields_incl_request_id": matched, "mismatch": mism}
+    summ["compare_with_iter_041_requests"] = cmpres
+    for k, rows in built.items():
+        write_new(os.path.join(a.out_dir, f"requests_{k}.jsonl"), rows)
+    summ["file_sha256"] = {f"requests_{k}.jsonl": hashlib.sha256(open(os.path.join(a.out_dir, f"requests_{k}.jsonl"), "rb").read()).hexdigest() for k in built}
+    json.dump(summ, open(os.path.join(a.out_dir, "summary.json"), "x"), indent=1)
+    print(json.dumps(summ, indent=1))
+    if any(v["mismatch"] for v in cmpres.values()):
+        sys.exit("mismatch with iter_041 requests")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_resume_check.py b/pg48_resume_check.py
new file mode 100644
index 0000000..ccffb48
--- /dev/null
+++ b/pg48_resume_check.py
@@ -0,0 +1,72 @@
+"""iter_048 재개 검사 비교: 결정적 기준 실행(ref)과 중단-재개 실행(int: epoch 중간 step 4, bnd: epoch 끝 checkpoint 직후·adapter 저장 전 step 3)의
+adapter·optimizer·RNG digest, 스텝별 loss/grad/batch/RNG가 같은지 확인한다. 기준: 결정적 모드이므로 digest 정확 일치, loss/grad 차이 == 0.
+python pg48_resume_check.py --out results/iter_048/tests/resume/resume_compare.json
+"""
+import argparse
+import json
+import os
+import sys
+
+import torch
+
+ROOT = "results/iter_048/tests/resume"
+
+
+def steps(d):
+    out, ev = {}, []
+    for l in open(os.path.join(d, "train_log.jsonl")):
+        r = json.loads(l)
+        if r["event"] == "step":
+            if r["step"] in out:
+                out.setdefault("_dup", []).append(r["step"])
+            out[r["step"]] = r
+        else:
+            ev.append(r)
+    return out, ev
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    res, allok = {}, True
+    for mode in ("J", "E"):
+        ref_s, ref_ev = steps(f"{ROOT}/{mode}_ref")
+        for var in ("int", "bnd"):
+            d = f"{ROOT}/{mode}_{var}"
+            s, ev = steps(d)
+            entry = {"n_steps": len([k for k in s if k != "_dup"]), "duplicate_step_records": s.get("_dup", [])}
+            keys = sorted(k for k in ref_s if k != "_dup")
+            entry["loss_max_abs_diff"] = max(abs(s[k]["loss"] - ref_s[k]["loss"]) for k in keys)
+            entry["grad_norm_max_abs_diff"] = max(abs(s[k]["grad_norm"] - ref_s[k]["grad_norm"]) for k in keys)
+            entry["batch_rows_equal"] = all(s[k]["batch_rows"] == ref_s[k]["batch_rows"] for k in keys)
+            entry["rng_before_equal"] = all(s[k]["rng_before"] == ref_s[k]["rng_before"] for k in keys)
+            entry["opt_step_before_equal"] = all(s[k]["opt_step_before"] == ref_s[k]["opt_step_before"] for k in keys)
+            entry["joint_orders_equal"] = all(s[k]["joint_orders"] == ref_s[k]["joint_orders"] for k in keys)
+            resumes = [e for e in ev if e["event"] == "resume"]
+            entry["resume_events"] = [{"step": e["step"], "epoch": e["epoch"], "pos": e["pos"], "restored_equals_saved": e["restored_equals_saved"]} for e in resumes]
+            entry["base_frozen_verified"] = any(e["event"] == "base_frozen_verified" for e in ev)
+            fa = {}
+            for ep in (1, 2):
+                ra = torch.load(f"{ROOT}/{mode}_ref/epoch_{ep:02d}/adapter.pt", map_location="cpu", weights_only=True)["digest"]
+                ia = torch.load(f"{d}/epoch_{ep:02d}/adapter.pt", map_location="cpu", weights_only=True)["digest"]
+                fa[f"epoch{ep}_adapter_digest_equal"] = ra == ia
+                rc = torch.load(f"{ROOT}/{mode}_ref/epoch_{ep:02d}/ckpt.pt", map_location="cpu", weights_only=False)["digests"]
+                ic = torch.load(f"{d}/epoch_{ep:02d}/ckpt.pt", map_location="cpu", weights_only=False)["digests"]
+                fa[f"epoch{ep}_ckpt_digests_equal(adapter,optimizer,rng)"] = rc == ic
+            entry.update(fa)
+            entry["ok"] = (entry["loss_max_abs_diff"] == 0 and entry["grad_norm_max_abs_diff"] == 0 and entry["batch_rows_equal"] and entry["rng_before_equal"]
+                           and entry["opt_step_before_equal"] and entry["joint_orders_equal"] and not entry["duplicate_step_records"]
+                           and len(resumes) == 1 and all(r["restored_equals_saved"] for r in resumes) and entry["base_frozen_verified"] and all(fa.values()))
+            allok &= entry["ok"]
+            res[f"{mode}_{var}"] = entry
+    out = {"results": res, "all_ok": allok, "criterion": "deterministic mode: exact digest equality, loss/grad diff == 0, one resume event restored_equals_saved"}
+    json.dump(out, open(a.out, "w"), indent=1)
+    print(json.dumps(out, indent=1))
+    sys.exit(0 if allok else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_seq.py b/pg48_seq.py
new file mode 100644
index 0000000..fb82572
--- /dev/null
+++ b/pg48_seq.py
@@ -0,0 +1,39 @@
+"""iter_048 순차 실행기: 여러 명령을 차례로 실행하고 첫 실패에서 멈춘다 (로그는 --log 에 이어쓰기, 종료 코드는 --log.json).
+python pg48_seq.py --log results/iter_048/logs/x.log --cmd "python a.py ..." --cmd "python b.py ..."
+환경(CUDA_VISIBLE_DEVICES 등)은 상속한다. 각 명령의 종료 코드·소요 시간을 기록한다 (GPU 지정은 pg43_run의 --gpus 인자 등 명령 자체가 담당).
+"""
+import argparse
+import json
+import os
+import shlex
+import subprocess
+import sys
+import time
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--log", required=True)
+    ap.add_argument("--cmd", action="append", required=True)
+    a = ap.parse_args()
+    os.makedirs(os.path.dirname(a.log) or ".", exist_ok=True)
+    res = []
+    with open(a.log, "a") as lf:
+        for c in a.cmd:
+            t0 = time.time()
+            lf.write(f"\n# {time.strftime('%F %T')} $ {c}\n")
+            lf.flush()
+            rc = subprocess.run(shlex.split(c), stdout=lf, stderr=subprocess.STDOUT).returncode
+            res.append({"cmd": c, "rc": rc, "wall_s": time.time() - t0})
+            lf.write(f"# rc={rc} wall={time.time() - t0:.1f}s\n")
+            lf.flush()
+            if rc != 0:
+                break
+    p = a.log + f".{int(time.time())}.json"
+    json.dump(res, open(p, "w"), indent=1)
+    print(json.dumps(res))
+    sys.exit(0 if len(res) == len(a.cmd) and all(r["rc"] == 0 for r in res) else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_time.py b/pg48_time.py
new file mode 100644
index 0000000..e0a568b
--- /dev/null
+++ b/pg48_time.py
@@ -0,0 +1,57 @@
+"""iter_048 paired timing block 실행기. block k(1..6)는 E/J/A 세 시스템을 순차 실행한다 (동시 실행 금지). 순서는 가능한 6개 순열을 block마다 한 번씩.
+J는 block 홀수=AB, 짝수=BA (3회씩 고정 배정). 구성(worker 수 등)은 decisions/timing_config.json (D24 pilot에서 V96 결과 전에 잠금), adapter는 decisions/v96_gate.json.
+python pg48_time.py --k 1 [--attempt 1]
+기술 실패(비정상 종료·불완전)면 원본 dir을 보존하고 --attempt N+1 로 paired block 전체(세 시스템)를 새 dir에서 재측정한다. 느리다는 이유의 제외 금지.
+"""
+import argparse
+import itertools
+import json
+import os
+import subprocess
+import sys
+import time
+
+ROOT = "results/iter_048/timing"
+GATE = "results/iter_048/decisions/v96_gate.json"
+CFG = "results/iter_048/decisions/timing_config.json"
+PERMS = list(itertools.permutations(["E", "J", "A"]))  # 6 순열, 사전식
+
+
+def run(cmd, log):
+    t = time.time()
+    p = subprocess.run(cmd, capture_output=True, text=True)
+    open(log, "a").write(f"$ {' '.join(cmd)}\nrc={p.returncode} dt={time.time() - t:.1f}\n{p.stdout[-3000:]}\n{p.stderr[-3000:]}\n")
+    return p.returncode
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--k", type=int, required=True)
+    ap.add_argument("--attempt", type=int, default=1)
+    a = ap.parse_args()
+    gate = json.load(open(GATE))
+    cfg = json.load(open(CFG))
+    order = PERMS[a.k - 1]
+    jorder = "AB" if a.k % 2 == 1 else "BA"
+    os.makedirs(ROOT, exist_ok=True)
+    log = os.path.join(ROOT, f"block{a.k}_attempt{a.attempt}.driver.log")
+    open(log, "a").write(f"# block {a.k} attempt {a.attempt} order={order} J_order={jorder}\n")
+    for s in order:
+        d = os.path.join(ROOT, f"block{a.k}_a{a.attempt}_{s}")
+        if os.path.exists(d):
+            sys.exit(f"exists: {d}")
+        if s in ("E", "J"):
+            cmd = [sys.executable, "pg48_ctime.py", "launch", "--system", s, "--order", jorder if s == "J" else "AB", "--adapter", gate["adapters"][s]["path"], "--out-dir", d,
+                   "--workers", str(cfg[s]["workers"]), "--gpus", "0,1", "--barrier", "--warmup-n", "8", "--set", "V96", "--peak-gb", str(cfg[s]["peak_gb"])]
+        else:
+            cmd = [sys.executable, "mg45_launch.py", "--set", "V96", "--ckpt", "A_final", "--ckpt-path", "results/iter_046/train/U/weights_e5.pth", "--out-dir", d,
+                   "--workers", str(cfg["A"]["workers"]), "--gpus", "0,1", "--batch", str(cfg["A"]["batch"]), "--post-thr", "0.8", "--warmup-d8", "--barrier"]
+        rc = run(cmd, log)
+        print(s, "rc", rc, d, flush=True)
+        if rc != 0:
+            sys.exit(f"technical failure in {s}: preserve {d}; rerun whole paired block with --attempt {a.attempt + 1}")
+        time.sleep(10)  # GPU 메모리 반환·clock 안정화
+
+
+if __name__ == "__main__":
+    main()
