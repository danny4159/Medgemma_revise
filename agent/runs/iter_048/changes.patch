+        gA = flat_grad(params).clone()
+        for p in params:
+            p.grad = None
+        loss = 0
+        for k, it in enumerate(items):
+            torch.manual_seed(T.derive_seed(17, 0, k))
+            torch.cuda.manual_seed(T.derive_seed(17, 0, k))
+            ce, n, _ = T.group_losses(torch, model, it["exs"], tok.pad_token_id, softcap, 2)
+            loss = loss + ce.sum() / tot
+        loss.backward()
+        gB = flat_grad(params).clone()
+        rel = float((gA - gB).norm() / gB.norm())
+        # 반복 노이즈 기준: 같은 방식 재실행
+        for p in params:
+            p.grad = None
+        for k, it in enumerate(items):
+            T.patient_step(torch, model, it, tok.pad_token_id, softcap, tot, 2, T.derive_seed(17, 0, k))
+        gA2 = flat_grad(params).clone()
+        acc_rel[mode] = {"rel_l2_accum_vs_single_backward": rel, "rel_l2_repeat_noise": float((gA - gA2).norm() / gA.norm()), "grad_norm": float(gB.norm()),
+                         "n_patients": len(items), "tot_tokens": tot}
+        for p in params:
+            p.grad = None
+    chk(f"gradient accumulation == single backward (rel L2 <= {ACC_TOL}) for J and E", all(v["rel_l2_accum_vs_single_backward"] <= ACC_TOL for v in acc_rel.values()), acc_rel)
+    if det:
+        chk("deterministic mode: repeat-run gradient noise <= 1e-6", all(v["rel_l2_repeat_noise"] <= 1e-6 for v in acc_rel.values()), acc_rel)
+    chk("base weights unchanged by forward/backward (base digest)", lora.base_digest(model) == base_h)
+    chk("gradients only on LoRA parameters (base params have no grad)", all(p.grad is None for n_, p in model.named_parameters() if not p.requires_grad))
+    peak = torch.cuda.max_memory_allocated() / 2 ** 30
+    res = {"checks": checks, "n_pass": sum(c["ok"] for c in checks), "n": len(checks), "ce_rel": ce_rel, "acc": acc_rel, "peak_alloc_gb": peak,
+           "tolerances_fixed_before": {"ce_rel": CE_TOL, "acc_rel": ACC_TOL}, "wall_s": time.time() - t0, "cuda_visible": os.environ.get("CUDA_VISIBLE_DEVICES"),
+           "source_sha256": {f: sha_file(f) for f in T.CODE_FILES + ["pg48_gates.py"]}}
+    res["deterministic_mode"] = det
+    write(f"gate_gpu_{'det_' if det else ''}{os.environ.get('CUDA_VISIBLE_DEVICES', 'x').replace(',', '')}.json", res)
+    print("GPU GATE", res["n_pass"], "/", res["n"], "peak", peak)
+    sys.exit(0 if res["n_pass"] == res["n"] else 1)
+
+
+if __name__ == "__main__":
+    {"data": gate_data, "inputs": gate_inputs, "gpu": gate_gpu}[sys.argv[1]]()
diff --git a/pg48_gentests.py b/pg48_gentests.py
new file mode 100644
index 0000000..4d0ff5e
--- /dev/null
+++ b/pg48_gentests.py
@@ -0,0 +1,133 @@
+"""iter_048 생성 경로 CPU 검사: D8의 C adapter 실행(2w/4w/중단-재개)에 대해
+ (1) 완료 검증 통과, (2) 2w/4w/재개 token 일치, (3) 저장된 iter_041 C D24 출력과 token 일치 (같은 (환자, cond, targets)),
+ (4) 변조·중복·누락·wrong config 거부 (복사본에서 변조하고 completion을 다시 만들어 깊은 검사 분기가 실제로 실패하는지 확인).
+python pg48_gentests.py --out results/iter_048/tests/gen_tests.json
+"""
+import argparse
+import glob
+import json
+import os
+import shutil
+import sys
+
+import pg43_run as R
+import pg48_import as IM
+
+ROOT = "results/iter_048"
+REQ = f"{ROOT}/requests/requests_D8.jsonl"
+DIRS = {"2w": f"{ROOT}/gen/D8_C_2w", "4w": f"{ROOT}/gen/D8_C_4w_b", "resume": f"{ROOT}/gen/D8_C_resume"}
+PROTO = f"{ROOT}/protocol/proto_D8_C.json"
+TAMPER = f"{ROOT}/tests/tamper"
+
+
+def recs_by_key(d):
+    out = {}
+    for fn in sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl"))):
+        for r in R.read_records(fn):
+            out[(r["patient"], r["cond"], tuple(r["targets"]))] = r
+    return out
+
+
+def rewrite(src, dst, mutate):
+    """src dir 복사 후 mutate(files:{name:[records]}) 로 변조하고 completion의 worker_file_sha256/n_requests를 일치시킨다 (깊은 검사 분기를 시험하기 위함)."""
+    if os.path.exists(dst):
+        shutil.rmtree(dst) if False else sys.exit(f"exists {dst}")
+    shutil.copytree(src, dst)
+    comp = json.load(open(os.path.join(dst, "completion.json")))
+    files = {os.path.basename(f): R.read_records(f) for f in sorted(glob.glob(os.path.join(dst, "gen_worker*.jsonl")))}
+    mutate(files)
+    for fn, recs in files.items():
+        with open(os.path.join(dst, fn), "w") as f:
+            for r in recs:
+                f.write(json.dumps(r) + "\n")
+    comp["worker_file_sha256"] = {fn: R.file_sha(os.path.join(dst, fn)) for fn in files}
+    json.dump(comp, open(os.path.join(dst, "completion.json"), "w"), indent=1)
+
+
+def expect_fail(name, dst, proto, req, res, needle):
+    try:
+        R.verify_completion(dst, req, proto)
+        res[name] = {"rejected": False, "message": None}
+    except Exception as e:  # noqa
+        res[name] = {"rejected": True, "message": str(e)[:200], "expected_branch_match": needle in str(e)}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    res = {"verify_completion_pass": {}, "token_equality": {}, "tamper": {}}
+    for k, d in DIRS.items():
+        recs = R.verify_completion(d, REQ, PROTO)
+        res["verify_completion_pass"][k] = len(recs)
+    base = {k: recs_by_key(d) for k, d in DIRS.items()}
+    for k in ("4w", "resume"):
+        res["token_equality"][f"2w_vs_{k}"] = {"n": len(base["2w"]), "suffix_ids_mismatch": sum(base["2w"][x]["suffix_ids"] != base[k][x]["suffix_ids"] for x in base["2w"]),
+                                               "text_mismatch": sum(base["2w"][x]["suffix_text_raw"] != base[k][x]["suffix_text_raw"] for x in base["2w"])}
+    old = IM.load_c_d24()["records"]
+    for k in DIRS:
+        res["token_equality"][f"{k}_vs_stored_iter041_C_D24"] = {"n": len(base[k]), "suffix_ids_mismatch": sum(base[k][x]["suffix_ids"] != old[x]["suffix_ids"] for x in base[k])}
+    res["resume_info"] = {"repair_logs": sorted(glob.glob(f"{DIRS['resume']}/*.repair.log")), "partial_files": sorted(glob.glob(f"{DIRS['resume']}/*.partial.*")),
+                          "n_worker_timing_files": len(glob.glob(f"{DIRS['resume']}/worker*.timing.*.json")), "partial_json": sorted(glob.glob(f"{DIRS['resume']}/partial_*.json"))}
+    os.makedirs(TAMPER, exist_ok=True)
+    src = DIRS["2w"]
+
+    def dup(files):
+        fn = sorted(files)[0]
+        files[fn].append(dict(files[fn][0]))
+
+    def drop(files):
+        fn = max(files, key=lambda k: len(files[k]))
+        files[fn].pop()
+
+    def flip_text(files):
+        fn = sorted(files)[0]
+        files[fn][0]["suffix_text_raw"] = files[fn][0]["suffix_text_raw"] + " "  # record_digest stale
+
+    def wrong_adapter(files):
+        fn = sorted(files)[0]
+        r = files[fn][0]
+        r["adapter_digest"] = "0" * 64
+        r["record_digest"] = R.record_digest(r)  # digest 재계산: adapter 검사 분기
+
+    def wrong_prompt(files):
+        fn = sorted(files)[0]
+        r = files[fn][0]
+        r["prompt_sha256"] = "1" * 64
+        r["record_digest"] = R.record_digest(r)
+
+    def wrong_image(files):
+        fn = sorted(files)[0]
+        r = files[fn][0]
+        r["input_pixel_sha256"] = "2" * 64
+        r["record_digest"] = R.record_digest(r)
+
+    for name, mut, needle in (("duplicate_record", dup, "request set mismatch"), ("missing_record", drop, "request set mismatch"), ("altered_text_stale_digest", flip_text, "record digest"),
+                              ("wrong_adapter_digest", wrong_adapter, "adapter/protocol digest"), ("wrong_prompt_hash", wrong_prompt, "row digest"),
+                              ("wrong_image_pixel_hash", wrong_image, "pixel hash")):
+        dst = f"{TAMPER}/{name}"
+        rewrite(src, dst, mut)
+        expect_fail(name, dst, PROTO, REQ, res["tamper"], needle)
+    # 원본 completion 파일 변조 (worker file sha 분기)
+    dst = f"{TAMPER}/raw_file_changed"
+    shutil.copytree(src, dst)
+    fn = sorted(glob.glob(os.path.join(dst, "gen_worker*.jsonl")))[0]
+    open(fn, "a").write("\n")
+    expect_fail("worker_file_changed_after_completion", dst, PROTO, REQ, res["tamper"], "worker file changed")
+    # wrong config: 다른 protocol(adapter가 다른 protocol)로 같은 출력을 검증
+    wp = f"{ROOT}/protocol/proto_D8_wrongcfg.json"
+    if os.path.exists(wp):
+        expect_fail("wrong_protocol_adapter", src, wp, REQ, res["tamper"], "protocol")
+    res["all_rejected"] = all(v["rejected"] for v in res["tamper"].values())
+    res["all_branch_match"] = all(v.get("expected_branch_match", True) for v in res["tamper"].values())
+    res["tokens_all_equal"] = all(v["suffix_ids_mismatch"] == 0 for v in res["token_equality"].values())
+    json.dump(res, open(a.out, "w"), indent=1)
+    print(json.dumps({k: res[k] for k in ("all_rejected", "all_branch_match", "tokens_all_equal")}))
+    print(json.dumps(res["tamper"], indent=1))
+    print(json.dumps(res["token_equality"], indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_import.py b/pg48_import.py
new file mode 100644
index 0000000..07f9707
--- /dev/null
+++ b/pg48_import.py
@@ -0,0 +1,141 @@
+"""iter_048 기존 출력 import 검증 (pg43_eval.verify_import를 쓰지 않는 별도 구현). 기존 C(iter_040/041)와 A(iter_046) 출력을 원 request·protocol·adapter·영상 연결로 검증한다.
+
+load_c_v96(): C의 V96 I(iter_040 gen/C) / J_AB / J_BA(iter_041) record를 반환한다 (모두 request/record/completion/protocol/adapter/현재 영상 hash 검증).
+load_c_d24(): C의 D24 96요청(iter_041 D24_C_2w; 4w와 token 일치 확인).
+load_a_v96(): iter_046 A_U_e5 raw(모든 threshold 저장) 192문장.
+"""
+import glob
+import hashlib
+import json
+import os
+
+import pg43_run as R
+
+MAN = "results/iter_043/data/manifest_private.json"
+C_DIGEST = "419ae81f5ef455d39742b158537373da6e26061b362d13205ab28b4a50905ba8"
+C_ADAPTER_FILE = "results/iter_040/train2/C_s17/epoch_03/adapter.pt"
+A_CKPT = "results/iter_046/train/U/weights_e5.pth"
+A_SHA = "b9c2bccd04dde8b7445aa5f60e082a0c93f1f2412af8a583a4ca5ee207c8718a"
+
+
+class ImportError_(RuntimeError):
+    pass
+
+
+def _need(c, msg):
+    if not c:
+        raise ImportError_(msg)
+
+
+def _read_requests(path):
+    rows = {}
+    for l in open(path):
+        if l.strip():
+            r = json.loads(l)
+            rows[r["request_id"]] = r
+    return rows
+
+
+def verify_old_gen(gen_dir, req_path, proto_path, expect_n):
+    """returns (records by request_id, old request rows by request_id, protocol digest)."""
+    comp = json.load(open(os.path.join(gen_dir, "completion.json")))
+    _need(all(c == 0 for c in comp["exit_codes"]), f"{gen_dir}: nonzero exit")
+    proto = json.load(open(proto_path))
+    _need(R.file_sha(req_path) == proto["requests_sha256"], f"{gen_dir}: requests file != protocol lock")
+    ad = proto["adapter"]
+    _need(ad["digest"] == C_DIGEST and R.file_sha(os.path.join(ad["path"], "adapter.pt")) == ad["file_sha256"], f"{gen_dir}: adapter != C")
+    _need(R.file_sha(C_ADAPTER_FILE) == ad["file_sha256"], f"{gen_dir}: current C adapter file changed")
+    rows = _read_requests(req_path)
+    _need(len(rows) == expect_n == comp["n_requests"], f"{gen_dir}: n requests {len(rows)} {comp['n_requests']}")
+    files = sorted(glob.glob(os.path.join(gen_dir, "gen_worker*.jsonl")))
+    _need(sorted(os.path.basename(f) for f in files) == sorted(comp["worker_file_sha256"]), f"{gen_dir}: worker file set")
+    recs = {}
+    for f in files:
+        _need(R.file_sha(f) == comp["worker_file_sha256"][os.path.basename(f)], f"{gen_dir}: worker file changed {f}")
+        for r in R.read_records(f):
+            _need(r["request_id"] not in recs, f"{gen_dir}: duplicate {r['request_id']}")
+            recs[r["request_id"]] = r
+    _need(set(recs) == set(rows), f"{gen_dir}: request set mismatch")
+    for rid, r in recs.items():
+        _need(r["record_digest"] == R.record_digest(r), f"{gen_dir}: record digest {rid}")
+        _need(r["row_digest"] == R.row_digest(rows[rid]), f"{gen_dir}: row digest {rid}")
+        _need(r["adapter_digest"] == C_DIGEST and r["protocol_digest"] == comp["protocol_digest"], f"{gen_dir}: record adapter/protocol {rid}")
+        _need(r["prompt_sha256"] == rows[rid]["prompt_sha256"] == hashlib.sha256(rows[rid]["prompt"].encode()).hexdigest(), f"{gen_dir}: prompt hash {rid}")
+    return recs, rows, comp["protocol_digest"]
+
+
+def _check_against_new(recs, old_rows, new_rows_by_key, man_entries, what):
+    """old 요청 행이 내 요청 행렬과 같은 (patient, cond, targets, prompt, 영상 hash)인지, record 영상 hash가 manifest와 같은지 확인하고 key별 record를 반환."""
+    out = {}
+    for rid, r in recs.items():
+        o = old_rows[rid]
+        key = (o["patient"], o["cond"], tuple(o["targets"]))
+        n = new_rows_by_key.get(key)
+        _need(n is not None, f"{what}: no matching new request for {key}")
+        _need(n["prompt_sha256"] == o["prompt_sha256"] and n["caps"] == o["caps"] and n["image_file_sha256"] == o["image_file_sha256"] and
+              n["input_pixel_sha256"] == o["input_pixel_sha256"] and n["image"] == o["image"], f"{what}: request differs from new matrix {key}")
+        e = man_entries[o["patient"]]
+        _need(r["input_pixel_sha256"] == e["input_pixel_sha256"] and o["input_pixel_sha256"] == e["input_pixel_sha256"], f"{what}: pixel hash != manifest")
+        _need(r["ended_eos"] is True or r["finish_reason"] in ("eos", "length"), f"{what}: bad finish")
+        out[key] = r
+    return out
+
+
+def new_rows_by_key(path):
+    return {(r["patient"], r["cond"], tuple(r["targets"])): r for r in (json.loads(l) for l in open(path) if l.strip())}
+
+
+def man_entries(man, name):
+    return {e["PatientID"]: e for e in man[name]}
+
+
+def load_c_v96(req_new="results/iter_048/requests/requests_V96.jsonl"):
+    man = json.load(open(MAN))
+    ents = man_entries(man, "V96")
+    nk = new_rows_by_key(req_new)
+    out = {}
+    for tag, gen, req, proto, n in (("I", "results/iter_040/gen/C", "results/iter_040/requests/requests_V96.jsonl", "results/iter_040/protocol/protocol_C.json", 192),
+                                    ("AB", "results/iter_041/gen/V96_C_JAB", "results/iter_041/requests/requests_V96_JAB.jsonl", "results/iter_041/protocol/protocol_V96_C_JAB.json", 96),
+                                    ("BA", "results/iter_041/gen/V96_C_JBA", "results/iter_041/requests/requests_V96_JBA.jsonl", "results/iter_041/protocol/protocol_V96_C_JBA.json", 96)):
+        recs, rows, pdig = verify_old_gen(gen, req, proto, n)
+        out[tag] = {"records": _check_against_new(recs, rows, nk, ents, f"C_{tag}"), "protocol_digest": pdig, "gen_dir": gen,
+                    "completion_sha256": R.file_sha(os.path.join(gen, "completion.json"))}
+    return out
+
+
+def load_c_d24(req_new="results/iter_048/requests/requests_D24.jsonl"):
+    man = json.load(open(MAN))
+    ents = man_entries(man, "D24")
+    nk = new_rows_by_key(req_new)
+    recs, rows, pdig = verify_old_gen("results/iter_041/gen/D24_C_2w", "results/iter_041/requests/requests_D24_C.jsonl", "results/iter_041/protocol/protocol_D24_C.json", 96)
+    recs4, _, _ = verify_old_gen("results/iter_041/gen/D24_C_4w", "results/iter_041/requests/requests_D24_C.jsonl", "results/iter_041/protocol/protocol_D24_C.json", 96)
+    mism = sum(recs[k]["suffix_ids"] != recs4[k]["suffix_ids"] for k in recs)
+    return {"records": _check_against_new(recs, rows, nk, ents, "C_D24"), "protocol_digest": pdig, "tokens_2w_vs_4w_mismatch": mism,
+            "gen_dir": "results/iter_041/gen/D24_C_2w"}
+
+
+def load_a_v96(gen_dir="results/iter_046/mg/V96_A_w2b4"):
+    man = json.load(open(MAN))
+    ents = man_entries(man, "V96")
+    comp = json.load(open(os.path.join(gen_dir, "completion.json")))
+    _need(all(c == 0 for c in comp["exit_codes"]) and comp["complete"] and comp["n_unique"] == 192, "A: completion")
+    _need(R.file_sha(A_CKPT) == A_SHA, "A: checkpoint file changed")
+    recs = {}
+    for fn, sha in comp["raw_file_sha256"].items():
+        p = os.path.join(gen_dir, fn)
+        _need(R.file_sha(p) == sha, f"A: raw file changed {fn}")
+        for ln in open(p, "rb").read().split(b"\n")[:-1]:
+            if ln.strip():
+                r = json.loads(ln)
+                _need(r["request_id"] not in recs, "A: duplicate")
+                recs[r["request_id"]] = r
+    _need(len(recs) == 192, "A: 192 records")
+    by = {}
+    for r in recs.values():
+        e = ents[r["patient"]]
+        _need(r["ckpt_sha256"] == A_SHA and r["u8_pixel_sha256"] == e["u8_pixel_sha256"] and r["image"] == e["image"], "A: provenance != manifest")
+        _need(r["sentence_sha256"] == hashlib.sha256(e["sentences"][r["target"]].encode()).hexdigest(), "A: sentence mismatch")
+        _need("0.8" in r["detections"], "A: threshold 0.8 missing")
+        by[(r["patient"], r["target"])] = r
+    _need(len(by) == 192 and {p for p, _ in by} == set(ents), "A: patient/sentence coverage")
+    return {"records": by, "completion_sha256": R.file_sha(os.path.join(gen_dir, "completion.json")), "gen_dir": gen_dir}
diff --git a/pg48_jobs.py b/pg48_jobs.py
new file mode 100644
index 0000000..a10b6bc
--- /dev/null
+++ b/pg48_jobs.py
@@ -0,0 +1,55 @@
+"""iter_048 병렬 job 실행기: 허용 GPU 집합(CUDA_VISIBLE_DEVICES 상속) 안에서만 job을 장치에 배정하고 모두 끝날 때까지 기다린다.
+
+python pg48_jobs.py --log-dir DIR --job GPU "CMD ..." [--job GPU "CMD ..."] ...
+ - GPU는 상속된 허용 집합의 물리 index. 각 job은 CUDA_VISIBLE_DEVICES=<GPU> 로 시작한다 (논리/물리 대응은 job 로그 첫 줄에 기록).
+ - 시작 직전 nvidia-smi 여유 메모리를 기록한다. 로그는 DIR/job<k>.log (이어쓰기), 종료 코드는 DIR/jobs_<ts>.json.
+"""
+import argparse
+import json
+import os
+import shlex
+import subprocess
+import sys
+import time
+
+
+def free_mib():
+    r = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used,memory.total", "--format=csv,noheader,nounits"], capture_output=True, text=True, check=True)
+    return {int(l.split(",")[0]): int(l.split(",")[2]) - int(l.split(",")[1]) for l in r.stdout.strip().splitlines()}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--log-dir", required=True)
+    ap.add_argument("--job", nargs=2, action="append", metavar=("GPU", "CMD"), required=True)
+    ap.add_argument("--min-free-gb", type=float, default=0.0, help="job 시작 전 해당 GPU 여유 최소값 (GiB)")
+    a = ap.parse_args()
+    allowed = [int(x) for x in os.environ.get("CUDA_VISIBLE_DEVICES", "").split(",") if x]
+    if not allowed:
+        sys.exit("CUDA_VISIBLE_DEVICES not set")
+    os.makedirs(a.log_dir, exist_ok=True)
+    free = free_mib()
+    procs = []
+    t0 = time.time()
+    for k, (gpu, cmd) in enumerate(a.job):
+        g = int(gpu)
+        if g not in allowed:
+            sys.exit(f"gpu {g} not in allowed {allowed}")
+        if free[g] < a.min_free_gb * 1024:
+            sys.exit(f"gpu {g} free {free[g]} MiB < {a.min_free_gb} GiB")
+        env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(g))
+        lf = open(os.path.join(a.log_dir, f"job{k}.log"), "a")
+        lf.write(f"# job{k} gpu(physical)={g} CUDA_VISIBLE_DEVICES={g} free_mib_before={free[g]} start={time.time()} cmd={cmd}\n")
+        lf.flush()
+        procs.append((k, g, cmd, subprocess.Popen(shlex.split(cmd), env=env, stdout=lf, stderr=subprocess.STDOUT)))
+    codes = {}
+    for k, g, cmd, p in procs:
+        codes[k] = p.wait()
+    res = {"wall_s": time.time() - t0, "jobs": [{"k": k, "gpu": g, "cmd": cmd, "rc": codes[k]} for k, g, cmd, _ in procs], "free_mib_before": free}
+    json.dump(res, open(os.path.join(a.log_dir, f"jobs_{int(time.time())}.json"), "w"), indent=1)
+    print(json.dumps(res))
+    sys.exit(0 if all(c == 0 for c in codes.values()) else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_launchtests.py b/pg48_launchtests.py
new file mode 100644
index 0000000..da12f3d
--- /dev/null
+++ b/pg48_launchtests.py
@@ -0,0 +1,90 @@
+"""iter_048 mg45_launch.py 보완 검사 (실제 프로세스 fixture): (c) barrier 전 child 사망 -> launcher가 자기 child만 종료하고 실패로 끝남,
+(a) 기존 launch_protocol과 다른 config로 같은 out-dir 재호출 -> 거부(기존 파일 불변), (b) 같은 out-dir 동시 launcher -> 거부.
+GPU 1장(물리 --gpu 인자)을 사용한다. 결과: results/iter_048/tests/launch_tests.json (덮어쓰기 거부).
+python pg48_launchtests.py --gpu 1 --out results/iter_048/tests/launch_tests.json
+"""
+import argparse
+import hashlib
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+CKPT = "results/iter_046/train/U/weights_e5.pth"
+BASE = ["python", "mg45_launch.py", "--set", "D24", "--ckpt", "A_final", "--ckpt-path", CKPT, "--workers", "2", "--batch", "4", "--post-thr", "0.8", "--warmup-d8", "--barrier"]
+
+
+def children(pid):
+    out = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True).stdout.split()
+    return [int(x) for x in out]
+
+
+def alive(pid):
+    try:
+        os.kill(pid, 0)
+        return True
+    except OSError:
+        return False
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--gpu", default="1")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES=a.gpu)
+    root = "results/iter_048/tests/launch"
+    res = {}
+    # (c) barrier 전 child 사망
+    dc = f"{root}/c_child_death"
+    p = subprocess.Popen(BASE + ["--gpus", a.gpu, "--out-dir", dc, "--peak-gb", "4"], env=env, stdout=open(f"{root}_c.stdout", "w"), stderr=subprocess.STDOUT)
+    victim = None
+    t0 = time.time()
+    while time.time() - t0 < 60 and victim is None:
+        ch = children(p.pid)
+        if len(ch) >= 2:
+            victim = ch[1]
+        time.sleep(0.5)
+    all_children = children(p.pid)
+    os.kill(victim, signal.SIGKILL)
+    t_kill = time.time()
+    try:
+        rc = p.wait(timeout=180)
+        hung = False
+    except subprocess.TimeoutExpired:
+        rc, hung = None, True
+        p.kill()
+    left = [c for c in all_children if alive(c)]
+    partial = [f for f in os.listdir(dc) if f.startswith("partial_")]
+    pj = json.load(open(os.path.join(dc, partial[0]))) if partial else {}
+    res["c_child_death_before_barrier"] = {"launcher_rc": rc, "hung": hung, "seconds_to_exit_after_kill": time.time() - t_kill, "leftover_child_pids": left,
+                                           "partial_json_aborted_field": pj.get("aborted"), "no_completion": not os.path.exists(os.path.join(dc, "completion.json")),
+                                           "ok": rc not in (0, None) and not hung and not left and bool(pj.get("aborted")) and not os.path.exists(os.path.join(dc, "completion.json"))}
+    # (a) config mismatch on same out-dir (batch 4 -> 2)
+    lp = os.path.join(dc, "launch_protocol.json")
+    before = hashlib.sha256(open(lp, "rb").read()).hexdigest()
+    cmd = [x if x != "4" else "2" for x in BASE]
+    r = subprocess.run(cmd + ["--gpus", a.gpu, "--out-dir", dc, "--peak-gb", "4"], env=env, capture_output=True, text=True, timeout=120)
+    res["a_config_mismatch_rejected"] = {"rc": r.returncode, "message": (r.stderr + r.stdout)[-200:], "launch_protocol_unchanged": hashlib.sha256(open(lp, "rb").read()).hexdigest() == before,
+                                         "ok": r.returncode != 0 and "config mismatch" in (r.stderr + r.stdout) and hashlib.sha256(open(lp, "rb").read()).hexdigest() == before}
+    # (b) 동시 launcher
+    db = f"{root}/b_concurrent"
+    p1 = subprocess.Popen(BASE + ["--gpus", a.gpu, "--out-dir", db, "--peak-gb", "4"], env=env, stdout=open(f"{root}_b.stdout", "w"), stderr=subprocess.STDOUT)
+    time.sleep(8)
+    r2 = subprocess.run(BASE + ["--gpus", a.gpu, "--out-dir", db, "--peak-gb", "4"], env=env, capture_output=True, text=True, timeout=120)
+    rc1 = p1.wait(timeout=600)
+    comp = os.path.exists(os.path.join(db, "completion.json"))
+    res["b_concurrent_launcher_rejected"] = {"second_rc": r2.returncode, "message": (r2.stderr + r2.stdout)[-200:], "first_launcher_rc": rc1, "first_completed": comp,
+                                             "ok": r2.returncode != 0 and "another launcher" in (r2.stderr + r2.stdout) and rc1 == 0 and comp}
+    res["all_ok"] = all(v["ok"] for v in res.values() if isinstance(v, dict))
+    res["mg45_launch_sha256"] = hashlib.sha256(open("mg45_launch.py", "rb").read()).hexdigest()
+    json.dump(res, open(a.out, "w"), indent=1)
+    print(json.dumps(res, indent=1))
+
+
+if __name__ == "__main__":
+    main()
