new file mode 100644
index 0000000..de707f9
--- /dev/null
+++ b/pg48_decide.py
@@ -0,0 +1,79 @@
+"""iter_048 사전 판정 규칙 (plan.md Evaluation을 결과 전에 코드로 고정; 결과를 보고 바꾸지 않는다). CPU.
+
+recovered   : M1(J_J-E_J) mean>=0.10 & 97.5% CI lo>0  AND  M2((E_I-E_J)-(J_I-J_J)) mean>=0.10 & 97.5% CI lo>0  AND  (J_I-E_I) F1@0.3 95% CI lo >= -0.03
+sufficient  : J_AB와 J_BA 각각의 (E_I 대비) F1@0.3 97.5% CI lo>=-0.03, F1@0.5 95% CI lo>=-0.03, FP/문장 95% CI hi<=0.10 (모두)
+residual    : (J_I - J_J) mean>=0.05 & 95% CI lo>0
+adv(X)      : (X - A) F1@0.3 mean>=0.05 & 97.5% CI lo>0, F1@0.5 95% CI lo>=-0.03, FP 95% CI hi<=0.10
+cost_opp    : J/E device-seconds ratio 95% CI hi<=0.80 & throughput ratio 95% CI lo>=1.25 & p95 latency ratio 95% CI hi<=1.20
+outcome     : recovered&sufficient -> recovered_and_preserved / else residual -> residual_joint_loss / else indeterminate_format_effect
+next        : recovered_and_preserved -> 별도 공동 loss 투자 종료 (adv(J_J)&cost_opp면 독립 확인 가치 검토)
+              residual_joint_loss -> adv(E_I)&cost_opp면 최소 방법 pilot 가치를 다음 리뷰에서 판단, 아니면 보류
+              indeterminate -> 비교 종료 (추가 표본/seed/prompt/timing 없음). adv(E_I)와 adv(J_J)가 모두 거짓이면 MG 대비 필요한 이점 미확보로 공동 grounding 추가 방법 투자 보류.
+적용 범위: 두 양성 문장, T305 단일 seed, 개발 V96. 신규성/내부 원인/임상 일반화 판정이 아니다.
+python pg48_decide.py --report R --timing T --out OUT
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+
+def sha(p):
+    return hashlib.sha256(open(p, "rb").read()).hexdigest()
+
+
+def decide(rep, timing):
+    c = rep["compare"]
+    M1, M2 = c["M1_J_J_minus_E_J"]["f1_03_ci975"], c["M2_loss_reduction_(E_I-E_J)-(J_I-J_J)"]["f1_03_ci975"]
+    JIE = c["J_I_minus_E_I"]["f1_03"]["ci95"]
+    rec = {"M1_mean>=0.10": M1["mean"] >= 0.10, "M1_lo>0": M1["lo"] > 0, "M2_mean>=0.10": M2["mean"] >= 0.10, "M2_lo>0": M2["lo"] > 0, "J_I-E_I_lo95>=-0.03": JIE["lo"] >= -0.03}
+    recovered = all(rec.values())
+    suff = {}
+    for o in ("AB", "BA"):
+        cc = c[f"J_{o}_minus_E_I"]
+        suff[o] = {"f1_03_lo975>=-0.03": cc["f1_03_ci975"]["lo"] >= -0.03, "f1_05_lo95>=-0.03": cc["f1_05_ci95"]["lo"] >= -0.03, "fp_hi95<=0.10": cc["fp_03_ci95"]["hi"] <= 0.10}
+    sufficient = all(v for d in suff.values() for v in d.values())
+    jl = c["J_loss_J_I_minus_J_J"]["f1_03_ci95"]
+    residual = jl["mean"] >= 0.05 and jl["lo"] > 0
+
+    def adv(name):
+        cc = c[f"{name}_minus_A"]
+        d = {"f1_03_mean>=0.05": cc["f1_03_ci975"]["mean"] >= 0.05, "f1_03_lo975>0": cc["f1_03_ci975"]["lo"] > 0, "f1_05_lo95>=-0.03": cc["f1_05_ci95"]["lo"] >= -0.03,
+             "fp_hi95<=0.10": cc["fp_03_ci95"]["hi"] <= 0.10}
+        return all(d.values()), d
+    advE, advE_d = adv("E_I")
+    advJ, advJ_d = adv("J_J")
+    r = timing["ratios"]["J/E"]
+    cost = {"device_hi95<=0.80": r["device_seconds"]["hi95"] <= 0.80, "throughput_lo95>=1.25": r["throughput"]["lo95"] >= 1.25, "p95_hi95<=1.20": r["p95_latency"]["hi95"] <= 1.20}
+    cost_opp = all(cost.values())
+    outcome = "recovered_and_preserved" if (recovered and sufficient) else ("residual_joint_loss" if residual else "indeterminate_format_effect")
+    hold_mg = not (advE or advJ)
+    if outcome == "recovered_and_preserved":
+        nxt = "close separate joint-loss investment" + ("; review independent confirmation (J_J advantage over A and cost opportunity both met)" if (advJ and cost_opp) else "")
+    elif outcome == "residual_joint_loss":
+        nxt = "next review judges minimal method pilot value (E_I advantage over A and J cost opportunity both met)" if (advE and cost_opp) else "hold joint grounding method investment"
+    else:
+        nxt = "close this comparison (no more samples/seeds/prompts/timing); preserve observations"
+    return {"outcome": outcome, "recovered": recovered, "recovered_conditions": rec, "sufficient": sufficient, "sufficient_conditions": suff, "residual": residual,
+            "residual_stat": jl, "adv_E_I_over_A": advE, "adv_E_I_detail": advE_d, "adv_J_J_over_A": advJ, "adv_J_J_detail": advJ_d, "cost_opportunity_J_over_E": cost_opp, "cost_detail": cost,
+            "hold_no_required_advantage_over_MG": hold_mg, "next_investment": nxt,
+            "scope": "two positive sentences, T305 single seed, development V96; not novelty/internal-cause/clinical generalization"}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--report", required=True)
+    ap.add_argument("--timing", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    d = decide(json.load(open(a.report)), json.load(open(a.timing)))
+    d["input_digests"] = {"report_sha256": sha(a.report), "timing_sha256": sha(a.timing), "decide_source_sha256": sha("pg48_decide.py")}
+    json.dump(d, open(a.out, "w"), indent=1)
+    print(json.dumps({k: d[k] for k in ("outcome", "recovered", "sufficient", "residual", "adv_E_I_over_A", "adv_J_J_over_A", "cost_opportunity_J_over_E", "hold_no_required_advantage_over_MG", "next_investment")}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_dsel.py b/pg48_dsel.py
new file mode 100644
index 0000000..a7d398e
--- /dev/null
+++ b/pg48_dsel.py
@@ -0,0 +1,140 @@
+"""iter_048 D24 선택 단계 판정 (CPU). 규칙은 plan.md를 결과 전에 코드로 고정한 것이며 결과를 보고 바꾸지 않는다.
+
+stage1 (epoch 2 vs 5):
+  extend = (D24 F1@0.3 E_I e5 - e2 >= 0.02) or (D24 F1@0.3 J_J e5 - e2 >= 0.02)
+           or (E의 I형식 D24 teacher-forced CE가 e2 대비 e5에서 5% 이상 감소) or (J의 J형식(AB+BA) D24 CE가 e2 대비 e5에서 5% 이상 감소)
+  extend=True 이면 E/J 두 trajectory를 함께 8 epoch까지 한 번 연장 (const LR, 같은 train_config).
+select (후보 2/5/(8)): 공통 epoch = argmax (E_I F1@0.3 + J_J F1@0.3)/2 on D24, J_J = AB/BA 평균.
+  동률은 (두 점수의 최솟값이 큰 쪽) -> 이른 epoch. E/J를 서로 다른 epoch에서 고르지 않는다. C 초기점(참고)도 같은 D24 표에 보고하지만 후보가 아니다.
+출력은 새 파일만 쓴다 (덮어쓰기 거부).
+
+python pg48_dsel.py stage1 --out results/iter_048/decisions/D24_stage1.json
+python pg48_dsel.py select --epochs 2 5 [8] --out results/iter_048/decisions/v96_gate.json
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+import numpy as np
+
+import pg39_spec as S39
+import pg43_run as R
+import pg48_eval as E
+import pg48_import as IM
+
+ROOT = "results/iter_048"
+MAN = E.MAN
+TH = 0.02
+CE_DROP = 0.05
+
+
+def ents_d24():
+    man = json.load(open(MAN))
+    return {e["PatientID"]: e for e in man["D24"]}, [e["PatientID"] for e in man["D24"]]
+
+
+def d24_dir(label):
+    return f"{ROOT}/gen/D24_{label}", f"{ROOT}/requests/requests_D24.jsonl", f"{ROOT}/protocol/proto_D24_{label}.json"
+
+
+def score_label(label, ents):
+    gd, rq, pr = d24_dir(label)
+    recs = R.verify_completion(gd, rq, pr)
+    byk = {(r["patient"], r["cond"], tuple(r["targets"])): r for r in recs}
+    return E.score_dir(byk, ents), R.verify_protocol(pr, rq)[0]
+
+
+def d24_table(labels):
+    ents, pids = ents_d24()
+    out = {}
+    for lab in labels:
+        sc, pdig = score_label(lab, ents)
+        row = {"protocol_digest": pdig}
+        for kind in ("I", "AB", "BA", "J"):
+            row[kind] = {m: float(E.pat_vec(sc, pids, kind, m).mean()) for m in ("f1_03", "f1_05", "recall_03", "fp_03")}
+        row["invalid"] = {k: sum(v[0] not in E.parse.VALID for v in sc[k].values()) for k in ("I", "AB", "BA")}
+        out[lab] = row
+    return out
+
+
+def ce_of(name, ep):
+    p = f"{ROOT}/decisions/ce_{name}_e{ep}.json"
+    return json.load(open(p)), p
+
+
+def stage1(a):
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    tab = d24_table(["E_e2", "E_e5", "J_e2", "J_e5"])
+    ce = {}
+    for n in ("E", "J"):
+        for ep in (2, 5):
+            ce[f"{n}_e{ep}"], _ = ce_of(n, ep)
+    dE = tab["E_e5"]["I"]["f1_03"] - tab["E_e2"]["I"]["f1_03"]
+    dJ = tab["J_e5"]["J"]["f1_03"] - tab["J_e2"]["J"]["f1_03"]
+    ceE2, ceE5 = ce["E_e2"]["ce_token_mean"]["I"], ce["E_e5"]["ce_token_mean"]["I"]
+    ceJ2, ceJ5 = ce["J_e2"]["ce_J_both_orders_token_mean"], ce["J_e5"]["ce_J_both_orders_token_mean"]
+    cond = {"E_I_f1_03_gain_e5_minus_e2": dE, "J_J_f1_03_gain_e5_minus_e2": dJ, "cond_E_f1>=0.02": dE >= TH, "cond_J_f1>=0.02": dJ >= TH,
+            "E_I_ce_e2_e5": [ceE2, ceE5], "E_ce_drop_frac": (ceE2 - ceE5) / ceE2, "cond_E_ce_drop>=5%": (ceE2 - ceE5) / ceE2 >= CE_DROP,
+            "J_J_ce_e2_e5": [ceJ2, ceJ5], "J_ce_drop_frac": (ceJ2 - ceJ5) / ceJ2, "cond_J_ce_drop>=5%": (ceJ2 - ceJ5) / ceJ2 >= CE_DROP}
+    extend = bool(cond["cond_E_f1>=0.02"] or cond["cond_J_f1>=0.02"] or cond["cond_E_ce_drop>=5%"] or cond["cond_J_ce_drop>=5%"])
+    out = {"stage": "stage1_e2_vs_e5", "extend_to_8_epochs": extend, "run": extend, "conditions": cond, "d24_table": tab,
+           "ce_files": {k: {"adapter_digest": v["adapter_digest"], "ce_token_mean": v["ce_token_mean"], "ce_J_both_orders": v["ce_J_both_orders_token_mean"]} for k, v in ce.items()},
+           "source_sha256": {"pg48_dsel.py": R.file_sha("pg48_dsel.py"), "pg48_eval.py": R.file_sha("pg48_eval.py")},
+           "note": "D24는 선택 자료. 이 판정은 epoch 연장 여부만 정한다."}
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump(out, open(a.out, "w"), indent=1)
+    print(json.dumps({"extend": extend, **cond}, indent=1))
+
+
+def adapter_info(name, ep):
+    d = f"{ROOT}/train/{name}_s17/epoch_{ep:02d}"
+    import torch
+    b = torch.load(os.path.join(d, "adapter.pt"), map_location="cpu", weights_only=True)
+    return {"path": d, "digest": b["digest"], "file_sha256": R.file_sha(os.path.join(d, "adapter.pt")), "epoch": ep, "step": b.get("step")}
+
+
+def select(a):
+    if os.path.exists(a.out):
+        sys.exit("exists")
+    eps = list(a.epochs)
+    tab = d24_table([f"{n}_e{ep}" for n in ("E", "J") for ep in eps])
+    # C 초기점 (참고; 후보 아님)
+    ents, pids = ents_d24()
+    cd = IM.load_c_d24()
+    csc = E.score_dir(cd["records"], ents)
+    cref = {k: {m: float(E.pat_vec(csc, pids, k, m).mean()) for m in ("f1_03", "f1_05")} for k in ("I", "AB", "BA", "J")}
+    scores = {}
+    for ep in eps:
+        e_i, j_j = tab[f"E_e{ep}"]["I"]["f1_03"], tab[f"J_e{ep}"]["J"]["f1_03"]
+        scores[ep] = {"E_I": e_i, "J_J": j_j, "mean": (e_i + j_j) / 2, "min": min(e_i, j_j)}
+    best = sorted(eps, key=lambda ep: (-round(scores[ep]["mean"], 12), -round(scores[ep]["min"], 12), ep))[0]
+    ad = {n: adapter_info(n, best) for n in ("E", "J")}
+    st1 = json.load(open(f"{ROOT}/decisions/D24_stage1.json"))
+    out = {"run": True, "stage": "select_common_epoch", "common_epoch": best, "candidates": eps, "scores_d24": {str(k): v for k, v in scores.items()},
+           "d24_table": tab, "c_initial_d24_reference": cref, "adapters": ad, "stage1_decision_sha256": R.file_sha(f"{ROOT}/decisions/D24_stage1.json"),
+           "extended": 8 in eps, "stage1_extend": st1["extend_to_8_epochs"],
+           "v96_runs": {n: {"gen_dir": f"{ROOT}/gen/V96_{n}_e{best}", "requests": f"{ROOT}/requests/requests_V96.jsonl",
+                            "protocol": f"{ROOT}/protocol/proto_V96_{n}_e{best}.json"} for n in ("E", "J")},
+           "rule": "argmax (E_I + J_J)/2 F1@0.3 on D24; tie -> larger min -> earlier epoch",
+           "source_sha256": {"pg48_dsel.py": R.file_sha("pg48_dsel.py")}}
+    json.dump(out, open(a.out, "w"), indent=1)
+    print(json.dumps({"common_epoch": best, "scores": out["scores_d24"]}, indent=1))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    s1 = sub.add_parser("stage1")
+    s1.add_argument("--out", required=True)
+    s2 = sub.add_parser("select")
+    s2.add_argument("--epochs", nargs="+", type=int, required=True)
+    s2.add_argument("--out", required=True)
+    a = ap.parse_args()
+    {"stage1": stage1, "select": select}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pg48_eval.py b/pg48_eval.py
new file mode 100644
index 0000000..997ecd2
--- /dev/null
+++ b/pg48_eval.py
@@ -0,0 +1,234 @@
+"""iter_048 평가 (CPU only): 문장별 최대 일대일 matching F1@0.3/0.5, recall, FP/문장, invalid·EOS. 환자 점수 = 두 문장 평균, J_J = AB/BA 평균.
+
+점수 함수는 pg39_spec(parse_ids/score_request/sent_metrics)과 같은 생산 경로이며 독립 검증은 pg48_verify.py(별도 parser/matching)가 한다.
+환자 paired bootstrap 10,000회, seed 4801 (같은 환자의 모든 조건을 함께 resample). 판정 규칙은 pg48_decide.py (결과 전에 고정).
+
+라이브러리: score_dir / vectors / ci / diff. CLI: python pg48_eval.py --out results/iter_048/eval/report.json --epoch-sel results/iter_048/decisions/select.json
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+import pg39_spec as S39
+import pg43_run as R
+from rsna_diag import parse
+
+MAN = "results/iter_043/data/manifest_private.json"
+NBOOT = 10000
+SEED = 4801
+METRICS = ("f1_03", "f1_05", "recall_03", "fp_03")
+
+
+def boot_idx(n, seed=SEED, B=NBOOT):
+    return np.random.default_rng(seed).integers(0, n, size=(B, n), dtype=np.int32)
+
+
+def ci(vals, level, idx):
+    v = np.asarray(vals, float)
+    m = v[idx].mean(axis=1)
+    a = (1 - level) / 2 * 100
+    return {"mean": float(v.mean()), "lo": float(np.percentile(m, a)), "hi": float(np.percentile(m, 100 - a)), "level": level}
+
+
+def score_record(rec, e):
+    """returns (status, {target: metrics}). e: manifest entry (GT canvas)."""
+    tg = rec["targets"]
+    r = S39.parse_ids(rec["suffix_text_raw"], rec["ended_eos"], set(tg))
+    return r["status"], S39.score_request(r["status"], r["groups"], tg, e["gt_canvas_yxyx"]), r
+
+
+def score_dir(records_by_key, ents):
+    """records_by_key: {(patient, cond, targets_tuple): record}. returns per-system dict:
+    I: {(p,t): (status, metrics, eos, n_out_tok)}, AB/BA: {p: (status, {t: metrics}, eos, n_out_tok)}"""
+    out = {"I": {}, "AB": {}, "BA": {}}
+    for (p, cond, tg), rec in records_by_key.items():
+        st, sc, _ = score_record(rec, ents[p])
+        if cond == "I-short":
+            out["I"][(p, tg[0])] = (st, sc[tg[0]], bool(rec["ended_eos"]), rec["n_output_tokens"])
+        elif cond == "J-short":
+            out["AB"][p] = (st, sc, bool(rec["ended_eos"]), rec["n_output_tokens"])
+        elif cond == "J-short-rev":
+            out["BA"][p] = (st, sc, bool(rec["ended_eos"]), rec["n_output_tokens"])
+        else:
+            raise ValueError(cond)
+    return out
+
+
+def score_a(a_recs, ents, thr="0.8"):
+    """MedGrounder 출력 (원본 정규화 xyxy)을 GT(원본 정규화 xyxy)와 같은 matching 함수로 채점."""
+    out = {}
+    for (p, t), r in a_recs.items():
+        boxes = r["detections"][thr]["boxes_orig_xyxy"]
+        gt = ents[p]["gt_boxes_xyxy_norm"][t]
+        m3, m5 = S39.sent_metrics(boxes, gt, 0.3), S39.sent_metrics(boxes, gt, 0.5)
+        out[(p, t)] = {"f1_03": m3["f1"], "f1_05": m5["f1"], "recall_03": m3["recall"], "fp_03": m3["fp"], "n_pred": len(boxes), "n_gt": len(gt)}
+    return out
+
+
+def pat_vec(scored, pids, kind, metric):
+    """환자별 두 문장 평균 벡터. kind: I | AB | BA | J(AB,BA 평균) | A."""
+    if kind == "I":
+        return np.array([np.mean([scored["I"][(p, t)][1][metric] for t in ("qA", "qB")]) for p in pids])
+    if kind in ("AB", "BA"):
+        return np.array([np.mean([scored[kind][p][1][t][metric] for t in ("qA", "qB")]) for p in pids])
+    if kind == "J":
+        return (pat_vec(scored, pids, "AB", metric) + pat_vec(scored, pids, "BA", metric)) / 2
+    raise ValueError(kind)
+
+
+def a_vec(a_scored, pids, metric):
+    return np.array([np.mean([a_scored[(p, t)][metric] for t in ("qA", "qB")]) for p in pids])
+
+
+def summarize(scored, pids, idx):
+    res = {}
+    for kind in ("I", "AB", "BA", "J"):
+        res[kind] = {m: ci(pat_vec(scored, pids, kind, m), 0.95, idx) for m in METRICS}
+    for kind in ("I", "AB", "BA"):
+        items = list(scored[kind].values())
+        res[kind]["n_requests"] = len(items)
+        res[kind]["n_invalid"] = sum(it[0] not in parse.VALID for it in items)
+        res[kind]["status_counts"] = {s: sum(it[0] == s for it in items) for s in sorted({it[0] for it in items})}
+        res[kind]["eos_rate"] = float(np.mean([it[2] for it in items]))
+        res[kind]["mean_output_tokens"] = float(np.mean([it[3] for it in items]))
+    return res
+
+
+def build_report(systems, a_scored, ents, pids, strata_info):
+    """systems: {name: scored}. 모든 비교는 같은 환자 index에서."""
+    idx = boot_idx(len(pids))
+    rep = {"n_patients": len(pids), "bootstrap": {"B": NBOOT, "seed": SEED}, "systems": {}, "A": {}, "compare": {}}
+    for n, sc in systems.items():
+        rep["systems"][n] = summarize(sc, pids, idx)
+    rep["A"] = {m: ci(a_vec(a_scored, pids, m), 0.95, idx) for m in METRICS}
+    V = {}
+    for n, sc in systems.items():
+        for kind in ("I", "AB", "BA", "J"):
+            for m in METRICS:
+                V[(n, kind, m)] = pat_vec(sc, pids, kind, m)
+    for m in METRICS:
+        V[("A", "A", m)] = a_vec(a_scored, pids, m)
+
+    def d(x, y, m, level):
+        return ci(V[x + (m,)] - V[y + (m,)], level, idx)
+    cmp = {}
+    # 주비교 1/2 (97.5%)
+    cmp["M1_J_J_minus_E_J"] = {"f1_03_ci975": d(("J", "J"), ("E", "J"), "f1_03", 0.975), "f1_03_ci95": d(("J", "J"), ("E", "J"), "f1_03", 0.95)}
+    e_loss = V[("E", "I", "f1_03")] - V[("E", "J", "f1_03")]
+    j_loss = V[("J", "I", "f1_03")] - V[("J", "J", "f1_03")]
+    cmp["M2_loss_reduction_(E_I-E_J)-(J_I-J_J)"] = {"f1_03_ci975": ci(e_loss - j_loss, 0.975, idx), "f1_03_ci95": ci(e_loss - j_loss, 0.95, idx)}
+    cmp["E_loss_E_I_minus_E_J"] = {"f1_03_ci95": ci(e_loss, 0.95, idx)}
+    cmp["J_loss_J_I_minus_J_J"] = {"f1_03_ci95": ci(j_loss, 0.95, idx), "f1_03_ci975": ci(j_loss, 0.975, idx)}
+    cmp["J_I_minus_E_I"] = {m: {"ci95": d(("J", "I"), ("E", "I"), m, 0.95)} for m in METRICS}
+    # 충분성: J_AB / J_BA vs E_I
+    for o in ("AB", "BA"):
+        cmp[f"J_{o}_minus_E_I"] = {"f1_03_ci975": d(("J", o), ("E", "I"), "f1_03", 0.975), "f1_05_ci95": d(("J", o), ("E", "I"), "f1_05", 0.95),
+                                   "fp_03_ci95": d(("J", o), ("E", "I"), "fp_03", 0.95), "recall_03_ci95": d(("J", o), ("E", "I"), "recall_03", 0.95)}
+    # 추가 기준 비교
+    for name, x in (("E_I", ("E", "I")), ("J_J", ("J", "J")), ("J_I", ("J", "I")), ("E_J", ("E", "J")), ("C_I", ("C", "I")), ("C_J", ("C", "J"))):
+        cmp[f"{name}_minus_A"] = {"f1_03_ci975": d(x, ("A", "A"), "f1_03", 0.975), "f1_03_ci95": d(x, ("A", "A"), "f1_03", 0.95),
+                                  "f1_05_ci95": d(x, ("A", "A"), "f1_05", 0.95), "fp_03_ci95": d(x, ("A", "A"), "fp_03", 0.95),
+                                  "recall_03_ci95": d(x, ("A", "A"), "recall_03", 0.95)}
+    for tgt in ("E", "J"):
+        cmp[f"{tgt}_I_minus_C_I"] = {"f1_03_ci95": d((tgt, "I"), ("C", "I"), "f1_03", 0.95)}
+        cmp[f"{tgt}_J_minus_C_J"] = {"f1_03_ci95": d((tgt, "J"), ("C", "J"), "f1_03", 0.95)}
+    cmp["J_J_minus_J_I_residual"] = {"f1_03_ci95": ci(-j_loss, 0.95, idx)}
+    rep["compare"] = cmp
+    # 층별 (사전 정의; 결과와 무관)
+    rep["strata"] = strata_info["fn"](systems, a_scored, ents, pids, V, idx)
+    return rep, V
+
+
+def strata(systems, a_scored, ents, pids, V, idx):
+    """multi/single box 문장, 작은/큰 GT (가장 큰 GT box 면적이 V96 192문장 중앙값 미만), 환자 stratum. 환자 벡터 대신 문장 단위 평균 F1@0.3 (I/J 조건 문장 점수 평균)."""
+    def area(b):
+        return max(0, b[2] - b[0]) * max(0, b[3] - b[1])
+    mx = {(p, t): max(area(b) for b in ents[p]["gt_boxes_xyxy_norm"][t]) for p in pids for t in ("qA", "qB")}
+    med = float(np.median(list(mx.values())))
+    groups = {"multi_box": lambda p, t: len(ents[p]["gt_boxes_xyxy_norm"][t]) > 1, "single_box": lambda p, t: len(ents[p]["gt_boxes_xyxy_norm"][t]) == 1,
+              "small_box(max GT area<median)": lambda p, t: mx[(p, t)] < med, "large_box": lambda p, t: mx[(p, t)] >= med}
+    out = {"small_threshold_max_gt_area_median": med}
+    for gname, fn in groups.items():
+        ks = [(p, t) for p in pids for t in ("qA", "qB") if fn(p, t)]
+        row = {"n_sentences": len(ks), "systems": {}}
+        for n, sc in systems.items():
+            def s_I(k):
+                return sc["I"][k][1]["f1_03"]
+
+            def s_J(k):
+                return np.mean([sc["AB"][k[0]][1][k[1]]["f1_03"], sc["BA"][k[0]][1][k[1]]["f1_03"]])
+            row["systems"][n] = {"I_f1_03": float(np.mean([s_I(k) for k in ks])), "J_f1_03": float(np.mean([s_J(k) for k in ks])),
+                                 "I_missed_gt": float(np.mean([sc["I"][k][1]["n_gt"] - sc["I"][k][1]["tp_03"] for k in ks])),
+                                 "I_fp": float(np.mean([sc["I"][k][1]["fp_03"] for k in ks]))}
+        row["systems"]["A"] = {"f1_03": float(np.mean([a_scored[k]["f1_03"] for k in ks])), "missed_gt": float(np.mean([a_scored[k]["n_gt"] - a_scored[k]["recall_03"] * a_scored[k]["n_gt"] for k in ks])),
+                               "fp": float(np.mean([a_scored[k]["fp_03"] for k in ks]))}
+        out[gname] = row
+    return out
+
+
+def main():
+    import pg48_import as IM
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--select", required=True, help="results/iter_048/decisions/select.json (공통 epoch·adapter·gen dir)")
+    ap.add_argument("--dry-run-c", action="store_true", help="코드 경로 검사 전용: E/J 자리에 C 출력을 넣는다 (결과는 tests/dryrun에만 저장, 판정에 쓰지 않는다)")
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("output exists")
+    t0 = time.time()
+    man = json.load(open(MAN))
+    ents = {e["PatientID"]: e for e in man["V96"]}
+    pids = [e["PatientID"] for e in man["V96"]]
+    for e in man["V96"]:  # 현재 영상 hash
+        if R.file_sha(e["image"]) != e["image_file_sha256"] or R.G.load_image(e["image"])[2] != e["input_pixel_sha256"]:
+            raise R.RunError(f"current image hash mismatch {e['PatientID']}")
+    sel = json.load(open(a.select)) if not a.dry_run_c else {"common_epoch": "dryrun", "adapters": {}, "v96_runs": {}}
+    if a.dry_run_c and "tests/dryrun" not in a.out:
+        sys.exit("--dry-run-c output must live under tests/dryrun")
+    c = IM.load_c_v96()
+    csc = {"I": {}, "AB": {}, "BA": {}}
+    for tag in ("I", "AB", "BA"):
+        sub = score_dir(c[tag]["records"], ents)
+        csc[tag] = sub[tag]
+    systems = {"C": csc}
+    prov = {"C": {t: {"gen_dir": c[t]["gen_dir"], "completion_sha256": c[t]["completion_sha256"], "protocol_digest": c[t]["protocol_digest"]} for t in c}}
+    for n in ("E", "J"):
+        if a.dry_run_c:
+            systems[n] = {k: dict(v) for k, v in csc.items()}
+            prov[n] = {"gen_dir": c["I"]["gen_dir"], "dry_run_stand_in": "C"}
+            continue
+        info = sel["v96_runs"][n]
+        recs = R.verify_completion(info["gen_dir"], info["requests"], info["protocol"])
+        pd_, proto = R.verify_protocol(info["protocol"], info["requests"])
+        if proto["adapter"]["digest"] != sel["adapters"][n]["digest"]:
+            raise R.RunError(f"{n}: protocol adapter != selection")
+        byk = {(r["patient"], r["cond"], tuple(r["targets"])): r for r in recs}
+        systems[n] = score_dir(byk, ents)
+        prov[n] = {"gen_dir": info["gen_dir"], "completion_sha256": R.file_sha(os.path.join(info["gen_dir"], "completion.json")), "protocol_digest": pd_,
+                   "protocol_sha256": R.file_sha(info["protocol"]), "adapter_digest": proto["adapter"]["digest"], "epoch": sel["common_epoch"]}
+    av = IM.load_a_v96()
+    a_scored = score_a(av["records"], ents)
+    prov["A"] = {"gen_dir": av["gen_dir"], "completion_sha256": av["completion_sha256"], "ckpt_sha256": IM.A_SHA, "threshold": 0.8}
+    rep, V = build_report(systems, a_scored, ents, pids, {"fn": strata})
+    rep["provenance"] = dict(prov, eval_source_sha256=R.file_sha("pg48_eval.py"), manifest_sha256=R.file_sha(MAN), select_sha256=(R.file_sha(a.select) if not a.dry_run_c else None),
+                             spec_sha256=R.file_sha("pg39_spec.py"), parse_sha256=R.file_sha("rsna_diag/parse.py"), metrics_sha256=R.file_sha("rsna_diag/metrics.py"),
+                             eval_wall_s=time.time() - t0)
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    per = {"patients": pids, "vectors": {f"{k[0]}|{k[1]}|{k[2]}": v.tolist() for k, v in V.items()}}
+    tmp2 = a.out.replace(".json", "_per_patient.json") + f".{os.getpid()}.tmp"
+    json.dump(per, open(tmp2, "w"))
+    tmp = a.out + f".{os.getpid()}.tmp"
+    json.dump(rep, open(tmp, "w"), indent=1)
+    os.replace(tmp2, a.out.replace(".json", "_per_patient.json"))
+    os.replace(tmp, a.out)
+    print(json.dumps({n: {k: rep["systems"][n][k]["f1_03"]["mean"] for k in ("I", "AB", "BA", "J")} for n in rep["systems"]}, indent=1))
+    print("A f1_03", rep["A"]["f1_03"]["mean"])
+
+
+if __name__ == "__main__":
+    main()
