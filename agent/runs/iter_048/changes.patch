+++ b/pg48_gates.py
@@ -0,0 +1,416 @@
+"""iter_048 동작 확인 gate (결과는 results/iter_048/tests/ 의 새 파일; 기존 파일은 덮어쓰지 않는다).
+
+  python pg48_gates.py data      # CPU: 자료·target·AB/BA·좌표·분리·token 분모 (영상 hash 전수)
