+++ b/qes/selection.py
@@ -0,0 +1,74 @@
+"""Label-free tile selectors. 이 모듈은 annotation 경로를 받지 않는다."""
+import numpy as np
+
+from .data import FINDINGS, GRID
+
+NT = GRID * GRID
+MAIN_METHODS = ["C_blur", "D_blur", "C_mean", "D_mean", "crop_conf"]
+
+
+def argmax_tie_low(v):
+    v = np.asarray(v, dtype=np.float64)
+    mx = v.max()
+    idx = np.flatnonzero(v == mx)
+    return int(idx[0]), int(len(idx))
+
+
+def margin_table(requests, valid, field="m"):
+    """(image, finding) -> {'orig': float, 'crop'|'blur'|'mean': [9]}"""
+    tab = {}
+    for r in requests:
+        rec = valid[r["id"]]
+        d = tab.setdefault(r["image"], {}).setdefault(r["finding"], {
+            "crop": [None] * NT, "blur": [None] * NT, "mean": [None] * NT})
+        if r["kind"] == "orig":
+            d["orig"] = rec[field]
+        else:
+            d[r["kind"]][r["tile"]] = rec[field]
+    return tab
+
+
+def removal_scores(tab_img, kind, findings=FINDINGS):
+    """D[q] = m(I,q) - m(T(I,R),q), C[q] = D[q] - mean_{q'!=q} D[q'] (각 tile별)."""
+    D = {q: np.array([tab_img[q]["orig"] - x for x in tab_img[q][kind]]) for q in findings}
+    C = {}
+    for q in findings:
+        others = [D[o] for o in findings if o != q]
+        C[q] = D[q] - np.mean(others, axis=0)
+    return D, C
+
+
+def select_all(requests, valid, field="m", findings=FINDINGS):
+    tab = margin_table(requests, valid, field)
+    sel, scores, ties = {}, {}, []
+    for img in sorted(tab):
+        Db, Cb = removal_scores(tab[img], "blur", findings)
+        Dm, Cm = removal_scores(tab[img], "mean", findings)
+        sel[img], scores[img] = {}, {}
+        for q in findings:
+            crop = np.array(tab[img][q]["crop"])
+            maps = {"C_blur": Cb[q], "D_blur": Db[q], "C_mean": Cm[q], "D_mean": Dm[q], "crop_conf": crop}
+            sel[img][q] = {}
+            for meth, v in maps.items():
+                t, n = argmax_tie_low(v)
+                sel[img][q][meth] = t
+                if n > 1:
+                    ties.append({"image": img, "finding": q, "method": meth, "n_tied": n})
+            # 다른 질문 하나를 뺀 C_blur (민감도 전용, 주결과 대체 금지)
+            loqo = {}
+            for drop in findings:
+                if drop == q:
+                    continue
+                sub = [f for f in findings if f != drop]
+                _, Csub = removal_scores(tab[img], "blur", sub)
+                loqo[drop] = argmax_tie_low(Csub[q])[0]
+            sel[img][q]["C_blur_loqo"] = loqo
+            scores[img][q] = {
+                "m_orig": tab[img][q]["orig"],
+                "m_crop": crop.tolist(),
+                "crop_mean": float(crop.mean()),
+                "crop_max": float(crop.max()),
+                "D_blur": Db[q].tolist(), "C_blur": Cb[q].tolist(),
+                "D_mean": Dm[q].tolist(), "C_mean": Cm[q].tolist(),
+            }
+    return {"selection": sel, "scores": scores, "ties": ties}
diff --git a/qes/store.py b/qes/store.py
new file mode 100644
index 0000000..f01cec1
--- /dev/null
+++ b/qes/store.py
@@ -0,0 +1,155 @@
+"""Prediction cache validation, explicit run queue and device-minute ledger.
+
+재개(runner)와 집계(selector)가 같은 `validate_predictions`를 쓴다.
+"""
+import json
+import os
+import time
+
+# 같은 입력의 반복 결과가 이 값보다 다르면 conflicting duplicate로 본다.
+DUP_TOL = 0.0
+
+UNCOUNTED_SESSION_PENALTY_MIN = 2.0  # 비정상 종료 세션의 미계상 구간에 보수적으로 부과
+
+
+def read_jsonl(path):
+    if not os.path.exists(path):
+        return []
+    out = []
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                out.append(json.loads(line))
+    return out
+
+
+def append_jsonl(path, rec):
+    with open(path, "a") as f:
+        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
+        f.flush()
+        os.fsync(f.fileno())
+
+
+def write_json_atomic(path, obj):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f, indent=1, ensure_ascii=False)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
+
+
+def validate_predictions(requests, records, config_sha256, scorer_version):
+    """요청별로 유효한 결과를 하나 고른다.
+
+    유효 조건: status ok, id가 manifest에 있고 request/config/input hash와 scorer version이 모두 일치.
+    같은 id의 유효 결과가 여러 개인데 margin이 다르면 conflict로 두고 채택하지 않는다.
+    """
+    req_by_id = {r["id"]: r for r in requests}
+    valid, rejected, conflicts, dup_ok = {}, [], [], 0
+    for rec in records:
+        rid = rec.get("id")
+        r = req_by_id.get(rid)
+        reason = None
+        if r is None:
+            reason = "unknown_id"
+        elif rec.get("status") != "ok":
+            reason = f"status_{rec.get('status')}"
+        elif rec.get("request_sha256") != r["request_sha256"]:
+            reason = "request_hash_mismatch"
+        elif rec.get("config_sha256") != config_sha256 or r["config_sha256"] != config_sha256:
+            reason = "config_hash_mismatch"
+        elif rec.get("input_pixel_sha256") != r["input_pixel_sha256"]:
+            reason = "input_hash_mismatch"
+        elif rec.get("scorer_version") != scorer_version:
+            reason = "scorer_version_mismatch"
+        if reason:
+            rejected.append({"id": rid, "reason": reason})
+            continue
+        if rid in valid:
+            if abs(valid[rid]["m"] - rec["m"]) > DUP_TOL:
+                conflicts.append({"id": rid, "m": [valid[rid]["m"], rec["m"]]})
+            else:
+                dup_ok += 1
+            continue
+        valid[rid] = rec
+    conflict_ids = {c["id"] for c in conflicts}
+    for rid in conflict_ids:
+        valid.pop(rid, None)
+    missing = [r["id"] for r in requests if r["id"] not in valid]
+    return {
+        "valid": valid,
+        "rejected": rejected,
+        "conflicts": conflicts,
+        "duplicates_consistent": dup_ok,
+        "missing": missing,
+        "status": "complete" if not missing and not conflicts else "incomplete",
+    }
+
+
+def plan_queue(requests, done_ids, allowed_ids=None, limit=None):
+    """실행할 요청 목록을 한 번에 명시적으로 만든다 (반복 중 재할당하지 않는다)."""
+    q = [r for r in requests if r["id"] not in done_ids]
+    if allowed_ids is not None:
+        allowed = set(allowed_ids)
+        q = [r for r in q if r["id"] in allowed]
+    if limit is not None:
+        q = q[:limit]
+    return q
+
+
+class Ledger:
+    """device-minute 사용량 checkpoint. 매 요청 완료 시 저장한다.
+
+    세션 시작 시 open=True로 기록하고 정상/예외 종료 시 close한다. 다음 실행에서 open 상태로 남은
+    세션이 발견되면 마지막 checkpoint 이후 구간을 알 수 없으므로 penalty를 추가 계상한다.
+    """
+
+    def __init__(self, path, n_devices=1):
+        self.path = path
+        self.n_devices = n_devices
+        self.data = {"sessions": [], "cap_minutes": None}
+        if os.path.exists(path):
+            with open(path) as f:
+                self.data = json.load(f)
+        for s in self.data["sessions"]:
+            if s.get("open"):
+                s["open"] = False
+                s["closed_by"] = "recovered_unclosed"
+                s["uncounted_penalty_min"] = UNCOUNTED_SESSION_PENALTY_MIN
+        self.cur = None
+
+    def total_minutes(self):
+        tot = 0.0
+        for s in self.data["sessions"]:
+            tot += s.get("device_minutes", 0.0) + s.get("uncounted_penalty_min", 0.0)
+        return tot
+
+    def start(self, note):
+        self.t0 = time.time()
+        self.cur = {"note": note, "start": self.t0, "last_checkpoint": self.t0, "open": True,
+                    "device_minutes": 0.0, "n_requests": 0, "inflight": None, "n_devices": self.n_devices}
+        self.data["sessions"].append(self.cur)
+        self.save()
+
+    def mark_inflight(self, what):
+        self.cur["inflight"] = what
+        self.checkpoint()
+
+    def checkpoint(self, n_done_delta=0, **extra):
+        now = time.time()
+        self.cur["last_checkpoint"] = now
+        self.cur["device_minutes"] = (now - self.t0) / 60.0 * self.n_devices
+        self.cur["n_requests"] += n_done_delta
+        self.cur.update(extra)
+        self.save()
+
+    def close(self, how):
+        self.cur["inflight"] = None
+        self.cur["open"] = False
+        self.cur["closed_by"] = how
+        self.checkpoint()
+
+    def save(self):
+        write_json_atomic(self.path, self.data)
diff --git a/run_qes.py b/run_qes.py
new file mode 100644
index 0000000..056a8f8
--- /dev/null
+++ b/run_qes.py
@@ -0,0 +1,227 @@
+"""iter_004 GPU runner: calibration / full scoring / verification (1 GPU, 1 process).
+
+실행:
+  python research/run_qes.py --out research/results/iter_004 --phase calib
+  python research/run_qes.py --out research/results/iter_004 --phase full
+  python research/run_qes.py --out research/results/iter_004 --phase verify
+"""
+import argparse
+import json
+import os
+import statistics
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from qes.data import (DATA_DIR, SCORER_VERSION, ImageInputs, build_config, config_hash,  # noqa: E402
+                      file_sha256, pixel_hash, sha256_json)
+from qes.store import (Ledger, append_jsonl, plan_queue, read_jsonl, validate_predictions,  # noqa: E402
+                       write_json_atomic)
+
+DEFAULT_REQ_MIN = 0.5  # 관측 전 1요청 추정 (보수적)
+VERIFY_FORWARDS_PER_GEN = 8
+
+
+def load_manifest(out):
+    cfg = build_config()
+    chash = config_hash(cfg)
+    stored = json.load(open(os.path.join(out, "config.json")))
+    if stored.get("config_sha256") != chash:
+        raise SystemExit("config.json hash differs from current code config -> rebuild manifest in a new dir")
+    reqs = read_jsonl(os.path.join(out, "requests.jsonl"))
+    for r in reqs:
+        body = {k: v for k, v in r.items() if k != "request_sha256"}
+        if sha256_json(body) != r["request_sha256"] or r["config_sha256"] != chash:
+            raise SystemExit(f"request hash/config mismatch: {r['id']}")
+    info = json.load(open(os.path.join(out, "image_info.json")))
+    subsets = json.load(open(os.path.join(out, "subsets.json")))
+    return cfg, chash, reqs, info, subsets
+
+
+class InputCache:
+    """실제 파일에서 입력을 다시 만들고 manifest hash와 대조한다."""
+
+    def __init__(self, info, data_dir=DATA_DIR):
+        self.info = info
+        self.data_dir = data_dir
+        self.cur_name, self.cur = None, None
+
+    def get(self, r):
+        if r["image"] != self.cur_name:
+            path = os.path.join(self.data_dir, r["image"])
+            inf = self.info[r["image"]]
+            if file_sha256(path) != inf["source_file_sha256"]:
+                raise RuntimeError(f"source file hash changed: {path}")
+            ii = ImageInputs(path)
+            if pixel_hash(ii.orig) != inf["source_pixel_sha256"]:
+                raise RuntimeError(f"source pixel hash changed: {path}")
+            self.cur_name, self.cur = r["image"], ii
+        img = self.cur.make(r["kind"], r["tile"])
+        h = pixel_hash(img)
+        if h != r["input_pixel_sha256"]:
+            raise RuntimeError(f"input pixel hash mismatch: {r['id']}")
+        return img, h
+
+
+def pick_gpu():
+    if os.environ.get("CUDA_VISIBLE_DEVICES"):
+        return os.environ["CUDA_VISIBLE_DEVICES"], "preset"
+    q = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.free", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True, check=True).stdout
+    free = {int(a): int(b) for a, b in (ln.split(",") for ln in q.strip().splitlines())}
+    best = max(free, key=lambda k: (free[k], -k))
+    if free[best] < 12000:
+        raise SystemExit(f"not enough free GPU memory: {free}")
+    os.environ["CUDA_VISIBLE_DEVICES"] = str(best)
+    return str(best), f"auto(free MiB={free})"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--phase", choices=["calib", "full", "verify"], required=True)
+    ap.add_argument("--cap", type=float, default=45.0, help="누적 device-minute 상한")
+    ap.add_argument("--target", type=float, default=40.0, help="calibration 예상 총량 허용치")
+    args = ap.parse_args()
+
+    cfg, chash, reqs, info, subsets = load_manifest(args.out)
+    pred_path = os.path.join(args.out, "predictions.jsonl")
+    ledger = Ledger(os.path.join(args.out, "budget.json"))
+    used0 = ledger.total_minutes()
+    print(f"[budget] used so far {used0:.3f} device-min (cap {args.cap})", flush=True)
+    if used0 >= args.cap:
+        raise SystemExit("budget cap reached; not starting")
+
+    v = validate_predictions(reqs, read_jsonl(pred_path), chash, SCORER_VERSION)
+    print(f"[cache] valid={len(v['valid'])} rejected={len(v['rejected'])} conflicts={len(v['conflicts'])} "
+          f"missing={len(v['missing'])}", flush=True)
+    if v["conflicts"]:
+        raise SystemExit(f"conflicting duplicate results: {v['conflicts'][:3]}")
+
+    if args.phase == "calib":
+        queue = plan_queue(reqs, set(v["valid"]), allowed_ids=subsets["calibration"])
+    elif args.phase == "full":
+        cal = json.load(open(os.path.join(args.out, "calibration.json")))
+        if cal["projected_total_device_min"] > args.target:
+            raise SystemExit(f"calibration projection {cal['projected_total_device_min']:.1f} > {args.target}")
+        queue = plan_queue(reqs, set(v["valid"]))
+    else:
+        missing_ver = [i for i in subsets["verification"] if i not in v["valid"]]
+        if missing_ver:
+            raise SystemExit(f"verification inputs lack main results: {missing_ver}")
+        queue = [r for r in reqs if r["id"] in set(subsets["verification"])]
+    print(f"[queue] phase={args.phase} n={len(queue)}", flush=True)
+    if not queue:
+        print("[queue] nothing to do", flush=True)
+        return
+
+    gpu, how = pick_gpu()
+    ledger.start(f"{args.phase} gpu={gpu}")
+    how_closed = "exception"
+    times, n_err = [], 0
+    stopped_reason = None
+    try:
+        t_load = time.time()
+        from qes.scorer import Scorer
+        sc = Scorer()
+        env = sc.load()
+        env["gpu_select"] = how
+        env["load_seconds"] = time.time() - t_load
+        write_json_atomic(os.path.join(args.out, f"env_{args.phase}_{int(time.time())}.json"), env)
+        ledger.checkpoint(load_seconds=env["load_seconds"])
+        print(f"[load] {env['load_seconds']:.1f}s  gpu={gpu}", flush=True)
+        inputs = InputCache(info)
+        import torch
+
+        if args.phase in ("calib", "full"):
+            for i, r in enumerate(queue):
+                est = max(times) / 60.0 if times else DEFAULT_REQ_MIN
+                if ledger.total_minutes() + est > args.cap:
+                    stopped_reason = f"budget: next request est {est:.3f} min exceeds remaining"
+                    break
+                ledger.mark_inflight(r["id"])
+                t0 = time.time()
+                try:
+                    img, h = inputs.get(r)
+                    out = sc.score(img, r["prompt"])
+                    rec = {"id": r["id"], "status": "ok", **out}
+                except torch.cuda.OutOfMemoryError as e:
+                    rec = {"id": r["id"], "status": "oom", "error": str(e)[:300]}
+                    stopped_reason = "oom"
+                except Exception as e:  # 형식·hash 오류 등은 error로 기록
+                    rec = {"id": r["id"], "status": "error", "error": repr(e)[:300]}
+                    n_err += 1
+                dt = time.time() - t0
+                rec.update({"request_sha256": r["request_sha256"], "config_sha256": chash,
+                            "input_pixel_sha256": r["input_pixel_sha256"], "scorer_version": SCORER_VERSION,
+                            "phase": args.phase, "seconds": dt, "ts": time.time()})
+                append_jsonl(pred_path, rec)
+                if rec["status"] == "ok":
+                    times.append(dt)
+                ledger.cur["inflight"] = None
+                ledger.checkpoint(n_done_delta=1)
+                if (i + 1) % 100 == 0 or i < 3:
+                    print(f"[score] {i + 1}/{len(queue)} {r['id']} m={rec.get('m')} {dt:.2f}s "
+                          f"used={ledger.total_minutes():.2f}", flush=True)
+                if stopped_reason == "oom" or n_err > 5:
+                    stopped_reason = stopped_reason or "too many errors"
+                    break
+        else:
+            valid = v["valid"]
+            ver_path = os.path.join(args.out, "verification.jsonl")
+            session = int(time.time())
+            for r in queue:
+                if ledger.total_minutes() + 1.0 > args.cap:
+                    stopped_reason = "budget"
+                    break
+                ledger.mark_inflight("verify:" + r["id"])
+                img, h = inputs.get(r)
+                t0 = time.time()
+                rep = sc.score(img, r["prompt"])
+                t1 = time.time()
+                tf = sc.teacher_forced(img, r["prompt"])
+                t2 = time.time()
+                gen = sc.generate(img, r["prompt"], max_new_tokens=8)
+                t3 = time.time()
+                main_m = valid[r["id"]]["m"]
+                rec = {"id": r["id"], "session": session, "m_main": main_m, "m_repeat": rep["m"],
+                       "repeat_abs_diff": abs(rep["m"] - main_m), **tf, "tf_abs_diff": abs(tf["m_tf"] - main_m),
+                       **gen, "score_decision": "Yes" if main_m > 0 else "No",
+                       "gen_agrees": gen["gen_parsed"] == ("Yes" if main_m > 0 else "No"),
+                       "sec_repeat": t1 - t0, "sec_tf": t2 - t1, "sec_gen": t3 - t2,
+                       "request_sha256": r["request_sha256"], "config_sha256": chash}
+                append_jsonl(ver_path, rec)
+                ledger.cur["inflight"] = None
+                ledger.checkpoint(n_done_delta=1)
+                print(f"[verify] {r['id']} main={main_m:.4f} rep={rep['m']:.4f} tf={tf['m_tf']:.4f} "
+                      f"gen={gen['gen_text']!r}", flush=True)
+        how_closed = "normal" if stopped_reason is None else f"stopped:{stopped_reason}"
+    except KeyboardInterrupt:
+        how_closed = "interrupted"
+        raise
+    finally:
+        ledger.close(how_closed)
+        print(f"[budget] session closed ({how_closed}); total {ledger.total_minutes():.3f} device-min", flush=True)
+
+    if args.phase == "calib":
+        v2 = validate_predictions(reqs, read_jsonl(pred_path), chash, SCORER_VERSION)
+        per_req_min = statistics.median(times) / 60.0 if times else DEFAULT_REQ_MIN
+        load_min = env["load_seconds"] / 60.0
+        remaining = len(v2["missing"])
+        verify_min = 12 * per_req_min * (1 + 2 + VERIFY_FORWARDS_PER_GEN)
+        projected = ledger.total_minutes() + 2 * load_min + remaining * per_req_min * 1.2 + verify_min
+        cal = {"n_calibration_done": len(times), "median_sec_per_request": per_req_min * 60,
+               "max_sec_per_request": max(times) if times else None, "load_min": load_min,
+               "used_device_min": ledger.total_minutes(), "remaining_requests": remaining,
+               "verify_est_min": verify_min, "projected_total_device_min": projected,
+               "target": args.target, "proceed": projected <= args.target,
+               "formula": "used + 2*load + remaining*median*1.2 + 12*median*(1+2+8)"}
+        write_json_atomic(os.path.join(args.out, "calibration.json"), cal)
+        print(json.dumps(cal, indent=1), flush=True)
+    if stopped_reason:
+        print(f"[status] incomplete: {stopped_reason}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/select_qes.py b/select_qes.py
new file mode 100644
index 0000000..fd16e4a
--- /dev/null
+++ b/select_qes.py
@@ -0,0 +1,50 @@
+"""Label-free selection. 모든 질문의 선택을 annotation 접근 없이 먼저 저장·고정한다.
+
+실행: python research/select_qes.py --out research/results/iter_004
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from qes.data import SCORER_VERSION, build_config, config_hash  # noqa: E402
+from qes.selection import select_all  # noqa: E402
+from qes.store import read_jsonl, validate_predictions, write_json_atomic  # noqa: E402
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+    chash = config_hash(build_config())
+    reqs = read_jsonl(os.path.join(args.out, "requests.jsonl"))
+    pred_path = os.path.join(args.out, "predictions.jsonl")
+    v = validate_predictions(reqs, read_jsonl(pred_path), chash, SCORER_VERSION)
+    status = {"status": v["status"], "n_requests": len(reqs), "n_valid": len(v["valid"]),
+              "n_missing": len(v["missing"]), "n_conflicts": len(v["conflicts"]),
+              "n_rejected": len(v["rejected"]), "rejected_reasons": {}}
+    for x in v["rejected"]:
+        status["rejected_reasons"][x["reason"]] = status["rejected_reasons"].get(x["reason"], 0) + 1
+    write_json_atomic(os.path.join(args.out, "completion.json"), status)
+    print(json.dumps(status), flush=True)
+    if v["status"] != "complete":
+        raise SystemExit("incomplete: selection not computed (결측 조합을 제외하고 계산하지 않는다)")
+    main_sel = select_all(reqs, v["valid"], field="m")
+    fp32_sel = select_all(reqs, v["valid"], field="m_fp32head")
+    pred_digest = hashlib.sha256(
+        json.dumps({k: v["valid"][k]["m"] for k in sorted(v["valid"])}).encode()).hexdigest()
+    out = {"predictions_digest": pred_digest, "config_sha256": chash, "label_free": True,
+           "main": main_sel, "sensitivity_fp32head": fp32_sel}
+    path = os.path.join(args.out, "selections.json")
+    if os.path.exists(path):
+        old = json.load(open(path))
+        if old["predictions_digest"] != pred_digest:
+            raise SystemExit("selections.json exists for different predictions; refusing to overwrite")
+    write_json_atomic(path, out)
+    print(f"selections saved: {path}; ties(main)={len(main_sel['ties'])} ties(fp32)={len(fp32_sel['ties'])}")
+
+
+if __name__ == "__main__":
+    main()
