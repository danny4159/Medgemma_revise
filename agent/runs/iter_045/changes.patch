+"""iter_045: C timing block 출력의 token 정합성(기존 iter_040 C 192 출력 대비)·EOS·입력 hash·자원 요약.
+
+python mg45_ccheck.py DIR [DIR ...]   (결과는 stdout JSON; 저장은 호출자가 필요 시 리다이렉트하지 않고 timing 리포트가 읽는다)
+"""
+import glob
+import json
+import sys
+
+import numpy as np
+
+OLD = "results/iter_040/gen/C"
+
+
+def old_records():
+    old = {}
+    for f in glob.glob(OLD + "/gen_worker*.jsonl"):
+        for l in open(f):
+            r = json.loads(l)
+            old[r["request_id"]] = r
+    return old
+
+
+def check(d, old=None):
+    old = old or old_records()
+    recs = []
+    for f in sorted(glob.glob(d + "/ctime_worker*.jsonl")):
+        recs += [json.loads(l) for l in open(f)]
+    mm = [r["request_id"] for r in recs if r["suffix_ids"] != old[r["request_id"]]["suffix_ids"]]
+    c = json.load(open(d + "/completion.json"))
+    lat = {}
+    for r in recs:
+        lat[r["patient"]] = r["t_patient_done"] - r["t_patient_dispatch"]
+    lv = np.array(list(lat.values()))
+    rl = [json.loads(x) for x in open(d + "/resource_log.jsonl")]
+    gmax = {}
+    for r in rl:
+        for g in r["gpu"]:
+            i, used, _ = [int(x) for x in g.split(",")]
+            gmax[i] = max(gmax.get(i, 0), used)
+    return {"dir": d, "n": len(recs), "token_mismatch": len(mm), "mismatch_ids": mm[:5], "all_eos": all(r["ended_eos"] for r in recs),
+            "input_pixel_equal": all(r["input_pixel_sha256"] == old[r["request_id"]]["input_pixel_sha256"] for r in recs),
+            "n_retry": sum(len(r["attempts"]) > 1 for r in recs),
+            "workload_wall_s": c.get("workload_wall_s"), "device_seconds_union": c.get("device_seconds_union"),
+            "patients_per_min": 96 / c["workload_wall_s"] * 60 if c.get("workload_wall_s") else None,
+            "latency_s": {"mean": float(lv.mean()), "p50": float(np.percentile(lv, 50)), "p95": float(np.percentile(lv, 95))},
+            "peak_alloc_gb_max": c.get("peak_alloc_gb_max"), "peak_reserved_gb_max": c.get("peak_reserved_gb_max"),
+            "gpu_used_mib_max_sampled": gmax, "cold_load_s": c.get("cold_load_s"), "mapping": c["mapping"]}
+
+
+if __name__ == "__main__":
+    old = old_records()
+    for d in sys.argv[1:]:
+        print(json.dumps(check(d, old), indent=1))
diff --git a/mg45_ctime.py b/mg45_ctime.py
new file mode 100644
index 0000000..9bb6a95
--- /dev/null
+++ b/mg45_ctime.py
@@ -0,0 +1,281 @@
+"""iter_045 C(MedGemma+LoRA seed17 epoch03) timing worker/launcher. 기본(medgemma) python 실행.
+
+환자 단위 작업: worker가 환자 claim(flock)을 얻은 시점이 dispatch이고, 그 환자의 두 문장 요청을 순차 생성·후처리(JSON parse + canvas->원본 좌표 변환)한 뒤의
+시각이 done이다. 요청 입력은 기존 C V96 요청(results/iter_040/requests/requests_V96.jsonl, prompt/cap/adapter 불변)이며 greedy 출력은
+기존 192개 token과 대조한다 (불일치는 조사 대상; 기존 정확도 출력은 대체하지 않는다).
+timing worker는 pg43_run과 달리 claim마다 전체 record를 재검증하지 않는다(검증은 block 종료 후 launcher가 수행): 비용 측정에 장부 검증 시간을 넣지 않기 위함.
+
+사용:
+  python mg45_ctime.py launch --out-dir DIR --workers 4 --gpus 0,1 [--barrier] [--warmup-n 8] [--peak-gb 9] [--set V96|D24]
+  (worker는 launcher가 호출: python mg45_ctime.py worker ...)
+"""
+import argparse
+import glob
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+
+REQ = {"V96": "results/iter_040/requests/requests_V96.jsonl"}
+PROTO = "results/iter_040/protocol/protocol_C.json"
+MAN = "results/iter_043/data/manifest_private.json"
+
+
+def sha_b(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def file_sha(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def try_flock(path):
+    import fcntl
+    fd = os.open(path, os.O_CREAT | os.O_RDWR)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError:
+        os.close(fd)
+        return None
+    return fd
+
+
+def load_rows(setname):
+    rows = [json.loads(l) for l in open(REQ[setname]) if l.strip()]
+    by_p = {}
+    for r in rows:
+        by_p.setdefault(r["patient"], []).append(r)
+    return rows, by_p
+
+
+def worker(a):
+    from rsna_diag import generate as G
+    import pg39_spec as S39
+    import pg43_eval as E
+    from rsna_diag import parse
+    t_proc = time.time()
+    proto = json.load(open(PROTO))
+    rows, by_p = load_rows(a.set)
+    torch, proc, model = G.load_model()
+    adig = G.load_adapter(torch, model, proto["adapter"]["path"])
+    if adig != proto["adapter"]["digest"]:
+        sys.exit("adapter digest != protocol")
+    env = G.env_info(torch, proc, model)
+    for k, v in proto["generation_config"].items():
+        if k in env and k not in ("runner", "image_size") and env[k] != v:
+            sys.exit(f"runtime env {k}={env[k]!r} != protocol {v!r}")  # 생성 설정 불일치는 fatal (chat template/model revision/dtype 등)
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    t_ready = time.time()
+    man = json.load(open(MAN))
+    ents = {e["PatientID"]: e for e in man["V96"] + man["D24"]}  # warm-up(D8)와 본 작업(V96) 환자 모두 포함
+
+    def do_request(row, record_dir=None):
+        image, aff, pxs = G.load_image(row["image"])
+        inp = G.build_inputs(proc, image, row["prompt"])
+        ids_in = inp["input_ids"][0].tolist()
+        attempts = []
+        for cap in row["caps"]:
+            at = G.generate(torch, proc, model, inp, cap, eos_ids)
+            attempts.append(at)
+            if at["ended_eos"]:
+                break
+        fin = attempts[-1]
+        txt = proc.tokenizer.decode(fin["suffix_ids"], skip_special_tokens=False)
+        # 후처리: 공통 parser로 box 추출 후 canvas->원본 정규화 xyxy (평가와 같은 함수)
+        t = row["targets"][0]
+        pr = S39.parse_ids(txt, fin["ended_eos"], {t})
+        boxes = [E.canvas_to_norm_xyxy(b, aff, ents[row["patient"]]["h"], ents[row["patient"]]["w"]) for b in pr["groups"][t]] if pr["status"] in parse.VALID else []
+        return {"suffix_ids": fin["suffix_ids"], "suffix_text_raw": txt, "ended_eos": fin["ended_eos"], "n_output_tokens": fin["n_new"],
+                "final_cap": fin["cap"], "status": pr["status"], "boxes_orig_xyxy": boxes, "input_pixel_sha256": pxs,
+                "n_input_tokens": len(ids_in), "input_ids_sha256": sha_b(json.dumps(ids_in).encode()),
+                "attempts": [{k: v for k, v in at.items() if k != "suffix_ids"} for at in attempts],
+                "peak_mem_alloc_gb_max": max(at["peak_mem_alloc_gb"] for at in attempts),
+                "peak_mem_reserved_gb_max": max(at["peak_mem_reserved_gb"] for at in attempts)}
+
+    if a.warmup_n:
+        d8 = sorted(man["D8"])[: max(1, a.warmup_n // 2)]
+        d24 = {e["PatientID"]: e for e in man["D24"]}
+        for p in d8:
+            for t in ("qA", "qB"):
+                row = {"patient": p, "image": d24[p]["image"], "prompt": S39.prompt_I_short(d24[p]["sentences"][t], t),
+                       "caps": [1000, 2000, 4000], "targets": [t]}
+                do_request(row)
+        torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    t_warm = time.time()
+    if a.barrier:
+        open(os.path.join(a.barrier, f"ready.{a.worker}"), "w").write(json.dumps({"t": time.time(), "pid": os.getpid()}))
+        gof = os.path.join(a.barrier, "go")
+        while not os.path.exists(gof):
+            time.sleep(0.005)
+        t_go = json.load(open(gof))["t"]
+    else:
+        t_go = None
+    out = os.path.join(a.out_dir, f"ctime_worker{a.worker}.jsonl")
+    cdir = os.path.join(a.out_dir, "claims")
+    os.makedirs(cdir, exist_ok=True)
+    n_new = 0
+    with open(out, "a") as f:
+        for p in sorted(by_p):
+            try:  # 영구 claim (O_EXCL): flock은 claim 보유 worker가 종료하면 풀려 꼬리 구간에서 같은 환자를 다른 worker가 다시 처리하는 중복이 실제 발생했다 (block1_a1_C)
+                fd = os.open(os.path.join(cdir, p + ".claim"), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+                os.write(fd, json.dumps({"worker": a.worker, "t": time.time()}).encode())
+                os.close(fd)
+            except FileExistsError:
+                continue
+            t_disp = time.time()
+            res = {}
+            for row in sorted(by_p[p], key=lambda r: r["targets"][0]):
+                t_req = time.time()
+                r = do_request(row)
+                r.update({"request_id": row["request_id"], "patient": p, "target": row["targets"][0], "t_req_start": t_req, "t_req_done": time.time()})
+                res[row["targets"][0]] = r
+            t_done = time.time()
+            for t, r in res.items():
+                r.update({"t_patient_dispatch": t_disp, "t_patient_done": t_done, "worker": a.worker, "gpu_uuid": env.get("gpu_uuid"),
+                          "cuda_visible": os.environ.get("CUDA_VISIBLE_DEVICES")})
+                f.write(json.dumps(r) + "\n")
+                n_new += 1
+            f.flush()
+            os.fsync(f.fileno())
+    t_end = time.time()
+    if a.barrier:
+        open(os.path.join(a.barrier, f"done.{a.worker}"), "w").write(json.dumps({"t": t_end, "n_new": n_new}))
+    json.dump({"worker": a.worker, "t_proc_start": t_proc, "t_model_ready": t_ready, "t_warm_done": t_warm, "t_go": t_go, "t_end": t_end, "load_s": t_ready - t_proc,
+               "n_new": n_new, "peak_alloc_gb": torch.cuda.max_memory_allocated() / 2**30, "peak_reserved_gb": torch.cuda.max_memory_reserved() / 2**30,
+               "cuda_visible": os.environ.get("CUDA_VISIBLE_DEVICES"), "adapter_digest": adig},
+              open(os.path.join(a.out_dir, f"worker{a.worker}.meta.{int(t_proc)}.json"), "x"), indent=1)
+    print(f"worker {a.worker}: {n_new} requests", flush=True)
+
+
+def gpu_free_mib():
+    r = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used,memory.total", "--format=csv,noheader,nounits"], capture_output=True, text=True, check=True)
+    return {int(l.split(",")[0]): (int(l.split(",")[2]) - int(l.split(",")[1])) for l in r.stdout.strip().splitlines()}
+
+
+def union(ivs):
+    tot, cs, ce = 0.0, None, None
+    for s_, e_ in sorted(ivs):
+        if ce is None or s_ > ce:
+            if ce is not None:
+                tot += ce - cs
+            cs, ce = s_, e_
+        else:
+            ce = max(ce, e_)
+    return tot + ((ce - cs) if ce is not None else 0.0)
+
+
+def launch(a):
+    os.makedirs(a.out_dir, exist_ok=True)
+    if os.path.exists(os.path.join(a.out_dir, "completion.json")):
+        sys.exit("completion exists")
+    allowed = [int(x) for x in os.environ["CUDA_VISIBLE_DEVICES"].split(",")] if os.environ.get("CUDA_VISIBLE_DEVICES") else None
+    if allowed is None:
+        sys.exit("CUDA_VISIBLE_DEVICES not set")
+    gpus = [int(x) for x in a.gpus.split(",")] if a.gpus else allowed
+    if not set(gpus) <= set(allowed):
+        sys.exit("--gpus not within allowed")
+    free = gpu_free_mib()
+    gpus = sorted(gpus, key=lambda g: (-free[g], g))
+    mapping = {k: gpus[k % len(gpus)] for k in range(a.workers)}
+    per = {}
+    for k, g in mapping.items():
+        per.setdefault(g, []).append(k)
+    for g, ws in per.items():
+        need = len(ws) * (a.peak_gb + 2.0) * 1024
+        if free[g] < need:
+            sys.exit(f"gpu {g}: free {free[g]}MiB < need {need:.0f}MiB for workers {ws}")
+    bdir = os.path.join(a.out_dir, "barrier") if a.barrier else None
+    if bdir:
+        os.makedirs(bdir, exist_ok=True)
+    json.dump({"mapping": mapping, "free_mib_before": free, "args": vars(a), "code_sha256": file_sha("mg45_ctime.py"),
+               "protocol_sha256": file_sha(PROTO), "requests_sha256": file_sha(REQ[a.set])}, open(os.path.join(a.out_dir, "launch_protocol.json"), "x"), indent=1)
+    t0 = time.time()
+    procs = {}
+    for k in range(a.workers):
+        env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(mapping[k]))
+        cmd = [sys.executable, "mg45_ctime.py", "worker", "--set", a.set, "--out-dir", a.out_dir, "--worker", str(k), "--warmup-n", str(a.warmup_n)]
+        if bdir:
+            cmd += ["--barrier", bdir]
+        procs[k] = subprocess.Popen(cmd, env=env, stdout=open(os.path.join(a.out_dir, f"worker{k}.stdout"), "a"), stderr=open(os.path.join(a.out_dir, f"worker{k}.stderr"), "a"))
+    rl = open(os.path.join(a.out_dir, "resource_log.jsonl"), "a")
+    t_go, last = None, 0
+    while any(p.poll() is None for p in procs.values()):
+        if bdir and t_go is None:
+            if all(os.path.exists(os.path.join(bdir, f"ready.{k}")) for k in range(a.workers)):
+                t_go = time.time()
+                tmpg = os.path.join(bdir, f"go.{os.getpid()}.tmp")
+                json.dump({"t": t_go}, open(tmpg, "w"))
+                os.replace(tmpg, os.path.join(bdir, "go"))
+            elif any(p.poll() is not None for p in procs.values()):
+                break
+        time.sleep(0.02 if (bdir and t_go is None) else 0.5)
+        if time.time() - last > 5:
+            last = time.time()
+            used = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used,utilization.gpu", "--format=csv,noheader,nounits"], capture_output=True, text=True).stdout.strip().splitlines()
+            rl.write(json.dumps({"t": round(time.time() - t0, 1), "gpu": used}) + "\n")
+            rl.flush()
+    codes = [procs[k].wait() for k in range(a.workers)]
+    wall = time.time() - t0
+    recs = []
+    for fn in sorted(glob.glob(os.path.join(a.out_dir, "ctime_worker*.jsonl"))):
+        recs += [json.loads(l) for l in open(fn, "rb").read().split(b"\n")[:-1] if l.strip()]
+    rows, by_p = load_rows(a.set)
+    ids = [r["request_id"] for r in recs]
+    want = {r["request_id"] for r in rows}
+    complete = len(ids) == len(set(ids)) and set(ids) == want
+    iv = {}
+    for r in recs:
+        iv.setdefault(mapping[r["worker"]], set()).add((r["t_patient_dispatch"], r["t_patient_done"]))
+    res = {"exit_codes": codes, "launcher_wall_s_incl_loading": wall, "n_records": len(recs), "n_unique": len(set(ids)), "n_expected": len(want), "complete": complete,
+           "workers": a.workers, "mapping": mapping, "t_go": t_go,
+           "device_seconds_union": sum(union(v) for v in iv.values()) if iv else None,
+           "peak_alloc_gb_max": None}
+    metas = [json.load(open(p)) for p in glob.glob(os.path.join(a.out_dir, "worker*.meta.*.json"))]
+    if metas:
+        res["peak_alloc_gb_max"] = max(m["peak_alloc_gb"] for m in metas)
+        res["peak_reserved_gb_max"] = max(m["peak_reserved_gb"] for m in metas)
+        res["cold_load_s"] = {m["worker"]: m["load_s"] for m in metas}
+    if bdir:
+        dn = [json.load(open(p))["t"] for p in glob.glob(os.path.join(bdir, "done.*"))]
+        res["workload_wall_s"] = (max(dn) - t_go) if (dn and t_go) else None
+    if complete and all(c == 0 for c in codes):
+        res["worker_file_sha256"] = {os.path.basename(f): file_sha(f) for f in sorted(glob.glob(os.path.join(a.out_dir, "ctime_worker*.jsonl")))}
+        tmp = os.path.join(a.out_dir, f"completion.{os.getpid()}.tmp")
+        json.dump(res, open(tmp, "w"), indent=1)
+        os.replace(tmp, os.path.join(a.out_dir, "completion.json"))
+        print("completion", json.dumps({k: res[k] for k in ("exit_codes", "n_unique", "launcher_wall_s_incl_loading", "workload_wall_s") if k in res}))
+    else:
+        json.dump(res, open(os.path.join(a.out_dir, f"partial_{int(time.time())}.json"), "w"), indent=1)
+        print("NOT complete", json.dumps({k: res[k] for k in ("exit_codes", "n_unique", "n_expected")}))
+        sys.exit(1)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    w = sub.add_parser("worker")
+    l = sub.add_parser("launch")
+    for s in (w, l):
+        s.add_argument("--out-dir", required=True)
+        s.add_argument("--set", default="V96")
+        s.add_argument("--warmup-n", type=int, default=8)
+    w.add_argument("--worker", type=int, required=True)
+    w.add_argument("--barrier", default=None)
+    l.add_argument("--workers", type=int, required=True)
+    l.add_argument("--gpus", default=None)
+    l.add_argument("--barrier", action="store_true")
+    l.add_argument("--peak-gb", type=float, default=9.0)
+    a = ap.parse_args()
+    {"worker": worker, "launch": launch}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mg45_d8.py b/mg45_d8.py
new file mode 100644
index 0000000..921bead
--- /dev/null
+++ b/mg45_d8.py
@@ -0,0 +1,144 @@
+"""iter_045 D8 동작 확인 (venv 실행): checkpoint strict load, 공식 dataset 경로와 wrapper 입력 tensor 일치, 좌표 왕복,
+confidence·threshold·WBF 순서, batch 1 vs N 정합성, empty/복수 box fixture.  GT는 좌표 역변환 검사에만 쓰고 운영점 선택에 쓰지 않는다.
+
+python mg45_vrun.py mg45_d8.py --out results/iter_045/d8/d8_check.json   (CUDA_VISIBLE_DEVICES로 장치 지정)
+"""
+import argparse
+import ast
+import json
+import os
+import sys
+import time
+
+import mg45_mg as M
+
+MAN = "results/iter_043/data/manifest_private.json"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("output exists")
+    import numpy as np
+    import pandas as pd
+    import torch
+    dev = torch.device("cuda:0")
+    man = json.load(open(MAN))
+    d24 = {e["PatientID"]: e for e in man["D24"]}
+    d8 = [d24[p] for p in man["D8"]]
+    tf = M.val_transform()
+    res = {"manifest_sha256": M.file_sha(MAN), "n_d8": len(d8), "checks": {}}
+
+    # --- 공식 dataset 경로와 wrapper 입력 일치 ---
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    csv = os.path.join(os.path.dirname(a.out), "official_dataset_input.csv")
+    rows = []
+    for e in d8:
+        for t in ("qA", "qB"):
+            rows.append({"image_id": e["ImageID"], "split": "test", "sentence_en": e["sentences"][t],
+                         "labels": str(["cardiomegaly"]),  # 범주는 공식 dataset의 lookup 통과용 더미 (모델 입력 아님)
+                         "boxes": str([list(map(float, b)) for b in e["gt_boxes_xyxy_norm"][t]])})
+    pd.DataFrame(rows).to_csv(csv, index=False)
+    from dataloaders.dataset import GMPGPadChestDataset
+    ds = GMPGPadChestDataset(csv, csv, "results/iter_039/data/images", split="test", transform=tf)
+    items, affs, tens, phrases, gts_c = [], [], [], [], []
+    tdiff, bdiff, aff_ok = [], [], []
+    for i, r in enumerate(rows):
+        e = d24[man["D8"][i // 2]]
+        t = "qA" if i % 2 == 0 else "qB"
+        ten, aff, u8 = M.prepare(e["image"], tf)
+        assert u8 == e["u8_pixel_sha256"], "decoded u8 pixel hash != manifest"
+        o = ds[i]
+        tdiff.append(float((o["image"] - ten).abs().max()))
+        # GT를 공식 transform이 변환한 canvas cxcywh vs 우리 affine으로 변환한 값
+        W, H = aff["r"] - aff["l"], aff["b"] - aff["t"]
+        mine = []
+        for x0, y0, x1, y1 in e["gt_boxes_xyxy_norm"][t]:
+            cx0, cy0, cx1, cy1 = aff["l"] + x0 * W, aff["t"] + y0 * H, aff["l"] + x1 * W, aff["t"] + y1 * H
+            mine.append([(cx0 + cx1) / 2, (cy0 + cy1) / 2, cx1 - cx0, cy1 - cy0])
+        off = o["bboxes"].numpy()
+        bdiff.append(float(np.abs(np.array(mine) - off).max()) if len(mine) == len(off) and len(off) else (0.0 if len(mine) == len(off) else 9.0))
+        aff_ok.append(aff)
+        tens.append(ten)
+        phrases.append(e["sentences"][t])
+        gts_c.append(e["gt_boxes_xyxy_norm"][t])
+        items.append((e["PatientID"], t))
+    res["checks"]["official_dataset_tensor_max_abs_diff"] = max(tdiff)
+    res["checks"]["official_dataset_gt_box_vs_affine_max_abs_diff"] = max(bdiff)
+    res["checks"]["n_items"] = len(items)
+    res["affines"] = {f"{p}|{t}": {k: aff_ok[i][k] for k in aff_ok[i]} for i, (p, t) in enumerate(items)}
+    # affine이 정수 resize/padding과 일치하는지 (shape 기준 독립 계산)
+    ind = []
+    for i, e_ in enumerate(aff_ok):
+        sc = 640.0 / max(e_["h"], e_["w"])
+        nh, nw = round(e_["h"] * sc), round(e_["w"] * sc)
+        ind.append(abs((e_["r"] - e_["l"]) * 640 - nw) < 1e-3 and abs((e_["b"] - e_["t"]) * 640 - nh) < 1e-3 and
+                   abs(e_["l"] * 640 - (640 - nw) // 2) < 1.0 and abs(e_["t"] * 640 - (640 - nh) // 2) < 1.0)
+    res["checks"]["affine_matches_integer_resize_pad"] = all(ind)
+
+    res["models"] = {}
+    for key in ("P", "MS"):
+        t0 = time.time()
+        model, cfg, load = M.load_model(key, dev)
+        assert not load["missing"] and not load["unexpected"], load
+        r = {"load_s": time.time() - t0, "state_keys": load["n_state_keys"], "ckpt_sha256": M.file_sha(M.WEIGHTS[key]),
+             "text_encoder_type": cfg.text_encoder_type, "grounding_threshold_cfg": cfg.grounding_threshold,
+             "num_queries": cfg.num_queries}
+        lg1, bx1 = [], []
+        for i in range(len(items)):
+            l, b = M.forward(model, [tens[i]], [phrases[i]], dev)
+            lg1.append(l[0])
+            bx1.append(b[0])
+        lg1, bx1 = torch.stack(lg1), torch.stack(bx1)
+        r["batch_compare"] = {}
+        for bs in (4, 8, 16):
+            lgs, bxs = [], []
+            for s in range(0, len(items), bs):
+                l, b = M.forward(model, tens[s:s + bs], phrases[s:s + bs], dev)
+                lgs.append(l)
+                bxs.append(b)
+            lgb, bxb = torch.cat(lgs), torch.cat(bxs)
+            r["batch_compare"][bs] = {"max_abs_logit_diff": float((lgb - lg1).abs().max()), "max_abs_box_diff": float((bxb - bx1).abs().max())}
+        # confidence/threshold/WBF 순서 검사
+        probs = torch.softmax(lg1, dim=-1)[..., 0]
+        order = {}
+        for thr in M.THRESHOLDS + [1.0]:
+            det = M.postprocess(lg1, bx1, thr)
+            exp_n = (probs > thr).sum(1).tolist()
+            order[str(thr)] = {"pre_wbf_n_equals_softmax0_gt_thr": [d["pre_wbf_n"] for d in det] == exp_n,
+                               "n_after_wbf_mean": float(np.mean([len(d["boxes"]) for d in det])),
+                               "n_empty": sum(len(d["boxes"]) == 0 for d in det),
+                               "max_after_wbf_leq_pre": all(len(d["boxes"]) <= d["pre_wbf_n"] for d in det)}
+        r["threshold_wbf"] = order
+        # cxcywh 해석 검사: query box를 cxcywh로 보았을 때 [0,1] 범위 안(sigmoid)이며 w,h>0, 원본 좌표 변환 후 영상 안쪽 비율
+        cx = bx1.reshape(-1, 4).numpy()
+        r["raw_box_range"] = {"min": float(cx.min()), "max": float(cx.max())}
+        # 복수 box fixture: 공식 WBF에 겹치지 않는 두 box + 하나의 empty
+        fx = [{"boxes": torch.tensor([[0.3, 0.3, 0.2, 0.2], [0.7, 0.7, 0.2, 0.2]]), "scores": torch.tensor([0.9, 0.8])},
+              {"boxes": torch.zeros((0, 4)), "scores": torch.zeros((0,))}]
+        from utils.box_utils import run_wbf
+        o = run_wbf(fx, iou_threshold=0.1, skip_box_threshold=0.0)
+        r["wbf_fixture"] = {"two_disjoint_boxes_kept": len(o[0]["boxes"]) == 2, "empty_ok": len(o[1]["boxes"]) == 0,
+                            "roundtrip_cxcywh_maxdiff": float((o[0]["boxes"][np.argsort([-s for s in o[0]["scores"].tolist()])] - fx[0]["boxes"]).abs().max())}
+        # GT 대비 좌표 sanity (원본 정규화 변환; 운영점 선택 아님): 5 query 중 최대 IoU의 평균
+        from rsna_diag import metrics
+        best = []
+        for i, (p, t) in enumerate(items):
+            ob = M.canvas_cxcywh_to_orig_xyxy(bx1[i].tolist(), aff_ok[i])
+            ious = [metrics.iou(q, g) for q in ob for g in gts_c[i]] or [0.0]
+            best.append(max(ious))
+        r["gt_sanity_mean_best_query_iou_orig_coords"] = float(np.mean(best))
+        res["models"][key] = r
+        del model
+        torch.cuda.empty_cache()
+    res["torch"] = torch.__version__
+    res["cuda_visible"] = os.environ.get("CUDA_VISIBLE_DEVICES")
+    res["peak_mem_alloc_gb"] = torch.cuda.max_memory_allocated() / 2**30
+    json.dump(res, open(a.out, "w"), indent=1)
+    print(json.dumps({"checks": res["checks"], "models": {k: {kk: vv for kk, vv in v.items() if kk in ("batch_compare", "gt_sanity_mean_best_query_iou_orig_coords", "raw_box_range")} for k, v in res["models"].items()}}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mg45_env.py b/mg45_env.py
new file mode 100644
index 0000000..3cf8cb5
--- /dev/null
+++ b/mg45_env.py
@@ -0,0 +1,58 @@
+"""iter_045: 격리 venv(results/environments/medgrounder_iter045)에 MedGrounder 의존성을 설치하고 기록한다.
+
+기존 medgemma 환경은 변경하지 않는다. 설치 명령·freeze를 results/iter_045/env/ 에 남긴다.
+사용: python mg45_env.py install | check
+"""
+import json
+import os
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ENV = os.path.join(HERE, "results", "environments", "medgrounder_iter045")
+PY = os.path.join(ENV, "bin", "python")
+OUT = os.path.join(HERE, "results", "iter_045", "env")
+
+# 공식 requirements.txt(SHA a0aad98d) 그대로 + gdown(가중치 다운로드용 보조)
+REQ = os.path.join(HERE, "results", "iter_045", "external", "MedGrounder", "requirements.txt")
+
+
+def run(args, log):
+    os.makedirs(OUT, exist_ok=True)
+    p = subprocess.run(args, capture_output=True, text=True)
+    with open(os.path.join(OUT, log), "a") as f:
+        f.write("$ " + " ".join(args) + f"\nrc={p.returncode}\n{p.stdout[-20000:]}\n{p.stderr[-20000:]}\n")
+    print(" ".join(args[:6]), "rc=", p.returncode)
+    return p
+
+
+def install():
+    run([PY, "-m", "pip", "install", "--upgrade", "pip"], "install.log")
+    p = run([PY, "-m", "pip", "install", "-r", REQ, "gdown"], "install.log")
+    if p.returncode != 0:
+        sys.exit(p.returncode)
+    fr = run([PY, "-m", "pip", "freeze"], "freeze_cmd.log")
+    with open(os.path.join(OUT, "pip_freeze.txt"), "w") as f:
+        f.write(fr.stdout)
+
+
+def extra():
+    """공식 requirements.txt에 빠져 있지만 model/backbone.py가 import하는 패키지(timm). 사유: ModuleNotFoundError 대응."""
+    p = run([PY, "-m", "pip", "install", "timm"], "install_extra.log")
+    fr = run([PY, "-m", "pip", "freeze"], "freeze_cmd.log")
+    with open(os.path.join(OUT, "pip_freeze_after_extra.txt"), "w") as f:
+        f.write(fr.stdout)
+    sys.exit(p.returncode)
+
+
+def check():
+    code = ("import torch,torchvision,transformers,json;"
+            "print(json.dumps({'torch':torch.__version__,'tv':torchvision.__version__,"
+            "'tf':transformers.__version__,'cuda':torch.cuda.is_available(),"
+            "'n':torch.cuda.device_count(),'cap':torch.cuda.get_device_capability(0) if torch.cuda.is_available() else None}))")
+    p = run([PY, "-c", code], "check.log")
+    print(p.stdout, p.stderr[-2000:])
+
+
+if __name__ == "__main__":
+    {"install": install, "check": check, "extra": extra}[sys.argv[1]]()
diff --git a/mg45_eval.py b/mg45_eval.py
new file mode 100644
index 0000000..376761d
--- /dev/null
+++ b/mg45_eval.py
@@ -0,0 +1,221 @@
+"""iter_045 평가 라이브러리/CLI (기본 python, CPU only). MG 출력은 원본 정규화 xyxy에서, C 출력은 canvas->원본 정규화 역변환으로 채점한다.
+
+사전 고정 규칙 (plan.md Evaluation; 결과를 본 뒤 바꾸지 않는다):
+  - 주지표 문장 F1@IoU0.3 (최대 cardinality 일대일 matching, 동률은 총 IoU 최대: pg39_spec.match_fast)를 환자 안 평균 -> 환자 평균.
+  - D24 운영점 선택: checkpoint별 환자평균 F1@0.3 최대 threshold. 동률은 F1@0.5, 낮은 FP/문장, 높은 threshold 순.
+    두 checkpoint 대표 선택도 같은 순서. 완전 동률이면 MS. 공식 threshold 0.8은 보조 보고.
+  - 낮은 성능을 이유로 정상 동작한 모델을 제외하지 않는다.
+CLI:
+  python mg45_eval.py select --out results/iter_045/decisions/D24_select.json
+"""
+import argparse
+import glob
+import hashlib
+import json
+import os
+import sys
+
+import numpy as np
+
+import pg39_spec as S39
+from rsna_diag import parse
+
+MAN = "results/iter_043/data/manifest_private.json"
+THRS = [0.2, 0.4, 0.6, 0.8]
+OFFICIAL_THR = 0.8
+LOCKED_CODE = ["mg45_mg.py", "mg45_worker.py"]
+
+
+class EvalError(RuntimeError):
+    pass
+
+
+def file_sha(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def rid(setname, ckpt, patient, t):
+    return hashlib.sha256(f"{setname}|{ckpt}|{patient}|{t}".encode()).hexdigest()[:32]
+
+
+def entries(man, setname):
+    if setname in ("D24", "D8"):
+        ents = man["D24"]
+        if setname == "D8":
+            keep = set(man["D8"])
+            ents = [e for e in ents if e["PatientID"] in keep]
+        return ents
+    return man[setname]
+
+
+def verify_mg_dir(d, setname, ckpt, man, allow_code_diff=False):
+    """completion·protocol·요청 집합·현재 입력 hash·code/ckpt/manifest 잠금을 검증하고 {(patient,target): record}를 반환한다."""
+    comp_p = os.path.join(d, "completion.json")
+    if not os.path.exists(comp_p):
+        raise EvalError(f"no completion: {d}")
+    comp = json.load(open(comp_p))
+    if comp["complete"] is not True or any(c != 0 for c in comp["exit_codes"]):
+        raise EvalError(f"completion not complete/exit codes nonzero: {d}")
+    pp = os.path.join(d, "launch_protocol.json")
+    if file_sha(pp) != comp["launch_protocol_sha256"]:
+        raise EvalError("launch protocol changed after completion")
+    proto = json.load(open(pp))
+    bad = [f for f in LOCKED_CODE if file_sha(f) != proto["code"][f]]
+    if bad and not allow_code_diff:
+        raise EvalError(f"code changed since run: {bad}")
+    if file_sha(MAN) != proto["manifest_sha256"]:
+        raise EvalError("manifest changed since run")
+    wf = {"P": "medgrounder_pretrain_imagenome.pth", "MS": "medgrounder_finetune_ms.pth"}[ckpt]
+    ck = file_sha(os.path.join("results/iter_045/external/weights", wf))
+    if ck != proto["ckpt_sha256"]:
+        raise EvalError("checkpoint file changed")
+    ents = {e["PatientID"]: e for e in entries(man, setname)}
+    files = sorted(glob.glob(os.path.join(d, "raw_worker*.jsonl")))
+    if sorted(os.path.basename(f) for f in files) != sorted(comp["raw_file_sha256"]):
+        raise EvalError("raw file set != completion")
+    recs = []
+    for f in files:
+        if file_sha(f) != comp["raw_file_sha256"][os.path.basename(f)]:
+            raise EvalError(f"raw file changed after completion {f}")
+        recs += [json.loads(l) for l in open(f, "rb").read().split(b"\n")[:-1] if l.strip()]
+    want = {rid(setname, ckpt, p, t): (p, t) for p in ents for t in ("qA", "qB")}
+    ids = [r["request_id"] for r in recs]
+    if len(ids) != len(set(ids)) or set(ids) != set(want):
+        raise EvalError("request set mismatch (missing/duplicate/extra)")
+    out = {}
+    img_ok = {}
+    for r in recs:
+        p, t = want[r["request_id"]]
+        e = ents[p]
+        if (r["patient"], r["target"]) != (p, t) or r["ckpt"] != ckpt or r["set"] != setname or r["ckpt_sha256"] != ck:
+            raise EvalError("record identity mismatch")
+        if r["sentence_sha256"] != hashlib.sha256(e["sentences"][t].encode()).hexdigest():
+            raise EvalError("sentence != manifest")
+        if r["u8_pixel_sha256"] != e["u8_pixel_sha256"] or r["image"] != e["image"]:
+            raise EvalError("input pixel/image != manifest")
+        if e["image"] not in img_ok:
+            img_ok[e["image"]] = file_sha(e["image"]) == e["image_file_sha256"]
+        if not img_ok[e["image"]]:
+            raise EvalError(f"current image file hash mismatch {e['image']}")
+        out[(p, t)] = r
+    return out, comp, proto
+
+
+def score(pred_boxes, gt_boxes):
+    m3 = S39.sent_metrics(pred_boxes, gt_boxes, 0.3)
+    m5 = S39.sent_metrics(pred_boxes, gt_boxes, 0.5)
+    return {"f1_03": m3["f1"], "f1_05": m5["f1"], "recall_03": m3["recall"], "fp_03": m3["fp"], "n_pred": len(pred_boxes),
+            "n_gt": len(gt_boxes), "empty": len(pred_boxes) == 0}
+
+
+def mg_scores(recs, ents, thr):
+    """{(patient,target): score dict} at threshold thr. 예측 box는 원본 정규화 xyxy(추가 clipping 없음)."""
+    out = {}
+    for (p, t), r in recs.items():
+        d = r["detections"][str(thr)]
+        out[(p, t)] = score(d["boxes_orig_xyxy"], ents[p]["gt_boxes_xyxy_norm"][t])
+    return out
+
+
+def summarize(sc, pids):
+    f3 = [np.mean([sc[(p, t)]["f1_03"] for t in ("qA", "qB")]) for p in pids]
+    f5 = [np.mean([sc[(p, t)]["f1_05"] for t in ("qA", "qB")]) for p in pids]
+    rec = [np.mean([sc[(p, t)]["recall_03"] for t in ("qA", "qB")]) for p in pids]
+    fp = [np.mean([sc[(p, t)]["fp_03"] for t in ("qA", "qB")]) for p in pids]
+    emp = [np.mean([sc[(p, t)]["empty"] for t in ("qA", "qB")]) for p in pids]
+    return {"n_patients": len(pids), "f1_03": float(np.mean(f3)), "f1_05": float(np.mean(f5)), "recall_03": float(np.mean(rec)),
+            "fp_per_sentence": float(np.mean(fp)), "empty_rate": float(np.mean(emp))}
+
+
+def pick_threshold(table):
+    """table: {thr: summary}. 규칙: F1@0.3 최대 -> F1@0.5 최대 -> FP 최소 -> threshold 최대."""
+    return sorted(table, key=lambda t: (-round(table[t]["f1_03"], 12), -round(table[t]["f1_05"], 12),
+                                        round(table[t]["fp_per_sentence"], 12), -t))[0]
+
+
+def cmd_select(a):
+    if os.path.exists(a.out):
+        sys.exit("output exists")
+    man = json.load(open(MAN))
+    ents = {e["PatientID"]: e for e in man["D24"]}
+    pids = sorted(ents)
+    res = {"manifest_sha256": file_sha(MAN), "n_patients": len(pids), "rule": pick_threshold.__doc__, "ckpts": {}, "dirs": {}}
+    for ck, d in (("P", a.p_dir), ("MS", a.ms_dir)):
+        recs, comp, proto = verify_mg_dir(d, "D24", ck, man)
+        res["dirs"][ck] = {"dir": d, "completion_sha256": file_sha(os.path.join(d, "completion.json")),
+                           "launch_protocol_sha256": comp["launch_protocol_sha256"]}
+        table = {t: summarize(mg_scores(recs, ents, t), pids) for t in THRS}
+        sel = pick_threshold(table)
+        res["ckpts"][ck] = {"table": {str(t): table[t] for t in THRS}, "selected_threshold": sel, "official_0.8": table[OFFICIAL_THR]}
+    cand = {ck: res["ckpts"][ck]["table"][str(res["ckpts"][ck]["selected_threshold"])] for ck in ("P", "MS")}
+    key = lambda ck: (-round(cand[ck]["f1_03"], 12), -round(cand[ck]["f1_05"], 12), round(cand[ck]["fp_per_sentence"], 12))
+    best = sorted(["MS", "P"], key=key)  # 완전 동률이면 MS 우선(정렬 안정성: 리스트 순서)
+    res["selected"] = {"ckpt": best[0], "threshold": res["ckpts"][best[0]]["selected_threshold"], "summary": cand[best[0]],
+                       "tie_rule_ms_preferred": key("P") == key("MS")}
+    res["note"] = "D24는 양성 문장 집단이다. 이 선택으로 부재 거부 성능을 주장할 수 없다. V96를 보고 checkpoint/threshold를 바꾸지 않는다."
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    tmp = a.out + f".{os.getpid()}.tmp"
+    json.dump(res, open(tmp, "w"), indent=1)
+    os.replace(tmp, a.out)
+    print(json.dumps({"selected": res["selected"], "P": res["ckpts"]["P"]["selected_threshold"], "MS": res["ckpts"]["MS"]["selected_threshold"]}, indent=1))
+    for ck in ("P", "MS"):
+        for t in THRS:
+            print(ck, t, {k: round(v, 4) for k, v in res["ckpts"][ck]["table"][str(t)].items()})
+
+
+def cmd_cfg(a):
+    """실행 구성(worker/batch) 비교: 기준 dir 대비 logit/box 차이, threshold 통과 집합, 최종 box 집합·matching F1 일치. 처리량은 completion 기록."""
+    if os.path.exists(a.out):
+        sys.exit("output exists")
+    man = json.load(open(MAN))
+    ents = {e["PatientID"]: e for e in man["D24"]}
+    pids = sorted(ents)
+    base, bcomp, _ = verify_mg_dir(a.base, "D24", a.ckpt, man)
+    res = {"base": a.base, "ckpt": a.ckpt, "configs": {}}
+    for d in a.dirs:
+        recs, comp, proto = verify_mg_dir(d, "D24", a.ckpt, man)
+        ml = mb = 0.0
+        pass_same = True
+        boxes_same = True
+        f1_same = True
+        for k, r in recs.items():
+            b = base[k]
+            ml = max(ml, float(np.abs(np.array(r["logits"]) - np.array(b["logits"])).max()))
+            mb = max(mb, float(np.abs(np.array(r["pred_boxes_cxcywh"]) - np.array(b["pred_boxes_cxcywh"])).max()))
+            for t in THRS:
+                x, y = r["detections"][str(t)], b["detections"][str(t)]
+                pass_same &= x["pre_wbf_n"] == y["pre_wbf_n"]
+                boxes_same &= len(x["boxes_orig_xyxy"]) == len(y["boxes_orig_xyxy"])
+        for t in THRS:
+            sa, sb = mg_scores(recs, ents, t), mg_scores(base, ents, t)
+            f1_same &= all(sa[k]["f1_03"] == sb[k]["f1_03"] and sa[k]["f1_05"] == sb[k]["f1_05"] for k in sa)
+        res["configs"][d] = {"workers": comp["workers"], "batch": comp["batch"], "workload_wall_s": comp.get("workload_wall_s"),
+                             "launcher_wall_incl_loading_s": comp["launcher_wall_s_incl_loading"], "items_per_min_workload": (48 / comp["workload_wall_s"] * 60) if comp.get("workload_wall_s") else None,
+                             "peak_alloc_gb_max": comp["peak_alloc_gb_max"], "max_abs_logit_diff": ml, "max_abs_box_diff": mb,
+                             "threshold_pass_counts_equal": bool(pass_same), "n_final_boxes_equal": bool(boxes_same), "per_sentence_f1_equal_all_thr": bool(f1_same)}
+    json.dump(res, open(a.out, "x"), indent=1)
+    print(json.dumps(res, indent=1))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    c = sub.add_parser("cfg")
+    c.add_argument("--out", required=True)
+    c.add_argument("--ckpt", required=True)
+    c.add_argument("--base", required=True)
+    c.add_argument("--dirs", nargs="+", required=True)
+    s = sub.add_parser("select")
+    s.add_argument("--out", required=True)
+    s.add_argument("--p-dir", default="results/iter_045/mg/D24_P_w1b1")
+    s.add_argument("--ms-dir", default="results/iter_045/mg/D24_MS_w1b1")
+    a = ap.parse_args()
+    {"select": cmd_select, "cfg": cmd_cfg}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
