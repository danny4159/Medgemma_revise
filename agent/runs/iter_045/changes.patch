+            "attempts": BLOCK_ATTEMPT, "excluded_attempts": {"block1_a1": "C 환자 claim 중복(flock 해제 경쟁)으로 기술 실패; 원본 보존, paired block 전체 재측정"}}
+    for nm in ("device_seconds_span", "device_seconds_union"):
