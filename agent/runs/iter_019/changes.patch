new file mode 100644
index 0000000..0ddc861
--- /dev/null
+++ b/rsna_diag/mi19_eval.py
@@ -0,0 +1,151 @@
+"""iter_019 평가: 형식 분해, IoU, wrong-instance 판정, H·pair success, CI. 실제 생성 record와 C/N baseline을 입력받는다."""
+import glob
+import json
+
+import numpy as np
+
+from . import metrics, parse as PA
+
+
+def classify_response(rec):
+    """returns dict: parse_status, n_boxes, box(단일 유효 box 또는 None)."""
+    pr = PA.parse_response(rec["suffix_text_raw"], rec["ended_eos"])
+    st = pr["status"]
+    if st in PA.VALID:
+        boxes = pr["boxes"]
+        if len(boxes) == 1:
+            return {"parse_status": st, "n_boxes": 1, "box": [float(v) for v in boxes[0]]}
+        return {"parse_status": f"{st}_wrong_count", "n_boxes": len(boxes), "box": None}
+    return {"parse_status": st, "n_boxes": None, "box": None}
+
+
+def classify_pred(pred_box, target_gt_box, other_gts):
+    """other_gts: [(label, box), ...]. returns dict target_iou, success flags, wrong-instance 판정."""
+    candidates = [("__target__", target_gt_box)] + list(other_gts)
+    ious = [(lab, metrics.iou(pred_box, b)) for lab, b in candidates]
+    max_iou = max(i for _, i in ious)
+    tied = [lab for lab, i in ious if abs(i - max_iou) < 1e-9]
+    target_iou = dict(ious)["__target__"]
+    is_wrong = target_iou <= 0.1 and len(tied) == 1 and tied[0] != "__target__" and max_iou >= 0.3
+    return {"target_iou": target_iou, "success_0.5": target_iou >= 0.5, "success_0.3": target_iou >= 0.3,
+            "is_wrong_instance": is_wrong, "wrong_instance_label": tied[0] if is_wrong else None, "max_iou_any": max_iou}
+
+
+def load_records(out_dir):
+    recs = {}
+    for f in sorted(glob.glob(f"{out_dir}/gen_worker*.jsonl")):
+        for ln in open(f):
+            if ln.strip():
+                r = json.loads(ln)
+                if r["request_id"] in recs:
+                    raise RuntimeError(f"duplicate request_id {r['request_id']} across worker files in {out_dir}")
+                recs[r["request_id"]] = r
+    return recs
+
+
+def evaluate_condition(rows, records, manifest, condition_label):
+    """rows: mi19_requests 행 목록(단일 condition). returns list of per-row eval dict (patient,label 포함)."""
+    out = []
+    for row in rows:
+        rec = records.get(row["request_id"])
+        pid, lab = row["patient"], row["label"]
+        m = manifest[pid]
+        inst = next(i for i in m["instances"] if i["label"] == lab)
+        target_gt = inst["target_gt_norm"]
+        other_gts = [(o["label"], o["box_norm"]) for o in m["other_gt_boxes_in_T_norm"]] + \
+                    [(i["label"], i["target_gt_norm"]) for i in m["instances"] if i["label"] != lab]
+        if rec is None:
+            out.append({"patient": pid, "label": lab, "condition": condition_label, "missing": True})
+            continue
+        cls = classify_response(rec)
+        row_out = {"patient": pid, "label": lab, "condition": condition_label, "missing": False, **cls}
+        if cls["box"] is not None:
+            row_out.update(classify_pred(cls["box"], target_gt, other_gts))
+        else:
+            row_out.update({"target_iou": None, "success_0.5": False, "success_0.3": False,
+                            "is_wrong_instance": False, "wrong_instance_label": None, "max_iou_any": None})
+        out.append(row_out)
+    return out
+
+
+def evaluate_baseline(manifest, patient_ids, condition_fn, condition_label):
+    """condition_fn(manifest_entry, inst) -> (pred_box_norm or None, meta). C/N에 사용."""
+    out = []
+    for pid in patient_ids:
+        m = manifest[pid]
+        for inst in m["instances"]:
+            lab = inst["label"]
+            target_gt = inst["target_gt_norm"]
+            other_gts = [(o["label"], o["box_norm"]) for o in m["other_gt_boxes_in_T_norm"]] + \
+                        [(i["label"], i["target_gt_norm"]) for i in m["instances"] if i["label"] != lab]
+            pred, meta = condition_fn(m, inst)
+            row = {"patient": pid, "label": lab, "condition": condition_label, "missing": False,
+                  "parse_status": meta.get("status", "ok"), "box": pred, "meta": meta}
+            if pred is not None:
+                row.update(classify_pred(pred, target_gt, other_gts))
+            else:
+                row.update({"target_iou": None, "success_0.5": False, "success_0.3": False,
+                           "is_wrong_instance": False, "wrong_instance_label": None, "max_iou_any": None})
+            out.append(row)
+    return out
+
+
+def pair_success_rate(rows):
+    """condition 하나의 rows(patient,label 여러 개)에서 환자별 두 instance 모두 success_0.5인 비율."""
+    by_pat = {}
+    for r in rows:
+        by_pat.setdefault(r["patient"], []).append(r)
+    n, k = 0, 0
+    per_patient = {}
+    for pid, rs in by_pat.items():
+        ok = len(rs) >= 2 and all(r.get("success_0.5") for r in rs)
+        per_patient[pid] = ok
+        n += 1
+        k += int(ok)
+    return {"n_patients": n, "n_both_success": k, "rate": k / n if n else float("nan"),
+            "wilson_95": metrics.wilson(k, n), "per_patient": per_patient}
+
+
+def compute_H(patients, o_rows, j_rt_rows, j_tr_rows):
+    """H 사건: O 두 instance 모두 성공, J_RT/J_TR 모두 유효 단일 box이고 같은 wrong_instance_label을 가진 instance가 하나 이상."""
+    o_by_pat = {}
+    for r in o_rows:
+        o_by_pat.setdefault(r["patient"], {})[r["label"]] = r
+    jrt_by = {}
+    for r in j_rt_rows:
+        jrt_by.setdefault(r["patient"], {})[r["label"]] = r
+    jtr_by = {}
+    for r in j_tr_rows:
+        jtr_by.setdefault(r["patient"], {})[r["label"]] = r
+    events, detail = {}, {}
+    for pid in patients:
+        o_ok = pid in o_by_pat and all(r.get("success_0.5") for r in o_by_pat[pid].values()) and len(o_by_pat[pid]) >= 2
+        has_wrong = False
+        labs_hit = []
+        if pid in jrt_by and pid in jtr_by:
+            for lab in jrt_by[pid]:
+                a, b = jrt_by[pid].get(lab), jtr_by[pid].get(lab)
+                if a is None or b is None:
+                    continue
+                if a.get("box") is not None and b.get("box") is not None and a.get("is_wrong_instance") and b.get("is_wrong_instance"):
+                    if a.get("wrong_instance_label") == b.get("wrong_instance_label") and a["wrong_instance_label"] is not None:
+                        has_wrong = True
+                        labs_hit.append(lab)
+        ev = bool(o_ok and has_wrong)
+        events[pid] = ev
+        detail[pid] = {"o_ok": o_ok, "has_wrong": has_wrong, "labels_hit": labs_hit}
+    n = len(patients)
+    k = sum(1 for v in events.values() if v)
+    return {"n": n, "k": k, "H": k / n if n else float("nan"), "wilson_95": metrics.wilson(k, n),
+            "events": events, "detail": detail}
+
+
+def paired_diff(rate_a_per_patient, rate_b_per_patient, patients, seed=19019, B=10000):
+    """paired bootstrap: patients 순서로 정렬한 0/1 배열의 평균차 CI. 값이 모두 같은 discordance=0이면 discordant 쌍 수를 함께 보고한다."""
+    a = np.array([1.0 if rate_a_per_patient.get(p) else 0.0 for p in patients])
+    b = np.array([1.0 if rate_b_per_patient.get(p) else 0.0 for p in patients])
+    idx = metrics.bootstrap_indices(len(patients), B=B, seed=seed)
+    mean_diff, lo, hi = metrics.paired_boot_ci(a, b, idx)
+    discordant = int(np.sum(a != b))
+    return {"mean_diff": mean_diff, "ci95": [lo, hi], "n": len(patients), "discordant_n": discordant,
+           "a_pos": int(a.sum()), "b_pos": int(b.sum())}
diff --git a/rsna_diag/mi19_gen.py b/rsna_diag/mi19_gen.py
new file mode 100644
index 0000000..d6c0403
--- /dev/null
+++ b/rsna_diag/mi19_gen.py
@@ -0,0 +1,213 @@
+"""iter_019 다중 영상 생성 worker. qa_gen.py의 재개·claim·검증 패턴을 다중 image 요청에 맞게 일반화한다.
+
+- 시작 시: mi19_protocol.verify, 요청 파일이 protocol에 잠긴 파일과 같은지, 각 행의 request_id 재계산·config digest,
+  모든 영상의 현재 file/pixel hash(raw file sha256 + padded 이후 hash는 generate.load_image가 재계산).
+- 재개: 완료 record 포함 모든 worker 파일을 요청 행과 대조. 중복·잉여·id/prompt/images/config 불일치·입력 변경·잘린 JSONL은 중단.
+사용: CUDA_VISIBLE_DEVICES=<gpu> python -m rsna_diag.mi19_gen --requests R --out-dir D --worker K --protocol P
+"""
+import argparse
+import glob
+import json
+import os
+import re
+import sys
+import time
+
+from . import generate, mi19_protocol, mi19_requests as Q, queue_lock
+
+
+class GenError(RuntimeError):
+    pass
+
+
+def read_strict(path, repair_tail=False, tolerate_tail=False):
+    if not os.path.exists(path):
+        return []
+    raw = open(path, "rb").read()
+    lines = raw.split(b"\n")
+    tail = lines[-1]
+    body = lines[:-1]
+    if tail.strip() and tolerate_tail:
+        pass
+    elif tail.strip():
+        if repair_tail:
+            with open(path + ".partial", "ab") as f:
+                f.write(tail + b"\n")
+            with open(path, "wb") as f:
+                f.write(b"\n".join(body) + (b"\n" if body else b""))
+        else:
+            raise GenError(f"truncated last line (no newline) in {path}; rerun with --repair-tail")
+    recs = []
+    for k, ln in enumerate(body):
+        if ln.strip():
+            try:
+                recs.append(json.loads(ln))
+            except ValueError as e:
+                raise GenError(f"corrupt JSON line {k} in {path}") from e
+    return recs
+
+
+def _worker_of(path):
+    m = re.fullmatch(r"gen_worker(\d+)\.jsonl", os.path.basename(path))
+    return int(m.group(1)) if m else None
+
+
+def _has_tail(path):
+    if not os.path.exists(path):
+        return False
+    data = open(path, "rb").read()
+    return bool(data.split(b"\n")[-1].strip())
+
+
+def read_all_owned(out_dir, my_worker, repair, live, info):
+    out = {}
+    for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        w = _worker_of(f)
+        if w == my_worker or not _has_tail(f):
+            out[f] = read_strict(f, repair_tail=repair and w == my_worker and not live)
+            continue
+        lk, _, _ = queue_lock.try_lock(os.path.join(out_dir, f"worker{w}.lock"), info)
+        if lk is None:
+            out[f] = read_strict(f, tolerate_tail=True)
+        else:
+            try:
+                out[f] = read_strict(f, repair_tail=repair and not live, tolerate_tail=live)
+            finally:
+                lk.release()
+    return out
+
+
+def validate_records(files_records, rows, cdig, protocol_digest, pixel_sha):
+    by = {r["request_id"]: r for r in rows}
+    done = {}
+    for fn, recs in files_records.items():
+        for r in recs:
+            rid = r.get("request_id")
+            row = by.get(rid)
+            if row is None:
+                raise GenError(f"unexpected record {rid} in {fn}: not in current request set")
+            if rid in done:
+                raise GenError(f"duplicate record {rid} in {fn}")
+            for k, want in (("prompt_sha256", row["prompt_sha256"]), ("config_digest", cdig),
+                            ("protocol_digest", protocol_digest), ("patient", row["patient"]),
+                            ("condition", row["condition"]), ("label", row["label"]), ("n_images", len(row["images"]))):
+                if r.get(k) != want:
+                    raise GenError(f"{k} mismatch for {rid} in {fn}: {r.get(k)!r} != {want!r}")
+            for i, im in enumerate(row["images"]):
+                rim = r["images"][i]
+                if rim.get("file_sha256") != im["file_sha256"] or rim.get("path") != im["path"]:
+                    raise GenError(f"image[{i}] mismatch for {rid} in {fn}")
+                if rim.get("input_pixel_sha256") != pixel_sha(im["path"]):
+                    raise GenError(f"input image changed since generation for {rid} image[{i}]")
+            done[rid] = r
+    return done
+
+
+def check_inputs(rows):
+    seen = {}
+    for r in rows:
+        for im in r["images"]:
+            key = im["path"]
+            if key in seen:
+                continue
+            if generate.sha(open(key, "rb").read()) != im["file_sha256"]:
+                raise GenError(f"file sha changed for {key}")
+            seen[key] = 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--worker", type=int, required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--max-requests", type=int, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    a = ap.parse_args()
+    pdig = mi19_protocol.verify(a.protocol)
+    if json.load(open(a.protocol))["locked"]["files"].get(a.requests) != generate.sha(open(a.requests, "rb").read()):
+        sys.exit(f"request file {a.requests} is not locked in {a.protocol} (or changed)")
+    cfg, _ = mi19_protocol.static_cfg()
+    rows = Q.load_rows(a.requests, cfg)
+    check_inputs(rows)
+    os.makedirs(a.out_dir, exist_ok=True)
+    info = queue_lock.my_info(worker=a.worker)
+    lk, own, _ = queue_lock.try_lock(os.path.join(a.out_dir, f"worker{a.worker}.lock"), info)
+    if lk is None:
+        sys.exit(f"worker {a.worker} already running: {own}")
+    try:
+        run_worker(a, rows, pdig, cfg, info)
+    finally:
+        lk.release()
+
+
+def run_worker(a, rows, pdig, cfg, info):
+    torch, proc, model = generate.load_model()
+    env = generate.env_info(torch, proc, model)
+    cdig, core = generate.config_digest(env, {})
+    if cdig != cfg:
+        raise GenError("runtime generation config digest != protocol config digest")
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    with open(os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl.env.json"), "w") as f:
+        json.dump({"env": env, "config_digest": cdig, "protocol_digest": pdig, "worker": a.worker,
+                   "requests": a.requests}, f, indent=1, default=str)
+    cache = {}
+
+    def px(path):
+        if path not in cache:
+            cache[path] = generate.load_image(path)[2]
+        return cache[path]
+
+    def read_all(repair, live=False):
+        return read_all_owned(a.out_dir, a.worker, repair, live, info)
+
+    done = validate_records(read_all(a.repair_tail), rows, cdig, pdig, px)
+    out = os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl")
+    claim_dir = os.path.join(a.out_dir, "claims")
+    os.makedirs(claim_dir, exist_ok=True)
+    log = open(out + ".log", "a")
+    t0, n_done = time.time(), 0
+    for row in sorted(rows, key=lambda r: r["request_id"]):
+        if row["request_id"] in done:
+            continue
+        if (a.time_limit and time.time() - t0 > a.time_limit) or (a.max_requests is not None and n_done >= a.max_requests):
+            log.write(json.dumps({"event": "stop", "done_this_run": n_done}) + "\n")
+            break
+        clk, prev, reclaimed = queue_lock.try_lock(os.path.join(claim_dir, row["request_id"] + ".claim"), info)
+        if clk is None:
+            continue
+        try:
+            if reclaimed:
+                log.write(json.dumps({"event": "claim_reclaimed_from_dead_owner", "request_id": row["request_id"], "prev_owner": prev}) + "\n")
+            done = validate_records(read_all(False, live=True), rows, cdig, pdig, px)
+            if row["request_id"] in done:
+                continue
+            try:
+                rec = generate.run_request_multi(torch, proc, model, eos_ids,
+                                                 {"id": row["id"], "images": row["images"]}, row["condition"], row["prompt"])
+            except torch.cuda.OutOfMemoryError as e:
+                log.write(json.dumps({"event": "oom", "request_id": row["request_id"], "err": str(e)[:200]}) + "\n")
+                log.flush()
+                raise
+            rec.update({"request_id": row["request_id"], "patient": row["patient"], "condition": row["condition"],
+                        "label": row["label"], "config_digest": cdig, "protocol_digest": pdig, "worker": a.worker,
+                        "ts": time.time(), "gpu_uuid": env.get("gpu_uuid")})
+            with open(out, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            done[row["request_id"]] = rec
+            n_done += 1
+            log.write(json.dumps({"event": "done", "request_id": row["request_id"], "n_out": rec["n_output_tokens"],
+                                  "finish": rec["finish_reason"], "runtime_s": round(rec["runtime_s_total"], 2),
+                                  "peak_gb": round(rec["peak_mem_alloc_gb_max"], 2), "elapsed": round(time.time() - t0, 1)}) + "\n")
+            log.flush()
+        finally:
+            clk.release()
+    print(f"worker {a.worker}: finished; {n_done} new requests this run", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/mi19_manifest.py b/rsna_diag/mi19_manifest.py
new file mode 100644
index 0000000..9fcaa08
--- /dev/null
+++ b/rsna_diag/mi19_manifest.py
@@ -0,0 +1,146 @@
+"""iter_019 최종 manifest: images.zip 영상 co-registration 검사, R/T 렌더링·PNG 저장, bbox/point normalized 변환, split 배정.
+
+실행: python -m rsna_diag.mi19_manifest
+입력: results/iter_019/data/gate.json (mi19_data.gate_patients 결과), results/iter_019/source/{images,masks}.zip
+출력: results/iter_019/data/images/{pid}_{R,T}.png, results/iter_019/data/manifest.json, results/iter_019/data/split.json
+"""
+import hashlib
+import json
+import os
+
+import numpy as np
+
+from . import geometry, mi19_data as D, mi19_mha as M, mi19_render as R
+
+DATA_DIR = D.DATA_DIR
+SOURCE = D.SOURCE
+SPLIT_SALT = "iter019-split-v1"
+D_SIZE, E_SIZE = 8, 48
+
+
+def sha_bytes(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def check_coregistration(mask_hdr, img_meta, patient):
+    for k in ("dim_size_xyz",):
+        if list(mask_hdr[k]) != list(img_meta[k]):
+            raise RuntimeError(f"{patient}: mask/image {k} differ: {mask_hdr[k]} != {img_meta[k]}")
+    for k in ("spacing_xyz", "offset_xyz"):
+        a, b = mask_hdr[k], img_meta[k]
+        if len(a) != len(b) or any(abs(float(x) - float(y)) > 1e-4 for x, y in zip(a, b)):
+            raise RuntimeError(f"{patient}: mask/image {k} differ: {a} != {b}")
+    if mask_hdr["direction"] != img_meta["direction"]:
+        raise RuntimeError(f"{patient}: mask/image direction differ: {mask_hdr['direction']} != {img_meta['direction']}")
+
+
+def instance_point_native(mask_vol, x_idx, label):
+    """centroid에 가장 가까운 foreground pixel (row,col), half-open bbox 아님, 정확한 pixel 좌표."""
+    sl = mask_vol[:, :, x_idx] == label
+    rows, cols = np.where(sl)
+    if rows.size == 0:
+        raise RuntimeError("empty instance slice (should not happen for eligible instance)")
+    cy, cx = rows.mean(), cols.mean()
+    d2 = (rows - cy) ** 2 + (cols - cx) ** 2
+    k = int(np.argmin(d2))
+    return int(rows[k]), int(cols[k])
+
+
+def build_one(pid, gate_entry, images_zc, masks_zc):
+    mask_data, mask_sha = masks_zc.read(f"masks/{pid}_t2.mha")
+    if mask_sha != gate_entry["mask_file_sha256"]:
+        raise RuntimeError(f"{pid}: mask sha changed since gate")
+    mask_m = M.read_mha(mask_data)
+    mask_vol = mask_m["array"]
+    img_data, img_sha = images_zc.read(f"images/{pid}_t2.mha")
+    img_m = M.read_mha(img_data)
+    img_meta = {"dim_size_xyz": img_m["dim_size_xyz"], "spacing_xyz": img_m["spacing_xyz"],
+                "offset_xyz": img_m["offset_xyz"], "direction": img_m["direction"]}
+    check_coregistration(gate_entry, img_meta, pid)
+    img_vol = img_m["array"]
+    sx, sy, sz = gate_entry["spacing_xyz"]
+    lo, hi = R.volume_window(img_vol)
+    r_idx, t_idx = gate_entry["r_idx"], gate_entry["t_idx"]
+    rgb_r, sr, sc, shape = R.render_slice(img_vol, r_idx, sy, sz, lo, hi)
+    rgb_t, sr_t, sc_t, shape_t = R.render_slice(img_vol, t_idx, sy, sz, lo, hi)
+    if shape != shape_t:
+        raise RuntimeError(f"{pid}: R/T rendered shape differ {shape} vs {shape_t} (same volume expected identical)")
+    top, left, side = geometry.pad_offsets(*shape)
+    padded_r, aff_r = geometry.pad_square(rgb_r)
+    padded_t, aff_t = geometry.pad_square(rgb_t)
+    assert aff_r == (top, left, side) and aff_t == (top, left, side)
+
+    img_dir = f"{DATA_DIR}/images"
+    os.makedirs(img_dir, exist_ok=True)
+    from PIL import Image
+    path_r, path_t = f"{img_dir}/{pid}_R.png", f"{img_dir}/{pid}_T.png"
+    Image.fromarray(padded_r).save(path_r)
+    Image.fromarray(padded_t).save(path_t)
+    file_sha_r = sha_bytes(open(path_r, "rb").read())
+    file_sha_t = sha_bytes(open(path_t, "rb").read())
+    pixel_sha_r = sha_bytes(padded_r.tobytes())
+    pixel_sha_t = sha_bytes(padded_t.tobytes())
+
+    instances = []
+    for lab in gate_entry["chosen_instances"]:
+        r_box_native = gate_entry["per_slice_boxes"]["r"][str(lab)]  # (r0,c0,r1,c1)
+        t_box_native = gate_entry["per_slice_boxes"]["t"][str(lab)]
+        ref_norm = R.native_bbox_to_norm(r_box_native, sr, sc, shape, (top, left, side))
+        target_gt_norm = R.native_bbox_to_norm(t_box_native, sr, sc, shape, (top, left, side))
+        pr, pc = instance_point_native(mask_vol, t_idx, lab)
+        point_norm = R.native_point_to_norm((pr, pc), sr, sc, shape, (top, left, side))
+        instances.append({"label": lab, "ref_box_norm": ref_norm, "target_gt_norm": target_gt_norm,
+                          "point_norm": point_norm})
+    other_boxes_norm = []
+    for lab, box_native in gate_entry["per_slice_boxes"]["t_all_others"].items():
+        other_boxes_norm.append({"label": int(lab), "box_norm": R.native_bbox_to_norm(box_native, sr, sc, shape, (top, left, side))})
+
+    return {
+        "patient": pid, "r_idx": r_idx, "t_idx": t_idx, "dist_mm": gate_entry["dist_mm"],
+        "mask_file_sha256": mask_sha, "image_file_sha256_source": img_sha,
+        "spacing_xyz": gate_entry["spacing_xyz"], "volume_window": [lo, hi],
+        "resize_scale_row_col": [sr, sc], "rendered_shape_hw": list(shape), "pad_top_left_side": [top, left, side],
+        "R": {"path": path_r, "file_sha256": file_sha_r, "pixel_sha256": pixel_sha_r},
+        "T": {"path": path_t, "file_sha256": file_sha_t, "pixel_sha256": pixel_sha_t},
+        "instances": instances, "other_gt_boxes_in_T_norm": other_boxes_norm,
+    }
+
+
+def assign_split(patients):
+    order = sorted(patients, key=lambda p: hashlib.sha256(f"{SPLIT_SALT}|{p}".encode()).hexdigest())
+    d = order[:D_SIZE]
+    e = order[D_SIZE:D_SIZE + E_SIZE]
+    f = order[D_SIZE + E_SIZE:]
+    return {"D": d, "E": e, "F": f, "order_salt": SPLIT_SALT}
+
+
+def main():
+    gate = json.load(open(f"{DATA_DIR}/gate.json"))
+    eligible = {e["patient"]: e for e in gate["eligible"]}
+    n = len(eligible)
+    if n < 56:
+        json.dump({"status": "insufficient_eligible", "n_eligible": n},
+                  open(f"{DATA_DIR}/manifest_status.json", "w"), indent=1)
+        print(json.dumps({"status": "insufficient_eligible", "n_eligible": n}))
+        return
+    images_zc = D.ZipCache(f"{SOURCE}/images.zip")
+    masks_zc = D.ZipCache(f"{SOURCE}/masks.zip")
+    split = assign_split(sorted(eligible))
+    manifest = {}
+    errors = {}
+    for pid in sorted(eligible):
+        try:
+            manifest[pid] = build_one(pid, eligible[pid], images_zc, masks_zc)
+        except Exception as e:
+            errors[pid] = str(e)
+    json.dump(split, open(f"{DATA_DIR}/split.json", "w"), indent=1)
+    json.dump(manifest, open(f"{DATA_DIR}/manifest.json", "w"), indent=1, default=str)
+    json.dump(errors, open(f"{DATA_DIR}/manifest_errors.json", "w"), indent=1)
+    status = {"n_eligible": n, "n_built": len(manifest), "n_errors": len(errors),
+              "split_sizes": {k: len(v) for k, v in split.items() if k != "order_salt"}}
+    json.dump(status, open(f"{DATA_DIR}/manifest_status.json", "w"), indent=1)
+    print(json.dumps(status, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/mi19_mha.py b/rsna_diag/mi19_mha.py
new file mode 100644
index 0000000..0843edf
--- /dev/null
+++ b/rsna_diag/mi19_mha.py
@@ -0,0 +1,113 @@
+"""제한된 MetaIO(.mha) reader (iter_019). SimpleITK가 없는 환경에서 실제 등장하는 3D scalar LOCAL binary MHA만 지원한다.
+
+지원 범위: NDims=3, BinaryData=True, ElementDataFile=LOCAL, ElementNumberOfChannels<=1,
+ElementType in {MET_UCHAR, MET_CHAR, MET_SHORT, MET_USHORT, MET_FLOAT, MET_DOUBLE, MET_INT, MET_UINT},
+CompressedData True(zlib)/False, BinaryDataByteOrderMSB True/False.
+공식 규약: https://docs.itk.org/en/latest/learn/metaio.html
+
+지원하지 않는 header(비3D, non-LOCAL, ASCII data, 다중 채널, 알 수 없는 ElementType)는 MhaError로 실패시킨다(추측 금지).
+DimSize는 [x, y, z] (x가 가장 빠르게 변함)이며, 반환 numpy 배열의 axis 순서는 (z, y, x) (C-order, x가 마지막 축).
+"""
+import zlib
+
+import numpy as np
+
+_TYPE_MAP = {
+    "MET_UCHAR": "u1", "MET_CHAR": "i1",
+    "MET_SHORT": "i2", "MET_USHORT": "u2",
+    "MET_INT": "i4", "MET_UINT": "u4",
+    "MET_FLOAT": "f4", "MET_DOUBLE": "f8",
+}
+
+
+class MhaError(RuntimeError):
+    pass
+
+
+def _parse_value(key, raw):
+    raw = raw.strip()
+    if key in ("NDims", "CompressedDataSize", "ElementNumberOfChannels", "HeaderSize"):
+        return int(raw)
+    if key in ("CompressedData", "BinaryData", "BinaryDataByteOrderMSB"):
+        return raw.strip().lower() == "true"
+    if key in ("DimSize",):
+        return [int(x) for x in raw.split()]
+    if key in ("ElementSpacing", "Offset", "TransformMatrix", "CenterOfRotation"):
+        return [float(x) for x in raw.split()]
+    return raw
+
+
+def parse_header(data):
+    """data(bytes) -> (header dict, payload_offset:int). ElementDataFile != LOCAL 이면 MhaError."""
+    pos = 0
+    header = {}
+    n = len(data)
+    while True:
+        nl = data.find(b"\n", pos)
+        if nl == -1:
+            raise MhaError("header not terminated (no ElementDataFile line found)")
+        line = data[pos:nl].decode("ascii", errors="strict")
+        pos = nl + 1
+        if "=" not in line:
+            if line.strip() == "":
+                continue
+            raise MhaError(f"malformed header line: {line!r}")
+        key, _, val = line.partition("=")
+        key = key.strip()
+        if key == "ElementDataFile":
+            if val.strip() != "LOCAL":
+                raise MhaError(f"unsupported ElementDataFile {val.strip()!r} (only LOCAL supported)")
+            header[key] = "LOCAL"
+            return header, pos
+        header[key] = _parse_value(key, val)
+        if pos >= n:
+            raise MhaError("header not terminated (no ElementDataFile line found)")
+
+
+def read_mha(path_or_bytes):
+    """returns dict: array(z,y,x), dim_size(x,y,z), spacing(x,y,z), offset(x,y,z), direction(3x3 row-major), element_type, raw_header."""
+    data = path_or_bytes if isinstance(path_or_bytes, (bytes, bytearray)) else open(path_or_bytes, "rb").read()
+    hdr, off = parse_header(data)
+    if hdr.get("ObjectType", "Image") != "Image":
+        raise MhaError(f"unsupported ObjectType {hdr.get('ObjectType')!r}")
+    if hdr.get("NDims") != 3:
+        raise MhaError(f"unsupported NDims {hdr.get('NDims')!r} (only 3D supported)")
+    if not hdr.get("BinaryData", False):
+        raise MhaError("only BinaryData=True supported")
+    nchan = hdr.get("ElementNumberOfChannels", 1)
+    if nchan not in (1,):
+        raise MhaError(f"unsupported ElementNumberOfChannels {nchan}")
+    etype = hdr.get("ElementType")
+    if etype not in _TYPE_MAP:
+        raise MhaError(f"unsupported ElementType {etype!r}")
+    dim = hdr.get("DimSize")
+    if not dim or len(dim) != 3:
+        raise MhaError(f"invalid DimSize {dim!r}")
+    nx, ny, nz = dim
+    nvoxels = nx * ny * nz
+    msb = hdr.get("BinaryDataByteOrderMSB", False)
+    dtype_code = (">" if msb else "<") + _TYPE_MAP[etype]
+    dt = np.dtype(dtype_code)
+    payload = data[off:]
+    if hdr.get("CompressedData", False):
+        size = hdr.get("CompressedDataSize")
+        if size is None:
+            raise MhaError("CompressedData=True but no CompressedDataSize")
+        if len(payload) < size:
+            raise MhaError(f"truncated compressed payload: have {len(payload)}, want {size}")
+        raw = zlib.decompress(payload[:size])
+    else:
+        need = nvoxels * dt.itemsize
+        if len(payload) < need:
+            raise MhaError(f"truncated payload: have {len(payload)}, want {need}")
+        raw = payload[:need]
+    expect_bytes = nvoxels * dt.itemsize
+    if len(raw) != expect_bytes:
+        raise MhaError(f"decoded payload size {len(raw)} != expected {expect_bytes} (nx={nx} ny={ny} nz={nz} itemsize={dt.itemsize})")
+    arr = np.frombuffer(raw, dtype=dt).reshape((nz, ny, nx))
+    spacing = hdr.get("ElementSpacing", [1.0, 1.0, 1.0])
+    offset = hdr.get("Offset", [0.0, 0.0, 0.0])
+    tm = hdr.get("TransformMatrix", [1, 0, 0, 0, 1, 0, 0, 0, 1])
+    direction = [tm[0:3], tm[3:6], tm[6:9]]
+    return {"array": arr, "dim_size_xyz": dim, "spacing_xyz": spacing, "offset_xyz": offset,
+            "direction": direction, "element_type": etype, "header": hdr}
