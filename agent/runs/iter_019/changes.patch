new file mode 100644
index 0000000..dce67e6
--- /dev/null
+++ b/rsna_diag/mi19_render.py
@@ -0,0 +1,67 @@
+"""iter_019 표시 영상 렌더링: MRI volume -> in-plane spacing 보정 uint8 2D slice, bbox·점 좌표 변환.
+
+- intensity window: volume 전체의 유한한 비배경(0이 아닌) intensity의 1-99 percentile로 clip 후 [0,255] 선형 변환.
+  같은 volume의 모든 slice에 동일 window를 적용한다.
+- 종횡비: in-plane spacing(spacing_y, spacing_z)이 다르면 더 촘촘한 축을 기준으로 다른 축만 배율 조정한다
+  (PIL bilinear). 배율은 반올림 정수 픽셀 크기를 만든다.
+- bbox/point는 native(z,y) 픽셀 좌표(half-open) -> resize 배율 -> geometry.pad_square affine -> canvas_to_norm 순서로 변환한다.
+"""
+import numpy as np
+from PIL import Image
+
+from . import geometry
+
+
+def volume_window(img_vol):
+    """returns (lo, hi) intensity for 1-99 percentile of finite, nonzero voxels."""
+    flat = img_vol.astype(np.float64).ravel()
+    finite = flat[np.isfinite(flat)]
+    nonzero = finite[finite != 0]
+    if nonzero.size == 0:
+        nonzero = finite
+    lo, hi = np.percentile(nonzero, [1.0, 99.0])
+    if hi <= lo:
+        hi = lo + 1.0
+    return float(lo), float(hi)
+
+
+def to_uint8(slice2d, lo, hi):
+    a = np.clip(slice2d.astype(np.float64), lo, hi)
+    a = (a - lo) / (hi - lo)
+    return np.round(a * 255.0).astype(np.uint8)
+
+
+def resize_scale(spacing_y, spacing_z):
+    """returns (scale_row, scale_col) so that physical pixel spacing becomes isotropic (= min(spacing_y,spacing_z))."""
+    target = min(spacing_y, spacing_z)
+    return spacing_z / target, spacing_y / target  # (row scale from z, col scale from y)
+
+
+def render_slice(img_vol, x_idx, spacing_y, spacing_z, lo, hi):
+    """img_vol: (nz,ny,nx). returns (uint8 RGB resized array, scale_row, scale_col, new_shape(h,w))."""
+    native = img_vol[:, :, x_idx]  # (nz, ny) = (row=z, col=y)
+    u8 = to_uint8(native, lo, hi)
+    nz, ny = u8.shape
+    scale_row, scale_col = resize_scale(spacing_y, spacing_z)
+    new_h, new_w = max(1, round(nz * scale_row)), max(1, round(ny * scale_col))
+    im = Image.fromarray(u8, mode="L").resize((new_w, new_h), resample=Image.BILINEAR)
+    rgb = np.repeat(np.asarray(im)[:, :, None], 3, axis=2)
+    return rgb, new_h / nz, new_w / ny, (new_h, new_w)
+
+
+def native_bbox_to_norm(bbox_rc, scale_row, scale_col, new_shape, pad_top_left_side=None):
+    """bbox_rc: (row0,col0,row1,col1) native half-open. -> resized xyxy -> pad_square -> normalized yxyx[0,1000].
+    pad_top_left_side가 주어지면 그 affine을 쓰고, 없으면 new_shape 기준으로 pad_square를 계산한다(호출측이 동일 affine을 재사용해야 함)."""
+    r0, c0, r1, c1 = bbox_rc
+    x0, y0, x1, y1 = c0 * scale_col, r0 * scale_row, c1 * scale_col, r1 * scale_row
+    h, w = new_shape
+    top, left, side = pad_top_left_side if pad_top_left_side else geometry.pad_offsets(h, w)
+    return geometry.canvas_to_norm([x0, y0, x1, y1], top, left, side)
+
+
+def native_point_to_norm(point_rc, scale_row, scale_col, new_shape, pad_top_left_side=None):
+    r, c = point_rc
+    x, y = c * scale_col, r * scale_row
+    h, w = new_shape
+    top, left, side = pad_top_left_side if pad_top_left_side else geometry.pad_offsets(h, w)
+    return [(y + top) * 1000.0 / side, (x + left) * 1000.0 / side]
diff --git a/rsna_diag/mi19_requests.py b/rsna_diag/mi19_requests.py
new file mode 100644
index 0000000..83943d0
--- /dev/null
+++ b/rsna_diag/mi19_requests.py
@@ -0,0 +1,139 @@
+"""iter_019 요청 행렬. phase1(J_RT,J_TR,A,O,S1)은 manifest만으로 만들 수 있다. S2는 완료된 S1 record가 필요하다 (2단계).
+
+request_id = sha256(patient|condition|label|images(path,file_sha256 순서대로)|prompt|config_digest)[:32].
+"""
+import argparse
+import hashlib
+import json
+import os
+
+from . import generate, mi19_spec as S
+
+DATA_DIR = "results/iter_019/data"
+
+
+def sha(b):
+    return hashlib.sha256(b if isinstance(b, bytes) else b.encode()).hexdigest()
+
+
+def req_id(fields):
+    return sha(json.dumps(fields, sort_keys=True, default=str))[:32]
+
+
+def _img(path, file_sha256):
+    return {"path": path, "file_sha256": file_sha256}
+
+
+def make_row(pid, condition, label, images, prompt, cfg_digest, extra=None):
+    row = {"id": f"{pid}__{condition}__{label}", "patient": pid, "condition": condition, "label": label,
+           "images": images, "prompt": prompt, "prompt_sha256": S.sha(prompt),
+           "model_revision": generate.MODEL_REVISION, "config_digest": cfg_digest}
+    if extra:
+        row["extra"] = extra
+    row["request_id"] = req_id({"patient": pid, "condition": condition, "label": label,
+                                "images": [(i["path"], i["file_sha256"]) for i in images],
+                                "prompt_sha256": row["prompt_sha256"], "config_digest": cfg_digest,
+                                "model_revision": row["model_revision"]})
+    return row
+
+
+def build_phase1(manifest, patient_ids, cfg_digest):
+    """returns {condition: [rows]} for J_RT, J_TR, A, O, S1."""
+    out = {c: [] for c in ("J_RT", "J_TR", "A", "O", "S1")}
+    for pid in patient_ids:
+        m = manifest[pid]
+        r_img = _img(m["R"]["path"], m["R"]["file_sha256"])
+        t_img = _img(m["T"]["path"], m["T"]["file_sha256"])
+        for inst in m["instances"]:
+            lab = inst["label"]
+            ref = inst["ref_box_norm"]
+            out["J_RT"].append(make_row(pid, "J_RT", lab, [r_img, t_img], S.prompt_J_RT(ref), cfg_digest))
+            out["J_TR"].append(make_row(pid, "J_TR", lab, [t_img, r_img], S.prompt_J_TR(ref), cfg_digest))
+            out["A"].append(make_row(pid, "A", lab, [t_img], S.prompt_A(ref), cfg_digest))
+            out["O"].append(make_row(pid, "O", lab, [t_img], S.prompt_O(inst["point_norm"]), cfg_digest))
+            out["S1"].append(make_row(pid, "S1", lab, [r_img, t_img], S.prompt_S1(ref), cfg_digest))
+    return out
+
+
+def build_s2(manifest, patient_ids, cfg_digest, s1_records):
+    """s1_records: {request_id: record} (검증된 완료 S1 record). returns [rows]."""
+    out = []
+    for pid in patient_ids:
+        m = manifest[pid]
+        t_img = _img(m["T"]["path"], m["T"]["file_sha256"])
+        for inst in m["instances"]:
+            lab = inst["label"]
+            s1_row = make_row(pid, "S1", lab, [_img(m["R"]["path"], m["R"]["file_sha256"]), t_img],
+                              S.prompt_S1(inst["ref_box_norm"]), cfg_digest)
+            rec = s1_records.get(s1_row["request_id"])
+            if rec is None:
+                raise RuntimeError(f"missing S1 record for {pid}/{lab}")
+            desc = rec["suffix_text_raw"]
+            if rec.get("ended_eos"):
+                desc = desc[:-len("<end_of_turn>")] if desc.endswith("<end_of_turn>") else desc
+            desc = desc.strip()
+            row = make_row(pid, "S2", lab, [t_img], S.prompt_S2(desc), cfg_digest,
+                          extra={"s1_request_id": rec["request_id"], "s1_ended_eos": rec.get("ended_eos"),
+                                 "s1_description_sha256": S.sha(desc)})
+            out.append(row)
+    return out
+
+
+def load_rows(path, cfg_digest=None):
+    rows = [json.loads(ln) for ln in open(path) if ln.strip()]
+    ids = [r["request_id"] for r in rows]
+    if len(set(ids)) != len(ids):
+        raise RuntimeError(f"duplicate request_id in {path}")
+    if cfg_digest:
+        for r in rows:
+            if r["config_digest"] != cfg_digest:
+                raise RuntimeError(f"config_digest mismatch for {r['request_id']}")
+            if r.get("model_revision") != generate.MODEL_REVISION:
+                raise RuntimeError("model revision differs")
+    return rows
+
+
+def write_rows(rows, path):
+    if os.path.exists(path):
+        raise RuntimeError(f"{path} exists (not overwriting)")
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w") as f:
+        for r in rows:
+            f.write(json.dumps(r) + "\n")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--phase", required=True, choices=["1", "2"])
+    ap.add_argument("--split", required=True, choices=["D", "E", "F"])
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--s1-dir", default=None, help="phase 2: 완료된 S1 gen_worker*.jsonl 디렉터리")
+    a = ap.parse_args()
+    manifest = json.load(open(f"{DATA_DIR}/manifest.json"))
+    split = json.load(open(f"{DATA_DIR}/split.json"))
+    pids = split[a.split]
+    cfg, _ = generate.static_config()
+    if a.phase == "1":
+        built = build_phase1(manifest, pids, cfg)
+        counts = {}
+        for cond, rows in built.items():
+            p = f"{a.out_dir}/{a.split}__{cond}.jsonl"
+            write_rows(rows, p)
+            counts[cond] = len(rows)
+        print(json.dumps({"split": a.split, "phase": 1, "counts": counts}))
+    else:
+        import glob
+        s1_records = {}
+        for f in sorted(glob.glob(os.path.join(a.s1_dir, "gen_worker*.jsonl"))):
+            for ln in open(f):
+                if ln.strip():
+                    r = json.loads(ln)
+                    s1_records[r["request_id"]] = r
+        rows = build_s2(manifest, pids, cfg, s1_records)
+        p = f"{a.out_dir}/{a.split}__S2.jsonl"
+        write_rows(rows, p)
+        print(json.dumps({"split": a.split, "phase": 2, "counts": {"S2": len(rows)}}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/mi19_run.py b/rsna_diag/mi19_run.py
new file mode 100644
index 0000000..0d07392
--- /dev/null
+++ b/rsna_diag/mi19_run.py
@@ -0,0 +1,255 @@
+"""iter_019 stage 실행기 (qa_run.py 패턴 재사용): worker 수와 GPU 수 분리, 허용 GPU·메모리 여유·완료 검증·자식 종료 코드 강제.
+
+사용: python -m rsna_diag.mi19_run --requests R --out-dir D --protocol P --workers N --peak-gb G [--gpus 0,1]
+"""
+import argparse
+import glob
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+from . import generate, mi19_gen, mi19_protocol, mi19_requests as Q, queue_lock
+
+MIB_PER_GIB = 1024
+
+
+class GpuError(RuntimeError):
+    pass
+
+
+def atomic_json(obj, path):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f, indent=1, default=str)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
+
+
+def allowed_gpus():
+    raw = os.environ.get("CUDA_VISIBLE_DEVICES")
+    if not raw:
+        raise GpuError("CUDA_VISIBLE_DEVICES not set (allowed GPU set unknown)")
+    try:
+        return [int(x) for x in raw.split(",")]
+    except ValueError:
+        raise GpuError(f"non-integer CUDA_VISIBLE_DEVICES {raw!r}")
+
+
+def query_gpus(idx):
+    r = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,memory.used,memory.total", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True)
+    if r.returncode != 0:
+        raise GpuError(f"nvidia-smi failed rc={r.returncode}: {r.stderr[:200]}")
+    rows = {}
+    for ln in r.stdout.strip().splitlines():
+        i, u, mu, mt = [x.strip() for x in ln.split(",")]
+        rows[int(i)] = {"uuid": u, "used_mib": int(mu), "total_mib": int(mt)}
+    missing = [i for i in idx if i not in rows]
+    if missing:
+        raise GpuError(f"gpus {missing} not reported by nvidia-smi")
+    return {i: rows[i] for i in idx}
+
+
+def plan_gpus(gpus, workers, peak_gb, allowed, snapshot):
+    if not gpus or not set(gpus) <= set(allowed):
+        raise GpuError(f"gpus {gpus} not within allowed {allowed}")
+    assign = [(k, gpus[k % len(gpus)]) for k in range(workers)]
+    for g in gpus:
+        n = sum(1 for _, x in assign if x == g)
+        need = n * (peak_gb + 2.0) * MIB_PER_GIB
+        free = snapshot[g]["total_mib"] - snapshot[g]["used_mib"]
+        if n and need > free:
+            raise GpuError(f"gpu {g}: {n} workers x ({peak_gb}+2) GiB = {need:.0f} MiB > free {free} MiB")
+    return assign
+
+
+def live_workers(out_dir):
+    live = []
+    for f in sorted(glob.glob(os.path.join(out_dir, "worker*.lock"))):
+        fd = os.open(f, os.O_RDWR)
+        try:
+            import fcntl
+            try:
+                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                live.append((f, queue_lock._read(fd)))
+                continue
+            fcntl.flock(fd, fcntl.LOCK_UN)
+        finally:
+            os.close(fd)
+    return live
+
+
+def stop_children(procs, grace=60.0):
+    for p in procs:
+        if p.poll() is None:
+            p.terminate()
+    t0 = time.time()
+    while time.time() - t0 < grace and any(p.poll() is None for p in procs):
+        time.sleep(0.5)
+    for p in procs:
+        if p.poll() is None:
+            p.kill()
+    for p in procs:
+        p.wait()
+    return [{"pid": p.pid, "returncode": p.returncode} for p in procs]
+
+
+def verify_job(out_dir, rows, cfg, pdig):
+    mi19_gen.check_inputs(rows)
+    files = {f: mi19_gen.read_strict(f) for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl")))}
+    cache = {}
+    px = lambda p: cache.setdefault(p, generate.load_image(p)[2])
+    done = mi19_gen.validate_records(files, rows, cfg, pdig, px)
+    missing = [r["request_id"] for r in rows if r["request_id"] not in done]
+    return done, missing
+
+
+class _Term(BaseException):
+    pass
+
+
+def _on_term(signum, frame):
+    raise _Term(f"signal {signum}")
+
+
+class _Args:
+    def __init__(self, **kw):
+        self.requests = kw["requests"]
+        self.out_dir = kw["out_dir"]
+        self.protocol = kw["protocol"]
+        self.workers = kw["workers"]
+        self.gpus = kw.get("gpus")
+        self.peak_gb = kw["peak_gb"]
+        self.max_requests = kw.get("max_requests")
+        self.time_limit = kw.get("time_limit")
+        self.repair_tail = kw.get("repair_tail", False)
+        self.poll_s = kw.get("poll_s", 15.0)
+
+
+def main_run(**kwargs):
+    """프로그램적 호출(파이프라인 오케스트레이터용). returns exit code (0=success)."""
+    a = _Args(**kwargs)
+    try:
+        return run_stage(a)
+    except SystemExit as e:
+        return e.code if isinstance(e.code, int) else 1
+
+
+def main():
+    signal.signal(signal.SIGTERM, _on_term)
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--workers", type=int, required=True)
+    ap.add_argument("--gpus", default=None)
+    ap.add_argument("--peak-gb", type=float, required=True)
+    ap.add_argument("--max-requests", type=int, default=None)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    ap.add_argument("--poll-s", type=float, default=15.0)
+    a = ap.parse_args()
+    sys.exit(run_stage(a))
+
+
+def run_stage(a):
+    pdig = mi19_protocol.verify(a.protocol)
+    cfg, _ = mi19_protocol.static_cfg()
+    rows = Q.load_rows(a.requests, cfg)
+    if json.load(open(a.protocol))["locked"]["files"].get(a.requests) != generate.sha(open(a.requests, "rb").read()):
+        sys.exit(f"{a.requests} not locked in {a.protocol}")
+    allowed = allowed_gpus()
+    gpus = [int(x) for x in a.gpus.split(",")] if a.gpus else allowed
+    out_dir = a.out_dir
+    os.makedirs(out_dir, exist_ok=True)
+    cp = os.path.join(out_dir, "completion.json")
+    if os.path.exists(cp):
+        done, missing = verify_job(out_dir, rows, cfg, pdig)
+        if not missing:
+            print(f"already complete & re-verified ({len(rows)} requests); skip", flush=True)
+            sys.exit(0)
+    alive = live_workers(out_dir)
+    if alive:
+        sys.exit(f"live worker(s) still own {out_dir}: {alive}")
+    snap = query_gpus(gpus)
+    assign = plan_gpus(gpus, a.workers, a.peak_gb, allowed, snap)
+    info = queue_lock.my_info(role="mi19_run")
+    rlk, own, _ = queue_lock.try_lock(os.path.join(out_dir, "run.lock"), info)
+    if rlk is None:
+        sys.exit(f"another mi19_run owns {out_dir}: {own}")
+    aid = f"{time.strftime('%Y%m%d_%H%M%S')}_{os.getpid()}"
+    att_dir = os.path.join(out_dir, "attempts")
+    os.makedirs(att_dir, exist_ok=True)
+    att_path = os.path.join(att_dir, f"attempt_{aid}.json")
+    att = {"attempt_id": aid, "status": "running", "pid": os.getpid(), "t_start": time.time(), "workers": a.workers,
+           "assign_worker_gpu": assign, "gpu_uuid": {g: snap[g]["uuid"] for g in gpus}, "peak_gb_assumed": a.peak_gb,
+           "gpu_snapshot_before": snap, "allowed": allowed}
+    procs = []
+    try:
+        if os.path.exists(cp):
+            os.replace(cp, os.path.join(att_dir, f"completion_superseded_by_{aid}.json"))
+        atomic_json(att, att_path)
+        for k, g in assign:
+            cmd = [sys.executable, "-m", "rsna_diag.mi19_gen", "--requests", a.requests, "--out-dir", out_dir,
+                   "--worker", str(k), "--protocol", a.protocol]
+            if a.max_requests is not None:
+                cmd += ["--max-requests", str(a.max_requests)]
+            if a.time_limit:
+                cmd += ["--time-limit", str(a.time_limit)]
+            if a.repair_tail:
+                cmd += ["--repair-tail"]
+            env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(g), CUDA_DEVICE_ORDER="PCI_BUS_ID")
+            procs.append(subprocess.Popen(cmd, env=env, stdout=open(f"{out_dir}/worker{k}.stdout.log", "a"),
+                                          stderr=open(f"{out_dir}/worker{k}.stderr.log", "a")))
+        att["children"] = [{"pid": p.pid, "start": queue_lock.proc_start(p.pid), "worker": k, "gpu": g} for p, (k, g) in zip(procs, assign)]
+        atomic_json(att, att_path)
+        t0 = time.time()
+        rl = open(f"{out_dir}/resource_log.jsonl", "a")
+        while any(p.poll() is None for p in procs):
+            try:
+                q = query_gpus(gpus)
+                apps = subprocess.run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory", "--format=csv,noheader,nounits"],
+                                      capture_output=True, text=True).stdout.strip().splitlines()
+            except GpuError as e:
+                q, apps = {"error": str(e)}, []
+            rl.write(json.dumps({"t": time.time() - t0, "gpus": q, "apps": apps}) + "\n")
+            rl.flush()
+            time.sleep(a.poll_s)
+        codes = [p.returncode for p in procs]
+        wall = time.time() - t0
+        err = None
+        try:
+            done, missing = verify_job(out_dir, rows, cfg, pdig)
+        except mi19_gen.GenError as e:
+            done, missing, err = {}, [r["request_id"] for r in rows], str(e)[:500]
+        per_file = {os.path.basename(f): len(mi19_gen.read_strict(f)) for f in sorted(glob.glob(f"{out_dir}/gen_worker*.jsonl"))}
+        rep = {"n_expected": len(rows), "n_actual_unique": len(done), "n_missing": len(missing), "n_duplicate": 0,
+               "n_extra": 0, "returncodes": codes, "wall_s": wall, "per_file": per_file, "protocol_digest": pdig,
+               "worker_gpu": assign, "gpu_uuid": att["gpu_uuid"], "verify_error": err, "requests": a.requests,
+               "requests_sha256": generate.sha(open(a.requests, "rb").read()), "config_digest": cfg, "attempt_id": aid}
+        atomic_json(rep, f"{out_dir}/last_run.json")
+        ok = not missing and err is None and all(c == 0 for c in codes)
+        att.update({"status": "complete" if ok else "failed_or_incomplete", "returncodes": codes, "t_end": time.time(), "report": rep})
+        atomic_json(att, att_path)
+        if ok:
+            atomic_json(rep, cp)
+        print(f"rc={codes} wall={wall:.0f}s n={len(done)}/{len(rows)} ok={ok}", flush=True)
+        sys.exit(0 if ok else 2)
+    finally:
+        stopped = stop_children(procs) if any(p.poll() is None for p in procs) else [{"pid": p.pid, "returncode": p.returncode} for p in procs]
+        if att["status"] == "running":
+            att.update({"status": "interrupted", "t_end": time.time(), "children_final": stopped})
+            try:
+                atomic_json(att, att_path)
+            except OSError:
+                pass
+        rlk.release()
+
+
+if __name__ == "__main__":
+    main()
