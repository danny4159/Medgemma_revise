+    quota = PLAN_QUOTA[name]
+    if name == "E":
+        # D8 환자와 겹치지 않아야 한다. D8 manifest는 먼저 확정돼 있어야 한다.
+        dm = json.load(open(f"{OUT}/data/manifest_D8.json"))
