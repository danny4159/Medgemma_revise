+++ b/rr47_decide.py
@@ -0,0 +1,41 @@
+"""iter_047 사전 투자 판단 (plan.md Evaluation '사전 투자 판단'을 코드로 고정). 입력: rr47_eval.summarize 결과 report + validity 플래그.
+결과를 보고 문턱을 바꾸지 않는다. 출력 outcome: simple_alternative_sufficient / positive_min_method_review / negative_no_tradeoff / inconclusive / invalid_run.
+"""
+R_GOAL = 0.80
+HFAIL_GOAL = 0.05
+ACC_GAIN = 0.10
+R_TRADE = 0.15
+HFAIL_TRADE = 0.05
+SIMPLE = ["R1", "R2", "BJ", "BI"]
+
+
+def decide(report, valid):
+    c, d = report["conds"], report["diffs"]
+    out = dict(valid=bool(valid), criteria={}, flags=[])
+    if not valid:
+        out["outcome"] = "invalid_run"
+        return out
+    suff = {k: bool(c[k]["r"]["lo95"] >= R_GOAL and c[k]["h_fail"]["hi95"] <= HFAIL_GOAL) for k in SIMPLE}
+    out["criteria"]["simple_sufficient"] = suff
+    c2 = d["BJ-T:acc"]
+    cond2 = bool(c2["mean"] >= ACC_GAIN and c2["lo"] > 0)
+    r_d, h_d = d["BJ-R2:r"], d["BJ-R2:h_fail"]
+    cond3 = bool(r_d["mean"] >= R_TRADE and r_d["lo"] > 0 and h_d["mean"] >= HFAIL_TRADE and h_d["lo"] > 0)
+    cond4 = {k: bool(c[k]["r"]["hi95"] < R_GOAL or c[k]["h_fail"]["lo95"] > HFAIL_GOAL) for k in SIMPLE}
+    out["criteria"].update(image_contributes_BJ_vs_T=cond2, bj_r2_tradeoff=cond3, each_simple_misses_goal=cond4)
+    if any(suff.values()):
+        out["outcome"] = "simple_alternative_sufficient"
+    elif cond2 and cond3 and all(cond4.values()):
+        out["outcome"] = "positive_min_method_review"
+    else:
+        # 음성 계열 flag (투자 보류 근거; 의료 VLM 전체의 기각이 아니다)
+        if c2["hi"] < ACC_GAIN:
+            out["flags"].append("image_gain_over_text_below_0.10")
+        if r_d["hi"] < R_TRADE or h_d["hi"] < HFAIL_TRADE:
+            out["flags"].append("bj_r2_tradeoff_not_reached")
+        if c["R2"]["h_fail"]["hi95"] <= HFAIL_GOAL:
+            out["flags"].append("r2_preserves_within_goal")
+        # 필수 양성 조건 중 하나라도 CI 상한이 문턱 미만이면 음성(투자 보류), 아니면 불확정
+        neg = c2["hi"] < ACC_GAIN or r_d["hi"] < R_TRADE or h_d["hi"] < HFAIL_TRADE
+        out["outcome"] = "negative_no_tradeoff" if neg else "inconclusive"
+    return out
diff --git a/rr47_eval.py b/rr47_eval.py
new file mode 100644
index 0000000..cd66e76
--- /dev/null
+++ b/rr47_eval.py
@@ -0,0 +1,240 @@
+"""iter_047 평가: 상태 JSON -> 최종 상태 -> 수정률 r / 훼손률 h / 보존 실패율 h_fail / 최종 상태 정확도 / clean·robust exact / 초안 민감도,
+환자 단위 층화 paired bootstrap (seed 4702, 10,000회). CPU only. 호출자는 verify(pg43_run.verify_completion + rr47_run.verify)를 먼저 통과해야 한다.
+
+bootstrap 규약(검증기와 공유하는 명세): 층(truth_code)을 정렬 순서로, 층 안의 환자를 PatientID 정렬 순서로 두고
+rng=np.random.default_rng(4702)에서 층마다 integers(0, n_층, size=(B, n_층))를 순서대로 뽑아 모든 조건·지표가 같은 resample을 쓴다.
+"""
+import json
+import math
+
+import numpy as np
+
+import rr47_spec as S
+
+CONDS_EDIT = ["R1", "R2", "T"]
+CONDS = ["K", "R1", "R2", "T", "BJ", "BI"]
+METRICS = ["r", "h", "h_fail", "acc", "clean_exact", "robust_exact", "sens"]
+DRAFTS = S.DRAFT_CODES
+
+
+def parse_all(manifest, rows, recs):
+    """records -> {patient: {cond: parsed}}. 모든 요청을 한 번씩 소비하고 누락/잉여는 예외."""
+    by_rid = {r["request_id"]: r for r in recs}
+    out = {}
+    for row in rows:
+        rec = by_rid[row["request_id"]]
+        p = S.parse_state(rec["suffix_text_raw"], rec["ended_eos"], row["targets"])
+        p["final_cap"] = rec["final_cap"]
+        p["ended_eos"] = rec["ended_eos"]
+        out.setdefault(row["patient"], {})[row["cond"]] = p
+    return out
+
+
+def finals_for(cond, draft, parsed_by_cond, drafts_states):
+    """조건·초안 -> {qA: state, qB: state} (state in present/absent/uncertain/invalid)."""
+    if cond == "K":
+        return dict(zip(S.IDS, drafts_states))
+    if cond in CONDS_EDIT:
+        p = parsed_by_cond[f"{cond}_d{draft}"]
+        return {i: S.final_state(p, i) for i in S.IDS}
+    if cond == "BJ":
+        p = parsed_by_cond["BJ"]
+        return {i: S.final_state(p, i) for i in S.IDS}
+    if cond == "BI":
+        return {i: S.final_state(parsed_by_cond[f"BI_{i}"], i) for i in S.IDS}
+    raise KeyError(cond)
+
+
+def patient_metrics(truth, cond, parsed_by_cond):
+    """truth: [stateA, stateB]. 환자 단위 지표 dict (분모는 환자마다 고정: 틀린 상태 4, 맞은 상태 4, 전체 8)."""
+    n_wrong = n_right = 0
+    fixed = harmed = hfail = correct = 0
+    per_finding_final = {i: [] for i in S.IDS}
+    exact_clean = None
+    all_ok = True
+    for d in DRAFTS:
+        ds = S.code_states(d)
+        fin = finals_for(cond, d, parsed_by_cond, ds)
+        ok_both = True
+        for k, i in enumerate(S.IDS):
+            f = fin[i]
+            per_finding_final[i].append(f)
+            if f == truth[k]:
+                correct += 1
+            else:
+                ok_both = False
+            if ds[k] != truth[k]:
+                n_wrong += 1
+                fixed += f == truth[k]
+            else:
+                n_right += 1
+                harmed += f == S.flip(truth[k])
+                hfail += f != truth[k]
+        if d == S.draft_code(*truth):
+            exact_clean = ok_both
+        all_ok = all_ok and ok_both
+    assert n_wrong == 4 and n_right == 4
+    sens = sum(len(set(v)) > 1 for v in per_finding_final.values()) / 2
+    return dict(r=fixed / 4, h=harmed / 4, h_fail=hfail / 4, acc=correct / 8, clean_exact=float(bool(exact_clean)), robust_exact=float(all_ok), sens=sens)
+
+
+def build_table(manifest, rows, recs):
+    parsed = parse_all(manifest, rows, recs)
+    table = {}
+    for m in manifest["rows"]:
+        pid = m["PatientID"]
+        truth = [m["q"][i]["state"] for i in S.IDS]
+        table[pid] = dict(stratum=m["truth_code"], truth=truth,
+                          metrics={c: patient_metrics(truth, c, parsed[pid]) for c in CONDS if c != "K" or True})
+    return table, parsed
+
+
+def strata(table):
+    st = {}
+    for pid in sorted(table):
+        st.setdefault(table[pid]["stratum"], []).append(pid)
+    return dict(sorted(st.items()))
+
+
+def boot_indices(st, B=S.BOOT_B, seed=S.BOOT_SEED):
+    rng = np.random.default_rng(seed)
+    return [rng.integers(0, len(p), size=(B, len(p))) for p in st.values()]
+
+
+def boot_stat(table, st, idxs, fn):
+    """fn(pid)->float. returns array (B,) of resampled patient means (층별 resample을 합쳐 전체 환자 수로 나눈 값)."""
+    N = sum(len(p) for p in st.values())
+    tot = 0
+    for p, idx in zip(st.values(), idxs):
+        v = np.array([fn(pid) for pid in p], float)
+        tot = tot + v[idx].sum(axis=1)
+    return tot / N
+
+
+def ci(arr, level):
+    a = (1 - level) / 2 * 100
+    return float(np.percentile(arr, a)), float(np.percentile(arr, 100 - a))
+
+
+def summarize(table, conds=CONDS, extra_pairs=()):
+    st = strata(table)
+    idxs = boot_indices(st)
+    N = len(table)
+    out = dict(n_patients=N, strata_sizes={k: len(v) for k, v in st.items()}, conds={}, diffs={})
+    cache = {}
+
+    def samples(c, m):
+        if (c, m) not in cache:
+            cache[(c, m)] = boot_stat(table, st, idxs, lambda pid: table[pid]["metrics"][c][m])
+        return cache[(c, m)]
+
+    for c in conds:
+        out["conds"][c] = {}
+        for m in METRICS:
+            mean = float(np.mean([table[p]["metrics"][c][m] for p in table]))
+            lo, hi = ci(samples(c, m), 0.95)
+            out["conds"][c][m] = dict(mean=mean, lo95=lo, hi95=hi)
+    pairs = [("BJ", "R2", 0.975, ["r", "h_fail", "h", "acc"]), ("BJ", "T", 0.95, ["acc"]), ("R2", "R1", 0.95, ["r", "h_fail", "acc"]),
+             ("BI", "BJ", 0.95, ["r", "h_fail", "acc"]), ("R2", "T", 0.95, ["acc"]), ("R1", "T", 0.95, ["acc"]), ("R2", "K", 0.95, ["r", "h_fail"]),
+             ("BJ", "R1", 0.95, ["r", "h_fail"]), ("BI", "R2", 0.95, ["r", "h_fail"])] + list(extra_pairs)
+    for a, b, lev, ms in pairs:
+        if a not in conds or b not in conds:
+            continue
+        for m in ms:
+            d = samples(a, m) - samples(b, m)
+            mean = float(np.mean([table[p]["metrics"][a][m] - table[p]["metrics"][b][m] for p in table]))
+            lo, hi = ci(d, lev)
+            out["diffs"][f"{a}-{b}:{m}"] = dict(mean=mean, lo=lo, hi=hi, level=lev, degenerate=bool(np.ptp(d) == 0),
+                                              exploratory=(lev != 0.975))
+    return out
+
+
+def format_counts(parsed):
+    out = {}
+    for pid, byc in parsed.items():
+        for cond, p in byc.items():
+            base = cond.split("_d")[0] if cond.startswith(("R1", "R2", "T_", "O_")) else cond.split("_")[0] if cond.startswith("BI") else cond
+            out.setdefault(base, {}).setdefault(p["status"], 0)
+            out[base][p["status"]] += 1
+    return out
+
+
+def uncertain_counts(parsed):
+    out = {}
+    for pid, byc in parsed.items():
+        for cond, p in byc.items():
+            base = cond.split("_d")[0] if cond.startswith(("R1", "R2", "T_", "O_")) else cond.split("_")[0] if cond.startswith("BI") else cond
+            if p["status"] == "ok":
+                for i, v in p["answers"].items():
+                    out.setdefault(base, {}).setdefault(v, 0)
+                    out[base][v] += 1
+    return out
+
+
+def oracle_check(manifest, parsed):
+    """O 조건: 최종 상태가 정답이고 결정론적 문장 렌더링이 canonical 문장과 일치하는가 (D8 형식·편집 연결 검사)."""
+    n = ok = 0
+    bad = []
+    for m in manifest["rows"]:
+        pid = m["PatientID"]
+        fp = {i: m["q"][i]["finding"] for i in S.IDS}
+        truth = {i: m["q"][i]["state"] for i in S.IDS}
+        for d in DRAFTS:
+            p = parsed[pid].get(f"O_d{d}")
+            if p is None:
+                continue
+            n += 1
+            fin = {i: S.final_state(p, i) for i in S.IDS}
+            rend = S.render_final(fp, fin)
+            want = [S.FINDINGS[fp[i]][truth[i]] for i in S.IDS]
+            if fin == truth and rend == want:
+                ok += 1
+            else:
+                bad.append((pid, d, fin))
+    return dict(n=n, ok=ok, bad=bad)
+
+
+def main():
+    import argparse
+    import hashlib
+    import os
+    import sys
+    import rr47_run
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit(f"refuse to overwrite {a.out}")
+    recs = rr47_run.verify(a.out_dir, a.stage, a.protocol)  # completion·요청 집합·hash 재검증 후에만 점수 계산
+    req_path = f"results/iter_047/requests/requests_{a.stage}.jsonl"
+    rows = [json.loads(l) for l in open(req_path)]
+    manifest = json.load(open(f"results/iter_047/data/manifest_{a.stage}.json"))
+    table, parsed = build_table(manifest, rows, recs)
+    rep = summarize(table)
+    rep["stage"] = a.stage
+    rep["format_status_counts"] = format_counts(parsed)
+    rep["answer_counts_ok_only"] = uncertain_counts(parsed)
+    nonO = [(c, p) for byc in parsed.values() for c, p in byc.items() if not c.startswith("O_")]
+    rep["n_valid_requests_nonoracle"] = sum(p["status"] == "ok" for c, p in nonO)
+    rep["n_requests_nonoracle"] = len(nonO)
+    rep["n_non_eos_final"] = sum(1 for byc in parsed.values() for p in byc.values() if not p["ended_eos"])
+    rep["oracle"] = oracle_check(manifest, parsed)
+    rep["per_patient_metrics"] = dict((pid, dict(stratum=t["stratum"], truth=t["truth"], metrics=t["metrics"])) for pid, t in table.items())
+    rep["by_truth_stratum"] = dict((k, dict((c, dict((m, float(np.mean([table[p]["metrics"][c][m] for p in v]))) for m in METRICS)) for c in CONDS))
+                                   for k, v in strata(table).items())
+    h = hashlib.sha256()
+    for f in sorted(os.listdir(a.out_dir)):
+        if f.startswith("gen_worker") and f.endswith(".jsonl"):
+            h.update(open(os.path.join(a.out_dir, f), "rb").read())
+    rep["source"] = dict(protocol=a.protocol, out_dir=a.out_dir, worker_files_digest=h.hexdigest(), spec=S.VERSION, boot_seed=S.BOOT_SEED, boot_b=S.BOOT_B)
+    tmp = a.out + ".tmp"
+    json.dump(rep, open(tmp, "w"), indent=1, default=str)
+    os.replace(tmp, a.out)
+    print("report written", a.out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rr47_gate.py b/rr47_gate.py
new file mode 100644
index 0000000..2e060e8
--- /dev/null
+++ b/rr47_gate.py
@@ -0,0 +1,47 @@
+"""iter_047 D8 기술 gate decision (E 실행 허용 여부). D의 임상 정확도는 보지 않는다 — 형식·입력 정합성·oracle·실행 안정성만 검사한다.
+python rr47_gate.py --report D8_report.json --verify D8_verify.json --workers-cmp cmp.json --resume resume.json --tamper tamper.json --out gate.json
+run=true 조건(사전 고정): report의 oracle 32/32, 모든 요청 최종 EOS, 비oracle 조건별 형식 유효율 >= 0.90, 독립 verifier PASS,
+2/4 worker token 불일치 0, 실제 중단·재개 token 불일치 0, 변조/중복/누락/wrong-config 거부 전부 통과.
+E 자료 gate(E_data_gate.json)는 별도이며 rr47_run.make가 따로 강제한다.
+"""
+import argparse
+import json
+import os
+import sys
+
+MIN_FORMAT_VALID = 0.90
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    for k in ("report", "verify", "workers-cmp", "resume", "tamper", "out"):
+        ap.add_argument("--" + k, required=True)
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        sys.exit("refuse to overwrite gate decision")
+    rep, ver = json.load(open(a.report)), json.load(open(a.verify))
+    cmp_, res, tam = json.load(open(a.workers_cmp)), json.load(open(a.resume)), json.load(open(a.tamper))
+    fs = rep["format_status_counts"]
+    per_cond_valid = {}
+    for c in ("R1", "R2", "T", "BJ", "BI"):
+        n = sum(fs[c].values())
+        per_cond_valid[c] = fs[c].get("ok", 0) / n
+    checks = dict(
+        oracle_all_correct=rep["oracle"]["n"] == 32 and rep["oracle"]["ok"] == 32,
+        all_final_eos=rep["n_non_eos_final"] == 0,
+        format_valid_each_cond=all(v >= MIN_FORMAT_VALID for v in per_cond_valid.values()),
+        independent_verify_pass=bool(ver["passed"]),
+        workers_token_mismatch_zero=cmp_["token_mismatch"] == 0 and cmp_["n_common"] == 152,
+        resume_token_mismatch_zero=res["token_mismatch"] == 0 and res["n_common"] == 152 and res["killed_midrun"] is True,
+        tamper_all_rejected=bool(tam["all_rejected"]),
+    )
+    dec = dict(run=all(checks.values()), checks=checks, per_cond_format_valid=per_cond_valid,
+               inputs=dict(report=a.report, verify=a.verify, workers_cmp=a.workers_cmp, resume=a.resume, tamper=a.tamper))
+    tmp = a.out + ".tmp"
+    json.dump(dec, open(tmp, "w"), indent=1)
+    os.replace(tmp, a.out)
+    print(json.dumps(dec, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rr47_gen_test.py b/rr47_gen_test.py
new file mode 100644
index 0000000..983d7f3
--- /dev/null
+++ b/rr47_gen_test.py
@@ -0,0 +1,254 @@
+"""iter_047 D8 실행 검사: (1) 2/4 worker 출력 정합성, (2) 실제 SIGKILL 중단·재개, (3) 변조·중복·누락·wrong config·동시 launcher 거부.
+python rr47_gen_test.py compare  --a DIR --b DIR --out JSON
+python rr47_gen_test.py resume   --base DIR --out-dir DIR --requests R --protocol P --workers 4 --kill-after N --out JSON
+python rr47_gen_test.py tamper   --src DIR --protocol P --requests R --out JSON
+결과 JSON은 기존 파일을 덮어쓰지 않는다.
+"""
+import argparse
+import glob
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+import pg43_run as PR
+import rr47_run
+
+
+def load(d):
+    recs = {}
+    for f in sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl"))):
+        for r in PR.read_records(f):
+            recs[r["request_id"]] = r
+    return recs
+
+
+def write_new(path, obj):
+    if os.path.exists(path):
+        sys.exit(f"refuse to overwrite {path}")
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    json.dump(obj, open(path + ".tmp", "w"), indent=1, default=str)
+    os.replace(path + ".tmp", path)
+
+
+def compare(a, b):
+    A, B = load(a), load(b)
+    common = sorted(set(A) & set(B))
+    mism = [r for r in common if A[r]["suffix_ids"] != B[r]["suffix_ids"] or A[r]["input_ids_sha256"] != B[r]["input_ids_sha256"]]
+    return dict(a=a, b=b, n_a=len(A), n_b=len(B), n_common=len(common), token_mismatch=len(mism), mismatched_ids=mism[:10],
+                only_a=len(set(A) - set(B)), only_b=len(set(B) - set(A)))
+
+
+def resume(a):
+    if os.path.exists(a.out_dir):
+        sys.exit("resume out-dir exists")
+    cmd = [sys.executable, "pg43_run.py", "launch", "--requests", a.requests, "--protocol", a.protocol, "--out-dir", a.out_dir,
+           "--workers", str(a.workers), "--peak-gb", "8.5"]
+    p = subprocess.Popen(cmd, start_new_session=True, stdout=open(a.out_dir + ".launch1.stdout", "w"), stderr=subprocess.STDOUT)
+    n = 0
+    t0 = time.time()
+    while time.time() - t0 < 900:
+        time.sleep(3)
+        n = sum(len(PR.read_records(f)) for f in glob.glob(os.path.join(a.out_dir, "gen_worker*.jsonl")))
+        if n >= a.kill_after or p.poll() is not None:
+            break
+    killed = p.poll() is None
+    if killed:
+        os.killpg(p.pid, signal.SIGKILL)
+    p.wait()
+    time.sleep(5)
+    n_at_kill = sum(len(PR.read_records(f)) for f in glob.glob(os.path.join(a.out_dir, "gen_worker*.jsonl")))
+    partial_bytes = []
+    for f in glob.glob(os.path.join(a.out_dir, "gen_worker*.jsonl")):
+        data = open(f, "rb").read()
+        partial_bytes.append(dict(file=os.path.basename(f), ends_with_newline=data.endswith(b"\n") or not data))
+    p2 = subprocess.run(cmd, capture_output=True, text=True)
+    comp = os.path.exists(os.path.join(a.out_dir, "completion.json"))
+    res = compare(a.base, a.out_dir)
+    res.update(killed_midrun=killed, records_at_kill=n_at_kill, partial_tails=partial_bytes, relaunch_rc=p2.returncode, relaunch_stdout=p2.stdout[-300:],
+               completion_written=comp, repair_logs=sorted(os.path.basename(f) for f in glob.glob(os.path.join(a.out_dir, "*.repair.log"))),
+               preserved_partial_files=sorted(os.path.basename(f) for f in glob.glob(os.path.join(a.out_dir, "*.partial.*.bin"))))
+    if comp:
+        rr47_run.verify(a.out_dir, "D8", a.protocol)
+        res["verify_after_resume"] = "ok"
+    return res
+
+
+def expect_reject(name, fn, out):
+    try:
+        fn()
+        out.append(dict(name=name, rejected=False))
+    except PR.RunError as e:
+        out.append(dict(name=name, rejected=True, error=str(e)[:160]))
+    except Exception as e:  # 다른 종류의 오류는 의도한 검증 분기가 아니므로 기록하되 거부로 세지 않는다
+        out.append(dict(name=name, rejected=False, other_error=repr(e)[:200]))
+
+
+def tamper(a):
+    root = os.path.join(os.path.dirname(a.src.rstrip("/")), "tamper_work_" + os.path.splitext(os.path.basename(a.out))[0])
+    if os.path.exists(root):
+        sys.exit("tamper_work exists")
+    res = []
+    shutil.copytree(a.src, root + "_base")
+    base = root + "_base"
+    stage = "D8"
+    # 0. 변조 전 정상 확인
+    rr47_run.verify(base, stage, a.protocol)
+    res.append(dict(name="unmodified copy verifies", rejected=False, expected_pass=True))
+    files = sorted(glob.glob(os.path.join(base, "gen_worker*.jsonl")))
+
+    def fresh(tag):
+        d = f"{root}_{tag}"
+        shutil.copytree(base, d)
+        return d
+
+    d = fresh("digest")  # record 내용 변경 (digest 불일치)
+    f = sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl")))[0]
+    lines = open(f).read().split("\n")
+    r = json.loads(lines[0])
+    r["suffix_text_raw"] = r["suffix_text_raw"].replace("absent", "present", 1)
+    lines[0] = json.dumps(r)
+    open(f, "w").write("\n".join(lines))
+    expect_reject("edited record content (record_digest/file hash)", lambda: rr47_run.verify(d, stage, a.protocol), res)
+    d = fresh("dup")  # 중복 record
+    f = sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl")))[0]
+    first = open(f).read().split("\n")[0]
+    open(f, "a").write(first + "\n")
+    expect_reject("duplicated record line", lambda: rr47_run.verify(d, stage, a.protocol), res)
+    d = fresh("miss")  # 누락 record
+    f = sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl")))[0]
+    ln = open(f).read().split("\n")
+    open(f, "w").write("\n".join(ln[1:]))
+    expect_reject("missing record line", lambda: rr47_run.verify(d, stage, a.protocol), res)
+    d = fresh("exit")  # completion 종료 코드 변조
+    c = json.load(open(os.path.join(d, "completion.json")))
+    c["exit_codes"][0] = 1
+    json.dump(c, open(os.path.join(d, "completion.json"), "w"))
+    expect_reject("completion exit code != 0", lambda: rr47_run.verify(d, stage, a.protocol), res)
+    d = fresh("proto")  # wrong config: 다른 코드 hash의 구 protocol
+    expect_reject("wrong protocol (v1, code locked at different hash)", lambda: rr47_run.verify(d, stage, "results/iter_047/protocol/protocol_D8_v1.json"), res)
+    d = fresh("reqs")  # 요청 파일 변조
+    req2 = d + "/requests_altered.jsonl"
+    rows = open(a.requests).read().split("\n")
+    r0 = json.loads(rows[0])
+    r0["prompt"] = r0["prompt"] + " "
+    rows[0] = json.dumps(r0, sort_keys=True)
+    open(req2, "w").write("\n".join(rows))
+    expect_reject("altered request file vs protocol lock", lambda: PR.verify_completion(d, req2, a.protocol), res)
+    d = fresh("adapter")  # record가 adapter를 썼다고 변조 -> digest 불일치
+    f = sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl")))[0]
+    lines = open(f).read().split("\n")
+    r = json.loads(lines[0])
+    r["adapter_digest"] = "deadbeef"
+    lines[0] = json.dumps(r)
+    open(f, "w").write("\n".join(lines))
+    expect_reject("record claims adapter use", lambda: rr47_run.verify(d, stage, a.protocol), res)
+    # --- 공격자가 completion의 worker 파일 hash까지 맞춘 경우: 파일 hash가 아니라 record 내부 검증 분기가 실패해야 한다 ---
+    def rehash(d):
+        c = json.load(open(os.path.join(d, "completion.json")))
+        for fn in c["worker_file_sha256"]:
+            c["worker_file_sha256"][fn] = PR.file_sha(os.path.join(d, fn))
+        json.dump(c, open(os.path.join(d, "completion.json"), "w"))
+
+    def edit_first(d, fn_edit, redigest):
+        f = sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl")))[0]
+        lines = open(f).read().split("\n")
+        r = json.loads(lines[0])
+        fn_edit(r)
+        if redigest:
+            r["record_digest"] = PR.record_digest(r)
+        lines[0] = json.dumps(r)
+        open(f, "w").write("\n".join(lines))
+        rehash(d)
+
+    def branch(name, d, want, edit=None, redigest=False, dup=False, drop=False):
+        if edit:
+            edit_first(d, edit, redigest)
+        f = sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl")))[0]
+        if dup:
+            open(f, "a").write(open(f).read().split("\n")[0] + "\n")
+            rehash(d)
+        if drop:
+            open(f, "w").write("\n".join(open(f).read().split("\n")[1:]))
+            rehash(d)
+        try:
+            rr47_run.verify(d, stage, a.protocol)
+            res.append(dict(name=name, rejected=False))
+        except PR.RunError as e:
+            res.append(dict(name=name, rejected=(want in str(e)), want=want, error=str(e)[:160]))
+
+    branch("[inner] edited content, completion rehashed -> record digest", fresh("b1"), "record digest mismatch",
+           edit=lambda r: r.__setitem__("suffix_text_raw", r["suffix_text_raw"] + " "))
+    branch("[inner] duplicated line, rehashed -> request set", fresh("b2"), "request set mismatch", dup=True)
+    branch("[inner] dropped line, rehashed -> request set", fresh("b3"), "request set mismatch", drop=True)
+    branch("[inner] adapter digest set + record re-digested -> adapter/protocol digest", fresh("b4"), "adapter/protocol digest mismatch",
+           edit=lambda r: r.__setitem__("adapter_digest", "deadbeef"), redigest=True)
+    branch("[inner] row digest edited + re-digested -> record digest", fresh("b5"), "record digest mismatch",
+           edit=lambda r: r.__setitem__("row_digest", "00" * 32), redigest=True)
+    branch("[inner] prompt hash edited + re-digested -> prompt hash", fresh("b6"), "prompt hash mismatch",
+           edit=lambda r: r.__setitem__("prompt_sha256", "11" * 32), redigest=True)
+
+    def txt_edit(d):
+        for f in sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl"))):
+            lines = open(f).read().split("\n")
+            for k, ln in enumerate(lines):
+                if ln.strip() and json.loads(ln)["modality"] == "text":
+                    r = json.loads(ln)
+                    r["n_image_tokens"] = 5
+                    r["record_digest"] = PR.record_digest(r)
+                    lines[k] = json.dumps(r)
+                    open(f, "w").write("\n".join(lines))
+                    rehash(d)
+                    return
+    d = fresh("b7")
+    txt_edit(d)
+    try:
+        rr47_run.verify(d, stage, a.protocol)
+        res.append(dict(name="[inner] text-only record with image tokens", rejected=False))
+    except PR.RunError as e:
+        res.append(dict(name="[inner] text-only record with image tokens", rejected=("text-only record carries image input" in str(e)), error=str(e)[:160]))
+    # 동시 launcher: 같은 out-dir launch.lock 을 잡고 있는 동안 두 번째 launcher는 거부해야 한다
+    ld = f"{root}_lock"
+    os.makedirs(ld)
+    fd = PR.try_flock(os.path.join(ld, "launch.lock"))
+    r2 = subprocess.run([sys.executable, "pg43_run.py", "launch", "--requests", a.requests, "--protocol", a.protocol, "--out-dir", ld, "--workers", "1"],
+                        capture_output=True, text=True)
+    os.close(fd)
+    res.append(dict(name="concurrent launcher on locked out-dir", rejected=(r2.returncode != 0 and "another launcher" in (r2.stdout + r2.stderr)), rc=r2.returncode,
+                    msg=(r2.stdout + r2.stderr)[-120:]))
+    r3 = subprocess.run([sys.executable, "pg43_run.py", "launch", "--requests", a.requests, "--protocol", a.protocol, "--out-dir", base, "--workers", "1"],
+                        capture_output=True, text=True)
+    res.append(dict(name="launch into a completed out-dir", rejected=(r3.returncode != 0 and "completion.json exists" in (r3.stdout + r3.stderr)), rc=r3.returncode))
+    tests = [x for x in res if not x.get("expected_pass")]
+    return dict(results=res, all_rejected=all(x["rejected"] for x in tests), n_tests=len(tests), root=root)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    c = sub.add_parser("compare")
+    c.add_argument("--a", required=True)
+    c.add_argument("--b", required=True)
+    c.add_argument("--out", required=True)
+    r = sub.add_parser("resume")
+    for k in ("base", "out-dir", "requests", "protocol", "out"):
+        r.add_argument("--" + k, required=True)
+    r.add_argument("--workers", type=int, default=4)
+    r.add_argument("--kill-after", type=int, default=40)
+    t = sub.add_parser("tamper")
+    for k in ("src", "protocol", "requests", "out"):
+        t.add_argument("--" + k, required=True)
+    a = ap.parse_args()
+    if a.cmd == "compare":
+        write_new(a.out, compare(a.a, a.b))
+    elif a.cmd == "resume":
+        write_new(a.out, resume(a))
+    else:
+        write_new(a.out, tamper(a))
+
+
+if __name__ == "__main__":
+    main()
