+                             "peak_reserved_gib_max": max(max(x["peak_mem_reserved_gb"] for x in r["attempts"]) for r in allrecs)}) + "\n")
+
+
+def finish(d, a, target, reqmap, sci_digest, image_ids):
+    recs = load_own(d, reqmap, sci_digest, image_ids)
