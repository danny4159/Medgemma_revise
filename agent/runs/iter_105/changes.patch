+    tmp = p.with_name(p.name + f'.{os.getpid()}.tmp')
+    with tmp.open('x') as f:
+        json.dump(value, f, ensure_ascii=False, indent=2)
+        f.flush()
+        os.fsync(f.fileno())
+    try:
+        os.link(tmp, p)  # 이미 있으면 FileExistsError
+    finally:
