new file mode 100644
index 0000000..8c9dc9b
--- /dev/null
+++ b/lk105_data.py
@@ -0,0 +1,282 @@
+"""iter_105: 소견–영역 연결 제안 진단용 PadChest-GR train 쌍 선정 (CPU only, 모델 출력 미사용).
+
+단계:
+  enumerate : train 전체에서 사전 규칙(환자당 1영상·1문장쌍)으로 후보를 열거하고 hash 순서·제외 사유·과거 노출을 기록한다.
+  extract   : 앞 N_POOL(=D4 4 + E32 32 + reserve 64 + 시각/문장 제외 예비)명의 영상을 uint16>>8 uint8 PNG로 추출하고 contact sheet/overlay를 만든다.
+  lock      : visual_audit.json(눈·문장 검토로 제외한 ID) 반영 후 D4/E32/reserve 입력·정답·잠금을 쓴다.
+영상 규약은 report101_data와 동일(uint16 -> uint8 right shift 8). 새 산출물은 results/iter_105 아래에만 쓴다.
+문장 원문은 변경하지 않는다. 제외 검토는 assistant의 문장/영상 점검이며 전문의 검토가 아니다.
+"""
+import hashlib
+import io
+import json
+import os
+import re
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+import pg39_data as D
+from report86_common import ROOT, sha, sha_obj, save
+
+R105 = ROOT / "results/iter_105"
+DATA = R105 / "data"
+SEED = 105017
+N_D, N_E, N_R = 4, 32, 64
+N_POOL = 120   # hash 순서 앞 120명 추출: 100 사용 + 20 예비(문장/영상 제외용)
+IMG_RE = re.compile(r"[0-9]{20,}_[0-9a-z]+\.png")
+
+
+def hk(*parts):
+    return hashlib.sha256("|".join(str(p) for p in (SEED,) + parts).encode()).hexdigest()
+
+
+def inter_area(a, b):
+    w = min(a[2], b[2]) - max(a[0], b[0])
+    h = min(a[3], b[3]) - max(a[1], b[1])
+    return max(0.0, w) * max(0.0, h)
+
+
+def all_boxes(f):
+    return [list(map(float, b)) for b in f["boxes"]] + [list(map(float, b)) for b in f.get("extra_boxes") or []]
+
+
+def pair_ok(fi, fj):
+    """(ok, reason). 두 문장: 서로 다른 문장·label 집합, boxes+extra_boxes 사이 양의 면적 교차 없음."""
+    if fi["sentence_en"].strip().lower() == fj["sentence_en"].strip().lower():
+        return False, "same_sentence"
+    if set(fi["labels"]) == set(fj["labels"]):
+        return False, "same_label_set"
+    for a in all_boxes(fi):
+        for b in all_boxes(fj):
+            if inter_area(a, b) > 0:
+                return False, "annotation_overlap"
+    return True, ""
+
+
+def finding_ok(f, lab2grp):
+    ok, why = D.eligibility(f, lab2grp)
+    if not ok:
+        return False, why
+    if len(f["boxes"]) != 1:
+        return False, "not_single_box"
+    eb = f.get("extra_boxes") or []
+    if not all(D.valid_box(b) for b in eb):
+        return False, "invalid_extra_box"
+    return True, ""
+
+
+def scan_prior_images():
+    """results 안의 json/jsonl/csv/txt에서 PadChest ImageID가 등장한 파일 목록 {id: [files]} (과거 사용·노출 기록)."""
+    seen = {}
+    for dirpath, dns, fns in os.walk(ROOT / "results"):
+        dns[:] = [d for d in dns if d not in ("runtime_cache", "models", "hf", "images", "raw", "environments", "external", "datasets", "iter_105")]
+        for fn in fns:
+            if not fn.endswith((".json", ".jsonl", ".csv", ".txt")):
+                continue
+            p = Path(dirpath) / fn
+            try:
+                if p.stat().st_size > 80 << 20:
+                    continue
+                txt = p.read_text(errors="ignore")
+            except OSError:
+                continue
+            for m in set(IMG_RE.findall(txt)):
+                seen.setdefault(m, []).append(str(p.relative_to(ROOT)))
+    return seen
+
+
+def do_enumerate():
+    reports, m, links = D.load_inputs()
+    lab2grp = links["lab2grp"]
+    train = [r for r in reports if links["img2split"][r["ImageID"]] == "train"]
+    excl = Counter()
+    per_img = {}
+    for r in train:
+        iid = r["ImageID"]
+        el = []
+        for idx, f in enumerate(r["findings"]):
+            ok, why = finding_ok(f, lab2grp)
+            if ok:
+                el.append(idx)
+            else:
+                excl["finding_" + why] += 1
+        pairs = []
+        for a, i in enumerate(el):
+            for j in el[a + 1:]:
+                ok, why = pair_ok(r["findings"][i], r["findings"][j])
+                if ok:
+                    pairs.append((i, j))
+                else:
+                    excl["pair_" + why] += 1
+        if not pairs:
+            excl["image_no_valid_pair"] += 1
+            continue
+        i, j = min(pairs, key=lambda p: hk(iid, p[0], p[1]))
+        per_img[iid] = {"ImageID": iid, "PatientID": links["img2patient"][iid], "StudyID": r["StudyID"], "i": i, "j": j,
+                        "n_valid_pairs": len(pairs), "hash": hk(links["img2patient"][iid], iid)}
+    seen = scan_prior_images()
+    prior_pat = {links["img2patient"][i] for i in seen if i in links["img2patient"]}
+    prior_study = {links["img2study"][i] for i in seen if i in links["img2study"]}
+    by_pat = defaultdict(list)
+    n_prior = 0
+    for v in per_img.values():
+        # 제외하지 않고 기록한다: 두 모델은 frozen이며 이전 반복의 환자 사용은 LoRA 학습/개발 manifest이다 (v1 열거는 광범위 파일 언급까지
+        # 제외해 254->29로 줄어 폐기: enumeration.json은 superseded로 보존)
+        n_prior += v["PatientID"] in prior_pat or v["StudyID"] in prior_study or v["ImageID"] in seen
+        by_pat[v["PatientID"]].append(v)
+    reps = [min(vs, key=lambda v: v["hash"]) for vs in by_pat.values()]
+    reps.sort(key=lambda v: v["hash"])
+    pool = reps[:N_POOL]
+    by_id = {r["ImageID"]: r for r in train}
+    for v in pool:
+        v["earlier_use_files"] = seen.get(v["ImageID"], [])
+        f = by_id[v["ImageID"]]["findings"]
+        v["s_i"], v["s_j"] = f[v["i"]]["sentence_en"], f[v["j"]]["sentence_en"]
+        v["labels_i"], v["labels_j"] = f[v["i"]]["labels"], f[v["j"]]["labels"]
+    out = {"rule": "train only; findings: abnormal, single valid box, no progression, no TEMPORAL_RE, labels mapped, valid extra_boxes; "
+                   "pair: distinct sentence & label set, no positive-area intersection among boxes+extra_boxes of the two findings; "
+                   "per image min hk(ImageID|i|j) pair; patient representative min hk(PatientID|ImageID); "
+                   "no exclusion for earlier use (recorded only; frozen models); order by representative hash; "
+                   f"pool=first {N_POOL}; D4=first {N_D}, E32 next {N_E}, reserve next {N_R} (after audit exclusions)",
+           "seed": SEED, "n_train_images": len(train), "exclusion_counts": dict(excl), "n_images_with_valid_pair": len(per_img),
+           "n_images_with_prior_use_recorded": n_prior, "n_prior_images_seen_in_results": len(seen),
+           "n_candidate_patients": len(reps), "pool": pool, "raw_sha256": D.PINNED, "code_sha256": sha(__file__)}
+    save(DATA / "enumeration_v2.json", out)
+    print(json.dumps({k: out[k] for k in ("n_train_images", "exclusion_counts", "n_images_with_valid_pair", "n_images_with_prior_use_recorded",
+                                           "n_candidate_patients")}, indent=1))
+
+
+def extract_one(z, zi, iid):
+    raw = z.read(zi)
+    a = np.asarray(Image.open(io.BytesIO(raw)))
+    if a.dtype != np.uint16 or a.ndim != 2:
+        raise D.InputError(f"{iid}: unexpected dtype/shape {a.dtype} {a.shape}")
+    b = (a >> 8).astype(np.uint8)
+    (DATA / "images").mkdir(parents=True, exist_ok=True)
+    (DATA / "raw").mkdir(parents=True, exist_ok=True)
+    pu8, praw = DATA / "images" / iid, DATA / "raw" / iid
+    if praw.exists():
+        assert praw.read_bytes() == raw
+    else:
+        praw.write_bytes(raw)
+    if not pu8.exists():
+        tmp = str(pu8) + f".{os.getpid()}.tmp.png"
+        Image.fromarray(b).save(tmp)
+        os.replace(tmp, pu8)
+    h, w = a.shape
+    return {"image": str(pu8), "raw_path": str(praw), "zip_member": zi.filename, "zip_crc": zi.CRC,
+            "raw_png_sha256": hashlib.sha256(raw).hexdigest(), "u16_pixel_sha256": hashlib.sha256(a.tobytes()).hexdigest(),
+            "u8_pixel_sha256": hashlib.sha256(b.tobytes()).hexdigest(), "file_sha256": sha(pu8), "h": int(h), "w": int(w)}
+
+
+def do_extract():
+    en = json.loads((DATA / "enumeration_v2.json").read_text())
+    reports, _, links = D.load_inputs()
+    by_id = {r["ImageID"]: r for r in reports}
+    z = D.open_image_zip()
+    idx = D.zip_index(z)
+    meta = {}
+    for v in en["pool"]:
+        meta[v["ImageID"]] = extract_one(z, idx[v["ImageID"]], v["ImageID"])
+    pix = Counter(m["u16_pixel_sha256"] for m in meta.values())
+    prior_pix = set()
+    for q in (ROOT / "results").glob("iter_*/*/inputs*.json"):
+        try:
+            for d in json.load(open(q)):
+                if isinstance(d, dict) and d.get("u16_pixel_sha256"):
+                    prior_pix.add(d["u16_pixel_sha256"])
+        except (ValueError, OSError):
+            pass
+    for p in (ROOT / "results").glob("iter_0*/data/manifest*.jsonl"):
+        for ln in open(p):
+            try:
+                h = (json.loads(ln).get("image_meta") or {}).get("u16_pixel_sha256")
+            except ValueError:
+                continue
+            if h:
+                prior_pix.add(h)
+    ov = {"within_pool_duplicate_pixel_hashes": sum(c > 1 for c in pix.values()),
+          "pixel_overlap_with_prior_manifests": sum(m["u16_pixel_sha256"] in prior_pix for m in meta.values()),
+          "n_prior_pixel_hashes_checked": len(prior_pix)}
+    save(DATA / "extract_meta.json", {"meta": meta, "overlaps": ov, "convention": "uint16>>8 -> uint8 (iter_039/042/086/101과 동일)"})
+    # overlay: 두 문장의 boxes(실선)와 extra_boxes(점선 대신 얇은 선) — 문장 번호별 색
+    (DATA / "overlay").mkdir(exist_ok=True)
+    sheets, items = [], []
+    for k, v in enumerate(en["pool"]):
+        f = by_id[v["ImageID"]]["findings"]
+        im = Image.open(DATA / "images" / v["ImageID"]).convert("RGB")
+        w, h = im.size
+        dr = ImageDraw.Draw(im)
+        lw = max(3, w // 300)
+        for idx_f, col in ((v["i"], (255, 60, 60)), (v["j"], (60, 255, 60))):
+            for b in f[idx_f]["boxes"]:
+                dr.rectangle([b[0] * w, b[1] * h, b[2] * w, b[3] * h], outline=col, width=lw)
+            for b in f[idx_f].get("extra_boxes") or []:
+                dr.rectangle([b[0] * w, b[1] * h, b[2] * w, b[3] * h], outline=tuple(c // 2 for c in col), width=1)
+        im.thumbnail((380, 380))
+        items.append((k, v["ImageID"], im))
+    for s in range(0, len(items), 12):
+        part = items[s:s + 12]
+        sheet = Image.new("RGB", (4 * 380, 3 * 400), 0)
+        dr = ImageDraw.Draw(sheet)
+        for n, (k, iid, im) in enumerate(part):
+            x, y = (n % 4) * 380, (n // 4) * 400
+            sheet.paste(im, (x, y + 18))
+            dr.text((x + 4, y + 2), f"#{k} {iid[:8]}  red=S_i green=S_j", fill=(255, 255, 255))
+        p = DATA / "overlay" / f"sheet_{s // 12:02d}.png"
+        sheet.save(p)
+        sheets.append({"file": str(p), "items": [f"#{k}:{iid}" for k, iid, _ in part]})
+    save(DATA / "overlay_sheets.json", sheets)
+    print(json.dumps(ov), len(sheets), "sheets")
+
+
+def do_lock():
+    en = json.loads((DATA / "enumeration_v2.json").read_text())
+    meta = json.loads((DATA / "extract_meta.json").read_text())["meta"]
+    audit = json.loads((DATA / "visual_audit.json").read_text())
+    excluded = {x["ImageID"] for x in audit["excluded"]}
+    keep = [v for v in en["pool"] if v["ImageID"] not in excluded]
+    n_need = N_D + N_E + N_R
+    use = keep[:n_need]
+    reports, _, links = D.load_inputs()
+    by_id = {r["ImageID"]: r for r in reports}
+    stages = {"D4": use[:N_D], "E32": use[N_D:N_D + N_E], "R64": use[N_D + N_E:]}
+    refs, rows_all = {}, {}
+    for st, vs in stages.items():
+        rows = []
+        for v in vs:
+            f = by_id[v["ImageID"]]["findings"]
+            fi, fj = f[v["i"]], f[v["j"]]
+            m = meta[v["ImageID"]]
+            # 문장 ID(S1/S2)는 해시 parity로 무작위 배정 (원문 순서·위치와 독립)
+            swap = int(hk(v["ImageID"], "assign"), 16) % 2 == 1
+            a, b = (fj, fi) if swap else (fi, fj)
+            rows.append({"PatientID": v["PatientID"], "StudyID": v["StudyID"], "ImageID": v["ImageID"], "image": m["image"],
+                         "file_sha256": m["file_sha256"], "u16_pixel_sha256": m["u16_pixel_sha256"], "size": [m["w"], m["h"]],
+                         "split": "train", "stage": st, "order_hash": v["hash"],
+                         "S1": a["sentence_en"], "S2": b["sentence_en"], "box1": a["boxes"][0], "box2": b["boxes"][0],
+                         "extra1": a.get("extra_boxes") or [], "extra2": b.get("extra_boxes") or [],
+                         "labels1": a["labels"], "labels2": b["labels"], "finding_idx": [v["j"], v["i"]] if swap else [v["i"], v["j"]]})
+        rows_all[st] = rows
+        save(DATA / f"inputs_{st}.json", rows)
+        save(DATA / f"raw_manifest_{st}.json", [{"ImageID": r["ImageID"], "raw_path": meta[r["ImageID"]]["raw_path"],
+                                                  "sha256": meta[r["ImageID"]]["raw_png_sha256"]} for r in rows])
+    allrows = [r for st in rows_all.values() for r in st]
+    for k in ("PatientID", "StudyID", "ImageID", "u16_pixel_sha256"):
+        assert len({r[k] for r in allrows}) == len(allrows), k
+    assert len(allrows) == n_need, len(allrows)
+    lock = {"enumeration_v2_sha256": sha(DATA / "enumeration_v2.json"), "extract_meta_sha256": sha(DATA / "extract_meta.json"),
+            "visual_audit_sha256": sha(DATA / "visual_audit.json"), "n_excluded_audit": len(excluded),
+            **{f"inputs_{st}_sha256": sha(DATA / f"inputs_{st}.json") for st in rows_all},
+            "n": {st: len(r) for st, r in rows_all.items()}, "code_sha256": sha(__file__),
+            "label": "all development material (train split); not an independent test"}
+    save(DATA / "selection_lock.json", lock)
+    print(json.dumps(lock, indent=1))
+
+
+if __name__ == "__main__":
+    {"enumerate": do_enumerate, "extract": do_extract, "lock": do_lock}[sys.argv[1]]()
diff --git a/lk105_eval.py b/lk105_eval.py
new file mode 100644
index 0000000..1e628b5
--- /dev/null
+++ b/lk105_eval.py
@@ -0,0 +1,255 @@
+"""iter_105 평가: 환자 단위 연결 정확도·paired 차이·전환·PG 대안·확대 규칙. 입력은 완료·검증된 shard 출력만.
+
+분석 단위는 환자. 환자별 두 순서의 정확도를 평균한다. invalid/truncated/abstain은 오답으로 센다(별도 집계).
+bootstrap: 환자 단위 10,000회, seed 105017, 95% percentile. 모델별로 분리 보고한다(합성 없음).
+요청 구성에서 GT는 C/W 제안 문장에만 쓰였고, 평가에서 GT와 대조한다.
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+import lk105_run as R
+import lk105_spec as S
+from report86_common import sha, sha_obj, save
+
+BOOT, BSEED = 10000, 105017
+
+
+def load_stage(gen_dir, stage, workers, systems=("CURE", "M15")):
+    """completion과 요청 집합을 전수 검증하고 {system: {id: record}}를 돌려준다."""
+    out = {}
+    for system in systems:
+        nw = workers[system] if isinstance(workers, dict) else workers
+        sd = sha_obj(R.scientific_protocol(stage, system, nw))
+        recs = {}
+        for k in range(nw):
+            c, rs = R.verify_completion(R.shard_dir(gen_dir, system, k), stage, system, k, nw, sd)
+            for r in rs:
+                assert r["id"] not in recs
+                recs[r["id"]] = r
+        assert set(recs) == {q["id"] for q in R.requests(stage, system)}, "request set mismatch"
+        out[system] = recs
+    return out
+
+
+def final_text(rec):
+    a = rec["attempts"][-1]
+    return rec["text"], a["ended_eos"]
+
+
+PARSERS = {"strict": S.parse_choice, "lenient_v1": S.parse_choice_lenient}
+
+
+def patient_table(stage, recs, system, parser=S.parse_choice):
+    """returns list per patient: dict with per-condition arrays."""
+    rows, _ = R.stage_rows(stage)
+    tab = []
+    for row in rows:
+        iid = row["ImageID"]
+        t = {"ImageID": iid, "sel": {}, "status": {}}
+        for mod in ("img", "txt"):
+            for cond in S.CONDS:
+                for o in S.ORDERS:
+                    rec = recs[f"{iid}|{system}|{mod}-{cond}-o{o}"]
+                    text, eos = final_text(rec)
+                    ans, status = parser(text, eos)
+                    t["sel"][(mod, cond, o)] = ans
+                    t["status"][(mod, cond, o)] = status
+        # PG
+        pgs = {}
+        for k in ("S1", "S2"):
+            rec = recs[f"{iid}|{system}|pg-{k}"]
+            text, eos = final_text(rec)
+            pgs[k] = S.parse_pg(system, text, eos, row)
+        t["pg"] = pgs
+        a, sa, sb = S.pg_connection(row, pgs["S1"]["boxes"], pgs["S2"]["boxes"])
+        t["pg_choice"], t["pg_scores"] = a, (sa, sb)
+        t["pg_iou"] = (S.best_iou(pgs["S1"]["boxes"], row["box1"]), S.best_iou(pgs["S2"]["boxes"], row["box2"]))
+        # 민감도: 참조를 boxes ∪ extra_boxes로 확장
+        ex1, ex2 = [row["box1"]] + row["extra1"], [row["box2"]] + row["extra2"]
+        sa2 = max(S.best_iou(pgs["S1"]["boxes"], b) for b in ex1) + max(S.best_iou(pgs["S2"]["boxes"], b) for b in ex2)
+        sb2 = max(S.best_iou(pgs["S1"]["boxes"], b) for b in ex2) + max(S.best_iou(pgs["S2"]["boxes"], b) for b in ex1)
+        t["pg_choice_ext"] = None if (sa2 == sb2 or (sa2 == 0 and sb2 == 0)) else ("A" if sa2 > sb2 else "B")
+        tab.append(t)
+    return tab
+
+
+def correct(t, mod, cond, o):
+    return t["sel"][(mod, cond, o)] == S.gt_letter(o)
+
+
+def acc_vec(tab, mod, cond, filt=None):
+    """환자별 두 순서 평균 정확도."""
+    return np.array([np.mean([correct(t, mod, cond, o) for o in S.ORDERS]) for t in tab], float)
+
+
+def boot_ci(x, fn=np.mean, n=BOOT, seed=BSEED):
+    rng = np.random.default_rng(seed)
+    idx = rng.integers(0, len(x), size=(n, len(x)))
+    vals = fn(x[idx], axis=1) if fn is np.mean else np.array([fn(x[i]) for i in idx])
+    return [float(np.percentile(vals, 2.5)), float(np.percentile(vals, 97.5))]
+
+
+def mean_ci(x):
+    x = np.asarray(x, float)
+    return {"mean": float(x.mean()), "ci95": boot_ci(x), "n": int(len(x))}
+
+
+def diff_ci(a, b):
+    return mean_ci(np.asarray(a, float) - np.asarray(b, float))
+
+
+def summarize_tab(tab, recs):
+    n = len(tab)
+    out = {"n_patients": n}
+    acc = {f"{mod}_{c}": acc_vec(tab, mod, c) for mod in ("img", "txt") for c in S.CONDS}
+    out["acc"] = {k: mean_ci(v) for k, v in acc.items()}
+    pg = np.array([1.0 if t["pg_choice"] == "A" else 0.0 for t in tab])
+    out["acc"]["PG"] = mean_ci(pg)
+    out["acc"]["PG_ext_reference_sensitivity"] = mean_ci([1.0 if t["pg_choice_ext"] == "A" else 0.0 for t in tab])
+    out["paired"] = {"N_minus_W": diff_ci(acc["img_N"], acc["img_W"]), "C_minus_N": diff_ci(acc["img_C"], acc["img_N"]),
+                     "N_minus_TextN": diff_ci(acc["img_N"], acc["txt_N"]), "C_minus_W": diff_ci(acc["img_C"], acc["img_W"]),
+                     "TextN_minus_TextW": diff_ci(acc["txt_N"], acc["txt_W"]), "C_minus_PG": diff_ci(acc["img_C"], pg),
+                     "N_minus_PG": diff_ci(acc["img_N"], pg)}
+    # 전환: 같은 order에서 N 정답→W 오답 (환자 수/요청 수), W 정답→N 오답 반대 방향도 보고
+    def trans(c1, c2, mod="img"):
+        pats, reqs = 0, 0
+        for t in tab:
+            k = sum(correct(t, mod, c1, o) and not correct(t, mod, c2, o) for o in S.ORDERS)
+            pats += k > 0
+            reqs += k
+        return {"patients": int(pats), "requests": int(reqs)}
+    out["transitions"] = {"N_right_to_W_wrong": trans("N", "W"), "W_right_to_N_wrong": trans("W", "N"), "N_right_to_C_wrong": trans("N", "C"),
+                          "N_right_to_W_wrong_text": trans("N", "W", "txt"), "N_wrong_to_C_right": trans("C", "N")}
+    # 양 순서 일치(같은 환자의 두 순서에서 선택한 문장-영역 연결이 동일; 둘 다 유효일 때)
+    cons = {}
+    for mod in ("img", "txt"):
+        for c in S.CONDS:
+            ok = [t for t in tab if t["sel"][(mod, c, 0)] and t["sel"][(mod, c, 1)]]
+            # order1에서 같은 연결은 반대 글자: 연결 일치 = 글자가 다름
+            same = [t["sel"][(mod, c, 0)] != t["sel"][(mod, c, 1)] for t in ok]
+            cons[f"{mod}_{c}"] = {"n_both_valid": len(ok), "same_connection_rate": float(np.mean(same)) if same else None}
+    out["order_consistency"] = cons
+    # 제안 추종률 (유효 응답 중 제안 글자와 같은 비율) — Copy 규칙의 해석 기준
+    follow = {}
+    for mod in ("img", "txt"):
+        for c in ("C", "W"):
+            v = [t["sel"][(mod, c, o)] == S.proposal_letter(c, o) for t in tab for o in S.ORDERS]
+            follow[f"{mod}_{c}"] = float(np.mean(v))
+    out["follow_proposal_rate"] = follow
+    # 형식/응답 상태
+    st = {}
+    for mod in ("img", "txt"):
+        for c in S.CONDS:
+            cnt = {}
+            for t in tab:
+                for o in S.ORDERS:
+                    s = t["status"][(mod, c, o)]
+                    cnt[s] = cnt.get(s, 0) + 1
+            st[f"{mod}_{c}"] = cnt
+    out["selection_status"] = st
+    out["letter_prior"] = {f"{mod}_{c}": {"A_rate": float(np.mean([t["sel"][(mod, c, o)] == "A" for t in tab for o in S.ORDERS]))}
+                           for mod in ("img", "txt") for c in S.CONDS}
+    # valid-format only 환자 (두 순서 모두 N/W img 유효)
+    ok = [t for t in tab if all(t["status"][("img", c, o)] == "valid" for c in ("N", "W") for o in S.ORDERS)]
+    if ok:
+        a_n = np.array([np.mean([correct(t, "img", "N", o) for o in S.ORDERS]) for t in ok])
+        a_w = np.array([np.mean([correct(t, "img", "W", o) for o in S.ORDERS]) for t in ok])
+        out["valid_only_N_minus_W"] = {**diff_ci(a_n, a_w), "n_patients": len(ok)}
+    # 후보 순서별 N−W
+    out["by_order_N_minus_W"] = {f"o{o}": float(np.mean([correct(t, "img", "N", o) for t in tab]) - np.mean([correct(t, "img", "W", o) for t in tab]))
+                                 for o in S.ORDERS}
+    # 조건부: N이 두 순서 모두 맞은 환자에서 W/C 정확도
+    both = [t for t in tab if all(correct(t, "img", "N", o) for o in S.ORDERS)]
+    out["conditional_on_N_both_orders_right"] = {"n": len(both),
+                                                  "W_acc": float(np.mean([np.mean([correct(t, "img", "W", o) for o in S.ORDERS]) for t in both])) if both else None,
+                                                  "C_acc": float(np.mean([np.mean([correct(t, "img", "C", o) for o in S.ORDERS]) for t in both])) if both else None}
+    # PG 상세
+    pgst = {}
+    for k in ("S1", "S2"):
+        for t in tab:
+            s = t["pg"][k]["status"]
+            pgst[s] = pgst.get(s, 0) + 1
+    out["pg"] = {"status": pgst, "abstain": int(sum(t["pg_choice"] is None for t in tab)),
+                 "grounding_iou_mean": mean_ci([np.mean(t["pg_iou"]) for t in tab]),
+                 "grounding_iou_ge_0.3_sentence_rate": float(np.mean([v >= 0.3 for t in tab for v in t["pg_iou"]])),
+                 "ext_reference_choice_differs": int(sum(t["pg_choice"] != t["pg_choice_ext"] for t in tab))}
+    # 비용(생성 초 합, cap 재시도 포함)
+    def cost(pred):
+        v = [sum(x["runtime_s"] for x in r["attempts"]) for r in recs.values() if pred(r)]
+        return {"n": len(v), "mean_s": float(np.mean(v)) if v else None, "sum_s": float(np.sum(v)) if v else None}
+    out["cost_generation_s"] = {"select_img": cost(lambda r: r["kind"] == "select" and r["modality"] == "image"),
+                                "select_txt": cost(lambda r: r["kind"] == "select" and r["modality"] == "text"),
+                                "pg": cost(lambda r: r["kind"] == "pg")}
+    out["final_not_eos"] = int(sum(not r["attempts"][-1]["ended_eos"] for r in recs.values()))
+    out["cap_retries"] = int(sum(len(r["attempts"]) > 1 for r in recs.values()))
+    out["max_new_tokens_select"] = int(max(r["attempts"][-1]["n_new"] for r in recs.values() if r["kind"] == "select"))
+    return out
+
+
+def expansion_rule(summ):
+    """사전 확대 규칙(E32): 모델별 N≥0.70 & N−TextN≥0.10 & (N−W≥0.10 or N정답→W오답 ≥3명). 한 모델이라도 충족하면 두 모델 모두 확대."""
+    per = {}
+    for s, o in summ.items():
+        n = o["acc"]["img_N"]["mean"]
+        cond = {"N_ge_0.70": n >= 0.70, "N_minus_TextN_ge_0.10": o["paired"]["N_minus_TextN"]["mean"] >= 0.10,
+                "N_minus_W_ge_0.10": o["paired"]["N_minus_W"]["mean"] >= 0.10,
+                "transitions_ge_3_patients": o["transitions"]["N_right_to_W_wrong"]["patients"] >= 3}
+        per[s] = {**cond, "meets": bool(cond["N_ge_0.70"] and cond["N_minus_TextN_ge_0.10"] and (cond["N_minus_W_ge_0.10"] or cond["transitions_ge_3_patients"]))}
+    return {"per_model": per, "expand_to_E96": any(v["meets"] for v in per.values())}
+
+
+def classify(summ):
+    """E96 평가용 사전 분류(양성 관찰·단순 대안 충분성·후속 최소 개입 검토 조건). E32에서는 탐색 표시로만 쓴다."""
+    out = {}
+    for s, o in summ.items():
+        p = o["paired"]
+        pos = (o["acc"]["img_N"]["mean"] >= 0.70 and p["N_minus_TextN"]["mean"] >= 0.10 and p["N_minus_W"]["mean"] >= 0.10
+               and p["N_minus_W"]["ci95"][0] > 0 and o["transitions"]["N_right_to_W_wrong"]["patients"] >= 3
+               and o.get("valid_only_N_minus_W", {}).get("mean", 0) > 0 and all(v > 0 for v in o["by_order_N_minus_W"].values()))
+        best_nc = max(o["acc"]["img_N"]["mean"], o["acc"]["img_C"]["mean"])
+        pg_ok = o["acc"]["PG"]["mean"] >= 0.85 and o["acc"]["PG"]["mean"] >= best_nc - 0.05
+        followup = (pos and not pg_ok and p["C_minus_N"]["mean"] >= 0.10 and p["C_minus_PG"]["mean"] >= 0.10)
+        out[s] = {"positive_observation": bool(pos), "simple_alternative_PG_sufficient_on_this_sample": bool(pg_ok),
+                  "followup_minimal_intervention_review_condition": bool(followup)}
+    return out
+
+
+def main(stage_names, gen_dirs, workers, tag, systems=("CURE", "M15")):
+    """stage_names: 합칠 단계 목록(예: E32 또는 E32,R64). gen_dirs: 단계별 gen dir."""
