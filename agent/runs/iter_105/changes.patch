+    rowmap = {r["ImageID"]: r for r in rows}
+    saved = 0
+    t_start = time.monotonic()
+    with (d / "outputs.jsonl").open("a", buffering=1) as f:
+        for img in [r["ImageID"] for r in rows if r["ImageID"] in by_img]:
+            row = rowmap[img]
+            im, px_sha = None, None
