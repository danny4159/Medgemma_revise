new file mode 100644
index 0000000..451b422
--- /dev/null
+++ b/sp77_resume_test.py
@@ -0,0 +1,157 @@
+"""iter_077 학습 재개·단일 소유권·수치 재현 검사 (결과: results/iter_077/tests/resume; 단계 상태: results/iter_077/state).
+
+결정적 설정(--deterministic = use_deterministic_algorithms + 기본 SDPA; sp77_sdpa_probe 근거)에서 같은 장치(GPU0)·같은 초기 상태·batch·RNG로
+ ref   : 중단 없는 연속 2 epoch
+ A     : step4 직후(마지막 checkpoint는 step3: 미커밋 step4 로그 구간) 중단 -> 재개(재개 중 동시 중복 실행은 거부되어야 함)
+ B     : epoch1 checkpoint 직후, validation 전 중단 -> 재개에서 validation 복구
+를 실행하고 step별 loss·grad_norm·batch/token hash·RNG·LR, checkpoint digest, val_ce, adapter digest를 정확 비교한다.
+GPU1 보조: ref_g1 (다른 장치 연속 실행; 정보용, 통과 조건 아님). 임의 tolerance 없음. 비교 집합이 비거나 step 집합이 다르면 FAIL.
+각 단계는 sp77_stage 상태 파일로 기록·재사용되며, 자식 실패/예외는 부모의 비정상 종료로 전달된다.
+"""
+import json, os, subprocess, sys, threading, time
+
+import sp77_stage as S
+
+OUT = 'results/iter_077'
+BASE = f'{OUT}/tests/resume'
+STATE = f'{OUT}/state'
+COMMON = ['--variant', 'F', '--lr', '2e-4', '--seed', '17']
+DET = ['--epochs', '2', '--save-epochs', '1,2', '--deterministic']
+CODE = ['sp75_train.py', 'sp75_vlm.py', 'sp75_data.py', 'rsna_diag/train.py', 'rsna_diag/lora.py', 'rsna_diag/generate.py', 'rsna_diag/queue_lock.py', 'sp77_stage.py', 'sp77_resume_test.py']
+errs = []
+
+
+def cmd(run, gpu, extra):
+    return [sys.executable, 'sp75_train.py', '--run-dir', f'{BASE}/{run}', '--gpu', gpu, *COMMON, *extra]
+
+
+def fin(run):
+    return [f'{BASE}/{run}/epoch_02/val_ce.json', f'{BASE}/{run}/freeze_end.json']
+
+
+def stage(name, run, gpu, extra, outputs, expect_rc=0):
+    return S.run_stage(STATE, name, cmd(run, gpu, extra), outputs, CODE, gpu=gpu, log=f'{BASE}/{name}.out', expect_rc=expect_rc)
+
+
+def guarded(fn):
+    def w(*a):
+        try:
+            fn(*a)
+        except BaseException as e:   # 스레드 안에서 오류를 잃지 않는다
+            errs.append(repr(e))
+    return w
+
+
+def chain0():
+    stage('ref', 'ref', '0', DET, fin('ref'))
+    stage('A_stop', 'A', '0', DET + ['--stop-after-step', '4', '--allow-uncommitted-stop'], [f'{BASE}/A_stop.out'], expect_rc=5)
+    res_err = []
+
+    def resume():
+        try:
+            stage('A_resume', 'A', '0', DET, fin('A'))
+        except BaseException as e:
+            res_err.append(repr(e))
+    t = threading.Thread(target=resume)
+    t.start()
+    for _ in range(300):    # A_resume이 lock을 잡고 'resumed' 로그를 낼 때까지 대기 후 동시 중복 실행을 시도
+        time.sleep(2)
+        if os.path.exists(f'{BASE}/A_resume.out') and 'resumed step=' in open(f'{BASE}/A_resume.out').read():
+            break
+    stage('A_dup_concurrent', 'A', '0', DET, [f'{BASE}/A_dup_concurrent.out'], expect_rc=1)
+    t.join()
+    if res_err:
+        raise RuntimeError(res_err[0])
+    stage('B_stop', 'B', '0', DET + ['--stop-after-epoch-ckpt', '1'], [f'{BASE}/B_stop.out'], expect_rc=3)
+    json.dump({'B_val_before_resume': os.path.exists(f'{BASE}/B/epoch_01/val_ce.json')}, open(f'{BASE}/B_before_resume.json.tmp', 'w'))
+    if not os.path.exists(f'{BASE}/B_before_resume.json'):
+        os.replace(f'{BASE}/B_before_resume.json.tmp', f'{BASE}/B_before_resume.json')
+    stage('B_resume', 'B', '0', DET, fin('B'))
+
+
+def chain1():
+    stage('ref_g1', 'ref_g1', '1', DET, fin('ref_g1'))
+
+
+def events(run):
+    return [json.loads(l) for l in open(f'{BASE}/{run}/train_log.jsonl') if l.strip()]
+
+
+def steps(L):
+    out = {}
+    for r in L:
+        if 'loss' in r:
+            if r['step'] in out:
+                raise RuntimeError('duplicate logged step')
+            out[r['step']] = r
+    return out
+
+
+def val(run, e):
+    return json.load(open(f'{BASE}/{run}/epoch_{e:02d}/val_ce.json'))
+
+
+def compare(a_run, b_run, epochs):
+    La, Lb = events(a_run), events(b_run)
+    sa, sb = steps(La), steps(Lb)
+    common = sorted(set(sa) & set(sb))
+    res = {'n_steps': [len(sa), len(sb)], 'same_step_set': sorted(sa) == sorted(sb), 'n_common': len(common)}
+    first = None
+    for s in common:
+        if (sa[s]['loss'] != sb[s]['loss'] or sa[s]['grad_norm'] != sb[s]['grad_norm']) and first is None:
+            first = {'step': s, 'loss_a': sa[s]['loss'], 'loss_b': sb[s]['loss'], 'abs_diff': abs(sa[s]['loss'] - sb[s]['loss'])}
+    res['first_loss_mismatch'] = first
+    res['max_abs_loss_diff'] = max(abs(sa[s]['loss'] - sb[s]['loss']) for s in common) if common else None
+    res['loss_exact_equal_all'] = bool(common) and all(sa[s]['loss'] == sb[s]['loss'] and sa[s]['grad_norm'] == sb[s]['grad_norm'] for s in common)
+    res['batch_ids_token_sha_equal'] = bool(common) and all(sa[s]['batch_ids'] == sb[s]['batch_ids'] and sa[s]['batch_token_sha'] == sb[s]['batch_token_sha'] for s in common)
+    res['rng_before_equal'] = bool(common) and all(sa[s]['rng_before'] == sb[s]['rng_before'] and sa[s]['opt_step_before'] == sb[s]['opt_step_before'] for s in common)
+    res['lr_equal'] = bool(common) and all(sa[s]['lr'] == sb[s]['lr'] for s in common)
+    ca = {r['step']: r['digests'] for r in La if r.get('event') == 'checkpoint'}
+    cb = {r['step']: r['digests'] for r in Lb if r.get('event') == 'checkpoint'}
+    cc = sorted(set(ca) & set(cb))
+    res['checkpoint_steps_common'] = cc
+    res['checkpoint_digests_equal_common_steps'] = {str(s): ca[s] == cb[s] for s in cc}
+    res['val_ce'] = {str(e): [val(a_run, e)['val_ce'], val(b_run, e)['val_ce']] for e in epochs}
+    res['val_ce_equal'] = all(val(a_run, e)['val_ce'] == val(b_run, e)['val_ce'] for e in epochs)
+    res['adapter_digest_equal'] = all(val(a_run, e)['adapter_digest'] == val(b_run, e)['adapter_digest'] for e in epochs)
+    res['val_tokens_equal'] = all(val(a_run, e)['val_tokens'] == val(b_run, e)['val_tokens'] for e in epochs)
+    res['ok'] = bool(res['same_step_set'] and res['n_common'] == 18 and res['loss_exact_equal_all'] and res['batch_ids_token_sha_equal'] and res['rng_before_equal'] and res['lr_equal']
+                     and len(cc) >= 6 and all(res['checkpoint_digests_equal_common_steps'].values()) and res['val_ce_equal'] and res['adapter_digest_equal'] and res['val_tokens_equal'])
+    return res
+
+
+def main():
+    os.makedirs(BASE, exist_ok=True)
+    t = [threading.Thread(target=guarded(chain0)), threading.Thread(target=guarded(chain1))]
+    t0 = time.time()
+    [x.start() for x in t]
+    [x.join() for x in t]
+    res = {'wall_s': time.time() - t0, 'errors': errs, 'gpu_env': os.environ.get('CUDA_VISIBLE_DEVICES')}
+    ok = {'no_stage_errors': not errs}
+    if not errs:
+        res['A_vs_ref'], res['B_vs_ref'] = compare('A', 'ref', (1, 2)), compare('B', 'ref', (1, 2))
+        res['ref_g1_vs_ref_info_only'] = compare('ref_g1', 'ref', (1, 2))
+        La, Lb = events('A'), events('B')
+        res['A_resume_events'] = [r for r in La if r.get('event') == 'resume']
+        res['B_resume_events'] = [r for r in Lb if r.get('event') == 'resume']
+        res['B_val_events'] = [r.get('epoch') for r in Lb if r.get('event') == 'val_ce']
+        res['B_val_before_resume'] = json.load(open(f'{BASE}/B_before_resume.json'))['B_val_before_resume']
+        res['dup_message_tail'] = open(f'{BASE}/A_dup_concurrent.out').read()[-300:]
+        unc = f'{BASE}/A/train_log.uncommitted.jsonl'
+        res['A_uncommitted_rows_preserved'] = [json.loads(l) for l in open(unc) if l.strip()][:1] if os.path.exists(unc) else None
+        ok['A_vs_ref'], ok['B_vs_ref'] = res['A_vs_ref']['ok'], res['B_vs_ref']['ok']
+        ok['A_restored_equals_saved_and_tail_quarantined'] = len(res['A_resume_events']) == 1 and res['A_resume_events'][0].get('restored_equals_saved') is True and res['A_resume_events'][0].get('quarantined_rows') == 1
+        ok['B_resume_restored'] = len(res['B_resume_events']) == 1 and res['B_resume_events'][0].get('restored_equals_saved') is True
+        ok['B_val_missing_before_resume_and_recovered'] = res['B_val_before_resume'] is False and res['B_val_events'] == [1, 2]
+        ok['dup_rejected_by_lock'] = 'owned by live process' in res['dup_message_tail']
+        res['ref_g1_exact_info'] = res['ref_g1_vs_ref_info_only']['loss_exact_equal_all']
+    res['ok'] = ok
+    res['PASS'] = bool(ok and all(ok.values()))
+    json.dump(res, open(f'{BASE}/resume_compare.json.tmp', 'w'), indent=1)
+    os.replace(f'{BASE}/resume_compare.json.tmp', f'{BASE}/resume_compare.json')
+    print(json.dumps({'PASS': res['PASS'], 'ok': ok, 'errors': errs}, indent=1))
+    sys.exit(0 if res['PASS'] else 1)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp77_sdpa_probe.py b/sp77_sdpa_probe.py
new file mode 100644
index 0000000..867c9a5
--- /dev/null
+++ b/sp77_sdpa_probe.py
@@ -0,0 +1,90 @@
+"""iter_077 메모리·재현성 probe (학습 의미 변경 없음; 진단 전용, 학습 없음).
+
+iter_076 결정적 실행(set_deterministic: math SDPA만)은 allocated 21.5GiB·43초/step이었다. 어떤 SDPA backend 구성에서
+(a) peak allocated/reserved (b) 같은 입력·초기 상태 두 번의 forward/backward gradient가 bit 단위로 같은지를 측정한다.
+구성: nondet_default(기본), det_math(현 --deterministic), det_flag_only(use_deterministic_algorithms만, SDPA backend 기본), det_efficient(math 끄고 efficient/flash 허용)
+사용: python sp77_sdpa_probe.py --out results/iter_077/tests/sdpa_probe.json --gpu 0
+"""
+import argparse, hashlib, json, os, sys, time
+
+import sp75_data as D
+import sp75_vlm as V
+from rsna_diag import generate, lora
+from rsna_diag import train as T
+
+
+def grad_digest(torch, params):
+    h = hashlib.sha256()
+    for p in params:
+        h.update(p.grad.detach().float().cpu().numpy().tobytes())
+    return h.hexdigest()[:16]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--gpu', required=True)
+    a = ap.parse_args()
+    inh = os.environ.get('CUDA_VISIBLE_DEVICES', '').split(',')
+    if a.gpu not in inh:
+        sys.exit(f'gpu {a.gpu} not in inherited {inh}')
+    os.environ['CUDA_VISIBLE_DEVICES'] = a.gpu
+    os.environ['CUBLAS_WORKSPACE_CONFIG'] = ':4096:8'
+    if os.path.exists(a.out):
+        sys.exit('exists')
+    import torch
+    T.seed_all(torch, 17)
+    man = D.load_manifest()
+    rows = sorted([r for r in man['rows'] if r['split'] == 'T24' and r['position_set'] == 'supervised' and not r['excluded']], key=lambda r: (int(r['patient']), r['ordinal']))[:2]
+    _, proc, model = generate.load_model()
+    lora.apply_lora(model, 16, 32, 0.0, seed=17)   # dropout 0: 이 probe는 backend 간 수치 재현만 본다
+    params = list(lora.lora_params(model).values())
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={'use_reentrant': False})
+    model.config.use_cache = False
+    model.train()
+    batches = [V.to_cuda(V.collate([V.build_example(proc, V.load_images(r['inputs']['F']), V.PROMPTS['F'], str(r['grade']))], proc.tokenizer.pad_token_id)) for r in rows]
+    res = {'attn_implementation': getattr(model.config, '_attn_implementation', None), 'gpu_logical': a.gpu, 'configs': {}}
+
+    def setcfg(name):
+        be = torch.backends.cuda
+        torch.use_deterministic_algorithms(name.startswith('det'))
+        be.enable_flash_sdp(True); be.enable_mem_efficient_sdp(True); be.enable_math_sdp(True)
+        if name == 'det_math':
+            be.enable_flash_sdp(False); be.enable_mem_efficient_sdp(False)
+        if name == 'det_efficient':
+            be.enable_math_sdp(False)
+
+    for name in ('nondet_default', 'det_flag_only', 'det_efficient', 'det_math'):
+        entry = {}
+        try:
+            setcfg(name)
+            digs, losses, ts = [], [], []
+            torch.cuda.empty_cache()
+            torch.cuda.reset_peak_memory_stats()
+            for rep in range(2):
+                for p in params:
+                    p.grad = None
+                t0 = time.time()
+                tot = 0.0
+                for b in batches:
+                    ls, n = V.loss_sum(torch, model, b)
+                    (ls / (2 * len(batches))).backward()
+                    tot += float(ls) / n
+                torch.cuda.synchronize()
+                ts.append(time.time() - t0)
+                losses.append(tot)
+                digs.append(grad_digest(torch, params))
+            entry = {'grad_digest_rep': digs, 'repeat_bitwise_equal': digs[0] == digs[1], 'losses': losses, 'sec_per_2ex_fwd_bwd': ts,
+                     'peak_allocated_gib': torch.cuda.max_memory_allocated() / 2 ** 30, 'peak_reserved_gib': torch.cuda.max_memory_reserved() / 2 ** 30}
+        except Exception as ex:
+            entry = {'error': repr(ex)[:400]}
+        res['configs'][name] = entry
+        print(name, json.dumps(entry), flush=True)
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    tmp = a.out + '.tmp'
+    json.dump(res, open(tmp, 'w'), indent=1)
+    os.replace(tmp, a.out)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp77_stage.py b/sp77_stage.py
new file mode 100644
index 0000000..b91b81e
--- /dev/null
+++ b/sp77_stage.py
@@ -0,0 +1,119 @@
+"""iter_077 단계 실행 상태 관리 (pending/running/completed/failed, 원자적 기록, stale 완료 거부, 자식 반환값 전파).
+
+state 파일: <state_dir>/<stage>.json  {status, cmd, rc, code_sha, outputs{path: sha256}, pid, pid_start, ts_start, ts_end, gpu, peak_gpu_used_mib, wall_s}
+- completed 재사용 조건: 기록된 code_sha가 현재 코드와 같고 모든 outputs 파일의 sha256가 기록과 같다. 하나라도 다르면 stale로 보고 재실행한다(기존 파일 덮어쓰기 금지는 호출자가 새 경로 사용).
+- running 상태 기록이 있고 그 pid(+시작 tick)가 살아 있으면 중복 시작하지 않고 예외를 낸다. 죽었으면 failed(stale-running)로 기록 후 재실행한다.
+- 자식 rc != 0 이면 StageFailed를 일으킨다. 호출 측은 이를 잡아 부모 프로세스를 비정상 종료시킨다.
+"""
+import hashlib, json, os, subprocess, threading, time
+
+
+class StageFailed(RuntimeError):
+    pass
+
+
+def sha_file(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(1 << 22), b''):
+            h.update(b)
+    return h.hexdigest()
+
+
+def code_sha(files):
+    return {f: sha_file(f) for f in files}
+
+
+def _atomic(obj, path):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = path + f'.tmp{os.getpid()}'
+    json.dump(obj, open(tmp, 'w'), indent=1, default=str)
+    os.replace(tmp, path)
+
+
+def _pid_start(pid):
+    try:
+        return open(f'/proc/{pid}/stat').read().split()[21]
+    except Exception:
+        return None
+
+
+def read_state(state_dir, name):
+    p = os.path.join(state_dir, name + '.json')
+    return json.load(open(p)) if os.path.exists(p) else None
+
+
+def completed_valid(state_dir, name, code_files):
+    st = read_state(state_dir, name)
+    if not st or st.get('status') != 'completed' or st.get('rc') != st.get('expect_rc', 0):
+        return False
+    if st.get('code_sha') != code_sha(code_files):
+        return False
+    for p, h in st.get('outputs', {}).items():
+        if not os.path.exists(p) or sha_file(p) != h:
+            return False
+    return bool(st.get('outputs'))
+
+
+_gpu_lock = threading.Lock()
+
+
+def gpu_used():
+    out = subprocess.check_output(['nvidia-smi', '--query-gpu=index,uuid,memory.used,memory.total', '--format=csv,noheader,nounits']).decode().strip().splitlines()
+    res = {}
+    for ln in out:
+        i, u, used, tot = [x.strip() for x in ln.split(',')]
+        res[i] = {'used': int(used), 'total': int(tot), 'uuid': u}
+    return res
+
+
+def run_stage(state_dir, name, cmd, outputs, code_files, gpu=None, log=None, expect_rc=0, extra=None, verify=None):
+    """cmd 실행. outputs: 완료로 인정하려면 존재해야 하는 파일 목록. expect_rc: 의도적 중단 시험은 비0 코드를 기대할 수 있다.
+    반환: state dict. 실패 시 StageFailed."""
+    if completed_valid(state_dir, name, code_files):
+        st = read_state(state_dir, name)
+        st['reused'] = True
+        return st
+    old = read_state(state_dir, name)
+    if old and old.get('status') == 'running':
+        pid, ps = old.get('pid'), old.get('pid_start')
+        if pid and _pid_start(pid) == ps and ps is not None:
+            raise StageFailed(f'stage {name} owned by live pid {pid}')
+        old['status'], old['note'] = 'failed', 'stale-running (owner not alive)'
+        _atomic(old, os.path.join(state_dir, name + '.stale.json'))
+    st = {'stage': name, 'status': 'running', 'cmd': cmd, 'gpu': gpu, 'code_sha': code_sha(code_files), 'ts_start': time.time(), 'pid': os.getpid(), 'pid_start': _pid_start(os.getpid()),
+          'expect_rc': expect_rc, **(extra or {})}
+    _atomic(st, os.path.join(state_dir, name + '.json'))
+    os.makedirs(os.path.dirname(log), exist_ok=True) if log else None
+    p = subprocess.Popen(cmd, stdout=open(log, 'a') if log else None, stderr=subprocess.STDOUT)
+    peak = 0
+    while p.poll() is None:
+        try:
+            u = gpu_used()
+            if gpu is not None:
+                peak = max(peak, max(v['used'] for k, v in u.items() if v['uuid'] == gpu or k == gpu))
+        except Exception:
+            pass
+        time.sleep(5)
+    st.update({'rc': p.returncode, 'ts_end': time.time(), 'wall_s': time.time() - st['ts_start'], 'peak_gpu_used_mib': peak})
+    missing = [o for o in outputs if not os.path.exists(o)]
+    vprob = None
+    if p.returncode == expect_rc and not missing and verify is not None:
+        try:
+            verify()
+        except BaseException as e:
+            vprob = repr(e)[:400]
+            st['verify_error'] = vprob
+    if p.returncode == expect_rc and not missing and vprob is None:
+        st['status'] = 'completed'
+        st['outputs'] = {o: sha_file(o) for o in outputs}
+        if expect_rc != 0:
+            st['rc_matches_expected_nonzero'] = True
+            st['rc'] = p.returncode
+    else:
+        st['status'] = 'failed'
+        st['missing_outputs'] = missing
+    _atomic(st, os.path.join(state_dir, name + '.json'))
+    if st['status'] != 'completed':
+        raise StageFailed(f'stage {name} rc={p.returncode} (expected {expect_rc}) missing={missing} verify_error={vprob}')
+    return st
