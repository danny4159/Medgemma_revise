@@ -0,0 +1,45 @@
+"""iter_058: 공식 HD-GLIO v2.0 predict_from_folder 호출 wrapper (venv hdglio58의 python으로 실행).
+설정은 공식 hd_glio_predict_folder와 동일: fold (0,), TTA 사용(tta=True), mixed precision 기본값, checkpoint model_final_checkpoint.
+case 단위 shard를 입력 폴더 하위 symlink 없이 case 목록 파일로 받아 임시 폴더에 hard-link하여 호출한다.
+사용: HD_GLIO_PARAMS=... CUDA_VISIBLE_DEVICES=k hdglio58 python hdglio58_pred.py IN_DIR OUT_DIR CASE_LIST.json TIMING.json
+출력: OUT_DIR/{case}.nii.gz (label 0/1/2), TIMING.json: 단계별 wall(sync) 기록
+"""
+import json
+import os
+import shutil
+import sys
+import time
+
+import torch
+
+from hd_glio.paths import folder_with_parameter_files
+from nnunet.inference.predict import predict_from_folder
+
+
+def main():
+    in_dir, out_dir, case_json, timing = sys.argv[1:5]
+    cases = json.load(open(case_json))
+    procs = int(os.environ.get("HDG_PROCS", "2"))
+    assert os.path.isdir(folder_with_parameter_files), folder_with_parameter_files
+    work = out_dir + ".in_tmp"
+    shutil.rmtree(work, ignore_errors=True)
+    os.makedirs(work)
+    os.makedirs(out_dir, exist_ok=True)
+    for c in cases:
+        for s in ("0000", "0001", "0002", "0003"):
+            os.link(f"{in_dir}/{c}_{s}.nii.gz", f"{work}/{c}_{s}.nii.gz")
+    t0 = time.time()
+    predict_from_folder(folder_with_parameter_files, work, out_dir, (0,), False, procs, procs, None, 0, 1, True,
+                        overwrite_existing=True, checkpoint_name="model_final_checkpoint")
+    torch.cuda.synchronize()
+    t1 = time.time()
+    shutil.rmtree(work, ignore_errors=True)
+    json.dump({"cases": cases, "t_start": t0, "t_end": t1, "wall_s": t1 - t0, "procs": procs,
+               "peak_alloc_MiB": torch.cuda.max_memory_allocated() / 2**20,
+               "peak_reserved_MiB": torch.cuda.max_memory_reserved() / 2**20,
+               "cuda_visible": os.environ.get("CUDA_VISIBLE_DEVICES")}, open(timing, "w"), indent=1)
+    print("done", len(cases), t1 - t0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/hdglio58_prep.py b/hdglio58_prep.py
new file mode 100644
index 0000000..01df92d
--- /dev/null
+++ b/hdglio58_prep.py
@@ -0,0 +1,80 @@
+"""iter_058: MSD Task01 4D NIfTI -> HD-GLIO 입력(채널 분리). 원본 label은 사용하지 않는다.
+
+MSD dataset.json modality: 0 FLAIR, 1 T1w, 2 t1gd, 3 T2w
+HD-GLIO 파일 규약: _0000 T1, _0001 T1c, _0002 T2, _0003 FLAIR
+iter_056 cases.json의 case 목록/순서/split을 변경하지 않는다.
+사용: python hdglio58_prep.py [D|E|DE]
+"""
+import hashlib
+import json
+import os
+import sys
+
+import nibabel as nib
+import numpy as np
+
+SRC = "results/iter_056"
+OUT = "results/iter_058/hd"
+MSD_TO_HD = {0: 1, 1: 3, 2: 0, 3: 2}  # HD index -> MSD channel: T1<-1, T1c<-2, T2<-3, FLAIR<-0 (아래 HD_CH 참고)
+HD_CH = {"0000": 1, "0001": 2, "0002": 3, "0003": 0}  # HD suffix -> MSD channel
+MODALITY = {"0": "FLAIR", "1": "T1w", "2": "t1gd", "3": "T2w"}
+
+
+def sha256_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def prep_case(c, out_dir):
+    cid = c["case"]
+    ip = f"{SRC}/data/raw/{cid}_img.nii.gz"
+    got = sha256_file(ip)
+    assert got == c["img_sha256"], (cid, got)
+    img = nib.load(ip)
+    assert img.ndim == 4 and img.shape[3] == 4
+    assert "".join(nib.aff2axcodes(img.affine)) == "RAS"
+    assert np.allclose(img.affine, np.eye(4), atol=1e-4), (cid, img.affine)
+    data = np.asarray(img.dataobj)
+    assert np.isfinite(data).all()
+    rec = {"case": cid, "split": c["split"], "img_sha256": got, "shape": list(img.shape), "channels": {}}
+    os.makedirs(out_dir, exist_ok=True)
+    nz = []
+    for suf, ch in HD_CH.items():
+        vol = data[..., ch].astype(np.float32)
+        p = f"{out_dir}/{cid}_{suf}.nii.gz"
+        if not os.path.exists(p):
+            h = img.header.copy()
+            h.set_data_dtype(np.float32)
+            nib.save(nib.Nifti1Image(vol, img.affine, h), p + ".tmp.nii.gz")
+            os.replace(p + ".tmp.nii.gz", p)
+        nz.append(vol != 0)
+        rec["channels"][suf] = {"msd_channel": ch, "msd_name": {0: "FLAIR", 1: "T1w", 2: "t1gd", 3: "T2w"}[ch],
+                                "sha256": sha256_file(p), "nonzero_frac": float((vol != 0).mean()),
+                                "min": float(vol.min()), "max": float(vol.max())}
+    # 비뇌 영역 0 / 공통 지지 영역 일치도
+    u = np.logical_or.reduce(nz)
+    i = np.logical_and.reduce(nz)
+    rec["nonzero_union_frac"] = float(u.mean())
+    rec["nonzero_all_frac"] = float(i.mean())
+    rec["corners_zero"] = bool(all(not v[0, 0, 0] for v in nz))
+    return rec
+
+
+def main():
+    which = sys.argv[1] if len(sys.argv) > 1 else "DE"
+    cs = json.load(open(f"{SRC}/data/cases.json"))["chosen"]
+    recs = []
+    for c in cs:
+        if c["split"] in which:
+            recs.append(prep_case(c, f"{OUT}/input_{c['split']}"))
+            print(recs[-1]["case"], recs[-1]["nonzero_union_frac"], recs[-1]["nonzero_all_frac"], flush=True)
+    tag = f"prep_{which}.json"
+    json.dump({"records": recs, "mapping_note": "HD _0000 T1<-MSD ch1(T1w), _0001 T1c<-ch2(t1gd), _0002 T2<-ch3(T2w), _0003 FLAIR<-ch0",
+               "msd_modality": MODALITY}, open(f"{OUT}/{tag}", "w"), indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/hdglio58_timing.py b/hdglio58_timing.py
new file mode 100644
index 0000000..6a55b96
--- /dev/null
+++ b/hdglio58_timing.py
@@ -0,0 +1,72 @@
+"""iter_058: D6 paired 전체 pipeline 비용 측정(HD-GLIO vs U8) 및 U8 기술 검사.
+python hdglio58_timing.py u8check        # U8 D6 전체: PNG 동일성 + iter_056 답변과 대조 (GPU1)
+python hdglio58_timing.py blocks         # 3 block x 2 order, 동일 GPU 순차, block/order별 GPU 균형
+출력: results/iter_058/timing/
+"""
+import json
+import os
+import subprocess
+import sys
+import time
+
+ROOT = os.path.abspath(".")
+PYV = f"{ROOT}/results/environments/hdglio58/bin/python"
+PARAMS = f"{ROOT}/results/iter_058/external/weights/params"
+OUT = f"{ROOT}/results/iter_058/timing"
+BLOCKS = [["BRATS_053", "BRATS_199"], ["BRATS_368", "BRATS_380"], ["BRATS_037", "BRATS_455"]]
+
+
+def smi():
+    r = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used,utilization.gpu", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True)
+    return r.stdout.strip().splitlines()
+
+
+def run_u8(cases, gpu, out, check=False):
+    os.makedirs(out, exist_ok=True)
+    cj = f"{out}/cases.json"
+    json.dump(cases, open(cj, "w"))
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(gpu), U8_CHECK_PNG="1" if check else "0")
+    t = time.perf_counter()
+    r = subprocess.run([sys.executable, f"{ROOT}/hdglio58_u8.py", "D", cj, out], env=env, stdout=open(f"{out}/stdout.log", "w"),
+                       stderr=subprocess.STDOUT)
+    return {"rc": r.returncode, "wall_s": time.perf_counter() - t}
+
+
+def run_hd(cases, gpu, out):
+    os.makedirs(out, exist_ok=True)
+    cj = f"{out}/cases.json"
+    json.dump(cases, open(cj, "w"))
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(gpu), HD_GLIO_PARAMS=PARAMS, HDG_PROCS="2")
+    t = time.perf_counter()
+    r = subprocess.run([PYV, f"{ROOT}/hdglio58_pred.py", f"{ROOT}/results/iter_058/hd/input_D", f"{out}/pred", cj, f"{out}/timing.json"],
+                       env=env, stdout=open(f"{out}/stdout.log", "w"), stderr=subprocess.STDOUT)
+    return {"rc": r.returncode, "wall_s": time.perf_counter() - t}
+
+
+def u8check():
+    cases = json.load(open("results/iter_058/hd/D_cases.json"))
+    res = run_u8(cases, 1, f"{OUT}/u8check", check=True)
+    print(res)
+
+
+def blocks():
+    ev = []
+    for b, cs in enumerate(BLOCKS):
+        for o, order in enumerate((("U8", "HD"), ("HD", "U8"))):
+            gpu = (b + o) % 2
+            snap = {"smi_before": smi(), "loadavg": os.getloadavg()}
+            rec = {"block": b, "order": "->".join(order), "cases": cs, "gpu": gpu, **snap, "runs": {}}
+            for name in order:
+                d = f"{OUT}/b{b}_o{o}_{name}"
+                rec["runs"][name] = (run_u8 if name == "U8" else run_hd)(cs, gpu, d)
+                rec["runs"][name]["start_order_index"] = order.index(name)
+                rec["runs"][name]["dir"] = d
+            ev.append(rec)
+            json.dump(ev, open(f"{OUT}/blocks.json", "w"), indent=1)
+            print(rec["block"], rec["order"], {k: v["wall_s"] for k, v in rec["runs"].items()}, flush=True)
+
+
+if __name__ == "__main__":
+    os.makedirs(OUT, exist_ok=True)
+    {"u8check": u8check, "blocks": blocks}[sys.argv[1]]()
diff --git a/hdglio58_u8.py b/hdglio58_u8.py
new file mode 100644
index 0000000..f419987
--- /dev/null
+++ b/hdglio58_u8.py
@@ -0,0 +1,96 @@
+"""iter_058: U8 전체 pipeline(원본 4D NIfTI -> FLAIR 읽기·정규화·8-slice 렌더 -> processor -> 6 구간 생성 -> 저장) 비용 측정용 실행기.
+iter_056의 prompt/모델 revision/caps/렌더 함수를 그대로 사용한다(msd56_run, msd56_data import). 렌더 결과는 PNG 저장 없이 메모리 PIL로 전달하며
+iter_056 PNG와 pixel 동일성을 검사한다(--check-png).
+
+python hdglio58_u8.py SPLIT CASES.json OUT_DIR  (CUDA_VISIBLE_DEVICES는 호출자가 지정)
+출력 OUT_DIR/u8_{case}.json (case별 원자적 기록), OUT_DIR/summary.json
+"""
+import json
+import os
+import sys
+import time
+
+T_PROC_START = time.time()
+
+import numpy as np  # noqa: E402
+
+import msd56_data as D  # noqa: E402
+import msd56_run as R  # noqa: E402
+
+SRC = "results/iter_056"
+
+
+def flair_only(cid):
+    import nibabel as nib
+    img = nib.load(f"{SRC}/data/raw/{cid}_img.nii.gz")
+    can = nib.as_closest_canonical(img)
+    assert "".join(nib.aff2axcodes(can.affine)) == "RAS"
+    fl = np.asarray(can.dataobj[..., 0], dtype=np.float32)
+    if not np.isfinite(fl).all():
+        raise R.RunError(f"{cid}: non-finite FLAIR")
+    return fl
+
+
+def main():
+    split, case_json, out = sys.argv[1:4]
+    cases = json.load(open(case_json))
+    os.makedirs(out, exist_ok=True)
+    check_png = os.environ.get("U8_CHECK_PNG") == "1"
+    from PIL import Image
+    t = time.time()
+    torch, proc, model = R.load_model()
+    eos = set(model.generation_config.eos_token_id if isinstance(model.generation_config.eos_token_id, list) else [model.generation_config.eos_token_id])
+    torch.cuda.synchronize()
+    t_load = time.time() - t
+    meta = {c["case"]: c for c in json.load(open(f"{SRC}/data/cases.json"))["chosen"]}
+    summ = {"split": split, "cases": cases, "t_import_s": t - T_PROC_START, "t_load_model_s": t_load, "per_case": {}}
+    for cid in cases:
+        tc0 = time.time()
+        fl = flair_only(cid)
+        z0, z1 = D.nonzero_range(fl)
+        slabs = D.make_slabs(z0, z1)
+        ref = meta[cid]
+        assert slabs == ref["slabs"] and float(fl.min()) == ref["vmin"] and float(fl.max()) == ref["vmax"], f"{cid}: slab/range mismatch vs iter_056"
+        rows = []
+        for si, (a, b) in enumerate(slabs):
+            zs = [a + i for i in D.equi(b - a + 1, 8)]
+            imgs = [Image.fromarray(D.render(fl, k, ref["vmin"], ref["vmax"])) for k in zs]
+            if check_png:
+                for k, im in zip(zs, imgs):
+                    p = np.asarray(Image.open(f"{SRC}/data/png/{cid}_z{k:03d}.png").convert("RGB"))
+                    assert np.array_equal(p, np.asarray(im)), f"{cid} z{k}: render != iter_056 png"
+            rows.append((si, zs, imgs))
+        t_prep = time.time() - tc0
+        res, t_gen, t_proc = [], 0.0, 0.0
+        for si, zs, imgs in rows:
+            tp = time.time()
+            content = [{"type": "image", "image": im} for im in imgs] + [{"type": "text", "text": R.PROMPT}]
+            inp = proc.apply_chat_template([{"role": "user", "content": content}], add_generation_prompt=True, tokenize=True,
+                                           return_dict=True, return_tensors="pt")
+            t_proc += time.time() - tp
+            attempts = []
+            for cap in R.CAPS:
+                at = R.generate(torch, model, inp, cap, eos)
+                attempts.append(at)
+                if at["ended_eos"]:
+                    break
+            txt = proc.tokenizer.decode(attempts[-1]["suffix_ids"], skip_special_tokens=False)
+            t_gen += sum(a_["runtime_s"] for a_ in attempts)
+            res.append({"slab": si, "slices": zs, "answer": R.parse_answer(txt), "raw": txt, "ended_eos": attempts[-1]["ended_eos"],
+                        "n_attempts": len(attempts)})
+        rec = {"case": cid, "t_case_s": time.time() - tc0, "t_read_prep_s": t_prep, "t_processor_s": t_proc, "t_generate_s": t_gen,
+               "answers": res, "t_start": tc0, "t_end": time.time()}
+        tmp = f"{out}/u8_{cid}.json.tmp"
+        json.dump(rec, open(tmp, "w"), indent=1)
+        os.replace(tmp, f"{out}/u8_{cid}.json")
+        summ["per_case"][cid] = {k: rec[k] for k in ("t_case_s", "t_read_prep_s", "t_processor_s", "t_generate_s")}
+        print(cid, round(rec["t_case_s"], 2), flush=True)
+    summ["t_total_s"] = time.time() - T_PROC_START
+    summ["peak_alloc_MiB"] = torch.cuda.max_memory_allocated() / 2**20
+    summ["peak_reserved_MiB"] = torch.cuda.max_memory_reserved() / 2**20
+    summ["cuda_visible"] = os.environ.get("CUDA_VISIBLE_DEVICES")
+    json.dump(summ, open(f"{out}/summary.json", "w"), indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/hdglio58_verify.py b/hdglio58_verify.py
new file mode 100644
index 0000000..969a5e0
--- /dev/null
+++ b/hdglio58_verify.py
@@ -0,0 +1,60 @@
+"""iter_058: E 수치 독립 재계산(평가 모듈 비사용). per_row_E.json(iter_057, U8 답변)과 per_slab_hd.json(HD-GLIO)만 읽고,
+GT는 raw NIfTI label에서 직접 구간 present를 재계산한다. 쓰기는 results/iter_058/eval_E/verify.json.
+"""
+import json
+
+import nibabel as nib
+import numpy as np
+
+E = "results/iter_058/eval_E"
+gt_rows = {(g["case"], g["slab"]): g for g in json.load(open("results/iter_056/data/gt_slabs.json"))["rows"] if g["split"] == "E"}
+u8 = {(r["case"], r["slab"]): r["answer"] for r in json.load(open("results/iter_057/analysis/per_row_E.json")) if r["cond"] == "U8"}
+hd = {(r["case"], r["slab"]): r["answer"] for r in json.load(open(f"{E}/per_slab_hd.json"))}
+cases = sorted({k[0] for k in gt_rows})
+assert len(gt_rows) == len(u8) == len(hd) == 288 and len(cases) == 48
+truth = {}
+for cid in cases:
+    lbl = np.asarray(nib.load(f"results/iter_056/data/raw/{cid}_lbl.nii.gz").dataobj) > 0
+    for s in range(6):
+        g = gt_rows[(cid, s)]
+        truth[(cid, s)] = bool(lbl[:, :, g["z0"]:g["z1"] + 1].any())
+assert all(truth[k] == gt_rows[k]["present"] for k in truth)
+
+
+def tab(pred):
+    arr = np.zeros((len(cases), 4))  # TP, P, TN, N
+    for i, c in enumerate(cases):
+        for s in range(6):
+            t, a = truth[(c, s)], pred[(c, s)]
+            arr[i, 1 if t else 3] += 1
+            arr[i, 0 if t else 2] += (a == "PRESENT") if t else (a == "ABSENT")
+    return arr
+
+
+def ba(a):
+    s = a.sum(0)
+    return ((s[0] / s[1]) + (s[2] / s[3])) / 2
+
+
+def sn(a):
+    s = a.sum(0)
+    return s[0] / s[1]
+
+
+a_h, a_u = tab(hd), tab(u8)
+rng = np.random.default_rng(1058)  # 평가 모듈과 다른 seed/구현: 값이 근사 일치하는지만 확인
+d, ds = [], []
+for _ in range(10000):
+    ix = rng.integers(0, 48, 48)
+    d.append(ba(a_h[ix]) - ba(a_u[ix]))
+    ds.append(sn(a_h[ix]) - sn(a_u[ix]))
+rep = {"BA_HD": ba(a_h), "BA_U8": ba(a_u), "diff": ba(a_h) - ba(a_u), "sens_HD": sn(a_h), "sens_U8": sn(a_u),
+       "ci_diff_BA_indep_seed1058": [float(np.percentile(d, 2.5)), float(np.percentile(d, 97.5))],
+       "ci_diff_sens_indep_seed1058": [float(np.percentile(ds, 2.5)), float(np.percentile(ds, 97.5))],
+       "gt_vs_raw_label_mismatch": 0}
+main = json.load(open(f"{E}/report.json"))
+rep["matches_report"] = {"BA_HD": bool(abs(rep["BA_HD"] - main["point"]["HD"]["BA_all"]) < 1e-12),
+                         "BA_U8": bool(abs(rep["BA_U8"] - main["point"]["U8"]["BA_all"]) < 1e-12)}
+assert all(rep["matches_report"].values())
+json.dump(rep, open(f"{E}/verify.json", "w"), indent=1)
+print(json.dumps(rep, indent=1))
diff --git a/test_hdglio58.py b/test_hdglio58.py
new file mode 100644
index 0000000..3498956
--- /dev/null
+++ b/test_hdglio58.py
@@ -0,0 +1,103 @@
+"""iter_058 회귀·변조 fixture. python test_hdglio58.py  -> results/iter_058/tests/fixtures.json
+임시 디렉터리에 합성 입력/출력을 만들어 평가 경로가 변조를 거부하는지 검사한다(실제 결과 파일은 수정하지 않는다).
+"""
+import json
+import os
+import shutil
+import tempfile
+
+import nibabel as nib
+import numpy as np
+
+import hdglio58_eval as E
+
+OUT = "results/iter_058/tests"
+res = []
+
+
+def check(name, fn, expect_raise=None):
+    try:
+        fn()
+        ok = expect_raise is None
+        msg = "no raise"
+    except Exception as e:  # noqa: BLE001
+        ok = expect_raise is not None and expect_raise in str(e)
+        msg = f"{type(e).__name__}: {e}"
+    res.append({"name": name, "pass": bool(ok), "detail": msg[:200]})
+    print("PASS" if ok else "FAIL", name, "|", msg[:100])
+
+
+def make_tree(root, cases, rc=0):
+    """root/hd/{input_X,run_T/g0w0/pred} 합성. 입력 grid 4x4x4."""
+    run = f"{root}/run_T"
+    for c in cases:
+        os.makedirs(f"{root}/input_X", exist_ok=True)
+        for s in ("0000", "0001", "0002", "0003"):
+            nib.save(nib.Nifti1Image(np.ones((4, 4, 4), np.float32), np.eye(4)), f"{root}/input_X/{c}_{s}.nii.gz")
+        os.makedirs(f"{run}/g0w0/pred", exist_ok=True)
+        p = np.zeros((4, 4, 4), np.uint8)
+        p[1:3, 1:3, 1:3] = 1
+        nib.save(nib.Nifti1Image(p, np.eye(4)), f"{run}/g0w0/pred/{c}.nii.gz")
+    json.dump(cases, open(f"{root}/X_cases.json", "w"))
+    json.dump({"rc": {"g0w0": rc}}, open(f"{run}/launch.json", "w"))
+    man = {c: {"pred_sha256": E.sha_file(f"{run}/g0w0/pred/{c}.nii.gz"),
+               "input_sha256": {s: E.sha_file(f"{root}/input_X/{c}_{s}.nii.gz") for s in ("0000", "0001", "0002", "0003")}} for c in cases}
+    json.dump(man, open(f"{run}/pred_manifest.json", "w"))
+    return run
+
+
+def main():
