+        os.remove(f"{tmp}/run_T/g0w0/pred/BRATS_B.nii.gz")
+        check("missing_pred_rejected", lambda: E.collect_pred("X", "T"), "mismatch")
+        # 실패 worker
+        shutil.rmtree(tmp)
