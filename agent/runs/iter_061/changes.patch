@@ -0,0 +1,461 @@
+"""iter_056 MSD FLAIR 구간 생성 runner (MedGemma 1.5, 다중 영상). GT를 읽지 않는다.
+
+서브명령
+  build-requests --split D|E --out R [--cond-map M]   (GT 접근: O8 준비용. worker는 GT를 읽지 않는다)
+  lock --requests R --out P                            (코드·prompt·config·요청 digest 잠금)
+  worker --requests R --protocol P --out-dir D --worker K
+  launch --requests R --protocol P --out-dir D --gpus 0,1,0,1 [--peak-gb G]
+  verify --requests R --protocol P --out-dir D          (완료 검증)
+
+재사용(제한): rsna_diag/generate.py의 고정 revision 로딩·env 기록·greedy 생성 패턴(pg43_run의 flock claim/record 패턴).
+ 다중 영상 경로, 요청 완전성, 자식 종료 상태, attempt별 비용은 이 파일에서 새로 구현했다.
+"""
+import argparse
+import fcntl
+import glob
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+
+MODEL_ID = "google/medgemma-1.5-4b-it"
+MODEL_REVISION = "91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b"
+HF_HOME = "/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache"
+CAPS = [512, 2048]
+RUNNER = "msd56_run_v1"
+PROMPT = ("The images are consecutive-or-sampled axial slices of a brain MRI (FLAIR sequence), ordered from inferior to superior. "
+          "Is a glioma-related lesion, including peritumoral edema, visible in the presented axial FLAIR slices? "
+          "Answer with exactly one word: PRESENT or ABSENT.")
+CODE_FILES = ["msd56_run.py", "msd56_data.py"]
+DATA = "results/iter_056/data"
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def canon(o):
+    return json.dumps(o, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def parse_answer(text):
+    """whole-string: 대소문자·주변 공백·끝 punctuation만 정규화. 'PRESENT'/'ABSENT' 외에는 invalid(None)."""
+    t = re.sub(r"[\s]+$|^[\s]+", "", text.replace("<end_of_turn>", "").strip())
+    t = re.sub(r"[\s.!?,;:]+$", "", t).strip().upper()
+    return t if t in ("PRESENT", "ABSENT") else None
+
+
+class RunError(RuntimeError):
+    pass
+
+
+def read_jsonl(path):
+    """완전한 행(개행으로 끝난 행)만 읽는다. 개행 없는 꼬리(비정상 종료의 torn row)는 소유 worker가 시작할 때 repair_tail로 보존·제거한다."""
+    out = []
+    if os.path.exists(path):
+        with open(path) as f:
+            for ln in f:
+                if ln.endswith("\n") and ln.strip():
+                    out.append(json.loads(ln))
+    return out
+
+
+def repair_tail(path):
+    """부분 행(개행 없이 끝난 꼬리)을 별도 파일로 보존하고 잘라낸다."""
+    if not os.path.exists(path):
+        return
+    b = open(path, "rb").read()
+    if not b or b.endswith(b"\n"):
+        return
+    cut = b.rfind(b"\n") + 1
+    open(f"{path}.partial.{int(time.time())}.bin", "wb").write(b[cut:])
+    with open(path, "r+b") as f:
+        f.truncate(cut)
+
+
+_PX_CACHE = {}
+
+
+def image_pixel_sha(paths):
+    """디코드 pixel hash. 프로세스 내 캐시(입력 파일 hash는 load_requests가 시작 시 이미 검증) — 재검증 O(n^2) 방지."""
+    key = tuple(paths)
+    if key not in _PX_CACHE:
+        import numpy as np
+        from PIL import Image
+        h = hashlib.sha256()
+        for p in paths:
+            h.update(np.asarray(Image.open(p).convert("RGB")).tobytes())
+        _PX_CACHE[key] = h.hexdigest()
+    return _PX_CACHE[key]
+
+
+# ---------------- requests ----------------
+def make_rid(images_sha, modality):
+    return sha(canon({"model_revision": MODEL_REVISION, "prompt": sha(PROMPT.encode()), "images": images_sha,
+                      "modality": modality, "runner": RUNNER}).encode())[:32]
+
+
+def cmd_build_requests(a):
+    gt = json.load(open(f"{DATA}/gt_slabs.json"))["rows"]
+    png_sha = json.load(open(f"{DATA}/png_sha256.json"))
+    rows, cmap = {}, []
+    for r in gt:
+        if r["split"] != a.split:
+            continue
+        for cn, c in r["cond"].items():
+            paths = [f"{DATA}/png/{r['case']}_z{k:03d}.png" for k in c["slices"]]
+            ish = [png_sha[p] for p in paths]
+            rid = make_rid(ish, "image")
+            rows.setdefault(rid, {"rid": rid, "modality": "image", "images": paths, "image_file_sha256": ish,
+                                  "prompt": PROMPT, "split": a.split})
+            cmap.append({"case": r["case"], "slab": r["slab"], "cond": cn, "rid": rid})
+    trid = make_rid([], "text")
+    rows[trid] = {"rid": trid, "modality": "text", "images": [], "image_file_sha256": [], "prompt": PROMPT, "split": "ALL"}
+    for r in gt:
+        if r["split"] == a.split:
+            cmap.append({"case": r["case"], "slab": r["slab"], "cond": "TEXT", "rid": trid})
+    ordered = sorted(rows.values(), key=lambda x: x["rid"])
+    with open(a.out, "w") as f:
+        for x in ordered:
+            f.write(json.dumps(x) + "\n")
+    json.dump(cmap, open(a.cond_map, "w"), indent=0)
+    print(f"{a.split}: unique requests {len(ordered)} (cond rows {len(cmap)})")
+
+
+def load_requests(path):
+    rows = [json.loads(ln) for ln in open(path) if ln.strip()]
+    if len({r["rid"] for r in rows}) != len(rows):
+        raise RunError("duplicate rid in requests")
+    for r in rows:
+        if r["rid"] != make_rid(r["image_file_sha256"], r["modality"]) or r["prompt"] != PROMPT:
+            raise RunError(f"rid/prompt mismatch {r['rid']}")
+        if r["modality"] == "image" and len(r["images"]) != len(r["image_file_sha256"]):
+            raise RunError("images/sha length mismatch")
+        for p, h in zip(r["images"], r["image_file_sha256"]):
+            if sha(open(p, "rb").read()) != h:
+                raise RunError(f"image changed on disk: {p}")
+    return rows
+
+
+# ---------------- protocol ----------------
+def file_digests(files):
+    return {f: sha(open(f, "rb").read()) for f in files}
+
+
+def cmd_lock(a):
+    rows = load_requests(a.requests)
+    extra = [x for x in (a.extra or "").split(",") if x]
+    prot = {"runner": RUNNER, "model_id": MODEL_ID, "model_revision": MODEL_REVISION, "caps": CAPS,
+            "prompt_sha256": sha(PROMPT.encode()), "requests_file": a.requests,
+            "requests_sha256": sha(open(a.requests, "rb").read()), "n_requests": len(rows),
+            "code": file_digests(CODE_FILES + extra), "locked_at": time.strftime("%Y-%m-%dT%H:%M:%S")}
+    if os.path.exists(a.out):
+        raise RunError(f"{a.out} exists; refusing to overwrite")
+    open(a.out, "w").write(json.dumps(prot, indent=1))
+    print("locked", a.out)
+
+
+def verify_protocol(path, requests):
+    p = json.load(open(path))
+    for f, d in p["code"].items():
+        if sha(open(f, "rb").read()) != d:
+            raise RunError(f"code digest changed: {f}")
+    if sha(open(requests, "rb").read()) != p["requests_sha256"] or p["requests_file"] != requests:
+        raise RunError("requests digest mismatch")
+    if p["prompt_sha256"] != sha(PROMPT.encode()) or p["model_revision"] != MODEL_REVISION or p["caps"] != CAPS:
+        raise RunError("prompt/model/caps mismatch")
+    return sha(open(path, "rb").read()), p
+
+
+# ---------------- model ----------------
+def load_model():
+    os.environ.setdefault("HF_HOME", HF_HOME)
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    import torch
+    import transformers
+    torch.manual_seed(0)
+    proc = transformers.AutoProcessor.from_pretrained(MODEL_ID, revision=MODEL_REVISION)
+    model = transformers.AutoModelForImageTextToText.from_pretrained(
+        MODEL_ID, revision=MODEL_REVISION, dtype=torch.bfloat16, device_map="cuda")
+    model.eval()
+    return torch, proc, model
+
+
+def env_info(torch, proc, model):
+    import transformers
+    import PIL
+    gc = model.generation_config
+    return {"model_id": MODEL_ID, "model_revision": MODEL_REVISION, "transformers": transformers.__version__,
+            "torch": torch.__version__, "PIL": PIL.__version__, "dtype": str(model.dtype),
+            "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"), "gpu_name": torch.cuda.get_device_name(0),
+            "gpu_uuid": str(torch.cuda.get_device_properties(0).uuid), "eos_token_id": gc.eos_token_id,
+            "generation_config": gc.to_dict(), "chat_template_sha256": sha((proc.chat_template or "").encode()),
+            "image_seq_length": getattr(proc, "image_seq_length", None),
+            "attn_implementation": getattr(model.config.text_config, "_attn_implementation", None), "runner": RUNNER}
+
+
+def build_inputs(proc, row):
+    from PIL import Image
+    content = [{"type": "image", "image": Image.open(p).convert("RGB")} for p in row["images"]]
+    content.append({"type": "text", "text": row["prompt"]})
+    msgs = [{"role": "user", "content": content}]
+    return proc.apply_chat_template(msgs, add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors="pt")
+
+
+def generate(torch, model, inp, cap, eos_ids):
+    x = {k: (v.to("cuda", dtype=torch.bfloat16) if k == "pixel_values" else v.to("cuda")) for k, v in inp.items()}
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    t0 = time.time()
+    with torch.no_grad():
+        out = model.generate(**x, max_new_tokens=cap, do_sample=False)
+    torch.cuda.synchronize()
+    dt = time.time() - t0
+    ids = out[0, x["input_ids"].shape[1]:].tolist()
+    ended = len(ids) > 0 and ids[-1] in eos_ids
+    return {"cap": cap, "suffix_ids": ids, "n_new": len(ids), "ended_eos": bool(ended), "runtime_s": dt,
+            "t_start": t0, "t_end": t0 + dt,
+            "peak_mem_alloc_gb": torch.cuda.max_memory_allocated() / 2**30,
+            "peak_mem_reserved_gb": torch.cuda.max_memory_reserved() / 2**30}
+
+
+def run_request(torch, proc, model, eos_ids, row):
+    inp = build_inputs(proc, row)
+    ids_in = inp["input_ids"][0].tolist()
+    img_tok = model.config.image_token_index
+    n_img_tok = sum(1 for t in ids_in if t == img_tok)
+    if row["modality"] == "text" and ("pixel_values" in inp or n_img_tok):
+        raise RunError("text request has image inputs")
+    if row["modality"] == "image":
+        want = len(row["images"]) * (getattr(proc, "image_seq_length", 256))
+        if inp["pixel_values"].shape[0] != len(row["images"]) or n_img_tok != want:
+            raise RunError(f"image count/token mismatch: pv={tuple(inp['pixel_values'].shape)} tok={n_img_tok} want={want}")
+    attempts = []
+    for cap in CAPS:
+        at = generate(torch, model, inp, cap, eos_ids)
+        attempts.append(at)
+        if at["ended_eos"]:
+            break
+    fin = attempts[-1]
+    for at in attempts:
+        at["suffix_text_raw"] = proc.tokenizer.decode(at["suffix_ids"], skip_special_tokens=False)
+    text = fin["suffix_text_raw"]
+    return {"rid": row["rid"], "modality": row["modality"], "n_images": len(row["images"]),
+            "n_input_tokens": len(ids_in), "n_image_tokens": n_img_tok,
+            "input_ids_sha256": sha(json.dumps(ids_in).encode()),
+            "pixel_values_shape": list(inp["pixel_values"].shape) if "pixel_values" in inp else None,
+            "input_pixel_sha256": image_pixel_sha(row["images"]) if row["images"] else None,
+            "image_file_sha256": row["image_file_sha256"], "suffix_ids": fin["suffix_ids"], "suffix_text_raw": text,
+            "answer": parse_answer(text), "ended_eos": fin["ended_eos"], "final_cap": fin["cap"],
+            "attempts": [{k: v for k, v in at.items() if k != "suffix_ids"} for at in attempts],
+            "runtime_s_total": sum(at["runtime_s"] for at in attempts),
+            "peak_mem_alloc_gb_max": max(at["peak_mem_alloc_gb"] for at in attempts),
+            "peak_mem_reserved_gb_max": max(at["peak_mem_reserved_gb"] for at in attempts)}
+
+
+def validate_existing(out_dir, rows, pdig):
+    by = {r["rid"]: r for r in rows}
+    seen = {}
+    for fn in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        for r in read_jsonl(fn):
+            q = by.get(r.get("rid"))
+            if q is None:
+                raise RunError(f"unexpected record {r.get('rid')} in {fn}")
+            if r["rid"] in seen:
+                raise RunError(f"duplicate record {r['rid']}: {seen[r['rid']]} and {fn}")
+            seen[r["rid"]] = fn
+            if r.get("protocol_digest") != pdig:
+                raise RunError(f"protocol digest mismatch in {fn}")
+            if r.get("image_file_sha256") != q["image_file_sha256"] or r.get("modality") != q["modality"]:
+                raise RunError(f"record/request mismatch {r['rid']}")
+            if q["images"] and r.get("input_pixel_sha256") != image_pixel_sha(q["images"]):
+                raise RunError(f"input pixels changed since record {r['rid']}")
+    return seen
+
+
+class FileLock:
+    def __init__(self, path):
+        self.path, self.f = path, None
+
+    def try_acquire(self):
+        self.f = open(self.path, "a+")
+        try:
+            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            return True
+        except OSError:
+            self.f.close()
+            self.f = None
+            return False
+
+    def release(self):
+        if self.f:
+            fcntl.flock(self.f, fcntl.LOCK_UN)
+            self.f.close()
+
+
+def cmd_worker(a):
+    rows = load_requests(a.requests)
+    pdig, _ = verify_protocol(a.protocol, a.requests)
+    os.makedirs(a.out_dir, exist_ok=True)
+    wl = FileLock(os.path.join(a.out_dir, f"worker{a.worker}.lock"))
+    if not wl.try_acquire():
+        sys.exit(f"worker {a.worker} already running")
+    out = os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl")
+    repair_tail(out)
+    t_load0 = time.time()
+    torch, proc, model = load_model()
+    t_load = time.time() - t_load0
+    env = env_info(torch, proc, model)
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    envp = os.path.join(a.out_dir, f"worker{a.worker}.env.json")
+    attempt_id = f"{int(time.time())}"
+    with open(envp, "a") as f:
+        f.write(json.dumps({"attempt": attempt_id, "env": env, "load_s": t_load, "t_loaded": time.time(), "pid": os.getpid()}) + "\n")
+    validate_existing(a.out_dir, rows, pdig)
+    cdir = os.path.join(a.out_dir, "claims")
+    os.makedirs(cdir, exist_ok=True)
+    log = open(out + ".log", "a")
+    n_new, t0 = 0, time.time()
+    # 긴 요청(DENSE)을 먼저 배정하지 않는다: rid 정렬 순서 유지
+    for row in rows:
+        if a.max_requests is not None and n_new >= a.max_requests:
+            break
+        cl = FileLock(os.path.join(cdir, row["rid"] + ".claim"))
+        if not cl.try_acquire():
+            continue
+        try:
+            done = validate_existing(a.out_dir, rows, pdig)
+            if row["rid"] in done:
+                continue
+            try:
+                rec = run_request(torch, proc, model, eos_ids, row)
+            except torch.cuda.OutOfMemoryError as e:
+                log.write(json.dumps({"event": "oom", "rid": row["rid"], "n_images": len(row["images"]), "err": str(e)[:200]}) + "\n")
+                log.flush()
+                raise
+            rec.update({"protocol_digest": pdig, "worker": a.worker, "attempt_id": attempt_id, "ts": time.time(),
+                        "gpu_uuid": env["gpu_uuid"]})
+            with open(out, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            n_new += 1
+            log.write(json.dumps({"event": "done", "rid": row["rid"], "n_images": rec["n_images"], "n_out": len(rec["suffix_ids"]),
+                                  "ans": rec["answer"], "eos": rec["ended_eos"], "s": round(rec["runtime_s_total"], 2),
+                                  "peak_gb": round(rec["peak_mem_alloc_gb_max"], 2), "elapsed": round(time.time() - t0, 1)}) + "\n")
+            log.flush()
+        finally:
+            cl.release()
+    json.dump({"worker": a.worker, "attempt": attempt_id, "n_new": n_new, "load_s": t_load, "elapsed_s": time.time() - t0},
+              open(os.path.join(a.out_dir, f"worker{a.worker}.attempt_{attempt_id}.done.json"), "w"))
+    print(f"worker {a.worker}: {n_new} new", flush=True)
+
+
+def gpu_free_mib():
+    o = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used,memory.total", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True, check=True).stdout
+    return {int(l.split(",")[0]): int(l.split(",")[2]) - int(l.split(",")[1]) for l in o.strip().splitlines()}
+
+
+def cmd_launch(a):
+    rows = load_requests(a.requests)
+    verify_protocol(a.protocol, a.requests)
+    gpus = [int(x) for x in a.gpus.split(",")]
+    allowed = {int(x) for x in os.environ.get("CUDA_VISIBLE_DEVICES", "0,1").split(",")}
+    if not set(gpus) <= allowed:
+        sys.exit(f"gpus {gpus} not in allowed {allowed}")
+    free = gpu_free_mib()
+    need = {}
+    for g in gpus:
+        need[g] = need.get(g, 0) + (a.peak_gb + 2.0) * 1024
+    for g, n in need.items():
+        if n > free[g]:
+            sys.exit(f"GPU {g}: need {n:.0f} MiB (peak {a.peak_gb} GB + 2GiB per worker) > free {free[g]} MiB")
+    os.makedirs(a.out_dir, exist_ok=True)
+    ll = FileLock(os.path.join(a.out_dir, "launch.lock"))
+    if not ll.try_acquire():
+        sys.exit("launcher already running")
+    t0 = time.time()
+    procs = []
+    for k, g in enumerate(gpus):
+        env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(g))
+        cmd = [sys.executable, "msd56_run.py", "worker", "--requests", a.requests, "--protocol", a.protocol,
+               "--out-dir", a.out_dir, "--worker", str(k + a.worker_offset)]
+        if a.max_requests is not None:
+            cmd += ["--max-requests", str(a.max_requests)]
+        lg = open(os.path.join(a.out_dir, f"worker{k + a.worker_offset}.stdout.log"), "a")
+        procs.append((k + a.worker_offset, g, subprocess.Popen(cmd, env=env, stdout=lg, stderr=subprocess.STDOUT)))
+    samples = []
+    while any(p.poll() is None for _, _, p in procs):
+        time.sleep(5)
+        try:
+            o = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used", "--format=csv,noheader,nounits"],
+                               capture_output=True, text=True).stdout
+            samples.append({"t": time.time(), "used_mib": {int(l.split(",")[0]): int(l.split(",")[1]) for l in o.strip().splitlines()}})
+        except Exception:
+            pass
+    rcs = {k: p.returncode for k, _, p in procs}
+    peak = {}
+    for s in samples:
+        for g, u in s["used_mib"].items():
+            peak[g] = max(peak.get(g, 0), u)
+    comp = {"gpus": gpus, "worker_exit_codes": rcs, "wall_s": time.time() - t0, "t_start": t0, "t_end": time.time(),
+            "peak_gpu_used_mib_sampled": peak, "n_samples": len(samples), "peak_gb_assumed": a.peak_gb}
+    name = f"launch_{int(t0)}.json"
+    json.dump(comp, open(os.path.join(a.out_dir, name), "w"), indent=1)
+    ll.release()
+    print(comp)
+    if any(rc != 0 for rc in rcs.values()):
+        sys.exit(1)
+
+
+def cmd_verify(a):
+    rows = load_requests(a.requests)
+    pdig, _ = verify_protocol(a.protocol, a.requests)
+    seen = validate_existing(a.out_dir, rows, pdig)
+    miss = [r["rid"] for r in rows if r["rid"] not in seen]
+    launches = sorted(glob.glob(os.path.join(a.out_dir, "launch_*.json")))
+    bad = [(f, json.load(open(f))["worker_exit_codes"]) for f in launches
+           if any(rc != 0 for rc in json.load(open(f))["worker_exit_codes"].values())]
+    res = {"n_requests": len(rows), "n_records": len(seen), "missing": miss, "launches": launches, "bad_exit_launches": bad,
+           "ok": not miss and len(seen) == len(rows)}
+    print(json.dumps({k: (v if k != "missing" else len(v)) for k, v in res.items()}))
+    if not res["ok"]:
+        sys.exit(1)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    b = sp.add_parser("build-requests")
+    b.add_argument("--split", required=True)
+    b.add_argument("--out", required=True)
+    b.add_argument("--cond-map", required=True)
+    lk = sp.add_parser("lock")
+    lk.add_argument("--requests", required=True)
+    lk.add_argument("--out", required=True)
+    lk.add_argument("--extra", default="")
+    for n in ("worker", "launch", "verify"):
+        s = sp.add_parser(n)
+        s.add_argument("--requests", required=True)
+        s.add_argument("--protocol", required=True)
+        s.add_argument("--out-dir", required=True)
+        if n == "worker":
+            s.add_argument("--worker", type=int, required=True)
+            s.add_argument("--max-requests", type=int, default=None)
+        if n == "launch":
+            s.add_argument("--gpus", required=True)
+            s.add_argument("--peak-gb", type=float, default=14.0)
+            s.add_argument("--worker-offset", type=int, default=0)
+            s.add_argument("--max-requests", type=int, default=None)
+    a = ap.parse_args()
+    {"build-requests": cmd_build_requests, "lock": cmd_lock, "worker": cmd_worker, "launch": cmd_launch,
+     "verify": cmd_verify}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
