index 0000000..cfac12b
--- /dev/null
+++ b/ed116_analyze.py
@@ -0,0 +1,90 @@
+"""iter_116 본 분석: 검증된 MAIN completion → 환자별 표, 그룹별 report, 사전 투자 분기. 결과는 새 경로에만 쓴다 ('x' 모드).
+사용: python ed116_analyze.py --gen results/iter_116/gen/MAIN --requests ... --protocol ... --out results/iter_116/eval
+"""
+import argparse
+import json
+import os
+import sys
+
+import ed116_eval as EV
+import ed116_spec as ES
+import ev109_extract as X
+import pg43_run as RUN
+
+PROV = "results/iter_116/provenance"
+LOCKDIR = "results/iter_116/lock"
+
+
+def load_inputs():
+    rows = json.load(open(f"{PROV}/ledger_nogt.json"))["rows"]
+    gt = json.load(open(f"{PROV}/gt.json"))
+    sel = json.load(open(f"{LOCKDIR}/selection.json"))
+    return {r["id"]: r for r in rows}, gt, sel
+
+
+def model_answers(recs):
+    """records → {patient: {cond: (answer|None, resolve dict, record)}}"""
+    out = {}
+    for r in recs:
+        res = X.resolve("O", r["suffix_text_raw"], r["ended_eos"])
+        out.setdefault(r["patient"], {})[r["cond"]] = (res["answer"], res, r)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--gen", required=True)
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    lock = json.load(open(f"{LOCKDIR}/eval_lock.json"))
+    bad = [f for f, h in lock["files"].items() if RUN.file_sha(f) != h]
+    if bad:
+        sys.exit(f"평가 잠금 파일이 변경됨: {bad}")
+    recs = RUN.verify_completion(a.gen, a.requests, a.protocol)  # 요청 집합·record digest·영상 hash·보호 필드 재검증
+    byid, gt, sel = load_inputs()
+    ma = model_answers(recs)
+    groups = {"mismatch": sel["mismatch"], "control": sel["control"]}
+    for g, ids in groups.items():
+        for i in ids:
+            if set(ma.get(i, {})) != set(ES.COND_ORDER):
+                sys.exit(f"조건 누락: {g} {i}")
+    if set(ma) != set(sel["mismatch"]) | set(sel["control"]):
+        sys.exit("분석 대상 외 환자 record가 있다")
+    patients, per_patient = {}, []
+    for g, ids in groups.items():
+        patients[g] = []
+        for i in ids:
+            p = EV.make_patient(byid[i], gt[i], {c: ma[i][c][0] for c in ES.COND_ORDER})
+            patients[g].append(p)
+            pt = EV.point_scalars(p)
+            per_patient.append(dict(id=i, group=g, category=p["cat"], gt=p["y"], answers=p["base"],
+                                    correct={q: p["base"][q] == p["y"] for q in EV.POL},
+                                    resolve={c: dict(source=ma[i][c][1]["source"], reason=ma[i][c][1]["reason"], rule=ma[i][c][1]["rule"]) for c in ES.COND_ORDER},
+                                    raw={c: ma[i][c][2]["suffix_text_raw"] for c in ES.COND_ORDER},
+                                    ended_eos={c: ma[i][c][2]["ended_eos"] for c in ES.COND_ORDER},
+                                    joint03={q: pt[f"joint03_{q}"] for q in EV.JOINT_POL}, n_det=p["n_det"], n_gt=p["n_gt"],
+                                    tp03=p["tp03"], request_ids={c: ma[i][c][2]["request_id"] for c in ES.COND_ORDER}))
+    rep_mm = EV.group_report(patients["mismatch"])
+    rep_ag = EV.group_report(patients["control"])
+    dec = EV.decide(rep_mm, rep_ag)
+    fmt = {}
+    for g, ids in groups.items():
+        fmt[g] = EV.format_report({c: [ma[i][c][2] for i in ids] for c in ES.COND_ORDER})
+    comp = json.load(open(os.path.join(a.gen, "completion.json")))
+    unresolved = [dict(id=i, raw=byid[i]["O"]["raw"], request_id=byid[i]["O"]["request_id"]) for i in sel["unresolved"]]
+    report = dict(spec_version=ES.SPEC_VERSION, eval_lock_sha256=RUN.file_sha(f"{LOCKDIR}/eval_lock.json"), protocol_sha256=RUN.file_sha(a.protocol),
+                  requests_sha256=RUN.file_sha(a.requests), n_records=len(recs), mismatch=rep_mm, control=rep_ag, decision=dec, format=fmt,
+                  cost=comp["cost"], cost_this_attempt=comp.get("cost_this_attempt"), wall_s=comp["wall_s"], workers=comp["workers"],
+                  mapping=comp["mapping"], unresolved_excluded_E600_K=unresolved,
+                  note="불일치 87명은 K/B 중 하나가 맞는 구조로 선정한 집단이다. 자연 모집단 오류율·실용 이득으로 외삽하지 않는다.")
+    os.makedirs(a.out, exist_ok=True)
+    for name, obj in (("report.json", report), ("per_patient.json", per_patient)):
+        with open(os.path.join(a.out, name), "x") as f:
+            json.dump(obj, f, indent=1, sort_keys=True)
+    print(json.dumps(dict(label=dec["label"], point=dec["point"], worst=dec["worst"]), indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ed116_baselines.py b/ed116_baselines.py
new file mode 100644
index 0000000..ef93124
--- /dev/null
+++ b/ed116_baselines.py
@@ -0,0 +1,38 @@
+"""iter_116 생성 없는 단순 대조(K/B/G/M) 기술. 잠금된 ed116_eval/ed116_spec를 그대로 사용한다 (N/E/R/T/S는 MAIN 생성이 있어야 계산 가능).
+사용: python ed116_baselines.py <출력 json> ('x' 모드)"""
+import json
+import os
+import sys
+
+import ed116_eval as EV
+
+PROV = "results/iter_116/provenance"
+POL = ("K", "B", "G", "M")
+CATS = ("opacity", "normal", "not_normal_no_opacity")
+
+
+def main(out):
+    rows = dict((r["id"], r) for r in json.load(open(f"{PROV}/ledger_nogt.json"))["rows"])
+    gt = json.load(open(f"{PROV}/gt.json"))
+    sel = json.load(open("results/iter_116/lock/selection.json"))
+    res = dict(note="생성 없는 저장 출력 기반 단순 대조(K/B/G/M). N/E/R/T/S는 MAIN 미생성으로 계산하지 않음.")
+    for g, ids in (("mismatch", sel["mismatch"]), ("control", sel["control"])):
+        ps = [EV.make_patient(rows[i], gt[i], {}) for i in ids]
+        pt = [EV.point_scalars(p) for p in ps]
+        d = dict(n=len(ps))
+        for name in ("correct", "correction", "harm"):
+            d[name] = dict((q, sum(x[f"{name}_{q}"] for x in pt)) for q in POL)
+        d["joint03"] = dict((q, sum(x[f"joint03_{q}"] for x in pt)) for q in ("K", "B"))
+        d["joint05"] = dict((q, sum(x[f"joint05_{q}"] for x in pt)) for q in ("K", "B"))
+        d["by_category_correct"] = {}
+        for c in CATS:
+            k_ = [k for k, p in enumerate(ps) if p["cat"] == c]
+            d["by_category_correct"][c] = dict([("n", len(k_))] + [(q, sum(pt[k][f"correct_{q}"] for k in k_)) for q in POL])
+        res[g] = d
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    json.dump(res, open(out, "x"), indent=1)
+    print(json.dumps(res, indent=1))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/ed116_build.py b/ed116_build.py
new file mode 100644
index 0000000..dca3e58
--- /dev/null
+++ b/ed116_build.py
@@ -0,0 +1,157 @@
+"""iter_116 표본·요청·protocol·평가 잠금 (결과는 results/iter_116 아래에만, 기존 파일 덮어쓰기 거부).
+ select   : 환자 선택(selection.json). GT는 읽지 않는다 (ledger_nogt만 사용).
+ requests : TECH(12×4=48), MAIN(174×4=696), RESUME8(TECH의 처음 8행) 요청 파일. 입력 영상 padded pixel hash를 현재 파일에서 재계산한다.
+ weights  : 현재 가중치 snapshot 내용 sha256을 iter_108 weights_lock과 대조한다.
+ lock     : 평가·명세 코드와 입력의 hash를 잠금 시각과 함께 eval_lock.json에 기록한다 (생성 전).
+ protocol : pg43_run.make_protocol (코드 hash·요청 hash·영상 digest·generation config·잠금 파일).
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import ed116_spec as ES
+import pg43_run as RUN
+from rsna_diag import generate as G
+
+R116 = "results/iter_116"
+PROV = f"{R116}/provenance"
+LOCKDIR = f"{R116}/lock"
+REQ = f"{R116}/requests"
+PROTO = f"{R116}/protocol"
+SNAP = Path("../hf_cache/hub/models--google--medgemma-1.5-4b-it/snapshots") / G.MODEL_REVISION
+WLOCK108 = "results/iter_108/protocol/weights_lock.json"
+EVAL_CODE = ["ed116_spec.py", "ed116_eval.py", "ed116_link.py", "ed116_build.py", "ed116_verify.py", "ed116_analyze.py", "test_ed116.py",
+             "ev109_extract.py", "ev108_spec.py", "test_ev109_extract.py", "pg43_run.py", "rsna_diag/__init__.py", "rsna_diag/generate.py",
+             "rsna_diag/geometry.py", "rsna_diag/prompts.py", "rsna_diag/qa_spec.py", "rsna_diag/metrics.py"]
+
+
+def fsha(p):
+    return RUN.file_sha(p)
+
+
+def wr(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "x") as f:
+        json.dump(obj, f, indent=1, sort_keys=True)
+
+
+def ledger():
+    return json.load(open(f"{PROV}/ledger_nogt.json"))["rows"]
+
+
+def cmd_select():
+    rows = ledger()
+    sel = ES.select(rows)
+    sel["spec_version"] = ES.SPEC_VERSION
+    sel["ledger_nogt_sha256"] = fsha(f"{PROV}/ledger_nogt.json")
+    wr(f"{LOCKDIR}/selection.json", sel)
+    print(sel["n"])
+
+
+def make_rows(rows, ids, stage, group_of):
+    byid = {r["id"]: r for r in rows}
+    out = []
+    for rank, i in enumerate(ids):
+        r = byid[i]
+        draft = ES.answer_K(r)
+        if draft is None:
+            raise RuntimeError(f"unresolved draft in selected set {i}")
+        _, _, pxs = G.load_image(r["image"])
+        if RUN.file_sha(r["image"]) != r["file_sha256"]:
+            raise RuntimeError(f"image file hash changed {i}")
+        for cond in ES.COND_ORDER:
+            prompt = ES.build_prompt(cond, r, draft)
+            psha = ES.sha(prompt)
+            has_img = cond in ES.IMAGE_CONDS
+            row = dict(stage=stage, group=group_of[i], cond=cond, patient=i, targets=["O"], kind="correction", donor_patient=None,
+                       modality="image" if has_img else "text", image=r["image"] if has_img else None,
+                       image_file_sha256=r["file_sha256"] if has_img else None, input_pixel_sha256=pxs if has_img else None,
+                       draft=draft, prompt=prompt, prompt_sha256=psha, caps=ES.CAPS,
+                       order_key=f"{stage}|{rank:04d}|{ES.COND_ORDER.index(cond)}")
+            row["request_id"] = ES.request_id(i, cond, psha, row["input_pixel_sha256"], G.MODEL_REVISION)
+            out.append(row)
+    return out
+
+
+def write_jsonl(path, rows):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "x") as f:
+        for r in rows:
+            f.write(json.dumps(r, sort_keys=True) + "\n")
+
+
+def cmd_requests():
+    rows = ledger()
+    sel = json.load(open(f"{LOCKDIR}/selection.json"))
+    if sel["ledger_nogt_sha256"] != fsha(f"{PROV}/ledger_nogt.json"):
+        sys.exit("selection이 현재 ledger와 다르다")
+    group_of = {**{i: "tech" for i in sel["tech"]}, **{i: "mismatch" for i in sel["mismatch"]}, **{i: "control" for i in sel["control"]}}
+    tech = make_rows(rows, sel["tech"], "TECH", group_of)
+    main = make_rows(rows, sel["mismatch"] + sel["control"], "MAIN", group_of)
+    resume8 = sorted(tech, key=lambda r: r["order_key"])[:8]
+    for name, rr in (("TECH", tech), ("MAIN", main), ("RESUME8", resume8)):
+        write_jsonl(f"{REQ}/{name}.jsonl", rr)
+        ids = [r["request_id"] for r in rr]
+        assert len(ids) == len(set(ids))
+        print(name, len(rr), RUN.file_sha(f"{REQ}/{name}.jsonl"))
+    # 입력 누설 검사: 요청에 GT/category가 없다
+    txt = open(f"{REQ}/MAIN.jsonl").read()
+    assert "category" not in txt and "gt_" not in txt
+
+
+def cmd_weights():
+    now = {p.name: {"sha256": RUN.file_sha(str(p.resolve())), "size": p.resolve().stat().st_size} for p in sorted(SNAP.iterdir())}
+    ref = json.load(open(WLOCK108))["files"]
+    diff = sorted(k for k in set(now) | set(ref) if now.get(k) != ref.get(k))
+    res = dict(snapshot=str(SNAP), revision=G.MODEL_REVISION, n_files=len(now), reference=WLOCK108, reference_sha256=fsha(WLOCK108),
+               differences_vs_reference=diff, files=now, checked_at=time.time())
+    wr(f"{LOCKDIR}/weights_check.json", res)
+    print("weights files", len(now), "diff", diff)
+    if diff:
+        sys.exit(1)
+
+
+def lock_files():
+    return (EVAL_CODE + [f"{PROV}/ledger_nogt.json", f"{PROV}/gt.json", f"{PROV}/provenance.json", f"{LOCKDIR}/selection.json",
+                         f"{LOCKDIR}/weights_check.json"] + [f"{REQ}/{n}.jsonl" for n in ("TECH", "MAIN", "RESUME8")])
+
+
+def cmd_lock(tests):
+    t = time.time()
+    d = dict(locked_at_epoch=t, locked_at_utc=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t)), note=
+             "생성(TECH/MAIN) 시작 전에 작성. 평가 코드·명세·표본·요청·정답 파일의 hash. 이 시각 이후 생성 결과를 보고 수정하지 않는다.",
+             files={f: fsha(f) for f in lock_files() + [tests]}, spec_digest=ES.rules_digest())
+    wr(f"{LOCKDIR}/eval_lock.json", d)
+    print("locked", d["locked_at_utc"], len(d["files"]))
+
+
+def cmd_protocol(stage, gate):
+    wd = json.load(open(f"{LOCKDIR}/weights_check.json"))
+    extra = dict(spec_version=ES.SPEC_VERSION, weights_check_sha256=fsha(f"{LOCKDIR}/weights_check.json"),
+                 eval_lock_sha256=fsha(f"{LOCKDIR}/eval_lock.json"), model_revision=G.MODEL_REVISION, n_weight_files=wd["n_files"])
+    lock = [f"{LOCKDIR}/eval_lock.json", f"{LOCKDIR}/selection.json", f"{PROV}/ledger_nogt.json", f"{LOCKDIR}/weights_check.json",
+            "ed116_spec.py", "ed116_eval.py", "ev109_extract.py", "ev108_spec.py", "rsna_diag/qa_spec.py", "rsna_diag/metrics.py"]
+    d = RUN.make_protocol(f"{REQ}/{stage}.jsonl", f"{PROTO}/protocol_{stage}.json", gate=gate, extra=extra, lock=lock)
+    print("protocol", stage, RUN.file_sha(f"{PROTO}/protocol_{stage}.json"), d["n_requests"])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("cmd", choices=["select", "requests", "weights", "lock", "protocol"])
+    ap.add_argument("--stage")
+    ap.add_argument("--gate")
+    ap.add_argument("--tests")
+    a = ap.parse_args()
+    {"select": cmd_select, "requests": cmd_requests, "weights": cmd_weights}.get(a.cmd, lambda: None)() if a.cmd in ("select", "requests", "weights") else None
+    if a.cmd == "lock":
+        cmd_lock(a.tests)
+    if a.cmd == "protocol":
+        cmd_protocol(a.stage, a.gate)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ed116_directcheck.py b/ed116_directcheck.py
new file mode 100644
index 0000000..85e3ca2
--- /dev/null
+++ b/ed116_directcheck.py
@@ -0,0 +1,81 @@
+"""iter_116 공식 방식 직접 generate 대조 (4건: 영상 2 + text-only 2). worker 경로(pg43_run/generate)를 import하지 않고
+모델 카드 방식(processor.apply_chat_template → model.generate)과 독립 padding으로 입력 tensor·생성 token을 재현한다.
+사용: CUDA_VISIBLE_DEVICES=<허용 GPU 하나> python ed116_directcheck.py <TECH 완료 dir> <출력 json>"""
+import glob
+import hashlib
+import json
+import os
+import sys
+
+import numpy as np
+from PIL import Image
+
+os.environ.setdefault("HF_HOME", "/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache")
+os.environ.setdefault("HF_HUB_OFFLINE", "1")
+import torch
+import transformers
+
+ID, REV = "google/medgemma-1.5-4b-it", "91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b"
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def indep_pad(path):
+    a = np.asarray(Image.open(path).convert("RGB"))  # uint8 L→RGB 채널 복제
+    h, w = a.shape[:2]
+    side = max(h, w)
+    canvas = np.zeros((side, side, 3), np.uint8)
+    t, l = (side - h) // 2, (side - w) // 2
+    canvas[t:t + h, l:l + w] = a
+    return Image.fromarray(canvas), sha(canvas.tobytes())
+
+
+def main(gen_dir, out):
+    recs = {}
+    for f in sorted(glob.glob(gen_dir + "/gen_worker*.jsonl")):
+        for ln in open(f):
+            r = json.loads(ln)
+            recs[r["request_id"]] = r
+    rows = [json.loads(l) for l in open("results/iter_116/requests/TECH.jsonl")]
+    byk = {(r["patient"], r["cond"]): r for r in rows}
+    pats = sorted({r["patient"] for r in rows})
+    pick = [byk[(pats[0], "R")], byk[(pats[1], "N")], byk[(pats[0], "T")], byk[(pats[2], "T")]]
+    proc = transformers.AutoProcessor.from_pretrained(ID, revision=REV)
+    model = transformers.AutoModelForImageTextToText.from_pretrained(ID, revision=REV, dtype=torch.bfloat16, device_map="cuda").eval()
+    eos = model.generation_config.eos_token_id
+    eos = set(eos if isinstance(eos, list) else [eos])
+    res = []
+    for row in pick:
+        rec = recs[row["request_id"]]
+        content = [{"type": "text", "text": row["prompt"]}]
+        pad_sha = None
+        if row["modality"] == "image":
+            img, pad_sha = indep_pad(row["image"])
+            content = [{"type": "image", "image": img}] + content
+        inputs = proc.apply_chat_template([{"role": "user", "content": content}], add_generation_prompt=True, tokenize=True,
+                                          return_dict=True, return_tensors="pt").to(model.device, dtype=torch.bfloat16)
+        ids = inputs["input_ids"][0].tolist()
+        n_in = len(ids)
+        with torch.no_grad():
+            out_ids = model.generate(**inputs, max_new_tokens=row["caps"][0], do_sample=False)
+        suffix = out_ids[0][n_in:].tolist()
+        res.append(dict(request_id=row["request_id"], cond=row["cond"], modality=row["modality"],
+                        has_pixel_values="pixel_values" in inputs, keys=sorted(inputs.keys()),
+                        n_image_tokens=sum(t == model.config.image_token_index for t in ids),
+                        input_ids_sha256_direct=sha(json.dumps(ids).encode()), input_ids_sha256_record=rec["input_ids_sha256"],
+                        input_ids_equal=sha(json.dumps(ids).encode()) == rec["input_ids_sha256"],
+                        indep_pad_pixel_sha256=pad_sha, record_pixel_sha256=rec["input_pixel_sha256"],
+                        pixel_equal=(pad_sha == rec["input_pixel_sha256"]) if row["modality"] == "image" else (rec["input_pixel_sha256"] is None),
+                        suffix_equal=suffix == rec["suffix_ids"], n_suffix_direct=len(suffix), n_suffix_record=len(rec["suffix_ids"]),
+                        text_only_has_no_image=(row["modality"] != "text") or ("pixel_values" not in inputs and sum(t == model.config.image_token_index for t in ids) == 0)))
+    ok = all(r["input_ids_equal"] and r["pixel_equal"] and r["suffix_equal"] and r["text_only_has_no_image"] for r in res)
+    json.dump(dict(all_pass=ok, n=len(res), results=res, transformers=transformers.__version__, torch=torch.__version__,
+                   cuda_visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES")), open(out, "x"), indent=1)
+    print("all_pass", ok)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
diff --git a/ed116_eval.py b/ed116_eval.py
new file mode 100644
index 0000000..ec8cbb5
--- /dev/null
+++ b/ed116_eval.py
@@ -0,0 +1,249 @@
+"""iter_116 평가 (생성 결과를 보기 전에 잠근다). 입력은 검증된 record와 ledger/gt.
+
+정의 (모두 계획에 명시된 것만 구현; 계획에 없는 사건 수 문턱은 추가하지 않는다):
+ - 정답: category=='opacity' → yes, 그 외 → no (표적 Q_O).
+ - 정책 정답 수는 unresolved(None)를 정답으로 세지 않는다 (주 보수적 점수).
+ - correction: K 오답 환자 중 정책이 정답인 수. harm: K 정답 환자 중 정책이 정답이 아닌 수(unresolved 포함, harm_wrong은 resolved 반대 답만).
+ - 공동 지표: 최종 답이 yes면 고정 detector 후보(score>=0.70)를 유지, no/unresolved면 제거(빈 집합). 양성은 yes이고 IoU0.3 최대 일대일 matching에서
+   TP==n_GT==n_pred, 음성은 no이고 box 없음일 때 공동 성공. unresolved는 공동 성공이 아니다. IoU0.5·양성 F1·FP/FN은 보조.
+ - unresolved 범위: 환자별로 미해결 변수(G,N,E,R,T)의 모든 yes/no 배정을 열거해 각 지표의 환자별 최소/최대를 합산한다.
+   같은 출력이 여러 정책(E→S, G→M)에 쓰이므로 환자 내에서는 공유 변수로 함께 배정한다 (환자 간은 독립이므로 합산이 정확).
+ - bootstrap: 환자 단위 10,000회, seed 11617, 그룹(불일치/일치 대조)별 분리, percentile 95%.
+"""
+import itertools
+import json
+import os
+
+import numpy as np
+
+import ed116_spec as ES
+import ev109_extract as X
+from rsna_diag import geometry as GEO
+from rsna_diag import metrics as MET
+
+POL = ("K", "B", "G", "M", "N", "E", "R", "T", "S")
+COMP = ("K", "B", "G", "M", "N", "E", "S")  # 성공 기준의 필수 단순/기존 대조 (T는 보고만)
+JOINT_POL = ("K", "B", "N", "E", "R", "T", "S")
+FREE = ("G", "N", "E", "R", "T")
+# 사전 투자 분기 상수 (계획 Evaluation '양성 탐색')
+MIN_CORRECTION = 10
+MAX_HARM = 5
+MIN_ADV = 5
+MAX_AGREE_HARM_RATE = 0.05
+TECH_MIN_RESOLVED = 6  # 12명 중 절반 미만(<6)이면 본생성 보류
+
+
+def gt_answer(cat):
+    return "yes" if cat == "opacity" else "no"
+
+
+def derive(k, b, g, n, e, r, t):
+    s = e if (e is not None and e == b) else k
+    return dict(K=k, B=b, G=g, M=ES.majority(k, b, g), N=n, E=e, R=r, T=t, S=s)
+
+
+def det_norm_boxes(row):
+    top, left, side = row["pad"]
+    return [GEO.canvas_to_norm(b, top, left, side) for _, b in ES.det_boxes(row)]
+
+
+def make_patient(row, gt, model_ans):
+    """row: ledger_nogt 행, gt: gt.json 항목, model_ans: cond→raw answer|None (N/E/R/T)."""
+    base = derive(ES.answer_K(row), ES.answer_B(row), ES.answer_G(row), model_ans.get("N"), model_ans.get("E"),
+                  model_ans.get("R"), model_ans.get("T"))
+    pred = det_norm_boxes(row)
+    g = gt["gt_yxyx_norm"]
+    m03, m05 = MET.match(pred, g, 0.3), MET.match(pred, g, 0.5)
+    return dict(id=row["id"], cat=gt["category"], y=gt_answer(gt["category"]), base=base, n_det=len(pred), n_gt=len(g),
+                tp03=len(m03), tp05=len(m05))
+
+
+def scalars(p, ans):
+    """한 환자·한 배정(ans: 정책→답 또는 None)의 지표. None은 보수적으로 처리한다."""
+    y, kc = p["y"], p["base"]["K"] == p["y"]
+    out = {}
+    cor = {q: int(ans[q] == y) for q in POL}
+    for q in POL:
+        out[f"correct_{q}"] = cor[q]
+        out[f"correction_{q}"] = cor[q] if not kc else 0
+        out[f"harm_{q}"] = (1 - cor[q]) if kc else 0
+        out[f"harmwrong_{q}"] = int(kc and ans[q] is not None and ans[q] != y)
+        out[f"flip_to_yes_{q}"] = int(ans[q] == "yes" and p["base"]["K"] == "no")
+        out[f"flip_to_no_{q}"] = int(ans[q] == "no" and p["base"]["K"] == "yes")
+    for q in POL:
+        if q != "R":
+            out[f"diff_R_{q}"] = cor["R"] - cor[q]
+    pos = p["y"] == "yes"
+    for q in JOINT_POL:
+        a = ans[q]
+        npred = p["n_det"] if a == "yes" else 0
+        for thr, tp_all in (("03", p["tp03"]), ("05", p["tp05"])):
+            tp = tp_all if a == "yes" else 0
+            if pos:
+                ok = int(a == "yes" and tp == p["n_gt"] == npred)
+            else:
+                ok = int(a == "no" and npred == 0)
+            out[f"joint{thr}_{q}"] = ok
+            out[f"fp{thr}_{q}"] = npred - tp
+            out[f"fn{thr}_{q}"] = (p["n_gt"] - tp) if pos else 0
+        if pos:
+            tp = p["tp03"] if a == "yes" else 0
+            prec = tp / npred if npred else 0.0
+            rec = tp / p["n_gt"]
+            out[f"posf1_03_{q}"] = 2 * prec * rec / (prec + rec) if prec + rec > 0 else 0.0
+        else:
+            out[f"posf1_03_{q}"] = 0.0
+    for q in JOINT_POL:
+        if q != "R":
+            out[f"jdiff03_R_{q}"] = out["joint03_R"] - out[f"joint03_{q}"]
+    return out
+
+
+def point_scalars(p):
+    return scalars(p, p["base"])
+
+
+def range_scalars(p):
+    """미해결 변수 모든 yes/no 배정에서 지표별 (min, max). 해결된 환자는 점추정과 같다."""
+    free = [v for v in FREE if p["base"][v] is None]
+    lo = hi = None
+    for combo in itertools.product(("yes", "no"), repeat=len(free)):
+        b = dict(p["base"])
+        for v, a in zip(free, combo):
+            b[v] = a
+        d = derive(b["K"], b["B"], b["G"], b["N"], b["E"], b["R"], b["T"])
+        sc = scalars(p, d)
+        if lo is None:
+            lo, hi = dict(sc), dict(sc)
+        else:
+            for k, v in sc.items():
+                lo[k] = min(lo[k], v)
+                hi[k] = max(hi[k], v)
+    return lo, hi
+
+
+def boot_idx(n):
+    return np.random.default_rng(ES.SEED_BOOT).integers(0, n, size=(ES.N_BOOT, n), dtype=np.int32)
+
+
+def ci_mean(v, idx):
+    v = np.asarray(v, float)
+    m = v[idx].mean(axis=1)
+    return [float(v.mean()), float(np.percentile(m, 2.5)), float(np.percentile(m, 97.5))]
+
+
+def ci_ratio(num, den, idx):
+    num, den = np.asarray(num, float), np.asarray(den, float)
+    if den.sum() == 0:
+        return [None, None, None]
+    n_, d_ = num[idx].sum(axis=1), den[idx].sum(axis=1)
+    ok = d_ > 0
+    r = n_[ok] / d_[ok]
+    return [float(num.sum() / den.sum()), float(np.percentile(r, 2.5)), float(np.percentile(r, 97.5))]
+
+
+def group_report(patients):
+    n = len(patients)
+    pts = [point_scalars(p) for p in patients]
+    rng = [range_scalars(p) for p in patients]
+    keys = list(pts[0])
+    point = {k: int(sum(d[k] for d in pts)) if all(isinstance(d[k], int) for d in pts) else float(sum(d[k] for d in pts)) for k in keys}
+    rmin = {k: float(sum(lo[k] for lo, _ in rng)) for k in keys}
+    rmax = {k: float(sum(hi[k] for _, hi in rng)) for k in keys}
+    kc = np.array([int(p["base"]["K"] == p["y"]) for p in patients])
+    n_kc, n_kw = int(kc.sum()), int(n - kc.sum())
+    idx = boot_idx(n)
+    vec = lambda k: np.array([d[k] for d in pts], float)
+    ci = {}
+    for q in POL:
+        if q != "R":
+            ci[f"diff_R_{q}"] = ci_mean(vec(f"diff_R_{q}"), idx)
+    for q in JOINT_POL:
+        if q != "R":
+            ci[f"jdiff03_R_{q}"] = ci_mean(vec(f"jdiff03_R_{q}"), idx)
+    for q in POL:
+        ci[f"correction_rate_{q}"] = ci_ratio(vec(f"correction_{q}"), 1 - kc, idx)
+        ci[f"harm_rate_{q}"] = ci_ratio(vec(f"harm_{q}"), kc, idx)
+        ci[f"accuracy_{q}"] = ci_mean(vec(f"correct_{q}"), idx)
+    cats = {}
+    for c in ("opacity", "normal", "not_normal_no_opacity"):
+        sub = [i for i, p in enumerate(patients) if p["cat"] == c]
+        cats[c] = dict(n=len(sub), K_correct=int(sum(pts[i]["correct_K"] for i in sub)),
+                       correct={q: int(sum(pts[i][f"correct_{q}"] for i in sub)) for q in POL},
+                       to_yes_R=int(sum(pts[i]["flip_to_yes_R"] for i in sub)), to_no_R=int(sum(pts[i]["flip_to_no_R"] for i in sub)))
+    follow = {}
+    for q in ("N", "E", "R", "T"):
+        res = [p for p in patients if p["base"][q] is not None]
+        follow[q] = dict(n_resolved=len(res), n_unresolved=n - len(res),
+                         equals_K=int(sum(p["base"][q] == p["base"]["K"] for p in res)),
+                         equals_B=int(sum(p["base"][q] == p["base"]["B"] for p in res)))
+    return dict(n=n, n_K_correct=n_kc, n_K_wrong=n_kw, point=point, range_min=rmin, range_max=rmax, ci95=ci, by_category=cats, follow=follow,
+                n_unresolved_cells={q: int(sum(p["base"][q] is None for p in patients)) for q in FREE})
+
+
+def decide(mm, ag):
+    """사전 투자 분기. mm: 불일치 그룹 report, ag: 일치 대조 report. 계획에 없는 문턱은 쓰지 않는다.
+    각 기준은 지표 하나에 대한 부등식이므로 '모든 미해결 배정에서 기준 충족'은 지표별 최악값에서의 충족과 같다."""
+
+    def get(mode, rep, k):
+        if mode == "point":
+            return rep["point"][k]
+        good_high = k.startswith("correction_") or k.startswith("diff_")  # 클수록 R에 유리한 지표
+        lo, hi = rep["range_min"][k], rep["range_max"][k]
+        if mode == "worst":
+            return lo if good_high else hi
+        return hi if good_high else lo
+
+    def crit(mode):
+        c = {"R_correction>=10": get(mode, mm, "correction_R") >= MIN_CORRECTION,
+             "R_harm<=5": get(mode, mm, "harm_R") <= MAX_HARM}
+        for x in COMP:
+            c[f"R_minus_{x}>=5"] = get(mode, mm, f"diff_R_{x}") >= MIN_ADV
+        c["agree_harm_rate<=0.05"] = get(mode, ag, "harm_R") <= MAX_AGREE_HARM_RATE * ag["n_K_correct"]
+        return c
+
+    res = {m: crit(m) for m in ("point", "worst", "best")}
+    point_ok, worst_ok, best_ok = (all(res[m].values()) for m in ("point", "worst", "best"))
+    if point_ok and worst_ok:
+        label = "positive_exploratory"
+    elif point_ok:
+        label = "inconclusive_unresolved_flips_criteria"
+    elif best_ok:
+        label = "inconclusive_unresolved_could_satisfy"
+    else:
+        label = "hold_current_frozen_setting"
+    return dict(label=label, point=res["point"], worst=res["worst"], best=res["best"],
+                note="CI·표본 변동에 따른 불확정은 계획에 수치 기준이 없어 자동 분기에서 사용하지 않고 보고서에 서술한다.")
+
+
+def format_report(recs_by_cond):
+    """cond→records(list). 응답 형식 준수와 내용 정확도를 분리하기 위한 형식 통계."""
+    out = {}
+    for c, recs in recs_by_cond.items():
+        srcs, reasons, strict = {}, {}, 0
+        for r in recs:
+            res = X.resolve("O", r["suffix_text_raw"], r["ended_eos"])
+            srcs[res["source"]] = srcs.get(res["source"], 0) + 1
+            if res["source"] == "unresolved":
+                reasons[res["reason"]] = reasons.get(res["reason"], 0) + 1
+            strict += int(ES.S.strict("O", r["suffix_text_raw"], r["ended_eos"])[0] == "valid")
+        out[c] = dict(n=len(recs), source=srcs, unresolved_reasons=reasons, strict_valid=strict,
+                      eos=sum(bool(r["ended_eos"]) for r in recs), retry=sum(len(r["attempts"]) > 1 for r in recs),
+                      mean_output_tokens=float(np.mean([r["n_output_tokens"] for r in recs])) if recs else None)
+    return out
+
+
+def tech_gate(recs, tech_ids):
+    """기술 12명 × 4조건. 한 조건이라도 resolved가 12명 중 6 미만이면 본생성 보류 (사전 형식 분기)."""
+    by = {c: {} for c in ES.COND_ORDER}
+    for r in recs:
+        by[r["cond"]][r["patient"]] = r
+    det = {}
+    ok = True
+    for c in ES.COND_ORDER:
+        miss = [i for i in tech_ids if i not in by[c]]
+        n_res = sum(X.resolve("O", by[c][i]["suffix_text_raw"], by[c][i]["ended_eos"])["answer"] is not None for i in tech_ids if i in by[c])
+        det[c] = dict(n_records=len(by[c]), n_missing=len(miss), n_resolved=n_res, passes=(not miss) and n_res >= TECH_MIN_RESOLVED)
+        ok &= det[c]["passes"]
+    return dict(run=bool(ok), per_condition=det, min_resolved_required=TECH_MIN_RESOLVED, n_tech=len(tech_ids),
+                note="기술 검사 통과는 정확도 문턱이 아니다. 형식(resolved) 분기만 판정한다.")
