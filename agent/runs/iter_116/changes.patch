+    chk("resume_cost_this_attempt_vs_total", cj["cost_this_attempt"]["n_records"] == 5 and cj["cost"]["n_records"] == 8, [cj["cost_this_attempt"]["n_records"], cj["cost"]["n_records"]])
+    gpus = {r.get("physical_gpu") for r in rr}
