+"""전처리(정사각 padding)와 좌표 변환.
+
+좌표 규약
+- 원본/pixel bbox: xyxy = [x0, y0, x1, y1] (pixel, 원본 canvas).
+- 모델 출력/GT 정규화 bbox: [y0, x0, y1, x1] in [0, 1000], padding된 정사각 전체 영상 기준.
+padding: 중앙 정렬, 위/왼쪽에 floor(d/2), 아래/오른쪽에 나머지 (공식 notebook pad_image_to_square와 동일).
+"""
+import numpy as np
+from PIL import Image
+
+
+def pad_offsets(h, w):
+    """returns (top, left, side)."""
+    side = max(h, w)
+    top = (side - h) // 2 if h < w else 0
+    left = (side - w) // 2 if w < h else 0
+    return top, left, side
+
+
+def to_uint8_rgb_preserving(arr, mode=None):
+    """값 보존 경로: uint8 L/RGB는 밝기 유지(gray는 채널 복제), RGBA는 흰 배경 alpha 합성(반올림).
+
+    uint8이 아닌 dtype은 지원하지 않는다 (임의 정규화 금지) -> ValueError.
+    """
+    a = np.asarray(arr)
+    if a.dtype != np.uint8:
+        raise ValueError(f"unsupported dtype {a.dtype}")
+    if a.ndim == 2:
+        return np.repeat(a[:, :, None], 3, axis=2)
+    if a.ndim == 3 and a.shape[2] == 1:
+        return np.repeat(a, 3, axis=2)
+    if a.ndim == 3 and a.shape[2] == 3:
+        return a.copy()
+    if a.ndim == 3 and a.shape[2] == 4:
+        af = a[:, :, 3:4].astype(np.float64) / 255.0
+        rgb = a[:, :, :3].astype(np.float64)
+        out = rgb * af + 255.0 * (1.0 - af)
+        return np.floor(out + 0.5).astype(np.uint8)
+    raise ValueError(f"unsupported shape {a.shape}")
+
+
+def pad_square(rgb):
+    """검은 padding, 중앙, 위/왼쪽 floor. returns (padded, (top, left, side))."""
+    h, w = rgb.shape[:2]
+    top, left, side = pad_offsets(h, w)
+    out = np.zeros((side, side, rgb.shape[2]), dtype=rgb.dtype)
+    out[top:top + h, left:left + w] = rgb
+    return out, (top, left, side)
+
+
+def notebook_pad_emulation(arr):
+    """공식 notebook의 preprocess를 numpy로 모사한다 (skimage 미설치, pip 불가 -> 근사 emulation).
+
+    skimage.util.img_as_ubyte(uint8) = 항등. gray2rgb: 채널 복제(uint8 유지).
+    rgba2rgb: img_as_float(x/255) 후 흰 배경 alpha 합성 -> float64 [0,1]. 그 뒤 `* 255` 후 astype(uint8):
+      - float 경로(RGBA 입력): 값 x/255*255 를 uint8로 truncation (부동소수 오차로 1 LSB 감소 가능).
+      - uint8 경로(L/RGB 입력): uint8 * 255 는 uint8에서 modulo 256 wrap (v -> (255*v) mod 256).
+    """
+    a = np.asarray(arr)
+    if a.dtype != np.uint8:
+        raise ValueError("emulation only for uint8 input")
+    if a.ndim == 2:
+        a = np.repeat(a[:, :, None], 3, axis=2)
+    if a.shape[2] == 4:
+        f = a.astype(np.float64) / 255.0
+        alpha = f[:, :, 3:4]
+        a = f[:, :, :3] * alpha + 1.0 * (1.0 - alpha)
+    padded, aff = pad_square(a)
+    return (padded * 255).astype(np.uint8), aff
+
+
+def canvas_to_norm(box_xyxy, top, left, side):
+    """원본 pixel xyxy -> padding canvas 기준 [y0,x0,y1,x1] (0-1000, float)."""
+    x0, y0, x1, y1 = box_xyxy
+    return [(y0 + top) * 1000.0 / side, (x0 + left) * 1000.0 / side,
+            (y1 + top) * 1000.0 / side, (x1 + left) * 1000.0 / side]
+
+
+def norm_to_canvas(box_yxyx, top, left, side):
+    """padding canvas 기준 [y0,x0,y1,x1] (0-1000) -> 원본 pixel xyxy (clipping 없음)."""
+    y0, x0, y1, x1 = box_yxyx
+    return [x0 * side / 1000.0 - left, y0 * side / 1000.0 - top,
+            x1 * side / 1000.0 - left, y1 * side / 1000.0 - top]
+
+
+def to_pil(rgb):
+    return Image.fromarray(rgb)
diff --git a/rsna_diag/metrics.py b/rsna_diag/metrics.py
new file mode 100644
index 0000000..33c5131
--- /dev/null
+++ b/rsna_diag/metrics.py
@@ -0,0 +1,136 @@
+"""bbox 평가 (iter_009). 모든 box는 [y0,x0,y1,x1] (0-1000, padding canvas)."""
+import itertools
+import math
+
+import numpy as np
+
+
+def area(b):
+    return max(0.0, b[2] - b[0]) * max(0.0, b[3] - b[1])
+
+
+def inter(a, b):
+    return max(0.0, min(a[2], b[2]) - max(a[0], b[0])) * max(0.0, min(a[3], b[3]) - max(a[1], b[1]))
+
+
+def iou(a, b):
+    i = inter(a, b)
+    u = area(a) + area(b) - i
+    return i / u if u > 0 else 0.0
+
+
+def union_area(boxes):
+    """겹친 면적을 한 번만 세는 직사각형 합집합 면적 (좌표 압축)."""
+    boxes = [b for b in boxes if area(b) > 0]
+    if not boxes:
+        return 0.0
+    ys = sorted({v for b in boxes for v in (b[0], b[2])})
+    tot = 0.0
+    for y0, y1 in zip(ys[:-1], ys[1:]):
+        iv = sorted((b[1], b[3]) for b in boxes if b[0] <= y0 and b[2] >= y1)
+        cur_s = cur_e = None
+        length = 0.0
+        for s, e in iv:
+            if cur_e is None or s > cur_e:
+                if cur_e is not None:
+                    length += cur_e - cur_s
+                cur_s, cur_e = s, e
+            else:
+                cur_e = max(cur_e, e)
+        if cur_e is not None:
+            length += cur_e - cur_s
+        tot += length * (y1 - y0)
+    return tot
+
+
+def union_iou(pred, gt):
+    if not pred and not gt:
+        return 0.0
+    up, ug = union_area(pred), union_area(gt)
+    # 교집합 면적 = up + ug - union(all)
+    ia = up + ug - union_area(list(pred) + list(gt))
+    u = up + ug - ia
+    return ia / u if u > 0 else 0.0
+
+
+def match(pred, gt, thr):
+    """threshold thr 이상 IoU 쌍의 최대 cardinality one-to-one matching.
+    동률은 총 IoU 최대, 이후 (gt index 순의) pred index tuple 사전순 최소. returns list[(gi, pi)]."""
+    mat = [[iou(p, g) for p in pred] for g in gt]
+    best = {"key": None, "pairs": []}
+
+    def rec(gi, used, pairs, tot):
+        if gi == len(gt):
+            key = (len(pairs), tot)
+            cur = best["key"]
+            if cur is None or key[0] > cur[0] or (key[0] == cur[0] and key[1] > cur[1] + 1e-12):
+                best["key"], best["pairs"] = key, list(pairs)
+            return
+        # 사전순 최소 tie-break: pred index 오름차순으로 탐색하고 엄격히 더 좋을 때만 갱신 (none 분기는 마지막)
+        for pi in range(len(pred)):
+            if pi not in used and mat[gi][pi] >= thr:
+                pairs.append((gi, pi))
+                rec(gi + 1, used | {pi}, pairs, tot + mat[gi][pi])
+                pairs.pop()
+        rec(gi + 1, used, pairs, tot)
+
+    rec(0, frozenset(), [], 0.0)
+    return best["pairs"]
+
+
+def patient_metrics(pred, gt, thr):
+    pairs = match(pred, gt, thr)
+    tp = len(pairs)
+    prec = tp / len(pred) if pred else 0.0
+    rec = tp / len(gt) if gt else 0.0
+    f1 = 2 * prec * rec / (prec + rec) if prec + rec > 0 else 0.0
+    return {"tp": tp, "n_pred": len(pred), "n_gt": len(gt), "precision": prec, "recall": rec, "f1": f1,
+            "unmatched_gt": len(gt) - tp, "unmatched_pred": len(pred) - tp}
+
+
+def max_iou_all(pred, gt):
+    return max((iou(p, g) for p in pred for g in gt), default=0.0)
+
+
+def wilson(k, n, z=1.959964):
+    if n == 0:
+        return (float("nan"), float("nan"))
+    p = k / n
+    d = 1 + z * z / n
+    c = (p + z * z / (2 * n)) / d
+    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+    return (c - h, c + h)
+
+
+def bootstrap_indices(n, B=10000, seed=20260924):
+    rng = np.random.default_rng(seed)
+    return rng.integers(0, n, size=(B, n), dtype=np.int32)
+
+
+def paired_boot_ci(a, b, idx):
+    """a,b: 같은 환자 순서의 값. 차이 a-b 평균의 percentile 95% CI. returns (mean_diff, lo, hi)."""
+    d = np.asarray(a, float) - np.asarray(b, float)
+    m = d[idx].mean(axis=1)
+    return float(d.mean()), float(np.percentile(m, 2.5)), float(np.percentile(m, 97.5))
+
+
+def derangement(n, seed):
+    """Sattolo: 고정점이 없는 순열 (단일 순환)."""
+    rng = np.random.default_rng(seed)
+    p = list(range(n))
+    for i in range(n - 1, 0, -1):
+        j = int(rng.integers(0, i))
+        p[i], p[j] = p[j], p[i]
+    assert all(p[i] != i for i in range(n))
+    return p
+
+
+def medoid_box(dev_gt_boxes_per_image):
+    """dev 양성 GT box 후보 중 (영상별 best IoU)의 평균이 최대인 실제 box. 동률은 입력 순서(고정 ID 순)."""
+    cands = [b for boxes in dev_gt_boxes_per_image for b in boxes]
+    best, best_s = None, -1.0
+    for c in cands:
+        s = float(np.mean([max(iou(c, g) for g in boxes) for boxes in dev_gt_boxes_per_image]))
+        if s > best_s + 1e-12:
+            best, best_s = c, s
+    return best, best_s
diff --git a/rsna_diag/parse.py b/rsna_diag/parse.py
new file mode 100644
index 0000000..5ea4871
--- /dev/null
+++ b/rsna_diag/parse.py
@@ -0,0 +1,170 @@
+"""생성 suffix 전용 엄격 parser (iter_009).
+
+규칙(계획 5절)
+- suffix만 파싱한다. EOS 없이 끝난 요청은 status='truncated' (내용 오류와 구분).
+- thinking(<unused94> ... <unused95>)을 분리한다. 열리고 닫히지 않으면 'unclosed_thinking'.
+- 답 영역에서 'Final Answer:' 마커를 우선한다. 마커가 없으면 영역 전체에서 완결 JSON 목록이 정확히 하나일 때만 허용(marker_missing 표시).
+- 복수의 서로 다른 최종 목록은 'ambiguous'. 빈 목록은 유효한 미검출.
+- 좌표가 유한 수치, 0..1000, y0<y1 & x0<x1이 아니면 'coord_invalid'. clipping/정렬 구제 없음. 반환 box 전체를 보존한다.
+- 라벨 비어있음/누락은 'schema_error'.
+status 분류: valid_nonempty, valid_empty (유효 출력) / truncated, unclosed_thinking, no_answer, no_json, grammar_error,
+             ambiguous, schema_error, coord_invalid (형식·좌표 실패).
+"""
+import json
+import math
+import re
+
+THINK_OPEN, THINK_CLOSE = "<unused94>", "<unused95>"
+EOT = "<end_of_turn>"
+VALID = ("valid_nonempty", "valid_empty")
+FINAL_RE = re.compile(r"Final Answer\s*:", re.I)
+FENCE_RE = re.compile(r"```(?:json)?", re.I)
+
+
+def _spans(text):
+    """문자열 리터럴을 존중하는 최상위 [...] 균형 구간 목록 [(start, end_exclusive, complete)]."""
+    out, i, n = [], 0, len(text)
+    while i < n:
+        if text[i] == "[":
+            depth, j, in_s, esc = 0, i, False, False
+            while j < n:
+                c = text[j]
+                if in_s:
+                    if esc:
+                        esc = False
+                    elif c == "\\":
+                        esc = True
+                    elif c == '"':
+                        in_s = False
+                else:
+                    if c == '"':
+                        in_s = True
+                    elif c == "[":
+                        depth += 1
+                    elif c == "]":
+                        depth -= 1
+                        if depth == 0:
+                            break
+                j += 1
+            if depth == 0 and j < n:
+                out.append((i, j + 1, True))
+                i = j + 1
+                continue
+            out.append((i, n, False))
+            break
+        i += 1
+    return out
+
+
+def _candidates(region):
+    """region에서 JSON 목록 후보를 찾는다. returns list of dict(kind, value/raw)."""
+    region = FENCE_RE.sub(" ", region)
+    cands = []
+    for s, e, complete in _spans(region):
+        raw = region[s:e]
+        if not complete:
+            if '"box_2d"' in raw or "box_2d" in raw:
+                cands.append({"kind": "grammar_error", "raw": raw})
+            continue
+        try:
+            v = json.loads(raw)
+        except Exception:
+            if "box_2d" in raw:
+                cands.append({"kind": "grammar_error", "raw": raw})
+            continue
+        if isinstance(v, list) and (len(v) == 0 or any(isinstance(x, dict) and "box_2d" in x for x in v)
+                                    or all(isinstance(x, dict) for x in v)):
+            cands.append({"kind": "list", "value": v, "raw": raw})
+    return cands
+
+
+def _entry(e):
+    """returns (box or None, label, problems list)."""
+    prob = []
+    if not isinstance(e, dict) or "box_2d" not in e:
+        return None, None, ["schema:not_object_or_no_box_2d"]
+    b, lab = e["box_2d"], e.get("label")
+    if not isinstance(lab, str) or not lab.strip():
+        prob.append("schema:empty_label")
+    if not (isinstance(b, list) and len(b) == 4 and all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in b)):
+        return None, lab, prob + ["schema:box_2d_not_4_numbers"]
+    if not all(math.isfinite(v) for v in b):
+        return [float(v) if math.isfinite(v) else v for v in b], lab, prob + ["coord:nonfinite"]
+    b = [float(v) for v in b]
+    if any(v < 0 or v > 1000 for v in b):
+        prob.append("coord:out_of_range")
+    if not (b[0] < b[2] and b[1] < b[3]):
+        prob.append("coord:inverted_or_zero_area")
+    return b, lab, prob
+
+
+def parse_response(raw_suffix, ended_eos):
+    res = {"status": None, "boxes": [], "labels": [], "flags": [], "problems": [], "n_candidates": 0}
+    if not ended_eos:
+        res["status"] = "truncated"
+        return res
+    text = raw_suffix
+    if text.endswith(EOT):
+        text = text[:-len(EOT)]
+    region = text
+    if THINK_OPEN in text or THINK_CLOSE in text:
+        res["flags"].append("thinking_present")
+        if THINK_CLOSE not in text:
+            res["status"] = "unclosed_thinking"
+            return res
+        region = text.split(THINK_CLOSE, 1)[1]
+        if THINK_OPEN in region or THINK_CLOSE in region:
+            res["flags"].append("multiple_thinking_blocks")
+    if not region.strip():
+        res["status"] = "no_answer"
+        return res
+    markers = list(FINAL_RE.finditer(region))
+    if markers:
+        segs = [region[markers[i].end(): markers[i + 1].start() if i + 1 < len(markers) else len(region)]
+                for i in range(len(markers))]
+    else:
+        res["flags"].append("marker_missing")
+        segs = [region]
+    if "```" in region:
+        res["flags"].append("fenced")
+    all_c = []
+    for sgm in segs:
+        all_c += _candidates(sgm)
+    res["n_candidates"] = len(all_c)
+    if not all_c:
+        res["status"] = "no_json"
+        return res
+    if any(c["kind"] == "grammar_error" for c in all_c):
+        res["status"] = "grammar_error"
+        return res
+    uniq = {json.dumps(c["value"], sort_keys=True) for c in all_c}
+    if len(uniq) > 1:
+        res["status"] = "ambiguous"
+        return res
+    if len(all_c) > 1:
+        res["flags"].append("repeated_identical_final")
+    val = all_c[0]["value"]
+    res["raw_list"] = val
+    probs = []
+    for e in val:
+        b, lab, p = _entry(e)
+        res["boxes"].append(b)
+        res["labels"].append(lab)
+        probs += p
+    res["problems"] = probs
+    if any(p.startswith("schema") for p in probs):
+        res["status"] = "schema_error"
+    elif any(p.startswith("coord") for p in probs):
+        res["status"] = "coord_invalid"
+    else:
+        res["status"] = "valid_nonempty" if val else "valid_empty"
+    return res
+
+
+def duplicates(boxes):
+    seen, d = set(), 0
+    for b in boxes:
+        t = tuple(b)
+        d += t in seen
+        seen.add(t)
+    return d
