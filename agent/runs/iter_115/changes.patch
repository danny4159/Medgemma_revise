+++ b/nr115_simple.py
@@ -0,0 +1,60 @@
+"""iter_115 보조 기술 통계(봉인 이후 추가, 잠금·completion 대상 아님): 차별 포착이 '출력 비어 있음'·개수·면적 같은 단순 속성으로 설명되는지.
+table87.json(봉인된 산출물)만 읽는다. 새 점수·threshold·검토 정책을 만들지 않는다."""
+import json
+from pathlib import Path
+
+from report86_common import sha
+
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / "results/iter_115"
+rows = json.loads((OUT / "table87.json").read_text())
+
+
+def cnt(f, key):
+    d = {}
+    for r in rows:
+        if f(r):
+            d[r[key]] = d.get(r[key], 0) + 1
+    return d
+
+
+res = {"input_table87_sha256": sha(OUT / "table87.json"), "code_sha256": sha(Path(__file__)),
+       "note": "봉인 이후 추가한 기술 통계. 사후 탐색이며 포착 규칙·점수를 바꾸지 않는다."}
+G = ["err_cure_only", "err_mspc_only", "err_both", "err_neither", "ok_selected_by_cure_or_mspc", "ok_not_selected"]
+res["cure_status_by_group"] = {g: cnt(lambda r, g=g: r["group"] == g, "cure_status") for g in G}
+res["cure_empty_overall"] = {"n_empty": sum(1 for r in rows if r["n_C"] == 0), "of_which_error": sum(1 for r in rows if r["n_C"] == 0 and r["error_official"]),
+                             "of_which_sel_cure": sum(1 for r in rows if r["n_C"] == 0 and r["sel_cure"]),
+                             "of_which_sel_cure_and_not_mspc_err": sum(1 for r in rows if r["n_C"] == 0 and r["sel_cure"] and r["error_official"] and not r["sel_mspc"])}
+res["mspc_empty_overall"] = {"n_empty": sum(1 for r in rows if r["n_P"] == 0)}
+res["mg_empty_overall"] = {"n_empty": sum(1 for r in rows if r["n_M"] == 0), "of_which_sel_conf": sum(1 for r in rows if r["n_M"] == 0 and r["sel_conf"])}
+# 개수: n_M vs n_GT, n_C vs n_M, n_P vs n_M (오류 87 vs 비오류)
+res["count_mismatch"] = {}
+for name, f in (("err", lambda r: r["error_official"] == 1), ("ok", lambda r: r["error_official"] == 0)):
+    sub = [r for r in rows if f(r)]
+    res["count_mismatch"][name] = {"n": len(sub), "n_M_ne_n_GT": sum(1 for r in sub if r["n_M"] != r["n_GT"]),
+                                   "n_C_ne_n_M": sum(1 for r in sub if r["n_C"] != r["n_M"]), "n_P_ne_n_M": sum(1 for r in sub if r["n_P"] != r["n_M"])}
+# 두 번째 모델의 공식 GT 대비 기본 오류율 (선택 집합 밖 포함)
+res["second_model_error_vs_GT"] = {"cure": sum(r["cure_err_vs_GT"] for r in rows), "mspc": sum(r["mspc_err_vs_GT"] for r in rows), "N": len(rows)}
+# 차별 포착 13개: 순위와 경계 근접(K=22)
+res["only_rank_margin"] = {"cure_only_rank_cure": sorted(r["rank_cure"] for r in rows if r["group"] == "err_cure_only"),
+                           "mspc_only_rank_mspc": sorted(r["rank_mspc"] for r in rows if r["group"] == "err_mspc_only"),
+                           "cure_only_rank_mspc": sorted(r["rank_mspc"] for r in rows if r["group"] == "err_cure_only"),
+                           "mspc_only_rank_cure": sorted(r["rank_cure"] for r in rows if r["group"] == "err_mspc_only")}
+# 환자 중복
+res["patients"] = {"cure_only": len({r["patient"] for r in rows if r["group"] == "err_cure_only"}), "mspc_only": len({r["patient"] for r in rows if r["group"] == "err_mspc_only"}),
+                   "mspc_only_items": 6}
+# 공식 유형이 ALT 에서 유지된 비율 (13개)
+res["alt_preservation_13"] = {}
+for r in rows:
+    if r["group"] in ("err_cure_only", "err_mspc_only"):
+        t, a = r["type_GT"], r["type_ALT"]
+        k = "no_alt" if a == "NA" else "same" if a == t else "resolved" if a == "iou_ok" else "changed"
+        res["alt_preservation_13"][k] = res["alt_preservation_13"].get(k, 0) + 1
+# 유형 분포: 오류 전체(37) vs 차별 포착
+res["type_GT_all_errors"] = cnt(lambda r: r["error_official"] == 1, "type_GT")
+res["type_GT_only13"] = cnt(lambda r: r["group"] in ("err_cure_only", "err_mspc_only"), "type_GT")
+p = OUT / "simple_explanations.json"
+if p.exists():
+    raise SystemExit("exists")
+p.write_text(json.dumps(res, indent=1, ensure_ascii=False))
+print(json.dumps(res, indent=1, ensure_ascii=False))
diff --git a/nr115_tests.py b/nr115_tests.py
new file mode 100644
index 0000000..0049f20
--- /dev/null
+++ b/nr115_tests.py
@@ -0,0 +1,106 @@
+"""iter_115 fixture: 유형 분류 경계, 원시 입력 변조 검출(stale PASS 방지), 기존 결과 덮어쓰기 거부."""
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+import nr115_core as K
+import nr115_run as R
+import nr115_verify as V
+
+OUT = R.OUT
+res = {}
+
+
+def check(name, cond):
+    res[name] = bool(cond)
+
+
+B = lambda x0, y0, x1, y1: [x0, y0, x1, y1]
+# ---- 분류 fixture
+check("empty_pred", K.classify([], [B(.1, .1, .5, .5)]) == "empty_pred")
+check("no_overlap", K.classify([B(.6, .6, .9, .9)], [B(.1, .1, .4, .4)]) == "no_overlap")
+check("ALT_none_NA", K.classify([B(.1, .1, .4, .4)], []) == K.NA)
+check("iou_ok", K.classify([B(.1, .1, .5, .5)], [B(.1, .1, .5, .5)]) == K.NON_ERR)
+# 2개 GT 중 하나만 덮음: M=GT1 → IoU = 1/2 ≥0.3 이면 iou_ok. 3개 GT 중 하나만 덮으면 IoU=1/3→ok, 4개면 1/4 <0.3 → partial
+g4 = [B(0, 0, .2, .2), B(.3, 0, .5, .2), B(.6, 0, .8, .2), B(.0, .5, .2, .7)]
+check("partial_low_coverage", K.classify([g4[0]], g4) == "partial_low_coverage")
+# 큰 예측: GT 하나(0.1x0.1)를 포함하는 큰 box → u=1, IoU=0.01/1.0 <0.3
+check("large_pred_all_covered", K.classify([B(0, 0, 1, 1)], [B(.4, .4, .5, .5)]) == "all_covered_area_mismatch")
+# 중첩 GT: 두 주석이 겹쳐도 u_j 원값 보존, 합집합 기반
+ov = [B(0, 0, .5, .5), B(.25, .25, .75, .75)]
+check("gt_overlap_flag", K.gt_boxes_overlap(ov) and not K.gt_boxes_overlap(g4))
+# 0.3 경계: u 가 정확히 0.3 → 대응(≥). M=[0,0,0.3,1], GT=[0,0,1,1] u=0.3, IoU=0.3 → iou_ok(원 기준 <0.3 이 오류)
+check("boundary_iou_0.3_is_ok", K.classify([B(0, 0, .3, 1)], [B(0, 0, 1, 1)]) == K.NON_ERR)
+# u=0.29 단일 GT: IoU=0.29 → 오류, 겹침 양, u<0.3 → other_overlap
+check("boundary_u_0.29_other", K.classify([B(0, 0, .29, 1)], [B(0, 0, 1, 1)]) == "other_overlap")
+# 단일 GT 에서는 partial_low_coverage 로 분류되지 않는다
+check("single_gt_never_partial", K.classify([B(0, 0, .29, 1), B(.8, .8, .9, .9)], [B(0, 0, 1, 1)]) != "partial_low_coverage")
+# 독립 구현과 일치(합성 무작위 200개)
+import random
+rnd = random.Random(115)
+
+
+def rb():
+    x0, y0 = rnd.random() * .8, rnd.random() * .8
+    return B(x0, y0, x0 + .05 + rnd.random() * (.95 - x0 - .05 + .05) * .5, y0 + .05 + rnd.random() * .3)
+
+
+ok = True
+for _ in range(200):
+    m = [rb() for _ in range(rnd.randint(0, 3))]
+    g = [rb() for _ in range(rnd.randint(0, 4))]
+    m = [[a, b, min(c, 1), min(d, 1)] for a, b, c, d in m]
+    g = [[a, b, min(c, 1), min(d, 1)] for a, b, c, d in g]
+    if K.classify(m, g) != V.gtype(m, g):
+        ok = False
+check("random200_core_vs_independent_grid", ok)
+
+# ---- 원시 입력 변조 검출 (stale PASS): 원시 worker 파일 hash 만 틀리게 하면 verify_final PASS 와 무관하게 problem 발생
+real_sha = R.sha
+prov, probs = R.provenance()
+check("provenance_clean_on_real_inputs", probs == [])
+check("verify_final_all_pass_is_true_stale_candidate", prov["verify_final_all_pass"] is True)
+
+
+def tamper_sha(p):
+    return "0" * 64 if str(p).endswith("raw_worker0.jsonl") and "INIT_A" in str(p) else real_sha(p)
+
+
+R.sha = tamper_sha
+_, probs2 = R.provenance()
+R.sha = real_sha
+check("tampered_raw_detected_despite_stale_pass", any("raw input digest" in p for p in probs2))
+
+
+def tamper_ledger(p):
+    return "1" * 64 if str(p).endswith("ledger_final.json") else real_sha(p)
+
+
+R.sha = tamper_ledger
+_, probs3 = R.provenance()
+R.sha = real_sha
+check("tampered_ledger_detected", any("ledger_final" in p for p in probs3))
+
+# ---- 덮어쓰기 거부·중단 후 재개(기존 완료 파일 보존)
+with tempfile.TemporaryDirectory() as td:
+    p = Path(td) / "x.json"
+    R.wjson(p, {"a": 1})
+    try:
+        R.wjson(p, {"a": 2})
+        refused = False
+    except SystemExit:
+        refused = True
+    check("overwrite_refused", refused and json.loads(p.read_text()) == {"a": 1})
+    # 같은 입력으로 재실행해도 기존 결과를 보존(다시 쓰지 않고 digest 대조는 seal 이 수행)
+    check("no_tmp_left", not list(Path(td).glob("*.tmp")))
+
+out = {"all_pass": all(res.values()), "n": len(res), "checks": res}
+(OUT / "tests").mkdir(parents=True, exist_ok=True)
+tp = OUT / "tests/fixtures.json"
+if tp.exists():
+    print("fixtures.json exists; not overwriting")
+else:
+    tp.write_text(json.dumps(out, indent=1))
+print(json.dumps(out, indent=1))
+sys.exit(0 if out["all_pass"] else 1)
diff --git a/nr115_verify.py b/nr115_verify.py
new file mode 100644
index 0000000..24ec7b2
--- /dev/null
+++ b/nr115_verify.py
@@ -0,0 +1,166 @@
+"""iter_115 독립 검산: nr107_geom/nr113/nr114/nr115_core 를 import 하지 않고 ledger_final.json 과 report.json 에서 직접
+(1) 87/68/37/K22, 포착 16/15/13, 차별 7/6·공통 9·미포착 15, disagree 26/no_alt 16 을 재계산하고
+(2) 좌표 격자(numpy 셀 마스크)로 면적·union IoU·u_j·유형을 다시 계산해 table87.json 과 대조한다.
+"""
+import hashlib
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parent
+R114 = ROOT / "results/iter_114"
+OUT = ROOT / "results/iter_115"
+
+
+def grid_masks(sets):
+    xs = sorted({v for s in sets for b in s for v in (b[0], b[2])})
+    ys = sorted({v for s in sets for b in s for v in (b[1], b[3])})
+    if len(xs) < 2 or len(ys) < 2:
+        return None, None, [np.zeros((1, 1), bool) for _ in sets]
+    xc, yc = np.array(xs), np.array(ys)
+    cx0, cx1, cy0, cy1 = xc[:-1], xc[1:], yc[:-1], yc[1:]
+    cell = (cx1 - cx0)[:, None] * (cy1 - cy0)[None, :]
+    masks = []
+    for s in sets:
+        m = np.zeros(cell.shape, bool)
+        for b in s:
+            m |= ((cx0 >= b[0] - 1e-15) & (cx1 <= b[2] + 1e-15))[:, None] & ((cy0 >= b[1] - 1e-15) & (cy1 <= b[3] + 1e-15))[None, :]
+        masks.append(m)
+    return cell, None, masks
+
+
+def areas(a, b):
+    """a, b: box 리스트. 반환 (area a, area b, area a∩b), 빈 집합 허용."""
+    cell, _, (ma, mb) = grid_masks([a, b])
+    if cell is None:
+        return 0.0, 0.0, 0.0
+    return float((cell * ma).sum()), float((cell * mb).sum()), float((cell * (ma & mb)).sum())
+
+
+def uiou(a, b):
+    if not a or not b:
+        return 0.0
+    ua, ub, i = areas(a, b)
+    return i / (ua + ub - i) if (ua + ub - i) > 0 else 0.0
+
+
+def err(m, g):
+    return 1 if (not m or uiou(m, g) < 0.3) else 0
+
+
+def ufrac(m, g):
+    if not m:
+        return 0.0
+    ua, ug, i = areas(m, [g])
+    return i / ug
+
+
+def gtype(m, gts):
+    if not gts:
+        return "NA"
+    if not m:
+        return "empty_pred"
+    if uiou(m, gts) >= 0.3:
+        return "iou_ok"
+    ua, ug, i = areas(m, gts)
+    if i <= 1e-15:
+        return "no_overlap"
+    u = [ufrac(m, g) for g in gts]
+    if len(gts) >= 2 and any(x >= 0.3 for x in u) and any(x < 0.3 for x in u):
+        return "partial_low_coverage"
+    if all(x >= 0.3 for x in u):
+        return "all_covered_area_mismatch"
+    return "other_overlap"
+
+
+def sha(p):
+    h = hashlib.sha256()
+    h.update(Path(p).read_bytes())
+    return h.hexdigest()
+
+
+def main():
+    chk = {}
+    L = json.loads((R114 / "analysis_r1/ledger_final.json").read_text())["ledger"]
+    rep = json.loads((R114 / "analysis_r1/result_final/report.json").read_text())
+    rows = {r["item_key"]: r for r in json.loads((OUT / "table87.json").read_text())}
+    L = [l for l in L if not l.get("excluded_from_ranking")]
