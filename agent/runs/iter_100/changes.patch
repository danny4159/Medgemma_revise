diff --git a/report100_blind.py b/report100_blind.py
new file mode 100644
index 0000000..b01eeaa
--- /dev/null
+++ b/report100_blind.py
@@ -0,0 +1,64 @@
+"""iter_100: 완료된 main 생성(N/T/L)과 GPU 없는 K/A 텍스트를 조건명 없는 blind ID로 묶어 의미 검토용 파일을 만든다.
+
+- 생성 stage는 completion과 요청·protocol 검증(report100_gen의 verify)을 통과해야 한다.
+- K = 저장 초안(C-G), A = 초안 + 고정 중복 제거 후 영역 본문 전체(D01.. 순서, 의미 선택 없음). T/L/N은 모델 출력.
+- 조건명·mapping은 private_mapping.json에만 둔다. 검토 파일에는 reference 문장·atom만 포함한다(모델 입력에는 없었음).
+"""
+import hashlib
+import json
+from pathlib import Path
+
+import report100_gen as G  # C.OUT 패치 + verify 연결
+import report98_data as D
+from report86_common import save, sha
+
+C = G.C
+OUT = G.OUT
+
+
+def a_text(pk):
+    return pk["draft"].rstrip() + " " + " ".join(g["body"] for g in pk["groups"])
+
+
+def main():
+    stage = OUT / "gen" / "main"
+    req = OUT / "data" / "main" / "requests.json"
+    proto = json.loads((stage / "protocol.json").read_text())
+    workers = json.loads((stage / "mapping.json").read_text())["workers"]
+    rows, expected = C.verify(stage, str(req), proto, workers)
+    assert len(rows) == len(expected) == 6 and (stage / "completion.json").exists()
+    dec = json.loads((OUT / "data" / "eligibility_decision.json").read_text())
+    atoms = json.loads((OUT / "data" / "atom_ledger.json").read_text())["atoms"]
+    am = json.load(open(D.REF_AMEND))["patients"]
+    R = D.load_readings()
+    outputs, mapping = [], {}
+    for sel in dec["selected_patients"]:
+        img, pi = sel["ImageID"], sel["patient"]
+        pk = D.package(img, R)
+        texts = {"K": pk["draft"], "A": a_text(pk)}
+        flags = {"K": False, "A": False}
+        for c in ("N", "T", "L"):
+            r = [x for x in rows if x["id"] == "%s|%s" % (img, c)]
+            assert len(r) == 1
+            texts[c] = r[0]["text"]
+            flags[c] = not r[0]["attempts"][-1]["ended_eos"]
+        for c, t in texts.items():
+            b = hashlib.sha256(("98017|iter100|%s|%s" % (img, c)).encode()).hexdigest()[:12]
+            assert b not in mapping
+            mapping[b] = dict(ImageID=img, patient=pi, condition=c)
+            outputs.append(dict(blind_id=b, patient=pi, text=t, non_eos=flags[c], chars=len(t)))
+    outputs.sort(key=lambda o: (o["patient"], o["blind_id"]))
+    review = []
+    for sel in dec["selected_patients"]:
+        img, pi = sel["ImageID"], sel["patient"]
+        review.append(dict(patient=pi, reference_facts=[dict(fact=f["fact_id"], sentence=f["sentence_en"], cls=f["v2_class"]) for f in am[img]["facts"]],
+                           draft=D.package(img, R)["draft"], atoms_P=atoms[str(pi)]["P"], atoms_Q=atoms[str(pi)]["Q"],
+                           outputs=[o for o in outputs if o["patient"] == pi]))
+    dest = OUT / "eval" / "blind"
+    save(dest / "private_mapping.json", mapping)
+    save(dest / "review_input.json", dict(review=review, completion_sha=sha(stage / "completion.json"), source_sha=sha(__file__)))
+    print(len(outputs), "blinded outputs ->", dest)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/report100_eval.py b/report100_eval.py
new file mode 100644
index 0000000..6bffa9c
--- /dev/null
+++ b/report100_eval.py
@@ -0,0 +1,167 @@
+"""iter_100: 수동 의미 판정(judgments.json, 조건명 눈가림)에서 환자·조건별 지표와 원 분기를 계산한다.
+
+판정 스키마(blind_id별):
+  P: {atom_id: {status: preserved|deleted|negated|damaged, quote}}      (보존 대상: 초안의 reference-supported atom)
+  Q: {atom_id: {status: recovered|absent, quote, ambiguous?: bool}}      (회복 대상)
+  explicit: [{key, quote, fact, why}]     reference가 명시적으로 반박하는 주장
+  internal: [{key, quotes:[..], why}]     출력 내부의 명확한 충돌
+  unverifiable: [{key, quote, why}]       reference에 없는 검증 불가 주장
+'새' 오류 = K(초안 유지)에 없는 key. quote는 해당 출력 원문에 있어야 한다(없으면 거부). 모든 출력이 판정되어야 한다.
+안전한 회복 환자: Q 하나 이상 recovered + P 전체 preserved + K 대비 새 explicit/internal 없음.
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+from report86_common import save, sha
+
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / "results" / "iter_100"
+CONDS = ["K", "A", "N", "T", "L"]
+
+
+def load(dest=OUT / "eval"):
+    blind = json.loads((dest / "blind" / "review_input.json").read_text())
+    mapping = json.loads((dest / "blind" / "private_mapping.json").read_text())
+    judg = json.loads((dest / "judgments.json").read_text())
+    return blind, mapping, judg
+
+
+def validate(blind, mapping, judg):
+    problems = []
+    texts = dict((o["blind_id"], o["text"]) for r in blind["review"] for o in r["outputs"])
+    atoms = dict((r["patient"], (set(a["id"] for a in r["atoms_P"]), set(a["id"] for a in r["atoms_Q"]))) for r in blind["review"])
+    jb = dict((j["blind_id"], j) for j in judg["judgments"])
+    if len(jb) != len(judg["judgments"]) or set(jb) != set(texts):
+        problems.append("judgment_set_mismatch")
+    for b, j in jb.items():
+        if b not in texts:
+            continue
+        pi = mapping[b]["patient"]
+        t = texts[b].lower()
+        pids, qids = atoms[pi]
+        if set(j["P"]) != pids or set(j["Q"]) != qids:
+            problems.append("atom_set:%s" % b)
+        for d in list(j["P"].values()) + list(j["Q"].values()):
+            if d["status"] not in ("preserved", "deleted", "negated", "damaged", "recovered", "absent"):
+                problems.append("status:%s" % b)
+            if d["status"] in ("preserved", "recovered", "damaged", "negated") and d.get("quote", "").lower() not in t:
+                problems.append("quote_missing:%s" % b)
+        for k in j["explicit"] + j["unverifiable"]:
+            if k["quote"].lower() not in t:
+                problems.append("quote_missing:%s:%s" % (b, k["key"]))
+        for k in j["internal"]:
+            if not all(q.lower() in t for q in k["quotes"]):
+                problems.append("quote_missing:%s:%s" % (b, k["key"]))
+    return problems
+
+
+def per_patient(blind, mapping, judg, drop_ambiguous=False, ignore_internal=False):
+    cond = dict((b, m["condition"]) for b, m in mapping.items())
+    jb = dict((j["blind_id"], j) for j in judg["judgments"])
+    # 회복 집계는 ledger에서 clear로 잠근 Q atom만 센다. unknown/partial atom은 판정을 기록하되 회복 수에 넣지 않는다.
+    clear_q = dict((r["patient"], set(a["id"] for a in r["atoms_Q"] if a["status"] == "clear")) for r in blind["review"])
+    rows = {}
+    for b, j in jb.items():
+        pi, c = mapping[b]["patient"], cond[b]
+        rows.setdefault(pi, {})[c] = j
+    out = {}
+    for pi, byc in rows.items():
+        k = byc["K"]
+        kexp = set(x["key"] for x in k["explicit"])
+        kint = set(x["key"] for x in k["internal"])
+        kunv = set(x["key"] for x in k["unverifiable"])
+        res = {}
+        for c in CONDS:
+            j = byc[c]
+            q = [d for a, d in j["Q"].items() if a in clear_q[pi] and not (drop_ambiguous and d.get("ambiguous"))]
+            rec = sum(d["status"] == "recovered" for d in q)
+            pdam = sum(d["status"] != "preserved" for d in j["P"].values())
+            nexp = len(set(x["key"] for x in j["explicit"]) - kexp)
+            nint = 0 if ignore_internal else len(set(x["key"] for x in j["internal"]) - kint)
+            nunv = len(set(x["key"] for x in j["unverifiable"]) - kunv)
+            res[c] = dict(Q_recovered=rec, Q_total=len(q), P_damaged=pdam, P_total=len(j["P"]), new_explicit=nexp, new_internal=nint,
+                          new_unverifiable=nunv, safe_recovery=bool(rec >= 1 and pdam == 0 and nexp == 0 and nint == 0),
+                          harm=bool(pdam > 0 or nexp > 0 or nint > 0))
+        out[pi] = res
+    return out
+
+
+def decide(role, table):
+    """원 계획의 분기. recovery 환자 수 N이 작으면 양성 기준(최소 3명/순증가 2명)은 충족 불가능으로 기록한다."""
+    rec = [p for p in table if role[p] == "recovery"]
+    n = len(rec)
+
+    def net(a, b):
+        return sum(table[p][a]["safe_recovery"] for p in rec) - sum(table[p][b]["safe_recovery"] for p in rec)
+
+    def harm(c):
+        return sum(table[p][c]["harm"] for p in table)
+    safe_T = sum(table[p]["T"]["safe_recovery"] for p in rec)
+    safe_L = sum(table[p]["L"]["safe_recovery"] for p in rec)
+    d = dict(n_recovery=n, n_total=len(table),
+             safe_recovery_patients=dict((c, sum(table[p][c]["safe_recovery"] for p in rec)) for c in CONDS),
+             harm_patients=dict((c, harm(c)) for c in CONDS),
+             net_T_vs_N=net("T", "N"), net_T_vs_A=net("T", "A"), net_L_vs_N=net("L", "N"), net_L_vs_A=net("L", "A"), net_L_vs_T=net("L", "T"),
+             positive_criterion_satisfiable=n >= 3)
+    t_or_l = max(safe_T, safe_L)
+    d["positive"] = bool(t_or_l >= 3 and max(net("T", "N"), net("L", "N")) >= 2 and max(net("T", "A"), net("L", "A")) >= 2)
+    d["source_effect"] = bool(d["positive"] and net("L", "T") >= 2)
+    d["outcome"] = ("insufficient_sample: 원 양성 기준(최소 3명)을 충족할 수 없는 사례 관찰" if n < 3
+                    else ("positive_exploration" if d["positive"] else "no_gain_or_uncertain"))
+    return d
+
+
+def boot(role, table, seed=98017, B=10000):
+    """환자 bootstrap(조건별 safe_recovery 평균 차이). 환자 수가 작으면 퇴화 구간이며 확증이 아니다."""
+    pats = sorted(table)
+    rng = np.random.default_rng(seed)
+    res = {}
+    for a, b in (("T", "K"), ("L", "K"), ("T", "N"), ("L", "N"), ("T", "A"), ("L", "A"), ("L", "T")):
+        v = np.array([int(table[p][a]["safe_recovery"]) - int(table[p][b]["safe_recovery"]) for p in pats], float)
+        idx = rng.integers(0, len(pats), (B, len(pats)))
+        m = v[idx].mean(1)
+        res["%s-%s" % (a, b)] = dict(mean=float(v.mean()), lo=float(np.percentile(m, 2.5)), hi=float(np.percentile(m, 97.5)),
+                                     degenerate=bool(len(set(v.tolist())) == 1))
+    return res
+
+
+def loo(role, table):
+    out = {}
+    for drop in sorted(table):
+        sub = dict((p, v) for p, v in table.items() if p != drop)
+        sub_role = dict((p, role[p]) for p in sub)
+        out[str(drop)] = decide(sub_role, sub) if sub else None
+    return out
+
+
+def main():
+    dest = OUT / "eval"
+    blind, mapping, judg = load(dest)
+    probs = validate(blind, mapping, judg)
+    assert not probs, probs
+    dec = json.loads((OUT / "data" / "eligibility_decision.json").read_text())
+    role = dict((s["patient"], s["role"]) for s in dec["selected_patients"])
+    table = per_patient(blind, mapping, judg)
+    table_na = per_patient(blind, mapping, judg, drop_ambiguous=True)
+    table_ni = per_patient(blind, mapping, judg, ignore_internal=True)
+    # 검증 불가 증가 환자 제외 분석
+    excl = dict((p, v) for p, v in table.items() if all(v[c]["new_unverifiable"] == 0 for c in ("T", "L", "N", "A")))
+    report = dict(table=table, decision=decide(role, table),
+                  sensitivity_exclude_ambiguous=decide(role, table_na),
+                  sensitivity_ignore_internal_conflicts=dict(decision=decide(role, table_ni), table=table_ni,
+                                                             note="사후 민감도: 내부 충돌 판정이 결과를 가르는지 보기 위한 것이며 원 기준이 아니다"),
+                  sensitivity_exclude_unverifiable_increase=decide({p: role[p] for p in excl}, excl) if excl else None,
+                  excluded_for_unverifiable=sorted(set(table) - set(excl)),
+                  bootstrap_seed98017=boot(role, table), leave_one_patient_out=loo(role, table),
+                  provenance=dict(judgments_sha=sha(dest / "judgments.json"), review_input_sha=sha(dest / "blind" / "review_input.json"),
+                                  mapping_sha=sha(dest / "blind" / "private_mapping.json"), eval_sha=sha(__file__)),
+                  note="assistant 단일 수동 검토이며 전문의/독립 임상 평가가 아니다. 눈가림은 조건명 제거 수준이다.")
+    save(dest / "report_v2.json", report)
+    print(json.dumps(report["decision"], ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/report100_gen.py b/report100_gen.py
new file mode 100644
index 0000000..69791d2
--- /dev/null
+++ b/report100_gen.py
@@ -0,0 +1,125 @@
+"""iter_100: 기존 생성 연산(report90_gen/report90_gen_safe/report90_recovery_gen)을 유지하고 출력·cache를 iter_100으로 격리한다.
+
+report97_gen.py와 같은 구조이며 launch만 다음을 보강한다(생성 수식·protocol은 그대로).
+- attempt 번호를 기존 로그 파일 이름에서 정해 비정상 종료 후 재시작 시 로그 충돌을 피한다.
+- worker는 report90_gen.worker의 허용 GPU 집합 검사(--gpu in CUDA_VISIBLE_DEVICES)를 그대로 쓰고, launch의 장치 선택도 허용 집합 안으로 한정한다.
+- worker 시작 직전 매번 nvidia-smi로 실제 free를 다시 읽고, 이미 시작한 살아 있는 worker마다 (peak - 현재 점유 + 2GiB)를 예약으로 차감한다.
+"""
+import argparse
+import fcntl
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import report90_gen as C
+import report90_gen_safe as S
+import report90_recovery_gen as RG  # noqa: F401  load_model·SOURCES 패치 적용
+from report86_common import save, sha, sha_obj
+
+OUT = Path(__file__).resolve().parent / 'results/iter_100'
+C.OUT = OUT
+C.SOURCES = C.SOURCES + ['report100_gen.py']
+C.__file__ = __file__
+
+
+def next_attempt(out):
+    nums = [int(m.group(1)) for p in Path(out).glob('launch*_worker*.stdout.log') for m in [re.match(r'launch(\d+)_worker', p.name)] if m]
+    return max(nums) + 1 if nums else 0
+
+
+def launch(a):
+    out = Path(a.out).resolve()
+    out.relative_to(C.OUT)
+    out.mkdir(parents=True, exist_ok=True)
+    with (out / 'launcher.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        proto = C.protocol(a.requests, a.checkpoint)
+        for path, value in [(out / 'protocol.json', proto), (out / 'mapping.json', dict(workers=a.workers))]:
+            if path.exists():
+                import json
+                assert json.loads(path.read_text()) == value, ('protocol/mapping changed', path)
+            else:
+                save(path, value)
+        # 부분 행 복구는 worker lock을 소유한 상태에서만 한다.
+        for s in range(a.workers):
+            with (out / f'worker_{s}.lock').open('a') as wl:
+                fcntl.flock(wl, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                from pg43_run import repair_tail
+                repair_tail(str(out / f'worker_{s}.jsonl'))
+        existing, expected = C.verify(out, a.requests, proto, a.workers)
+        if len(existing) == len(expected):
+            cp = out / 'completion.json'
+            completion = dict(n=len(existing), protocol_digest=sha_obj(proto),
+                              files={str(out / f'worker_{s}.jsonl'): sha(out / f'worker_{s}.jsonl') for s in range(a.workers)})
+            if cp.exists():
+                import json
+                assert json.loads(cp.read_text()) == completion
+            else:
+                save(cp, completion)
+            return 0
+        allowed = os.environ['CUDA_VISIBLE_DEVICES'].split(',')
+        procs, logs = [], []
+        attempt = next_attempt(out)
+        start = time.monotonic()
+
+        def stop(*args):
+            raise KeyboardInterrupt('supervisor stopped; terminating owned children')
+        signal.signal(signal.SIGTERM, stop)
+        try:
+            for s in range(a.workers):
+                raw = subprocess.check_output(['nvidia-smi', '--query-gpu=index,memory.free', '--format=csv,noheader,nounits'], text=True)
+                free = {x.split(',')[0].strip(): int(x.split(',')[1]) for x in raw.splitlines()}
+                usage = subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid,used_memory', '--format=csv,noheader,nounits'], text=True)
+                actual = {int(x.split(',')[0]): int(x.split(',')[1]) for x in usage.splitlines() if x.strip()}
+                choices = {g: free[g] - sum(max(0, a.peak_mib - actual.get(p.pid, 0)) + 2048 for _, p, gg in procs if gg == g and p.poll() is None)
+                           for g in allowed}
+                gpu = max(choices, key=choices.get)
+                assert choices[gpu] >= a.peak_mib + 2048, ('memory admission', choices)
+                cmd = [sys.executable, __file__, 'worker', '--requests', a.requests, '--out', str(out), '--gpu', gpu, '--shard', str(s),
+                       '--workers', str(a.workers)]
+                if a.checkpoint:
+                    cmd += ['--checkpoint', a.checkpoint]
+                if a.limit:
+                    cmd += ['--limit', str(a.limit)]
+                so = (out / f'launch{attempt}_worker{s}.stdout.log').open('x')
+                se = (out / f'launch{attempt}_worker{s}.stderr.log').open('x')
+                logs.extend([so, se])
+                procs.append((s, subprocess.Popen(cmd, stdout=so, stderr=se), gpu))
+                time.sleep(a.stagger)
+            codes = {s: p.wait() for s, p, _ in procs}
+        finally:
+            for _, p, _ in procs:
+                if p.poll() is None:
+                    p.terminate()
+            for _, p, _ in procs:
+                p.wait()
+            for f in logs:
+                f.close()
+        save(out / f'launch_{attempt:03}.json', dict(codes=codes, wall_s=time.monotonic() - start, mapping={s: g for s, _, g in procs},
+                                                      protocol_digest=sha_obj(proto), allowed=allowed))
+        assert all(c == 0 for c in codes.values())
+        recs, expected = C.verify(out, a.requests, proto, a.workers)
+        if len(recs) == len(expected):
+            save(out / 'completion.json', dict(n=len(recs), protocol_digest=sha_obj(proto),
+                                               files={str(out / f'worker_{s}.jsonl'): sha(out / f'worker_{s}.jsonl') for s in range(a.workers)}))
+        return 0 if len(recs) == len(expected) or a.limit else 2
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('command', choices=['worker', 'launch'])
+    p.add_argument('--requests', required=True)
+    p.add_argument('--out', required=True)
+    p.add_argument('--checkpoint')
+    p.add_argument('--workers', type=int, default=1)
+    p.add_argument('--shard', type=int, default=0)
+    p.add_argument('--gpu')
+    p.add_argument('--limit', type=int, default=0)
+    p.add_argument('--peak-mib', type=int, default=12000)
+    p.add_argument('--stagger', type=float, default=20.0)
+    a = p.parse_args()
+    raise SystemExit(C.worker(a) if a.command == 'worker' else launch(a))
diff --git a/report100_gencheck.py b/report100_gencheck.py
new file mode 100644
index 0000000..6cd41f6
--- /dev/null
+++ b/report100_gencheck.py
@@ -0,0 +1,70 @@
+"""iter_100 생성 경로 검사: (1) 재개/worker 수가 다른 실행 간 token 정합성, (2) 래퍼(LoRA 장착, 항등 초기화)와 공식 무패치 모델의 greedy 출력 비교.
+
+(2)는 GPU 하나를 쓴다. 공식 경로는 processor.apply_chat_template + model.generate(do_sample=False, use_cache 기본값).
