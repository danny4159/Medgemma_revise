+        files={n: sha_file(out / n) for n in ("atom_ledger.json", "eligibility_decision.json")},
+        N=n_cohort, controls=controls, run_generation=bool(n_cohort)), ensure_ascii=False, indent=1))
+    print(json.dumps(dict(N=n_cohort, controls=controls, finding_only=decision["scenario_finding_only"], run_generation=bool(n_cohort),
+                          order=order), ensure_ascii=False))
+    return 0, []
+
+
+if __name__ == "__main__":
+    rc, probs = build()
+    if probs:
+        print(json.dumps(probs, ensure_ascii=False, indent=1))
+    sys.exit(rc)
diff --git a/report100_req.py b/report100_req.py
new file mode 100644
index 0000000..8c5cf93
--- /dev/null
+++ b/report100_req.py
@@ -0,0 +1,149 @@
+"""iter_100 교정 요청 구성: N(근거 없음) / T(영역 본문) / L(같은 본문 + 실제 질의 영역 이름). K/A는 GPU 요청 없음.
+
+모델 입력에는 reference·P/Q·평가 라벨·정답 bbox를 넣지 않는다. 영역 본문은 29개 전부(좌표·헤더 제거, 공백 정규화, 정확 중복 제거만).
+"""
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+
+import report98_data as D
+from report86_common import save, sha, sha_obj
+
+ROOT = D.ROOT
+OUT = ROOT / "results" / "iter_100"
+LOCK = OUT / "data" / "eligibility_decision.json"
+D8_INPUTS = ROOT / "results" / "iter_085" / "D8" / "inputs.json"
+D8_READINGS = ROOT / "results" / "iter_086" / "D8" / "readings.jsonl"
+CONDS = ["N", "T", "L"]
+
+HEAD = "Below is a draft report for the attached chest X-ray.\n\nDraft report:\n%s\n\nAutomatically generated region notes (they may be incorrect):\n%s\n\n"
+TASK = ("Task: Review the draft report against the image. Keep every statement of the draft that is supported by the image. "
+        "Change or add a statement only when the image or a note supports it, and do not copy note statements that you cannot verify on the image. "
+        "Output only the final revised report text.")
+
+
+def notes(pk, cond):
+    if cond == "N":
+        return "(none)"
+    lines = []
+    for g in pk["groups"]:
+        if cond == "T":
+            lines.append("%s: %s" % (g["gid"], g["body"]))
+        else:
+            lines.append("%s (generated for region: %s): %s" % (g["gid"], "; ".join(g["regions"]), g["body"]))
+    return "\n".join(lines)
+
+
+def prompt(pk, cond):
+    return HEAD % (pk["draft"], notes(pk, cond)) + TASK
+
+
+def build_requests(items, readings):
+    """items: [(ImageID, image_path, file_sha256)] -> 요청 목록(환자 순서 고정, 조건 N,T,L)과 검사 기록."""
+    reqs, info = [], []
+    for img, path, fsha in items:
+        assert sha(path) == fsha, ("image hash mismatch", img)
+        pk = D.package(img, readings)
+        for c in CONDS:
+            reqs.append(dict(id="%s|%s" % (img, c), image=str(path), file_sha256=fsha, prompt=prompt(pk, c)))
+        info.append(dict(ImageID=img, n_groups=len(pk["groups"]), draft_chars=len(pk["draft"]),
+                         body_chars=sum(len(g["body"]) for g in pk["groups"])))
+    return reqs, info
+
+
+def leak_check(reqs, refs):
+    """요청 prompt에 reference 문장·평가 라벨이 들어갔는지(문장 전체 일치) 검사한다. 문제 목록 반환."""
+    bad = []
+    for r in reqs:
+        img = r["id"].split("|")[0]
+        for s in refs.get(img, []):
+            if s.lower().strip(". ") and len(s) > 25 and s.lower() in r["prompt"].lower():
+                bad.append(dict(id=r["id"], sentence=s))
+        for w in ("P/Q", "reference", "ground truth", "recovery", "preservation"):
+            if w in r["prompt"].lower():
+                bad.append(dict(id=r["id"], word=w))
+    return bad
+
+
+def tl_identity(reqs, readings):
+    """T/L 본문 byte 동일성(헤더 제거 후 gid와 본문이 일치), 순서 동일, L 출처 = 실제 저장 source, N 동일 template을 검사한다."""
+    problems = []
+    for img in sorted(set(r["id"].split("|")[0] for r in reqs)):
+        pk = D.package(img, readings)
+        by = dict((r["id"].split("|")[1], r) for r in reqs if r["id"].startswith(img + "|"))
+        if sorted(by) != sorted(CONDS):
+            problems.append(dict(img=img, problem="conditions"))
+            continue
+        for c in CONDS:
+            if by[c]["image"] != by["N"]["image"] or by[c]["file_sha256"] != by["N"]["file_sha256"]:
+                problems.append(dict(img=img, cond=c, problem="image_differs"))
+            if not by[c]["prompt"].endswith(TASK) or pk["draft"] not in by[c]["prompt"]:
+                problems.append(dict(img=img, cond=c, problem="template_or_draft"))
+        t_lines = by["T"]["prompt"].split("(they may be incorrect):\n")[1].split("\n\n" + "Task:")[0].split("\n")
+        l_lines = by["L"]["prompt"].split("(they may be incorrect):\n")[1].split("\n\n" + "Task:")[0].split("\n")
+        if len(t_lines) != len(l_lines) or len(t_lines) != len(pk["groups"]):
+            problems.append(dict(img=img, problem="group_count"))
+            continue
+        for g, tl, ll in zip(pk["groups"], t_lines, l_lines):
+            tg, tb = tl.split(": ", 1)
+            m = re.match(r"^(D\d\d) \(generated for region: (.*?)\): (.*)$", ll, re.S)
+            if not m or tg != g["gid"] or tb != g["body"] or m.group(1) != g["gid"] or m.group(3) != tb.strip() \
+                    or m.group(2).split("; ") != g["regions"]:
+                problems.append(dict(img=img, gid=g["gid"], problem="T_L_mismatch"))
+        if "(none)" not in by["N"]["prompt"]:
+            problems.append(dict(img=img, problem="N_notes"))
+    return problems
+
+
+def d8_items(n=4):
+    """기술 검사용 D8 4명: 총 입력(본문 길이)이 가장 긴 환자 1명 + 나머지는 sha256('report100_d8|'+ImageID) 오름차순 3명. E96과 환자/study/영상 비중복 확인."""
+    d8 = json.load(open(D8_INPUTS))
+    E = D.load_inputs()
+    pe, se, ie = set(i["PatientID"] for i in E), set(i["StudyID"] for i in E), set(i["ImageID"] for i in E)
+    R = D.load_readings(D8_READINGS)
+    for i in d8:
+        assert i["PatientID"] not in pe and i["StudyID"] not in se and i["ImageID"] not in ie
+    size = dict((i["ImageID"], len(D.package(i["ImageID"], R)["draft"]) + sum(len(g["body"]) for g in D.package(i["ImageID"], R)["groups"])) for i in d8)
+    longest = max(d8, key=lambda i: size[i["ImageID"]])
+    rest = sorted([i for i in d8 if i is not longest], key=lambda i: hashlib.sha256(("report100_d8|" + i["ImageID"]).encode()).hexdigest())
+    return [longest] + rest[:n - 1], R, size
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("stage", choices=["D8", "main"])
+    a = ap.parse_args()
+    dest = OUT / "data" / a.stage
+    if a.stage == "D8":
+        sel, R, size = d8_items()
+        items = [(i["ImageID"], i["image"], i["file_sha256"]) for i in sel]
+        meta = dict(patients=[i["ImageID"] for i in sel], input_size_chars=dict((i["ImageID"], size[i["ImageID"]]) for i in sel),
+                    source_inputs=str(D8_INPUTS), source_readings=str(D8_READINGS), source_inputs_sha=sha(D8_INPUTS), source_readings_sha=sha(D8_READINGS))
+        refs = {}
+    else:
+        dec = json.loads(LOCK.read_text())
+        assert (OUT / "data" / "lock_complete.json").exists() and dec["run_generation"]
+        lc = json.loads((OUT / "data" / "lock_complete.json").read_text())
+        assert all(sha(OUT / "data" / n) == h for n, h in lc["files"].items())
+        E = dict((i["ImageID"], i) for i in D.load_inputs())
+        sel_ids = [s["ImageID"] for s in dec["selected_patients"]]
+        items = [(i, E[i]["image"], E[i]["file_sha256"]) for i in sel_ids]
+        R = D.load_readings()
+        am = json.load(open(D.REF_AMEND))["patients"]
+        refs = dict((i, [f["sentence_en"] for f in am[i]["facts"]]) for i in sel_ids)
+        meta = dict(patients=sel_ids, roles=dict((s["ImageID"], s["role"]) for s in dec["selected_patients"]), lock_complete_sha=sha(OUT / "data" / "lock_complete.json"))
+    reqs, info = build_requests(items, R)
+    probs = leak_check(reqs, refs) + tl_identity(reqs, R)
+    assert not probs, probs
+    assert len(set(r["id"] for r in reqs)) == len(reqs)
+    save(dest / "requests.json", reqs)
+    save(dest / "manifest.json", dict(stage=a.stage, n_requests=len(reqs), requests_sha=sha(dest / "requests.json"), per_patient=info, meta=meta,
+                                      checks=dict(leak_check="reference 문장/평가 단어 없음", tl_identity="T/L 본문·gid·순서 동일, L 출처=저장 source", n_conditions=3),
+                                      source_sha=dict(req=sha(__file__), data=sha(ROOT / "report98_data.py"))))
+    print(a.stage, len(reqs), "requests ->", dest)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/report100_tech.py b/report100_tech.py
new file mode 100644
index 0000000..21fe64e
--- /dev/null
+++ b/report100_tech.py
@@ -0,0 +1,165 @@
+"""iter_100 기술 검사(D8 12요청): 2 worker 처리량·peak, 가능하면 4 worker, 중단(limit)→재개, 완료 후 재실행, 요청/완료 변조 거부, worker 수 간 token 정합성.
+
+내용 정답률은 gate가 아니다. 각 단계는 새 out 디렉터리를 쓰고 기존 결과를 덮어쓰지 않는다. 단계는 --step으로 하나씩 실행한다(재시작 가능).
+"""
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+from report86_common import read_jsonl_complete, save, sha
+
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / "results" / "iter_100"
+REQ = OUT / "data" / "D8" / "requests.json"
+TECH = OUT / "tech"
+
+
+class Sampler(threading.Thread):
+    """1초 간격으로 GPU별 used 메모리와 프로세스별 점유를 기록한다(관측 peak)."""
+
+    def __init__(self):
+        super().__init__(daemon=True)
+        self.stop = threading.Event()
+        self.peak = {}
+        self.proc_peak = {}
+        self.n = 0
+
+    def run(self):
+        while not self.stop.is_set():
+            try:
+                g = subprocess.check_output(["nvidia-smi", "--query-gpu=index,memory.used", "--format=csv,noheader,nounits"], text=True)
+                for ln in g.splitlines():
+                    i, u = [x.strip() for x in ln.split(",")]
+                    self.peak[i] = max(self.peak.get(i, 0), int(u))
+                p = subprocess.check_output(["nvidia-smi", "--query-compute-apps=pid,used_memory", "--format=csv,noheader,nounits"], text=True)
+                for ln in p.splitlines():
+                    if ln.strip():
+                        pid, u = [x.strip() for x in ln.split(",")]
+                        self.proc_peak[pid] = max(self.proc_peak.get(pid, 0), int(u))
+                self.n += 1
+            except Exception:
+                pass
+            self.stop.wait(1.0)
+
+
+RESUME_REQ = TECH / "requests_resume8.json"
+
+
+def resume_requests():
+    """재개 검사용 8요청: D8의 N/T 조건만(비EOS 확장이 없던 짧은 요청). 기준은 D8_w2의 같은 요청 token."""
+    if not RESUME_REQ.exists():
+        TECH.mkdir(parents=True, exist_ok=True)
+        save(RESUME_REQ, [r for r in json.loads(REQ.read_text()) if r["id"].endswith("|N") or r["id"].endswith("|T")])
+    return RESUME_REQ
+
+
+def gen(args, out, log, req=None):
+    cmd = [sys.executable, "report100_gen.py", "launch", "--requests", str(req or REQ), "--out", str(out)] + args
+    with open(str(log) + ".out", "x") as so, open(str(log) + ".err", "x") as se:
+        t = time.monotonic()
+        rc = subprocess.run(cmd, stdout=so, stderr=se, cwd=str(ROOT)).returncode
+    return rc, time.monotonic() - t
+
+
+def recs(out, workers):
+    r = []
+    for s in range(workers):
+        r += read_jsonl_complete(Path(out) / f"worker_{s}.jsonl")
+    return r
+
+
+def toks(r):
+    return [x["suffix_ids"] for x in r["attempts"]]
+
+
+def summarize(out, workers, wall, smp):
+    r = recs(out, workers)
+    n_new = [x["attempts"][-1]["n_new"] for x in r]
+    return dict(n_records=len(r), n_unique=len(set(x["id"] for x in r)), all_eos=all(x["attempts"][-1]["ended_eos"] for x in r),
+                n_attempts=[len(x["attempts"]) for x in r], input_tokens=[len(x["input_ids"]) for x in r], new_tokens=n_new,
+                wall_s=wall, req_per_min=len(r) / wall * 60 if wall else None, gpu_peak_used_mib=smp.peak, proc_peak_mib=smp.proc_peak,
+                gpus=sorted(set(x["gpu"] for x in r)))
+
+
+def step(name, args, workers, req=None):
+    out = OUT / "gen" / name
+    if out.exists():
+        raise SystemExit("exists: %s" % out)
+    TECH.mkdir(parents=True, exist_ok=True)
+    smp = Sampler()
+    smp.start()
+    rc, wall = gen(args + ["--workers", str(workers)], out, TECH / name, req)
+    smp.stop.set()
+    res = dict(name=name, rc=rc, workers=workers, args=args, **(summarize(out, workers, wall, smp) if out.exists() else dict(wall_s=wall)))
+    save(TECH / f"{name}.json", res)
+    print(json.dumps({k: res[k] for k in ("name", "rc", "n_records", "req_per_min", "gpu_peak_used_mib") if k in res}))
+    return res
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("step", choices=["w2", "w4", "resume_a", "resume_b", "rerun", "tamper"])
+    ap.add_argument("--peak-mib", type=int, default=12000)
+    a = ap.parse_args()
+    pk = ["--peak-mib", str(a.peak_mib)]
+    if a.step == "w2":
+        step("D8_w2", pk, 2)
+    elif a.step == "w4":
+        step("D8_w4", pk, 4)
+    elif a.step == "resume_a":
+        step("D8_resume", pk + ["--limit", "2"], 2, resume_requests())
+    elif a.step == "resume_b":
+        out = OUT / "gen" / "D8_resume"
+        smp = Sampler()
+        smp.start()
+        rc, wall = gen(pk + ["--workers", "2"], out, TECH / "D8_resume_b", resume_requests())
+        smp.stop.set()
+        res = dict(name="D8_resume_b", rc=rc, **summarize(out, 2, wall, smp))
+        save(TECH / "D8_resume_b.json", res)
+        print(json.dumps({k: res[k] for k in ("rc", "n_records")}))
+    elif a.step == "rerun":
+        out = OUT / "gen" / "D8_w2"
+        before = dict((p.name, sha(p)) for p in sorted(out.glob("worker_*.jsonl")))
+        rc, wall = gen(pk + ["--workers", "2"], out, TECH / "D8_w2_rerun")
+        after = dict((p.name, sha(p)) for p in sorted(out.glob("worker_*.jsonl")))
+        save(TECH / "D8_w2_rerun.json", dict(rc=rc, unchanged=before == after, wall_s=wall))
+        print(rc, before == after)
+    elif a.step == "tamper":
+        base = OUT / "gen" / "D8_w2"
+        res = {}
+        # (1) 다른 요청 파일로 같은 출력 경로 재실행 -> 거부
+        sub = TECH / "requests_subset.json"
+        save(sub, json.loads(REQ.read_text())[:11])
+        cmd = [sys.executable, "report100_gen.py", "launch", "--requests", str(sub), "--out", str(base), "--workers", "2"] + pk
+        with open(str(TECH / "tamper_requests.out"), "x") as so, open(str(TECH / "tamper_requests.err"), "x") as se:
+            res["changed_requests_rc"] = subprocess.run(cmd, stdout=so, stderr=se, cwd=str(ROOT)).returncode
+        # (2) 완료 사본의 worker 출력 한 글자 변조 -> 거부(원본은 건드리지 않고 복사본에서 시험)
+        cp = OUT / "gen" / "D8_w2_tampered_copy"
+        shutil.copytree(base, cp, ignore=shutil.ignore_patterns("launcher.lock", "worker_*.lock", "*.log"))
+        w = cp / "worker_0.jsonl"
+        data = w.read_text()
+        w.write_text(data.replace('"text": "', '"text": "X', 1))
+        cmd = [sys.executable, "report100_gen.py", "launch", "--requests", str(REQ), "--out", str(cp), "--workers", "2"] + pk
+        with open(str(TECH / "tamper_output.out"), "x") as so, open(str(TECH / "tamper_output.err"), "x") as se:
+            res["tampered_output_rc"] = subprocess.run(cmd, stdout=so, stderr=se, cwd=str(ROOT)).returncode
+        # (3) 요청 prompt 변조 사본
+        rq = json.loads(REQ.read_text())
+        rq[0]["prompt"] += " "
+        bad = TECH / "requests_prompt_changed.json"
+        save(bad, rq)
+        cmd = [sys.executable, "report100_gen.py", "launch", "--requests", str(bad), "--out", str(base), "--workers", "2"] + pk
+        with open(str(TECH / "tamper_prompt.out"), "x") as so, open(str(TECH / "tamper_prompt.err"), "x") as se:
+            res["changed_prompt_rc"] = subprocess.run(cmd, stdout=so, stderr=se, cwd=str(ROOT)).returncode
+        res["original_unchanged"] = sha(base / "worker_0.jsonl") == json.loads((base / "completion.json").read_text())["files"][str(base / "worker_0.jsonl")]
+        save(TECH / "tamper_result.json", res)
+        print(res)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/report100_verify.py b/report100_verify.py
new file mode 100644
index 0000000..7ce8836
--- /dev/null
+++ b/report100_verify.py
@@ -0,0 +1,58 @@
+"""iter_100 산술 재계산: judgments.json을 report100_eval을 import하지 않고 다시 읽어 환자·조건별 지표를 계산해 report_v2.json과 대조한다.
+의미 라벨(judgments)은 같은 입력이므로 이 검사는 독립 의미 검증이 아니다. 또한 생성 비용·비EOS 기록을 원시 worker 파일에서 집계한다."""
+import json
+from pathlib import Path
+
+from report86_common import read_jsonl_complete, save, sha
+
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / "results" / "iter_100"
+
+
+def main():
+    ev = OUT / "eval"
+    judg = json.loads((ev / "judgments.json").read_text())["judgments"]
+    mp = json.loads((ev / "blind" / "private_mapping.json").read_text())
+    rep = json.loads((ev / "report_v2.json").read_text())
+    ri = json.loads((ev / "blind" / "review_input.json").read_text())["review"]
+    clearq = {}
+    for r in ri:
+        clearq[r["patient"]] = [a["id"] for a in r["atoms_Q"] if a["status"] == "clear"]
+    by = {}
+    for j in judg:
+        m = mp[j["blind_id"]]
+        by.setdefault(m["patient"], {})[m["condition"]] = j
+    mismatches, table = [], {}
+    for pi, cs in by.items():
+        kk = lambda j, f: set(x["key"] for x in j[f])
+        for c, j in cs.items():
+            rec = sum(1 for a in clearq[pi] if j["Q"][a]["status"] == "recovered")
+            pdam = sum(1 for v in j["P"].values() if v["status"] != "preserved")
+            ne = len(kk(j, "explicit") - kk(cs["K"], "explicit"))
+            ni = len(kk(j, "internal") - kk(cs["K"], "internal"))
+            nu = len(kk(j, "unverifiable") - kk(cs["K"], "unverifiable"))
+            safe = rec >= 1 and pdam == 0 and ne == 0 and ni == 0
+            table.setdefault(str(pi), {})[c] = dict(Q_recovered=rec, P_damaged=pdam, new_explicit=ne, new_internal=ni, new_unverifiable=nu, safe_recovery=safe)
+            ref = rep["table"][str(pi)][c]
+            for k, v in table[str(pi)][c].items():
+                if ref[k] != v:
+                    mismatches.append((pi, c, k, ref[k], v))
+    # 비용·EOS: 원시 worker 파일
+    recs = []
+    for s in range(2):
+        recs += read_jsonl_complete(OUT / "gen" / "main" / f"worker_{s}.jsonl")
+    ids = [r["id"] for r in recs]
+    launch = json.loads((OUT / "gen" / "main" / "launch_000.json").read_text())
+    cost = dict(n_requests=len(recs), unique=len(set(ids)),
+                per_request=[dict(id=r["id"].split("|")[1] + "|" + r["id"][:6], input_tokens=len(r["input_ids"]),
+                                  attempts=[a["n_new"] for a in r["attempts"]], ended_eos=r["attempts"][-1]["ended_eos"]) for r in sorted(recs, key=lambda r: r["id"])],
+                non_eos=sum(not r["attempts"][-1]["ended_eos"] for r in recs), launch_wall_s_incl_loading=launch["wall_s"],
+                gpu_mapping=launch["mapping"], generated_tokens_total=sum(sum(a["n_new"] for a in r["attempts"]) for r in recs))
+    out = dict(n_mismatch=len(mismatches), mismatches=mismatches, cost=cost, report_sha=sha(ev / "report_v2.json"),
+               note="산술 재계산만 수행. 의미 판정의 독립 검증이 아님")
+    save(ev / "verify.json", out)
+    print(json.dumps(dict(n_mismatch=len(mismatches), non_eos=cost["non_eos"], wall=cost["launch_wall_s_incl_loading"], tokens=cost["generated_tokens_total"])))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/report100_view.py b/report100_view.py
new file mode 100644
index 0000000..3fbd0cf
