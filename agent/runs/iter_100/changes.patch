+    out["official_vs_wrapper"] = off
+    out["note"] = "공식 경로는 generate 기본 use_cache. 첫 차이는 bf16 kernel/cache 경로 차이일 수 있어 원인을 단정하지 않는다."
+    save(OUT / "tech" / "gencheck.json", out)
