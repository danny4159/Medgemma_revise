+++ b/rsna_diag/roi26_gen.py
@@ -0,0 +1,226 @@
+"""iter_026 전용 생성 worker (roi25_gen.py 기반, 동일 claim/재개/변조 거부 규약)."""
+import argparse
+import glob
+import json
+import os
+import re
+import sys
+import time
+
+from . import generate, roi26_protocol as qa_protocol, roi26_requests as Q, queue_lock
+
+
+class QAError(RuntimeError):
+    pass
+
+
+def read_strict(path, repair_tail=False, tolerate_tail=False):
+    if not os.path.exists(path):
+        return []
+    raw = open(path, "rb").read()
+    lines = raw.split(b"\n")
+    tail = lines[-1]
+    recs = []
+    body = lines[:-1]
+    if tail.strip() and tolerate_tail:
+        pass
+    elif tail.strip():
+        if repair_tail:
+            with open(path + ".partial", "ab") as f:
+                f.write(tail + b"\n")
+            with open(path, "wb") as f:
+                f.write(b"\n".join(body) + (b"\n" if body else b""))
+        else:
+            raise QAError(f"truncated last line (no newline) in {path}; rerun with --repair-tail to quarantine it")
+    for k, ln in enumerate(body):
+        if ln.strip():
+            try:
+                recs.append(json.loads(ln))
+            except ValueError as e:
+                raise QAError(f"corrupt JSON line {k} in {path}") from e
+    return recs
+
+
+def _worker_of(path):
+    m = re.fullmatch(r"gen_worker(\d+)\.jsonl", os.path.basename(path))
+    return int(m.group(1)) if m else None
+
+
+def _has_tail(path):
+    if not os.path.exists(path):
+        return False
+    with open(path, "rb") as f:
+        data = f.read()
+    return bool(data.split(b"\n")[-1].strip())
+
+
+def read_all_owned(out_dir, my_worker, repair, live, info):
+    out = {}
+    for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        w = _worker_of(f)
+        if w == my_worker or not _has_tail(f):
+            out[f] = read_strict(f, repair_tail=repair and w == my_worker and not live)
+            continue
+        lk, _, _ = queue_lock.try_lock(os.path.join(out_dir, f"worker{w}.lock"), info)
+        if lk is None:
+            out[f] = read_strict(f, tolerate_tail=True)
+        else:
+            try:
+                out[f] = read_strict(f, repair_tail=repair and not live, tolerate_tail=live)
+            finally:
+                lk.release()
+    return out
+
+
+def validate_records(files_records, rows, cdig, adapter_digest, protocol_digest, pixel_sha):
+    by = {r["request_id"]: r for r in rows}
+    done = {}
+    for fn, recs in files_records.items():
+        for r in recs:
+            rid = r.get("request_id")
+            row = by.get(rid)
+            if row is None:
+                raise QAError(f"unexpected record {rid} in {fn}: not in current request set")
+            if rid in done:
+                raise QAError(f"duplicate record {rid} in {fn}")
+            for k, want in (("prompt_sha256", row["prompt_sha256"]), ("adapter_digest", adapter_digest),
+                            ("config_digest", cdig), ("protocol_digest", protocol_digest), ("id", row["id"]),
+                            ("condition", row["condition"]), ("checkpoint", row["checkpoint"]),
+                            ("target", row["target"]), ("modality", row["modality"])):
+                if r.get(k) != want:
+                    raise QAError(f"{k} mismatch for {rid} in {fn}: {r.get(k)!r} != {want!r}")
+            if row["modality"] == "image":
+                if r.get("image_file_sha256") != row["file_sha256"]:
+                    raise QAError(f"image_file_sha256 mismatch for {rid} in {fn}")
+                if r.get("input_pixel_sha256") != pixel_sha(row["image"]):
+                    raise QAError(f"input image changed since generation for {rid}")
+            else:
+                if r.get("image") is not None or r.get("image_file_sha256") is not None or r.get("input_pixel_sha256") is not None:
+                    raise QAError(f"text-only record {rid} in {fn} carries image fields")
+            done[rid] = r
+    return done
+
+
+def check_inputs(rows):
+    from . import inputs
+    seen = {}
+    for r in rows:
+        if r["modality"] == "text":
+            if r.get("image") is not None or r.get("file_sha256") is not None or r.get("pixel_sha256") is not None:
+                raise QAError(f"text-only row {r['id']}/{r['request_id']} carries image fields")
+            continue
+        if r["modality"] != "image":
+            raise QAError(f"unknown modality {r['modality']!r} for {r['request_id']}")
+        key = r["image"]
+        if key in seen:
+            continue
+        if generate.sha(open(key, "rb").read()) != r["file_sha256"]:
+            raise QAError(f"file sha changed for {r['id']}")
+        if inputs.raw_pixel_sha(key) != r["pixel_sha256"]:
+            raise QAError(f"pixel sha changed for {r['id']}")
+        seen[key] = 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--worker", type=int, required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--adapter", default=None)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--max-requests", type=int, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    a = ap.parse_args()
+    pdig = qa_protocol.verify(a.protocol)
+    if json.load(open(a.protocol))["locked"]["files"].get(a.requests) != generate.sha(open(a.requests, "rb").read()):
+        sys.exit(f"request file {a.requests} is not locked in {a.protocol} (or changed)")
+    cfg, _ = qa_protocol.static_cfg()
+    rows = Q.load_rows(a.requests, cfg)
+    if len({(r["checkpoint"], r["adapter_digest"]) for r in rows}) != 1:
+        sys.exit("one run must contain one checkpoint")
+    check_inputs(rows)
+    os.makedirs(a.out_dir, exist_ok=True)
+    info = queue_lock.my_info(worker=a.worker)
+    lk, own, _ = queue_lock.try_lock(os.path.join(a.out_dir, f"worker{a.worker}.lock"), info)
+    if lk is None:
+        sys.exit(f"worker {a.worker} already running: {own}")
+    try:
+        run_worker(a, rows, pdig, cfg, info)
+    finally:
+        lk.release()
+
+
+def run_worker(a, rows, pdig, cfg, info):
+    torch, proc, model = generate.load_model()
+    adapter_digest = generate.load_adapter(torch, model, a.adapter) if a.adapter else None
+    if adapter_digest != rows[0]["adapter_digest"]:
+        raise QAError(f"loaded adapter digest {adapter_digest} != requests {rows[0]['adapter_digest']}")
+    env = generate.env_info(torch, proc, model)
+    cdig, core = generate.config_digest(env, {})
+    if cdig != cfg:
+        raise QAError("runtime generation config digest != protocol config digest")
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    with open(os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl.env.json"), "w") as f:
+        json.dump({"env": env, "config_digest": cdig, "adapter_digest": adapter_digest, "protocol_digest": pdig,
+                   "worker": a.worker, "requests": a.requests}, f, indent=1, default=str)
+    cache = {}
+
+    def px(path):
+        if path not in cache:
+            cache[path] = generate.load_image(path)[2]
+        return cache[path]
+
+    def read_all(repair, live=False):
+        return read_all_owned(a.out_dir, a.worker, repair, live, info)
+
+    done = validate_records(read_all(a.repair_tail), rows, cdig, adapter_digest, pdig, px)
+    out = os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl")
+    claim_dir = os.path.join(a.out_dir, "claims")
+    os.makedirs(claim_dir, exist_ok=True)
+    log = open(out + ".log", "a")
+    t0, n_done = time.time(), 0
+    for row in sorted(rows, key=lambda r: r["request_id"]):
+        if row["request_id"] in done:
+            continue
+        if (a.time_limit and time.time() - t0 > a.time_limit) or (a.max_requests is not None and n_done >= a.max_requests):
+            log.write(json.dumps({"event": "stop", "done_this_run": n_done}) + "\n")
+            break
+        clk, prev, reclaimed = queue_lock.try_lock(os.path.join(claim_dir, row["request_id"] + ".claim"), info)
+        if clk is None:
+            continue
+        try:
+            if reclaimed:
+                log.write(json.dumps({"event": "claim_reclaimed_from_dead_owner", "request_id": row["request_id"], "prev_owner": prev}) + "\n")
+            done = validate_records(read_all(False, live=True), rows, cdig, adapter_digest, pdig, px)
+            if row["request_id"] in done:
+                continue
+            try:
+                rec = generate.run_request_modal(torch, proc, model, eos_ids, row)
+            except torch.cuda.OutOfMemoryError as e:
+                log.write(json.dumps({"event": "oom", "request_id": row["request_id"], "err": str(e)[:200]}) + "\n")
+                log.flush()
+                raise
+            rec.update({"request_id": row["request_id"], "split": row["split"], "checkpoint": row["checkpoint"],
+                        "target": row["target"], "condition": row["condition"],
+                        "adapter_digest": adapter_digest, "protocol_digest": pdig, "config_digest": cdig,
+                        "worker": a.worker, "ts": time.time(), "gpu_uuid": env.get("gpu_uuid"), "stage": row["stage"],
+                        "modality": row["modality"]})
+            with open(out, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            done[row["request_id"]] = rec
+            n_done += 1
+            log.write(json.dumps({"event": "done", "request_id": row["request_id"], "n_out": rec["n_output_tokens"], "finish": rec["finish_reason"],
+                                  "runtime_s": round(rec["runtime_s_total"], 2), "peak_gb": round(rec["peak_mem_alloc_gb_max"], 2),
+                                  "elapsed": round(time.time() - t0, 1)}) + "\n")
+            log.flush()
+        finally:
+            clk.release()
+    print(f"worker {a.worker}: finished; {n_done} new requests this run", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/roi26_protocol.py b/rsna_diag/roi26_protocol.py
new file mode 100644
index 0000000..ad94316
--- /dev/null
+++ b/rsna_diag/roi26_protocol.py
@@ -0,0 +1,92 @@
+"""iter_026 protocol 잠금 (roi25_protocol.py 기반): 이번 실행이 실제로 import하는 코드와 필요한 source manifest/원시 bbox 파일을 잠근다."""
+import argparse
+import json
+import os
+import sys
+
+from . import generate, lock_protocol
+
+SCHEMA = "iter026_roi26_protocol_v1"
+REQUIRED_CODE = [
+    "rsna_diag/__init__.py", "rsna_diag/geometry.py", "rsna_diag/parse.py", "rsna_diag/metrics.py",
+    "rsna_diag/lora.py", "rsna_diag/generate.py", "rsna_diag/prompts.py", "rsna_diag/queue_lock.py",
+    "rsna_diag/lock_protocol.py", "rsna_diag/inputs.py", "rsna_diag/eval_gate.py", "rsna_diag/qa_spec.py",
+    "rsna_diag/roi23_spec.py", "rsna_diag/roi23_data.py",
+    "rsna_diag/roi26_spec.py", "rsna_diag/roi26_data.py", "rsna_diag/roi26_protocol.py", "rsna_diag/roi26_requests.py",
+    "rsna_diag/roi26_gen.py", "rsna_diag/roi26_run.py", "rsna_diag/roi26_eval.py", "rsna_diag/roi26_decide.py",
+]
+REQUIRED_DATA = [
+    "results/iter_023/manifests/sets.json", "results/iter_023/manifests/labels.json",
+    "results/iter_010/manifests/infer_manifest.jsonl", "results/iter_010/manifests/gt_manifest.json",
+    "results/iter_010/manifests/validation_ids.json",
+    "results/iter_015/manifests/infer_manifest.jsonl", "results/iter_015/manifests/labels.json",
+    "results/iter_015/manifests/sets.json",
+    "results/iter_009/source/official/cxr_anatomy_localization_with_hugging_face.ipynb",
+]
+
+
+def static_cfg():
+    d, core = generate.config_digest(generate.static_env(), {})
+    return d, core
+
+
+def current(extra=()):
+    files = list(REQUIRED_CODE) + list(REQUIRED_DATA) + list(extra)
+    missing = [f for f in files if not os.path.isfile(f)]
+    if missing:
+        raise RuntimeError(f"required protocol files missing: {missing}")
+    d, core = static_cfg()
+    return {"schema": SCHEMA, "files": {f: lock_protocol.sha(f) for f in files},
+            "generation_config_digest": d, "generation_config": core}
+
+
+def create(out, extra=(), note=""):
+    if os.path.exists(out):
+        raise RuntimeError(f"protocol exists (not overwriting): {out}")
+    cur = current(extra)
+    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
+    json.dump({"locked": cur, "note": note}, open(out, "w"), indent=1, default=str)
+    return lock_protocol.locked_digest(cur)
+
+
+def verify(path, allowed_edits=None):
+    if not path or not os.path.exists(path):
+        raise RuntimeError(f"protocol file missing: {path!r}")
+    old = json.load(open(path))
+    lk = old["locked"]
+    if lk.get("schema") != SCHEMA:
+        raise RuntimeError(f"protocol schema {lk.get('schema')!r} != {SCHEMA}")
+    missing_req = [f for f in list(REQUIRED_CODE) + list(REQUIRED_DATA) if f not in lk["files"]]
+    if missing_req:
+        raise RuntimeError(f"protocol does not lock required files: {missing_req}")
+    extra = [f for f in lk["files"] if f not in list(REQUIRED_CODE) + list(REQUIRED_DATA)]
+    cur = current(extra)
+    allowed_edits = allowed_edits or {}
+    diff = {}
+    for k, v in cur["files"].items():
+        if lk["files"].get(k) == v:
+            continue
+        e = allowed_edits.get(k)
+        if e and e.get("reason") and e.get("before") == lk["files"].get(k) and e.get("after") == v:
+            continue
+        diff[k] = (lk["files"].get(k), v)
+    if diff or lk["generation_config_digest"] != cur["generation_config_digest"]:
+        raise RuntimeError("LOCK MISMATCH " + json.dumps(diff, indent=1)[:2000])
+    return lock_protocol.locked_digest(lk)
+
+
+def locked_file_sha(path, f):
+    return json.load(open(path))["locked"]["files"].get(f)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--extra", nargs="*", default=[])
+    ap.add_argument("--note", default="")
+    a = ap.parse_args()
+    print("locked", a.out, create(a.out, a.extra, a.note))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/rsna_diag/roi26_requests.py b/rsna_diag/roi26_requests.py
new file mode 100644
index 0000000..9d77a62
--- /dev/null
+++ b/rsna_diag/roi26_requests.py
@@ -0,0 +1,168 @@
+"""iter_026 요청 행렬 빌더: V(direct)/O(oracle, D전용)/RD(reader, M0전용)/text-only(D전용).
+
+request_id는 stage를 포함하지 않는다 (roi25_requests와 동일한 설계): 같은 (checkpoint, target, condition, id, prompt)
+조합이면 E60/E200처럼 서로 다른 stage에서도 같은 request_id를 가져 생성 출력을 그대로 재사용할 수 있다.
+"""
+import json
+import os
+
+from . import generate, prompts as P, roi23_spec as R, roi26_spec as R26
+
+OUT = os.environ.get("ROI26_RUN_ROOT", "results/iter_026")
+CKPT_SPEC = {"M0": None, "B0": "results/iter_012/train/lr2e-4_s17/epoch_05",
+             "B29": "results/iter_012/train/lr2e-4_s29/epoch_05", "B43": "results/iter_012/train/lr2e-4_s43/epoch_05"}
+ID_FIELDS = ("model_revision", "adapter_digest", "id", "split", "modality", "file_sha256", "pixel_sha256", "target",
+             "condition", "prompt_sha256", "config_digest", "preprocess")
+
+
+class RequestError(RuntimeError):
+    pass
+
+
+def compute_id(row):
+    return R.request_key({k: row.get(k) for k in ID_FIELDS})
+
+
+def make_row(item_id, split, ckpt, adapter_digest, target, condition, prompt, cfg_digest, stage, modality,
+             image_fields=None, extra=None):
+    row = {"id": item_id, "split": split, "checkpoint": ckpt, "adapter_digest": adapter_digest, "target": target,
+           "condition": condition, "prompt": prompt, "prompt_sha256": P.digest(prompt),
+           "model_revision": generate.MODEL_REVISION, "config_digest": cfg_digest,
+           "preprocess": generate.PREPROC_VERSION, "stage": stage, "modality": modality}
+    if modality == "image":
+        row.update({"image": image_fields["image"], "file_sha256": image_fields["file_sha256"],
+                    "pixel_sha256": image_fields["pixel_sha256"]})
+    else:
+        row.update({"image": None, "file_sha256": None, "pixel_sha256": None})
+    if extra:
+        row["extra"] = extra
+    row["request_id"] = compute_id(row)
+    return row
+
+
+def verify_row(row, cfg_digest):
+    if row.get("prompt_sha256") != P.digest(row["prompt"]):
+        raise RequestError(f"prompt_sha256 mismatch for {row.get('request_id')}")
+    if row.get("config_digest") != cfg_digest:
+        raise RequestError(f"config_digest mismatch for {row.get('request_id')}")
+    if row.get("model_revision") != generate.MODEL_REVISION:
+        raise RequestError("model revision differs")
+    if row.get("request_id") != compute_id(row):
+        raise RequestError(f"request_id != recomputed for {row.get('request_id')}")
+    if row["modality"] == "text" and (row.get("image") is not None or row.get("file_sha256") is not None):
+        raise RequestError(f"text-only row {row.get('request_id')} carries image fields")
+    if row["modality"] == "image" and row.get("image") is None:
+        raise RequestError(f"image row {row.get('request_id')} missing image field")
+    return True
+
+
+def load_rows(path, cfg_digest=None):
+    rows = [json.loads(ln) for ln in open(path) if ln.strip()]
+    ids = [r["request_id"] for r in rows]
+    if len(set(ids)) != len(ids):
+        raise RequestError(f"duplicate request_id in {path}")
+    if cfg_digest:
+        for r in rows:
+            verify_row(r, cfg_digest)
+    return rows
+
+
+def checkpoints(ckpts, out=None):
+    import torch
+    from . import eval_gate
+    out = out or f"{OUT}/manifests/checkpoints.json"
+    tab = json.load(open(out)) if os.path.exists(out) else {}
+    changed = False
+    for k in ckpts:
+        if k in tab:
+            continue
+        d = CKPT_SPEC[k]
+        if d is None:
+            tab[k] = {"dir": None, "digest": None}
+        else:
+            b = torch.load(os.path.join(d, "adapter.pt"), map_location="cpu", weights_only=True)
+            tab[k] = {"dir": d, "digest": eval_gate.adapter_digest(d), "epoch": b.get("epoch"), "step": b.get("step"),
+                      "train_digest": b.get("train_digest"), "lora": b["config"]}
+        changed = True
+    if changed:
+        os.makedirs(os.path.dirname(out), exist_ok=True)
+        tmp = out + ".tmp"
+        json.dump(tab, open(tmp, "w"), indent=1)
+        os.replace(tmp, out)
+    return tab
+
+
+def _img_fields(item):
+    return {"image": item["image"], "file_sha256": item["file_sha256"], "pixel_sha256": item["pixel_sha256"]}
+
+
+def build_v(items, tab, cfg, ckpts, stage):
+    out = {}
+    for ckpt in ckpts:
+        ad = tab[ckpt]["digest"]
+        rows = []
+        for i in sorted(items):
+            for t in R26.TARGETS:
+                txt = R26.v_prompt(t)
+                rows.append(make_row(i, items[i]["split"], ckpt, ad, t, "V", txt, cfg, stage, "image",
+                                     _img_fields(items[i])))
+        out[ckpt] = rows
+    return out
+
+
+def build_o(items, gts, tab, cfg, ckpts, stage="D"):
+    out = {}
+    for ckpt in ckpts:
+        ad = tab[ckpt]["digest"]
+        rows = []
+        for i in sorted(items):
+            boxes_f = sorted([b["yxyx_norm"] for b in gts[i]["boxes"]], key=lambda b: json.dumps(b))
+            boxes_i = R26.boxes_int(boxes_f)
+            for t in R26.TARGETS:
+                txt = R26.o_prompt(t, boxes_i)
+                rows.append(make_row(i, items[i]["split"], ckpt, ad, t, "O", txt, cfg, stage, "image",
+                                     _img_fields(items[i]), extra={"gt_boxes_int": boxes_i}))
+        out[ckpt] = rows
+    return out
+
+
+def build_rd(items, proposals, tab, cfg, stage, ckpt="M0"):
+    """proposals: {id: (boxes_norm_float or None, status)}. status != valid면 그 환자는 건너뛰고 unavailable로 기록."""
+    ad = tab[ckpt]["digest"]
+    rows, unavailable = [], []
+    for i in sorted(items):
+        boxes_f, status = proposals.get(i, (None, "missing"))
+        if boxes_f is None:
+            unavailable.append({"id": i, "status": status})
+            continue
+        boxes_i = R26.boxes_int(boxes_f)
+        for t in R26.TARGETS:
+            txt = R26.rd_prompt(t, boxes_i)
+            rows.append(make_row(i, items[i]["split"], ckpt, ad, t, "RD", txt, cfg, stage, "image",
+                                 _img_fields(items[i]), extra={"proposal_boxes_int": boxes_i,
+                                                                "proposal_status": status}))
+    return rows, unavailable
+
+
+def build_text(tab, cfg, ckpts, stage="D"):
+    out = {}
+    for ckpt in ckpts:
+        ad = tab[ckpt]["digest"]
+        rows = []
+        for t in R26.TARGETS:
+            txt = R26.v_prompt(t)
+            rows.append(make_row("control_text", "control", ckpt, ad, t, "V_TEXT", txt, cfg, stage, "text"))
+        out[ckpt] = rows
+    return out
+
+
+def write_rows(name, rows, out_dir=None):
+    out_dir = out_dir or f"{OUT}/requests"
+    os.makedirs(out_dir, exist_ok=True)
+    p = f"{out_dir}/{name}.jsonl"
+    if os.path.exists(p):
+        raise RequestError(f"{p} exists (not overwriting)")
+    with open(p, "w") as f:
+        for r in rows:
+            f.write(json.dumps(r) + "\n")
+    return p
diff --git a/rsna_diag/roi26_run.py b/rsna_diag/roi26_run.py
new file mode 100644
index 0000000..082c8e7
--- /dev/null
+++ b/rsna_diag/roi26_run.py
@@ -0,0 +1,255 @@
+"""iter_026 stage 실행기 (roi25_run.py 기반). 요청 jsonl 파일 목록(각 파일은 단일 checkpoint)을 순차 처리한다.
+사용: python -m rsna_diag.roi26_run --jobs f1.jsonl,f2.jsonl --protocol P --workers 2 --peak-gb 10
+"""
+import argparse
+import glob
+import signal
+import json
+import os
+import subprocess
+import sys
+import time
+
+from . import eval_gate, generate, roi26_gen as qa_gen, roi26_protocol as qa_protocol, roi26_requests as Q, queue_lock
+
+MIB_PER_GIB = 1024
+
+
+class GpuError(RuntimeError):
+    pass
+
+
+def atomic_json(obj, path):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f, indent=1, default=str)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
+
+
+def allowed_gpus():
+    raw = os.environ.get("CUDA_VISIBLE_DEVICES")
+    if not raw:
+        raise GpuError("CUDA_VISIBLE_DEVICES not set (allowed GPU set unknown)")
+    try:
+        return [int(x) for x in raw.split(",")]
+    except ValueError:
+        raise GpuError(f"non-integer CUDA_VISIBLE_DEVICES {raw!r}")
+
+
+def query_gpus(idx):
+    r = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,memory.used,memory.total", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True)
+    if r.returncode != 0:
+        raise GpuError(f"nvidia-smi failed rc={r.returncode}: {r.stderr[:200]}")
+    rows = {}
+    try:
+        for ln in r.stdout.strip().splitlines():
+            i, u, mu, mt = [x.strip() for x in ln.split(",")]
+            rows[int(i)] = {"uuid": u, "used_mib": int(mu), "total_mib": int(mt)}
+    except ValueError as e:
+        raise GpuError(f"cannot parse nvidia-smi output: {r.stdout[:200]}") from e
+    missing = [i for i in idx if i not in rows]
+    if missing:
+        raise GpuError(f"gpus {missing} not reported by nvidia-smi")
+    return {i: rows[i] for i in idx}
+
+
+def plan_gpus(gpus, workers, peak_gb, allowed, snapshot):
+    if not gpus or not set(gpus) <= set(allowed):
+        raise GpuError(f"gpus {gpus} not within allowed {allowed}")
+    assign = [(k, gpus[k % len(gpus)]) for k in range(workers)]
+    for g in gpus:
+        n = sum(1 for _, x in assign if x == g)
+        need = n * (peak_gb + 2.0) * MIB_PER_GIB
+        free = snapshot[g]["total_mib"] - snapshot[g]["used_mib"]
+        if n and need > free:
+            raise GpuError(f"gpu {g}: {n} workers x ({peak_gb}+2) GiB = {need:.0f} MiB > free {free} MiB")
+    return assign
+
+
+def live_workers(out_dir):
+    live = []
+    for f in sorted(glob.glob(os.path.join(out_dir, "worker*.lock"))):
+        fd = os.open(f, os.O_RDWR)
+        try:
+            import fcntl
+            try:
+                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                live.append((f, queue_lock._read(fd)))
+                continue
+            fcntl.flock(fd, fcntl.LOCK_UN)
+        finally:
+            os.close(fd)
+    return live
+
+
+def stop_children(procs, grace=60.0):
+    for p in procs:
+        if p.poll() is None:
+            p.terminate()
+    t0 = time.time()
+    while time.time() - t0 < grace and any(p.poll() is None for p in procs):
+        time.sleep(0.5)
+    for p in procs:
+        if p.poll() is None:
+            p.kill()
+    for p in procs:
+        p.wait()
+    return [{"pid": p.pid, "returncode": p.returncode} for p in procs]
+
+
+def verify_job(out_dir, rows, cfg, pdig, adapter_dir):
+    qa_gen.check_inputs(rows)
+    adg = eval_gate.adapter_digest(adapter_dir) if adapter_dir else None
+    if adg != rows[0]["adapter_digest"]:
+        raise qa_gen.QAError(f"adapter digest {adg} != requests {rows[0]['adapter_digest']}")
+    files = {f: qa_gen.read_strict(f) for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl")))}
+    cache = {}
+    px = lambda p: cache.setdefault(p, generate.load_image(p)[2])
+    done = qa_gen.validate_records(files, rows, cfg, adg, pdig, px)
+    missing = [r["request_id"] for r in rows if r["request_id"] not in done]
+    return done, missing
+
+
+class _Term(BaseException):
+    pass
+
+
+def _on_term(signum, frame):
+    raise _Term(f"signal {signum}")
+
+
+def run_one(rp, protocol, workers, gpus_arg, peak_gb, allowed, out_root, max_requests=None, time_limit=None,
+            repair_tail=False, poll_s=20.0):
+    pdig = qa_protocol.verify(protocol)
+    cfg, _ = qa_protocol.static_cfg()
+    rows = Q.load_rows(rp, cfg)
+    if json.load(open(protocol))["locked"]["files"].get(rp) != generate.sha(open(rp, "rb").read()):
+        raise RuntimeError(f"{rp} not locked in {protocol}")
+    ckpt = rows[0]["checkpoint"]
+    tab = Q.checkpoints([ckpt])
+    adapter = tab[ckpt]["dir"]
+    name = os.path.splitext(os.path.basename(rp))[0]
+    out_dir = f"{out_root}/gen/{name}"
+    os.makedirs(out_dir, exist_ok=True)
+    cp = os.path.join(out_dir, "completion.json")
+    if os.path.exists(cp):
+        done, missing = verify_job(out_dir, rows, cfg, pdig, adapter)
+        c = json.load(open(cp))
+        ok_c = (not missing and c.get("protocol_digest") == pdig and c.get("n_expected") == len(rows)
+                and c.get("n_actual_unique") == len(rows) and c.get("n_missing") == 0 and c.get("n_duplicate") == 0
+                and bool(c.get("returncodes")) and all(x == 0 for x in c["returncodes"]))
+        if ok_c:
+            print(f"[{name}] already complete & re-verified ({len(rows)} requests); skip", flush=True)
+            return {"name": name, "status": "verified_complete", "n": len(rows)}
+    alive = live_workers(out_dir)
+    if alive:
+        raise RuntimeError(f"live worker(s) still own {out_dir}: {alive} (parent was killed?). Wait for/stop them, then rerun.")
+    gpus = [int(x) for x in gpus_arg.split(",")] if gpus_arg else allowed
+    snap = query_gpus(gpus)
+    assign = plan_gpus(gpus, workers, peak_gb, allowed, snap)
+    info = queue_lock.my_info(role="roi26_run")
+    rlk, own, _ = queue_lock.try_lock(os.path.join(out_dir, "run.lock"), info)
+    if rlk is None:
+        raise RuntimeError(f"another roi26_run owns {out_dir}: {own}")
+    aid = f"{time.strftime('%Y%m%d_%H%M%S')}_{os.getpid()}"
+    att_dir = os.path.join(out_dir, "attempts")
+    os.makedirs(att_dir, exist_ok=True)
+    att_path = os.path.join(att_dir, f"attempt_{aid}.json")
+    att = {"attempt_id": aid, "status": "running", "pid": os.getpid(), "t_start": time.time(), "workers": workers,
+           "assign_worker_gpu": assign, "gpu_uuid": {g: snap[g]["uuid"] for g in gpus}, "peak_gb_assumed": peak_gb,
+           "gpu_snapshot_before": snap, "allowed": allowed}
+    procs = []
+    try:
+        if os.path.exists(cp):
+            os.replace(cp, os.path.join(att_dir, f"completion_superseded_by_{aid}.json"))
+        atomic_json(att, att_path)
+        for k, g in assign:
+            cmd = [sys.executable, "-m", "rsna_diag.roi26_gen", "--requests", rp, "--out-dir", out_dir, "--worker", str(k),
+                   "--protocol", protocol]
+            if adapter:
+                cmd += ["--adapter", adapter]
+            if max_requests is not None:
+                cmd += ["--max-requests", str(max_requests)]
+            if time_limit:
+                cmd += ["--time-limit", str(time_limit)]
+            if repair_tail:
+                cmd += ["--repair-tail"]
+            env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(g), CUDA_DEVICE_ORDER="PCI_BUS_ID")
+            procs.append(subprocess.Popen(cmd, env=env, stdout=open(f"{out_dir}/worker{k}.stdout.log", "a"),
+                                          stderr=open(f"{out_dir}/worker{k}.stderr.log", "a")))
+        att["children"] = [{"pid": p.pid, "start": queue_lock.proc_start(p.pid), "worker": k, "gpu": g} for p, (k, g) in zip(procs, assign)]
+        atomic_json(att, att_path)
+        t0 = time.time()
+        rl = open(f"{out_dir}/resource_log.jsonl", "a")
+        while any(p.poll() is None for p in procs):
+            try:
+                q = query_gpus(gpus)
+                apps = subprocess.run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory", "--format=csv,noheader,nounits"],
+                                      capture_output=True, text=True).stdout.strip().splitlines()
+            except GpuError as e:
+                q, apps = {"error": str(e)}, []
+            rl.write(json.dumps({"t": time.time() - t0, "gpus": q, "apps": apps}) + "\n")
+            rl.flush()
+            time.sleep(poll_s)
+        codes = [p.returncode for p in procs]
+        wall = time.time() - t0
+        err = None
+        try:
+            done, missing = verify_job(out_dir, rows, cfg, pdig, adapter)
+        except (qa_gen.QAError, eval_gate.GateError) as e:
+            done, missing, err = {}, [r["request_id"] for r in rows], str(e)[:500]
+        per_file = {os.path.basename(f): len(qa_gen.read_strict(f)) for f in sorted(glob.glob(f"{out_dir}/gen_worker*.jsonl"))}
+        rep = {"name": name, "n_expected": len(rows), "n_actual_unique": len(done), "n_missing": len(missing),
+               "n_duplicate": 0, "n_extra": 0, "returncodes": codes, "wall_s": wall, "per_file": per_file, "protocol_digest": pdig,
+               "adapter_digest": rows[0]["adapter_digest"], "worker_gpu": assign, "gpu_uuid": att["gpu_uuid"], "verify_error": err,
+               "requests": rp, "requests_sha256": generate.sha(open(rp, "rb").read()), "config_digest": cfg, "attempt_id": aid}
+        atomic_json(rep, f"{out_dir}/last_run.json")
+        ok = not missing and err is None and all(c == 0 for c in codes)
+        att.update({"status": "complete" if ok else "failed_or_incomplete", "returncodes": codes, "t_end": time.time(), "report": rep})
+        atomic_json(att, att_path)
+        if ok:
+            atomic_json(rep, cp)
+        print(f"[{name}] rc={codes} wall={wall:.0f}s n={len(done)}/{len(rows)} ok={ok}", flush=True)
+        return {"name": name, "status": "complete" if ok else "FAILED", "n": len(done), "of": len(rows), "wall_s": wall,
+                "rc": codes, "missing": len(missing), "err": err}
+    finally:
+        stopped = stop_children(procs) if any(p.poll() is None for p in procs) else [{"pid": p.pid, "returncode": p.returncode} for p in procs]
+        if att["status"] == "running":
+            att.update({"status": "interrupted", "t_end": time.time(), "children_final": stopped})
+            try:
+                atomic_json(att, att_path)
+            except OSError:
+                pass
+        rlk.release()
+
+
+def main():
+    signal.signal(signal.SIGTERM, _on_term)
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--jobs", required=True, help="comma-separated request jsonl paths")
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--workers", type=int, required=True)
+    ap.add_argument("--gpus", default=None)
+    ap.add_argument("--peak-gb", type=float, required=True)
+    ap.add_argument("--max-requests", type=int, default=None)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    ap.add_argument("--poll-s", type=float, default=20.0)
+    ap.add_argument("--out-root", default=Q.OUT)
+    a = ap.parse_args()
+    allowed = allowed_gpus()
+    summary = []
+    for rp in a.jobs.split(","):
+        res = run_one(rp, a.protocol, a.workers, a.gpus, a.peak_gb, allowed, a.out_root, a.max_requests, a.time_limit,
+                      a.repair_tail, a.poll_s)
+        summary.append(res)
+    print(json.dumps(summary))
+    sys.exit(0 if all(s["status"] in ("complete", "verified_complete") for s in summary) else 2)
+
+
+if __name__ == "__main__":
+    main()
