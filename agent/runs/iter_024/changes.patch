         out["cp_improve_prop_ci"] = [imp_lo, imp_hi]
         out["cp_worsen_prop_ci"] = [wor_lo, wor_hi]
+        # 계획식: [L_improve-U_worsen, U_improve-L_worsen], [-1,1]로 clip. 판정에는 이 구간을 쓴다 (bootstrap 원본은 보존).
