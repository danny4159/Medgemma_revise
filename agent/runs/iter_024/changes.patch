     else:
         out["degenerate"] = False
+    lo_j, hi_j = (out["diff_interval_clipped"] if out["degenerate"] else (out["ci_lo"], out["ci_hi"]))
+    out["judge_ci_lo"], out["judge_ci_hi"] = lo_j, hi_j
     return out
 
 
