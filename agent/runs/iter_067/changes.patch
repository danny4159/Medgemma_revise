+++ b/sp67_select.py
@@ -0,0 +1,26 @@
+"""D 단계: 모델별 baseline singleton B 선택(S1/S2의 D BA02, 동률이면 T1). 사용: python sp67_select.py <requests_D> <labels_D> <protocol_D> <gen_root> <out.json>"""
+import json, sys
+import numpy as np
+import m65_run as M65
+import sp67_eval as E
+import sp67_run as R
+
+
+def main():
+    req, lab, prot, gen, out = sys.argv[1:6]
+    pdig = R.check_protocol(prot, req, lab)
+    truth = E.truth_map(lab)
+    sel = {}
+    for model in R.MODELS:
+        recs = E.load_recs(gen, model, req, pdig)
+        t = E.Table(recs, truth, ['S1', 'S2'])
+        ba = {}
+        for n in ('S1', 'S2'):
+            ba[n] = E.ba_from_counts(t.patient_counts(t.pred[n]))[0]
+        sel[model] = {'B': 't1' if ba['S1'] >= ba['S2'] else 't2', 'D_BA02': ba, 'rule': 'higher D BA02, tie -> t1', 'protocol_digest': pdig}
+    json.dump(sel, open(out, 'w'), indent=1)
+    print(sel)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp67_tech.py b/sp67_tech.py
new file mode 100644
index 0000000..46d5209
--- /dev/null
+++ b/sp67_tech.py
@@ -0,0 +1,66 @@
+"""iter_067 기술 검사(D): 후보 단일 token, forward vs generate 첫 단계 logits, 조건 간 영상 tensor 동일성, 최대 stack 메모리.
+사용: CUDA_VISIBLE_DEVICES=<gpu> python sp67_tech.py <model> <requests> <out.json>"""
+import json, sys
+import numpy as np
+import m65_run as M65
+import sp67_run as R
+
+
+def main():
+    model, req, out = sys.argv[1:4]
+    rows = M65.read_jsonl(req)
+    torch, proc, m = M65.load_model(model)
+    cids = R.cand_ids(proc)
+    R.patch_vision(model, m)
+    res = {'model': model, 'cand_ids': cids, 'cand_tokens': [proc.tokenizer.decode([c]) for c in cids], 'env': M65.env_info(model, torch, proc, m)}
+    by = {}
+    for r in rows:
+        by.setdefault((r['patient'], r['ivd']), {})[r['cond']] = r
+    # 1) 영상 tensor 동일성: S1/S2 영상 sha가 J의 앞/뒤 부분과 같은가 (환자·IVD 대표 6개 + 최대 stack)
+    keys = sorted(by)[:: max(1, len(by) // 6)][:6]
+    mx = max(by, key=lambda k: by[k]['J']['images'].__len__())
+    if mx not in keys:
+        keys.append(mx)
+    eq = []
+    for k in keys:
+        g = by[k]
+        s1 = M65.per_image_pixels(model, M65.build_inputs(model, proc, g['S1']))[0]
+        s2 = M65.per_image_pixels(model, M65.build_inputs(model, proc, g['S2']))[0]
+        j = M65.per_image_pixels(model, M65.build_inputs(model, proc, g['J']))[0]
+        eq.append({'key': list(k), 'n1': len(s1), 'n2': len(s2), 'S1_eq_J_head': s1 == j[:len(s1)], 'S2_eq_J_tail': s2 == j[len(s1):], 'n_J': len(j)})
+    res['tensor_equality'] = eq
+    # 1b) vision chunk 동등성 (영상 수 <=24 요청에서 chunk 8 vs 24)
+    small = min(by, key=lambda k: len(by[k]['J']['images']))
+    row = by[small]['J']
+    R.patch_vision(model, m, 8); a8 = R.score_one(model, torch, proc, m, cids, row)
+    R.patch_vision(model, m, 64); a64 = R.score_one(model, torch, proc, m, cids, row)
+    R.patch_vision(model, m, 8)
+    res['chunk_equivalence'] = {'rid': row['rid'], 'n_images': len(row['images']), 'max_logit_diff': max(abs(x - y) for x, y in zip(a8['cand_logits'], a64['cand_logits'])),
+                                'pred_equal': a8['pred'] == a64['pred']}
+    # 2) forward vs generate 첫 단계
+    cmp = []
+    for k in keys:
+        for c in ('S1', 'J', 'T'):
+            row = by[k][c]
+            rec = R.score_one(model, torch, proc, m, cids, row)
+            inp = M65.build_inputs(model, proc, row)
+            x = R.to_dev(torch, inp)
+            with torch.no_grad():
+                g = m.generate(**x, max_new_tokens=1, do_sample=False, output_scores=True, return_dict_in_generate=True)
+            gl = g.scores[0][0].float()[cids].cpu()
+            fl = torch.tensor(rec['cand_logits'])
+            gp = torch.softmax(gl, -1); fp = torch.softmax(fl, -1)
+            cmp.append({'rid': row['rid'], 'max_prob_diff': float((gp - fp).abs().max()), 'max_logit_diff': float((gl - fl).abs().max()),
+                        'pred_equal': int(gp.argmax()) == int(fp.argmax()), 'gen_token_id': int(g.sequences[0, -1]), 'fwd_top_id': rec['top_token_id'],
+                        'n_images': rec['n_images'], 'n_input_tokens': rec['n_input_tokens'], 'peak_alloc_gb': rec['peak_alloc_gb'], 'peak_reserved_gb': rec['peak_reserved_gb'],
+                        't_forward_s': rec['t_forward_s'], 't_total_s': rec['t_total_s']})
+    res['forward_vs_generate'] = cmp
+    res['ok'] = (all(e['S1_eq_J_head'] and e['S2_eq_J_tail'] for e in eq) and all(c['max_prob_diff'] <= 1e-3 and c['pred_equal'] for c in cmp))
+    import os
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    json.dump(res, open(out, 'w'), indent=1)
+    print('ok', res['ok'], 'max_prob_diff', max(c['max_prob_diff'] for c in cmp), 'peak_reserved', max(c['peak_reserved_gb'] for c in cmp))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp67_test.py b/sp67_test.py
new file mode 100644
index 0000000..f30e8f1
--- /dev/null
+++ b/sp67_test.py
@@ -0,0 +1,112 @@
+"""iter_067 CPU 검사: canonical 기하(축 permutation·flip), crop 경계, protocol 변조 거부, 지표 함수. 결과: results/iter_067/tests/cpu_tests.json
+사용: python sp67_test.py"""
+import json, os, shutil, sys
+import numpy as np
+import sp67_data as S
+import sp67_eval as E
+import sp67_run as R
+
+res = []
+
+
+def check(name, cond, detail=None):
+    res.append({'name': name, 'pass': bool(cond), 'detail': detail})
+    print('PASS' if cond else 'FAIL', name, detail if not cond else '')
+
+
+def synth_geometry():
+    # RAI 예: identity. ASL 예: 실제 header의 direction.
+    for tag, D in (('RAI', [1, 0, 0, 0, 1, 0, 0, 0, 1]),
+                   ('ASL', [0, 1, 0, 0, 0, -1, -1, 0, 0])):
+        img = S.sitk.Image([5, 7, 9], S.sitk.sitkInt16)
+        img.SetDirection(D); img.SetSpacing([3.0, 0.5, 0.7]); img.SetOrigin([1.0, 2.0, 3.0])
+        arr = np.arange(5 * 7 * 9).reshape(9, 7, 5).astype(np.int16)
+        arr_img = S.sitk.GetImageFromArray(arr); arr_img.CopyInformation(img)
+        ca = S.canon_axes(arr_img.GetDirection())
+        V, sp = S.to_canonical(arr, arr_img.GetSpacing(), ca)
+        ok = True
+        rng = np.random.RandomState(1)
+        for _ in range(50):
+            c = tuple(int(rng.randint(0, n)) for n in V.shape)
+            oi = S.canon_to_orig_index(ca, V.shape, c)
+            ok &= bool(arr[oi[2], oi[1], oi[0]] == V[c])
+            ph = np.array(arr_img.TransformIndexToPhysicalPoint(oi))
+            # canonical 축 (x,z,y)는 물리 x,z,y 증가 방향
+            for ax in range(3):
+                d = list(c); d[ax] += 1
+                if d[ax] >= V.shape[ax]:
+                    continue
+                ph2 = np.array(arr_img.TransformIndexToPhysicalPoint(S.canon_to_orig_index(ca, V.shape, tuple(d))))
+                pa = [0, 2, 1][ax]
+                ok &= bool(ph2[pa] - ph[pa] > 0 and abs((ph2 - ph)[pa]) - sp[ax] < 1e-9)
+        check(f'canonical_physical_{tag}', ok)
+        check(f'canonical_shape_{tag}', sorted(V.shape) == [5, 7, 9] and sp == [arr_img.GetSpacing()[i] for i in ca['idx_axis']])
+    try:
+        S.canon_axes([0.7, 0.7, 0, 0, 0, 1, 1, 0, 0]); check('oblique_axis_rejected', False)
+    except S.GeomError:
+        check('oblique_axis_rejected', True)
+
+
+def crop_tests():
+    info = {'lo': [0, 100, 50], 'hi': [3, 119, 89]}   # si extent 20 vox, AP 40 vox
+    cb = S.crop_box(info, (10, 300, 200), (4.0, 0.5, 0.5))
+    W = 40 * 0.5
+    check('crop_margin_si', abs(cb['margin_mm']['sup'] - W) <= 0.5 and abs(cb['margin_mm']['inf'] - W) <= 0.5, cb['margin_mm'])
+    check('crop_margin_ap', abs(cb['margin_mm']['ant'] - 0.25 * W) <= 0.5 and abs(cb['margin_mm']['post'] - 0.25 * W) <= 0.5, cb['margin_mm'])
+    cb2 = S.crop_box({'lo': [0, 5, 2], 'hi': [3, 20, 40]}, (10, 300, 200), (4.0, 0.5, 0.5))
+    check('crop_clip_flagged', cb2['clip']['si_clipped_lo'] and cb2['clip']['pa_clipped_lo'] and cb2['si'][0] == 0 and cb2['pa'][0] == 0, cb2['clip'])
+
+
+def metric_tests():
+    y = np.array([0, 0, 2, 2, 1, 3]); p = np.array([0, 2, 2, 1, 1, 0])
+    n0, c0, n2, c2 = E.ba02_counts(y, p)
+    check('ba02_counts', (n0, c0, n2, c2) == (2, 1, 2, 1))   # 예측 I는 II 행의 오답
+    cnt = np.array([[2, 1, 2, 1.0]])
+    check('ba02_value', abs(E.ba_from_counts(cnt)[0] - 0.5) < 1e-12)
+    check('ba02_nan_when_class_absent', np.isnan(E.ba_from_counts(np.array([[2, 1, 0, 0.0]]))[0]))
+    P = np.array([[0.25, 0.25, 0.25, 0.25]])
+    check('tie_argmax_smaller_grade', int((0.5 * (P + P)).argmax(1)[0]) == 0)
+
+
+def protocol_tests():
+    base = 'results/iter_067/data'
+    req, lab, prot = f'{base}/requests_D.jsonl', f'{base}/pairs_D.json', f'{base}/protocol_D_v2.json'
+    R.check_protocol(prot, req, lab)
+    os.makedirs('results/iter_067/tests/tamper', exist_ok=True)
+    t_req = 'results/iter_067/tests/tamper/requests_D_tampered.jsonl'
+    rows = open(req).read().split('\n')
+    rows[0] = rows[0].replace('Modic', 'Modik', 1) if 'Modic' in rows[0] else rows[0] + ' '
+    open(t_req, 'w').write('\n'.join(rows))
+    try:
+        R.check_protocol(prot, t_req, lab); check('tamper_requests_rejected', False)
+    except SystemExit:
+        check('tamper_requests_rejected', True)
+    t_lab = 'results/iter_067/tests/tamper/pairs_D_tampered.json'
+    d = json.load(open(lab)); d[0]['ivd'][0]['modic'] = (d[0]['ivd'][0]['modic'] + 1) % 4
+    json.dump(d, open(t_lab, 'w'))
+    try:
+        R.check_protocol(prot, req, t_lab); check('tamper_labels_rejected', False)
+    except SystemExit:
+        check('tamper_labels_rejected', True)
+
+
+def request_tests():
+    rows = [json.loads(l) for l in open('results/iter_067/data/requests_D.jsonl')]
+    check('rid_unique', len({r['rid'] for r in rows}) == len(rows))
+    # 모델 입력 prompt에 정답/등급이 들어가지 않는지: prompt는 환자·IVD와 무관한 템플릿 + 영상 수만 포함
+    import re
+    stripped = {(r['cond'], re.sub(r'\d+', '#', r['prompt'])) for r in rows}
+    check('prompt_template_only_counts_vary', len(stripped) == len({r['cond'] for r in rows}), len(stripped))
+    check('T_has_no_images', all(r['images'] == [] for r in rows if r['cond'] == 'T'))
+    j = [r for r in rows if r['cond'] == 'J']
+    s1 = {(r['patient'], r['ivd']): r for r in rows if r['cond'] == 'S1'}
+    s2 = {(r['patient'], r['ivd']): r for r in rows if r['cond'] == 'S2'}
+    check('J_is_S1_then_S2', all(r['images'] == s1[(r['patient'], r['ivd'])]['images'] + s2[(r['patient'], r['ivd'])]['images'] for r in j))
+
+
+if __name__ == '__main__':
+    synth_geometry(); crop_tests(); metric_tests(); protocol_tests(); request_tests()
+    os.makedirs('results/iter_067/tests', exist_ok=True)
+    json.dump({'n': len(res), 'n_pass': sum(r['pass'] for r in res), 'tests': res}, open('results/iter_067/tests/cpu_tests.json', 'w'), indent=1)
+    print(sum(r['pass'] for r in res), '/', len(res))
+    sys.exit(0 if all(r['pass'] for r in res) else 1)
diff --git a/sp67_verify.py b/sp67_verify.py
new file mode 100644
index 0000000..d6ee331
--- /dev/null
+++ b/sp67_verify.py
@@ -0,0 +1,54 @@
+"""iter_067 독립 재계산: 원시 worker JSONL의 cand_logits에서 평가 모듈 import 없이 BA02를 다시 계산하고 report.json과 대조.
+추가(사후 탐색, 사전 기준 아님): 0 vs II 행에서 p(C)(Modic II 후보 확률)의 AUROC — argmax가 퇴화(항상 같은 class)했을 때 순위 신호가 있는지 구분용.
+사용: python sp67_verify.py <gen_root> <truth_labels.json> <report.json> <out.json>"""
+import glob, json, math, sys
+
+
+def softmax(v):
+    m = max(v); e = [math.exp(x - m) for x in v]; s = sum(e)
+    return [x / s for x in e]
+
+
+def auroc(pos, neg):
+    n = 0.0
+    for p in pos:
+        for q in neg:
+            n += 1.0 if p > q else 0.5 if p == q else 0.0
+    return n / (len(pos) * len(neg))
+
+
+def main():
+    gen, lab, rep, out = sys.argv[1:5]
+    truth = {(p['patient'], i['k']): i['modic'] for p in json.load(open(lab)) for i in p['ivd']}
+    report = json.load(open(rep))
+    res = {}
+    for model, r in report['models'].items():
+        rows = {}
+        for f in glob.glob(f'{gen}/{model}/worker*.jsonl'):
+            for l in open(f):
+                if l.endswith('\n') and l.strip():
+                    x = json.loads(l); rows[x['rid']] = x
+        by = {}
+        for x in rows.values():
+            by.setdefault(x['cond'], []).append(x)
+        res[model] = {}
+        for c, xs in by.items():
+            name = {'RT1': 'R'}.get(c, c)
+            hit = {0: [0, 0], 2: [0, 0]}
+            for x in xs:
+                y = truth[(x['patient'], x['ivd'])]
+                if y in hit:
+                    hit[y][0] += 1
+                    hit[y][1] += int(max(range(4), key=lambda i: (x['cand_logits'][i], -i)) == y)
+            ba = 0.5 * (hit[0][1] / hit[0][0] + hit[2][1] / hit[2][0])
+            pC0 = [softmax(x['cand_logits'])[2] for x in xs if truth[(x['patient'], x['ivd'])] == 0]
+            pC2 = [softmax(x['cand_logits'])[2] for x in xs if truth[(x['patient'], x['ivd'])] == 2]
+            res[model][name] = {'BA02_indep': ba, 'BA02_report': r['cond'][name]['BA02'], 'diff': abs(ba - r['cond'][name]['BA02']),
+                                'posthoc_AUROC_pC_II_vs_0_rowlevel': auroc(pC2, pC0), 'n_II': len(pC2), 'n_0': len(pC0)}
+    json.dump(res, open(out, 'w'), indent=1)
+    for m, d in res.items():
+        print(m, {k: (round(v['BA02_indep'], 3), round(v['diff'], 12), round(v['posthoc_AUROC_pC_II_vs_0_rowlevel'], 3)) for k, v in d.items()})
+
+
+if __name__ == '__main__':
+    main()
