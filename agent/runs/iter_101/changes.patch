diff --git a/report101_blind.py b/report101_blind.py
new file mode 100644
index 0000000..793defc
--- /dev/null
+++ b/report101_blind.py
@@ -0,0 +1,70 @@
+"""iter_101: 완료된 main 교정 생성(T/V/W)과 GPU 없는 K/A 텍스트를 조건명 없는 blind ID로 묶어 의미 검토용 파일을 만든다.
+
+- 생성 stage는 completion과 요청·protocol 검증(report101_gen.verify)을 통과해야 한다.
+- K = CURE 초안(좌표 제거), A = 초안 + 좌/우 영역 설명 단순 결합(고정 순서). T/V/W는 모델 출력(원문 그대로).
+- 조건명·mapping은 private_mapping.json에만 둔다. 검토 파일에는 reference 문장·atom 표만 포함한다(모델 입력에는 없었음).
+- blind는 문체로 조건을 추측할 수 있어 완전한 눈가림이 아니다(JSON 출력·'Revised Report' 머리말·FINDINGS 형식 등).
+"""
+import hashlib
+import json
+from pathlib import Path
+
+import pg39_data as D
+import report101_gen as G
+import report101_req as RQ
+from report86_common import ROOT, save, sha
+
+R101 = ROOT / 'results/iter_101'
+DATA = R101 / 'data'
+
+
+def ensure_period(t):
+    t = t.rstrip()
+    return t if t.endswith(('.', '!', '?')) else t + '.'
+
+
+def a_text(pk):
+    return ensure_period(pk['draft']) + ' ' + pk['left'] + ' ' + pk['right']
+
+
+def main():
+    gen = R101 / 'gen' / 'main'
+    req = DATA / 'corr_main' / 'requests.json'
+    workers = json.loads((gen / 'mapping.json').read_text())['workers']
+    rows, expected = G.verify(gen, str(req), workers)
+    assert len(rows) == len(expected) == 18 and (gen / 'completion.json').exists()
+    sel = json.loads((DATA / 'lock/selection.json').read_text())
+    atoms = json.loads((DATA / 'lock/atoms.json').read_text())
+    recs = RQ.load_cure('S24')
+    reports, _, _ = D.load_inputs()
+    rep = {r['ImageID']: r for r in reports}
+    outputs, mapping = [], {}
+    review = []
+    byid = {r['id']: r for r in rows}
+    for img in sel['selected_order']:
+        pk = RQ.package(img, recs)
+        texts = {'K': pk['draft'], 'A': a_text(pk)}
+        flags = {'K': False, 'A': False}
+        for c in ('T', 'V', 'W'):
+            r = byid['%s|%s' % (img, c)]
+            texts[c] = r['text']
+            flags[c] = not r['attempts'][-1]['ended_eos']
+        outs = []
+        for c, t in texts.items():
+            b = hashlib.sha256(('101017|iter101|%s|%s' % (img, c)).encode()).hexdigest()[:12]
+            assert b not in mapping
+            mapping[b] = {'ImageID': img, 'condition': c}
+            outs.append({'blind_id': b, 'text': t, 'non_eos': flags[c], 'chars': len(t)})
+        outs.sort(key=lambda o: o['blind_id'])
+        i = atoms['index'][img]
+        review.append({'patient_index': i, 'ref_sentences_full_report': [f['sentence_en'] for f in rep[img]['findings']],
+                       'ref_state': atoms['atoms'][img]['ref_state'], 'need_sides': atoms['atoms'][img]['need_sides'],
+                       'atoms': atoms['atoms'][img]['atoms'], 'draft_atoms_source': pk['draft'], 'outputs': outs})
+    dest = R101 / 'eval' / 'blind'
+    save(dest / 'private_mapping.json', mapping)
+    save(dest / 'review_input.json', {'review': review, 'completion_sha': sha(gen / 'completion.json'), 'source_sha': sha(__file__)})
+    print(len(mapping), 'blinded outputs ->', dest)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/report101_cure.py b/report101_cure.py
new file mode 100644
index 0000000..dc7874b
--- /dev/null
+++ b/report101_cure.py
@@ -0,0 +1,330 @@
+"""iter_101 CURE 원출력 생성기 (환자당 3요청: grounded report + 좌/우 costophrenic angle Describe).
+
+report95_gen/report95_launch의 모델 로딩·입력·생성 경로(NF4·bf16·공식 processor/chat template·CLAHE·greedy·cap 1024→2048→4096)를 유지한다.
+iter_095 재사용 결함 보완:
+ - 실행 소스 sha256을 scientific protocol에 포함: 소스가 바뀌면 resume 거부(모델 로딩 전).
+ - 완료(completion) 파일 변조 거부: 재실행·launcher 시작 시 completion의 파일 hash를 다시 검증하고, 불일치면 실패.
+ - launcher: 허용 GPU 집합 검사, launcher 단일 소유권(flock), 시작 직전 nvidia-smi 재확인 + 살아 있는 worker마다 (peak-현재점유+2GiB) 예약.
+출력은 results/iter_101 아래에만 쓴다. stdout/stderr 로그 이름은 기존 파일 기준으로 attempt 번호를 정한다.
+"""
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+from report86_common import (ROOT, SEED, CAPS, sha, sha_obj, save, read_jsonl_complete, record_digest, adapter_path_C, base_path, CURE_PY, R85)
+
+R101 = ROOT / 'results/iter_101'
+DATA = R101 / 'data'
+SYSTEM = 'C101'
+FORMATS = [('G', 'Generate a grounded report.'), ('CL', 'Describe the left costophrenic angle.'),
+           ('CR', 'Describe the right costophrenic angle.')]
+EXEC_SOURCES = ['report101_cure.py', 'report86_common.py', 'rsna_diag/generate.py', 'rsna_diag/lora.py', 'rsna_diag/geometry.py', 'pg43_run.py']
+MARGIN_MIB = 2048
+
+
+def stage_rows(stage):
+    return json.loads((DATA / f'inputs_{stage}.json').read_text()), {r['ImageID']: r for r in json.loads((DATA / f'raw_manifest_{stage}.json').read_text())}
+
+
+def requests(stage):
+    rows, _ = stage_rows(stage)
+    out = [{'id': f"{r['ImageID']}|{SYSTEM}|{k}", 'ImageID': r['ImageID'], 'fmt': k, 'prompt': p} for r in rows for k, p in FORMATS]
+    assert len({q['id'] for q in out}) == len(out)
+    return out
+
+
+def scientific_protocol(stage, nshards):
+    reqs = requests(stage)
+    return {'system': 'C', 'stage': stage, 'nshards': nshards, 'base': base_path('C'),
+            'adapter_digest': sha(adapter_path_C() / 'adapter_model.safetensors'), 'seed': SEED, 'caps': CAPS, 'precision': 'nf4_bf16_clahe',
+            'requests_sha256': sha_obj(reqs), 'n_requests': len(reqs), 'input_sha256': sha(DATA / f'inputs_{stage}.json'),
+            'raw_sha256': sha(DATA / f'raw_manifest_{stage}.json'), 'selection_lock_sha256': sha(DATA / 'selection_lock.json'),
+            'source_sha256': {f: sha(ROOT / f) for f in EXEC_SOURCES}}
+
+
+def isolated_env():
+    env = dict(os.environ)
+    cache = R101 / 'runtime_cache'
+    for key, name in {'HF_HOME': 'hf', 'HF_HUB_CACHE': 'hf/hub', 'HF_XET_CACHE': 'hf/xet', 'XDG_CACHE_HOME': 'xdg', 'TORCH_HOME': 'torch',
+                      'TORCHINDUCTOR_CACHE_DIR': 'inductor', 'TRITON_CACHE_DIR': 'triton', 'CUDA_CACHE_PATH': 'cuda',
+                      'MPLCONFIGDIR': 'matplotlib', 'TMPDIR': 'tmp'}.items():
+        p = cache / name
+        p.mkdir(parents=True, exist_ok=True)
+        env[key] = str(p)
+    env.update({'HF_HUB_OFFLINE': '1', 'TOKENIZERS_PARALLELISM': 'false', 'NO_ALBUMENTATIONS_UPDATE': '1'})
+    return env
+
+
+def shard_dir(out, s):
+    return Path(out) / f'shard{s}'
+
+
+def load_own(d, reqmap, sci_digest):
+    mine = read_jsonl_complete(Path(d) / 'outputs.jsonl')
+    ids = [r['id'] for r in mine]
+    assert len(ids) == len(set(ids)), 'duplicate in own output'
+    for r in mine:
+        q = reqmap.get(r['id'])
+        assert q is not None, f"record outside request set {r['id']}"
+        assert r['protocol_digest'] == sci_digest, 'record protocol digest mismatch'
+        assert r['record_digest'] == record_digest(r), 'record digest mismatch (tampered)'
+        assert r['prompt'] == q['prompt'] and r['ImageID'] == q['ImageID'], 'record prompt/image mismatch'
+    return mine
+
+
+def verify_completion(d, reqmap, sci_digest):
+    """completion이 있으면 파일 hash·요청 집합을 전수 재검증한다."""
+    cp = Path(d) / 'completion.json'
+    c = json.loads(cp.read_text())
+    for name, h in c['files'].items():
+        assert sha(Path(d) / name) == h, f'completion file hash differs: {d}/{name}'
+    recs = load_own(d, reqmap, sci_digest)
+    assert c['n_own_records'] == len(recs)
+    return c, recs
+
+
+def worker(a):
+    out = Path(a.out).resolve()
+    out.relative_to(R101)
+    allowed = os.environ['CUDA_VISIBLE_DEVICES'].split(',')
+    assert a.gpu in allowed, f'gpu {a.gpu} not in inherited CUDA_VISIBLE_DEVICES {allowed}'
+    os.environ['CUDA_VISIBLE_DEVICES'] = a.gpu
+    reqs = requests(a.stage)
+    reqmap = {r['id']: r for r in reqs}
+    rows, raw = stage_rows(a.stage)
+    for row in rows:
+        assert sha(row['image']) == row['file_sha256'], f"input image changed {row['ImageID']}"
+        assert sha(raw[row['ImageID']]['raw_path']) == raw[row['ImageID']]['sha256'], 'raw image changed'
+    sci = scientific_protocol(a.stage, a.nshards)
+    sci_digest = sha_obj(sci)
+    d = shard_dir(out, a.shard)
+    d.mkdir(parents=True, exist_ok=True)
+    lock = (d / 'worker.lock').open('a')
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    from pg43_run import repair_tail
+    repair_tail(str(d / 'outputs.jsonl'))
+    meta = {'scientific': sci, 'scientific_digest': sci_digest, 'stage': a.stage, 'shard': a.shard, 'nshards': a.nshards}
+    mypath = d / 'scientific_protocol.json'
+    if mypath.exists():
+        assert json.loads(mypath.read_text()) == json.loads(json.dumps(meta)), 'resume: protocol/source/shard mismatch (before model load)'
+    else:
+        save(mypath, meta)
+    my_rows = [r for i, r in enumerate(rows) if i % a.nshards == a.shard]
+    my_imgs = {r['ImageID'] for r in my_rows}
+    target = [q for q in reqs if q['ImageID'] in my_imgs]
+    if (d / 'completion.json').exists():
+        verify_completion(d, reqmap, sci_digest)  # 변조 시 AssertionError
+        return 0
+    mine = load_own(d, reqmap, sci_digest)
+    assert all(r['ImageID'] in my_imgs for r in mine), 'own record belongs to another shard'
+    done = {r['id'] for r in mine}
+    todo = [q for q in target if q['id'] not in done]
+    if a.limit:
+        todo = todo[:a.limit]
+    execution = {'event': 'start', 'time': time.time(), 'pid': os.getpid(), 'gpu_physical': a.gpu, 'python': sys.executable,
+                 'n_todo': len(todo), 'n_target': len(target), 'cuda_visible_devices_set': os.environ['CUDA_VISIBLE_DEVICES']}
+    events = (d / 'executions.jsonl').open('a', buffering=1)
+    if todo:
+        saved = generate(a, d, events, execution, todo, my_rows, rows, raw, sci_digest)
+    finish(d, a, target, reqmap, sci_digest)
+    return 0
+
+
+def generate(a, d, events, execution, todo, my_rows, rows, raw, sci_digest):
+    import numpy as np
+    import torch
+    from transformers import AutoProcessor, AutoModelForImageTextToText, BitsAndBytesConfig
+    from peft import PeftModel
+    from rsna_diag import generate as G
+    torch.set_num_threads(4)
+    torch.manual_seed(SEED)
+    base = base_path('C')
+    processor = AutoProcessor.from_pretrained(base, local_files_only=True)
+    processor.tokenizer.padding_side = 'left'
+    kw = dict(torch_dtype=torch.bfloat16, device_map={'': 0}, local_files_only=True, attn_implementation='sdpa',
+              quantization_config=BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_use_double_quant=True, bnb_4bit_quant_type='nf4',
+                                                     bnb_4bit_compute_dtype=torch.bfloat16, bnb_4bit_quant_storage=torch.bfloat16))
+    t0 = time.monotonic()
+    model = AutoModelForImageTextToText.from_pretrained(base, **kw)
+    ap = adapter_path_C()
+    model = PeftModel.from_pretrained(model, str(ap), local_files_only=True)
+    assert set(model.peft_config['default'].modules_to_save) == {'lm_head', 'embed_tokens'}
+    model.eval()
+    assert not any(m.training for m in model.modules())
+    loading_s = time.monotonic() - t0
+    sys.path.insert(0, str(R85 / 'official/minimal'))
+    from vlm_research_kit.data.transforms_factory import create_image_transforms
+    transform = create_image_transforms(use_model_specific_transforms=True, model_name='pil_with_augmentations', bbox_format='cxcywh',
+                                        image_size=[448, 448], is_train=False,
+                                        augmenter_override_params={'apply_clahe': True, 'clahe_clip_limit': [3., 3.]})
+    eos = model.generation_config.eos_token_id
+    eos = [eos] if isinstance(eos, int) else eos
+    events.write(json.dumps({**execution, 'torch': torch.__version__, 'loading_s': loading_s}) + '\n')
+    by_img = {}
+    for q in todo:
+        by_img.setdefault(q['ImageID'], []).append(q)
+    saved = 0
+    t_start = time.monotonic()
+    with (d / 'outputs.jsonl').open('a', buffering=1) as f:
+        for img in [r['ImageID'] for r in my_rows if r['ImageID'] in by_img]:
+            rr = raw[img]
+            im = transform(rr['raw_path'])['pixel_values']
+            row = next(r for r in rows if r['ImageID'] == img)
+            for q in by_img[img]:
+                events.write(json.dumps({'event': 'request_start', 'id': q['id'], 'time': time.time()}) + '\n')
+                inp = G.build_inputs(processor, im, q['prompt'])
+                official = processor.apply_chat_template([{'role': 'user', 'content': [{'type': 'image', 'image': im}, {'type': 'text', 'text': q['prompt']}]}],
+                                                         add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors='pt', padding=True)
+                assert set(inp) == set(official) and all(torch.equal(inp[k], official[k]) for k in inp)
+                attempts = []
+                for cap in CAPS:
+                    result = G.generate(torch, processor, model, inp, cap, eos)
+                    attempts.append(result)
+                    if result['ended_eos']:
+                        break
+                rec = {'id': q['id'], 'ImageID': img, 'fmt': q['fmt'], 'prompt': q['prompt'], 'protocol_digest': sci_digest,
+                       'image_sha256': row['file_sha256'], 'text': processor.decode(result['suffix_ids'], skip_special_tokens=True),
+                       'attempts': attempts, 'input_ids': inp['input_ids'][0].tolist(),
+                       'pixel_sha256': hashlib.sha256(np.asarray(im).tobytes()).hexdigest(),
+                       'exec': {'gpu': a.gpu, 'shard': a.shard, 'pid': os.getpid(), 'torch': torch.__version__}}
+                rec['record_digest'] = record_digest(rec)
+                f.write(json.dumps(rec, ensure_ascii=False) + '\n')
+                f.flush()
+                os.fsync(f.fileno())
+                saved += 1
+                events.write(json.dumps({'event': 'request_saved', 'id': q['id'], 'time': time.time(), 'seconds': result['runtime_s'],
+                                         'n_new': result['n_new'], 'attempts': len(attempts)}) + '\n')
+                print(json.dumps({'saved': saved, 'of': len(todo), 'shard': a.shard, 'tokens': result['n_new'],
+                                  'seconds': round(result['runtime_s'], 2)}), flush=True)
+    allrecs = read_jsonl_complete(d / 'outputs.jsonl')
+    events.write(json.dumps({'event': 'end', 'time': time.time(), 'saved': saved, 'wall_s': time.monotonic() - t_start,
+                             'peak_reserved_gib_max': max(max(x['peak_mem_reserved_gb'] for x in r['attempts']) for r in allrecs)}) + '\n')
+    return saved
+
+
+def finish(d, a, target, reqmap, sci_digest):
+    recs = load_own(d, reqmap, sci_digest)
+    got = {r['id'] for r in recs}
+    want = {q['id'] for q in target}
+    cp = d / 'completion.json'
+    if want <= got and not cp.exists():
+        events = [json.loads(l) for l in (d / 'executions.jsonl').read_text().splitlines() if l]
+        save(cp, {'stage': a.stage, 'shard': a.shard, 'nshards': a.nshards, 'n_own_records': len(recs), 'n_expected_in_shard': len(want),
+                  'files': {'scientific_protocol.json': sha(d / 'scientific_protocol.json'), 'outputs.jsonl': sha(d / 'outputs.jsonl')},
+                  'final_not_eos': sum(not r['attempts'][-1]['ended_eos'] for r in recs),
+                  'executions': len([e for e in events if e['event'] == 'start']),
+                  'generation_s_total': sum(sum(x['runtime_s'] for x in r['attempts']) for r in recs),
+                  'cost_scope': 'generation seconds of records in this shard dir; loading/interrupted cost in executions.jsonl'})
+
+
+def smi_free():
+    raw = subprocess.check_output(['nvidia-smi', '--query-gpu=index,memory.free,memory.used,memory.total', '--format=csv,noheader,nounits'], text=True)
+    return {x.split(',')[0].strip(): [int(v) for v in x.split(',')[1:]] for x in raw.splitlines()}
+
+
+def next_attempt(out):
+    nums = [int(m.group(1)) for p in Path(out).glob('launch*_worker*.stdout.log') for m in [re.match(r'launch(\d+)_worker', p.name)] if m]
+    return max(nums) + 1 if nums else 0
+
+
+def launch(a):
+    out = Path(a.out).resolve()
+    out.relative_to(R101)
+    out.mkdir(parents=True, exist_ok=True)
+    allowed = os.environ['CUDA_VISIBLE_DEVICES'].split(',')
+    reqs = requests(a.stage)
+    reqmap = {r['id']: r for r in reqs}
+    with (out / 'launcher.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        sci = scientific_protocol(a.stage, a.workers)
+        sd = sha_obj(sci)
+        mp = out / 'mapping.json'
+        want_map = {'stage': a.stage, 'workers': a.workers, 'scientific_digest': sd}
+        if mp.exists():
+            assert json.loads(mp.read_text()) == want_map, 'launcher mapping/protocol changed (source or inputs differ)'
+        else:
+            save(mp, want_map)
+        # 완료 검증: 모든 shard completion이 있으면 hash를 재검증하고 종료
+        if all((shard_dir(out, s) / 'completion.json').exists() for s in range(a.workers)):
+            total = 0
+            for s in range(a.workers):
+                c, recs = verify_completion(shard_dir(out, s), reqmap, sd)
+                total += len(recs)
+            assert total == len(reqs)
+            return 0
+        procs, logs = [], []
+        attempt = next_attempt(out)
+        start = time.monotonic()
+        env = isolated_env()
+
+        def stop(*args):
+            raise KeyboardInterrupt('supervisor stopped; terminating owned children')
+        signal.signal(signal.SIGTERM, stop)
+        admission = []
+        try:
+            for s in range(a.workers):
+                if (shard_dir(out, s) / 'completion.json').exists():
+                    continue
+                st = smi_free()
+                apps = subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid,used_memory', '--format=csv,noheader,nounits'], text=True)
+                actual = {int(x.split(',')[0]): int(x.split(',')[1]) for x in apps.splitlines() if x.strip()}
+                choices = {g: st[g][0] - sum(max(0, a.peak_mib - actual.get(p.pid, 0)) + MARGIN_MIB for _, p, gg in procs if gg == g and p.poll() is None)
+                           for g in allowed}
+                gpu = max(choices, key=choices.get)
+                admission.append({'shard': s, 'choices_free_mib': choices, 'chosen': gpu, 'need_mib': a.peak_mib + MARGIN_MIB,
+                                  'smi': st})
+                assert choices[gpu] >= a.peak_mib + MARGIN_MIB, ('memory admission refused', choices)
+                cmd = [str(CURE_PY), str(ROOT / 'report101_cure.py'), 'worker', '--stage', a.stage, '--out', str(out), '--gpu', gpu,
+                       '--shard', str(s), '--nshards', str(a.workers)] + (['--limit', str(a.limit)] if a.limit else [])
+                so = (out / f'launch{attempt}_worker{s}.stdout.log').open('x')
+                se = (out / f'launch{attempt}_worker{s}.stderr.log').open('x')
+                logs.extend([so, se])
+                procs.append((s, subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=so, stderr=se), gpu))
+                time.sleep(a.stagger)
+            with (out / f'launch{attempt}_resource.jsonl').open('x') as rf:
+                while any(p.poll() is None for _, p, _ in procs):
+                    rf.write(json.dumps({'t': time.time(), 'smi': smi_free()}) + '\n')
+                    rf.flush()
+                    time.sleep(15)
+            codes = {s: p.wait() for s, p, _ in procs}
+        finally:
+            for _, p, _ in procs:
+                if p.poll() is None:
+                    p.terminate()
+            for _, p, _ in procs:
+                p.wait()
+            for f in logs:
+                f.close()
+        save(out / f'launch_{attempt:03}.json', dict(codes=codes, wall_s=time.monotonic() - start, mapping={s: g for s, _, g in procs},
+                                                      scientific_digest=sd, allowed=allowed, admission=admission, peak_mib=a.peak_mib,
+                                                      script_sha256=sha(__file__)))
+        assert all(c == 0 for c in codes.values()), codes
+        if all((shard_dir(out, s) / 'completion.json').exists() for s in range(a.workers)):
+            save(out / 'completion.json', {'stage': a.stage, 'workers': a.workers, 'n': len(reqs), 'scientific_digest': sd,
+                                           'files': {f'shard{s}/completion.json': sha(shard_dir(out, s) / 'completion.json') for s in range(a.workers)}})
+            return 0
+        return 0 if a.limit else 2
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('command', choices=['worker', 'launch'])
+    p.add_argument('--stage', choices=['D4', 'S24'], required=True)
+    p.add_argument('--out', required=True)
+    p.add_argument('--gpu')
+    p.add_argument('--shard', type=int, default=0)
+    p.add_argument('--nshards', type=int, default=1)
+    p.add_argument('--workers', type=int, default=2)
+    p.add_argument('--limit', type=int, default=0, help='통제된 중단 시험용: 이번 실행 저장 최대 요청 수')
+    p.add_argument('--peak-mib', type=int, default=10100)
+    p.add_argument('--stagger', type=float, default=20.0)
+    a = p.parse_args()
+    raise SystemExit(worker(a) if a.command == 'worker' else launch(a))
diff --git a/report101_data.py b/report101_data.py
new file mode 100644
index 0000000..314e9f4
--- /dev/null
+++ b/report101_data.py
@@ -0,0 +1,307 @@
+"""iter_101: 별도 PadChest-GR 공식 train 환자의 흉수 명시 양성/음성 자료 선정 (CPU only, 모델 출력 미사용).
+
+단계:
+  enumerate : train 전체에서 문장 whitelist(수동 검토 규칙)로 영상 단위 흉수 상태 후보를 만들고 hash 순서·제외 근거·노출 기록을 저장.
+  extract   : 각 상태 앞 20명(D4 2 + S24 12 + 시각 제외 예비 6)의 영상을 uint16>>8 uint8 PNG로 추출하고 contact sheet를 만든다.
+  lock      : visual_audit.json(눈으로 확인한 제외 ID) 반영 후 D4/S24 입력·정답·잠금을 쓴다.
+영상 규약은 report86_build_E와 동일(uint16 -> uint8 right shift 8). 새 산출물은 results/iter_101 아래에만 쓴다.
+문장 whitelist는 원문을 사람(assistant)이 검토해 정한 것이며 전문의 검토가 아니다. 자동 정규식은 후보 열거에만 쓴다.
+"""
+import hashlib
+import io
+import json
+import os
+import re
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+import pg39_data as D
+from report86_common import ROOT, sha, sha_obj, save
+
+R101 = ROOT / "results/iter_101"
+DATA = R101 / "data"
+TAG = "101"
+N_POOL = 20          # 상태별 추출 풀(앞 20): D4 2 + S24 12 + 시각 제외 예비 6
+N_D, N_S = 2, 12
+
+# 수동 검토로 정한 whitelist(원문 sentence_en 정확 일치). 시간 비교·완화(probable/could/suspicion/signs of)·크기 제한 부정·
+# 위치 불명확(ipsilateral)·fissure 국한·known·다른 부위(pericardial) 문장은 주상태 정답으로 쓰지 않는다.
+POS_OK = {
+    "Left pleural effusion.", "Bilateral pleural effusion.", "Pleural effusion.", "Right pleural effusion.",
+    "Small pleural effusion.", "Small left pleural effusion.", "Small right pleural effusion.", "Slight left pleural effusion.",
+    "Minimal left pleural effusion.", "Moderate right pleural effusion.", "Presence of left pleural effusion.",
+    "Scant bilateral pleural effusion.", "Significant bilateral pleural effusion.", "Slight component of left pleural effusion.",
+    "Small amount of bilateral pleural effusion.", "Small pleural effusion located in the left posterior costophrenic angle.",
+    "Massive right pleural effusion, which displaces the mediastinum contralaterally.",
+}
+NEG_OK = {
+    "There is no evidence of effusion.", "No pleural effusion.", "There is no pleural effusion.", "No pleural effusion is appreciated.",
+    "No pleural effusion is observed.", "There is no evidence of pleural effusion or thickening.", "No pleural effusion or thickening.",
+    "No signs suggestive of pleural effusion.", "There are no signs of pleural effusion.",
+    "No condensations or pleural effusion are visualized.", "No infiltrates or pleural effusion in the current study.",
+    "I do not appreciate pleural effusion.", "There is no evidence of consolidation or effusion.",
+}
+# 영상 안에 이 용어가 하나라도 whitelist 밖 문장으로 있으면 해당 영상은 모호하므로 제외(양·음 공통).
+RELATED = re.compile(r"effusion|pleural fluid|fluid|hydrothorax|blunting|costophrenic|pleural (collection|liquid)|empyema", re.I)
+
+
+def hkey(pid, iid):
+    return hashlib.sha256(f"{TAG}|{pid}|{iid}".encode()).hexdigest()
+
+
+def prior_id_sets():
+    """이전 반복 산출물에서 ImageID/PatientID/StudyID를 모아 제외·노출 기록에 쓴다."""
+    pats = {"E96": set(), "D8_iter085": set(), "iter100": set()}
+    E = json.load(open(ROOT / "results/iter_086/E/inputs_E96.json"))
+    E2 = json.load(open(ROOT / "results/iter_086/E/inputs_E192x.json"))
+    D8 = json.load(open(ROOT / "results/iter_085/D8/inputs.json"))
+    ex = {"patients": set(), "studies": set(), "images": set()}
+    for name, rows in (("E96", E), ("E192x", E2), ("D8", D8)):
+        for r in rows:
+            ex["patients"].add(r["PatientID"]); ex["studies"].add(r["StudyID"]); ex["images"].add(r["ImageID"])
+    # iter_100 선정 환자(D8 4명 + main 환자) 이미지 ID
+    for p in (ROOT / "results/iter_100/data").rglob("requests.json"):
+        for r in json.load(open(p)):
+            ex["images"].add(r["id"].split("|")[0])
+    # 보호된 확인 manifest: iter_040 manifest_eval(V96 + H192 held 192), iter_039 D24/E96/F 계열 manifest
+    protected = list((ROOT / "results/iter_040/data").glob("manifest_eval_private.jsonl")) + \
+        list((ROOT / "results/iter_039/data").glob("manifest*.jsonl"))
+    assert protected, "protected manifests not found"
+    ex["protected_files"] = [str(p.relative_to(ROOT)) for p in protected]
+    for p in protected:
+        for ln in open(p):
+            d = json.loads(ln)
+            ex["patients"].add(d["PatientID"]); ex["studies"].add(d["StudyID"]); ex["images"].add(d["ImageID"])
+    return ex
+
+
+def scan_exposure(target_ids):
+    """results/iter_0*의 json/jsonl/csv/txt에서 target ImageID가 등장한 모든 파일(과거 사용·학습 노출 기록용). {id: [files]}"""
+    pat = re.compile(r"[0-9]{20,}_[0-9a-z]+\.png")
+    seen = {}
+    for dirpath, dns, fns in os.walk(ROOT / "results"):
+        dns[:] = [d for d in dns if d not in ("runtime_cache", "models", "hf", "images", "raw", "environments", "external", "datasets", "iter_101")]
+        for fn in fns:
+            if not fn.endswith((".json", ".jsonl", ".csv", ".txt")):
+                continue
+            p = Path(dirpath) / fn
+            try:
+                if p.stat().st_size > 60 << 20:
+                    continue
+                txt = p.read_text(errors="ignore")
+            except OSError:
+                continue
+            for m in set(pat.findall(txt)):
+                if m in target_ids:
+                    seen.setdefault(m, []).append(str(p.relative_to(ROOT)))
+    return seen
+
+
+def image_status(r, links):
+    """영상 단위 흉수 상태. returns (status, reason, sentences)."""
+    pos, neg, other = [], [], []
+    for f in r["findings"]:
+        s = f["sentence_en"]
+        if s in POS_OK:
+            pos.append(s)
+        elif s in NEG_OK:
+            neg.append(s)
+        elif RELATED.search(s):
+            other.append(s)
+    if other:
+        return None, "related_nonwhitelist_sentence", other
+    if pos and neg:
+        return None, "pos_and_neg_in_image", pos + neg
+    if pos:
+        return "POS", "", pos
+    if neg:
+        return "NEG", "", neg
+    return None, "no_effusion_statement", []
+
+
+def do_enumerate():
+    reports, m, links = D.load_inputs()
+    ex = prior_id_sets()
+    train = [r for r in reports if links["img2split"][r["ImageID"]] == "train"]
+    per_img, excl = {}, Counter()
+    for r in train:
+        iid = r["ImageID"]
+        st, why, sents = image_status(r, links)
+        if st is None:
+            if why != "no_effusion_statement":
+                excl[why] += 1
+            continue
+        pid = links["img2patient"][iid]
+        if pid in ex["patients"] or links["img2study"][iid] in ex["studies"] or iid in ex["images"]:
+            excl["overlap_prior_selected_sets"] += 1
+            continue
+        per_img[iid] = {"ImageID": iid, "PatientID": pid, "StudyID": r["StudyID"], "status": st, "sentences": sents,
+                        "has_previous": r["PreviousImageID"] is not None, "n_findings": len(r["findings"]), "hash": hkey(pid, iid)}
+    # 환자 내 상태 혼재 제외
+    by_pat = defaultdict(list)
+    for v in per_img.values():
+        by_pat[v["PatientID"]].append(v)
+    mixed = {p for p, vs in by_pat.items() if len({v["status"] for v in vs}) > 1}
+    excl["patient_mixed_states"] = len(mixed)
+    reps = []
+    for p, vs in by_pat.items():
+        if p in mixed:
+            continue
+        reps.append(min(vs, key=lambda v: v["hash"]))
+    order = {s: sorted([v for v in reps if v["status"] == s], key=lambda v: v["hash"]) for s in ("POS", "NEG")}
+    pool_ids = {v["ImageID"] for s in order for v in order[s][:N_POOL]}
+    expo = scan_exposure(pool_ids)
+    for s in order:
+        for v in order[s][:N_POOL]:
+            v["earlier_use_files"] = expo.get(v["ImageID"], [])
+    out = {"rule": "train only; image-level whitelist state; patient representative = min sha256('101|PatientID|ImageID') among qualifying images; "
+                   "patients with both states excluded; order by representative hash; D4=first2, S24=next12 per state; spare=next6 (visual exclusion only)",
+           "pos_ok": sorted(POS_OK), "neg_ok": sorted(NEG_OK), "related_regex": RELATED.pattern,
+           "n_train_images": len(train), "exclusions": dict(excl),
+           "n_images_with_status": Counter(v["status"] for v in per_img.values()),
+           "n_patients_by_status": {s: len(order[s]) for s in order},
+           "sentence_counts": {s: Counter(x for v in per_img.values() if v["status"] == s for x in v["sentences"]) for s in ("POS", "NEG")},
+           "ordered_pool": {s: order[s][:N_POOL] for s in order},
+           "protected_files": ex["protected_files"], "n_excluded_ids": {k: len(ex[k]) for k in ("patients", "studies", "images")},
+           "raw_sha256": D.PINNED, "code_sha256": sha(__file__)}
+    save(DATA / "enumeration.json", out)
+    print(json.dumps({k: out[k] for k in ("n_train_images", "exclusions", "n_images_with_status", "n_patients_by_status")}, default=dict, indent=1))
+
+
+def extract_one(z, zi, iid):
+    raw = z.read(zi)
+    a = np.asarray(Image.open(io.BytesIO(raw)))
+    if a.dtype != np.uint16 or a.ndim != 2:
+        raise D.InputError(f"{iid}: unexpected dtype/shape {a.dtype} {a.shape}")
+    b = (a >> 8).astype(np.uint8)
+    (DATA / "images").mkdir(parents=True, exist_ok=True)
+    (DATA / "raw").mkdir(parents=True, exist_ok=True)
+    pu8, praw = DATA / "images" / iid, DATA / "raw" / iid
+    if praw.exists():
+        assert praw.read_bytes() == raw
+    else:
+        praw.write_bytes(raw)
+    if not pu8.exists():
+        tmp = str(pu8) + f".{os.getpid()}.tmp.png"
+        Image.fromarray(b).save(tmp)
+        os.replace(tmp, pu8)
+    h, w = a.shape
+    return {"image": str(pu8), "raw_path": str(praw), "zip_member": zi.filename, "zip_crc": zi.CRC,
+            "raw_png_sha256": hashlib.sha256(raw).hexdigest(), "u16_pixel_sha256": hashlib.sha256(a.tobytes()).hexdigest(),
+            "u8_pixel_sha256": hashlib.sha256(b.tobytes()).hexdigest(), "file_sha256": sha(pu8), "h": int(h), "w": int(w),
+            "u16_min": int(a.min()), "u16_max": int(a.max())}
+
+
+def do_extract():
+    en = json.loads((DATA / "enumeration.json").read_text())
+    z = D.open_image_zip()
+    idx = D.zip_index(z)
+    meta = {}
+    for s in ("POS", "NEG"):
+        for rank, v in enumerate(en["ordered_pool"][s]):
+            meta[v["ImageID"]] = {**extract_one(z, idx[v["ImageID"]], v["ImageID"]), "status": s, "rank": rank,
+                                  "PatientID": v["PatientID"], "StudyID": v["StudyID"]}
+    pix = Counter(m["u16_pixel_sha256"] for m in meta.values())
+    dups = [k for k, c in pix.items() if c > 1]
+    # 이전 manifest와의 pixel 중복
+    prior_pix = set()
+    for p in (ROOT / "results").glob("iter_0*/data/manifest*.jsonl"):
+        for ln in open(p):
+            try:
+                d = json.loads(ln)
+            except ValueError:
+                continue
+            h = (d.get("image_meta") or {}).get("u16_pixel_sha256")
+            if h:
+                prior_pix.add(h)
+    for q in (ROOT / "results").glob("iter_*/*/inputs*.json"):
+        try:
+            for d in json.load(open(q)):
+                if isinstance(d, dict) and d.get("u16_pixel_sha256"):
+                    prior_pix.add(d["u16_pixel_sha256"])
+        except (ValueError, OSError):
+            pass
+    ov = {"within_pool_duplicate_pixel_hashes": len(dups),
+          "pixel_overlap_with_prior_manifests": sum(m["u16_pixel_sha256"] in prior_pix for m in meta.values()),
+          "n_prior_pixel_hashes_checked": len(prior_pix)}
+    save(DATA / "extract_meta.json", {"meta": meta, "overlaps": ov, "convention": "uint16>>8 -> uint8 (iter_039/042/086과 동일)",
+                                      "projection_note": "PadChest-GR 공개 metadata(report json, master_table)에 projection 필드 없음 — 시각 점검으로만 확인"})
+    order = sorted((m["status"], m["rank"], k) for k, m in meta.items())
+    from PIL import ImageDraw
+    sheets = []
+    for s in range(0, len(order), 20):
+        part = order[s:s + 20]
+        sheet = Image.new("L", (5 * 300, 4 * 320), 0)
+        dr = ImageDraw.Draw(sheet)
+        for i, (st, rank, k) in enumerate(part):
+            im = Image.open(DATA / "images" / k).convert("L")
+            im.thumbnail((300, 296))
+            x, y = (i % 5) * 300, (i // 5) * 320
+            sheet.paste(im, (x, y + 22))
+            dr.text((x + 4, y + 4), f"{st}{rank} {k[:6]}", fill=255)
+        p = DATA / "contact" / f"sheet_{s // 20:02d}.png"
+        p.parent.mkdir(exist_ok=True)
+        sheet.save(p)
+        sheets.append({"file": str(p), "items": [f"{st}{rank}:{k}" for st, rank, k in part]})
+    save(DATA / "contact_sheets.json", sheets)
+    print(json.dumps(ov), len(sheets), "sheets")
+
+
+def do_lock():
+    en = json.loads((DATA / "enumeration.json").read_text())
+    meta = json.loads((DATA / "extract_meta.json").read_text())["meta"]
+    audit = json.loads((DATA / "visual_audit.json").read_text())
+    excluded = {x["ImageID"] for x in audit["excluded"]}
+    rows, raws, refs, sel = [], [], {}, {}
+    for s in ("POS", "NEG"):
+        keep = [v for v in en["ordered_pool"][s] if v["ImageID"] not in excluded]
+        assert len(keep) >= N_D + N_S, (s, len(keep))
+        sel[s] = {"D4": keep[:N_D], "S24": keep[N_D:N_D + N_S]}
+    for stage in ("D4", "S24"):
+        rr, rw = [], []
+        for s in ("POS", "NEG"):
+            for v in sel[s][stage]:
+                m = meta[v["ImageID"]]
+                rr.append({"PatientID": v["PatientID"], "StudyID": v["StudyID"], "ImageID": v["ImageID"], "image": m["image"],
+                           "file_sha256": m["file_sha256"], "mode": "L", "size": [m["w"], m["h"]], "source": "iter_101 PadChest-GR train",
+                           "split": "train", "stratum": s, "order_hash": v["hash"], "u16_pixel_sha256": m["u16_pixel_sha256"]})
+                rw.append({"ImageID": v["ImageID"], "raw_path": m["raw_path"], "sha256": m["raw_png_sha256"]})
+                refs[v["ImageID"]] = {"ImageID": v["ImageID"], "PatientID": v["PatientID"], "StudyID": v["StudyID"], "status": s, "stage": stage,
+                                      "reference_sentences": v["sentences"], "earlier_use_files": v.get("earlier_use_files")}
+        rr.sort(key=lambda r: r["order_hash"])  # 두 상태를 섞어 처리 순서를 고정
+        order = {r["ImageID"]: i for i, r in enumerate(rr)}
+        rw.sort(key=lambda r: order[r["ImageID"]])
+        save(DATA / f"inputs_{stage}.json", rr)
+        save(DATA / f"raw_manifest_{stage}.json", rw)
+    save(DATA / "reference_private.json", refs)
+    lock = {"enumeration_sha256": sha(DATA / "enumeration.json"), "extract_meta_sha256": sha(DATA / "extract_meta.json"),
+            "visual_audit_sha256": sha(DATA / "visual_audit.json"), "inputs_D4_sha256": sha(DATA / "inputs_D4.json"),
+            "inputs_S24_sha256": sha(DATA / "inputs_S24.json"), "reference_sha256": sha(DATA / "reference_private.json"),
+            "counts": {st: Counter(r["stratum"] for r in json.loads((DATA / f"inputs_{st}.json").read_text())) for st in ("D4", "S24")},
+            "code_sha256": sha(__file__), "n_excluded_visual": len(excluded)}
+    # 환자/영상/study/pixel 교차 중복 검사
+    allrows = json.loads((DATA / "inputs_D4.json").read_text()) + json.loads((DATA / "inputs_S24.json").read_text())
+    for k in ("PatientID", "StudyID", "ImageID", "u16_pixel_sha256"):
+        assert len({r[k] for r in allrows}) == len(allrows), k
+    ex = prior_id_sets()
+    prot_pix = set()
+    for f in ex["protected_files"]:
+        for ln in open(ROOT / f):
+            h = (json.loads(ln).get("image_meta") or {}).get("u16_pixel_sha256")
+            if h:
+                prot_pix.add(h)
+    assert prot_pix, "no protected pixel hashes"
+    lock["protected_pixel_overlap"] = sum(r["u16_pixel_sha256"] in prot_pix for r in allrows)
+    lock["n_protected_pixel_hashes"] = len(prot_pix)
+    assert lock["protected_pixel_overlap"] == 0
+    assert not any(r["PatientID"] in ex["patients"] or r["ImageID"] in ex["images"] or r["StudyID"] in ex["studies"] for r in allrows)
+    save(DATA / "selection_lock.json", lock)
+    print(json.dumps(lock, indent=1, default=dict))
+
+
+if __name__ == "__main__":
+    {"enumerate": do_enumerate, "extract": do_extract, "lock": do_lock}[sys.argv[1]]()
diff --git a/report101_eval.py b/report101_eval.py
new file mode 100644
index 0000000..b3774c2
--- /dev/null
+++ b/report101_eval.py
@@ -0,0 +1,205 @@
+"""iter_101 평가: 수동(assistant) 사실 판정표(judgments)에서 환자별 지표·paired 차이·민감도·사전 분기를 계산한다. 의미 판정은 생성하지 않는다.
+
+판정표 형식(blind_id별):
+ state: correct | wrong | none  (POS reference: 필요한 쪽(need_sides)에 흉수 존재를 확정 주장하면 correct; 존재를 부정하거나 반대쪽만이면 wrong; 언급 없음/불확정이면 none)
+ opposing: bool    reference와 반대되는 흉수 주장(필요한 쪽의 명시 부정 등)
+ internal_conflict: bool   출력 안에서 같은 쪽 흉수 존재와 부재를 모두 확정 주장
+ atoms: {A1: kept|lost|ambiguous}   원 초안의 reference-지지 사실(P)의 보존 (U atom은 판정하지 않음)
+ new_explicit_error: [quote]   K에 없던 새 주장 중 reference가 명시 반박하는 것
+ unverifiable_added: [quote]   K에 없던 새 주장 중 reference에 없는 것(unknown)
+ format: plain | json | other
+ 모든 quote는 해당 출력 원문의 부분문자열이어야 한다(대소문자 무시).
+안전한 정답 환자(safe_correct) = state==correct ∧ ¬opposing ∧ ¬internal_conflict ∧ 모든 P atom=kept ∧ new_explicit_error 없음 (K 대비).
+사전 분기(계획의 Evaluation 그대로, 결과 보기 전에 고정): decide() 참조.
+"""
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+from report86_common import ROOT, save, sha
+
+R101 = ROOT / 'results/iter_101'
+CONDS = ['K', 'A', 'T', 'V', 'W']
+BOOT_N, BOOT_SEED = 10000, 101017
+
+
+def load_all():
+    blind = R101 / 'eval/blind'
+    mapping = json.loads((blind / 'private_mapping.json').read_text())
+    review = json.loads((blind / 'review_input.json').read_text())['review']
+    text = {o['blind_id']: o for p in review for o in p['outputs']}
+    return mapping, review, text
+
+
+def validate(judg, mapping, review, text):
+    """판정표 완전성·quote 일치 검사. 문제 목록을 반환한다."""
+    probs = []
+    if set(judg) != set(mapping):
+        probs.append(('judgment_ids_differ', sorted(set(mapping) ^ set(judg))))
+    atoms_by_patient = {p['patient_index']: p['atoms'] for p in review}
+    pat_of = {o['blind_id']: p['patient_index'] for p in review for o in p['outputs']}
+    for b, j in judg.items():
+        t = text[b]['text'].lower()
+        if j['state'] not in ('correct', 'wrong', 'none'):
+            probs.append((b, 'bad_state'))
+        need = [a[0] for a in atoms_by_patient[pat_of[b]] if a[1] == 'P']
+        if set(j['atoms']) != set(need):
+            probs.append((b, 'atoms_mismatch', sorted(j['atoms']), need))
+        if any(v not in ('kept', 'lost', 'ambiguous') for v in j['atoms'].values()):
+            probs.append((b, 'bad_atom_value'))
+        qs = list(j.get('new_explicit_error', [])) + list(j.get('unverifiable_added', [])) + list(j.get('opposing_quotes', [])) + \
+            list(j.get('conflict_quotes', [])) + [q for q in [j.get('state_quote')] if q] + [q for q in j.get('atom_quotes', {}).values() if q]
+        for q in qs:
+            if q.lower() not in t:
+                probs.append((b, 'quote_not_in_text', q))
+        if j['opposing'] and not j.get('opposing_quotes'):
+            probs.append((b, 'opposing_without_quote'))
+        if j['internal_conflict'] and not j.get('conflict_quotes'):
+            probs.append((b, 'conflict_without_quote'))
+    return probs
+
+
+def per_patient(judg, mapping, review):
+    pat = {}
+    for p in review:
+        pat[p['patient_index']] = {'ref_state': p['ref_state'], 'cond': {}}
+    for o_p in review:
+        for o in o_p['outputs']:
+            m = mapping[o['blind_id']]
+            j = judg[o['blind_id']]
+            lost = [a for a, v in j['atoms'].items() if v == 'lost']
+            amb = [a for a, v in j['atoms'].items() if v == 'ambiguous']
+            safe = j['state'] == 'correct' and not j['opposing'] and not j['internal_conflict'] and not lost and not amb and not j['new_explicit_error']
+            safe_amb_excl = j['state'] == 'correct' and not j['opposing'] and not j['internal_conflict'] and not lost and not j['new_explicit_error']
+            safe_unv_excl = safe and not j['unverifiable_added']
+            safe_fmt = safe and j['format'] == 'plain' and not o['non_eos']
+            harm = bool(lost or amb or j['new_explicit_error'] or j['internal_conflict'] or j['opposing'])
+            pat[o_p['patient_index']]['cond'][m['condition']] = {
+                'safe': safe, 'safe_ambiguous_atoms_excluded': safe_amb_excl, 'safe_unverifiable_excluded': safe_unv_excl,
+                'safe_format_valid': safe_fmt,
+                'harm_P_or_explicit': harm, 'P_lost': bool(lost), 'explicit_error': bool(j['new_explicit_error'] or j['opposing']),
+                'internal_conflict': bool(j['internal_conflict']), 'state': j['state'], 'unverifiable_added': len(j['unverifiable_added']),
+                'non_eos': text_flag(o), 'format': j['format'], 'chars': o['chars']}
+    return pat
+
+
+def text_flag(o):
+    return bool(o['non_eos'])
+
+
+def net(pat, x, y, key='safe', idx=None):
+    ids = idx if idx is not None else sorted(pat)
+    xo = sum(1 for i in ids if pat[i]['cond'][x][key] and not pat[i]['cond'][y][key])
+    yo = sum(1 for i in ids if pat[i]['cond'][y][key] and not pat[i]['cond'][x][key])
+    return xo - yo, xo, yo
+
+
+def boot(pat, x, y, key='safe'):
+    ids = sorted(pat)
+    d = np.array([int(pat[i]['cond'][x][key]) - int(pat[i]['cond'][y][key]) for i in ids])
+    rng = np.random.default_rng(BOOT_SEED)
+    s = d[rng.integers(0, len(d), size=(BOOT_N, len(d)))].sum(axis=1)
+    return {'net': int(d.sum()), 'ci95': [float(np.percentile(s, 2.5)), float(np.percentile(s, 97.5))], 'degenerate': bool(len(set(s.tolist())) == 1)}
+
+
+def loo(pat, x, y):
+    ids = sorted(pat)
+    vals = [net(pat, x, y, idx=[j for j in ids if j != i])[0] for i in ids]
+    return {'min': min(vals), 'max': max(vals), 'values': dict(zip(ids, vals))}
+
+
+def decide(pat, conflict_states, w_available=True):
+    """계획의 사전 분기. 결과를 보기 전에 고정한 정의."""
+    M = len(pat)
+    ids = sorted(pat)
+    t_safe = sum(pat[i]['cond']['T']['safe'] for i in ids)
+    v_safe = sum(pat[i]['cond']['V']['safe'] for i in ids)
+    vt, vt_o, tv_o = net(pat, 'V', 'T')
+    vw, vw_o, wv_o = net(pat, 'V', 'W')
+    by_state = {}
+    for st in ('POS', 'NEG'):
+        sub = [i for i in ids if pat[i]['ref_state'] == st]
+        by_state[st] = {'n': len(sub), 'V_over_T': sum(1 for i in sub if pat[i]['cond']['V']['safe'] and not pat[i]['cond']['T']['safe'])}
+    harm = {c: sum(pat[i]['cond'][c]['harm_P_or_explicit'] for i in ids) for c in CONDS}
+    sens_amb = net(pat, 'V', 'T', 'safe_ambiguous_atoms_excluded')[0]
+    sens_unv = net(pat, 'V', 'T', 'safe_unverifiable_excluded')[0]
+    fmt = {c: sum(pat[i]['cond'][c]['safe_format_valid'] for i in ids) for c in CONDS}
+    sens_fmt = {'V_minus_T': net(pat, 'V', 'T', 'safe_format_valid')[0], 'V_minus_W': net(pat, 'V', 'W', 'safe_format_valid')[0], 'safe_counts': fmt}
+    crit = {'V_minus_T_ge_3': vt >= 3, 'V_minus_W_ge_2': w_available and vw >= 2,
+            'T_improvement_in_both_states': by_state['POS']['V_over_T'] >= 1 and by_state['NEG']['V_over_T'] >= 1,
+            'V_harm_not_above_K_and_T': harm['V'] <= harm['K'] and harm['V'] <= harm['T'],
+            'direction_kept_ambiguous_atoms_excluded': sens_amb > 0, 'direction_kept_unverifiable_excluded': sens_unv > 0}
+    one_state_bias = len(set(conflict_states)) < 2
+    text_sufficient = t_safe == M and vt <= 0
+    v_no_gain = vt <= 0 or harm['V'] > harm['T']
+    if all(crit.values()):
+        label = 'positive_exploration'
+    elif text_sufficient:
+        label = 'negative_text_sufficient'
+    elif v_no_gain:
+        label = 'negative_V_no_gain_hold_frozen_interface'
+    else:
+        label = 'inconclusive'
+    return {'label': label, 'criteria': crit, 'V_minus_T': vt, 'V_only_vs_T': vt_o, 'T_only_vs_V': tv_o, 'V_minus_W': vw, 'V_only_vs_W': vw_o,
+            'W_only_vs_V': wv_o, 'safe_counts': {c: sum(pat[i]['cond'][c]['safe'] for i in ids) for c in CONDS}, 'harm_counts': harm,
+            'by_state_V_over_T': by_state, 'conflict_states': sorted(conflict_states), 'one_state_bias_in_conflict_group': one_state_bias,
+            'sens_V_minus_T_ambiguous_atoms_excluded': sens_amb, 'sens_V_minus_T_unverifiable_excluded': sens_unv, 'sens_format_valid_only': sens_fmt, 'M': M, 'T_safe_all': t_safe == M}
+
+
+def main():
+    jf = Path(sys.argv[1])
+    out = Path(sys.argv[2])
+    mapping, review, text = load_all()
+    judg = json.loads(jf.read_text())
+    probs = validate(judg, mapping, review, text)
+    assert not probs, probs
+    sel = json.loads((R101 / 'data/lock/selection.json').read_text())
+    atoms = json.loads((R101 / 'data/lock/atoms.json').read_text())
+    inputs = {r['ImageID']: r for r in json.loads((R101 / 'data/inputs_S24.json').read_text())}
+    conflict_states = [inputs[i]['stratum'] for i in sel['conflicts']]
+    pat = per_patient(judg, mapping, review)
+    dec = decide(pat, conflict_states)
+    conflicts_idx = {atoms['index'][i] for i in sel['conflicts']}
+    groups = {}
+    for name, ids in (('conflict', sorted(conflicts_idx)), ('control', sorted(set(pat) - conflicts_idx))):
+        groups[name] = {'n': len(ids), 'safe': {c: sum(pat[i]['cond'][c]['safe'] for i in ids) for c in CONDS},
+                        'V_minus_T': net(pat, 'V', 'T', idx=ids), 'V_minus_W': net(pat, 'V', 'W', idx=ids),
+                        'T_minus_K': net(pat, 'T', 'K', idx=ids), 'V_minus_K': net(pat, 'V', 'K', idx=ids)}
+    # donor-recipient 연결 집단: donor를 공유하거나 donor 자신이 recipient이면 같은 집단
+    don = sel['donors']
+    par = {}
+
+    def find(a):
+        while par.setdefault(a, a) != a:
+            par[a] = par[par[a]]
+            a = par[a]
+        return a
+    for r, d in don.items():
+        par[find(r)] = find(d)
+    clusters = {}
+    for r in don:
+        clusters.setdefault(find(r), []).append(r)
+    cl_idx = []
+    for members in clusters.values():
+        ix = [atoms['index'][m] for m in members if m in atoms['index']]
+        if ix:
+            cl_idx.append(ix)
+    cl_net = {}
+    for k in (('V', 'T'), ('V', 'W')):
+        d = [sum(int(pat[i]['cond'][k[0]]['safe']) - int(pat[i]['cond'][k[1]]['safe']) for i in ix) for ix in cl_idx]
+        cl_net[f'{k[0]}_minus_{k[1]}'] = {'cluster_sums': d, 'n_clusters': len(d), 'donor_reused': len(set(don.values())) < len(don)}
+    report = {'decision': dec, 'groups': groups, 'bootstrap': {'V_minus_T': boot(pat, 'V', 'T'), 'V_minus_W': boot(pat, 'V', 'W'),
+                                                              'T_minus_K': boot(pat, 'T', 'K'), 'V_minus_K': boot(pat, 'V', 'K')},
+              'leave_one_patient_out': {'V_minus_T': loo(pat, 'V', 'T'), 'V_minus_W': loo(pat, 'V', 'W')}, 'donor_recipient_cluster': cl_net,
+              'per_patient': {str(i): pat[i] for i in sorted(pat)}, 'judgments_sha256': sha(jf), 'code_sha256': sha(__file__),
+              'note': 'assistant 수동 판정 기반 탐색 분석. 확증 검정 아님; CI는 gate로 쓰지 않음. 전문의 검토 아님.'}
+    save(out, report)
+    print(json.dumps({'label': dec['label'], 'safe_counts': dec['safe_counts'], 'V_minus_T': dec['V_minus_T'], 'V_minus_W': dec['V_minus_W'],
+                      'harm': dec['harm_counts'], 'criteria': dec['criteria']}, indent=1))
+
+
+if __name__ == '__main__':
+    main()
