+"""iter_015/016 요청 행렬(qa_requests) 전용 생성 worker. generate.py의 모델 로더·adapter 로더·run_request(cap 래더 1000/2000/4000)를 재사용하고,
+요청 식별·재개 검증·claim만 request 단위로 새로 구현한다 (환자마다 prompt/evidence가 달라 전역 prompt 이름으로 식별할 수 없다).
+
+- 시작 시: qa_protocol.verify, 요청 파일이 protocol에 잠긴 파일과 같은지, 각 행의 request_id 재계산·config digest, 모든 영상의 현재 file/pixel hash.
+- adapter digest(tensor 재계산)가 모든 행의 adapter_digest와 같아야 한다 (base면 None).
+- 재개: 완료 record를 포함해 모든 worker 파일을 요청 행과 대조한다. 중복·잉여·id/prompt/adapter/config/protocol 불일치·입력 hash 변경·잘린 JSONL은 중단.
+  --repair-tail: 마지막 줄이 개행 없이 잘렸을 때만 그 줄을 *.partial로 옮기고 계속한다 (기록을 지우지 않는다).
+  iter_016 소유권: repair는 (a) 내 worker 파일(내 lock 보유) 또는 (b) 작성 worker가 종료돼 그 worker lock을 내가 확보한 파일에만 한다.
+  살아 있는 다른 worker의 파일은 읽기에서 개행 없는 마지막 줄만 유보하고 절대 수정하지 않는다.
+사용: CUDA_VISIBLE_DEVICES=<gpu> python -m rsna_diag.qa_gen --requests R --out-dir D --worker K --protocol P [--adapter DIR]
+"""
+import argparse
+import glob
+import json
+import os
+import re
+import sys
+import time
+
+from . import generate, qa_protocol, qa_requests as Q, queue_lock
+
+
+class QAError(RuntimeError):
+    pass
+
+
+def read_strict(path, repair_tail=False, tolerate_tail=False):
+    """JSONL을 읽는다. 잘린/깨진 줄은 QAError (repair_tail이면 개행 없는 마지막 줄만 격리)."""
+    if not os.path.exists(path):
+        return []
+    raw = open(path, "rb").read()
+    lines = raw.split(b"\n")
+    tail = lines[-1]
+    recs = []
+    body = lines[:-1]
+    if tail.strip() and tolerate_tail:
+        pass  # 다른 살아 있는 worker가 쓰는 중인 마지막 줄 (개행 전)은 아직 완료 요청이 아니다
+    elif tail.strip():
+        if repair_tail:
+            with open(path + ".partial", "ab") as f:
+                f.write(tail + b"\n")
+            with open(path, "wb") as f:
+                f.write(b"\n".join(body) + (b"\n" if body else b""))
+        else:
+            raise QAError(f"truncated last line (no newline) in {path}; rerun with --repair-tail to quarantine it")
+    for k, ln in enumerate(body):
+        if ln.strip():
+            try:
+                recs.append(json.loads(ln))
+            except ValueError as e:
+                raise QAError(f"corrupt JSON line {k} in {path}") from e
+    return recs
+
+
+def _worker_of(path):
+    m = re.fullmatch(r"gen_worker(\d+)\.jsonl", os.path.basename(path))
+    return int(m.group(1)) if m else None
+
+
+def _has_tail(path):
+    if not os.path.exists(path):
+        return False
+    with open(path, "rb") as f:
+        data = f.read()
+    return bool(data.split(b"\n")[-1].strip())
+
+
+def read_all_owned(out_dir, my_worker, repair, live, info):
+    """out_dir의 모든 gen_worker*.jsonl을 읽는다. 잘린 마지막 줄의 처리:
+    내 파일 -> repair 옵션이 있으면 격리·복구, 없으면 오류(live=False). 다른 worker 파일 -> 그 worker의 lock을 non-blocking으로 시도해
+    확보되면(작성자 종료) repair 옵션에 따라 복구/오류, 확보 실패(작성자 생존)이면 읽기에서만 유보하고 수정하지 않는다.
+    tail이 없는 파일은 lock을 건드리지 않는다 (동시에 시작하는 worker의 lock을 잠시라도 가로채지 않는다)."""
+    out = {}
+    for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        w = _worker_of(f)
+        if w == my_worker or not _has_tail(f):
+            out[f] = read_strict(f, repair_tail=repair and w == my_worker and not live)
+            continue
+        lk, _, _ = queue_lock.try_lock(os.path.join(out_dir, f"worker{w}.lock"), info)
+        if lk is None:
+            out[f] = read_strict(f, tolerate_tail=True)  # 살아 있는 writer: 수정 금지
+        else:
+            try:  # 작성자가 종료했고 lock을 내가 잡고 있다
+                out[f] = read_strict(f, repair_tail=repair and not live, tolerate_tail=live)
+            finally:
+                lk.release()
+    return out
+
+
+def validate_records(files_records, rows, cdig, adapter_digest, protocol_digest, pixel_sha):
+    """모든 기존 record를 현재 요청 행과 대조. returns {request_id: record}. 누락은 허용, 중복·잉여·불일치는 QAError."""
+    by = {r["request_id"]: r for r in rows}
+    done = {}
+    for fn, recs in files_records.items():
+        for r in recs:
+            rid = r.get("request_id")
+            row = by.get(rid)
+            if row is None:
+                raise QAError(f"unexpected record {rid} in {fn}: not in current request set")
+            if rid in done:
+                raise QAError(f"duplicate record {rid} in {fn}")
+            for k, want in (("prompt_sha256", row["prompt_sha256"]), ("adapter_digest", adapter_digest), ("config_digest", cdig),
+                            ("protocol_digest", protocol_digest), ("id", row["id"]), ("condition", row["condition"]),
+                            ("checkpoint", row["checkpoint"]), ("target", row["target"]), ("fmt", row["fmt"]),
+                            ("image_file_sha256", row["file_sha256"])):
+                if r.get(k) != want:
+                    raise QAError(f"{k} mismatch for {rid} in {fn}: {r.get(k)!r} != {want!r}")
+            if r.get("input_pixel_sha256") != pixel_sha(row["image"]):
+                raise QAError(f"input image changed since generation for {rid}")
+            done[rid] = r
+    return done
+
+
+def check_inputs(rows):
+    """현재 영상의 raw pixel/file sha를 요청 행과 대조한다 (전처리 전 원본 uint8 hash)."""
+    from . import inputs
+    seen = {}
+    for r in rows:
+        key = r["image"]
+        if key in seen:
+            continue
+        if generate.sha(open(key, "rb").read()) != r["file_sha256"]:
+            raise QAError(f"file sha changed for {r['id']}")
+        if inputs.raw_pixel_sha(key) != r["pixel_sha256"]:
+            raise QAError(f"pixel sha changed for {r['id']}")
+        seen[key] = 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--worker", type=int, required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--adapter", default=None)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--max-requests", type=int, default=None)
+    ap.add_argument("--repair-tail", action="store_true")
+    a = ap.parse_args()
+    pdig = qa_protocol.verify(a.protocol)
+    if json.load(open(a.protocol))["locked"]["files"].get(a.requests) != generate.sha(open(a.requests, "rb").read()):
+        sys.exit(f"request file {a.requests} is not locked in {a.protocol} (or changed)")
+    cfg, _ = qa_protocol.static_cfg()
+    rows = Q.load_rows(a.requests, cfg)
+    if len({(r["checkpoint"], r["adapter_digest"]) for r in rows}) != 1:
+        sys.exit("one run must contain one checkpoint")
+    check_inputs(rows)
+    os.makedirs(a.out_dir, exist_ok=True)
+    info = queue_lock.my_info(worker=a.worker)
+    lk, own, _ = queue_lock.try_lock(os.path.join(a.out_dir, f"worker{a.worker}.lock"), info)
+    if lk is None:
+        sys.exit(f"worker {a.worker} already running: {own}")
+    try:
+        run_worker(a, rows, pdig, cfg, info)
+    finally:
+        lk.release()
+
+
+def run_worker(a, rows, pdig, cfg, info):
+    torch, proc, model = generate.load_model()
+    adapter_digest = generate.load_adapter(torch, model, a.adapter) if a.adapter else None
+    if adapter_digest != rows[0]["adapter_digest"]:
+        raise QAError(f"loaded adapter digest {adapter_digest} != requests {rows[0]['adapter_digest']}")
+    env = generate.env_info(torch, proc, model)
+    cdig, core = generate.config_digest(env, {})
+    if cdig != cfg:
+        raise QAError("runtime generation config digest != protocol config digest")
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    with open(os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl.env.json"), "w") as f:
+        json.dump({"env": env, "config_digest": cdig, "adapter_digest": adapter_digest, "protocol_digest": pdig,
+                   "worker": a.worker, "requests": a.requests}, f, indent=1, default=str)
+    cache = {}
+
+    def px(path):
+        if path not in cache:
+            cache[path] = generate.load_image(path)[2]
+        return cache[path]
+
+    def read_all(repair, live=False):
+        return read_all_owned(a.out_dir, a.worker, repair, live, info)
+
+    done = validate_records(read_all(a.repair_tail), rows, cdig, adapter_digest, pdig, px)
+    out = os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl")
+    claim_dir = os.path.join(a.out_dir, "claims")
+    os.makedirs(claim_dir, exist_ok=True)
+    log = open(out + ".log", "a")
+    t0, n_done = time.time(), 0
+    # id 순서 고정 (worker 간 충돌을 줄이기 위해 worker 번호로 시작 위치를 나누지 않고 claim으로만 경쟁한다)
+    for row in sorted(rows, key=lambda r: r["request_id"]):
+        if row["request_id"] in done:
+            continue
+        if (a.time_limit and time.time() - t0 > a.time_limit) or (a.max_requests is not None and n_done >= a.max_requests):
+            log.write(json.dumps({"event": "stop", "done_this_run": n_done}) + "\n")
+            break
+        clk, prev, reclaimed = queue_lock.try_lock(os.path.join(claim_dir, row["request_id"] + ".claim"), info)
+        if clk is None:
+            continue
+        try:
+            if reclaimed:
+                log.write(json.dumps({"event": "claim_reclaimed_from_dead_owner", "request_id": row["request_id"], "prev_owner": prev}) + "\n")
+            done = validate_records(read_all(False, live=True), rows, cdig, adapter_digest, pdig, px)  # claim 뒤 재검증 (다른 worker가 방금 끝냈을 수 있다)
+            if row["request_id"] in done:
+                continue
+            try:
+                rec = generate.run_request(torch, proc, model, eos_ids, {"id": row["id"], "image": row["image"], "file_sha256": row["file_sha256"]},
+                                           row["condition"], row["prompt"])
+            except torch.cuda.OutOfMemoryError as e:
+                log.write(json.dumps({"event": "oom", "request_id": row["request_id"], "err": str(e)[:200]}) + "\n")
+                log.flush()
+                raise
+            rec.update({"request_id": row["request_id"], "split": row["split"], "checkpoint": row["checkpoint"], "target": row["target"],
+                        "fmt": row["fmt"], "condition": row["condition"], "adapter_digest": adapter_digest, "protocol_digest": pdig,
+                        "config_digest": cdig, "worker": a.worker, "ts": time.time(), "gpu_uuid": env.get("gpu_uuid"),
+                        "stage": row["stage"]})
+            with open(out, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            done[row["request_id"]] = rec
+            n_done += 1
+            log.write(json.dumps({"event": "done", "request_id": row["request_id"], "n_out": rec["n_output_tokens"], "finish": rec["finish_reason"],
+                                  "runtime_s": round(rec["runtime_s_total"], 2), "peak_gb": round(rec["peak_mem_alloc_gb_max"], 2),
+                                  "elapsed": round(time.time() - t0, 1)}) + "\n")
+            log.flush()
+        finally:
+            clk.release()
+    print(f"worker {a.worker}: finished; {n_done} new requests this run", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/qa_protocol.py b/rsna_diag/qa_protocol.py
new file mode 100644
index 0000000..1886c04
--- /dev/null
+++ b/rsna_diag/qa_protocol.py
@@ -0,0 +1,103 @@
+"""iter_015/016 protocol 잠금. 기존 lock_protocol과 달리 필수 파일이 없으면 조용히 생략하지 않고 실패한다.
+
+- create: 코드(REQUIRED_CODE 전부 존재해야 함) + 명시한 extra 파일(요청·manifest 등)의 sha256과 생성 config digest를 잠근다. 기존 파일은 덮어쓰지 않는다.
+- verify: 잠긴 모든 파일이 존재하고 sha가 같으며 config digest가 현재 processor/generation_config와 같아야 통과. returns protocol digest.
+- locked_file_sha(path, file): 잠긴 파일 목록에서 특정 파일의 sha (runner가 자신의 요청 파일이 잠겨 있는지 확인).
+사용: python -m rsna_diag.qa_protocol --out P --extra F ... [--note TEXT]
+"""
+import argparse
+import json
+import os
+import sys
+
+from . import generate, lock_protocol
+
+SCHEMA = "iter016_qa_protocol_v1"  # iter_017도 같은 스키마 (REQUIRED_CODE에 ev17_* 추가)
+# 반입한 16개 파일 + 이번 반복의 신규 모듈. 하나라도 없으면 실패한다.
+REQUIRED_CODE = [
+    "rsna_diag/__init__.py", "rsna_diag/geometry.py", "rsna_diag/parse.py", "rsna_diag/metrics.py", "rsna_diag/sft_eval.py",
+    "rsna_diag/lora.py", "rsna_diag/generate.py", "rsna_diag/prompts.py", "rsna_diag/queue_lock.py", "rsna_diag/lock_protocol.py",
+    "rsna_diag/inputs.py", "rsna_diag/eval_gate.py", "rsna_diag/run_shards.py", "rsna_diag/on_gpu.py", "rsna_diag/rsna_data.py",
+    "rsna_diag/dicom_min.py",
+    "rsna_diag/qa_spec.py", "rsna_diag/qa_data.py", "rsna_diag/qa_protocol.py", "rsna_diag/qa_requests.py", "rsna_diag/qa_gen.py",
+    "rsna_diag/qa_run.py",
+    # iter_017: evidence 정보 수준(U/B/K/L/X) 진단
+    "rsna_diag/ev17_spec.py", "rsna_diag/ev17_requests.py", "rsna_diag/ev17_analysis.py", "rsna_diag/ev17_reuse.py",
+    # iter_016: semantic parser(qa_spec)·평가·보고·재사용 검증·확대 결정 코드
+    "rsna_diag/qa_eval.py", "rsna_diag/qa_report.py", "rsna_diag/qa_reuse.py", "rsna_diag/qa_scope.py", "rsna_diag/qa_pilot.py",
+    # iter_018: CheXpert target-scope 진단(질문 대상 범위 문구 이후의 다른 finding 손상). 과거(iter_015~017) protocol은
+    # 이 파일들이 존재하지 않던 시점의 REQUIRED_CODE로 잠겼으므로, 이 추가 이후에는 현재 qa_protocol.py로 재검증되지
+    # 않는다(이미 ev17_* 추가 때도 iter_016 protocol에 동일하게 발생한 기존 관례). 과거 반복은 해당 시점의 코드
+    # 커밋에서만 재검증한다.
+    "rsna_diag/cx18_spec.py", "rsna_diag/cx18_data.py", "rsna_diag/cx18_requests.py", "rsna_diag/cx18_analysis.py",
+    "rsna_diag/cx18_run.py",
+]
+
+
+def static_cfg():
+    d, core = generate.config_digest(generate.static_env(), {})
+    return d, core
+
+
+def current(extra=()):
+    missing = [f for f in list(REQUIRED_CODE) + list(extra) if not os.path.isfile(f)]
+    if missing:
+        raise RuntimeError(f"required protocol files missing: {missing}")
+    d, core = static_cfg()
+    return {"schema": SCHEMA, "files": {f: lock_protocol.sha(f) for f in list(REQUIRED_CODE) + list(extra)},
+            "generation_config_digest": d, "generation_config": core}
+
+
+def create(out, extra=(), note=""):
+    if os.path.exists(out):
+        raise RuntimeError(f"protocol exists (not overwriting): {out}")
+    cur = current(extra)
+    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
+    json.dump({"locked": cur, "note": note}, open(out, "w"), indent=1, default=str)
+    return lock_protocol.locked_digest(cur)
+
+
+def verify(path, allowed_edits=None):
+    """잠긴 모든 파일이 존재하고 sha가 같아야 통과 (파일명만으로 허용하는 우회는 없다).
+    allowed_edits: {파일: {"before": 잠긴 sha, "after": 현재 sha, "reason": 사유}} 형태의 명시적 허용. before가 잠긴 값, after가 현재 값과
+    정확히 같을 때만 그 파일의 차이를 허용하고, 사유가 없거나 hash가 다르면 실패한다. 반환 digest는 항상 잠긴 목록의 digest이다."""
+    if not path or not os.path.exists(path):
+        raise RuntimeError(f"protocol file missing: {path!r}")
+    old = json.load(open(path))
+    lk = old["locked"]
+    if lk.get("schema") != SCHEMA:
+        raise RuntimeError(f"protocol schema {lk.get('schema')!r} != {SCHEMA}")
+    missing_req = [f for f in REQUIRED_CODE if f not in lk["files"]]
+    if missing_req:
+        raise RuntimeError(f"protocol does not lock required files: {missing_req}")
+    extra = [f for f in lk["files"] if f not in REQUIRED_CODE]
+    cur = current(extra)
+    allowed_edits = allowed_edits or {}
+    diff = {}
+    for k, v in cur["files"].items():
+        if lk["files"].get(k) == v:
+            continue
+        e = allowed_edits.get(k)
+        if e and e.get("reason") and e.get("before") == lk["files"].get(k) and e.get("after") == v:
+            continue
+        diff[k] = (lk["files"].get(k), v)
+    if diff or lk["generation_config_digest"] != cur["generation_config_digest"]:
+        raise RuntimeError("LOCK MISMATCH " + json.dumps(diff, indent=1)[:2000])
+    return lock_protocol.locked_digest(lk)
+
+
+def locked_file_sha(path, f):
+    return json.load(open(path))["locked"]["files"].get(f)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--extra", nargs="*", default=[])
+    ap.add_argument("--note", default="")
+    a = ap.parse_args()
+    print("locked", a.out, create(a.out, a.extra, a.note))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/rsna_diag/qa_requests.py b/rsna_diag/qa_requests.py
new file mode 100644
index 0000000..e27ef95
--- /dev/null
+++ b/rsna_diag/qa_requests.py
@@ -0,0 +1,249 @@
+"""iter_015/016 요청 행렬 (iter_016: OUT=run-root, SRC=읽기 전용 source-root). 요청 행(row)은 실제 prompt 원문과 evidence digest를 포함하고, request_id는 모델 revision·adapter digest·영상 identity·
+target·format·condition·실제 prompt·evidence·config digest·전처리 버전 전체의 hash다 (하나라도 바뀌면 id가 바뀐다).
+
+- 일반 요청 파일에는 category·정답이 없다. oracle 요청만 GT bbox를 prompt로 받으며 별도 stage(condition=ev_oracle)로 생성한다.
+- 사용:
+  python -m rsna_diag.qa_requests checkpoints                     # checkpoint table(adapter tensor digest) 생성
+  python -m rsna_diag.qa_requests build --stage S --kind qa|bbox|evidence --set D36 --ckpts M0,B0 --fmt plain [--exclude-set E180] [--conds ...]
+"""
+import argparse
+import glob
+import json
+import os
+
+from . import generate, parse as PA, prompts as P, qa_spec as S
+
+OUT = os.environ.get("QA_RUN_ROOT", "results/iter_017")   # 새 출력은 항상 이 run-root 아래에만 쓴다
+SRC = "results/iter_015"                                   # 과거(iter_015) 입력·결과는 읽기 전용 source-root
+CKPT_SPEC = {
+    "M0": None,
+    "B0": "results/iter_012/train/lr2e-4_s17/epoch_05",
+    "C": "results/iter_014/full/C_lr2e-05/epoch_03",
+    "B29": "results/iter_012/train/lr2e-4_s29/epoch_05",
+    "B43": "results/iter_012/train/lr2e-4_s43/epoch_05",
+}
+ID_FIELDS = ("model_revision", "adapter_digest", "id", "split", "file_sha256", "pixel_sha256", "target", "fmt", "condition",
+             "prompt_sha256", "evidence_digest", "config_digest", "preprocess")
+
+
+class RequestError(RuntimeError):
+    pass
+
+
+def compute_id(row):
+    return S.request_key({k: row.get(k) for k in ID_FIELDS})
+
+
+def make_row(item, ckpt, adapter_digest, target, fmt, condition, prompt, evidence_digest, cfg_digest, stage, extra=None):
+    row = {"id": item["id"], "split": item["split"], "image": item["image"], "file_sha256": item["file_sha256"],
+           "pixel_sha256": item["pixel_sha256"], "checkpoint": ckpt, "adapter_digest": adapter_digest, "target": target,
+           "fmt": fmt, "condition": condition, "prompt": prompt, "prompt_sha256": P.digest(prompt),
+           "evidence_digest": evidence_digest, "model_revision": generate.MODEL_REVISION, "config_digest": cfg_digest,
+           "preprocess": generate.PREPROC_VERSION, "stage": stage}
+    if extra:
+        row["extra"] = extra
+    row["request_id"] = compute_id(row)
+    return row
+
+
+def verify_row(row, cfg_digest):
+    """행 변조(prompt·evidence·adapter·영상 hash·config 등)를 감지한다."""
+    if row.get("prompt_sha256") != P.digest(row["prompt"]):
+        raise RequestError(f"prompt_sha256 != sha(prompt) for {row.get('request_id')}")
+    if row.get("config_digest") != cfg_digest:
+        raise RequestError(f"config_digest differs from protocol for {row.get('request_id')}")
+    if row.get("model_revision") != generate.MODEL_REVISION:
+        raise RequestError("model revision differs")
+    if row.get("request_id") != compute_id(row):
+        raise RequestError(f"request_id != recomputed for {row.get('request_id')}")
+    ev = row.get("evidence_digest")
+    if ev is not None and row["condition"] == "direct":
+        raise RequestError("direct request has evidence digest")
+    return True
+
+
+def load_rows(path, cfg_digest=None):
+    rows = [json.loads(ln) for ln in open(path) if ln.strip()]
+    ids = [r["request_id"] for r in rows]
+    if len(set(ids)) != len(ids):
+        raise RequestError(f"duplicate request_id in {path}")
+    if cfg_digest:
+        for r in rows:
+            verify_row(r, cfg_digest)
+    return rows
+
+
+def checkpoints(out=f"{OUT}/manifests/checkpoints.json"):
+    import torch
+    from . import eval_gate
+    tab = {}
+    for k, d in CKPT_SPEC.items():
+        if d is None:
+            tab[k] = {"dir": None, "digest": None}
+            continue
+        b = torch.load(os.path.join(d, "adapter.pt"), map_location="cpu", weights_only=True)
+        tab[k] = {"dir": d, "digest": eval_gate.adapter_digest(d), "epoch": b.get("epoch"), "step": b.get("step"),
+                  "train_digest": b.get("train_digest"), "lora": b["config"]}
+    tab["_note"] = {"C": "B0(seed17) 위의 추가 SFT single trajectory. 독립 seed가 아니다. V200 선택 기준 통과 최적 모델이 아니다."}
+    if os.path.exists(out):
+        old = json.load(open(out))
+        if old != tab:
+            raise RequestError("checkpoint table exists and differs")
+    json.dump(tab, open(out, "w"), indent=1)
+    return tab
+
+
+def patients(sets, name, exclude=None, per_cat=None):
+    ids = [i for c in S.CATEGORIES for i in (sets[name][c][:per_cat] if per_cat else sets[name][c])]
+    if exclude:
+        ex = {i for c in S.CATEGORIES for i in sets[exclude][c]}
+        ids = [i for i in ids if i not in ex]
+    return ids
+
+
+# bbox 원시 출력의 명시적 출처 목록. glob의 마지막 결과로 덮어쓰지 않는다. 같은 id가 두 출처에 있으면 오류.
+# ("reuse", jsonl 경로) | ("gen", 완료된 stage 디렉터리). 신규(iter_016) e600 C bbox는 run-root gen에 있으면 추가된다.
+def bbox_sources(ckpt):
+    src = {"M0": [("reuse", f"{SRC}/reuse/bbox_M0_concise.jsonl")],
+           "B0": [("reuse", f"{SRC}/reuse/bbox_B0_concise.jsonl"), ("gen", f"{SRC}/gen/d12_bbox__B0")],
+           "C": [("gen", f"{SRC}/gen/e180_bbox__C"), ("gen", f"{SRC}/gen/d12_bbox__C")]}[ckpt]
+    extra = f"{OUT}/gen/e600x_bbox__{ckpt}"
+    if ckpt == "C" and os.path.isdir(extra):
+        src.append(("gen", extra))
+    return src
+
+
+PINNED_SHA = {}   # iter_017: 검증된 reuse manifest의 {원본 파일 경로: sha256}. 비어 있지 않으면 reuse 출처는 여기에 있고 hash가 같아야 한다.
+
+
+def _file_sha(p):
+    import hashlib
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def bbox_records(ckpt, sources=None, pinned=None):
+    """ckpt의 concise bbox 원시 record {id: record}. 명시한 출처만 읽고, 출처 간 동일 id 충돌은 거부한다.
+    iter_017: pinned(기본 PINNED_SHA)가 있으면 reuse 출처의 현재 sha256이 pin과 다를 때, pin에 없을 때 거부한다.
+    gen 출처는 completion.json의 내용(누락·중복·잉여 0, 자식 종료 코드 0)도 확인한다."""
+    pinned = PINNED_SHA if pinned is None else pinned
+    out, origin = {}, {}
+    for kind, p in (sources or bbox_sources(ckpt)):
+        if kind == "reuse":
+            if pinned:
+                if p not in pinned:
+                    raise RequestError(f"bbox source {p} is not pinned in the verified reuse manifest")
+                if _file_sha(p) != pinned[p]:
+                    raise RequestError(f"bbox source {p} changed since verification")
+            recs = [json.loads(ln) for ln in open(p) if ln.strip()]
+        else:
+            if not os.path.exists(f"{p}/completion.json"):
+                raise RequestError(f"bbox source {p} has no completion.json (incomplete stage)")
+            c = json.load(open(f"{p}/completion.json"))
+            if (c.get("n_missing") != 0 or c.get("n_duplicate") != 0 or c.get("n_extra") != 0 or c.get("n_expected") != c.get("n_actual_unique")
+                    or not c.get("returncodes") or any(x != 0 for x in c["returncodes"])):
+                raise RequestError(f"bbox source {p}: completion content invalid")
+            recs = [r for f in sorted(glob.glob(f"{p}/gen_worker*.jsonl")) for r in generate.read_records(f)
+                    if r.get("condition") == "bbox" and r.get("checkpoint") == ckpt]
+        seen = set()
+        for r in recs:
+            if r["id"] in seen:
+                raise RequestError(f"duplicate bbox record for {r['id']} inside source {p}")
+            seen.add(r["id"])
+            if r["id"] in out:
+                raise RequestError(f"bbox record for {r['id']} present in both {origin[r['id']]} and {p}")
+            out[r["id"]] = r
+            origin[r["id"]] = p
+    return out
+
+
+def predicted_boxes(rec):
+    """returns (boxes or None, status). 유효 출력만 boxes를 가진다 (빈 목록은 []). 형식 실패·잘림·누락은 None."""
+    if rec is None:
+        return None, "missing"
+    pr = PA.parse_response(rec["suffix_text_raw"], rec["ended_eos"])
+    if pr["status"] in PA.VALID:
+        return [[int(round(v)) for v in b] for b in pr["boxes"]], pr["status"]
+    return None, pr["status"]
+
+
+def build(a):
+    sets = json.load(open(f"{OUT}/manifests/sets.json"))
+    man = {}
+    for ln in open(f"{OUT}/manifests/infer_manifest.jsonl"):
+        r = json.loads(ln)
+        man[r["id"]] = r
+    labels = json.load(open(f"{OUT}/manifests/labels.json")) if a.kind == "evidence" and "oracle" in a.conds.split(",") else None
+    tab = json.load(open(f"{OUT}/manifests/checkpoints.json"))
+    from . import qa_protocol
+    cfg, _ = qa_protocol.static_cfg()
+    ids = a.ids.split(',') if a.ids else patients(sets, a.set, a.exclude_set, a.per_cat)
+    os.makedirs(f"{OUT}/requests", exist_ok=True)
+    counts = {}
+    ckpts = a.ckpts.split(",")
+    per = {c: [] for c in ckpts}
+    for c in ckpts:
+        ad = tab[c]["digest"]
+        if a.kind == "qa":
+            for i in ids:
+                for t in S.TARGETS:
+                    per[c].append(make_row(man[i], c, ad, t, a.fmt, "direct", S.qa_prompt(t, a.fmt), None, cfg, a.stage))
+        elif a.kind == "bbox":
+            for i in ids:
+                per[c].append(make_row(man[i], c, ad, "bbox", "concise", "bbox", P.CONCISE, None, cfg, a.stage))
+        else:  # evidence: reader는 base(M0)
+            src = bbox_records(a.evidence_source)
+            for i in ids:
+                for cond in a.conds.split(","):
+                    if cond == "oracle":
+                        boxes = [b["yxyx_norm"] for b in labels[i]["boxes"]]
+                        txt, meta = S.evidence_text("oracle", boxes), {"source": "gt"}
+                    elif cond == "unavailable":
+                        txt, meta = S.evidence_text("unavailable"), {"source": None}
+                    else:
+                        if i not in src:
+                            raise RequestError(f"no {a.evidence_source} bbox record for {i}")
+                        boxes, st = predicted_boxes(src[i])
+                        txt = S.evidence_text("predicted", boxes)
+                        meta = {"source": a.evidence_source, "source_request_id": src[i].get("request_id"), "source_status": st}
+                    for t in S.TARGETS:
+                        per[c].append(make_row(man[i], c, ad, t, a.fmt, f"ev_{cond}", S.qa_prompt(t, a.fmt, txt), S.sha(txt), cfg,
+                                               a.stage, extra=meta))
+    for c, rows in per.items():
+        p = f"{OUT}/requests/{a.stage}__{c}.jsonl"
+        if os.path.exists(p):
+            raise RequestError(f"{p} exists (not overwriting)")
+        with open(p, "w") as f:
+            for r in rows:
+                f.write(json.dumps(r) + "\n")
+        counts[c] = len(rows)
+    print(json.dumps({"stage": a.stage, "n_patients": len(ids), "rows": counts}))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    sp.add_parser("checkpoints")
+    b = sp.add_parser("build")
+    b.add_argument("--stage", required=True)
+    b.add_argument("--kind", required=True, choices=["qa", "bbox", "evidence"])
+    b.add_argument("--set", default=None)
+    b.add_argument("--per-cat", type=int, default=None, help="각 category의 앞 N명 (표본은 category별로 먼저 고정한 뒤 요청을 구성한다)")
+    b.add_argument("--ids", default=None, help="stress 등 명시적 id 목록(쉼표)")
+    b.add_argument("--exclude-set", default=None)
+    b.add_argument("--ckpts", required=True)
+    b.add_argument("--fmt", default="plain")
+    b.add_argument("--conds", default="predicted,unavailable,oracle")
+    b.add_argument("--evidence-source", default="B0")
+    a = ap.parse_args()
+    if a.cmd == "checkpoints":
+        print(json.dumps({k: v.get("digest") for k, v in checkpoints().items() if k != "_note"}))
+    else:
+        build(a)
+
+
+if __name__ == "__main__":
+    main()
