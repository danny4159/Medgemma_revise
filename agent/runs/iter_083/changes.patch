+
+def batch_token_digest(b):
+    h = hashlib.sha256()
+    for k in ("input_ids", "attention_mask", "labels", "token_type_ids"):
+        if k in b:
+            h.update(k.encode())
+            h.update(str(tuple(b[k].shape)).encode())
+            h.update(b[k].contiguous().numpy().tobytes())
+    return h
+
