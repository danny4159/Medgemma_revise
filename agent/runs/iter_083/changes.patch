+++ b/rsna_diag/select.py
@@ -0,0 +1,185 @@
+"""validation 규칙에 따른 학습 확장·learning rate·checkpoint 선택 (iter_010 사전 고정 규칙, iter_011 gate 추가).
+
+- 확장 규칙: epoch 5에서, 어느 한 learning rate라도 (utility(5) - utility(4) >= 0.01) and (val_loss(5) <= 0.99 * val_loss(4))이면
+  두 learning rate 모두 epoch 8까지 연장한다 ('마지막 두 epoch' = epoch 4 -> 5 변화로 고정 해석).
+- checkpoint: run별 epoch 중 utility 최대, 동률은 양성 F1@0.5, 그 다음 이른 epoch. learning rate: seed 17 run의 선택 utility 최대
+  (동률 F1@0.5, 그 다음 작은 lr).
+- iter_011: 예정된 epoch 1..E 전체의 val_metrics가 있고, 각 epoch의 원시 validation 요청 집합(400 ID x concise)·adapter digest·
+  protocol·입력 digest·train_digest가 실제 파일과 일치할 때만 선택/확장 판정을 한다 (하나라도 어긋나면 예외, 출력 파일 없음).
+사용: python -m rsna_diag.select extend|pick --runs DIR [DIR ...] --epochs E --protocol P --out FILE
+"""
+import argparse
+import glob
+import hashlib
+import json
+import os
+
+from . import eval_gate, inputs, lock_protocol, sft_eval
+
+MANIFEST = "results/iter_010/manifests/infer_manifest.jsonl"
+GT = "results/iter_010/manifests/gt_manifest.json"
+VAL_IDS = "results/iter_010/manifests/validation_ids.json"
+
+
+def verify_epoch(run_dir, e, tc, v_in, protocol, val_items, gt):
+    """한 epoch의 val_metrics가 이 run·입력·adapter·원시 validation 요청 집합·protocol과 연결되는지 검증하고,
+    생성 기반 점수(utility·F1 등 summarize 결과 전체)를 원시 응답에서 다시 계산해 기록값과 같은지 확인한다. returns metrics."""
+    ed = os.path.join(run_dir, f"epoch_{e:02d}")
+    vm = os.path.join(ed, "val_metrics.json")
+    if not os.path.exists(vm):
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} val_metrics missing")
+    m = json.load(open(vm))
+    if m.get("epoch") != e or m.get("train_digest") != tc["train_digest"] or m.get("val_inputs_digest") != v_in:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} metrics not linked to this run/inputs")
+    if m.get("seed") != tc["config"]["seed"] or m.get("lr") != tc["config"]["lr"]:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} seed/lr mismatch")
+    if m.get("protocol_digest") != lock_protocol.verify(protocol):
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} metrics protocol digest differs from current protocol")
+    adg = eval_gate.adapter_digest(ed)
+    if m["adapter_digest"] != adg:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} adapter digest differs from metrics")
+    done = eval_gate.verify_gen(os.path.join(ed, "val_gen"), val_items, ["concise"], ed, protocol)
+    c = json.load(open(os.path.join(ed, "val_gen", "completion.json")))
+    if c.get("val_inputs_digest") != v_in:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} completion input digest differs")
+    ids = [i["id"] for i in val_items]
+    edges = sft_eval.area_edges(gt, [i for i in gt if gt[i]["split"] == "train"])
+    rec = json.loads(json.dumps(sft_eval.summarize(sft_eval.parse_records(done, ids, "concise", strict=True), gt, ids, edges)))
+    bad = [k for k in rec if m.get(k) != rec[k]]
+    if bad:
+        raise eval_gate.GateError(f"{run_dir}: epoch {e} recorded scores differ from recomputation from raw responses: {bad[:5]}")
+    return m
+
+
+def load_epochs(run_dir, expected_epochs, protocol, val_items=None, gt=None):
+    """epoch 1..expected_epochs 전체를 검증해 {epoch: metrics}를 반환한다. 누락·불일치는 GateError."""
+    if not expected_epochs or expected_epochs < 1:
+        raise eval_gate.GateError("expected_epochs required")
+    tc = json.load(open(os.path.join(run_dir, "train_config.json")))
+    if val_items is None:
+        val_items, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    v_in = inputs.inputs_digest(val_items, gt)
+    if tc["config"].get("val_inputs_digest") != v_in:
+        raise eval_gate.GateError(f"{run_dir}: run was not trained/validated on the current validation inputs")
+    if tc["config"].get("deterministic"):
+        raise eval_gate.GateError(f"{run_dir}: deterministic check run cannot be used for selection")
+    out = {}
+    for e in range(1, expected_epochs + 1):
+        if not os.path.exists(os.path.join(run_dir, f"epoch_{e:02d}", "val_metrics.json")):
+            raise eval_gate.GateError(f"{run_dir}: epoch {e} val_metrics missing (planned epochs 1..{expected_epochs})")
+        out[e] = verify_epoch(run_dir, e, tc, v_in, protocol, val_items, gt)
+    return out
+
+
+def file_sha(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def evidence(run_dir, expected_epochs):
+    """선택 근거 파일의 내용 hash (val_metrics·completion·원시 요청 파일·adapter). load_epochs 통과 뒤에만 부른다."""
+    ev = {"train_config_sha256": file_sha(os.path.join(run_dir, "train_config.json")), "epochs": {}}
+    for e in range(1, expected_epochs + 1):
+        ed = os.path.join(run_dir, f"epoch_{e:02d}")
+        ev["epochs"][str(e)] = {"val_metrics_sha256": file_sha(os.path.join(ed, "val_metrics.json")),
+                                "completion_sha256": file_sha(os.path.join(ed, "val_gen", "completion.json")),
+                                "gen_files_sha256": {os.path.basename(f): file_sha(f) for f in sorted(glob.glob(os.path.join(ed, "val_gen", "gen_worker*.jsonl")))},
+                                "adapter_file_sha256": file_sha(os.path.join(ed, "adapter.pt"))}
+    return ev
+
+
+def should_extend(run_dirs, protocol, expected=5):
+    rep, ext = {}, False
+    vi, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    for d in run_dirs:
+        e = load_epochs(d, expected, protocol, vi, gt)
+        du = e[5]["utility"] - e[4]["utility"]
+        rl = e[5]["val_loss"] / e[4]["val_loss"]
+        hit = du >= 0.01 and rl <= 0.99
+        rep[d] = {"utility_4": e[4]["utility"], "utility_5": e[5]["utility"], "delta_utility": du, "val_loss_ratio_5_over_4": rl, "meets_rule": hit}
+        ext = ext or hit
+    return ext, rep
+
+
+def best_epoch(epochs):
+    best = max(epochs.values(), key=lambda m: (round(m["utility"], 12), round(m["f1@0.5"], 12), -m["epoch"]))
+    return best["epoch"], {k: {"utility": m["utility"], "f1@0.3": m["f1@0.3"], "f1@0.5": m["f1@0.5"], "val_loss": m["val_loss"]}
+                           for k, m in sorted(epochs.items())}
+
+
+def pick(run_dirs, protocol, expected):
+    res = {}
+    vi, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    for d in run_dirs:
+        ep_metrics = load_epochs(d, expected, protocol, vi, gt)
+        ep, table = best_epoch(ep_metrics)
+        cfg = json.load(open(os.path.join(d, "train_config.json")))["config"]
+        res[d] = {"best_epoch": ep, "lr": cfg["lr"], "seed": cfg["seed"], "n_epochs_validated": expected, "table": table,
+                  "utility": table[ep]["utility"], "f1@0.5": table[ep]["f1@0.5"],
+                  "adapter_dir": os.path.join(d, f"epoch_{ep:02d}"), "adapter_digest": ep_metrics[ep]["adapter_digest"]}
+    best = max(res, key=lambda d: (round(res[d]["utility"], 12), round(res[d]["f1@0.5"], 12), -res[d]["lr"]))
+    return res, best
+
+
+RULES = {"extend": "iter010 fixed: any LR with utility(5)-utility(4)>=0.01 and val_loss(5)<=0.99*val_loss(4) -> both LRs to 8 epochs",
+         "pick": "iter010 fixed: epoch max utility, tie F1@0.5, then earlier epoch; run max utility, tie F1@0.5, then smaller lr"}
+
+
+def payload(mode, runs, protocol, epochs):
+    """선택 결정 + provenance (protocol 내용 digest, 규칙, 예정 epoch, seed/lr, 입력 digest, 근거 파일 hash). 항상 원시 근거에서 재계산한다."""
+    if len(set(runs)) != len(runs):
+        raise eval_gate.GateError("duplicate --runs")
+    if mode == "extend" and epochs != 5:
+        raise eval_gate.GateError("extend decision is defined at epoch 5 only")
+    pdig = lock_protocol.verify(protocol)
+    vi, gt = inputs.load_items(MANIFEST, GT, VAL_IDS, "validation")
+    base = {"mode": mode, "rule": RULES[mode], "protocol_path": protocol, "protocol_digest": pdig, "planned_epochs": epochs,
+            "runs_in": list(runs), "val_inputs_digest": inputs.inputs_digest(vi, gt)}
+    if mode == "extend":
+        ext, rep = should_extend(runs, protocol, 5)
+        base.update({"extend": ext, "detail": rep})
+    else:
+        res, best = pick(runs, protocol, epochs)
+        base.update({"runs": res, "selected_run": best})
+    base["evidence"] = {d: evidence(d, epochs) for d in runs}
+    return base
+
+
+def write_or_verify(path, pl):
+    """없으면 원자적으로 쓰고, 있으면 재계산 결과와 완전히 같아야 한다 (오래되거나 바뀐 선택 파일은 조용히 믿지 않는다)."""
+    if os.path.exists(path):
+        old = json.load(open(path))
+        if old != json.loads(json.dumps(pl)):
+            raise eval_gate.GateError(f"{path}: existing selection differs from recomputation from current evidence")
+        return "verified_existing"
+    tmp = path + ".tmp"
+    json.dump(pl, open(tmp, "w"), indent=1)
+    os.replace(tmp, path)
+    return "written"
+
+
+def verify_file(path, mode, protocol):
+    """선택 파일을 그 파일에 적힌 runs·예정 epoch로 다시 계산해 동일한지 검증한다 (final_eval이 사용). returns 파일 내용."""
+    old = json.load(open(path))
+    if old.get("mode") != mode:
+        raise eval_gate.GateError(f"{path}: not a {mode} selection")
+    pl = payload(mode, old["runs_in"], protocol, old["planned_epochs"])
+    if old != json.loads(json.dumps(pl)):
+        raise eval_gate.GateError(f"{path}: selection no longer matches recomputation from current evidence")
+    return old
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("mode", choices=["extend", "pick"])
+    ap.add_argument("--runs", nargs="+", required=True)
+    ap.add_argument("--epochs", type=int, required=True, help="예정 epoch 수 (extend는 5 고정)")
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    pl = payload(a.mode, a.runs, a.protocol, a.epochs)
+    st = write_or_verify(a.out, pl)
+    print(a.mode, st, pl.get("extend", pl.get("selected_run")))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/sft_data.py b/rsna_diag/sft_data.py
new file mode 100644
index 0000000..5229bad
--- /dev/null
+++ b/rsna_diag/sft_data.py
@@ -0,0 +1,81 @@
+"""직접 병변 SFT 학습 입력 (iter_010): target 문자열, 생성용/학습용 prefix 대조, assistant-only labels, collator.
+
+- 학습 prompt는 생성 평가와 같은 concise prompt, 같은 영상 전처리(generate.load_image), 같은 chat template이다.
+- target = 모든 GT box의 JSON 목록(중심 x, 중심 y, 좌표 순 결정적 정렬) 또는 "[]".
+- labels: assistant 본문 + <end_of_turn> 만 학습 (system/user/image/padding/후행 개행은 -100).
+"""
+import json
+
+from . import generate
+
+TARGET_LABEL = "pulmonary opacity"
+
+
+def round_half_up(v):
+    return int(v + 0.5)
+
+
+def target_boxes(boxes_yxyx):
+    """GT 정규화 box -> 정수 좌표, 결정적 순서. 반올림 뒤 유효하지 않으면 예외 (조용히 고치지 않는다)."""
+    out = []
+    for b in boxes_yxyx:
+        y0, x0, y1, x1 = [round_half_up(v) for v in b]
+        if not (0 <= y0 < y1 <= 1000 and 0 <= x0 < x1 <= 1000):
+            raise ValueError(f"box invalid after integer rounding: {b} -> {[y0, x0, y1, x1]}")
+        out.append([y0, x0, y1, x1])
+    return sorted(out, key=lambda b: ((b[1] + b[3]) / 2, (b[0] + b[2]) / 2, b[0], b[1], b[2], b[3]))
+
+
+def target_text(boxes_yxyx):
+    bs = target_boxes(boxes_yxyx)
+    return json.dumps([{"box_2d": b, "label": TARGET_LABEL} for b in bs])
+
+
+def build_example(proc, image, prompt, target):
+    """returns dict(input_ids, attention_mask, token_type_ids?, pixel_values, labels) 1-D/텐서 (batch 차원 없음, pixel_values는 (n,3,H,W))."""
+    import torch
+    gen = generate.build_inputs(proc, image, prompt)
+    msgs = [{"role": "user", "content": [{"type": "image", "image": image}, {"type": "text", "text": prompt}]},
+            {"role": "assistant", "content": [{"type": "text", "text": target}]}]
+    full = proc.apply_chat_template(msgs, add_generation_prompt=False, tokenize=True, return_dict=True, return_tensors="pt")
+    gi, fi = gen["input_ids"][0], full["input_ids"][0]
+    n = gi.shape[0]
+    if fi.shape[0] <= n or not torch.equal(fi[:n], gi):
+        raise ValueError("generation prefix != training prefix (token mismatch)")
+    tail = proc.tokenizer.decode(fi[n:].tolist(), skip_special_tokens=False)
+    if tail != target + "<end_of_turn>\n":
+        raise ValueError(f"unexpected assistant tail {tail!r}")
+    if not torch.equal(gen["pixel_values"], full["pixel_values"]):
+        raise ValueError("pixel_values differ between generation and training inputs")
+    labels = fi.clone()
+    labels[:n] = -100
+    labels[-1] = -100  # 후행 "\n"
+    if int((labels != -100).sum()) < 2:
+        raise ValueError("no assistant tokens to learn")
+    ex = {"input_ids": fi, "attention_mask": full["attention_mask"][0], "pixel_values": full["pixel_values"], "labels": labels,
+          "n_prefix": n}
+    if "token_type_ids" in full:
+        ex["token_type_ids"] = full["token_type_ids"][0]
+    return ex
+
+
+def collate(examples, pad_id):
+    import torch
+    L = max(e["input_ids"].shape[0] for e in examples)
+    B = len(examples)
+    ids = torch.full((B, L), pad_id, dtype=torch.long)
+    att = torch.zeros((B, L), dtype=torch.long)
+    lab = torch.full((B, L), -100, dtype=torch.long)
+    has_tt = "token_type_ids" in examples[0]
+    tt = torch.zeros((B, L), dtype=torch.long) if has_tt else None
+    for i, e in enumerate(examples):
+        n = e["input_ids"].shape[0]  # right padding
+        ids[i, :n], att[i, :n], lab[i, :n] = e["input_ids"], e["attention_mask"], e["labels"]
+        if has_tt:
+            tt[i, :n] = e["token_type_ids"]
+    out = {"input_ids": ids, "attention_mask": att, "labels": lab, "pixel_values": torch.cat([e["pixel_values"] for e in examples], 0)}
+    if has_tt:
+        out["token_type_ids"] = tt
+    if "sample_pos" in examples[0]:  # iter_012: 학습 loop가 실제 batch ID를 대조한다 (모델 입력에는 넣지 않음)
+        out["sample_pos"] = torch.tensor([e["sample_pos"] for e in examples], dtype=torch.long)
+    return out
diff --git a/rsna_diag/sft_eval.py b/rsna_diag/sft_eval.py
new file mode 100644
index 0000000..1241885
--- /dev/null
+++ b/rsna_diag/sft_eval.py
@@ -0,0 +1,103 @@
+"""iter_010 환자별 평가: 생성 record(또는 보정/prior 예측)를 같은 metric으로 요약한다.
+
+preds: {id: {"status": str, "boxes": [[y0,x0,y1,x1],...]}} — 형식 실패·잘림은 valid가 아니며 end-to-end에서 box 없음(F1=0)으로 계산한다.
+GT 좌표 규약·matching·metric은 iter_009 승인 모듈(metrics.py, parse.py)을 그대로 쓴다.
+"""
+import numpy as np
+
+from . import metrics as M, parse as PA
+
+NEG = (("normal", "Normal"), ("not_normal_no_opacity", "NoOpacity/NotNormal"))
+
+
+def parse_records(recs, ids, prompt, strict=True):
+    """recs: {(id, prompt): record}. strict(기본): 누락 요청은 예외 (미완료 실행을 점수화하지 않는다). strict=False는 진단 전용 status='missing'."""
+    out = {}
+    if strict:
+        miss = [i for i in ids if (i, prompt) not in recs]
+        if miss:
+            raise ValueError(f"{len(miss)} requested (id, {prompt}) records missing, e.g. {miss[:3]}")
+    for i in ids:
+        r = recs.get((i, prompt))
+        out[i] = ({"status": "missing", "boxes": []} if r is None
+                  else PA.parse_response(r["suffix_text_raw"], r["ended_eos"]))
+    return out
+
+
+def gt_boxes(g):
+    return [b["yxyx_norm"] for b in g["boxes"]]
+
+
+def gt_area_frac(g):
+    return M.union_area(gt_boxes(g)) / 1e6
+
+
+def area_edges(gt, train_ids):
+    """train 양성 GT 면적의 삼분위 경계 (2개 값)."""
+    a = np.array([gt_area_frac(gt[i]) for i in train_ids if gt[i]["category"] == "opacity"])
+    return [float(np.quantile(a, 1 / 3)), float(np.quantile(a, 2 / 3))]
+
+
+def per_patient(preds, gt, ids):
+    """양성 환자별 end-to-end 값. returns dict of arrays over positives (ids 순서)."""
+    pos = [i for i in ids if gt[i]["category"] == "opacity"]
+    cols = {"f1@0.3": [], "f1@0.5": [], "p@0.3": [], "r@0.3": [], "union_iou": []}
+    for i in pos:
+        pr = preds[i]
+        pb = pr["boxes"] if pr["status"] in PA.VALID else []
+        g = gt_boxes(gt[i])
+        m3, m5 = M.patient_metrics(pb, g, 0.3), M.patient_metrics(pb, g, 0.5)
+        cols["f1@0.3"].append(m3["f1"]); cols["f1@0.5"].append(m5["f1"])
+        cols["p@0.3"].append(m3["precision"]); cols["r@0.3"].append(m3["recall"])
+        cols["union_iou"].append(M.union_iou(pb, g))
+    return pos, {k: np.array(v) for k, v in cols.items()}
+
+
+def rate(k, n):
+    lo, hi = M.wilson(k, n)
+    return {"k": int(k), "n": int(n), "rate": (k / n if n else None), "wilson95": [lo, hi]}
+
+
+def summarize(preds, gt, ids, edges=None):
+    pos, pp = per_patient(preds, gt, ids)
+    st = lambda i: preds[i]["status"]
+    valid = lambda i: st(i) in PA.VALID
+    d = {"n_patients": len(ids), "n_positive": len(pos),
+         "f1@0.3": float(pp["f1@0.3"].mean()) if len(pos) else None, "f1@0.5": float(pp["f1@0.5"].mean()) if len(pos) else None,
+         "precision@0.3": float(pp["p@0.3"].mean()) if len(pos) else None, "recall@0.3": float(pp["r@0.3"].mean()) if len(pos) else None,
+         "union_iou": float(pp["union_iou"].mean()) if len(pos) else None,
+         "valid_rate_all": rate(sum(valid(i) for i in ids), len(ids)),
+         "valid_rate_positive": rate(sum(valid(i) for i in pos), len(pos)),
+         "positive_valid_empty": rate(sum(st(i) == "valid_empty" for i in pos), len(pos)),
+         "status_all": {s: sum(st(i) == s for i in ids) for s in sorted({st(i) for i in ids})},
+         "truncated_all": sum(st(i) == "truncated" for i in ids)}
+    vi = [k for k, i in enumerate(pos) if valid(i)]
+    d["f1@0.3_valid_only"] = {"mean": float(pp["f1@0.3"][vi].mean()) if vi else None, "n": len(vi)}
+    for cat, nm in NEG:
+        neg = [i for i in ids if gt[i]["category"] == cat]
+        d[f"neg_{nm}"] = {"valid_empty": rate(sum(st(i) == "valid_empty" for i in neg), len(neg)),
+                          "extra_box": rate(sum(st(i) == "valid_nonempty" for i in neg), len(neg)),
+                          "format_fail": rate(sum(not valid(i) for i in neg), len(neg))}
+    n_gt = np.array([len(gt[i]["boxes"]) for i in pos])
+    if len(pos):
+        d["by_n_gt"] = {"single": {"n": int((n_gt == 1).sum()), "f1@0.3": float(pp["f1@0.3"][n_gt == 1].mean()) if (n_gt == 1).any() else None},
+                        "multi": {"n": int((n_gt > 1).sum()), "f1@0.3": float(pp["f1@0.3"][n_gt > 1].mean()) if (n_gt > 1).any() else None}}
+        if edges:
+            ar = np.array([gt_area_frac(gt[i]) for i in pos])
+            bins = np.digitize(ar, edges)
+            d["by_gt_area_tertile"] = {name: {"n": int((bins == b).sum()), "f1@0.3": float(pp["f1@0.3"][bins == b].mean()) if (bins == b).any() else None}
+                                       for b, name in enumerate(("small", "medium", "large"))}
+    npred = [len(preds[i]["boxes"]) for i in pos if st(i) == "valid_nonempty"]
+    d["n_pred_dist_positive_nonempty"] = {str(k): int(v) for k, v in zip(*np.unique(npred, return_counts=True))} if npred else {}
+    d["mean_n_pred_vs_n_gt_positive_valid"] = ([float(np.mean([len(preds[i]["boxes"]) for i in pos if valid(i)])),
+                                                float(np.mean([len(gt[i]["boxes"]) for i in pos if valid(i)]))] if vi else None)
+    d["utility"] = utility(d)
+    return d
+
+
+def utility(d):
+    """0.5*양성 평균 F1@0.3 + 0.25*Normal valid_empty율 + 0.25*NoOpacity/NotNormal valid_empty율 (계획 고정식)."""
+    n1, n2 = d["neg_Normal"]["valid_empty"], d["neg_NoOpacity/NotNormal"]["valid_empty"]
+    if d["f1@0.3"] is None or n1["rate"] is None or n2["rate"] is None:
+        return None
+    return 0.5 * d["f1@0.3"] + 0.25 * n1["rate"] + 0.25 * n2["rate"]
