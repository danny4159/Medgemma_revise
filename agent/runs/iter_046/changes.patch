+def d_throughput(a):
+    import torch
+    dev = torch.device("cuda:0")
+    items = T.load_t305()
+    ts = T.TrainSet(items[:64])
+    res = {"mb": {}, "visible": os.environ.get("CUDA_VISIBLE_DEVICES"), "autocast_bf16": not a.fp32}
+    for mb in [int(x) for x in a.microbatches.split(",")]:
