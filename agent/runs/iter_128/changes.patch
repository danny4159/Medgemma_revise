+
+def sha(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(4 << 20), b''): h.update(b)
+    return h.hexdigest()
+
+
+def read(p):
+    def pairs(items):
