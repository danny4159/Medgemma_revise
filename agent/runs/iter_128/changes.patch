+                tmp = directory/(name+'.'+uuid.uuid4().hex+'.part')
+                with z.open(info) as s, tmp.open('xb') as f: shutil.copyfileobj(s, f); f.flush(); os.fsync(f.fileno())
+                if tmp.stat().st_size != info.file_size: raise ValueError('size mismatch')
+                h = sha(tmp)
