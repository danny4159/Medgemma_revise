index 0000000..8041a9f
--- /dev/null
+++ b/mr123_cost.py
@@ -0,0 +1,34 @@
+"""iter_123: 전처리 비용(NIfTI 읽기→slice 렌더링, 저장 제외) 측정 + 생성 비용 요약. 결과: results/iter_123/eval/cost.json"""
+import glob, json, os, time
+import numpy as np
+import mr123_data as D
+import mr123_run as R
+
+b = {}
+for p in ['build_tech.json', 'build_explore.json']:
+    b.update(json.load(open(D.RES + 'data/' + p)))
+rows = []
+for sid, info in b.items():
+    if info.get('exclude') is not None:
+        continue
+    t0 = time.perf_counter()
+    a, m, li = D.load_case(info['files']['img.nii.gz']['path'], info['files']['brain.nii.gz']['path'])
+    lo, hi = D.brain_range(m)
+    lv, hv = D.intensity_window(a, m)
+    t1 = time.perf_counter()
+    ks = sorted(set(info['W_idx']) | set(info['C_idx']))
+    for k in ks:
+        D.render_slice(a, k, lv, hv, li['canon_zooms'])
+    t2 = time.perf_counter()
+    rows.append(dict(study=sid, role=info['role'], read_s=t1 - t0, render_s=t2 - t1, n_slices_rendered=len(ks)))
+rs = [r for r in rows if r['role'] == 'explore']
+gen = {}
+for st in ['explore']:
+    recs = [r for fn in glob.glob(R.GEN + st + '/worker_*.jsonl') for r in R.read_jsonl(fn)]
+    gen = dict(n=len(recs), sum_prep_s=sum(r['prep_s'] for r in recs), sum_gen_s=sum(r['gen_s'] for r in recs), model_load_s=sorted({round(r['load_s'], 1) for r in recs}),
+               peak_mem_mib=max(r['peak_mem_mib'] for r in recs))
+out = dict(preprocess_explore=dict(n=len(rs), mean_read_s=float(np.mean([r['read_s'] for r in rs])), mean_render_s=float(np.mean([r['render_s'] for r in rs]))),
+           note='원 NIfTI 압축 해제 후 읽기→C/W 공통 slice 렌더링(저장 제외). ZIP 추출·PNG 저장·model load는 별도. 한 환자에서 C·W·P는 동일 PNG 재사용.',
+           generation=gen, per_case=rows)
+json.dump(out, open(D.RES + 'eval/cost.json', 'w'), indent=1)
+print(json.dumps({k: v for k, v in out.items() if k != 'per_case'}, indent=1))
diff --git a/mr123_data.py b/mr123_data.py
new file mode 100644
index 0000000..29a5466
--- /dev/null
+++ b/mr123_data.py
@@ -0,0 +1,169 @@
+"""iter_123: study ZIP 안전 추출, FLAIR/brain-mask 검사, 뇌 범위 기반 slice 선택·렌더링 (규칙 mr123_rules_v1)."""
+import hashlib, json, os, zipfile
+import numpy as np
+import nibabel as nib
+from PIL import Image
+
+ROOT = '/home/test/.local/share/medgemma/mr_rate/'
+RES = '/SSD1_1TB/home/milab/daniel/08_medgemma/research/results/iter_123/'
+SIDE = 896
+AREA_FRAC = 0.05  # 뇌 범위: slice별 brain-mask 면적이 최대 면적의 5% 이상인 연속 구간 (사전 고정)
+N_SLICE = 8
+
+
+def sha_file(p):
+    d = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(1 << 22), b''):
+            d.update(b)
+    return d.hexdigest()
+
+
+def extract(zip_path, study, series_id, out_root=ROOT + 'extracted/'):
+    """flair 영상과 brain-mask만 안전 추출. 경로 이탈·symlink 거부, 기존 파일 덮어쓰기 금지."""
+    out = os.path.join(out_root, study)
+    os.makedirs(out, exist_ok=True)
+    want = {f'{study}/img/{study}_{series_id}.nii.gz': 'img.nii.gz',
+            f'{study}/seg/{study}_{series_id}_brain-mask.nii.gz': 'brain.nii.gz'}
+    z = zipfile.ZipFile(zip_path)
+    res = {}
+    for info in z.infolist():
+        if info.filename in want:
+            assert '..' not in info.filename and not info.filename.startswith('/')
+            assert (info.external_attr >> 16) & 0o170000 != 0o120000, 'symlink'
+            dst = os.path.join(out, want[info.filename])
+            if not os.path.exists(dst):
+                with z.open(info) as s, open(dst + '.part', 'wb') as d:
+                    while True:
+                        b = s.read(1 << 22)
+                        if not b:
+                            break
+                        d.write(b)
+                os.replace(dst + '.part', dst)
+            res[want[info.filename]] = dict(path=dst, sha256=sha_file(dst), size=os.path.getsize(dst), zip_member=info.filename)
+    missing = set(want.values()) - set(res)
+    return res, sorted(missing)
+
+
+def load_case(img_path, brain_path):
+    im = nib.load(img_path)
+    bm = nib.load(brain_path)
+    info = dict(orig_axcodes=''.join(nib.aff2axcodes(im.affine)), shape=list(im.shape), zooms=[float(z) for z in im.header.get_zooms()[:3]],
+                brain_shape=list(bm.shape), brain_axcodes=''.join(nib.aff2axcodes(bm.affine)),
+                affine_match=bool(np.allclose(im.affine, bm.affine, atol=1e-3)), ndim=len(im.shape))
+    if len(im.shape) != 3 or tuple(im.shape) != tuple(bm.shape):
+        return None, None, info
+    im = nib.as_closest_canonical(im)
+    bm = nib.as_closest_canonical(bm)
+    a = np.asarray(im.dataobj).astype(np.float32)
+    b = np.asarray(bm.dataobj) > 0
+    info['canon_axcodes'] = ''.join(nib.aff2axcodes(im.affine))
+    info['canon_shape'] = list(a.shape)
+    info['canon_zooms'] = [float(z) for z in im.header.get_zooms()[:3]]
+    return a, b, info
+
+
+def brain_range(b):
+    area = b.sum(axis=(0, 1)).astype(np.float64)
+    if area.max() <= 0:
+        return None
+    ok = area >= AREA_FRAC * area.max()
+    best, s = None, None
+    for i, v in enumerate(list(ok) + [False]):
+        if v and s is None:
+            s = i
+        if not v and s is not None:
+            if best is None or (i - 1 - s) > (best[1] - best[0]):
+                best = (s, i - 1)
+            s = None
+    return best
+
+
+def pick(lo, hi, f0, f1, n=N_SLICE):
+    L = hi - lo
+    pos = [lo + L * (f0 + (f1 - f0) * i / (n - 1)) for i in range(n)]
+    idx = [int(round(p)) for p in pos]
+    return idx
+
+
+def intensity_window(a, b):
+    v = a[b]
+    return float(np.percentile(v, 1)), float(np.percentile(v, 99))
+
+
+def render_slice(a, k, lo_v, hi_v, zooms):
+    s = a[:, :, k]
+    s = np.clip((s - lo_v) / max(hi_v - lo_v, 1e-6), 0, 1)
+    s = (s * 255 + 0.5).astype(np.uint8)
+    img = s.T[::-1, ::-1]  # RAS 정렬 후: 위=anterior, 영상 왼쪽=환자 오른쪽(radiological)
+    h, w = img.shape
+    # 평면내 spacing 보정 (x: 열 방향 zooms[0], y: 행 방향 zooms[1])
+    hh = h * zooms[1]
+    ww = w * zooms[0]
+    scale = SIDE / max(hh, ww)
+    nh, nw = max(1, int(round(hh * scale))), max(1, int(round(ww * scale)))
+    pil = Image.fromarray(img).resize((nw, nh), Image.BICUBIC)
+    canvas = Image.new('L', (SIDE, SIDE), 0)
+    canvas.paste(pil, ((SIDE - nw) // 2, (SIDE - nh) // 2))
+    return canvas.convert('RGB')
+
+
+def build_case(rec, zip_path, out_dir):
+    """returns dict with qc info and rendered PNG paths; None 사유 포함."""
+    ex, missing = extract(zip_path, rec['study_uid'], rec['series_id'])
+    info = dict(study_uid=rec['study_uid'], patient_uid=rec['patient_uid'], series_id=rec['series_id'], files=ex, missing=missing)
+    if missing:
+        info['exclude'] = 'missing_member:' + ','.join(missing)
+        return info
+    a, b, li = load_case(ex['img.nii.gz']['path'], ex['brain.nii.gz']['path'])
+    info.update(li)
+    if a is None:
+        info['exclude'] = 'shape_or_ndim_mismatch'
+        return info
+    if not info['affine_match']:
+        info['exclude'] = 'affine_mismatch'
+        return info
+    if not np.isfinite(a).all():
+        info['exclude'] = 'nonfinite'
+        return info
+    if info['canon_axcodes'] != 'RAS':
+        info['exclude'] = 'orientation_not_RAS'
+        return info
+    br = brain_range(b)
+    if br is None:
+        info['exclude'] = 'no_brain_range'
+        return info
+    lo, hi = br
+    info['brain_slice_range'] = [lo, hi]
+    info['n_brain_slices'] = hi - lo + 1
+    info['brain_voxels'] = int(b.sum())
+    C = pick(lo, hi, 0.25, 0.75)
+    W = pick(lo, hi, 0.05, 0.95)
+    info['C_idx'], info['W_idx'] = C, W
+    if len(set(C)) < N_SLICE or len(set(W)) < N_SLICE:
+        info['exclude'] = 'lt8_unique_slices'
+        return info
+    lo_v, hi_v = intensity_window(a, b)
+    info['window_p1_p99'] = [lo_v, hi_v]
+    if not hi_v > lo_v:
+        info['exclude'] = 'degenerate_window'
+        return info
+    os.makedirs(out_dir, exist_ok=True)
+    pngs = {}
+    for k in sorted(set(C) | set(W)):
+        p = os.path.join(out_dir, f'{rec["study_uid"]}_s{k:03d}.png')
+        im = render_slice(a, k, lo_v, hi_v, info['canon_zooms'])
+        if not os.path.exists(p):
+            im.save(p)
+        pngs[k] = dict(path=p, sha256=sha_file(p))
+    info['pngs'] = {str(k): v for k, v in pngs.items()}
+    info['exclude'] = None
+    return info
+
+
+def montage(info, which, out_path):
+    ims = [Image.open(info['pngs'][str(k)]['path']).resize((224, 224)) for k in info[which + '_idx']]
+    M = Image.new('RGB', (224 * 4, 224 * 2))
+    for i, im in enumerate(ims):
+        M.paste(im, ((i % 4) * 224, (i // 4) * 224))
+    M.save(out_path)
diff --git a/mr123_eval.py b/mr123_eval.py
new file mode 100644
index 0000000..cd7a135
--- /dev/null
+++ b/mr123_eval.py
@@ -0,0 +1,153 @@
+"""iter_123: 평가 (BA 주지표). usage: python mr123_eval.py <stage> <out_json> [--protocol protocol.json]
+UNCERTAIN/INVALID는 정답으로 세지 않는다. 양·음성 층 내 환자 paired bootstrap 10,000회, seed122, 95% CI.
+"""
+import hashlib, json, os, sys
+import numpy as np
+import mr123_run as R
+
+SEED = 122
+NB = 10000
+
+
+def load_stage(stage):
+    reqs = R.read_jsonl(R.GEN + stage + '/requests.jsonl')
+    rid = [r['id'] for r in reqs]
+    assert len(set(rid)) == len(rid)
+    recs = {}
+    for fn in sorted(os.listdir(R.GEN + stage)):
+        if fn.startswith('worker_') and fn.endswith('.jsonl'):
+            for r in R.read_jsonl(R.GEN + stage + '/' + fn):
+                assert r['id'] not in recs, 'duplicate id ' + r['id']
+                recs[r['id']] = r
+    missing = set(rid) - set(recs)
+    extra = set(recs) - set(rid)
+    assert not missing and not extra, (len(missing), len(extra))
+    # 요청-출력 연결, 현재 PNG hash 재검증, parser 재적용
+    for q in reqs:
+        r = recs[q['id']]
+        assert r['cond'] == q['cond'] and r['study_uid'] == q['study_uid']
+        for p, h in zip(q['paths'], q['png_sha256']):
+            d = hashlib.sha256(open(p, 'rb').read()).hexdigest()
+            assert d == h, 'png changed ' + p
+        st, code = R.parse(r['text'])
+        assert (st, code) == (r['state'], r['parse_code']), 'parser mismatch'
+    return reqs, recs
+
+
+def patient_table(reqs, recs):
+    pt = {}
+    for q in reqs:
+        r = recs[q['id']]
+        p = pt.setdefault(q['patient_uid'], dict(label=q['label'], batch=q['batch_id'], study=q['study_uid']))
+        p[q['cond']] = r['state']
+        p[q['cond'] + '_eos'] = r['eos']
+        p[q['cond'] + '_code'] = r['parse_code']
+    for p in pt.values():
+        p['P'] = R.agg_P(p['P1'], p['P2'])
+    return pt
+
+
+def conf(pt, cond):
+    out = {}
+    for lab in ['positive', 'negative']:
+        c = {s: 0 for s in ['PRESENT', 'ABSENT', 'UNCERTAIN', 'INVALID']}
+        for p in pt.values():
+            if p['label'] == lab:
+                c[p[cond]] += 1
+        out[lab] = c
+    return out
+
+
+def vec(pt, cond):
+    ids = sorted(pt)
+    lab = np.array([pt[i]['label'] == 'positive' for i in ids])
+    corr = np.array([(pt[i][cond] == 'PRESENT') if pt[i]['label'] == 'positive' else (pt[i][cond] == 'ABSENT') for i in ids])
+    return ids, lab, corr
+
+
+def ba(lab, corr):
+    return 0.5 * (corr[lab].mean() + corr[~lab].mean())
+
+
+def metrics(pt, cond):
+    ids, lab, corr = vec(pt, cond)
+    c = conf(pt, cond)
+    n_pos, n_neg = int(lab.sum()), int((~lab).sum())
+    sens, spec = c['positive']['PRESENT'] / n_pos, c['negative']['ABSENT'] / n_neg
+    expl = sum(1 for p in pt.values() if p[cond] in ('PRESENT', 'ABSENT')) / len(pt)
+    expl_acc = (c['positive']['PRESENT'] + c['negative']['ABSENT']) / max(1, sum(1 for p in pt.values() if p[cond] in ('PRESENT', 'ABSENT')))
+    return dict(BA=0.5 * (sens + spec), sensitivity=sens, specificity=spec, explicit_coverage=expl, explicit_accuracy=expl_acc, confusion=c,
+                n_uncertain=sum(1 for p in pt.values() if p[cond] == 'UNCERTAIN'), n_invalid=sum(1 for p in pt.values() if p[cond] == 'INVALID'))
+
+
+def paired(pt, a, b, rng):
+    ids, lab, ca = vec(pt, a)
+    _, _, cb = vec(pt, b)
+    pos, neg = np.where(lab)[0], np.where(~lab)[0]
+    d = []
+    for _ in range(NB):
+        ip = rng.choice(pos, len(pos)); ineg = rng.choice(neg, len(neg))
+        d.append(0.5 * ((ca[ip].mean() - cb[ip].mean()) + (ca[ineg].mean() - cb[ineg].mean())))
+    d = np.array(d)
+    pt_est = ba(lab, ca) - ba(lab, cb)
+    to_a = int(((~cb) & ca).sum()); to_b = int((cb & (~ca)).sum())  # b에서 오답→a에서 정답 / b 정답→a 오답
+    by_batch = {}
+    for bt in sorted({pt[i]['batch'] for i in ids}):
+        m = np.array([pt[i]['batch'] == bt for i in ids])
+        if m.sum() and lab[m].any() and (~lab[m]).any():
+            by_batch[bt] = dict(n=int(m.sum()), n_pos=int(lab[m].sum()), diff_BA=float(ba(lab[m], ca[m]) - ba(lab[m], cb[m])),
+                                fixed=int(((~cb[m]) & ca[m]).sum()), broken=int((cb[m] & (~ca[m])).sum()))
+        else:
+            by_batch[bt] = dict(n=int(m.sum()), n_pos=int(lab[m].sum()), diff_BA=None,
+                                fixed=int(((~cb[m]) & ca[m]).sum()), broken=int((cb[m] & (~ca[m])).sum()))
+    return dict(diff=float(pt_est), ci95=[float(np.percentile(d, 2.5)), float(np.percentile(d, 97.5))], fixed_by_first=to_a, broken_by_first=to_b,
+                sens_diff=float(ca[lab].mean() - cb[lab].mean()), spec_diff=float(ca[~lab].mean() - cb[~lab].mean()), by_batch=by_batch)
+
+
+def decide(m, pw, wc):
+    flags = {}
+    flags['P_minus_W_positive'] = pw['diff'] >= 0.10 and pw['ci95'][0] > 0
+    flags['W_minus_C_positive'] = wc['diff'] >= 0.10 and wc['ci95'][0] > 0
+    flags['simple_alt_sufficient'] = any(m[c]['BA'] >= 0.80 and m[c]['sensitivity'] >= 0.75 and m[c]['specificity'] >= 0.75 for c in ['W', 'P'])
+    flags['P_minus_W_weak_ci_upper_lt_10pp'] = pw['ci95'][1] < 0.10
+    flags['all_BA_le_0.60'] = all(m[c]['BA'] <= 0.60 for c in ['C', 'W', 'P'])
+    if flags['P_minus_W_positive']:
+        v = 'positive_P_over_W'
+    elif flags['simple_alt_sufficient']:
+        v = 'simple_alternative_sufficient_candidate'
+    elif flags['all_BA_le_0.60']:
+        v = 'negative_low_frozen_performance_all_conditions'
+    elif flags['P_minus_W_weak_ci_upper_lt_10pp']:
+        v = 'negative_no_large_split_gain'
+    else:
+        v = 'inconclusive'
+    return v, flags
+
+
+def main(stage, out_path):
+    reqs, recs = load_stage(stage)
+    pt = patient_table(reqs, recs)
+    rng = np.random.default_rng(SEED)
+    m = {c: metrics(pt, c) for c in ['C', 'W', 'P']}
+    pw = paired(pt, 'P', 'W', rng)
+    wc = paired(pt, 'W', 'C', rng)
+    pc = paired(pt, 'P', 'C', rng)
+    v, flags = decide(m, pw, wc)
+    n_pos = sum(1 for p in pt.values() if p['label'] == 'positive')
+    nonEOS = sum(1 for r in recs.values() if not r['eos'])
+    parse_codes = {}
+    for r in recs.values():
+        parse_codes[r['parse_code']] = parse_codes.get(r['parse_code'], 0) + 1
+    out = dict(stage=stage, n_patients=len(pt), n_pos=n_pos, n_neg=len(pt) - n_pos, n_requests=len(recs), n_non_eos=nonEOS, parse_codes=parse_codes,
+               metrics=m, P_minus_W=pw, W_minus_C=wc, P_minus_C=pc, verdict=v, flags=flags, bootstrap=dict(n=NB, seed=SEED, stratified_by_label=True),
+               per_patient={str(k): v_ for k, v_ in pt.items()})
+    json.dump(out, open(out_path, 'w'), indent=1, default=str)
+    print(json.dumps({k: out[k] for k in ['n_patients', 'n_pos', 'n_neg', 'n_non_eos', 'parse_codes', 'verdict', 'flags']}, indent=1))
+    for c in ['C', 'W', 'P']:
+        print(c, {k: (round(x, 4) if isinstance(x, float) else x) for k, x in m[c].items()})
+    for k, x in [('P-W', pw), ('W-C', wc), ('P-C', pc)]:
+        print(k, round(x['diff'], 4), [round(y, 4) for y in x['ci95']], 'fixed', x['fixed_by_first'], 'broken', x['broken_by_first'])
+
+
+if __name__ == '__main__':
+    main(sys.argv[1], sys.argv[2])
diff --git a/mr123_fetch.py b/mr123_fetch.py
