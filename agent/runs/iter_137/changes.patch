diff --git a/i134_spec.py b/i134_spec.py
new file mode 100644
index 0000000..7962f6c
--- /dev/null
+++ b/i134_spec.py
@@ -0,0 +1,75 @@
+"""iter_134: GPU 출력 전에 고정한 prompt·상태 parser·명시 모순 규약·렌더 설정·조건표.
+질문: 제공된 영상 전체 중 어느 하나에 종양성 병변이 보이는가 (PRESENT/ABSENT/UNKNOWN). annotation-defined 정답이며 임상 진단이 아니다."""
+import re
+from pathlib import Path
+
+BASE_CONFIG = dict(model_id='google/medgemma-1.5-4b-it', revision='91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b', dtype='bfloat16',
+                   attention='sdpa', do_sample=False, seed=134, batch=1, image_labels=False)   # image_labels=False: v1 기술 실행(라벨 있음, T_w2)과 구분
+TOKENS = dict(technical=1024, technical2048=2048)   # main은 technical_gate.json의 main_max_new_tokens
+STAGES = ['technical', 'technical2048', 'main']
+
+QUESTION = ('The following FLAIR MRI image(s) of one brain are provided. '
+            'Question: is a tumor-like lesion visible in at least one of the provided images? '
+            'On the first line output only one word: PRESENT, ABSENT, or UNKNOWN. '
+            'PRESENT means a lesion is visible in at least one provided image. '
+            'ABSENT means no lesion is visible in any provided image. '
+            'UNKNOWN means this cannot be judged from the provided images. '
+            'Then give one short sentence of visible evidence.')
+NOIMG = ' In this input no MRI image is provided.'
+LABEL = 'Image %d:\n'
+FORBIDDEN_IN_PROMPT = ['BraTS', 'GLI', 't2f', 'glioma', 'edema', 'RadGenome', 'sub-', 'report', 'annotation', 'mask']
+
+# 조건: id -> 관측 구성(P=최대 종양 면적 axial slice, N1/N2=종양 annotation 0인 뇌 slice, 물리 거리 순)
+CONDS = dict(P=['P'], N1=['N1'], N2=['N2'], PN1=['P', 'N1'], N1P=['N1', 'P'], N1N2=['N1', 'N2'], N2N1=['N2', 'N1'],
+             PP=['P', 'P'], N1N1=['N1', 'N1'], NONE=[])
+RENDER = dict(side=896, normalization='volume_minmax', orientation='closest_canonical_RAS', mask_rule='seg>0 (whole tumor)',
+              N_min_brain_area_frac=0.5, P_rule='max whole-tumor area axial slice, tie lowest z', N_rule='tumor area 0, brain area>=0.5*max, nearest |dz|*zoom, tie lowest z')
+
+VALID = ('PRESENT', 'ABSENT', 'UNKNOWN')
+
+
+def first_line(text):
+    if not text or not text.strip():
+        return None
+    return text.strip().splitlines()[0].strip()
+
+
+def parse(text, eos=True):
+    """엄격 parser: EOS 종료, 첫 줄이 (양끝 ** 와 끝 마침표만 제거한 뒤) 세 상태 중 정확히 하나."""
+    if not eos:
+        return None
+    ln = first_line(text)
+    if ln is None:
+        return None
+    ln = ln.strip('*').strip().rstrip('.').strip('*').strip()
+    return ln if ln in VALID else None
+
+
+NEG = re.compile(r'\b(no|without|not|absence of|free of)\b(?:(?!\b(?:but|and|with|however|while)\b)[^.\n,;]){0,30}?\b(lesion|tumou?r|mass|abnormal\w*|hyperintens\w*)', re.I)
+POS = re.compile(r'\b(hyperintens\w*|abnormal signal|lesion (is|are) (visible|seen|present)|visible (lesion|mass)|a (lesion|mass|tumou?r) (is|in|at|within|located))\b', re.I)
+NOIMG_PHRASE = re.compile(r'\b(no (mri )?images? (is|are|was|were)? ?(provided|available)|cannot (assess|judge)|unable to (assess|judge))\b', re.I)
+
+
+def audit(text, state):
+    """첫 줄 상태와 설명문의 명시 모순 감사. 반환: 'consistent' | 'contradiction' | 'unresolved' | 'na'. 모호하면 unresolved. 원 답은 바꾸지 않는다."""
+    if state is None:
+        return 'na'
+    lines = (text or '').strip().splitlines()[1:]
+    body = ' '.join(l.strip() for l in lines if l.strip())
+    if not body:
+        return 'unresolved'
+    neg = bool(NEG.search(body)); pos = bool(POS.search(NEG.sub(' ', body)))   # 부정 구절을 제거한 뒤 양성 표현을 찾는다
+    if state == 'PRESENT':
+        if neg and not pos: return 'contradiction'
+        return 'consistent' if pos and not neg else 'unresolved'
+    if state == 'ABSENT':
+        if pos and not neg: return 'contradiction'
+        return 'consistent' if neg and not pos else 'unresolved'
+    return 'unresolved'
+
+
+def repetition(text, n_tokens=None, cap=None):
+    """동일 문장이 3회 이상 반복되거나 동일 줄 연속 반복."""
+    sents = [s.strip().lower() for s in re.split(r'(?<=[.!?])\s+|\n+', text or '') if len(s.strip()) > 8]
+    from collections import Counter
+    return bool(sents) and max(Counter(sents).values()) >= 3
diff --git a/i137_common.py b/i137_common.py
new file mode 100644
index 0000000..0a293a4
--- /dev/null
+++ b/i137_common.py
@@ -0,0 +1,30 @@
+"""iter_137 전용 경로·출처 유틸리티 (i136_common 파생). 결과는 results/iter_137에만 쓰고 iter_136 자료는 읽기 전용으로만 쓴다."""
+import hashlib, json, os
+from pathlib import Path
+from datetime import datetime, timezone
+
+HERE = Path(__file__).resolve().parent
+RES = HERE / 'results/iter_137'
+DATA = RES / 'data'
+OLD136 = HERE / 'results/iter_136'   # 읽기 전용 입력(manifest·PNG)
+GEN_SEED = 136     # 생성 seed (계획: 원 실행과 동일)
+BOOT_SEED = 137    # bootstrap seed (계획)
+
+
+def sha(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(4 << 20), b''):
+            h.update(b)
+    return h.hexdigest()
+
+
+def now(): return datetime.now(timezone.utc).isoformat()
+def digest(x): return hashlib.sha256(json.dumps(x, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()).hexdigest()
+def read(p): return json.loads(Path(p).read_text())
+
+
+def save(p, x):
+    p = Path(p); p.parent.mkdir(parents=True, exist_ok=True)
+    with open(p, 'x') as f:
+        json.dump(x, f, indent=2, sort_keys=True, allow_nan=False); f.write('\n'); f.flush(); os.fsync(f.fileno())
diff --git a/i137_data.py b/i137_data.py
new file mode 100644
index 0000000..76f993a
--- /dev/null
+++ b/i137_data.py
@@ -0,0 +1,75 @@
+"""iter_137 자료 연결 (CPU): iter_136 manifest의 D6/E45 P·N1 PNG를 읽기 전용으로 재연결하고 hash·역할·D/E 비중복·annotation 면적을 검사한 뒤,
+A/B 두 인터페이스의 요청 파일(technical 24 / main 180)을 만든다. 새 표본 선정·재렌더 없음. 모델 입력에는 mask·환자 ID·slice 역할·정답을 넣지 않는다.
+msd56_data.py의 case_paths는 원 NIfTI hash 확인에만 쓴다(원 hash가 없으면 PNG hash 검사로 한정하고 기록)."""
+import hashlib, json, sys
+from pathlib import Path
+import numpy as np
+from PIL import Image
+from i137_common import RES, DATA, OLD136, HERE, GEN_SEED, sha, read, save, digest, now
+from i137_spec import PROMPTS, IFACES, ROLES, FORBIDDEN_IN_PROMPT
+
+
+def link():
+    m = read(OLD136 / 'data/manifest.json'); problems = []
+    cases = m['cases']; ids = {s: [c['case'] for c in cases[s]] for s in 'DE'}
+    if set(ids['D']) & set(ids['E']): problems.append('D_E_overlap')
+    for s in 'DE':
+        if len(set(ids[s])) != len(ids[s]): problems.append('duplicate_case_' + s)
+    if (len(ids['D']), len(ids['E'])) != (6, 45): problems.append('unexpected_counts %s' % [len(ids['D']), len(ids['E'])])
+    png_owner = {}; rows = {'D': [], 'E': []}; raw_check = []
+    try:
+        import msd56_data as M
+    except Exception as e:   # noqa: BLE001
+        M = None; problems.append('msd56_data_import_failed:' + repr(e)[:80])
+    for s in 'DE':
+        for c in cases[s]:
+            img = {}
+            for role in ROLES:
+                im = c['images'][role]; p = Path(im['path'])
+                if not str(p).startswith(str(OLD136 / 'data/png') + '/'): problems.append('path_outside %s' % p)
+                if sha(p) != im['sha256']: problems.append('png_sha %s %s' % (c['case'], role))
+                arr = np.array(Image.open(p).convert('RGB'))
+                if arr.shape[:2] != (240, 240) or not ((arr[..., 0] == arr[..., 1]).all() and (arr[..., 0] == arr[..., 2]).all()): problems.append('png_format %s %s' % (c['case'], role))
+                png_owner.setdefault(im['sha256'], []).append((c['case'], role))
+                img[role] = dict(path=str(p), sha256=im['sha256'], pixel_sha256=hashlib.sha256(arr.tobytes()).hexdigest(), z=c['z'][role], annotation_area=c['area'][role])
+            if not (c['area']['P'] > 0 and c['area']['N1'] == 0): problems.append('area_contract %s' % c['case'])
+            if img['P']['sha256'] == img['N1']['sha256']: problems.append('same_png_P_N1 %s' % c['case'])
+            if c['images']['P']['same_pixels_as_iter064_png'] is not True or c['images']['N1']['same_pixels_as_iter064_png'] is not True: problems.append('iter064_pixel_link %s' % c['case'])
+            if M is not None:
+                ip, lp = M.case_paths(c['case'])
+                if Path(ip).exists() and Path(lp).exists():
+                    ok = sha(ip) == c['img_sha256'] and sha(lp) == c['lbl_sha256']; raw_check.append(ok)
+                    if not ok: problems.append('raw_nifti_sha %s' % c['case'])
+            rows[s].append(dict(case=c['case'], images=img))
+    dup = {k: v for k, v in png_owner.items() if len({x[0] for x in v}) > 1}
+    if dup: problems.append('png_duplicates_across_cases')
+    return m, rows, dict(problems=problems, n_raw_nifti_checked=len(raw_check), all_raw_nifti_ok=bool(raw_check) and all(raw_check), n_cases={s: len(rows[s]) for s in 'DE'}, png_duplicates=len(dup),
+                         excluded_in_iter136=[e['case'] for e in m['excluded']], iter136_manifest_sha256=sha(OLD136 / 'data/manifest.json'))
+
+
+def make_requests(rows):
+    reqs = []
+    for c in rows:
+        for role in ROLES:
+            for ifc in IFACES:
+                prompt = PROMPTS[ifc]; assert not any(s in prompt for s in FORBIDDEN_IN_PROMPT)
+                im = c['images'][role]
+                r = dict(id='%s__%s__%s' % (c['case'], role, ifc), kind='single', patient=c['case'], cond=role, iface=ifc, roles=[role], prompt=prompt,
+                         images=[dict(path=im['path'], sha256=im['sha256'])])
+                r['request_digest'] = digest(r); reqs.append(r)
+    reqs.sort(key=lambda r: hashlib.sha256(('%d|%s' % (GEN_SEED, r['id'])).encode()).hexdigest())   # 환자·조건·인터페이스 순서 균형화(seed 고정)
+    return reqs
+
+
+def main():
+    m, rows, checks = link()
+    run = not checks['problems']
+    save(DATA / 'manifest.json', dict(created_at=now(), source='results/iter_136/data/manifest.json(읽기 전용)', checks=checks, run_models=run, rows=rows,
+                                       note='반복 개발 자료(MSD Task01 FLAIR). 독립 test 아님. N1은 annotation 면적 0 slice이며 임상 정상이 아니다. P는 GT 기반 선택이다.'))
+    if run:
+        save(RES / 'requests/technical.json', make_requests(rows['D'])); save(RES / 'requests/main.json', make_requests(rows['E']))
+    print('run', run, {k: v for k, v in checks.items() if k != 'excluded_in_iter136'})
+
+
+if __name__ == '__main__':
+    main()
diff --git a/i137_eval.py b/i137_eval.py
new file mode 100644
index 0000000..06ae41f
--- /dev/null
+++ b/i137_eval.py
@@ -0,0 +1,107 @@
+"""iter_137 평가기: 출력 생성 전에 잠근다. strict 상태(UNKNOWN·invalid·절단은 오답, 분모 유지), annotation-defined BA, B−A 환자 paired bootstrap(10,000회, seed137, percentile 95%),
+사전 판정 분기(positive / negative / inconclusive / invalid_output_conditions). 정답은 annotation-defined이며 임상 진단이 아니다.
+입력: completion이 검증된 main job(verify_job: 요청 완전성·protocol·provenance 재검증). 자유 설명의 임상 정확성은 채점하지 않는다."""
+import glob, json, sys
+from pathlib import Path
+import numpy as np
+from i137_common import RES, OLD136, BOOT_SEED, read, save, now, sha
+from i137_spec import parse, audit, repetition, first_line, extra_text, TRUTH, IFACES
+
+N_BOOT = 10000
+THR = dict(ba=0.75, sens=0.65, spec=0.65, diff=0.15, valid=0.95, neg_ba=0.60)
+
+
+def states_of(records):
+    st = {}
+    for r in records:
+        s = parse(r['final_text'], r['eos'], r['boundary_status'])
+        st[r['id']] = dict(state=s, eos=r['eos'], n_tokens=r['n_tokens'], wall_s=r['wall_s'], boundary=r['boundary_status'], text=r['text'], audit=audit(r['final_text'], s),
+                           rep=repetition(r['final_text']), extra=extra_text(r['final_text']), peak_reserved_mib=r['peak_reserved_mib'], n_image_tokens=r['n_image_tokens'], input_len=r['input_len'])
+    return st
+
+
+def patient_table(st, pids):
+    T = {}
+    for p in pids:
+        row = {}
+        for i in IFACES:
+            for c, truth in TRUTH.items():
+                row['ok_%s_%s' % (c, i)] = float(st['%s__%s__%s' % (p, c, i)]['state'] == truth)
+            row['ba_%s' % i] = (row['ok_P_%s' % i] + row['ok_N1_%s' % i]) / 2
+            row['both_%s' % i] = float(row['ok_P_%s' % i] == 1.0 and row['ok_N1_%s' % i] == 1.0)
+        row['diff_ba'] = row['ba_B'] - row['ba_A']
+        T[p] = row
+    return T
+
+
+def mean(T, k): return float(np.mean([v[k] for v in T.values()]))
+
+
+def boot(T, f, n=N_BOOT, seed=BOOT_SEED):
+    pids = sorted(T); rng = np.random.default_rng(seed); arr = np.array([f(T[p]) for p in pids]); idx = rng.integers(0, len(pids), (n, len(pids)))
+    b = arr[idx].mean(1); return float(arr.mean()), [float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))]
+
+
+def decide(rep):
+    """사전 규칙(plan Evaluation). 출력 조건이 valid하지 않으면 과학적 양성/음성으로 쓰지 않는다."""
+    v = rep['output_validity']; ok_valid = all(v[i]['eos_rate'] >= THR['valid'] and v[i]['boundary_valid_rate'] >= THR['valid'] and v[i]['first_line_valid_rate'] >= THR['valid'] for i in IFACES)
+    if not ok_valid: return 'invalid_output_conditions'
+    B, d, ci = rep['B'], rep['diff_B_minus_A'], rep['diff_ci95']
+    if B['BA'] >= THR['ba'] and B['sensitivity'] >= THR['sens'] and B['specificity'] >= THR['spec'] and d >= THR['diff'] and ci[0] > 0: return 'positive_limited_recovery'
+    if B['BA'] <= THR['neg_ba'] or ci[1] < THR['diff']: return 'negative_no_recovery'
+    return 'inconclusive'
+
+
+def repro_vs_iter136(rec):
+    """A 재실행 대 iter_136 저장 출력(같은 prompt·pixels·설정): 재현성 점검용이며 주판정에 쓰지 않는다."""
+    old = {}
+    for f in sorted(glob.glob(str(OLD136 / 'jobs/main/worker*.jsonl'))):
+        for l in open(f):
+            r = json.loads(l); old[r['id']] = r
+    n = same = same_state = 0; cmp_ = []
+    for r in rec:
+        if not r['id'].endswith('__A'): continue
+        o = old.get(r['id'][:-3])
+        if o is None: continue
+        n += 1; same += int(o['tokens'] == r['tokens'])
+        so = parse(o['final_text'], o['eos'], o['boundary_status']); sn = parse(r['final_text'], r['eos'], r['boundary_status']); same_state += int(so == sn)
+        if o['tokens'] != r['tokens']: cmp_.append(r['id'])
+    return dict(n_compared=n, identical_tokens=same, identical_state=same_state, differing_ids=cmp_)
+
+
+def report(job, stage='main'):
+    import i137_run as R
+    rec = R.verify_job(job, stage); st = states_of(rec)
+    pids = sorted(set(r['id'].split('__')[0] for r in rec)); assert len(rec) == 4 * len(pids)
+    T = patient_table(st, pids)
+    diff, ci = boot(T, lambda v: v['diff_ba'])
+    out = dict(created_at=now(), stage=stage, n_patients=len(pids), always_PRESENT_BA=0.5, thresholds=THR)
+    per = {}; validity = {}; confusion = {}
+    for i in IFACES:
+        sens, spec = mean(T, 'ok_P_%s' % i), mean(T, 'ok_N1_%s' % i)
+        bm, bci = boot(T, lambda v, i=i: v['ba_%s' % i])
+        out[i] = dict(BA=(sens + spec) / 2, BA_ci95=bci, sensitivity=sens, specificity=spec, both_correct_rate=mean(T, 'both_%s' % i))
+        rows = {c: [st['%s__%s__%s' % (p, c, i)] for p in pids] for c in TRUTH}
+        allr = rows['P'] + rows['N1']
+        validity[i] = dict(n=len(allr), eos_rate=float(np.mean([r['eos'] for r in allr])), non_eos=sum(not r['eos'] for r in allr), boundary_valid_rate=float(np.mean([r['boundary'] != 'invalid_boundary' for r in allr])),
+                           first_line_valid_rate=float(np.mean([r['state'] is not None for r in allr])), invalid=sum(r['state'] is None for r in allr), truncated_non_eos=sum(not r['eos'] for r in allr),
+                           unknown=sum(r['state'] == 'UNKNOWN' for r in allr), repetition=sum(r['rep'] for r in allr), extra_explanation=sum(r['extra'] for r in allr),
+                           audit_contradiction=sum(r['audit'] == 'contradiction' for r in allr), audit_unresolved=sum(r['audit'] == 'unresolved' for r in allr))
+        confusion[i] = {c: {k: sum(r['state'] == k for r in rows[c]) for k in ('PRESENT', 'ABSENT', 'UNKNOWN')} | dict(invalid=sum(r['state'] is None for r in rows[c])) for c in TRUTH}
+        per[i] = dict(mean_tokens=float(np.mean([r['n_tokens'] for r in allr])), sum_tokens=int(sum(r['n_tokens'] for r in allr)), mean_request_wall_s=float(np.mean([r['wall_s'] for r in allr])), sum_request_wall_s=float(sum(r['wall_s'] for r in allr)),
+                      max_peak_reserved_mib=float(max(r['peak_reserved_mib'] for r in allr)), n_image_tokens=sorted({r['n_image_tokens'] for r in allr}), input_len=sorted({r['input_len'] for r in allr}))
+    out.update(diff_B_minus_A=diff, diff_ci95=ci, output_validity=validity, confusion=confusion, cost=per,
+               cost_ratio_B_over_A=dict(tokens=per['B']['sum_tokens'] / per['A']['sum_tokens'], request_wall=per['B']['sum_request_wall_s'] / per['A']['sum_request_wall_s']),
+               transitions=dict(A_right_B_wrong=float(sum(max(0, v['ba_A'] - v['ba_B']) for v in T.values())), A_wrong_B_right=float(sum(max(0, v['ba_B'] - v['ba_A']) for v in T.values()))),
+               sec_both_correct_diff=dict(zip(('mean', 'ci95'), boot(T, lambda v: v['both_B'] - v['both_A']))),
+               repro_vs_iter136_A=repro_vs_iter136(rec), bootstrap=dict(n=N_BOOT, seed=BOOT_SEED, unit='patient', ci='percentile95'), job=str(job),
+               note='annotation-defined 정답이며 임상 진단이 아니다. 반복 개발 E45. 설명의 임상 정확성은 채점하지 않는다. audit_*는 보조 정규식 감사.')
+    out['decision'] = decide(out)
+    return out, T
+
+
+if __name__ == '__main__':
+    job = Path(sys.argv[1]).resolve(); outp = Path(sys.argv[2]).resolve(); assert str(outp).startswith(str(RES) + '/')
+    o, T = report(job, sys.argv[3] if len(sys.argv) > 3 else 'main')
+    save(outp, o); save(outp.with_name(outp.stem + '_per_patient.json'), T)
+    print(json.dumps({k: o[k] for k in ('A', 'B', 'diff_B_minus_A', 'diff_ci95', 'decision')}, indent=1))
diff --git a/i137_gate.py b/i137_gate.py
new file mode 100644
index 0000000..5f49a94
--- /dev/null
+++ b/i137_gate.py
@@ -0,0 +1,44 @@
+"""iter_137 기술 gate 재계산 (생성 후 분리 도구). i137_tech.gate와 판정 기준은 동일하다. 차이: 빨리 끝난 w4의 resources 샘플이 비어 있어 원 코드가 max(빈 dict)로 중단했으므로
+샘플 없음을 기록하고 record의 torch peak로 판정하는 보정만 적용했다. i137_tech.py는 protocol에 잠긴 원본 그대로 두었다. 모든 입력은 원시 job·kill_record·compare에서 읽는다."""
+import sys, json
+from i137_common import RES, read, save, now
+from i137_spec import parse
+import i137_run as R
+from i137_tech import T, TAGS, compare as _unused  # noqa: F401
+
+
+def gate(final_stage):
+    """사전 기준: 최종 기술 집단 모든 조건(NONE 포함) EOS 100%, 첫 줄 형식 유효율>=95%, tensor·negative·boundary·w4 정합성·재개·메모리 검사 통과. 정확도는 사용하지 않는다."""
+    tag = TAGS[final_stage]
+    t = read(T / 'tensor_check.json'); n = read(T / 'negative_tests_v2.json'); b = read(T / 'boundary_check.json')
+    names = [tag + '_w2', tag + '_w4', tag + '_resume']; cfgs = read(T / ('compare_%s.json' % names[0]))['configs']
+    rec = R.verify_job(RES / 'jobs' / names[0], final_stage)   # 원시 record·completion을 요청 manifest(잠금)에서 재검증
+    n_expected = len(R.requests(final_stage))
+    parsed = [parse(r['final_text'], r['eos'], r['boundary_status']) for r in rec]
+    ifc = {i: [p for r, p in zip(rec, parsed) if r['id'].endswith('__' + i)] for i in ('A', 'B')}
+    valid_by_iface = {i: sum(p is not None for p in v) / len(v) for i, v in ifc.items()}; n_by_iface = {i: len(v) for i, v in ifc.items()}
+    all_eos = all(r['eos'] for r in rec)
+    cap = {g['index']: int(g['total']) for g in R.smi()}
+    mem_ok = all(max(c['max_gpu_used_mib'].values(), default=0) <= min(cap.values()) for c in cfgs.values()) and all(c['max_peak_reserved_mib'] < min(cap.values()) for c in cfgs.values())
+    mem_samples = {nm: bool(cfgs[nm]['max_gpu_used_mib']) for nm in names}
+    kr = cfgs[names[2]]['kill_records']
+    resume_valid = bool(kr) and all(k['killed_while_running'] and 0 < k['lines_at_kill'] < n_expected and not k['completion_exists'] for k in kr)
+    for nm in names: R.verify_job(RES / 'jobs' / nm, final_stage)   # 세 구성 모두 원시 완료 검증
+    checks = dict(boundary=b['passed'], tensor=t['passed'], negative=n['all_rejected'], w4_identical=cfgs[names[1]]['identical_tokens_to_first'], resume_identical=cfgs[names[2]]['identical_tokens_to_first'],
+                  complete_expected=all(v['n'] == n_expected for v in cfgs.values()) and n_by_iface == {'A': n_expected // 2, 'B': n_expected // 2}, rc_zero=all(all(x == 0 for x in v['returncodes']) for v in cfgs.values()),
+                  resume_was_interrupted_midrun=resume_valid, all_eos_all_requests=all_eos, first_line_valid_ge_95_each_iface=all(v >= 0.95 for v in valid_by_iface.values()), memory_no_oom_peak_below_capacity=mem_ok)
+    passed = all(checks.values())
+    thr = {nm: cfgs[nm]['req_per_min_incl_load'] for nm in names[:2]}
+    ok_cfg = [nm for nm in names[:2] if cfgs[nm]['identical_tokens_to_first'] and all(x == 0 for x in cfgs[nm]['returncodes'])]
+    main_workers = 4 if (names[1] in ok_cfg and thr[names[1]] > thr[names[0]]) else 2   # 정확도가 아닌 같은 token·오류 없음·loading 포함 처리량으로 선택
+    save(T / ('technical_gate_%s.json' % final_stage), dict(created_at=now(), final_stage=final_stage, passed=passed, checks=checks, valid_rate_by_iface=valid_by_iface, n_by_iface=n_by_iface, n_expected=n_expected,
+                                                              n_non_eos=sum(not r['eos'] for r in rec), n_invalid=sum(p is None for p in parsed),
+                                                              boundary_status_counts={k: sum(r['boundary_status'] == k for r in rec) for k in ('no_marker', 'thought_final', 'invalid_boundary')},
+                                                              main_max_new_tokens=R.config_for(final_stage)['max_new_tokens'], main_workers=main_workers, throughput_req_per_min_incl_load=thr, gpu_used_samples_present=mem_samples, invalid_ids=[r['id'] for r, p in zip(rec, parsed) if p is None],
+                                                              note='기술 정확도는 gate에 쓰지 않음. 유효율은 인터페이스별(D 분모 각 12). 요청 수·재개 판정은 원시 완료·kill_record에서 계산.'))
+    print(checks, 'valid', valid_by_iface, 'passed', passed, 'main_workers', main_workers)
+
+
+
+if __name__ == '__main__':
+    gate(sys.argv[1])
