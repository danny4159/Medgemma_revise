+            if r["cond"] in ("D", "T", "C"):  # L은 crop 단독이라 원본 영상이 아님
+                first_pix.setdefault(r["patient"], r["input_pixel_sha256"][0])
+    manifest["iter108_total_unique"] = len(ans)
