+"""iter_067 SPIDER Modic 과제의 자료 연결·기하 검증·IVD 중심 sagittal stack 렌더.
+
+- 영상/mask는 results/iter_021/source/{images,masks}.zip (iter_021 검증본)에서 읽는다. 독립 기준은 SimpleITK(격리 설치, results/environments/sitk67/site).
+- 모든 volume을 물리축(LPS: x=L+, y=P+, z=S+) 기준 canonical 배열 V[lr, si, pa]로 바꾼다. 축 선택은 header 문자열이 아니라
+  SimpleITK direction 행렬의 지배 성분으로 한다. canonical index -> physical 대응은 SimpleITK TransformIndexToPhysicalPoint로 대조한다.
+- mask label 200+k(k=1이 가장 아래)와 radiological_gradings.csv의 'IVD label' k를 연결한다. 해부학 이름으로 변환하지 않는다.
+- 모델 입력에는 Modic 등급·병변 mask·신호 설명을 넣지 않는다. IVD mask는 위치 지정 oracle(crop 범위 계산)로만 사용한다.
+"""
+import csv, hashlib, io, json, os, sys, tempfile, zipfile
+
+import numpy as np
+from PIL import Image
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'results/environments/sitk67/site'))
+import SimpleITK as sitk  # noqa: E402
+
+from rsna_diag import mi19_mha as M  # noqa: E402
+from rsna_diag import mi19_render as R  # noqa: E402
+
+SRC = 'results/iter_021/source'
+IMG_ZIP, MSK_ZIP = f'{SRC}/images.zip', f'{SRC}/masks.zip'
+GRADES = f'{SRC}/radiological_gradings.csv'
+SPLIT = 'results/iter_021/data/split.json'
+TMP = 'results/iter_067/tmp'
+SIDE = 448            # 모든 slice를 SIDE x SIDE 정사각 canvas로(긴 변 기준 물리 등방 resize 후 중앙 padding)
+MARGIN_SI_FACTOR = 1.0   # superior/inferior 각각 disc AP 폭 x 1.0
+MARGIN_AP_FACTOR = 0.25  # AP 방향 각각 폭 x 0.25
+GRID_TOL = 1e-4
+LABELS = ['0', 'I', 'II', 'III']
+
+
+def sha_file(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for ch in iter(lambda: f.read(1 << 22), b''):
+            h.update(ch)
+    return h.hexdigest()
+
+
+def read_sitk(zpath, member):
+    """zip member -> SimpleITK image (임시 파일은 읽은 뒤 제거)."""
+    os.makedirs(TMP, exist_ok=True)
+    data = zipfile.ZipFile(zpath).read(member)
+    fd, p = tempfile.mkstemp(suffix='.mha', dir=TMP)
+    try:
+        with os.fdopen(fd, 'wb') as f:
+            f.write(data)
+        img = sitk.ReadImage(p)
+        img = sitk.Cast(img, img.GetPixelID())  # 파일 의존 해제(메모리 로드)
+        arr_check = sitk.GetArrayFromImage(img)
+    finally:
+        try:
+            os.remove(p)
+        except OSError:
+            pass
+    return img, data, arr_check
+
+
+class GeomError(RuntimeError):
+    pass
+
+
+def canon_axes(direction):
+    """direction(9, row-major, SimpleITK) -> {'perm': [array axis for canonical axis (x,z,y)], 'flip': [bool]*3, 'idx_axis': [index axis i]}.
+    index axis i의 방향 = D[:, i]. 각 index axis는 하나의 물리축에 지배적(>=0.9)으로 대응해야 한다."""
+    D = np.array(direction, dtype=float).reshape(3, 3)
+    if not np.all(np.isfinite(D)):
+        raise GeomError('non-finite direction')
+    phys_of_idx, sign_of_idx = {}, {}
+    for i in range(3):
+        col = D[:, i]
+        p = int(np.argmax(np.abs(col)))
+        if abs(col[p]) < 0.9:
+            raise GeomError(f'index axis {i} not dominantly aligned: {col}')
+        phys_of_idx[i], sign_of_idx[i] = p, (1 if col[p] > 0 else -1)
+    if sorted(phys_of_idx.values()) != [0, 1, 2]:
+        raise GeomError(f'index->physical axes not a permutation: {phys_of_idx}')
+    idx_of_phys = {p: i for i, p in phys_of_idx.items()}
+    order_phys = [0, 2, 1]  # canonical axes: x(L), z(S), y(P)
+    idx_axis = [idx_of_phys[p] for p in order_phys]
+    return {'idx_axis': idx_axis, 'flip': [sign_of_idx[i] < 0 for i in idx_axis],
+            'perm': [2 - i for i in idx_axis]}  # numpy array axis = 2 - index axis
+
+
+def to_canonical(arr_zyx, spacing_xyz, ca):
+    V = np.transpose(arr_zyx, ca['perm'])
+    for ax, fl in enumerate(ca['flip']):
+        if fl:
+            V = np.flip(V, axis=ax)
+    sp = [spacing_xyz[i] for i in ca['idx_axis']]
+    return np.ascontiguousarray(V), sp
+
+
+def canon_to_orig_index(ca, shape_can, idx_can):
+    """canonical index (a,b,c) -> sitk index (i,j,k) (x,y,z 순)."""
+    out = [0, 0, 0]
+    for ax in range(3):
+        v = idx_can[ax]
+        if ca['flip'][ax]:
+            v = shape_can[ax] - 1 - v
+        out[ca['idx_axis'][ax]] = int(v)
+    return out
+
+
+def grid_equal(a, b):
+    if a.GetSize() != b.GetSize():
+        return False
+    for u, v in ((a.GetSpacing(), b.GetSpacing()), (a.GetOrigin(), b.GetOrigin()), (a.GetDirection(), b.GetDirection())):
+        if not np.allclose(u, v, rtol=GRID_TOL, atol=1e-4):
+            return False
+    return True
+
+
+def load_pair(pid, seq):
+    """영상+mask를 읽고 기하 검증 후 canonical volume/label을 반환. 오류는 GeomError."""
+    img, ibytes, iarr = read_sitk(IMG_ZIP, f'images/{pid}_{seq}.mha')
+    msk, mbytes, marr = read_sitk(MSK_ZIP, f'masks/{pid}_{seq}.mha')
+    if not grid_equal(img, msk):
+        raise GeomError('image/mask grid mismatch')
+    if not np.all(np.isfinite(iarr.astype(np.float64))):
+        raise GeomError('non-finite image values')
+    sp = img.GetSpacing()
+    if not all(np.isfinite(s) and s > 0 for s in sp):
+        raise GeomError(f'non-positive spacing {sp}')
+    ca = canon_axes(img.GetDirection())
+    V, spc = to_canonical(iarr, sp, ca)
+    L, _ = to_canonical(marr, sp, ca)
+    # 독립 기준(SimpleITK physical)과 대조: mask 내 임의 voxel 8개
+    rng = np.random.RandomState(0)
+    coords = np.argwhere(L >= 200)
+    pts = coords[rng.choice(len(coords), min(8, len(coords)), replace=False)] if len(coords) else []
+    maxerr = 0.0
+    for c in pts:
+        oi = canon_to_orig_index(ca, V.shape, c)
+        # 원 배열 값과 canonical 값이 같은 voxel인지
+        if iarr[oi[2], oi[1], oi[0]] != V[tuple(c)] or marr[oi[2], oi[1], oi[0]] != L[tuple(c)]:
+            raise GeomError('canonical voxel does not match original voxel')
+        ph = np.array(img.TransformIndexToPhysicalPoint(oi))
+        # canonical 축 (x, z, y)의 물리 성분을 회전 없이 재현: 이웃 voxel 차이가 canonical 축 방향과 일치해야 함
+        for ax in range(3):
+            d = np.zeros(3, int); d[ax] = 1
+            c2 = tuple(np.array(c) + d)
+            if c2[ax] >= V.shape[ax]:
+                continue
+            oi2 = canon_to_orig_index(ca, V.shape, c2)
+            ph2 = np.array(img.TransformIndexToPhysicalPoint(oi2))
+            delta = ph2 - ph
+            phys_axis = [0, 2, 1][ax]
+            maxerr = max(maxerr, abs(abs(delta[phys_axis]) - spc[ax]) / spc[ax] if abs(delta[phys_axis]) > 0.9 * spc[ax] else 1.0)
+            if delta[phys_axis] <= 0:
+                raise GeomError(f'canonical axis {ax} does not increase along physical axis {phys_axis}')
+    D = np.array(img.GetDirection()).reshape(3, 3)
+    return {'V': V, 'L': L, 'spacing': spc, 'ca': ca, 'src_sha': {'image': hashlib.sha256(ibytes).hexdigest(), 'mask': hashlib.sha256(mbytes).hexdigest()},
+            'tilt_deg': float(max(np.degrees(np.arccos(min(1.0, np.abs(D[:, i]).max()))) for i in range(3))),
+            'physical_check_max_rel_err': float(maxerr), 'size_xyz': list(img.GetSize()),
+            'direction': [float(x) for x in img.GetDirection()], 'origin': [float(x) for x in img.GetOrigin()],
+            'header': M.parse_header(ibytes[:8192])[0].get('AnatomicalOrientation')}
+
+
+def ivd_info(L, spacing):
+    """label 201.. -> bbox(canonical idx inclusive)와 S 중심(mm, canonical z index 기반)."""
+    out = {}
+    for lab in np.unique(L):
+        if lab < 200:
+            continue
+        idx = np.argwhere(L == lab)
+        lo, hi = idx.min(0), idx.max(0)
+        out[int(lab) - 200] = {'lo': [int(x) for x in lo], 'hi': [int(x) for x in hi], 'n_vox': int(len(idx)),
+                               'si_center_mm': float(idx[:, 1].mean() * spacing[1])}
+    return out
+
+
+def read_grades():
+    rows = {}
+    with open(GRADES) as f:
+        for r in csv.DictReader(f):
+            rows[(r['Patient'], int(r['IVD label']))] = int(r['Modic'])
+    return rows
+
+
+def crop_box(info, shape, spacing):
+    """IVD bbox -> crop index range (si, pa)와 clipping/margin 기록. 좌우 slice는 전부 사용."""
+    sx, ss, sp_ = spacing
+    s_lo, s_hi, p_lo, p_hi = info['lo'][1], info['hi'][1], info['lo'][2], info['hi'][2]
+    W = (p_hi - p_lo + 1) * sp_   # disc AP 폭(mm)
+    s0 = int(np.floor(s_lo - MARGIN_SI_FACTOR * W / ss)); s1 = int(np.ceil(s_hi + 1 + MARGIN_SI_FACTOR * W / ss))
+    p0 = int(np.floor(p_lo - MARGIN_AP_FACTOR * W / sp_)); p1 = int(np.ceil(p_hi + 1 + MARGIN_AP_FACTOR * W / sp_))
+    c = {'si_clipped_lo': s0 < 0, 'si_clipped_hi': s1 > shape[1], 'pa_clipped_lo': p0 < 0, 'pa_clipped_hi': p1 > shape[2]}
+    s0c, s1c, p0c, p1c = max(0, s0), min(shape[1], s1), max(0, p0), min(shape[2], p1)
+    return {'si': [s0c, s1c], 'pa': [p0c, p1c], 'disc_ap_width_mm': float(W), 'clip': c,
+            'margin_mm': {'sup': float((s_lo - s0c) * ss), 'inf': float((s1c - 1 - s_hi) * ss), 'ant': float((p_lo - p0c) * sp_), 'post': float((p1c - 1 - p_hi) * sp_)}}
+
+
+def render_stack(V, spacing, cb, side=SIDE):
+    """canonical volume V[lr,si,pa]의 모든 sagittal slice를 같은 crop·window·scale로 side x side RGB uint8 목록으로 반환.
+    row=superior(위)->inferior, col=anterior->posterior(physical y 증가 방향)."""
+    lo, hi = R.volume_window(V)
+    s0, s1 = cb['si']; p0, p1 = cb['pa']
+    h_mm, w_mm = (s1 - s0) * spacing[1], (p1 - p0) * spacing[2]
+    mm_per_px = max(h_mm, w_mm) / side
+    new_h, new_w = max(1, round(h_mm / mm_per_px)), max(1, round(w_mm / mm_per_px))
+    top, left = (side - new_h) // 2, (side - new_w) // 2
+    outs = []
+    for i in range(V.shape[0]):
+        sl = V[i, s0:s1, p0:p1][::-1]
+        u8 = R.to_uint8(sl, lo, hi)
+        im = Image.fromarray(u8, mode='L').resize((new_w, new_h), resample=Image.BILINEAR)
+        canvas = np.zeros((side, side), np.uint8)
+        canvas[top:top + new_h, left:left + new_w] = np.asarray(im)
+        outs.append(np.repeat(canvas[:, :, None], 3, axis=2))
+    return outs, {'window': [lo, hi], 'resized_hw': [new_h, new_w], 'pad_top_left': [top, left], 'mm_per_px': mm_per_px}
+
+
+def save_png(path, arr):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    buf = io.BytesIO()
+    Image.fromarray(arr).save(buf, format='PNG')
+    tmp = f'{path}.tmp{os.getpid()}'
+    with open(tmp, 'wb') as f:
+        f.write(buf.getvalue())
+    os.replace(tmp, path)
+    return hashlib.sha256(buf.getvalue()).hexdigest()
diff --git a/sp75_c.py b/sp75_c.py
new file mode 100644
index 0000000..6406e54
--- /dev/null
+++ b/sp75_c.py
@@ -0,0 +1,229 @@
+"""iter_075 C: 공유 ResNet18 crop 분류기 (R과 같은 세 crop). ImageNet 초기값에서 적응, 세 영상 feature 평균 + 공통 5-class head.
+
+- 입력: R crop PNG(L) 3장 -> 중앙 square padding(종횡비 보존) -> 224 bilinear -> gray 3채널 복제 -> ImageNet normalization. 병변 central crop 없음.
+- 증강(사전 고정): 한 target의 세 slice에 같은 translate(+-8px at 224)·scale(0.9-1.1). flip/rotation/intensity 없음. 평가에는 증강 없음.
+- 학습 T24 supervised(ordinal 1,3,5)만, V8 supervised로 8 epoch마다 CE/primary 평가. E24는 `predict` 단계에서 선택 파일(LOCK) 확인 후에만 읽는다.
+- LR 1e-4/1e-3, AdamW wd1e-4, batch8, seed17, 최대 64 epoch. 최근 세 milestone에서 V8 CE와 primary가 모두 개선되지 않으면 종료.
+사용: python sp75_c.py train --out D --gpu 0  /  python sp75_c.py predict --out D --gpu 0
+"""
+import argparse, hashlib, json, os, sys, time
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'results/environments/tv071'))
+import numpy as np
+from PIL import Image
+
+import sp75_data as D
+import sp75_metrics as M
+
+TORCH_HOME_W = 'results/environments/ch75/torch_home/hub/checkpoints/resnet18-f37072fd.pth'
+WEIGHT_SHA256 = 'f37072fd47e89c5e827621c5baffa7500819f7896bbacec160b1a16c560e07ec'
+LRS = (1e-4, 1e-3)
+MAX_EPOCH, MILESTONE, BATCH, SEED, WD = 64, 8, 8, 17, 1e-4
+SIDE = 224
+TRANS_PX, SCALE_RANGE = 8, (0.9, 1.1)
+MEAN, STD = np.array([0.485, 0.456, 0.406], np.float32), np.array([0.229, 0.224, 0.225], np.float32)
+CODE = ['sp75_c.py', 'sp75_data.py', 'sp75_metrics.py']
+
+
+def sha_file(p):
+    return hashlib.sha256(open(p, 'rb').read()).hexdigest()
+
+
+def load_crop(path):
+    a = np.asarray(Image.open(path))
+    h, w = a.shape
+    s = max(h, w)
+    top, left = (s - h) // 2, (s - w) // 2
+    sq = np.zeros((s, s), np.uint8)
+    sq[top:top + h, left:left + w] = a
+    im = Image.fromarray(sq, mode='L').resize((SIDE, SIDE), resample=Image.BILINEAR)
+    x = np.asarray(im, np.float32) / 255.0
+    return x
+
+
+def to_tensor(x_list):
+    import torch
+    arr = np.stack([(np.repeat(x[:, :, None], 3, axis=2) - MEAN) / STD for x in x_list]).transpose(0, 3, 1, 2)
+    return torch.from_numpy(np.ascontiguousarray(arr))
+
+
+def augment(torch, xs, rng):
+    """xs: (3,3,H,W) tensor. 같은 translate/scale을 세 slice에 적용."""
+    import torchvision.transforms.v2.functional as TF
+    tx, ty = [int(v) for v in rng.integers(-TRANS_PX, TRANS_PX + 1, 2)]
+    sc = float(rng.uniform(*SCALE_RANGE))
+    return TF.affine(xs, angle=0.0, translate=[tx, ty], scale=sc, shear=[0.0, 0.0])
+
+
+def build_model(torch):
+    import torchvision
+    if sha_file(TORCH_HOME_W) != WEIGHT_SHA256:
+        raise RuntimeError('resnet18 weight digest mismatch')
+    m = torchvision.models.resnet18()
+    m.load_state_dict(torch.load(TORCH_HOME_W, map_location='cpu', weights_only=True))
+    m.fc = torch.nn.Identity()
+    head = torch.nn.Linear(512, 5)
+    return m, head
+
+
+class Net:
+    def __init__(self, torch):
+        self.trunk, self.head = build_model(torch)
+
+    def forward(self, x3):  # x3: (B,3,3,H,W) -> (B,5)
+        B = x3.shape[0]
+        f = self.trunk(x3.flatten(0, 1)).view(B, 3, -1).mean(1)
+        return self.head(f)
+
+    def modules(self):
+        return [self.trunk, self.head]
+
+
+def row_tensor(r):
+    return to_tensor([load_crop(e['path']) for e in r['inputs']['R']])
+
+
+def check_rows(rows):
+    for r in rows:
+        for e in r['inputs']['R']:
+            assert sha_file(e['path']) == e['file_sha256'], f"file hash changed {e['path']}"
+
+
+def evaluate(torch, net, rows, tens):
+    for m in net.modules():
+        m.eval()
+    probs = []
+    with torch.no_grad():
+        for i in range(0, len(rows), 16):
+            x = torch.stack([tens[j] for j in range(i, min(len(rows), i + 16))]).cuda()
+            probs.append(torch.softmax(net.forward(x).float(), -1).cpu())
+    return torch.cat(probs).numpy()
+
+
+def ce_of(probs, rows):
+    return float(-np.mean([np.log(max(probs[i, r['grade'] - 1], 1e-12)) for i, r in enumerate(rows)]))
+
+
+def train_one(torch, lr, tr_rows, va_rows, tr_t, va_t, out):
+    os.makedirs(out, exist_ok=True)
+    torch.manual_seed(SEED)
+    np.random.seed(SEED)
+    net = Net(torch)
+    for m in net.modules():
+        m.cuda()
+    params = [p for m in net.modules() for p in m.parameters()]
+    opt = torch.optim.AdamW(params, lr=lr, weight_decay=WD)
+    hist, best, no_imp = [], None, 0
+    t0 = time.time()
+    n = len(tr_rows)
+    for ep in range(1, MAX_EPOCH + 1):
+        rng = np.random.default_rng(SEED * 1000 + ep)
+        order = rng.permutation(n)
+        for m in net.modules():
+            m.train()
+        tot = 0.0
+        for s in range(0, n, BATCH):
+            ix = order[s:s + BATCH]
+            xs = torch.stack([augment(torch, tr_t[j], rng) for j in ix]).cuda()
+            y = torch.tensor([tr_rows[j]['grade'] - 1 for j in ix]).cuda()
+            loss = torch.nn.functional.cross_entropy(net.forward(xs).float(), y)
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            if not torch.isfinite(loss):
+                raise RuntimeError('non-finite loss')
+            opt.step()
+            tot += float(loss) * len(ix)
+        if ep % MILESTONE == 0:
+            pr = evaluate(torch, net, va_rows, va_t)
+            pred = [int(np.argmax(p)) + 1 for p in pr]
+            prim = M.class_std_mae([r['grade'] for r in va_rows], pred)[0]
+            ce = ce_of(pr, va_rows)
+            rec = {'epoch': ep, 'train_loss_epoch_mean': tot / n, 'val_ce': ce, 'val_primary': prim, 'elapsed_s': time.time() - t0}
+            hist.append(rec)
+            torch.save({'trunk': net.trunk.state_dict(), 'head': net.head.state_dict(), 'epoch': ep, 'lr': lr}, f'{out}/epoch_{ep:02d}.pt')
+            improved = best is None or ce < best['ce'] - 1e-12 or prim < best['prim'] - 1e-12
+            if improved:
+                best = {'ce': min(ce, best['ce']) if best else ce, 'prim': min(prim, best['prim']) if best else prim}
+                no_imp = 0
+            else:
+                no_imp += 1
+            json.dump(hist, open(f'{out}/history.json', 'w'), indent=1)
+            if no_imp >= 3:
+                break
+    return hist
+
+
+def run_train(a):
+    import torch
+    rows_all = D.load_manifest()['rows']
+    sel = lambda sp: sorted([r for r in rows_all if r['split'] == sp and r['position_set'] == 'supervised' and not r['excluded']], key=lambda r: (int(r['patient']), r['ordinal']))
+    tr_rows, va_rows = sel('T24'), sel('V8')
+    check_rows(tr_rows + va_rows)
+    tr_t = [row_tensor(r) for r in tr_rows]
+    va_t = [row_tensor(r) for r in va_rows]
+    res = {'lrs': {}, 'code': {f: sha_file(f) for f in CODE}, 'weight_sha256': WEIGHT_SHA256, 'n_train': len(tr_rows), 'n_val': len(va_rows),
+           'cfg': {'lrs': LRS, 'max_epoch': MAX_EPOCH, 'milestone': MILESTONE, 'batch': BATCH, 'seed': SEED, 'wd': WD, 'side': SIDE, 'trans_px': TRANS_PX, 'scale': SCALE_RANGE},
+           'manifest_sha256': sha_file(f'{D.DATA}/manifest.json')}
+    for lr in LRS:
+        out = f'{a.out}/lr{lr:g}'
+        if os.path.exists(f'{out}/history.json'):
+            sys.exit(f'{out} exists')
+        hist = train_one(torch, lr, tr_rows, va_rows, tr_t, va_t, out)
+        res['lrs'][f'{lr:g}'] = hist
+    # 선택: V8 primary 최소, 동률은 CE, 더 이른 epoch, 작은 LR
+    cands = [(h['val_primary'], h['val_ce'], h['epoch'], float(lr), lr) for lr, hs in res['lrs'].items() for h in hs]
+    cands.sort(key=lambda c: (round(c[0], 12), round(c[1], 12), c[2], c[3]))
+    best = cands[0]
+    res['selected'] = {'lr': best[4], 'epoch': best[2], 'val_primary': best[0], 'val_ce': best[1]}
+    json.dump(res, open(f'{a.out}/selection.json', 'w'), indent=1)
+    print(json.dumps(res['selected']))
+
+
+def run_predict(a):
+    import torch
+    sel = json.load(open(f'{a.out}/selection.json'))
+    s = sel['selected']
+    for f, h in sel['code'].items():
+        if sha_file(f) != h:
+            sys.exit(f'code changed since selection: {f}')
+    if sel['manifest_sha256'] != sha_file(f'{D.DATA}/manifest.json'):
+        sys.exit('manifest changed since selection')
+    ck = f"{a.out}/lr{s['lr']}/epoch_{s['epoch']:02d}.pt"
+    rows_all = D.load_manifest()['rows']
+    rows = sorted([r for r in rows_all if r['split'] == a.split and not r['excluded']], key=lambda r: (int(r['patient']), r['ordinal']))
+    check_rows(rows)
+    net = Net(torch)
+    blob = torch.load(ck, map_location='cpu', weights_only=True)
+    net.trunk.load_state_dict(blob['trunk'])
+    net.head.load_state_dict(blob['head'])
+    for m in net.modules():
+        m.cuda()
+    t0 = time.time()
+    tens = [row_tensor(r) for r in rows]
+    pr = evaluate(torch, net, rows, tens)
+    dt = time.time() - t0
+    out = [{'id': r['id'], 'patient': r['patient'], 'ordinal': r['ordinal'], 'position_set': r['position_set'], 'probs': pr[i].tolist(), 'pred': int(np.argmax(pr[i])) + 1}
+           for i, r in enumerate(rows)]
+    json.dump({'selected': s, 'checkpoint': ck, 'checkpoint_sha256': sha_file(ck), 'split': a.split, 'n': len(out), 'preds': out, 'elapsed_s': dt},
+              open(f'{a.out}/pred_{a.split}.json', 'w'), indent=1)
+    print('wrote', len(out))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('mode', choices=['train', 'predict'])
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--split', default='E24')
+    ap.add_argument('--gpu', default=None)
+    a = ap.parse_args()
+    if a.gpu is not None:
+        inh = os.environ.get('CUDA_VISIBLE_DEVICES', '').split(',')
+        if a.gpu not in inh:
+            sys.exit(f'gpu {a.gpu} not in inherited {inh}')
+        os.environ['CUDA_VISIBLE_DEVICES'] = a.gpu
+    os.makedirs(a.out, exist_ok=True)
+    run_train(a) if a.mode == 'train' else run_predict(a)
+
+
+if __name__ == '__main__':
+    main()
