index 0000000..18f978c
--- /dev/null
+++ b/rsna_diag/lock_protocol.py
@@ -0,0 +1,86 @@
+"""실행 protocol 잠금 (iter_010): 코드·manifest·prompt·생성 config digest를 파일로 고정하고, 실행 진입점에서 강제 검증한다.
+
+- 경로는 항상 명시한다 (기본값 없음). 존재하면 현재 digest와 대조해 불일치 시 실패한다 (덮어쓰지 않음).
+- verify(path) -> protocol digest (sha256 of locked 내용). generate/train/run_shards는 시작 시 verify를 호출하며 실패하면 실행하지 않는다.
+사용: python -m rsna_diag.lock_protocol --out PATH [--extra FILE ...] [--check]
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+from . import prompts as P
+
+CODE = ["rsna_diag/generate.py", "rsna_diag/parse.py", "rsna_diag/metrics.py", "rsna_diag/evaluate.py", "rsna_diag/geometry.py",
+        "rsna_diag/prompts.py", "rsna_diag/rsna_data.py", "rsna_diag/dicom_min.py", "rsna_diag/run_shards.py",
+        "rsna_diag/queue_lock.py", "rsna_diag/lock_protocol.py", "rsna_diag/lora.py", "rsna_diag/sft_data.py", "rsna_diag/train.py",
+        "rsna_diag/baselines.py", "rsna_diag/launch.py", "rsna_diag/select.py", "rsna_diag/final_eval.py", "rsna_diag/sft_eval.py",
+        "rsna_diag/data_gate.py", "rsna_diag/build_data.py", "rsna_diag/inputs.py", "rsna_diag/eval_gate.py", "rsna_diag/migrate.py",
+        "rsna_diag/pipeline.py"]  # iter_012: 단계 순서·건너뛰기 검증을 담당하는 pipeline도 잠근다
+DATA = ["results/iter_010/manifests/infer_manifest.jsonl", "results/iter_010/manifests/gt_manifest.json",
+        "results/iter_010/manifests/exclusion_previous_patients.json", "results/iter_010/manifests/reserve_patients.json",
+        "results/iter_009/source/official/cxr_anatomy_localization_with_hugging_face.ipynb"]
+
+
+def sha(path):
+    return hashlib.sha256(open(path, "rb").read()).hexdigest()
+
+
+def locked_digest(locked):
+    return hashlib.sha256(json.dumps(locked, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def digest_of(path):
+    """코드 상태를 검증하지 않고 protocol 파일의 digest만 계산한다 (부모 실행의 원본 protocol 식별용)."""
+    return locked_digest(json.load(open(path))["locked"])
+
+
+def locked_config_digest(path):
+    return json.load(open(path))["locked"]["generation_config_digest"]
+
+
+def current(extra=()):
+    from . import generate
+    files = [f for f in CODE + DATA + list(extra) if os.path.exists(f)]
+    d = {"files": {f: sha(f) for f in files}, "prompts": {k: P.digest(v) for k, v in P.all_prompts().items()}}
+    core, cdig = generate.static_config()
+    d["generation_config_digest"] = cdig
+    d["generation_config"] = core
+    return d
+
+
+def verify(path):
+    """protocol 파일이 없거나 현재 상태와 다르면 예외. returns protocol digest."""
+    if not path or not os.path.exists(path):
+        raise RuntimeError(f"protocol file missing: {path!r}")
+    old = json.load(open(path))
+    cur = current(extra=[f for f in old["locked"]["files"] if f not in CODE + DATA])
+    diff = {k: (old["locked"]["files"].get(k), v) for k, v in cur["files"].items() if old["locked"]["files"].get(k) != v}
+    diff.update({k: (v, None) for k, v in old["locked"]["files"].items() if k not in cur["files"]})
+    if diff or old["locked"]["prompts"] != cur["prompts"] or old["locked"]["generation_config_digest"] != cur["generation_config_digest"]:
+        raise RuntimeError("LOCK MISMATCH " + json.dumps(diff, indent=1)[:2000])
+    return locked_digest(old["locked"])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--extra", nargs="*", default=[])
+    ap.add_argument("--check", action="store_true")
+    ap.add_argument("--note", default="")
+    a = ap.parse_args()
+    if os.path.exists(a.out):
+        print("lock verified", verify(a.out))
+        return
+    if a.check:
+        print("no lock yet")
+        return
+    cur = current(a.extra)
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump({"locked": cur, "note": a.note}, open(a.out, "w"), indent=1, default=str)
+    print("locked", a.out, locked_digest(cur))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/rsna_diag/lora.py b/rsna_diag/lora.py
new file mode 100644
index 0000000..c596bdd
--- /dev/null
+++ b/rsna_diag/lora.py
@@ -0,0 +1,85 @@
+"""표준 LoRA (peft 미설치·설치 금지). y = W x + (alpha/r) B A x. 언어모델 attention/MLP 선형층만 (iter_010).
+
+- A: kaiming_uniform(a=sqrt(5)) (loralib 표준), B: 0 -> 초기 항등. base weight는 동결·불변.
+- LoRA 파라미터는 fp32 master, 연산은 fp32 후 base 출력 dtype으로 cast해 더한다.
+"""
+import hashlib
+import math
+
+import torch
+import torch.nn as nn
+
+TARGET_SUFFIXES = ("q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj")
+LM_LAYER_PREFIX = "model.language_model.layers."
+
+
+class LoRALinear(nn.Module):
+    def __init__(self, base: nn.Linear, r=16, alpha=32, dropout=0.05):
+        super().__init__()
+        self.base, self.r, self.alpha, self.scaling = base, r, alpha, alpha / r
+        dev = base.weight.device
+        self.lora_A = nn.Parameter(torch.empty(r, base.in_features, dtype=torch.float32, device=dev))
+        self.lora_B = nn.Parameter(torch.zeros(base.out_features, r, dtype=torch.float32, device=dev))
+        nn.init.kaiming_uniform_(self.lora_A, a=math.sqrt(5))
+        self.drop = nn.Dropout(dropout)
+
+    def forward(self, x):
+        y = self.base(x)
+        z = (self.drop(x).to(torch.float32) @ self.lora_A.t()) @ self.lora_B.t() * self.scaling
+        return y + z.to(y.dtype)
+
+
+def apply_lora(model, r=16, alpha=32, dropout=0.05, seed=None):
+    """LM layer의 대상 선형층을 LoRALinear로 교체하고 다른 모든 파라미터를 동결한다. returns 교체한 모듈 이름 목록."""
+    if seed is not None:
+        torch.manual_seed(seed)
+    for p in model.parameters():
+        p.requires_grad_(False)
+    names = []
+    for name, mod in list(model.named_modules()):
+        if name.startswith(LM_LAYER_PREFIX) and name.rsplit(".", 1)[-1] in TARGET_SUFFIXES and isinstance(mod, nn.Linear):
+            parent = model.get_submodule(name.rsplit(".", 1)[0])
+            setattr(parent, name.rsplit(".", 1)[1], LoRALinear(mod, r, alpha, dropout))
+            names.append(name)
+    if not names:
+        raise RuntimeError("no LoRA target modules found")
+    return names
+
+
+def lora_params(model):
+    return {n: p for n, p in model.named_parameters() if p.requires_grad}
+
+
+def lora_state_dict(model):
+    return {n: p.detach().to("cpu", torch.float32).clone() for n, p in model.named_parameters() if "lora_" in n}
+
+
+def load_lora_state(model, state, strict=True):
+    own = {n: p for n, p in model.named_parameters() if "lora_" in n}
+    if strict and set(own) != set(state):
+        raise ValueError(f"lora keys mismatch: missing {sorted(set(own) - set(state))[:3]} extra {sorted(set(state) - set(own))[:3]}")
+    with torch.no_grad():
+        for n, p in own.items():
+            p.copy_(state[n].to(p.device, p.dtype))
+
+
+def state_digest(state):
+    h = hashlib.sha256()
+    for n in sorted(state):
+        t = state[n].detach().to("cpu", torch.float32).contiguous()
+        h.update(n.encode())
+        h.update(str(tuple(t.shape)).encode())
+        h.update(t.numpy().tobytes())
+    return h.hexdigest()
+
+
+def base_digest(model):
+    """LoRA를 제외한 모든 파라미터의 (이름, shape, 첫/마지막 1M 원소 합 등이 아닌) 전체 hash. 동결 검증용 (느리지만 정확)."""
+    h = hashlib.sha256()
+    for n, p in model.named_parameters():
+        if "lora_" in n:
+            continue
+        h.update(n.replace(".base.", ".").encode())  # LoRA 적용 전후 이름을 같게 정규화
+        h.update(p.detach().to("cpu").contiguous().view(torch.uint8).numpy().tobytes() if p.dtype != torch.bfloat16
+                 else p.detach().to("cpu").contiguous().view(torch.int16).numpy().tobytes())
+    return h.hexdigest()
diff --git a/rsna_diag/metrics.py b/rsna_diag/metrics.py
new file mode 100644
index 0000000..33c5131
--- /dev/null
+++ b/rsna_diag/metrics.py
@@ -0,0 +1,136 @@
+"""bbox 평가 (iter_009). 모든 box는 [y0,x0,y1,x1] (0-1000, padding canvas)."""
+import itertools
+import math
+
+import numpy as np
+
+
+def area(b):
+    return max(0.0, b[2] - b[0]) * max(0.0, b[3] - b[1])
+
+
+def inter(a, b):
+    return max(0.0, min(a[2], b[2]) - max(a[0], b[0])) * max(0.0, min(a[3], b[3]) - max(a[1], b[1]))
+
+
+def iou(a, b):
+    i = inter(a, b)
+    u = area(a) + area(b) - i
+    return i / u if u > 0 else 0.0
+
+
+def union_area(boxes):
+    """겹친 면적을 한 번만 세는 직사각형 합집합 면적 (좌표 압축)."""
+    boxes = [b for b in boxes if area(b) > 0]
+    if not boxes:
+        return 0.0
+    ys = sorted({v for b in boxes for v in (b[0], b[2])})
+    tot = 0.0
+    for y0, y1 in zip(ys[:-1], ys[1:]):
+        iv = sorted((b[1], b[3]) for b in boxes if b[0] <= y0 and b[2] >= y1)
+        cur_s = cur_e = None
+        length = 0.0
+        for s, e in iv:
+            if cur_e is None or s > cur_e:
+                if cur_e is not None:
+                    length += cur_e - cur_s
+                cur_s, cur_e = s, e
+            else:
+                cur_e = max(cur_e, e)
+        if cur_e is not None:
+            length += cur_e - cur_s
+        tot += length * (y1 - y0)
+    return tot
+
+
+def union_iou(pred, gt):
+    if not pred and not gt:
+        return 0.0
+    up, ug = union_area(pred), union_area(gt)
+    # 교집합 면적 = up + ug - union(all)
+    ia = up + ug - union_area(list(pred) + list(gt))
+    u = up + ug - ia
+    return ia / u if u > 0 else 0.0
+
+
+def match(pred, gt, thr):
+    """threshold thr 이상 IoU 쌍의 최대 cardinality one-to-one matching.
+    동률은 총 IoU 최대, 이후 (gt index 순의) pred index tuple 사전순 최소. returns list[(gi, pi)]."""
+    mat = [[iou(p, g) for p in pred] for g in gt]
+    best = {"key": None, "pairs": []}
+
+    def rec(gi, used, pairs, tot):
+        if gi == len(gt):
+            key = (len(pairs), tot)
+            cur = best["key"]
+            if cur is None or key[0] > cur[0] or (key[0] == cur[0] and key[1] > cur[1] + 1e-12):
+                best["key"], best["pairs"] = key, list(pairs)
+            return
+        # 사전순 최소 tie-break: pred index 오름차순으로 탐색하고 엄격히 더 좋을 때만 갱신 (none 분기는 마지막)
+        for pi in range(len(pred)):
+            if pi not in used and mat[gi][pi] >= thr:
+                pairs.append((gi, pi))
+                rec(gi + 1, used | {pi}, pairs, tot + mat[gi][pi])
+                pairs.pop()
+        rec(gi + 1, used, pairs, tot)
+
+    rec(0, frozenset(), [], 0.0)
+    return best["pairs"]
+
+
+def patient_metrics(pred, gt, thr):
+    pairs = match(pred, gt, thr)
+    tp = len(pairs)
+    prec = tp / len(pred) if pred else 0.0
+    rec = tp / len(gt) if gt else 0.0
+    f1 = 2 * prec * rec / (prec + rec) if prec + rec > 0 else 0.0
+    return {"tp": tp, "n_pred": len(pred), "n_gt": len(gt), "precision": prec, "recall": rec, "f1": f1,
+            "unmatched_gt": len(gt) - tp, "unmatched_pred": len(pred) - tp}
+
+
+def max_iou_all(pred, gt):
+    return max((iou(p, g) for p in pred for g in gt), default=0.0)
+
+
+def wilson(k, n, z=1.959964):
+    if n == 0:
+        return (float("nan"), float("nan"))
+    p = k / n
+    d = 1 + z * z / n
+    c = (p + z * z / (2 * n)) / d
+    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+    return (c - h, c + h)
+
+
+def bootstrap_indices(n, B=10000, seed=20260924):
+    rng = np.random.default_rng(seed)
+    return rng.integers(0, n, size=(B, n), dtype=np.int32)
+
+
+def paired_boot_ci(a, b, idx):
+    """a,b: 같은 환자 순서의 값. 차이 a-b 평균의 percentile 95% CI. returns (mean_diff, lo, hi)."""
+    d = np.asarray(a, float) - np.asarray(b, float)
+    m = d[idx].mean(axis=1)
+    return float(d.mean()), float(np.percentile(m, 2.5)), float(np.percentile(m, 97.5))
+
+
+def derangement(n, seed):
+    """Sattolo: 고정점이 없는 순열 (단일 순환)."""
+    rng = np.random.default_rng(seed)
+    p = list(range(n))
+    for i in range(n - 1, 0, -1):
+        j = int(rng.integers(0, i))
+        p[i], p[j] = p[j], p[i]
+    assert all(p[i] != i for i in range(n))
+    return p
+
+
+def medoid_box(dev_gt_boxes_per_image):
+    """dev 양성 GT box 후보 중 (영상별 best IoU)의 평균이 최대인 실제 box. 동률은 입력 순서(고정 ID 순)."""
+    cands = [b for boxes in dev_gt_boxes_per_image for b in boxes]
+    best, best_s = None, -1.0
+    for c in cands:
+        s = float(np.mean([max(iou(c, g) for g in boxes) for boxes in dev_gt_boxes_per_image]))
+        if s > best_s + 1e-12:
+            best, best_s = c, s
+    return best, best_s
diff --git a/rsna_diag/mi19_mha.py b/rsna_diag/mi19_mha.py
new file mode 100644
index 0000000..6af577e
--- /dev/null
+++ b/rsna_diag/mi19_mha.py
@@ -0,0 +1,168 @@
+"""제한된 MetaIO(.mha) reader (iter_019). SimpleITK가 없는 환경에서 실제 등장하는 3D scalar LOCAL binary MHA만 지원한다.
+
+지원 범위: NDims=3, BinaryData=True, ElementDataFile=LOCAL, ElementNumberOfChannels<=1,
+ElementType in {MET_UCHAR, MET_CHAR, MET_SHORT, MET_USHORT, MET_FLOAT, MET_DOUBLE, MET_INT, MET_UINT},
+CompressedData True(zlib)/False, BinaryDataByteOrderMSB True/False.
+공식 규약: https://docs.itk.org/en/latest/learn/metaio.html
+
+지원하지 않는 header(비3D, non-LOCAL, ASCII data, 다중 채널, 알 수 없는 ElementType)는 MhaError로 실패시킨다(추측 금지).
+DimSize는 [x, y, z] (x가 가장 빠르게 변함)이며, 반환 numpy 배열의 axis 순서는 (z, y, x) (C-order, x가 마지막 축).
+"""
+import zlib
+
+import numpy as np
+
+_TYPE_MAP = {
+    "MET_UCHAR": "u1", "MET_CHAR": "i1",
+    "MET_SHORT": "i2", "MET_USHORT": "u2",
+    "MET_INT": "i4", "MET_UINT": "u4",
+    "MET_FLOAT": "f4", "MET_DOUBLE": "f8",
+}
+
+
+class MhaError(RuntimeError):
+    pass
+
+
+def _parse_value(key, raw):
+    raw = raw.strip()
+    if key in ("NDims", "CompressedDataSize", "ElementNumberOfChannels", "HeaderSize"):
+        return int(raw)
+    if key in ("CompressedData", "BinaryData", "BinaryDataByteOrderMSB"):
+        return raw.strip().lower() == "true"
+    if key in ("DimSize",):
+        return [int(x) for x in raw.split()]
+    if key in ("ElementSpacing", "Offset", "TransformMatrix", "CenterOfRotation"):
+        return [float(x) for x in raw.split()]
+    return raw
+
+
+def parse_header(data):
+    """data(bytes) -> (header dict, payload_offset:int). ElementDataFile != LOCAL 이면 MhaError."""
+    pos = 0
+    header = {}
+    n = len(data)
+    while True:
+        nl = data.find(b"\n", pos)
+        if nl == -1:
+            raise MhaError("header not terminated (no ElementDataFile line found)")
+        line = data[pos:nl].decode("ascii", errors="strict")
+        pos = nl + 1
+        if "=" not in line:
+            if line.strip() == "":
+                continue
+            raise MhaError(f"malformed header line: {line!r}")
+        key, _, val = line.partition("=")
+        key = key.strip()
+        if key == "ElementDataFile":
+            if val.strip() != "LOCAL":
+                raise MhaError(f"unsupported ElementDataFile {val.strip()!r} (only LOCAL supported)")
+            header[key] = "LOCAL"
+            return header, pos
+        header[key] = _parse_value(key, val)
+        if pos >= n:
+            raise MhaError("header not terminated (no ElementDataFile line found)")
+
+
+def read_mha(path_or_bytes):
+    """returns dict: array(z,y,x), dim_size(x,y,z), spacing(x,y,z), offset(x,y,z), direction(3x3 row-major), element_type, raw_header."""
+    data = path_or_bytes if isinstance(path_or_bytes, (bytes, bytearray)) else open(path_or_bytes, "rb").read()
+    hdr, off = parse_header(data)
+    if hdr.get("ObjectType", "Image") != "Image":
+        raise MhaError(f"unsupported ObjectType {hdr.get('ObjectType')!r}")
+    if hdr.get("NDims") != 3:
+        raise MhaError(f"unsupported NDims {hdr.get('NDims')!r} (only 3D supported)")
+    if not hdr.get("BinaryData", False):
+        raise MhaError("only BinaryData=True supported")
+    nchan = hdr.get("ElementNumberOfChannels", 1)
+    if nchan not in (1,):
+        raise MhaError(f"unsupported ElementNumberOfChannels {nchan}")
+    etype = hdr.get("ElementType")
+    if etype not in _TYPE_MAP:
+        raise MhaError(f"unsupported ElementType {etype!r}")
+    dim = hdr.get("DimSize")
+    if not dim or len(dim) != 3:
+        raise MhaError(f"invalid DimSize {dim!r}")
+    nx, ny, nz = dim
+    nvoxels = nx * ny * nz
+    msb = hdr.get("BinaryDataByteOrderMSB", False)
+    dtype_code = (">" if msb else "<") + _TYPE_MAP[etype]
+    dt = np.dtype(dtype_code)
+    payload = data[off:]
+    if hdr.get("CompressedData", False):
+        size = hdr.get("CompressedDataSize")
+        if size is None:
+            raise MhaError("CompressedData=True but no CompressedDataSize")
+        if len(payload) < size:
+            raise MhaError(f"truncated compressed payload: have {len(payload)}, want {size}")
+        raw = zlib.decompress(payload[:size])
+    else:
+        need = nvoxels * dt.itemsize
+        if len(payload) < need:
+            raise MhaError(f"truncated payload: have {len(payload)}, want {need}")
+        raw = payload[:need]
+    expect_bytes = nvoxels * dt.itemsize
+    if len(raw) != expect_bytes:
+        raise MhaError(f"decoded payload size {len(raw)} != expected {expect_bytes} (nx={nx} ny={ny} nz={nz} itemsize={dt.itemsize})")
+    arr = np.frombuffer(raw, dtype=dt).reshape((nz, ny, nx))
+    spacing = hdr.get("ElementSpacing", [1.0, 1.0, 1.0])
+    offset = hdr.get("Offset", [0.0, 0.0, 0.0])
+    tm = hdr.get("TransformMatrix", [1, 0, 0, 0, 1, 0, 0, 0, 1])
+    direction = [tm[0:3], tm[3:6], tm[6:9]]
+    return {"array": arr, "dim_size_xyz": dim, "spacing_xyz": spacing, "offset_xyz": offset,
+            "direction": direction, "element_type": etype, "header": hdr,
+            "anatomical_orientation": hdr.get("AnatomicalOrientation")}
+
+
+def sagittal_axis(direction, anatomical_orientation, tol=0.5):
+    """index axis (0=x,1=y,2=z in DimSize order) that is dominantly aligned with the R/L physical
+    coordinate. `direction[j]` = index axis j's direction cosines in the file's physical frame
+    (MetaIO TransformMatrix row j, per https://docs.itk.org/en/latest/learn/metaio.html); by ITK/MetaIO
+    convention physical component 0 is the L-R axis. Cross-checked against AnatomicalOrientation
+    (index j must be labelled 'R' or 'L') so a single source is never trusted alone. Ambiguous
+    (no axis dominant, or two axes both dominant) or missing/invalid AnatomicalOrientation -> MhaError;
+    callers must treat that as an unsupported orientation, not guess.
+    """
+    if len(direction) != 3 or any(len(row) != 3 for row in direction):
+        raise MhaError(f"invalid direction matrix shape: {direction!r}")
+    col0 = [float(row[0]) for row in direction]
+    absvals = [abs(v) for v in col0]
+    order = sorted(range(3), key=lambda i: -absvals[i])
+    j_best, j_second = order[0], order[1]
+    if absvals[j_best] < tol:
+        raise MhaError(f"no axis dominantly aligned with R-L physical axis: direction column-0 {col0!r}")
+    if absvals[j_second] >= tol:
+        raise MhaError(f"ambiguous sagittal axis (two axes >= {tol} on R-L column): direction column-0 {col0!r}")
+    ao = anatomical_orientation
+    if not ao or not isinstance(ao, str) or len(ao.strip()) != 3:
+        raise MhaError(f"missing/invalid AnatomicalOrientation {ao!r}")
+    ao = ao.strip()
+    if any(ch not in "RLAPSI?" for ch in ao):
+        raise MhaError(f"unsupported AnatomicalOrientation characters {ao!r}")
+    if ao[j_best] not in "RL":
+        raise MhaError(f"direction column-0 dominant axis {j_best} not confirmed R/L by AnatomicalOrientation {ao!r}")
+    sign = 1.0 if col0[j_best] > 0 else -1.0
+    return j_best, sign
+
+
+def axis_layout(j_sag):
+    """returns (array_axis_sag, array_axis_row, array_axis_col) for slicing a (z,y,x) array along
+    index axis j_sag (0=x,1=y,2=z). array axis for index axis i is (2-i) since array shape is (z,y,x).
+    row/col follow the legacy x-sagittal convention (row from the higher remaining index axis,
+    col from the lower one), so j_sag=0 reproduces the original row=z, col=y layout exactly."""
+    remaining = sorted(a for a in range(3) if a != j_sag)
+    idx_col, idx_row = remaining[0], remaining[1]
+    return 2 - j_sag, 2 - idx_row, 2 - idx_col
+
+
+def take_slice(vol, array_axis_sag, array_axis_row, array_axis_col, idx):
+    """2D slice of a 3D array at index `idx` along array_axis_sag, oriented (row=array_axis_row,
+    col=array_axis_col). With 3 axes total, the two remaining axes after removing array_axis_sag
+    are already exactly {array_axis_row, array_axis_col}; only their order can need a transpose."""
+    sl = [slice(None)] * 3
+    sl[array_axis_sag] = idx
+    raw = vol[tuple(sl)]
+    remaining_axes_in_order = [a for a in range(3) if a != array_axis_sag]
+    if remaining_axes_in_order == [array_axis_row, array_axis_col]:
+        return raw
+    return raw.T
diff --git a/rsna_diag/mi19_render.py b/rsna_diag/mi19_render.py
new file mode 100644
index 0000000..c357425
--- /dev/null
+++ b/rsna_diag/mi19_render.py
@@ -0,0 +1,73 @@
+"""iter_019 표시 영상 렌더링: MRI volume -> in-plane spacing 보정 uint8 2D slice, bbox·점 좌표 변환.
+
+- intensity window: volume 전체의 유한한 비배경(0이 아닌) intensity의 1-99 percentile로 clip 후 [0,255] 선형 변환.
+  같은 volume의 모든 slice에 동일 window를 적용한다.
+- 종횡비: in-plane spacing(spacing_y, spacing_z)이 다르면 더 촘촘한 축을 기준으로 다른 축만 배율 조정한다
+  (PIL bilinear). 배율은 반올림 정수 픽셀 크기를 만든다.
+- bbox/point는 native(z,y) 픽셀 좌표(half-open) -> resize 배율 -> geometry.pad_square affine -> canvas_to_norm 순서로 변환한다.
+"""
+import numpy as np
+from PIL import Image
+
+from . import geometry
+from . import mi19_mha as M
+
+
+def volume_window(img_vol):
+    """returns (lo, hi) intensity for 1-99 percentile of finite, nonzero voxels."""
+    flat = img_vol.astype(np.float64).ravel()
+    finite = flat[np.isfinite(flat)]
+    nonzero = finite[finite != 0]
+    if nonzero.size == 0:
+        nonzero = finite
+    lo, hi = np.percentile(nonzero, [1.0, 99.0])
+    if hi <= lo:
+        hi = lo + 1.0
+    return float(lo), float(hi)
+
+
+def to_uint8(slice2d, lo, hi):
+    a = np.clip(slice2d.astype(np.float64), lo, hi)
+    a = (a - lo) / (hi - lo)
+    return np.round(a * 255.0).astype(np.uint8)
+
+
+def resize_scale(spacing_row, spacing_col):
+    """returns (scale_row, scale_col) so that physical in-plane pixel spacing becomes isotropic
+    (= min(spacing_row, spacing_col))."""
+    target = min(spacing_row, spacing_col)
+    return spacing_row / target, spacing_col / target
+
+
+def render_slice(img_vol, sag_idx, axes, spacing_row, spacing_col, lo, hi):
+    """img_vol: (nz,ny,nx). axes=(array_axis_sag,array_axis_row,array_axis_col) from mi19_mha.axis_layout.
+    spacing_row/spacing_col are the physical ElementSpacing values for the row/col index axes
+    (i.e. spacing_xyz[idx_row], spacing_xyz[idx_col] with the same idx_row/idx_col used to build axes).
+    returns (uint8 RGB resized array, scale_row, scale_col, new_shape(h,w))."""
+    array_axis_sag, array_axis_row, array_axis_col = axes
+    native = M.take_slice(img_vol, array_axis_sag, array_axis_row, array_axis_col, sag_idx)
+    u8 = to_uint8(native, lo, hi)
+    nrow, ncol = u8.shape
+    scale_row, scale_col = resize_scale(spacing_row, spacing_col)
+    new_h, new_w = max(1, round(nrow * scale_row)), max(1, round(ncol * scale_col))
+    im = Image.fromarray(u8, mode="L").resize((new_w, new_h), resample=Image.BILINEAR)
+    rgb = np.repeat(np.asarray(im)[:, :, None], 3, axis=2)
+    return rgb, new_h / nrow, new_w / ncol, (new_h, new_w)
+
+
+def native_bbox_to_norm(bbox_rc, scale_row, scale_col, new_shape, pad_top_left_side=None):
+    """bbox_rc: (row0,col0,row1,col1) native half-open. -> resized xyxy -> pad_square -> normalized yxyx[0,1000].
+    pad_top_left_side가 주어지면 그 affine을 쓰고, 없으면 new_shape 기준으로 pad_square를 계산한다(호출측이 동일 affine을 재사용해야 함)."""
+    r0, c0, r1, c1 = bbox_rc
+    x0, y0, x1, y1 = c0 * scale_col, r0 * scale_row, c1 * scale_col, r1 * scale_row
+    h, w = new_shape
+    top, left, side = pad_top_left_side if pad_top_left_side else geometry.pad_offsets(h, w)
+    return geometry.canvas_to_norm([x0, y0, x1, y1], top, left, side)
+
+
+def native_point_to_norm(point_rc, scale_row, scale_col, new_shape, pad_top_left_side=None):
+    r, c = point_rc
+    x, y = c * scale_col, r * scale_row
+    h, w = new_shape
+    top, left, side = pad_top_left_side if pad_top_left_side else geometry.pad_offsets(h, w)
+    return [(y + top) * 1000.0 / side, (x + left) * 1000.0 / side]
