new file mode 100644
index 0000000..68a4e4f
--- /dev/null
+++ b/rsna_diag/migrate.py
@@ -0,0 +1,119 @@
+"""iter_010 -> iter_011 학습 checkpoint 이관 (제한된 부모 checkpoint 가져오기 경로).
+
+protocol이 바뀌면 protocol digest -> train digest가 바뀌므로 단순 digest 교체는 하지 않는다. 대신 아래를 명시적으로 검증한 migration manifest를
+만들고, train.py는 이 manifest와 부모 checkpoint 파일을 다시 검증한 뒤에만 새 run으로 가져온다.
+  - 부모 checkpoint 파일 sha256, 부모 train_digest/protocol digest, 부모 train_config 재계산 digest 일치
+  - 부모 config와 새 config가 protocol_digest·새 입력 digest 외에 동일 (학습 의미 불변)
+  - 부모 protocol이 잠근 manifest/GT sha == 현재 파일 sha (입력 대응), 현재 train ID 파일 == manifest의 train split 전체
+  - checkpoint 위치가 step == epoch*steps_per_epoch + pos 와 일치
+  - old -> new protocol 코드 파일 hash 변경 목록 (변경된 파일만; 학습 의미 불변은 변경 목록과 함께 서술)
+사용: python -m rsna_diag.migrate make --parent-run D --old-protocol P0 --new-protocol P1 --out FILE --semantics-note TXT
+"""
+import argparse
+import hashlib
+import json
+import math
+import os
+import sys
+
+from . import lock_protocol
+
+
+def cfg_digest(cfg):
+    return hashlib.sha256(json.dumps(cfg, sort_keys=True).encode()).hexdigest()
+
+
+def file_sha(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for ch in iter(lambda: f.read(1 << 20), b""):
+            h.update(ch)
+    return h.hexdigest()
+
+
+class MigrationError(RuntimeError):
+    pass
+
+
+NEW_ONLY_KEYS = ("protocol_digest", "train_inputs_digest", "val_inputs_digest")
+
+
+def make(parent_run, old_protocol, new_protocol, out, note, manifest_paths):
+    import torch
+    ck = os.path.join(parent_run, "ckpt_latest.pt")
+    blob = torch.load(ck, map_location="cpu", weights_only=False)
+    tc = json.load(open(os.path.join(parent_run, "train_config.json")))
+    old_dig = lock_protocol.digest_of(old_protocol)
+    new_dig = lock_protocol.verify(new_protocol)
+    if cfg_digest(tc["config"]) != tc["train_digest"] or blob["train_digest"] != tc["train_digest"]:
+        raise MigrationError("parent train digest inconsistent")
+    if blob["protocol_digest"] != old_dig or tc["config"]["protocol_digest"] != old_dig:
+        raise MigrationError("parent protocol digest != old protocol file")
+    old_files = json.load(open(old_protocol))["locked"]["files"]
+    new_files = json.load(open(new_protocol))["locked"]["files"]
+    data_match = {}
+    for f in manifest_paths:
+        cur = file_sha(f)
+        if old_files.get(f) != cur or new_files.get(f) != cur:
+            raise MigrationError(f"{f}: sha differs between old protocol / new protocol / current")
+        data_match[f] = cur
+    spe = math.ceil(tc["config"]["n_train"] / tc["config"]["eff_batch"])
+    if blob["step"] != blob["epoch"] * spe + blob["pos_in_epoch"]:
+        raise MigrationError(f"checkpoint position inconsistent: step {blob['step']} epoch {blob['epoch']} pos {blob['pos_in_epoch']}")
+    changed = {f: {"old": old_files.get(f), "new": new_files.get(f)} for f in sorted(set(old_files) | set(new_files))
+               if old_files.get(f) != new_files.get(f)}
+    man = {"parent_run": parent_run, "parent_ckpt": ck, "parent_ckpt_sha256": file_sha(ck), "parent_ckpt_bytes": os.path.getsize(ck),
+           "parent_step": blob["step"], "parent_epoch": blob["epoch"], "parent_pos_in_epoch": blob["pos_in_epoch"],
+           "parent_train_digest": tc["train_digest"], "parent_protocol_digest": old_dig, "parent_protocol_file": old_protocol,
+           "parent_config": tc["config"], "parent_train_log": os.path.join(parent_run, "train_log.jsonl"),
+           "parent_train_log_sha256_at_migration": file_sha(os.path.join(parent_run, "train_log.jsonl")),
+           "new_protocol_file": new_protocol, "new_protocol_digest": new_dig, "invariant_config_excludes": list(NEW_ONLY_KEYS),
+           "manifest_sha_old_new_current_equal": data_match, "protocol_file_changes_old_to_new": changed,
+           "semantics_note": note}
+    if os.path.exists(out):
+        sys.exit(f"{out} exists (not overwritten)")
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    json.dump(man, open(out, "w"), indent=1)
+    return man
+
+
+def verify_parent(migration_path, new_cfg, new_protocol_digest):
+    """train.py가 호출. 부모 checkpoint를 다시 읽어 manifest와 대조하고 blob을 반환한다."""
+    import torch
+    m = json.load(open(migration_path))
+    if m["new_protocol_digest"] != new_protocol_digest:
+        raise MigrationError("migration manifest was made for a different new protocol")
+    ck = m["parent_ckpt"]
+    if file_sha(ck) != m["parent_ckpt_sha256"]:
+        raise MigrationError("parent checkpoint file changed since migration manifest")
+    blob = torch.load(ck, map_location="cpu", weights_only=False)
+    if (blob["train_digest"] != m["parent_train_digest"] or blob["protocol_digest"] != m["parent_protocol_digest"]
+            or blob["step"] != m["parent_step"] or blob["epoch"] != m["parent_epoch"] or blob["pos_in_epoch"] != m["parent_pos_in_epoch"]):
+        raise MigrationError("parent checkpoint content differs from manifest")
+    old, new = dict(m["parent_config"]), dict(new_cfg)
+    for k in NEW_ONLY_KEYS:
+        old.pop(k, None)
+        new.pop(k, None)
+    if old != new:
+        diff = {k: (old.get(k), new.get(k)) for k in set(old) | set(new) if old.get(k) != new.get(k)}
+        raise MigrationError(f"training semantics differ between parent and new config: {diff}")
+    return blob, m
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    c = sp.add_parser("make")
+    c.add_argument("--parent-run", required=True)
+    c.add_argument("--old-protocol", required=True)
+    c.add_argument("--new-protocol", required=True)
+    c.add_argument("--out", required=True)
+    c.add_argument("--semantics-note", required=True)
+    a = ap.parse_args()
+    make(a.parent_run, a.old_protocol, a.new_protocol, a.out, a.semantics_note,
+         ["results/iter_010/manifests/infer_manifest.jsonl", "results/iter_010/manifests/gt_manifest.json"])
+    print("migration manifest", a.out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/parse.py b/rsna_diag/parse.py
new file mode 100644
index 0000000..5ea4871
--- /dev/null
+++ b/rsna_diag/parse.py
@@ -0,0 +1,170 @@
+"""생성 suffix 전용 엄격 parser (iter_009).
+
+규칙(계획 5절)
+- suffix만 파싱한다. EOS 없이 끝난 요청은 status='truncated' (내용 오류와 구분).
+- thinking(<unused94> ... <unused95>)을 분리한다. 열리고 닫히지 않으면 'unclosed_thinking'.
+- 답 영역에서 'Final Answer:' 마커를 우선한다. 마커가 없으면 영역 전체에서 완결 JSON 목록이 정확히 하나일 때만 허용(marker_missing 표시).
+- 복수의 서로 다른 최종 목록은 'ambiguous'. 빈 목록은 유효한 미검출.
+- 좌표가 유한 수치, 0..1000, y0<y1 & x0<x1이 아니면 'coord_invalid'. clipping/정렬 구제 없음. 반환 box 전체를 보존한다.
+- 라벨 비어있음/누락은 'schema_error'.
+status 분류: valid_nonempty, valid_empty (유효 출력) / truncated, unclosed_thinking, no_answer, no_json, grammar_error,
+             ambiguous, schema_error, coord_invalid (형식·좌표 실패).
+"""
+import json
+import math
+import re
+
+THINK_OPEN, THINK_CLOSE = "<unused94>", "<unused95>"
+EOT = "<end_of_turn>"
+VALID = ("valid_nonempty", "valid_empty")
+FINAL_RE = re.compile(r"Final Answer\s*:", re.I)
+FENCE_RE = re.compile(r"```(?:json)?", re.I)
+
+
+def _spans(text):
+    """문자열 리터럴을 존중하는 최상위 [...] 균형 구간 목록 [(start, end_exclusive, complete)]."""
+    out, i, n = [], 0, len(text)
+    while i < n:
+        if text[i] == "[":
+            depth, j, in_s, esc = 0, i, False, False
+            while j < n:
+                c = text[j]
+                if in_s:
+                    if esc:
+                        esc = False
+                    elif c == "\\":
+                        esc = True
+                    elif c == '"':
+                        in_s = False
+                else:
+                    if c == '"':
+                        in_s = True
+                    elif c == "[":
+                        depth += 1
+                    elif c == "]":
+                        depth -= 1
+                        if depth == 0:
+                            break
+                j += 1
+            if depth == 0 and j < n:
+                out.append((i, j + 1, True))
+                i = j + 1
+                continue
+            out.append((i, n, False))
+            break
+        i += 1
+    return out
+
+
+def _candidates(region):
+    """region에서 JSON 목록 후보를 찾는다. returns list of dict(kind, value/raw)."""
+    region = FENCE_RE.sub(" ", region)
+    cands = []
+    for s, e, complete in _spans(region):
+        raw = region[s:e]
+        if not complete:
+            if '"box_2d"' in raw or "box_2d" in raw:
+                cands.append({"kind": "grammar_error", "raw": raw})
+            continue
+        try:
+            v = json.loads(raw)
+        except Exception:
+            if "box_2d" in raw:
+                cands.append({"kind": "grammar_error", "raw": raw})
+            continue
+        if isinstance(v, list) and (len(v) == 0 or any(isinstance(x, dict) and "box_2d" in x for x in v)
+                                    or all(isinstance(x, dict) for x in v)):
+            cands.append({"kind": "list", "value": v, "raw": raw})
+    return cands
+
+
+def _entry(e):
+    """returns (box or None, label, problems list)."""
+    prob = []
+    if not isinstance(e, dict) or "box_2d" not in e:
+        return None, None, ["schema:not_object_or_no_box_2d"]
+    b, lab = e["box_2d"], e.get("label")
+    if not isinstance(lab, str) or not lab.strip():
+        prob.append("schema:empty_label")
+    if not (isinstance(b, list) and len(b) == 4 and all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in b)):
+        return None, lab, prob + ["schema:box_2d_not_4_numbers"]
+    if not all(math.isfinite(v) for v in b):
+        return [float(v) if math.isfinite(v) else v for v in b], lab, prob + ["coord:nonfinite"]
+    b = [float(v) for v in b]
+    if any(v < 0 or v > 1000 for v in b):
+        prob.append("coord:out_of_range")
+    if not (b[0] < b[2] and b[1] < b[3]):
+        prob.append("coord:inverted_or_zero_area")
+    return b, lab, prob
+
+
+def parse_response(raw_suffix, ended_eos):
+    res = {"status": None, "boxes": [], "labels": [], "flags": [], "problems": [], "n_candidates": 0}
+    if not ended_eos:
+        res["status"] = "truncated"
+        return res
+    text = raw_suffix
+    if text.endswith(EOT):
+        text = text[:-len(EOT)]
+    region = text
+    if THINK_OPEN in text or THINK_CLOSE in text:
+        res["flags"].append("thinking_present")
+        if THINK_CLOSE not in text:
+            res["status"] = "unclosed_thinking"
+            return res
+        region = text.split(THINK_CLOSE, 1)[1]
+        if THINK_OPEN in region or THINK_CLOSE in region:
+            res["flags"].append("multiple_thinking_blocks")
+    if not region.strip():
+        res["status"] = "no_answer"
+        return res
+    markers = list(FINAL_RE.finditer(region))
+    if markers:
+        segs = [region[markers[i].end(): markers[i + 1].start() if i + 1 < len(markers) else len(region)]
+                for i in range(len(markers))]
+    else:
+        res["flags"].append("marker_missing")
+        segs = [region]
+    if "```" in region:
+        res["flags"].append("fenced")
+    all_c = []
+    for sgm in segs:
+        all_c += _candidates(sgm)
+    res["n_candidates"] = len(all_c)
+    if not all_c:
+        res["status"] = "no_json"
+        return res
+    if any(c["kind"] == "grammar_error" for c in all_c):
+        res["status"] = "grammar_error"
+        return res
+    uniq = {json.dumps(c["value"], sort_keys=True) for c in all_c}
+    if len(uniq) > 1:
+        res["status"] = "ambiguous"
+        return res
+    if len(all_c) > 1:
+        res["flags"].append("repeated_identical_final")
+    val = all_c[0]["value"]
+    res["raw_list"] = val
+    probs = []
+    for e in val:
+        b, lab, p = _entry(e)
+        res["boxes"].append(b)
+        res["labels"].append(lab)
+        probs += p
+    res["problems"] = probs
+    if any(p.startswith("schema") for p in probs):
+        res["status"] = "schema_error"
+    elif any(p.startswith("coord") for p in probs):
+        res["status"] = "coord_invalid"
+    else:
+        res["status"] = "valid_nonempty" if val else "valid_empty"
+    return res
+
+
+def duplicates(boxes):
+    seen, d = set(), 0
+    for b in boxes:
+        t = tuple(b)
+        d += t in seen
+        seen.add(t)
+    return d
