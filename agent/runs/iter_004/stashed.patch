+++ b/run_context_pilot.py
@@ -0,0 +1,283 @@
+"""iter_003 context pilot 추론: Yes/No 제한 답변 likelihood scoring + 짧은 greedy 생성 확인.
+
+- 입력은 build_context_manifest.py가 만든 requests.jsonl (labels.json은 읽지 않는다).
+- m(X) = log P("Yes"|X,q) - log P("No"|X,q). "Yes"/"No"는 각각 단일 token임을 실행 시 검증하고,
+  단일 token이면 마지막 위치 logits 한 번의 forward가 전체 continuation의 정확한 log-prob이다.
+- 일부 입력은 prompt+candidate를 이어 붙인 독립 teacher-forced forward로 같은 값을 다시 계산해 대조하고,
+  '<end_of_turn>'까지 포함한 2-token continuation 점수도 보조로 기록한다.
+- 한 GPU·한 프로세스. CUDA_VISIBLE_DEVICES가 이미 지정돼 있으면 그대로 쓰고, 없을 때만 여유 메모리가
+  가장 큰 GPU 하나를 스크립트 안에서 지정한다.
+- 누적 device-minutes(로딩 포함)를 budget.json에 기록하고 55분에서 중단한다. 재실행 시 같은 config와
+  input_sha256의 완료 결과만 재사용한다.
+
+실행 예: python research/run_context_pilot.py --out research/results/iter_003 --max-requests 8
+"""
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+T0 = time.time()
+
+
+def pick_gpu():
+    if os.environ.get("CUDA_VISIBLE_DEVICES"):
+        return os.environ["CUDA_VISIBLE_DEVICES"], "preset"
+    q = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.free", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True, check=True).stdout
+    free = [tuple(int(x) for x in line.split(",")) for line in q.strip().splitlines()]
+    idx = max(free, key=lambda t: t[1])[0]
+    os.environ["CUDA_VISIBLE_DEVICES"] = str(idx)
+    return str(idx), f"auto(free MiB={dict(free)})"
+
+
+GPU, GPU_HOW = pick_gpu()
+os.environ.setdefault("HF_HOME", "/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache")
+os.environ["HF_HUB_OFFLINE"] = "1"
+
+import torch  # noqa: E402
+import transformers  # noqa: E402
+from PIL import Image  # noqa: E402
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from context_pilot import data as D  # noqa: E402
+
+MODEL_ID = "google/medgemma-1.5-4b-it"
+SCORER_VERSION = 2  # 1: 예비 실행(보조 continuation = 답+<end_of_turn>), 2: 답+\n+<end_of_turn>
+GEN_PREFIX = [105, 4368, 107]  # "<start_of_turn>model\n"
+
+
+def sha(s):
+    return hashlib.sha256(s.encode()).hexdigest()
+
+
+class Scorer:
+    def __init__(self):
+        torch.manual_seed(0)
+        self.proc = transformers.AutoProcessor.from_pretrained(MODEL_ID)
+        self.model = transformers.AutoModelForImageTextToText.from_pretrained(
+            MODEL_ID, dtype=torch.bfloat16, device_map="cuda:0")
+        self.model.eval()
+        tok = self.proc.tokenizer
+        self.cand = {}
+        for name, text in D.CANDIDATES.items():
+            ids = tok.encode(text, add_special_tokens=False)
+            self.cand[name] = ids
+        assert self.cand["Yes"] != self.cand["No"]
+        self.single = all(len(v) == 1 for v in self.cand.values())
+        self.eot = tok.convert_tokens_to_ids("<end_of_turn>")
+        self.nl = tok.encode("\n", add_special_tokens=False)
+        assert len(self.nl) == 1
+        self.nl = self.nl[0]
+        self.image_token_id = self.model.config.image_token_id
+        self._images = {}
+
+    def env(self):
+        ip = self.proc.image_processor
+        return {"model_id": MODEL_ID, "commit_hash": getattr(self.model.config, "_commit_hash", None),
+                "name_or_path": self.model.config._name_or_path, "transformers": transformers.__version__,
+                "torch": torch.__version__, "gpu_visible": GPU, "gpu_select": GPU_HOW,
+                "gpu_name": torch.cuda.get_device_name(0), "dtype": str(self.model.dtype),
+                "processor_class": type(self.proc).__name__, "image_processor_class": type(ip).__name__,
+                "image_processor": {k: (v if isinstance(v, (int, float, str, bool, list, dict, type(None))) else str(v))
+                                    for k, v in ip.to_dict().items()},
+                "image_seq_length": getattr(self.proc, "image_seq_length", None),
+                "candidate_token_ids": self.cand, "single_token_candidates": self.single,
+                "eot_id": self.eot, "image_token_id": self.image_token_id}
+
+    def image(self, p):
+        if p not in self._images:
+            self._images[p] = Image.open(p).convert("RGB")
+        return self._images[p]
+
+    def inputs(self, req):
+        content = [{"type": "text", "text": D.PROMPT_INTRO.format(seq_text=D.SEQ_TEXT[req["sequence"]])}]
+        content += [{"type": "image", "image": self.image(p)} for p in req["slice_png"]]
+        content.append({"type": "text", "text": D.PROMPT_QUESTION})
+        inp = self.proc.apply_chat_template([{"role": "user", "content": content}], add_generation_prompt=True,
+                                            tokenize=True, return_dict=True, return_tensors="pt")
+        ids = inp["input_ids"][0].tolist()
+        assert ids[-3:] == GEN_PREFIX, "assistant prefix 경계 불일치"
+        return {k: (v.to("cuda", dtype=torch.bfloat16) if k == "pixel_values" else v.to("cuda"))
+                for k, v in inp.items()}
+
+    @torch.inference_mode()
+    def score(self, inp):
+        if not self.single:
+            raise NotImplementedError("다중 token 후보는 teacher_forced 경로를 사용해야 함")
+        out = self.model(**inp, logits_to_keep=1)
+        lp = torch.log_softmax(out.logits[0, -1].float(), -1)
+        ly, ln = lp[self.cand["Yes"][0]].item(), lp[self.cand["No"][0]].item()
+        top = torch.topk(lp, 5)
+        tok = self.proc.tokenizer
+        return {"lp_yes": ly, "lp_no": ln, "m": ly - ln, "p_yes_plus_no": float(torch.exp(lp[self.cand["Yes"][0]])
+                                                                                 + torch.exp(lp[self.cand["No"][0]])),
+                "top5": [[int(i), tok.decode([int(i)]), float(v)] for v, i in zip(top.values, top.indices)]}
+
+    @torch.inference_mode()
+    def teacher_forced(self, inp, cont):
+        """prompt + cont 전체를 한 번에 forward하고 cont token들의 log-prob 합을 계산 (독립 경로)."""
+        ids = inp["input_ids"]
+        add = torch.tensor([cont], device=ids.device, dtype=ids.dtype)
+        full = dict(inp)
+        full["input_ids"] = torch.cat([ids, add], 1)
+        full["attention_mask"] = torch.cat([inp["attention_mask"], torch.ones_like(add)], 1)
+        if "token_type_ids" in inp:
+            full["token_type_ids"] = torch.cat([inp["token_type_ids"], torch.zeros_like(add)], 1)
+        logits = self.model(**full).logits[0].float()
+        L = ids.shape[1]
+        total = 0.0
+        for j, t in enumerate(cont):
+            total += torch.log_softmax(logits[L - 1 + j], -1)[t].item()
+        return total
+
+    @torch.inference_mode()
+    def generate(self, inp, n=8):
+        seq = self.model.generate(**inp, do_sample=False, max_new_tokens=n)
+        new = seq[0, inp["input_ids"].shape[1]:].tolist()
+        tok = self.proc.tokenizer
+        return {"gen_ids": new, "gen_text_raw": tok.decode(new, skip_special_tokens=False),
+                "gen_text": tok.decode(new, skip_special_tokens=True).strip(),
+                "gen_hit_max": len(new) >= n and self.eot not in new}
+
+
+def parse_gen(t):
+    w = t.strip().strip(".,!:;*\"' ").lower()
+    first = w.split()[0].strip(".,!:;*\"'") if w else ""
+    return {"yes": "Yes", "no": "No"}.get(first, "unparsed")
+
+
+def load_budget(path):
+    return json.loads(path.read_text()) if path.exists() else {"limit_device_minutes": 55, "runs": []}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--max-requests", type=int, default=None, help="예비 실행용 요청 수 상한")
+    ap.add_argument("--budget-min", type=float, default=55.0)
+    ap.add_argument("--note", default="")
+    a = ap.parse_args()
+    out = a.out
+    cfg_sha = hashlib.sha256((out / "config.json").read_bytes()).hexdigest()
+    reqs = [json.loads(l) for l in open(out / "requests.jsonl")]
+    pred_path = out / "predictions.jsonl"
+    done = {}
+    if pred_path.exists():
+        for l in open(pred_path):
+            r = json.loads(l)
+            if (r.get("status") == "ok" and r.get("config_sha256") == cfg_sha
+                    and r.get("scorer_version") == SCORER_VERSION):
+                done[(r["id"], r["input_sha256"])] = r
+    budget_path = out / "budget.json"
+    budget = load_budget(budget_path)
+    used_before = sum(r["device_minutes"] for r in budget["runs"])
+    if used_before >= a.budget_min:
+        print(f"예산 소진: {used_before:.2f} device-min", flush=True)
+        return
+
+    # 요청 순서: T1CE 먼저 (예산 축소 규칙이 T1CE만 실행이므로), 예비 실행은 다양한 image 수를 포함
+    def key(r):
+        return (r["sequence"] != "t1c", r["case"], r["kind"] != "concat", r["id"])
+    reqs.sort(key=key)
+    if a.max_requests:
+        pilot_ids = []
+        by_n = {}
+        for r in reqs:
+            by_n.setdefault(r["n_images"], []).append(r)
+        for n in sorted(by_n):
+            pilot_ids += by_n[n][:2]
+        reqs = pilot_ids[:a.max_requests]
+    todo = [r for r in reqs if (r["id"], r["input_sha256"]) not in done]
+
+    sc = Scorer()
+    env = sc.env()
+    (out / f"env_{int(T0)}.json").write_text(json.dumps(env, indent=1, ensure_ascii=False))
+    t_load = time.time() - T0
+    print(f"GPU {GPU} ({GPU_HOW}) loaded in {t_load:.1f}s; todo {len(todo)} / {len(reqs)}; "
+          f"budget used before {used_before:.2f} min", flush=True)
+
+    verify_ids = {r["id"] for r in reqs if r["kind"] == "concat" and r["packet"] in ("E", "N") and r["cond"] in ("P0", "P6")}
+    gen_ids = {r["id"] for r in reqs if r["kind"] == "concat" and r["packet"] in ("E", "N") and r["cond"] == "P0"}
+    timings = []
+    reduced = False
+    stopped = None
+    fout = open(pred_path, "a")
+    for i, r in enumerate(todo):
+        elapsed = (time.time() - T0) / 60
+        if used_before + elapsed >= a.budget_min:
+            stopped = f"budget reached at {used_before + elapsed:.2f} device-min"
+            break
+        if i == 10 and not a.max_requests and not reduced:
+            # 결과를 보지 않고 속도만으로 남은 비용 추정 (image 수에 선형)
+            per_img = sum(t for t, _ in timings) / max(1, sum(n for _, n in timings))
+            rest = sum(x["n_images"] for x in todo[10:]) * per_img / 60
+            extra = (len(gen_ids) + len(verify_ids) * 3) * 0.5 / 60
+            proj = used_before + elapsed + rest + extra
+            print(f"projected total {proj:.2f} device-min (per image {per_img:.3f}s)", flush=True)
+            if proj > a.budget_min:
+                todo = todo[:10] + [x for x in todo[10:] if x["sequence"] == "t1c"]
+                reduced = True
+                print("예산 축소 규칙 적용: T1CE만 실행", flush=True)
+        rec = {k: r[k] for k in ("id", "case", "sequence", "kind", "cond", "packet", "slice_ids", "n_images",
+                                  "input_sha256")}
+        rec["config_sha256"] = cfg_sha
+        rec["scorer_version"] = SCORER_VERSION
+        try:
+            torch.cuda.reset_peak_memory_stats()
+            torch.cuda.synchronize()
+            t = time.time()
+            inp = sc.inputs(r)
+            s = sc.score(inp)
+            torch.cuda.synchronize()
+            dt = time.time() - t
+            rec.update(s)
+            rec.update({"status": "ok", "latency_s": dt, "peak_mem_gb": torch.cuda.max_memory_allocated() / 2**30,
+                        "n_input_tokens": int(inp["input_ids"].shape[1]),
+                        "n_image_tokens": int((inp["input_ids"] == sc.image_token_id).sum()),
+                        "pixel_values_shape": list(inp["pixel_values"].shape),
+                        "pred": "Yes" if s["m"] > 0 else "No"})
+            timings.append((dt, r["n_images"]))
+            if r["id"] in verify_ids:
+                ty = sc.teacher_forced(inp, sc.cand["Yes"])
+                tn = sc.teacher_forced(inp, sc.cand["No"])
+                # 보조: 예비 생성에서 관찰된 종결 형태 "<답>\n<end_of_turn>"까지 포함한 continuation
+                ty2 = sc.teacher_forced(inp, sc.cand["Yes"] + [sc.nl, sc.eot])
+                tn2 = sc.teacher_forced(inp, sc.cand["No"] + [sc.nl, sc.eot])
+                rec["verify"] = {"tf_lp_yes": ty, "tf_lp_no": tn, "tf_m": ty - tn,
+                                 "abs_diff_m_vs_lastlogit": abs((ty - tn) - s["m"]),
+                                 "lp_yes_nl_eot": ty2, "lp_no_nl_eot": tn2, "m_with_nl_eot": ty2 - tn2}
+            if r["id"] in gen_ids:
+                g = sc.generate(inp, 8)
+                g["gen_parsed"] = parse_gen(g["gen_text"])
+                g["gen_agrees_with_score"] = g["gen_parsed"] == rec["pred"]
+                rec["generation"] = g
+        except torch.cuda.OutOfMemoryError as e:
+            rec.update({"status": "oom", "error": str(e)[:300]})
+            torch.cuda.empty_cache()
+        except Exception as e:  # noqa: BLE001
+            rec.update({"status": "error", "error": repr(e)[:300]})
+        fout.write(json.dumps(rec, ensure_ascii=False) + "\n")
+        fout.flush()
+        if i % 20 == 0 or rec["status"] != "ok":
+            print(f"[{i + 1}/{len(todo)}] {r['id']} n_img={r['n_images']} {rec['status']} "
+                  f"{rec.get('latency_s', 0):.2f}s mem={rec.get('peak_mem_gb', 0):.1f}GB", flush=True)
+    fout.close()
+    dm = (time.time() - T0) / 60
+    budget["runs"].append({"start": T0, "device_minutes": dm, "n_attempted": i + 1 if todo else 0,
+                           "n_todo": len(todo), "load_s": t_load, "reduced_t1ce_only": reduced,
+                           "stopped": stopped, "max_requests": a.max_requests, "note": a.note, "gpu": GPU})
+    budget_path.write_text(json.dumps(budget, indent=1))
+    if timings:
+        print(f"mean latency {sum(t for t, _ in timings) / len(timings):.3f}s, per image "
+              f"{sum(t for t, _ in timings) / sum(n for _, n in timings):.3f}s, max peak mem "
+              f"{torch.cuda.max_memory_allocated() / 2**30:.2f}GB", flush=True)
+    print(f"run device-minutes {dm:.2f}, total {used_before + dm:.2f}; stopped={stopped}; reduced={reduced}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
