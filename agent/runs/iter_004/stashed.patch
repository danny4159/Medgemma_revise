@@ -0,0 +1,176 @@
+"""iter_003 context pilot: 추론 전 manifest·config·slice PNG·요청 목록·평가 label을 만든다 (CPU).
+
+모델 입력(requests.jsonl: slice 순서와 sequence만)과 평가 label(labels.json)을 분리해 저장한다.
+실행: python research/build_context_manifest.py --out research/results/iter_003
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+from context_pilot import data as D
+
+SEED = 0  # 선택 규칙은 결정적이며 랜덤을 쓰지 않는다. 기록용.
+
+
+def overlay(rgb, mask):
+    o = rgb.astype(np.float32).copy()
+    m = mask > 0
+    o[m] = 0.55 * o[m] + 0.45 * np.array([255, 0, 0], np.float32)
+    return o.astype(np.uint8)
+
+
+def save_montage(path, tiles, labels):
+    from PIL import ImageDraw
+    h, w = tiles[0].shape[:2]
+    cols = 5
+    rows = (len(tiles) + cols - 1) // cols
+    canvas = Image.new("RGB", (cols * w, rows * (h + 14)), (0, 0, 0))
+    dr = ImageDraw.Draw(canvas)
+    for i, (t, lab) in enumerate(zip(tiles, labels)):
+        r, c = divmod(i, cols)
+        canvas.paste(Image.fromarray(t), (c * w, r * (h + 14) + 14))
+        dr.text((c * w + 2, r * (h + 14) + 1), lab, fill=(255, 255, 0))
+    canvas.save(path)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args()
+    out = a.out
+    (out / "slices").mkdir(parents=True, exist_ok=True)
+    (out / "montage").mkdir(parents=True, exist_ok=True)
+
+    config = {
+        "iteration": "iter_003", "seed": SEED, "cases": D.CASES, "sequences": D.SEQS,
+        "seq_text": D.SEQ_TEXT, "prompt_intro": D.PROMPT_INTRO, "prompt_question": D.PROMPT_QUESTION,
+        "candidates": D.CANDIDATES, "conditions": D.CONDITIONS,
+        "selection_rule": {
+            "E": "seg>0 면적 상위 2 slice (동률 z 오름차순). 전체 종양 annotation 합집합(NCR/ED/ET)",
+            "empty_eligibility": f"z <= zmin-{D.EMPTY_MIN_GAP} 또는 z >= zmax+{D.EMPTY_MIN_GAP}, "
+                                 f"비영점 영상 면적 >= {D.EMPTY_MIN_AREA_FRAC} x volume 최대",
+            "empty_ranking": "|slice 영상 면적 - E 두 slice 평균 영상 면적| 오름차순, 동률 z 오름차순",
+            "empty_assignment": "순위 1..8을 N,R,A,B,N,R,A,B로 round-robin 배정",
+            "insufficient": "적격 8개 미만이면 case-sequence 제외 (기준 완화 없음)",
+        },
+        "orientation": "nib.as_closest_canonical(RAS) 후 axial slice.T[::-1, ::-1] (radiological, anterior 위)",
+        "intensity": "case-sequence별 비영점 voxel 1/99 percentile window -> uint8, RGB 복제",
+        "image_size_to_model": "240x240 PNG, processor가 896x896로 resize (resample=2 bilinear, pan-and-scan 없음)",
+        "iaf": {"gamma": D.IAF_GAMMA, "space": "[0,1] RGB, 240x240 native", "rule": "현재 anchor와 mean L1 > gamma이면 유지 후 anchor 갱신"},
+        "model_id": "google/medgemma-1.5-4b-it", "dtype": "bfloat16",
+        "budget_device_minutes": 55,
+        "budget_reduction_rule": "예비 속도로 추정한 총 비용이 예산 초과면 전체를 T1CE만 실행, 그것도 초과면 미완료 기록 후 중단",
+        "decision_rule": "m = logP(Yes) - logP(No) > 0 이면 Yes",
+    }
+
+    manifest = {"case_sequences": [], "excluded_case_sequences": []}
+    requests, labels = [], {}
+    for case in D.CASES:
+        for seq in D.SEQS:
+            vol, seg, info = D.load_canonical(case, seq)
+            lo, hi = D.window_params(vol)
+            sel, records, meta = D.select_slices(vol, seg)
+            cs = {"case": case, "sequence": seq,
+                  "source": {k: {"path": str(D.src_path(case, k)), "sha256": D.sha256_file(D.src_path(case, k))}
+                             for k in (seq, "seg")},
+                  "orientation": info, "window_lo_hi": [lo, hi], **meta, "z_records": records}
+            if sel is None:
+                cs["excluded_reason"] = f"적격 empty slice {meta['n_eligible_empty']}개 < 8"
+                manifest["excluded_case_sequences"].append(cs)
+                continue
+            slices = {}
+            packets = {}
+            for role, zs in sel.items():
+                packets[role] = []
+                for z in zs:
+                    sid = f"{case}_{seq}_z{z:03d}"
+                    rgb = D.to_rgb_uint8(D.display_2d(vol, z), lo, hi)
+                    msk = D.display_2d(seg, z)
+                    p = out / "slices" / f"{sid}.png"
+                    Image.fromarray(rgb).save(p)
+                    slices[sid] = {"z": z, "role": role, "png": str(p), "pixel_sha256": D.sha256_array(rgb),
+                                   "seg_area": int((msk > 0).sum()), "img_area_nonzero": int((D.display_2d(vol, z) > 0).sum()),
+                                   "_rgb": rgb, "_mask": msk}
+                    packets[role].append(sid)
+            order = [s for r in ["E", "N", "R", "A", "B"] for s in packets[r]]
+            save_montage(out / "montage" / f"{case}_{seq}.png",
+                         [overlay(slices[s]["_rgb"], slices[s]["_mask"]) for s in order],
+                         [f"{slices[s]['role']} z{slices[s]['z']} seg{slices[s]['seg_area']}" for s in order])
+
+            def add(kind, packet, cond, sids, extra=None):
+                rid = f"{case}|{seq}|{kind}|{packet}|{cond}"
+                h = D.sha256_array(np.frombuffer(json.dumps(
+                    [D.PROMPT_INTRO.format(seq_text=D.SEQ_TEXT[seq]), D.PROMPT_QUESTION]
+                    + [slices[s]["pixel_sha256"] for s in sids]).encode(), np.uint8))
+                r = {"id": rid, "case": case, "sequence": seq, "kind": kind, "cond": cond,
+                     "packet": packet, "slice_ids": sids, "slice_png": [slices[s]["png"] for s in sids],
+                     "n_images": len(sids), "input_sha256": h}
+                if extra:
+                    r.update(extra)
+                requests.append(r)
+                # 평가 label은 모델 입력과 분리 (E=Yes, N=No, R=reference·No)
+                labels[rid] = {"packet_role": packet, "gold": "Yes" if packet == "E" else "No"}
+
+            for s_role in ["E", "N", "R"]:
+                for cond in D.CONDITIONS:
+                    add("concat", s_role, cond, D.build_sequence(cond, packets, s_role))
+            for sid, sv in slices.items():
+                add("single", sv["role"], sid, [sid])
+            iaf_rec = []
+            for s_role in ["E", "N"]:
+                for cond in D.CONDITIONS:
+                    sids = D.build_sequence(cond, packets, s_role)
+                    keep = D.iaf_keep([slices[s]["_rgb"].astype(np.float32) / 255.0 for s in sids])
+                    kept = [sids[i] for i in keep]
+                    rec = {"packet": s_role, "cond": cond, "n_in": len(sids), "n_kept": len(kept),
+                           "kept": kept, "evidence_kept": sum(s in packets[s_role] for s in kept),
+                           "evidence_in": len(packets[s_role]), "identical_to_concat": kept == sids}
+                    iaf_rec.append(rec)
+                    if cond == "P0" and kept == sids:
+                        continue  # P0에서 제거가 없으면 concat P0 점수를 그대로 사용 (추가 GPU 없음)
+                    add("iaf", s_role, cond, kept, {"iaf_n_in": len(sids)})
+            for s_role in ["E", "N"]:  # 동일 입력 반복 오차 측정용
+                for cond in ["P1", "P3"]:
+                    add("repeat", s_role, cond, D.build_sequence(cond, packets, s_role))
+            # 인접 slice mean L1 (IAF 해석용)
+            l1 = {}
+            for r1 in packets:
+                for r2 in packets:
+                    for s1 in packets[r1]:
+                        for s2 in packets[r2]:
+                            if s1 < s2:
+                                l1[f"{s1}~{s2}"] = float(np.abs(slices[s1]["_rgb"].astype(np.float32)
+                                                                 - slices[s2]["_rgb"].astype(np.float32)).mean() / 255.0)
+            for sv in slices.values():
+                sv.pop("_rgb")
+                sv.pop("_mask")
+            cs.update({"packets": packets, "slices": slices, "iaf": iaf_rec, "pairwise_mean_l1": l1})
+            manifest["case_sequences"].append(cs)
+
+    included_cases = {c["case"] for c in manifest["case_sequences"]}
+    manifest["gpu_go"] = all(c in included_cases for c in D.CASES)
+    (out / "config.json").write_text(json.dumps(config, indent=1, ensure_ascii=False))
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=1, ensure_ascii=False))
+    (out / "labels.json").write_text(json.dumps(labels, indent=1, ensure_ascii=False))
+    with open(out / "requests.jsonl", "w") as f:
+        for r in requests:
+            f.write(json.dumps(r, ensure_ascii=False) + "\n")
+    kinds = {}
+    for r in requests:
+        kinds[r["kind"]] = kinds.get(r["kind"], 0) + 1
+    print("case-seq 포함", len(manifest["case_sequences"]), "제외", len(manifest["excluded_case_sequences"]),
+          "gpu_go", manifest["gpu_go"])
+    print("requests", len(requests), kinds, "images total", sum(r["n_images"] for r in requests))
+    for c in manifest["case_sequences"]:
+        print(c["case"], c["sequence"], "annot", c["annot_z_range"], "eligible", c["n_eligible_empty"],
+              {k: [c["slices"][s]["z"] for s in v] for k, v in c["packets"].items()},
+              "IAF evidence kept", [(r["packet"], r["cond"], r["evidence_kept"], r["n_kept"], r["n_in"]) for r in c["iaf"]])
+    for c in manifest["excluded_case_sequences"]:
+        print("EXCLUDED", c["case"], c["sequence"], c["excluded_reason"])
+
+
+if __name__ == "__main__":
+    main()
