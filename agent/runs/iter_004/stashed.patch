@@ -0,0 +1,131 @@
+"""iter_003 context pilot CPU 검증 (GPU·모델 없음).
+
+manifest 기반: 영상-mask 정렬, 근거 픽셀 불변, packet 비중복, 조건별 영상 수, 순서 변경 multiset 보존,
+반복 slice multiplicity, IAF 수동 예제, case 단위 집계·기권 분모.
+실행: python research/test_context_pilot.py --out research/results/iter_003
+"""
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+import analyze_context_pilot as A
+from context_pilot import data as D
+
+EXPECTED_N = {"P0": 2, "P1": 4, "P2": 4, "P3": 4, "P4": 6, "P5": 6, "P6": 10}
+
+
+def test_alignment(man):
+    for cs in man["case_sequences"]:
+        o = cs["orientation"]
+        assert o["orig_affine_equal"] and o["canon_affine_equal"] and o["canon_axcodes"] == ["R", "A", "S"]
+        vol, seg, _ = D.load_canonical(cs["case"], cs["sequence"])
+        for sid, sv in cs["slices"].items():
+            z = sv["z"]
+            m2 = D.display_2d(seg, z)
+            # 표시 변환 전후 annotation 면적 동일 (보간 없음)
+            assert int((m2 > 0).sum()) == int((seg[:, :, z] > 0).sum()) == sv["seg_area"]
+            if sv["role"] == "E":
+                assert sv["seg_area"] > 0
+                img = D.display_2d(vol, z)
+                inside = (img[m2 > 0] > 0).mean()
+                assert inside > 0.95, f"{sid}: mask 영역의 {inside:.3f}만 비영점 영상 위"
+            else:
+                assert sv["seg_area"] == 0
+                zmin, zmax = cs["annot_z_range"]
+                assert z <= zmin - D.EMPTY_MIN_GAP or z >= zmax + D.EMPTY_MIN_GAP
+                assert sv["img_area_nonzero"] >= D.EMPTY_MIN_AREA_FRAC * cs["img_area_max"]
+            # 저장된 PNG가 manifest hash와 같다
+            arr = np.array(Image.open(sv["png"]).convert("RGB"))
+            assert D.sha256_array(arr) == sv["pixel_sha256"], sid
+        # 원본 LPS 배열과 canonical 배열의 관계: x,y 뒤집기만 (보간 없음)
+        import nibabel as nib
+        raw = np.asarray(nib.load(str(D.src_path(cs["case"], "seg"))).dataobj)
+        assert np.array_equal(raw[::-1, ::-1, :], seg.astype(raw.dtype))
+    return "alignment"
+
+
+def test_packets(man):
+    for cs in man["case_sequences"]:
+        allz = [cs["slices"][s]["z"] for r in cs["packets"] for s in cs["packets"][r]]
+        assert len(allz) == len(set(allz)) == 10, "packet 사이 source slice 중복"
+        assert all(len(v) == 2 for v in cs["packets"].values())
+    return "packets"
+
+
+def test_requests(man, reqs):
+    by = {r["id"]: r for r in reqs}
+    for cs in man["case_sequences"]:
+        c, s = cs["case"], cs["sequence"]
+        P = cs["packets"]
+        for S in ["E", "N", "R"]:
+            for cond, n in EXPECTED_N.items():
+                r = by[f"{c}|{s}|concat|{S}|{cond}"]
+                assert r["n_images"] == n == len(r["slice_ids"])
+                # 근거 packet 픽셀 불변: S slice가 정해진 위치에 같은 파일/hash로 들어간다
+                assert r["slice_ids"][-2:] == P[S] if cond != "P3" else r["slice_ids"][:2] == P[S]
+                assert Counter(r["slice_ids"])[P[S][0]] == 1
+            p1, p3 = by[f"{c}|{s}|concat|{S}|P1"], by[f"{c}|{s}|concat|{S}|P3"]
+            assert Counter(p1["slice_ids"]) == Counter(p3["slice_ids"]) and p1["slice_ids"] != p3["slice_ids"]
+            p4 = by[f"{c}|{s}|concat|{S}|P4"]
+            assert all(Counter(p4["slice_ids"])[a] == 2 for a in P["A"])
+            p6 = by[f"{c}|{s}|concat|{S}|P6"]
+            assert all(Counter(p6["slice_ids"])[a] == 2 for a in P["A"] + P["B"])
+            # 조건마다 S 자리만 바뀌고 context는 같다 (E/N/R 교체 시 context 동일)
+            for cond in EXPECTED_N:
+                rE = by[f"{c}|{s}|concat|E|{cond}"]["slice_ids"]
+                rS = by[f"{c}|{s}|concat|{S}|{cond}"]["slice_ids"]
+                assert [x for x in rE if x not in P["E"]] == [x for x in rS if x not in P[S]]
+        # 모델 입력에 label/role 문자열이 들어가지 않는다 (요청에는 slice 경로와 sequence만 사용)
+        assert "E" not in D.PROMPT_INTRO.split() and "contiguous block" not in D.PROMPT_INTRO
+    assert len({r["id"] for r in reqs}) == len(reqs)
+    return "requests"
+
+
+def test_iaf_manual():
+    a = np.zeros((4, 4, 3), np.float32)
+    b = a + 0.04       # anchor(a)와 L1 0.04 -> 제거
+    c = a + 0.10       # anchor(a)와 0.10 -> 유지, 새 anchor
+    d = c + 0.03       # anchor(c)와 0.03 -> 제거 (a와는 0.13이지만 현재 anchor와만 비교)
+    e = a.copy()       # anchor(c)와 0.10 -> 유지 (비인접 중복은 제거하지 않음)
+    assert D.iaf_keep([a, b, c, d, e]) == [0, 2, 4]
+    assert D.iaf_keep([]) == [] and D.iaf_keep([a]) == [0]
+    return "iaf_manual"
+
+
+def test_aggregation():
+    # case 단위 집계: case A는 두 sequence, case B는 한 sequence -> sequence 평균 후 case 평균
+    per = {("A", "t1c"): {"x": 1.0}, ("A", "t2w"): {"x": 3.0}, ("B", "t1c"): {"x": 10.0}}
+    g = A.case_aggregate(per, ["x"])
+    assert g["per_case"]["A"]["x"] == 2.0 and g["case_mean"]["x"] == 6.0 and g["n_cases"] == 2
+    # 기권 분모: 전체 분모 기준 정답 비율과 선택적 오류를 함께
+    conc = {"E": {"P1": 1.0, "P3": -1.0}, "N": {"P1": -2.0, "P3": -0.5}}
+    ab = A.abstain_p13(conc)
+    assert ab["E"] == {"answered": False, "correct": False} and ab["N"] == {"answered": True, "correct": True}
+    s = A.summarize_abstain({("A", "t1c"): ab})
+    assert s["pooled"]["coverage"] == 0.5 and s["pooled"]["selective_error"] == 0.0
+    assert s["pooled"]["correct_over_all"] == 0.5
+    # paired 보정과 지표 계산의 작은 수동 예제
+    sc = {"E": {c: 2.0 for c in A.CONDS}, "N": {c: -1.0 for c in A.CONDS}}
+    sc["E"]["P1"] = -0.5  # flip 1개
+    m = A.cs_metrics(sc, sc)
+    assert m["flips_vs_packet"] == 1 and m["fn_E"] == 1 and abs(m["drift_own_E"] - 2.5 / 6) < 1e-9
+    assert m["worst_ctx_acc"] == 0.5 and abs(m["ba_mean"] - (6 * 1 + 0.5) / 7) < 1e-9
+    return "aggregation"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args()
+    man = json.loads((a.out / "manifest.json").read_text())
+    reqs = [json.loads(l) for l in open(a.out / "requests.jsonl")]
+    done = [test_alignment(man), test_packets(man), test_requests(man, reqs), test_iaf_manual(), test_aggregation()]
+    print("CPU checks PASS:", done)
+
+
+if __name__ == "__main__":
+    main()
