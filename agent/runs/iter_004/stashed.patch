new file mode 100644
index 0000000..61fcd1e
--- /dev/null
+++ b/context_pilot/data.py
@@ -0,0 +1,153 @@
+"""BraTS volume 로딩, slice 선택, packet/조건 구성, IAF. GPU·모델 없음.
+
+- 영상과 seg를 같은 방식(nib.as_closest_canonical, 보간 없는 축 뒤집기/전치)으로 RAS로 바꾼다.
+- 표시 방향은 radiological(환자 오른쪽이 영상 왼쪽, anterior가 위)로 고정한다.
+- intensity는 case-sequence별 비영점 voxel 1/99 percentile을 한 번 정해 모든 slice에 쓴다.
+"""
+import hashlib
+from pathlib import Path
+
+import nibabel as nib
+import numpy as np
+
+BRATS_ROOT = Path("/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache/hub/datasets--obi77--brats23-first-10-examples/"
+                  "snapshots/26e33d5e9644e735f043bd4e0c7759e9dae494ac/ASNR-MICCAI-BraTS2023-GLI-Challenge-TrainingData")
+CASES = ["BraTS-GLI-00000-000", "BraTS-GLI-00002-000", "BraTS-GLI-00005-000"]
+SEQS = ["t1c", "t2w"]
+SEQ_TEXT = {"t1c": "post-contrast T1-weighted (T1CE)", "t2w": "T2-weighted (T2)"}
+EMPTY_MIN_GAP = 5          # annotation z 범위에서 최소 거리
+EMPTY_MIN_AREA_FRAC = 0.25  # volume 최대 비영점 면적 대비
+EMPTY_ROLES = ["N", "R", "A", "B"]
+IAF_GAMMA = 0.05
+# 모든 입력에 같은 문장을 쓴다 (packet 역할·파일명·GT·case는 넣지 않음, contiguous라고 하지 않음)
+PROMPT_INTRO = ("The following images are axial slices from a {seq_text} brain MRI of one patient. "
+                "The slices are not necessarily contiguous, and the same slice may appear more than once.")
+PROMPT_QUESTION = ("Is there a tumor-associated abnormality visible in these images? "
+                   "Answer with only Yes or No.")
+CANDIDATES = {"Yes": "Yes", "No": "No"}
+CONDITIONS = {  # 조건 -> packet 순서 (S는 근거 packet 자리)
+    "P0": ["S"],
+    "P1": ["A", "S"],
+    "P2": ["B", "S"],
+    "P3": ["S", "A"],
+    "P4": ["A", "A", "S"],
+    "P5": ["A", "B", "S"],
+    "P6": ["A", "B", "A", "B", "S"],
+}
+
+
+def sha256_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def sha256_array(a):
+    return hashlib.sha256(np.ascontiguousarray(a).tobytes()).hexdigest()
+
+
+def src_path(case, kind):
+    return BRATS_ROOT / case / f"{case}-{kind}.nii.gz"
+
+
+def load_canonical(case, seq):
+    """영상·seg를 같은 canonical 변환으로 읽고 정렬을 검증한다."""
+    im = nib.load(str(src_path(case, seq)))
+    sg = nib.load(str(src_path(case, "seg")))
+    info = {"orig_shape_img": list(im.shape), "orig_shape_seg": list(sg.shape),
+            "orig_axcodes_img": list(nib.aff2axcodes(im.affine)),
+            "orig_axcodes_seg": list(nib.aff2axcodes(sg.affine)),
+            "orig_affine_equal": bool(np.allclose(im.affine, sg.affine, atol=1e-4))}
+    if im.shape != sg.shape or not info["orig_affine_equal"]:
+        raise ValueError(f"{case}/{seq}: 영상-seg shape/affine 불일치 {info}")
+    imc, sgc = nib.as_closest_canonical(im), nib.as_closest_canonical(sg)
+    info.update({"canon_axcodes": list(nib.aff2axcodes(imc.affine)),
+                 "canon_affine_equal": bool(np.allclose(imc.affine, sgc.affine, atol=1e-4)),
+                 "canon_shape": list(imc.shape)})
+    assert info["canon_affine_equal"] and info["canon_axcodes"] == ["R", "A", "S"]
+    vol = np.asarray(imc.dataobj).astype(np.float32)
+    seg = np.asarray(sgc.dataobj).astype(np.float32)
+    return vol, seg, info
+
+
+def display_2d(a3d, z):
+    """RAS 배열 [x,y,z]의 axial slice -> (row=anterior 위, col=환자 오른쪽이 왼쪽) radiological."""
+    return a3d[:, :, z].T[::-1, ::-1]
+
+
+def window_params(vol):
+    nz = vol[vol > 0]
+    lo, hi = float(np.percentile(nz, 1)), float(np.percentile(nz, 99))
+    if hi <= lo:
+        hi = lo + 1.0
+    return lo, hi
+
+
+def to_rgb_uint8(sl, lo, hi):
+    v = (np.clip(sl, lo, hi) - lo) / (hi - lo) * 255.0
+    g = np.round(v).astype(np.uint8)
+    return np.stack([g] * 3, axis=-1)
+
+
+def select_slices(vol, seg):
+    """E: seg>0 면적 상위 2 slice (동률은 z). 빈 slice: 규칙 적용 후 E 영상 면적과 가까운 순 8개.
+
+    반환: (selection dict, per-z 제외 기록). 부족하면 selection=None.
+    """
+    seg_area = (seg > 0).sum(axis=(0, 1)).astype(int)
+    img_area = (vol > 0).sum(axis=(0, 1)).astype(int)
+    zs = np.nonzero(seg_area)[0]
+    zmin, zmax = int(zs.min()), int(zs.max())
+    order = sorted(range(len(seg_area)), key=lambda z: (-seg_area[z], z))
+    e = sorted(order[:2])
+    target = float(np.mean([img_area[z] for z in e]))
+    max_area = int(img_area.max())
+    records, cands = [], []
+    for z in range(vol.shape[2]):
+        reasons = []
+        if seg_area[z] > 0:
+            reasons.append("annotated")
+        elif zmin - EMPTY_MIN_GAP < z < zmax + EMPTY_MIN_GAP:
+            reasons.append(f"within_{EMPTY_MIN_GAP}_of_annotation_range")
+        if img_area[z] < EMPTY_MIN_AREA_FRAC * max_area:
+            reasons.append("image_area_below_25pct_max")
+        records.append({"z": z, "seg_area": int(seg_area[z]), "img_area": int(img_area[z]),
+                        "eligible_empty": not reasons, "exclusion_reasons": reasons})
+        if not reasons:
+            cands.append(z)
+    ranked = sorted(cands, key=lambda z: (abs(img_area[z] - target), z))
+    meta = {"annot_z_range": [zmin, zmax], "img_area_max": max_area, "E_target_img_area": target,
+            "n_eligible_empty": len(cands), "ranked_empty_candidates": ranked}
+    if len(ranked) < 2 * len(EMPTY_ROLES):
+        return None, records, meta
+    sel = {"E": e}
+    # 순위 1..8을 N,R,A,B,N,R,A,B로 round-robin 배정 (한 역할에 가장 유사한 후보가 몰리지 않도록)
+    for i, role in enumerate(EMPTY_ROLES):
+        sel[role] = sorted([ranked[i], ranked[i + len(EMPTY_ROLES)]])
+    return sel, records, meta
+
+
+def build_sequence(cond, packets, s_role):
+    """조건과 packet 정의로 slice id 순서 목록을 만든다."""
+    out = []
+    for p in CONDITIONS[cond]:
+        out += packets[s_role if p == "S" else p]
+    return out
+
+
+def iaf_keep(images, gamma=IAF_GAMMA):
+    """MedPruner 본문의 inter-slice anchor filtering만 구현.
+
+    images: [0,1] RGB float 배열 목록. 첫 slice를 anchor로 유지하고, 이후 slice는 현재 anchor와의
+    mean L1이 gamma를 초과하면 유지하며 새 anchor가 된다. 유지 index 목록을 반환.
+    """
+    if not images:
+        return []
+    keep, anchor = [0], images[0]
+    for i in range(1, len(images)):
+        if float(np.abs(images[i] - anchor).mean()) > gamma:
+            keep.append(i)
+            anchor = images[i]
+    return keep
