@@ -0,0 +1,325 @@
+"""iter_003 context pilot 집계: 방법별 drift·balanced accuracy·worst-context·flip·margin·기권·비용.
+
+독립 단위는 case(3개)다. case-sequence 안에서 먼저 계산하고, case 안에서 sequence 평균, 그 다음 case 평균.
+paired 보정과 oracle packet-only는 GT 기반 oracle이다 (표에 oracle 열로 표시).
+실행: python research/analyze_context_pilot.py --out research/results/iter_003
+"""
+import argparse
+import json
+from pathlib import Path
+from statistics import mean
+
+from context_pilot.data import build_sequence
+
+CONDS = ["P0", "P1", "P2", "P3", "P4", "P5", "P6"]
+CTX = CONDS[1:]
+SCORER_VERSION = 2
+METHODS = {  # 이름: (oracle 여부, 설명)
+    "concat": (False, "원본 concatenation 점수"),
+    "paired": (True, "m(S,C)-m(R,C)+m(R) (GT로 만든 R 사용, 계수 1 고정)"),
+    "single_mean": (False, "입력 slice 독립 점수 평균 (multiplicity 반영)"),
+    "single_mean_unique": (False, "입력 slice 독립 점수 평균 (unique slice)"),
+    "single_max": (False, "입력 slice 독립 점수 max"),
+    "iaf": (False, "MedPruner IAF(gamma=0.05)만 적용한 입력의 점수"),
+    "packet_only": (True, "context 제거 (P0 점수를 모든 조건에 사용)"),
+}
+
+
+def load(out):
+    labels = json.loads((out / "labels.json").read_text())
+    manifest = json.loads((out / "manifest.json").read_text())
+    preds = {}
+    for line in open(out / "predictions.jsonl"):
+        r = json.loads(line)
+        if r.get("scorer_version") == SCORER_VERSION and r.get("status") == "ok":
+            preds[r["id"]] = r  # 같은 id가 여러 번이면 마지막 기록
+    return labels, manifest, preds
+
+
+def correct(v, packet):
+    return (v > 0) if packet == "E" else (v <= 0)
+
+
+def method_scores(cs, P):
+    """cs: manifest case-sequence, P: id->pred. 반환 {method: {S: {cond: value}}} 와 누락 목록."""
+    case, seq = cs["case"], cs["sequence"]
+    missing = []
+
+    def g(kind, packet, cond):
+        rid = f"{case}|{seq}|{kind}|{packet}|{cond}"
+        if rid not in P:
+            missing.append(rid)
+            return None
+        return P[rid]["m"]
+
+    single = {sid: g("single", sv["role"], sid) for sid, sv in cs["slices"].items()}
+    packets = cs["packets"]
+    res ={m: {} for m in METHODS}
+    for S in ["E", "N"]:
+        for m in METHODS:
+            res[m][S] = {}
+        for c in CONDS:
+            sids = build_sequence(c, packets, S)
+            ms, mr, mr0 = g("concat", S, c), g("concat", "R", c), g("concat", "R", "P0")
+            m0 = g("concat", S, "P0")
+            res["concat"][S][c] = ms
+            res["paired"][S][c] = None if None in (ms, mr, mr0) else ms - mr + mr0
+            sv = [single[s] for s in sids]
+            us = [single[s] for s in dict.fromkeys(sids)]
+            ok = None not in sv
+            res["single_mean"][S][c] = mean(sv) if ok else None
+            res["single_mean_unique"][S][c] = mean(us) if ok else None
+            res["single_max"][S][c] = max(sv) if ok else None
+            iaf_rid = f"{case}|{seq}|iaf|{S}|{c}"
+            if iaf_rid in P:
+                res["iaf"][S][c] = P[iaf_rid]["m"]
+            else:
+                rec = next(x for x in cs["iaf"] if x["packet"] == S and x["cond"] == c)
+                res["iaf"][S][c] = m0 if rec["identical_to_concat"] else g("iaf", S, c)
+            res["packet_only"][S][c] = m0
+    return res, missing
+
+
+def cs_metrics(sc, ref, conds=CONDS, ctx=CTX):
+    """sc: {S:{cond:v}} 한 방법, ref: concat {S:{cond:v}}. case-sequence 단위 지표."""
+    out = {}
+    d_own, d_pk = {}, {}
+    for S in ["E", "N"]:
+        d_own[S] = mean(abs(sc[S][c] - sc[S][conds[0]]) for c in ctx)
+        d_pk[S] = mean(abs(sc[S][c] - ref[S]["P0"]) for c in ctx)
+    out["drift_own"] = (d_own["E"] + d_own["N"]) / 2
+    out["drift_own_E"], out["drift_own_N"] = d_own["E"], d_own["N"]
+    out["drift_vs_packet"] = (d_pk["E"] + d_pk["N"]) / 2
+    bas = [(correct(sc["E"][c], "E") + correct(sc["N"][c], "N")) / 2 for c in conds]
+    out["ba_mean"] = mean(bas)
+    out["ba_by_cond"] = dict(zip(conds, bas))
+    out["worst_ctx_acc"] = mean(all(correct(sc[S][c], S) for c in conds) for S in ["E", "N"])
+    out["flips_vs_packet"] = sum((sc[S][c] > 0) != (ref[S]["P0"] > 0) for S in ["E", "N"] for c in ctx)
+    out["n_flip_slots"] = 2 * len(ctx)
+    out["fn_E"] = sum(not correct(sc["E"][c], "E") for c in conds)
+    out["fp_N"] = sum(not correct(sc["N"][c], "N") for c in conds)
+    margins = [sc["E"][c] - sc["N"][c] for c in conds]
+    out["margin_mean"] = mean(margins)
+    out["margin_pos"] = sum(x > 0 for x in margins)
+    out["n_conds"] = len(conds)
+    return out
+
+
+NUMERIC = ["drift_own", "drift_own_E", "drift_own_N", "drift_vs_packet", "ba_mean", "worst_ctx_acc",
+           "flips_vs_packet", "fn_E", "fp_N", "margin_mean", "margin_pos"]
+
+
+def case_aggregate(per_cs, keys=NUMERIC):
+    """per_cs: {(case,seq): metrics}. case 안 sequence 평균 → case 평균. 원시 값도 반환."""
+    cases = sorted({c for c, _ in per_cs})
+    per_case = {c: {k: mean(v[k] for (cc, _), v in per_cs.items() if cc == c) for k in keys} for c in cases}
+    return {"case_mean": {k: mean(per_case[c][k] for c in cases) for k in keys},
+            "per_case": per_case, "n_cases": len(cases), "n_case_sequences": len(per_cs)}
+
+
+def abstain_p13(concat):
+    """P1/P3 결정이 같을 때만 답. 반환: 각 S에 대한 (answered, correct)."""
+    res = {}
+    for S in ["E", "N"]:
+        a, b = concat[S]["P1"] > 0, concat[S]["P3"] > 0
+        ans = a == b
+        res[S] = {"answered": ans, "correct": ans and correct(concat[S]["P1"], S)}
+    return res
+
+
+def summarize_abstain(per_cs):
+    cases = sorted({c for c, _ in per_cs})
+
+    def agg(items):
+        n = len(items)
+        ans = sum(i["answered"] for i in items)
+        cor = sum(i["correct"] for i in items)
+        return {"n": n, "answered": ans, "coverage": ans / n, "selective_error": (ans - cor) / ans if ans else None,
+                "correct_over_all": cor / n}
+    per_case = {c: agg([v[S] for (cc, _), v in per_cs.items() if cc == c for S in v]) for c in cases}
+    covs = [per_case[c]["coverage"] for c in cases]
+    alls = [per_case[c]["correct_over_all"] for c in cases]
+    return {"per_case": per_case, "pooled": agg([v[S] for v in per_cs.values() for S in v]),
+            "case_mean_coverage": mean(covs), "case_mean_correct_over_all": mean(alls)}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args()
+    out = a.out
+    labels, manifest, P = load(out)
+    all_missing = []
+    per_method = {m: {} for m in METHODS}
+    raw = {}
+    p13 = {"ensemble": {}, "concat": {}, "paired": {}}
+    abst = {}
+    for cs in manifest["case_sequences"]:
+        key = (cs["case"], cs["sequence"])
+        res, missing = method_scores(cs, P)
+        all_missing += missing
+        if missing:
+            continue
+        raw["|".join(key)] = {m: res[m] for m in METHODS}
+        for m in METHODS:
+            per_method[m][key] = cs_metrics(res[m], res["concat"])
+        ens = {S: {"P13": (res["concat"][S]["P1"] + res["concat"][S]["P3"]) / 2} for S in ["E", "N"]}
+        # 2-order ensemble: 단일 pseudo-condition. drift는 packet-only 대비
+        p13["ensemble"][key] = {
+            "drift_vs_packet": mean(abs(ens[S]["P13"] - res["concat"][S]["P0"]) for S in ["E", "N"]),
+            "ba_mean": (correct(ens["E"]["P13"], "E") + correct(ens["N"]["P13"], "N")) / 2,
+            "worst_ctx_acc": mean(correct(ens[S]["P13"], S) for S in ["E", "N"])}
+        for m in ["concat", "paired"]:
+            p13[m][key] = {
+                "drift_vs_packet": mean(abs(res[m][S][c] - res["concat"][S]["P0"]) for S in ["E", "N"] for c in ["P1", "P3"]),
+                "ba_mean": mean((correct(res[m]["E"][c], "E") + correct(res[m]["N"][c], "N")) / 2 for c in ["P1", "P3"]),
+                "worst_ctx_acc": mean(all(correct(res[m][S][c], S) for c in ["P1", "P3"]) for S in ["E", "N"])}
+        abst[key] = abstain_p13(res["concat"])
+
+    metrics = {"n_predictions_ok": len(P), "missing_ids": all_missing, "oracle": {m: METHODS[m][0] for m in METHODS},
+               "method_desc": {m: METHODS[m][1] for m in METHODS}}
+    if all_missing:
+        print("누락 요청:", len(all_missing), all_missing[:5])
+    agg = {m: case_aggregate(per_method[m]) for m in METHODS}
+    metrics["methods"] = {m: {"aggregate": agg[m], "per_case_sequence": {"|".join(k): v for k, v in per_method[m].items()}}
+                          for m in METHODS}
+    metrics["p1_p3"] = {m: case_aggregate(p13[m], ["drift_vs_packet", "ba_mean", "worst_ctx_acc"]) for m in p13}
+    metrics["abstain_p1_p3"] = summarize_abstain(abst)
+    metrics["abstain_p1_p3"]["per_case_sequence"] = {"|".join(k): v for k, v in abst.items()}
+
+    # ---- 반복 오차
+    reps = []
+    for rid, r in P.items():
+        if r["kind"] == "repeat":
+            base = rid.replace("|repeat|", "|concat|")
+            if base in P:
+                reps.append({"id": rid, "abs_diff": abs(r["m"] - P[base]["m"]),
+                             "same_input_hash": r["input_sha256"] == P[base]["input_sha256"]})
+    # 입력 hash가 같은 서로 다른 요청(IAF 결과가 다른 입력과 같아진 경우 등)도 반복 측정으로 사용
+    by_hash = {}
+    for rid, r in P.items():
+        by_hash.setdefault(r["input_sha256"], []).append(r["m"])
+    hash_dups = [max(v) - min(v) for v in by_hash.values() if len(v) > 1]
+    rep_max = max([x["abs_diff"] for x in reps] + hash_dups) if (reps or hash_dups) else None
+    metrics["repeatability"] = {"n_repeat_pairs": len(reps), "max_abs_diff": max((x["abs_diff"] for x in reps), default=None),
+                                "n_identical_hash_groups": len(hash_dups), "max_abs_diff_identical_hash": max(hash_dups, default=None),
+                                "rep_err_max": rep_max, "pairs": reps}
+
+    # ---- 사전 진행 기준
+    c1_rows = []
+    for key, raw_m in raw.items():
+        c = raw_m["concat"]
+        c1_rows.append({"cs": key, "margin_P0": c["E"]["P0"] - c["N"]["P0"],
+                        "ba_P0": (correct(c["E"]["P0"], "E") + correct(c["N"]["P0"], "N")) / 2})
+    ba_p0_case = {}
+    for r in c1_rows:
+        ba_p0_case.setdefault(r["cs"].split("|")[0], []).append(r["ba_P0"])
+    ba_p0 = mean(mean(v) for v in ba_p0_case.values())
+    n_margin = sum(r["margin_P0"] > 0 for r in c1_rows)
+    crit1 = {"rows": c1_rows, "n_margin_positive": n_margin, "n_case_sequences": len(c1_rows),
+             "ba_P0_case_mean": ba_p0, "pass": n_margin >= 4 and ba_p0 >= 0.67}
+
+    thr = max(0.5, rep_max or 0.0)
+    c2_cases = {}
+    c2_rows = []
+    for key, raw_m in raw.items():
+        c = raw_m["concat"]
+        case = key.split("|")[0]
+        for S in ["E", "N"]:
+            for c2 in ["P2", "P3"]:
+                d = c[S][c2] - c[S]["P1"]
+                flip = (c[S][c2] > 0) != (c[S]["P1"] > 0)
+                hit = (flip and abs(d) > (rep_max or 0.0)) or abs(d) >= thr
+                c2_rows.append({"cs": key, "S": S, "pair": f"P1-{c2}", "diff": d, "flip": flip, "hit": hit})
+                c2_cases[case] = c2_cases.get(case, False) or hit
+    crit2 = {"rows": c2_rows, "threshold_abs": thr, "rep_err_max": rep_max,
+             "cases_hit": [k for k, v in c2_cases.items() if v], "pass": sum(c2_cases.values()) >= 2}
+
+    ca, pa = agg["concat"], agg["paired"]
+    red = 1 - pa["case_mean"]["drift_own"] / ca["case_mean"]["drift_own"] if ca["case_mean"]["drift_own"] else None
+    same_dir = [c for c in ca["per_case"] if pa["per_case"][c]["drift_own"] < ca["per_case"][c]["drift_own"]]
+    crit3 = {"drift_concat": ca["case_mean"]["drift_own"], "drift_paired": pa["case_mean"]["drift_own"],
+             "reduction": red, "cases_reduced": same_dir,
+             "reduction_E": 1 - pa["case_mean"]["drift_own_E"] / ca["case_mean"]["drift_own_E"],
+             "reduction_N": 1 - pa["case_mean"]["drift_own_N"] / ca["case_mean"]["drift_own_N"],
+             "ba_concat": ca["case_mean"]["ba_mean"], "ba_paired": pa["case_mean"]["ba_mean"],
+             "worst_concat": ca["case_mean"]["worst_ctx_acc"], "worst_paired": pa["case_mean"]["worst_ctx_acc"]}
+    crit3["pass"] = bool(red is not None and red >= 0.25 and len(same_dir) >= 2
+                         and crit3["ba_paired"] >= crit3["ba_concat"] and crit3["worst_paired"] >= crit3["worst_concat"])
+    metrics["criteria"] = {"1_measurability": crit1, "2_instability": crit2, "3_paired_promise": crit3}
+
+    # ---- 비용 (P1-P6, E/N 결정당)
+    cost = {}
+    def tok(kind, S, c, case, seq):
+        r = P.get(f"{case}|{seq}|{kind}|{S}|{c}")
+        return (r["n_image_tokens"], r["latency_s"]) if r else (None, None)
+    rows = {m: {"fwd": [], "img_tok": [], "lat": []} for m in ["concat", "paired", "single", "iaf", "ensemble_p13"]}
+    for cs in manifest["case_sequences"]:
+        case, seq = cs["case"], cs["sequence"]
+        sl = {sid: P.get(f"{case}|{seq}|single|{sv['role']}|{sid}") for sid, sv in cs["slices"].items()}
+        for S in ["E", "N"]:
+            for c in CTX:
+                t, l = tok("concat", S, c, case, seq)
+                tr, lr = tok("concat", "R", c, case, seq)
+                if t is None or tr is None:
+                    continue
+                rows["concat"]["fwd"].append(1); rows["concat"]["img_tok"].append(t); rows["concat"]["lat"].append(l)
+                rows["paired"]["fwd"].append(2); rows["paired"]["img_tok"].append(t + tr); rows["paired"]["lat"].append(l + lr)
+                u =list(dict.fromkeys(build_sequence(c, cs["packets"], S)))
+                if all(sl[s] for s in u):
+                    rows["single"]["fwd"].append(len(u)); rows["single"]["img_tok"].append(256 * len(u))
+                    rows["single"]["lat"].append(sum(sl[s]["latency_s"] for s in u))
+                ti, li = tok("iaf", S, c, case, seq)
+                if ti is not None:
+                    rows["iaf"]["fwd"].append(1); rows["iaf"]["img_tok"].append(ti); rows["iaf"]["lat"].append(li)
+            t1, l1 = tok("concat", S, "P1", case, seq)
+            t3, l3 = tok("concat", S, "P3", case, seq)
+            if t1 is not None and t3 is not None:
+                rows["ensemble_p13"]["fwd"].append(2); rows["ensemble_p13"]["img_tok"].append(t1 + t3)
+                rows["ensemble_p13"]["lat"].append(l1 + l3)
+    for m, v in rows.items():
+        cost[m] = {k: (mean(x) if x else None) for k, x in v.items()} | {"n": len(v["fwd"])}
+    cost["_note"] = ("결정 1개(E/N packet × P1-P6)당 평균. paired의 m(R) P0 1회는 case-sequence당 공유라 제외. "
+                     "single은 unique slice 단독 forward 수(같은 volume 안에서 캐시 재사용 가능). ensemble_p13은 P1/P3 결정당.")
+    metrics["cost"] = cost
+
+    # ---- IAF 근거 보존
+    iaf_rows = [dict(r, cs=f"{cs['case']}|{cs['sequence']}") for cs in manifest["case_sequences"] for r in cs["iaf"]]
+    e_rows = [r for r in iaf_rows if r["packet"] == "E" and r["cond"] != "P0"]
+    metrics["iaf_retention"] = {
+        "E_evidence_slices_kept_frac_P1_P6": sum(r["evidence_kept"] for r in e_rows) / sum(r["evidence_in"] for r in e_rows),
+        "E_inputs_with_zero_evidence_P1_P6": sum(r["evidence_kept"] == 0 for r in e_rows), "n_E_inputs_P1_P6": len(e_rows),
+        "mean_slices_kept_frac": mean(r["n_kept"] / r["n_in"] for r in iaf_rows), "rows": iaf_rows}
+
+    # ---- scoring 검증, 생성 확인
+    ver = [r for r in P.values() if "verify" in r]
+    gen = [r for r in P.values() if "generation" in r]
+    metrics["scoring_verification"] = {
+        "n": len(ver), "max_abs_diff_teacher_forced_vs_lastlogit": max((r["verify"]["abs_diff_m_vs_lastlogit"] for r in ver), default=None),
+        "sign_agree_with_nl_eot_continuation": sum((r["verify"]["m_with_nl_eot"] > 0) == (r["m"] > 0) for r in ver),
+        "min_p_yes_plus_no": min(r["p_yes_plus_no"] for r in P.values()),
+        "mean_p_yes_plus_no": mean(r["p_yes_plus_no"] for r in P.values()),
+        "rows": [{"id": r["id"], "m": r["m"], **r["verify"]} for r in ver]}
+    metrics["generation_check"] = {
+        "n": len(gen), "n_parsed": sum(r["generation"]["gen_parsed"] != "unparsed" for r in gen),
+        "n_agree": sum(r["generation"]["gen_agrees_with_score"] for r in gen),
+        "n_hit_max": sum(r["generation"]["gen_hit_max"] for r in gen),
+        "rows": [{"id": r["id"], "m": r["m"], "text": r["generation"]["gen_text_raw"],
+                  "parsed": r["generation"]["gen_parsed"], "agree": r["generation"]["gen_agrees_with_score"]} for r in gen]}
+    metrics["runtime"] = {"peak_mem_gb_max": max(r["peak_mem_gb"] for r in P.values()),
+                          "latency_s_total": sum(r["latency_s"] for r in P.values()),
+                          "kinds": {k: sum(r["kind"] == k for r in P.values()) for k in ["concat", "single", "iaf", "repeat"]}}
+    budget = json.loads((out / "budget.json").read_text())
+    metrics["budget"] = {"device_minutes_total": sum(r["device_minutes"] for r in budget["runs"]), "runs": budget["runs"]}
+    metrics["raw_scores"] = raw
+    (out / "metrics.json").write_text(json.dumps(metrics, indent=1, ensure_ascii=False))
+    print(json.dumps({k: metrics["criteria"][k]["pass"] for k in metrics["criteria"]}, ensure_ascii=False))
+    for m in METHODS:
+        cm = agg[m]["case_mean"]
+        print(f"{m:20s} oracle={METHODS[m][0]!s:5s} drift_own={cm['drift_own']:.3f} (E {cm['drift_own_E']:.3f} N {cm['drift_own_N']:.3f}) "
+              f"drift_vs_pk={cm['drift_vs_packet']:.3f} BA={cm['ba_mean']:.3f} worst={cm['worst_ctx_acc']:.3f} "
+              f"flips={cm['flips_vs_packet']:.2f}/12 margin={cm['margin_mean']:.2f}")
+
+
+if __name__ == "__main__":
+    main()
