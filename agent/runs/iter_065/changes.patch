diff --git a/hdglio59_hd.py b/hdglio59_hd.py
new file mode 100644
index 0000000..8f2435f
--- /dev/null
+++ b/hdglio59_hd.py
@@ -0,0 +1,109 @@
+"""iter_059: HD-GLIO+OR 전체 경로 실행기 (venv hdglio58의 python으로 실행).
+경계: 원본 4D NIfTI 읽기 -> channel 분리·쓰기(새 경로) -> 공식 predict_from_folder(fold0, TTA) -> native grid 복원 pred 읽기 ->
+      FLAIR 비영 범위 기반 6구간 foreground OR -> 답변 JSON 원자적 저장. GT(label)는 읽지 않는다.
+모델 loading(load_model_and_checkpoint_files)은 predict 모듈의 해당 함수를 감싸 sync 후 직접 계측한다(계산·인자 불변).
+python hdglio59_hd.py CASES.json OUT_DIR   (OUT_DIR는 존재하면 거부; CUDA_VISIBLE_DEVICES는 호출자가 지정)
+"""
+import json
+import os
+import sys
+import time
+
+T_PROC_START = time.time()
+
+import nibabel as nib  # noqa: E402
+import numpy as np  # noqa: E402
+import torch  # noqa: E402
+
+import msd56_data as D  # noqa: E402
+from hd_glio.paths import folder_with_parameter_files  # noqa: E402
+from nnunet.inference import predict as nnpredict  # noqa: E402
+
+SRC = "results/iter_056"
+HD_CH = {"0000": 1, "0001": 2, "0002": 3, "0003": 0}  # HD suffix -> MSD channel (hdglio58_prep와 동일)
+EV = []
+
+
+def ev(name, **kw):
+    EV.append({"event": name, "t": time.time(), **kw})
+
+
+def main():
+    case_json, out = sys.argv[1:3]
+    cases = json.load(open(case_json))
+    if os.path.exists(out):
+        raise FileExistsError(out)
+    os.makedirs(out)
+    procs = int(os.environ.get("HDG_PROCS", "2"))
+    meta = {c["case"]: c for c in json.load(open(f"{SRC}/data/cases.json"))["chosen"]}
+    assert os.path.isdir(folder_with_parameter_files), folder_with_parameter_files
+    ev("proc_start", t_proc_start=T_PROC_START, cuda_visible=os.environ.get("CUDA_VISIBLE_DEVICES"))
+
+    orig_load = nnpredict.load_model_and_checkpoint_files
+
+    def timed_load(*a, **k):
+        torch.cuda.synchronize()
+        ev("load_model_start")
+        r = orig_load(*a, **k)
+        torch.cuda.synchronize()
+        ev("load_model_end")
+        return r
+
+    nnpredict.load_model_and_checkpoint_files = timed_load
+
+    ev("pipeline_start")
+    indir = f"{out}/in"
+    os.makedirs(indir)
+    flair = {}
+    for cid in cases:
+        ev("case_read_start", case=cid)
+        img = nib.load(f"{SRC}/data/raw/{cid}_img.nii.gz")
+        assert img.ndim == 4 and img.shape[3] == 4 and "".join(nib.aff2axcodes(img.affine)) == "RAS"
+        assert np.allclose(img.affine, np.eye(4), atol=1e-4), (cid, img.affine)
+        data = np.asarray(img.dataobj)
+        assert np.isfinite(data).all(), cid
+        ev("case_read_end", case=cid)
+        for suf, ch in HD_CH.items():
+            vol = data[..., ch].astype(np.float32)
+            if suf == "0003":
+                flair[cid] = vol
+            h = img.header.copy()
+            h.set_data_dtype(np.float32)
+            p = f"{indir}/{cid}_{suf}.nii.gz"
+            nib.save(nib.Nifti1Image(vol, img.affine, h), p + ".tmp.nii.gz")
+            os.replace(p + ".tmp.nii.gz", p)
+        ev("case_split_end", case=cid)
+    ev("predict_start")
+    nnpredict.predict_from_folder(folder_with_parameter_files, indir, f"{out}/pred", (0,), False, procs, procs, None, 0, 1, True,
+                                  overwrite_existing=True, checkpoint_name="model_final_checkpoint")
+    torch.cuda.synchronize()
+    ev("predict_end")
+    for cid in cases:
+        ev("or_start", case=cid)
+        pr = np.asarray(nib.load(f"{out}/pred/{cid}.nii.gz").dataobj) > 0
+        assert pr.shape == flair[cid].shape
+        z0, z1 = D.nonzero_range(flair[cid])
+        slabs = D.make_slabs(z0, z1)
+        assert slabs == meta[cid]["slabs"], f"{cid}: slab mismatch vs iter_056 (FLAIR-only definition)"
+        ans = []
+        for si, (a, b) in enumerate(slabs):
+            n = int(pr[:, :, a:b + 1].sum())
+            ans.append({"slab": si, "z0": a, "z1": b, "answer": "PRESENT" if n > 0 else "ABSENT", "hd_fg_voxels": n})
+        rec = {"case": cid, "answers": ans, "pred_voxels": int(pr.sum())}
+        tmp = f"{out}/hd_{cid}.json.tmp"
+        with open(tmp, "w") as f:
+            json.dump(rec, f, indent=1)
+        os.replace(tmp, f"{out}/hd_{cid}.json")
+        ev("answer_saved", case=cid)
+    ev("pipeline_end")
+    summ = {"cases": cases, "events": EV, "procs": procs, "peak_alloc_MiB": torch.cuda.max_memory_allocated() / 2**20,
+            "peak_reserved_MiB": torch.cuda.max_memory_reserved() / 2**20, "cuda_visible": os.environ.get("CUDA_VISIBLE_DEVICES"),
+            "t_end": time.time()}
+    tmp = f"{out}/summary.json.tmp"
+    json.dump(summ, open(tmp, "w"), indent=1)
+    os.replace(tmp, f"{out}/summary.json")
+    print("done", len(cases))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/m65_cost.py b/m65_cost.py
new file mode 100644
index 0000000..cbd79f1
--- /dev/null
+++ b/m65_cost.py
@@ -0,0 +1,64 @@
+"""iter_065 D6 비용: 기존 순서의 2 case씩 3 block. block 워크로드 = 2 case x 6 구간 x 2 질문 = 24 답변.
+VLM 정책 비용(loading 제외) = 해당 block 요청들의 read->saved(원본 PNG 읽기·processor·생성·저장 fsync) 합. loading 포함 = + 모델 load_s(attempt 파일 평균, block마다 1회).
+HD 비용 = m65_hd.py summary의 pipeline_start->pipeline_end(원본 NIfTI 읽기~답변 저장), loading 포함은 proc_start->pipeline_end, 제외는 load_model 구간을 뺀 값.
+주의: VLM 요청은 block별 독립 프로세스가 아니라 D 생성 중 연속 측정값이다(두 GPU 동시 실행, 서로 다른 GPU). HD block은 단독 프로세스.
+사용: python m65_cost.py OUT.json"""
+import glob, json, os, sys
+import numpy as np
+
+R = 'results/iter_065'
+CASES = ['BRATS_053', 'BRATS_199', 'BRATS_368', 'BRATS_380', 'BRATS_037', 'BRATS_455']
+POL = {'F/F': ('F', 'F'), 'F/T': ('F', 'T'), 'T/F': ('T', 'F'), 'T/T': ('T', 'T'), 'J/J': ('J', 'J')}
+
+
+def vlm(model):
+    gd = f'{R}/gen/D_{model}'
+    cost, lab = {}, json.load(open(f'{R}/data/labels_D.json'))
+    for f in glob.glob(f'{gd}/worker*.cost'):
+        for l in open(f):
+            r = json.loads(l); cost[r['rid']] = r['read_to_saved_s']
+    loads = [json.load(open(f))['load_s'] for f in glob.glob(f'{gd}/worker*.attempt_*.json')]
+    out = {'load_s_mean': float(np.mean(loads))}
+    for p, (cw, ce) in POL.items():
+        blocks = []
+        for b in range(3):
+            cs = CASES[2 * b:2 * b + 2]
+            t = sum(v for rid, v in cost.items() if lab[rid]['case'] in cs and ((lab[rid]['q'] == 'W' and lab[rid]['cond'] == cw) or (lab[rid]['q'] == 'E' and lab[rid]['cond'] == ce)))
+            blocks.append(t)
+        out[p] = {'excl_load_s': blocks, 'incl_load_s': [x + out['load_s_mean'] for x in blocks]}
+    return out
+
+
+def hd():
+    res = []
+    for d in (f'{R}/hd/D_b0_a1', f'{R}/hd/D_b1_a0', f'{R}/hd/D_b2_a0'):
+        s = json.load(open(f'{d}/summary.json'))
+        ev = {e['event']: e for e in s['events']}
+        t_ps = [e for e in s['events'] if e['event'] == 'proc_start'][0]['t_proc_start']
+        t0, t1 = ev['pipeline_start']['t'], [e for e in s['events'] if e['event'] == 'pipeline_end'][0]['t']
+        ld = ev['load_model_end']['t'] - ev['load_model_start']['t']
+        res.append({'incl_load_s': t1 - t_ps, 'pipeline_s': t1 - t0, 'excl_load_s': t1 - t0 - ld, 'load_model_s': ld})
+    return res
+
+
+def main(out):
+    assert not os.path.exists(out)
+    h = hd()
+    rep = {'HD_blocks': h, 'HD_mean_incl_load_s': float(np.mean([x['incl_load_s'] for x in h])),
+           'HD_mean_excl_load_s': float(np.mean([x['excl_load_s'] for x in h]))}
+    for m in ('medgemma', 'qwen'):
+        v = vlm(m)
+        rep[m] = v
+        for p in ('F/T', 'F/F', 'J/J'):
+            for k in ('excl_load_s', 'incl_load_s'):
+                v[p][k + '_mean'] = float(np.mean(v[p][k]))
+        rep[m]['ratio_Q_FT_over_J'] = {k: v['F/T'][k + '_mean'] / v['J/J'][k + '_mean'] for k in ('excl_load_s', 'incl_load_s')}
+        rep[m]['ratio_Q_FT_over_HD'] = {'excl_load_s': v['F/T']['excl_load_s_mean'] / rep['HD_mean_excl_load_s'],
+                                        'incl_load_s': v['F/T']['incl_load_s_mean'] / rep['HD_mean_incl_load_s']}
+    json.dump(rep, open(out, 'w'), indent=1)
+    print(json.dumps({k: rep[k] for k in rep if k.startswith('HD_')}), {m: rep[m]['ratio_Q_FT_over_J'] for m in ('medgemma', 'qwen')},
+          {m: rep[m]['ratio_Q_FT_over_HD'] for m in ('medgemma', 'qwen')})
+
+
+if __name__ == '__main__':
+    main(sys.argv[1])
diff --git a/m65_data.py b/m65_data.py
new file mode 100644
index 0000000..95a1463
--- /dev/null
+++ b/m65_data.py
@@ -0,0 +1,145 @@
+"""iter_065 질문(W/E)×sequence(F/T/J) 요청 자료. 기존 MSD D6/E48(cases.json)·구간(slabs)을 유지한다.
+
+고정 규칙(출력 전 확정)
+ - 구간별 z 위치: z0 + msd56_data.equi(n, 8) (GT 미사용). F=FLAIR(채널0, 기존 case vmin/vmax 렌더), T=T1gd(채널2, volume 전체 min-max, 동일 RGB/표시 방향).
+ - 정답: W=구간 내 mask∈{1,2,3} voxel 존재, E=mask==3 존재(dataset.json: 3=enhancing tumour). coverage=같은 8개 z에서 해당 label voxel 존재(평가 변수; 입력 선택 불사용).
+ - J=동일 z의 F/T를 z별 교차(F_z1,T_z1,F_z2,T_z2,...) 16장.
+ - E12=E48을 SHA256('iter065:'+case)로 정렬한 앞 12 case, E36=나머지.
+서브명령: build --split D|E12|E36
+"""
+import hashlib, json, os, sys
+import numpy as np
+import msd56_data as MD
+
+ROOT = 'results/iter_065'
+SRC = 'results/iter_056/data'
+CH_F, CH_T = 0, 2
+Q = {'W': 'tumor or tumor-associated edema', 'E': 'contrast-enhancing tumor'}
+CONDS = ['F', 'T', 'J']
+DESC = {
+    'F': 'All 8 images are FLAIR slices, ordered from inferior to superior.',
+    'T': 'All 8 images are post-contrast T1-weighted slices, ordered from inferior to superior.',
+    'J': 'The 16 images are 8 pairs ordered from inferior to superior; in each pair the first image is a FLAIR slice and the second is the post-contrast T1-weighted slice at the same axial position.',
+}
+PROMPT = ('These are ordered axial MRI slices sampled from one fixed brain interval. {desc} '
+          'Is {target} present anywhere in this interval? Answer only PRESENT or ABSENT.')
+
+
+def prompt(cond, q):
+    return PROMPT.format(desc=DESC[cond], target=Q[q])
+
+
+def sha_file(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for ch in iter(lambda: f.read(1 << 22), b''):
+            h.update(ch)
+    return h.hexdigest()
+
+
+def sha_b(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def e_order(cases_e):
+    return sorted(cases_e, key=lambda c: sha_b(('iter065:' + c).encode()))
+
+
+def split_cases(split):
+    ch = json.load(open(f'{SRC}/cases.json'))['chosen']
+    d = [c for c in ch if c['split'] == 'D']
+    e = {c['case']: c for c in ch if c['split'] == 'E'}
+    order = e_order(list(e))
+    pick = {'D': [c['case'] for c in d], 'E12': order[:12], 'E36': order[12:]}[split]
+    allc = {c['case']: c for c in ch}
+    return [allc[c] for c in pick]
+
+
+def load_t1gd(cid):
+    """T1gd (canonical RAS, MD.load_case와 동일 변환) + 전체 min/max."""
+    import nibabel as nib
+    ip, _ = MD.case_paths(cid)
+    can = nib.as_closest_canonical(nib.load(ip))
+    assert "".join(nib.aff2axcodes(can.affine)) == 'RAS'
+    t = np.asarray(can.dataobj[..., CH_T], dtype=np.float32)
+    assert np.isfinite(t).all()
+    return t
+
+
+def png_name(cid, seq, z):
+    return f'{ROOT}/png/{sha_b(f"{cid}|{seq}|{z}".encode())[:16]}.png'
+
+
+def slab_labels(mask, a, b, zs):
+    sl = mask[:, :, a:b + 1]
+    sz = mask[:, :, zs]
+    return {'W': bool((sl > 0).any()), 'E': bool((sl == 3).any()),
+            'cov_W': bool((sz > 0).any()), 'cov_E': bool((sz == 3).any()),
+            'vox_W': int((sl > 0).sum()), 'vox_E': int((sl == 3).sum()),
+            'cov_vox_W': int((sz > 0).sum()), 'cov_vox_E': int((sz == 3).sum())}
+
+
+def build_requests(items):
+    """items: [{case, slab, F:[png...], T:[png...]}] -> (requests, labels_stub). 순수 함수."""
+    reqs = []
+    for it in items:
+        ims = {'F': it['F'], 'T': it['T'], 'J': [p for pair in zip(it['F'], it['T']) for p in pair]}
+        for q in ('W', 'E'):
+            for c in CONDS:
+                rid = f"{it['case']}__s{it['slab']}__{q}__{c}"
+                reqs.append({'rid': rid, 'case': it['case'], 'slab': it['slab'], 'q': q, 'cond': c, 'images': ims[c],
+                             'prompt': prompt(c, q)})
+    return reqs
+
+
+def cmd_build(split):
+    from PIL import Image
+    cs = split_cases(split)
+    co = json.load(open(f'{SRC}/case_order.json'))
+    os.makedirs(f'{ROOT}/png', exist_ok=True)
+    os.makedirs(f'{ROOT}/data', exist_ok=True)
+    items, labels, tm = [], {}, []
+    for c in cs:
+        cid = c['case']
+        ip, lp = MD.case_paths(cid)
+        assert MD.sha256(open(ip, 'rb').read()) == c['img_sha256'] == co['file_hashes'][f'images/{cid}']['sha256'], cid
+        assert MD.sha256(open(lp, 'rb').read()) == c['lbl_sha256'] == co['file_hashes'][f'labels/{cid}']['sha256'], cid
+        flair, mask, info = MD.load_case(cid)
+        assert info['shape'] == c['info']['shape'] and abs(float(flair.min()) - c['vmin']) < 1e-4 and abs(float(flair.max()) - c['vmax']) < 1e-4
+        t1 = load_t1gd(cid)
+        assert t1.shape == flair.shape
+        tmin, tmax = float(t1.min()), float(t1.max())
+        assert tmax > tmin
+        assert set(np.unique(mask).tolist()) <= {0, 1, 2, 3}
+        for si, (a, b) in enumerate(c['slabs']):
+            zs = [a + i for i in MD.equi(b - a + 1, 8)]
+            f_png, t_png = [], []
+            for z in zs:
+                for seq, vol, lo, hi, lst in (('F', flair, c['vmin'], c['vmax'], f_png), ('T', t1, tmin, tmax, t_png)):
+                    p = png_name(cid, seq, z)
+                    Image.fromarray(MD.render(vol, z, lo, hi)).save(p + '.tmp.png')
+                    os.replace(p + '.tmp.png', p)
+                    lst.append(p)
+            lab = slab_labels(mask, a, b, zs)
+            items.append({'case': cid, 'slab': si, 'F': f_png, 'T': t_png})
+            tm.append({'case': cid, 'slab': si, 'z0': a, 'z1': b, 'zs': zs, 'img_sha256': c['img_sha256'], 'lbl_sha256': c['lbl_sha256'],
+                       't1gd_min': tmin, 't1gd_max': tmax, 'flair_min': c['vmin'], 'flair_max': c['vmax'],
+                       'F_png': f_png, 'T_png': t_png, 'F_png_sha256': [sha_file(p) for p in f_png], 'T_png_sha256': [sha_file(p) for p in t_png], **lab})
+    reqs = build_requests(items)
+    by = {(t['case'], t['slab']): t for t in tm}
+    for r in reqs:
+        t = by[(r['case'], r['slab'])]
+        labels[r['rid']] = {'answer': 'PRESENT' if t[r['q']] else 'ABSENT', 'case': r['case'], 'slab': r['slab'], 'q': r['q'], 'cond': r['cond'],
+                            'coverage': bool(t['cov_' + r['q']])}
+    with open(f'{ROOT}/data/requests_{split}.jsonl', 'w') as f:
+        for r in reqs:
+            f.write(json.dumps(r) + '\n')
+    json.dump(labels, open(f'{ROOT}/data/labels_{split}.json', 'w'), indent=1)
+    json.dump({'slabs': tm, 'prompts': {f'{q}_{c}': prompt(c, q) for q in Q for c in CONDS}, 'e_order_rule': "sha256('iter065:'+case)",
+               'channels': {'F': CH_F, 'T': CH_T}}, open(f'{ROOT}/data/target_manifest_{split}.json', 'w'), indent=1)
+    print(split, 'cases', len(cs), 'slabs', len(tm), 'requests', len(reqs),
+          'W+', sum(t['W'] for t in tm), 'E+', sum(t['E'] for t in tm), 'covW0&W+', sum(t['W'] and not t['cov_W'] for t in tm), 'covE0&E+', sum(t['E'] and not t['cov_E'] for t in tm))
+
+
+if __name__ == '__main__':
+    cmd_build(sys.argv[sys.argv.index('--split') + 1]) if sys.argv[1] == 'build' else sys.exit('usage: build --split D|E12|E36')
diff --git a/m65_eval.py b/m65_eval.py
new file mode 100644
index 0000000..3615d09
--- /dev/null
+++ b/m65_eval.py
@@ -0,0 +1,292 @@
+"""iter_065 평가: 질문(W/E)×입력(F/T/J) 응답을 구간 단위 BA로 계산하고 질문별 고정 정책(F/F,F/T,T/F,T/T,J/J)·HD-GLIO를 비교.
+
+진입 조건(변경 거부): verify.json이 clean이고 기록 파일 hash가 그대로이며, 현재 requests/labels/target-manifest/model 파일로 계산한
+protocol digest가 verify.json·protocol과 같아야 한다 (m65_run.check_protocol, 부분 변조/교체 거부).
+정책 선택(D에서만): B=argmax macro BA{F/F,T/T}, Q=argmax macro BA{F/T,T/F}; 동률은 D 전체 비용(read->saved 합) 낮은 쪽, 그다음 사전식(F/F<T/T, F/T<T/F).
+bootstrap: case 단위 10,000회, seed65. 재표집에서 어느 질문이든 한 class가 사라진 replicate는 제외(유효 replicate 수 보고).
+"""
+import argparse, glob, json, os, sys
+import numpy as np
+import msd56_run as M
+import m65_run as R
+
+SEED, NB = 65, 10000
+QS = ('W', 'E')
+POLS = {'F/F': ('F', 'F'), 'F/T': ('F', 'T'), 'T/F': ('T', 'F'), 'T/T': ('T', 'T'), 'J/J': ('J', 'J')}
+B_SET, Q_SET = ['F/F', 'T/T'], ['F/T', 'T/F']
+
+
+DRIFT_OK = {'m65_run.py'}  # D·E12 생성 후 m65_run.py의 cmd_tech만 수정(E36에서 byte 동일 png 공유 허용). 생성 경로(worker/launch/verify) 불변.
+
+
+def check_protocol_run_py_drift(model, requests, labels, manifest, protocol):
+    """생성 시점 protocol과 현재 입력을 비교하되 code['m65_run.py'] hash 차이만 허용(기록). 그 외 모든 구성요소·모델 파일 hash는 엄격히 일치해야 한다."""
+    p = json.load(open(protocol))
+    comp, mf = R.components(model, requests, labels, manifest, full_model_hash=True)
+    diff = [k for k in comp if comp[k] != p['components'].get(k)]
+    code_diff = [f for f in comp['code'] if comp['code'][f] != p['components']['code'].get(f)]
+    assert diff in ([], ['code']) and set(code_diff) <= DRIFT_OK, ('protocol mismatch', diff, code_diff)
+    assert mf == {k: {**v, 'mtime_ns': mf[k]['mtime_ns']} for k, v in p['model_files'].items()} or all(
+        mf[k]['sha256'] == v['sha256'] and mf[k]['size'] == v['size'] for k, v in p['model_files'].items()), 'model files changed'
+    assert R.digest(p['components'], p['model_files']) == p['digest'], 'stored protocol tampered'
+    return p['digest'], code_diff
+
+
+def load(a, allow_drift=False):
+    v = json.load(open(a.verify))
+    assert v['n_problems'] == 0 and v['n_records'] == v['n_requests'], 'verify not clean'
+    for f, h in v['record_file_sha256'].items():
+        assert R.sha_file(f) == h, 'record file changed after verify ' + f
+    if allow_drift:
+        cur, _ = check_protocol_run_py_drift(a.model, a.requests, a.labels, a.target_manifest, a.protocol)
+    else:
+        cur = R.check_protocol(a.model, a.requests, a.labels, a.target_manifest, a.protocol, full=True)
+    assert cur == v['protocol_digest'] == json.load(open(a.protocol))['digest'], 'protocol/verify digest mismatch'
+    lab = json.load(open(a.labels))
+    reqs = {r['rid']: r for r in R.read_jsonl(a.requests)}
+    recs, cost = {}, {}
+    for f in sorted(glob.glob(f'{a.gen_dir}/worker*.jsonl')):
+        for r in R.read_jsonl(f):
+            assert r['rid'] not in recs, 'dup'
+            recs[r['rid']] = r
+    for f in sorted(glob.glob(f'{a.gen_dir}/worker*.cost')):
+        for r in R.read_jsonl(f):
+            cost[r['rid']] = r
+    assert set(recs) == set(reqs) == set(lab)
+    return lab, reqs, recs, cost, v
+
+
+def table(lab, recs):
+    T = {}
+    for rid, r in recs.items():
+        l = lab[rid]
+        txt = r['attempts'][-1]['text']
+        pa = M.parse_answer(txt)
+        pred = None if pa is None else (1 if pa == 'PRESENT' else 0)
+        gt = 1 if l['answer'] == 'PRESENT' else 0
+        T[rid] = {'case': l['case'], 'slab': l['slab'], 'q': l['q'], 'cond': l['cond'], 'pred': pred, 'gt': gt, 'correct': int(pred == gt),
+                  'cov': bool(l['coverage']), 'eos': bool(r['attempts'][-1]['ended_eos']), 'retried': len(r['attempts']) > 1}
+    return T
+
+
+def counts(T, cases):
+    """cases 순서 기준 배열 cnt[q][cond] -> (n_cases,4): tp,fn,tn,fp (invalid는 오답: gt1->fn, gt0->fp)."""
+    idx = {c: i for i, c in enumerate(cases)}
+    out = {q: {c: np.zeros((len(cases), 4)) for c in 'FTJ'} for q in QS}
+    for t in T.values():
+        a = out[t['q']][t['cond']][idx[t['case']]]
+        if t['gt'] == 1:
+            a[0 if t['pred'] == 1 else 1] += 1
+        else:
+            a[2 if t['pred'] == 0 else 3] += 1
+    return out
+
+
+def ba_from(cnt):
+    """cnt (...,4) 합산 -> BA 또는 nan"""
+    tp, fn, tn, fp = cnt[..., 0], cnt[..., 1], cnt[..., 2], cnt[..., 3]
+    with np.errstate(divide='ignore', invalid='ignore'):
+        return 0.5 * (tp / (tp + fn) + tn / (tn + fp))
+
+
+def policy_macro(cnts, pol, sel):
+    """cnts: q->cond->(n,4); sel: case index array (resample) 또는 None. returns (macro, W_ba, E_ba)"""
+    bas = []
+    for q, c in zip(QS, POLS[pol] if isinstance(pol, str) else pol):
+        x = cnts[q][c]
+        bas.append(ba_from(x.sum(0) if sel is None else x[sel].sum(1)))
+    return 0.5 * (bas[0] + bas[1]), bas[0], bas[1]
+
+
+def cost_by_cond(T, cost, recs):
+    out = {}
+    for rid, t in T.items():
+        out.setdefault((t['q'], t['cond']), []).append(cost[rid]['read_to_saved_s'])
+    return {f'{q}_{c}': float(sum(v)) for (q, c), v in out.items()}
+
+
+def hd_answers(dirs):
+    ans = {}
+    for d in dirs:
+        for f in glob.glob(f'{d}/hd_*.json'):
+            r = json.load(open(f))
+            assert r['case'] not in ans
+            ans[r['case']] = r['answers']
+    return ans
+
+
+def hd_counts(hd, lab_by_case, cases):
+    """HD W/E 응답 -> cnt[q] (n,4). 정답은 labels(질문별 F 조건)에서 가져온다."""
+    idx = {c: i for i, c in enumerate(cases)}
+    out = {q: np.zeros((len(cases), 4)) for q in QS}
+    for (case, slab, q), gt in lab_by_case.items():
+        pred = 1 if hd[case][slab][q] == 'PRESENT' else 0
+        a = out[q][idx[case]]
+        if gt == 1:
+            a[0 if pred == 1 else 1] += 1
+        else:
+            a[2 if pred == 0 else 3] += 1
+    return out
+
+
+def boot(cnts, diffs, n_cases):
+    rng = np.random.default_rng(SEED)
+    sel = rng.integers(0, n_cases, size=(NB, n_cases))
+    res = {}
+    for name, (f1, f2) in diffs.items():
+        a, b = f1(sel), f2(sel)
+        d = a - b
+        ok = ~np.isnan(d)
+        res[name] = {'n_valid_replicates': int(ok.sum()),
+                     'ci95': [float(np.percentile(d[ok], 2.5)), float(np.percentile(d[ok], 97.5))] if ok.sum() else None}
+    return res
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    for k in ('requests', 'labels', 'target-manifest', 'gen-dir', 'verify', 'model', 'protocol', 'out'):
+        ap.add_argument('--' + k, required=True)
+    ap.add_argument('--hd-dirs', nargs='*', default=[])
+    ap.add_argument('--select-from', default=None, help='D report.json: 여기서 고정한 B/Q 정책을 사용')
+    ap.add_argument('--pool', nargs='*', default=[], help='추가 split 묶음 "requests,labels,manifest,gen_dir,verify,protocol" (각각 독립 검증 후 합침; E12+E36=E48)')
+    ap.add_argument('--allow-run-py-drift', action='store_true', help='D/E12 protocol: m65_run.py hash 차이만 허용(기록)')
+    a = ap.parse_args()
+    assert not os.path.exists(a.out), 'report exists'
+    lab, reqs, recs, cost, v = load(a, allow_drift=a.allow_run_py_drift)
+    pooled = [{'requests': a.requests, 'verify': a.verify, 'protocol_digest': v['protocol_digest']}]
+    for spec in a.pool:
+        r_, l_, m_, g_, vf_, p_ = spec.split(',')
+        b = argparse.Namespace(requests=r_, labels=l_, target_manifest=m_, gen_dir=g_, verify=vf_, protocol=p_, model=a.model)
+        l2, q2, c2, k2, v2 = load(b, allow_drift=False)
+        assert not (set(l2) & set(lab)), 'overlapping request ids between pooled splits'
+        lab.update(l2); reqs.update(q2); recs.update(c2); cost.update(k2)
+        pooled.append({'requests': r_, 'verify': vf_, 'protocol_digest': v2['protocol_digest']})
+    T = table(lab, recs)
+    cases = sorted({t['case'] for t in T.values()})
+    cn = counts(T, cases)
+    n = len(cases)
+    cc = cost_by_cond(T, cost, recs)
+    rep = {'model': a.model, 'requests_sha256': R.sha_file(a.requests), 'labels_sha256': R.sha_file(a.labels),
+           'verify_sha256': R.sha_file(a.verify), 'protocol_digest': v['protocol_digest'], 'pooled_splits': pooled, 'seed': SEED, 'n_boot': NB, 'n_cases': n,
+           'n_slabs': n * 6, 'cost_sum_read_to_saved_s_by_q_cond': cc}
+    # 질문×입력 단독 지표
+    per = {}
+    for q in QS:
+        for c in 'FTJ':
+            x = cn[q][c].sum(0)
+            per[f'{q}_{c}'] = {'BA': float(ba_from(x)), 'sens': float(x[0] / (x[0] + x[1])), 'spec': float(x[2] / (x[2] + x[3])),
+                               'tp_fn_tn_fp': x.tolist()}
+    rep['per_question_cond'] = per
+    pol = {}
+    for p in POLS:
+        m, w, e = policy_macro(cn, p, None)
+        pol[p] = {'macro_BA': float(m), 'W_BA': float(w), 'E_BA': float(e), 'cost_s': cc[f'W_{POLS[p][0]}'] + cc[f'E_{POLS[p][1]}']}
+    rep['policies'] = pol
+    # 선택
+    if a.select_from:
+        sel = json.load(open(a.select_from))['selection']
+        rep['selection_source'] = a.select_from
+    else:
+        def pick(S):
+            return sorted(S, key=lambda p: (-round(pol[p]['macro_BA'], 12), pol[p]['cost_s'], S.index(p)))[0]
+        sel = {'B': pick(B_SET), 'Q': pick(Q_SET)}
+        rep['selection_rule'] = 'argmax macro BA; tie -> lower D cost; tie -> lexicographic order'
+    rep['selection'] = sel
+    best_here = max(POLS, key=lambda p: (round(pol[p]['macro_BA'], 12), -pol[p]['cost_s']))
+    rep['optimistic_best_policy_this_split'] = best_here
+    # bootstrap 비교
+    def pf(p):
+        return lambda s, p=p: policy_macro(cn, p, s)[0]
+
+    def pq(p, qi):
+        return lambda s, p=p, qi=qi: policy_macro(cn, p, s)[1 + qi]
+    diffs = {}
+    Bp, Qp = sel['B'], sel['Q']
+    diffs['Q-B_macro'] = (pf(Qp), pf(Bp))
+    diffs['Q-J_macro'] = (pf(Qp), pf('J/J'))
+    diffs['B-J_macro'] = (pf(Bp), pf('J/J'))
+    diffs['F/T-B_macro'] = (pf('F/T'), pf(Bp))
+    diffs['F/T-J_macro'] = (pf('F/T'), pf('J/J'))
+    for qi, q in enumerate(QS):
+        diffs[f'Q-B_{q}'] = (pq(Qp, qi), pq(Bp, qi))
+        diffs[f'Q-J_{q}'] = (pq(Qp, qi), pq('J/J', qi))
+        diffs[f'F-T_{q}'] = (pq('F/F', qi), pq('T/T', qi))
+        diffs[f'J-F_{q}'] = (pq('J/J', qi), pq('F/F', qi))
+        diffs[f'J-T_{q}'] = (pq('J/J', qi), pq('T/T', qi))
+    cis = boot(cn, diffs, n)
+    # 점추정: sel=None 경로
+    def pt(p, qi=None):
+        m = policy_macro(cn, p, None)
+        return m[0] if qi is None else m[1 + qi]
+    pts = {'Q-B_macro': pt(Qp) - pt(Bp), 'Q-J_macro': pt(Qp) - pt('J/J'), 'B-J_macro': pt(Bp) - pt('J/J'),
+           'F/T-B_macro': pt('F/T') - pt(Bp), 'F/T-J_macro': pt('F/T') - pt('J/J')}
+    for qi, q in enumerate(QS):
+        pts[f'Q-B_{q}'] = pt(Qp, qi) - pt(Bp, qi); pts[f'Q-J_{q}'] = pt(Qp, qi) - pt('J/J', qi)
+        pts[f'F-T_{q}'] = pt('F/F', qi) - pt('T/T', qi); pts[f'J-F_{q}'] = pt('J/J', qi) - pt('F/F', qi); pts[f'J-T_{q}'] = pt('J/J', qi) - pt('T/T', qi)
+    rep['diffs'] = {k: {'point': float(pts[k]), **cis[k]} for k in diffs}
+    # 비용비 Q/J (read->saved 합 기준, loading 제외)
+    rep['cost_ratio_Q_over_J'] = pol[Qp]['cost_s'] / pol['J/J']['cost_s']
+    # 형식·cap
+    fmt = {}
+    for c in 'FTJ':
+        rows = [t for t in T.values() if t['cond'] == c]
+        fmt[c] = {'n': len(rows), 'invalid': sum(t['pred'] is None for t in rows), 'non_eos_final': sum(not t['eos'] for t in rows),
+                  'retried_2048': sum(t['retried'] for t in rows)}
+    rep['format'] = fmt
+    # coverage: 양성 FN 분리
+    cov = {}
+    for q in QS:
+        for c in 'FTJ':
+            rows = [t for t in T.values() if t['q'] == q and t['cond'] == c and t['gt'] == 1]
+            cov[f'{q}_{c}'] = {'pos': len(rows), 'cov0_pos': sum(not t['cov'] for t in rows), 'FN_cov0': sum((not t['cov']) and t['pred'] != 1 for t in rows),
+                               'FN_cov1': sum(t['cov'] and t['pred'] != 1 for t in rows),
+                               'sens_cov1': (float(np.mean([t['pred'] == 1 for t in rows if t['cov']])) if any(t['cov'] for t in rows) else None)}
+    rep['coverage_split'] = cov
+    # W/E 정답이 다른 구간에서 두 답변 동시 정확
+    joint = {}
+    for p, (cw, ce) in POLS.items():
+        ok = tot = 0
+        for (case, slab) in {(t['case'], t['slab']) for t in T.values()}:
+            w = T[f'{case}__s{slab}__W__{cw}']; e = T[f'{case}__s{slab}__E__{ce}']
+            if w['gt'] != e['gt']:
+                tot += 1; ok += w['correct'] and e['correct']
+        joint[p] = {'n_discordant_gt_slabs': tot, 'both_correct': ok}
+    rep['joint_when_gt_differs'] = joint
+    # case oracle (낙관적 참고; selector 비용 미포함)
+    orc = []
+    for case in cases:
+        i = cases.index(case)
+        best = max(((policy_macro({q: {c: cn[q][c][[i]] for c in 'FTJ'} for q in QS}, pl, None)[0]) for pl in ('F/F', 'T/T')))
+        orc.append(best)
+    rep['oracle_case_F_or_T_mean_macro_BA_caseavg'] = float(np.nanmean(orc))
+    # HD
+    if a.hd_dirs:
+        hd = hd_answers(a.hd_dirs)
+        assert set(hd) == set(cases), 'HD cases mismatch'
+        lab_f = {(l['case'], l['slab'], l['q']): 1 if l['answer'] == 'PRESENT' else 0 for rid, l in lab.items() if l['cond'] == 'F'}
+        hc = hd_counts(hd, lab_f, cases)
+        hbas = {q: float(ba_from(hc[q].sum(0))) for q in QS}
+        rep['HD'] = {'W_BA': hbas['W'], 'E_BA': hbas['E'], 'macro_BA': 0.5 * (hbas['W'] + hbas['E']),
+                     'tp_fn_tn_fp': {q: hc[q].sum(0).tolist() for q in QS},
+                     'note': 'HD label2=contrast-enhancing(D에서 MSD label3와 Dice로 확인, hd_label_semantics_D.json); W=HD 비배경(ontology 차이 가능)'}
+        rng = np.random.default_rng(SEED)
+        sel_i = rng.integers(0, n, size=(NB, n))
+        def hdm(s):
+            return 0.5 * sum(ba_from(hc[q][s].sum(1)) for q in QS)
+        hcis = {}
+        for nm, f in (('Q-HD_macro', lambda s: policy_macro(cn, Qp, s)[0] - hdm(s)), ('J-HD_macro', lambda s: policy_macro(cn, 'J/J', s)[0] - hdm(s)),
+                      ('Q-HD_W', lambda s: policy_macro(cn, Qp, s)[1] - ba_from(hc['W'][s].sum(1))),
+                      ('Q-HD_E', lambda s: policy_macro(cn, Qp, s)[2] - ba_from(hc['E'][s].sum(1)))):
+            d = f(sel_i); ok = ~np.isnan(d)
+            hcis[nm] = {'n_valid_replicates': int(ok.sum()), 'ci95': [float(np.percentile(d[ok], 2.5)), float(np.percentile(d[ok], 97.5))] if ok.sum() else None}
+        q_m = policy_macro(cn, Qp, None)
+        hcis['Q-HD_macro']['point'] = float(q_m[0] - rep['HD']['macro_BA']); hcis['J-HD_macro']['point'] = float(pol['J/J']['macro_BA'] - rep['HD']['macro_BA'])
+        hcis['Q-HD_W']['point'] = float(q_m[1] - hbas['W']); hcis['Q-HD_E']['point'] = float(q_m[2] - hbas['E'])
+        rep['diffs_vs_HD'] = hcis
+    os.makedirs(os.path.dirname(a.out) or '.', exist_ok=True)
+    json.dump(rep, open(a.out, 'w'), indent=1)
+    print(a.model, 'selection', sel, {p: round(pol[p]['macro_BA'], 4) for p in pol})
+
+
+if __name__ == '__main__':
+    main()
