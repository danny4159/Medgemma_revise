+
+def cpu():
+    # --- select_targets 합성
+    fl = np.zeros((10, 10, 6), np.float32); mk = np.zeros((10, 10, 6), np.uint8)
+    for z, n in enumerate([0, 5, 20, 20, 0, 1]):
+        fl[:n, 0, z] = 1.0
