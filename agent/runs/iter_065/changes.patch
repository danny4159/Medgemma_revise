new file mode 100644
index 0000000..142c67d
--- /dev/null
+++ b/msd56_data.py
@@ -0,0 +1,220 @@
+"""iter_056 MSD Task01_BrainTumour FLAIR 구간 자료: 선택·추출·구간/정답/조건 생성.
+
+원칙
+- 채널은 dataset.json(modality["0"]=="FLAIR")에서 읽는다. 정답=모든 비배경 label(1,2,3)의 합집합 (전부 tumour/oedema 계열; dataset.json labels).
+- image·mask는 동일 함수(canonical RAS 재배열 + 동일 축 변환)로 처리한다. 구간은 FLAIR nonzero 범위만으로 정한다(mask 미사용).
+- 렌더링: FLAIR volume 전체 min/max로 uint8 선형 정규화(구간별/slice별 재정규화 없음), 동일 RGB 3채널.
+- 표시 방향: slice[k] = arr_RAS[::-1, :, k].T[::-1]  -> 행: anterior가 위, 열: patient right가 영상 왼쪽(radiological).
+사용: python msd56_data.py select | extract | build
+"""
+import hashlib
+import io
+import json
+import os
+import random
+import sys
+import tarfile
+
+import numpy as np
+
+ROOT = "results/iter_056"
+TAR = f"{ROOT}/source/Task01_BrainTumour.tar"
+DATA = f"{ROOT}/data"
+SEED = 56
+N_D, N_E, N_SLAB, MIN_SLAB = 6, 48, 6, 8
+VERSION = "msd56_data_v1"
+
+
+def sha256(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def training_ids():
+    d = json.load(open(f"{ROOT}/source/dataset.json"))
+    assert d["modality"]["0"] == "FLAIR", d["modality"]
+    ids = []
+    for e in d["training"]:
+        assert e["image"].startswith("./imagesTr/") and e["label"].startswith("./labelsTr/")
+        a, b = e["image"].rsplit("/", 1)[1], e["label"].rsplit("/", 1)[1]
+        assert a == b and not a.startswith("._")
+        ids.append(a[:-len(".nii.gz")])
+    assert len(ids) == len(set(ids)) == 484
+    return sorted(ids)
+
+
+def case_paths(cid):
+    return f"{DATA}/raw/{cid}_img.nii.gz", f"{DATA}/raw/{cid}_lbl.nii.gz"
+
+
+def load_case(cid):
+    """returns flair float32 (RAS canonical), mask uint8 (same), header info dict."""
+    import nibabel as nib
+    ip, lp = case_paths(cid)
+    img, lbl = nib.load(ip), nib.load(lp)
+    if img.shape[:3] != lbl.shape[:3] or not np.allclose(img.affine, lbl.affine, atol=1e-4):
+        raise ValueError(f"{cid}: image/label grid mismatch {img.shape} {lbl.shape}")
+    assert img.ndim == 4 and img.shape[3] == 4
+    info = {"shape": list(img.shape), "label_shape": list(lbl.shape), "zooms": [float(z) for z in img.header.get_zooms()[:3]],
+            "orig_axcodes": "".join(nib.aff2axcodes(img.affine)), "affine": img.affine.round(4).tolist(),
+            "dtype": str(img.get_data_dtype())}
+    can = nib.as_closest_canonical(img)
+    canl = nib.as_closest_canonical(lbl)
+    info["canon_axcodes"] = "".join(nib.aff2axcodes(can.affine))
+    assert info["canon_axcodes"] == "RAS"
+    flair = np.asarray(can.dataobj[..., 0], dtype=np.float32)
+    mask = np.asarray(canl.dataobj).astype(np.uint8)
+    if not np.isfinite(flair).all():
+        raise ValueError(f"{cid}: non-finite FLAIR")
+    return flair, mask, info
+
+
+def nonzero_range(flair):
+    nz = np.where((flair != 0).reshape(-1, flair.shape[2]).any(axis=0))[0]
+    return int(nz[0]), int(nz[-1])
+
+
+def make_slabs(z0, z1, n=N_SLAB):
+    L = z1 - z0 + 1
+    base, rem = divmod(L, n)
+    out, s = [], z0
+    for i in range(n):
+        ln = base + (1 if i < rem else 0)
+        out.append([s, s + ln - 1])
+        s += ln
+    assert out[-1][1] == z1
+    return out
+
+
+def render(flair, k, vmin, vmax):
+    sl = flair[::-1, :, k].T[::-1]
+    u = np.clip((sl - vmin) / (vmax - vmin), 0, 1) * 255.0
+    g = np.round(u).astype(np.uint8)
+    return np.repeat(g[:, :, None], 3, axis=2)
+
+
+def mask_slice(mask, k):
+    return (mask[::-1, :, k].T[::-1] > 0)
+
+
+def equi(n, m):
+    """양 끝 포함 결정적 등간격 m개 index (0..n-1), 중복 없어야 함."""
+    idx = [int(round(i * (n - 1) / (m - 1))) for i in range(m)]
+    assert len(set(idx)) == m, (n, m, idx)
+    return idx
+
+
+def conditions_for_slab(z0, z1, area):
+    """area: slab 내 slice별 annotation voxel 수(단면적) list. returns dict cond -> absolute slice list (inferior->superior)."""
+    n = z1 - z0 + 1
+    dense = list(range(z0, z1 + 1))
+    dense_note = "all"
+    if n > 85:
+        dense = [z0 + i for i in equi(n, 85)]
+        dense_note = "equispaced85"
+    u8 = [z0 + i for i in equi(n, 8)]
+    if sum(area) > 0:
+        order = sorted(range(n), key=lambda i: (-area[i], i))[:8]
+        o8 = sorted(z0 + i for i in order)
+    else:
+        o8 = list(u8)
+    return {"DENSE": dense, "U8": u8, "O8": o8}, dense_note
+
+
+def cmd_select():
+    os.makedirs(f"{DATA}/raw", exist_ok=True)
+    ids = training_ids()
+    t = tarfile.open(TAR)
+    hashes = {}
+    for cid in ids:
+        for kind in ("images", "labels"):
+            m = t.getmember(f"Task01_BrainTumour/{kind}Tr/{cid}.nii.gz")
+            hashes[f"{kind}/{cid}"] = (sha256(t.extractfile(m).read()), m.size)
+    img_dups = {}
+    for k, (h, _) in hashes.items():
+        if k.startswith("images/"):
+            img_dups.setdefault(h, []).append(k)
+    dup_groups = [v for v in img_dups.values() if len(v) > 1]
+    order = list(ids)
+    random.Random(SEED).shuffle(order)
+    json.dump({"seed": SEED, "n_training": len(ids), "shuffled_order": order,
+               "file_hashes": {k: {"sha256": h, "bytes": s} for k, (h, s) in hashes.items()},
+               "duplicate_image_file_groups": dup_groups, "version": VERSION},
+              open(f"{DATA}/case_order.json", "w"), indent=1)
+    print("n", len(ids), "dup groups", dup_groups)
+
+
+def extract_case(t, cid):
+    ip, lp = case_paths(cid)
+    for kind, p in (("images", ip), ("labels", lp)):
+        if os.path.exists(p):
+            continue
+        b = t.extractfile(f"Task01_BrainTumour/{kind}Tr/{cid}.nii.gz").read()
+        with open(p + ".part", "wb") as f:
+            f.write(b)
+        os.replace(p + ".part", p)
+
+
+def cmd_extract():
+    """고정 순서에서 FLAIR nonzero 범위만으로 적격(6 구간 각 >=8 slice)한 case를 D6, E48 순으로 채운다. mask는 정하는 데 사용하지 않는다."""
+    co = json.load(open(f"{DATA}/case_order.json"))
+    t = tarfile.open(TAR)
+    chosen, skipped = [], []
+    for cid in co["shuffled_order"]:
+        if len(chosen) >= N_D + N_E:
+            break
+        extract_case(t, cid)
+        flair, _, info = load_case(cid)
+        z0, z1 = nonzero_range(flair)
+        slabs = make_slabs(z0, z1)
+        if min(b - a + 1 for a, b in slabs) < MIN_SLAB:
+            skipped.append({"case": cid, "reason": f"slab<{MIN_SLAB}", "range": [z0, z1]})
+            continue
+        chosen.append({"case": cid, "split": "D" if len(chosen) < N_D else "E", "z_range": [z0, z1], "slabs": slabs,
+                       "vmin": float(flair.min()), "vmax": float(flair.max()), "info": info,
+                       "img_sha256": co["file_hashes"][f"images/{cid}"]["sha256"],
+                       "lbl_sha256": co["file_hashes"][f"labels/{cid}"]["sha256"]})
+    json.dump({"chosen": chosen, "skipped": skipped, "version": VERSION}, open(f"{DATA}/cases.json", "w"), indent=1)
+    print("chosen", len(chosen), "skipped", len(skipped))
+
+
+def cmd_build():
+    """구간별 정답·coverage·조건별 slice 선택과 PNG 렌더, requests 원본(manifest) 생성. GT는 manifest_gt.json에만 둔다."""
+    cs = json.load(open(f"{DATA}/cases.json"))["chosen"]
+    os.makedirs(f"{DATA}/png", exist_ok=True)
+    gt, inputs = [], {}
+    for c in cs:
+        flair, mask, _ = load_case(c["case"])
+        ann = mask > 0
+        for si, (a, b) in enumerate(c["slabs"]):
+            area = [int(ann[:, :, k].sum()) for k in range(a, b + 1)]
+            conds, dn = conditions_for_slab(a, b, area)
+            tot = sum(area)
+            row = {"case": c["case"], "split": c["split"], "slab": si, "z0": a, "z1": b, "n_slices": b - a + 1,
+                   "present": bool(tot > 0), "ann_voxels": tot, "n_pos_slices": int(sum(x > 0 for x in area)),
+                   "pos_slice_frac": float(sum(x > 0 for x in area)) / (b - a + 1), "max_slice_area": max(area),
+                   "dense_note": dn, "cond": {}}
+            for cn, sl in conds.items():
+                ar = [area[k - a] for k in sl]
+                row["cond"][cn] = {"slices": sl, "n": len(sl), "cov_pos_slices": int(sum(x > 0 for x in ar)),
+                                   "cov_voxels": int(sum(ar)),
+                                   "cov_max_area": max(ar),
+                                   "cov_frac_voxels": (sum(ar) / tot) if tot else None,
+                                   "cov_frac_pos_slices": (sum(x > 0 for x in ar) / row["n_pos_slices"]) if tot else None,
+                                   "cov_frac_max_area": (max(ar) / max(area)) if tot else None,
+                                   "missed_positive": bool(tot > 0 and sum(ar) == 0)}
+            gt.append(row)
+            for k in sorted({k for sl in conds.values() for k in sl}):
+                p = f"{DATA}/png/{c['case']}_z{k:03d}.png"
+                if not os.path.exists(p):
+                    from PIL import Image
+                    Image.fromarray(render(flair, k, c["vmin"], c["vmax"])).save(p + ".tmp.png")
+                    os.replace(p + ".tmp.png", p)
+                if p not in inputs:
+                    inputs[p] = sha256(open(p, "rb").read())
+    json.dump({"rows": gt, "version": VERSION}, open(f"{DATA}/gt_slabs.json", "w"), indent=1)
+    json.dump(inputs, open(f"{DATA}/png_sha256.json", "w"), indent=1)
+    print("slabs", len(gt), "pos", sum(r["present"] for r in gt), "pngs", len(inputs))
+
+
+if __name__ == "__main__":
+    {"select": cmd_select, "extract": cmd_extract, "build": cmd_build}[sys.argv[1]]()
diff --git a/msd56_run.py b/msd56_run.py
new file mode 100644
index 0000000..6334708
--- /dev/null
+++ b/msd56_run.py
@@ -0,0 +1,461 @@
+"""iter_056 MSD FLAIR 구간 생성 runner (MedGemma 1.5, 다중 영상). GT를 읽지 않는다.
+
+서브명령
+  build-requests --split D|E --out R [--cond-map M]   (GT 접근: O8 준비용. worker는 GT를 읽지 않는다)
+  lock --requests R --out P                            (코드·prompt·config·요청 digest 잠금)
+  worker --requests R --protocol P --out-dir D --worker K
+  launch --requests R --protocol P --out-dir D --gpus 0,1,0,1 [--peak-gb G]
+  verify --requests R --protocol P --out-dir D          (완료 검증)
+
+재사용(제한): rsna_diag/generate.py의 고정 revision 로딩·env 기록·greedy 생성 패턴(pg43_run의 flock claim/record 패턴).
+ 다중 영상 경로, 요청 완전성, 자식 종료 상태, attempt별 비용은 이 파일에서 새로 구현했다.
+"""
+import argparse
+import fcntl
+import glob
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+
+MODEL_ID = "google/medgemma-1.5-4b-it"
+MODEL_REVISION = "91850547d9f0b2fdd21aa7c5f4f3d1a8a52c243b"
+HF_HOME = "/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache"
+CAPS = [512, 2048]
+RUNNER = "msd56_run_v1"
+PROMPT = ("The images are consecutive-or-sampled axial slices of a brain MRI (FLAIR sequence), ordered from inferior to superior. "
+          "Is a glioma-related lesion, including peritumoral edema, visible in the presented axial FLAIR slices? "
+          "Answer with exactly one word: PRESENT or ABSENT.")
+CODE_FILES = ["msd56_run.py", "msd56_data.py"]
+DATA = "results/iter_056/data"
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def canon(o):
+    return json.dumps(o, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def parse_answer(text):
+    """whole-string: 대소문자·주변 공백·끝 punctuation만 정규화. 'PRESENT'/'ABSENT' 외에는 invalid(None)."""
+    t = re.sub(r"[\s]+$|^[\s]+", "", text.replace("<end_of_turn>", "").strip())
+    t = re.sub(r"[\s.!?,;:]+$", "", t).strip().upper()
+    return t if t in ("PRESENT", "ABSENT") else None
+
+
+class RunError(RuntimeError):
+    pass
+
+
+def read_jsonl(path):
+    """완전한 행(개행으로 끝난 행)만 읽는다. 개행 없는 꼬리(비정상 종료의 torn row)는 소유 worker가 시작할 때 repair_tail로 보존·제거한다."""
+    out = []
+    if os.path.exists(path):
+        with open(path) as f:
+            for ln in f:
+                if ln.endswith("\n") and ln.strip():
+                    out.append(json.loads(ln))
+    return out
+
+
+def repair_tail(path):
+    """부분 행(개행 없이 끝난 꼬리)을 별도 파일로 보존하고 잘라낸다."""
+    if not os.path.exists(path):
+        return
+    b = open(path, "rb").read()
+    if not b or b.endswith(b"\n"):
+        return
+    cut = b.rfind(b"\n") + 1
+    open(f"{path}.partial.{int(time.time())}.bin", "wb").write(b[cut:])
+    with open(path, "r+b") as f:
+        f.truncate(cut)
+
+
+_PX_CACHE = {}
+
+
+def image_pixel_sha(paths):
+    """디코드 pixel hash. 프로세스 내 캐시(입력 파일 hash는 load_requests가 시작 시 이미 검증) — 재검증 O(n^2) 방지."""
+    key = tuple(paths)
+    if key not in _PX_CACHE:
+        import numpy as np
+        from PIL import Image
+        h = hashlib.sha256()
+        for p in paths:
+            h.update(np.asarray(Image.open(p).convert("RGB")).tobytes())
+        _PX_CACHE[key] = h.hexdigest()
+    return _PX_CACHE[key]
+
+
+# ---------------- requests ----------------
+def make_rid(images_sha, modality):
+    return sha(canon({"model_revision": MODEL_REVISION, "prompt": sha(PROMPT.encode()), "images": images_sha,
+                      "modality": modality, "runner": RUNNER}).encode())[:32]
+
+
+def cmd_build_requests(a):
+    gt = json.load(open(f"{DATA}/gt_slabs.json"))["rows"]
+    png_sha = json.load(open(f"{DATA}/png_sha256.json"))
+    rows, cmap = {}, []
+    for r in gt:
+        if r["split"] != a.split:
+            continue
+        for cn, c in r["cond"].items():
+            paths = [f"{DATA}/png/{r['case']}_z{k:03d}.png" for k in c["slices"]]
+            ish = [png_sha[p] for p in paths]
+            rid = make_rid(ish, "image")
+            rows.setdefault(rid, {"rid": rid, "modality": "image", "images": paths, "image_file_sha256": ish,
+                                  "prompt": PROMPT, "split": a.split})
+            cmap.append({"case": r["case"], "slab": r["slab"], "cond": cn, "rid": rid})
+    trid = make_rid([], "text")
+    rows[trid] = {"rid": trid, "modality": "text", "images": [], "image_file_sha256": [], "prompt": PROMPT, "split": "ALL"}
+    for r in gt:
+        if r["split"] == a.split:
+            cmap.append({"case": r["case"], "slab": r["slab"], "cond": "TEXT", "rid": trid})
+    ordered = sorted(rows.values(), key=lambda x: x["rid"])
+    with open(a.out, "w") as f:
+        for x in ordered:
+            f.write(json.dumps(x) + "\n")
+    json.dump(cmap, open(a.cond_map, "w"), indent=0)
+    print(f"{a.split}: unique requests {len(ordered)} (cond rows {len(cmap)})")
+
+
+def load_requests(path):
+    rows = [json.loads(ln) for ln in open(path) if ln.strip()]
+    if len({r["rid"] for r in rows}) != len(rows):
+        raise RunError("duplicate rid in requests")
+    for r in rows:
+        if r["rid"] != make_rid(r["image_file_sha256"], r["modality"]) or r["prompt"] != PROMPT:
+            raise RunError(f"rid/prompt mismatch {r['rid']}")
+        if r["modality"] == "image" and len(r["images"]) != len(r["image_file_sha256"]):
+            raise RunError("images/sha length mismatch")
+        for p, h in zip(r["images"], r["image_file_sha256"]):
+            if sha(open(p, "rb").read()) != h:
+                raise RunError(f"image changed on disk: {p}")
+    return rows
+
+
+# ---------------- protocol ----------------
+def file_digests(files):
+    return {f: sha(open(f, "rb").read()) for f in files}
+
+
+def cmd_lock(a):
+    rows = load_requests(a.requests)
+    extra = [x for x in (a.extra or "").split(",") if x]
+    prot = {"runner": RUNNER, "model_id": MODEL_ID, "model_revision": MODEL_REVISION, "caps": CAPS,
+            "prompt_sha256": sha(PROMPT.encode()), "requests_file": a.requests,
+            "requests_sha256": sha(open(a.requests, "rb").read()), "n_requests": len(rows),
+            "code": file_digests(CODE_FILES + extra), "locked_at": time.strftime("%Y-%m-%dT%H:%M:%S")}
+    if os.path.exists(a.out):
+        raise RunError(f"{a.out} exists; refusing to overwrite")
+    open(a.out, "w").write(json.dumps(prot, indent=1))
+    print("locked", a.out)
+
+
+def verify_protocol(path, requests):
+    p = json.load(open(path))
+    for f, d in p["code"].items():
+        if sha(open(f, "rb").read()) != d:
+            raise RunError(f"code digest changed: {f}")
+    if sha(open(requests, "rb").read()) != p["requests_sha256"] or p["requests_file"] != requests:
+        raise RunError("requests digest mismatch")
+    if p["prompt_sha256"] != sha(PROMPT.encode()) or p["model_revision"] != MODEL_REVISION or p["caps"] != CAPS:
+        raise RunError("prompt/model/caps mismatch")
+    return sha(open(path, "rb").read()), p
+
+
+# ---------------- model ----------------
+def load_model():
+    os.environ.setdefault("HF_HOME", HF_HOME)
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    import torch
+    import transformers
+    torch.manual_seed(0)
+    proc = transformers.AutoProcessor.from_pretrained(MODEL_ID, revision=MODEL_REVISION)
+    model = transformers.AutoModelForImageTextToText.from_pretrained(
+        MODEL_ID, revision=MODEL_REVISION, dtype=torch.bfloat16, device_map="cuda")
+    model.eval()
+    return torch, proc, model
+
+
+def env_info(torch, proc, model):
+    import transformers
+    import PIL
+    gc = model.generation_config
+    return {"model_id": MODEL_ID, "model_revision": MODEL_REVISION, "transformers": transformers.__version__,
+            "torch": torch.__version__, "PIL": PIL.__version__, "dtype": str(model.dtype),
+            "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"), "gpu_name": torch.cuda.get_device_name(0),
+            "gpu_uuid": str(torch.cuda.get_device_properties(0).uuid), "eos_token_id": gc.eos_token_id,
+            "generation_config": gc.to_dict(), "chat_template_sha256": sha((proc.chat_template or "").encode()),
+            "image_seq_length": getattr(proc, "image_seq_length", None),
+            "attn_implementation": getattr(model.config.text_config, "_attn_implementation", None), "runner": RUNNER}
+
+
+def build_inputs(proc, row):
+    from PIL import Image
+    content = [{"type": "image", "image": Image.open(p).convert("RGB")} for p in row["images"]]
+    content.append({"type": "text", "text": row["prompt"]})
+    msgs = [{"role": "user", "content": content}]
+    return proc.apply_chat_template(msgs, add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors="pt")
+
+
+def generate(torch, model, inp, cap, eos_ids):
+    x = {k: (v.to("cuda", dtype=torch.bfloat16) if k == "pixel_values" else v.to("cuda")) for k, v in inp.items()}
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    t0 = time.time()
+    with torch.no_grad():
+        out = model.generate(**x, max_new_tokens=cap, do_sample=False)
+    torch.cuda.synchronize()
+    dt = time.time() - t0
+    ids = out[0, x["input_ids"].shape[1]:].tolist()
+    ended = len(ids) > 0 and ids[-1] in eos_ids
+    return {"cap": cap, "suffix_ids": ids, "n_new": len(ids), "ended_eos": bool(ended), "runtime_s": dt,
+            "t_start": t0, "t_end": t0 + dt,
+            "peak_mem_alloc_gb": torch.cuda.max_memory_allocated() / 2**30,
+            "peak_mem_reserved_gb": torch.cuda.max_memory_reserved() / 2**30}
+
+
+def run_request(torch, proc, model, eos_ids, row):
+    inp = build_inputs(proc, row)
+    ids_in = inp["input_ids"][0].tolist()
+    img_tok = model.config.image_token_index
+    n_img_tok = sum(1 for t in ids_in if t == img_tok)
+    if row["modality"] == "text" and ("pixel_values" in inp or n_img_tok):
+        raise RunError("text request has image inputs")
+    if row["modality"] == "image":
+        want = len(row["images"]) * (getattr(proc, "image_seq_length", 256))
+        if inp["pixel_values"].shape[0] != len(row["images"]) or n_img_tok != want:
+            raise RunError(f"image count/token mismatch: pv={tuple(inp['pixel_values'].shape)} tok={n_img_tok} want={want}")
+    attempts = []
+    for cap in CAPS:
+        at = generate(torch, model, inp, cap, eos_ids)
+        attempts.append(at)
+        if at["ended_eos"]:
+            break
+    fin = attempts[-1]
+    for at in attempts:
+        at["suffix_text_raw"] = proc.tokenizer.decode(at["suffix_ids"], skip_special_tokens=False)
+    text = fin["suffix_text_raw"]
+    return {"rid": row["rid"], "modality": row["modality"], "n_images": len(row["images"]),
+            "n_input_tokens": len(ids_in), "n_image_tokens": n_img_tok,
+            "input_ids_sha256": sha(json.dumps(ids_in).encode()),
+            "pixel_values_shape": list(inp["pixel_values"].shape) if "pixel_values" in inp else None,
+            "input_pixel_sha256": image_pixel_sha(row["images"]) if row["images"] else None,
+            "image_file_sha256": row["image_file_sha256"], "suffix_ids": fin["suffix_ids"], "suffix_text_raw": text,
+            "answer": parse_answer(text), "ended_eos": fin["ended_eos"], "final_cap": fin["cap"],
+            "attempts": [{k: v for k, v in at.items() if k != "suffix_ids"} for at in attempts],
+            "runtime_s_total": sum(at["runtime_s"] for at in attempts),
+            "peak_mem_alloc_gb_max": max(at["peak_mem_alloc_gb"] for at in attempts),
+            "peak_mem_reserved_gb_max": max(at["peak_mem_reserved_gb"] for at in attempts)}
+
+
+def validate_existing(out_dir, rows, pdig):
+    by = {r["rid"]: r for r in rows}
+    seen = {}
+    for fn in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl"))):
+        for r in read_jsonl(fn):
+            q = by.get(r.get("rid"))
+            if q is None:
+                raise RunError(f"unexpected record {r.get('rid')} in {fn}")
+            if r["rid"] in seen:
+                raise RunError(f"duplicate record {r['rid']}: {seen[r['rid']]} and {fn}")
+            seen[r["rid"]] = fn
+            if r.get("protocol_digest") != pdig:
+                raise RunError(f"protocol digest mismatch in {fn}")
+            if r.get("image_file_sha256") != q["image_file_sha256"] or r.get("modality") != q["modality"]:
+                raise RunError(f"record/request mismatch {r['rid']}")
+            if q["images"] and r.get("input_pixel_sha256") != image_pixel_sha(q["images"]):
+                raise RunError(f"input pixels changed since record {r['rid']}")
+    return seen
+
+
+class FileLock:
+    def __init__(self, path):
+        self.path, self.f = path, None
+
+    def try_acquire(self):
+        self.f = open(self.path, "a+")
+        try:
+            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            return True
+        except OSError:
+            self.f.close()
+            self.f = None
+            return False
+
+    def release(self):
+        if self.f:
+            fcntl.flock(self.f, fcntl.LOCK_UN)
+            self.f.close()
+
+
+def cmd_worker(a):
+    rows = load_requests(a.requests)
+    pdig, _ = verify_protocol(a.protocol, a.requests)
+    os.makedirs(a.out_dir, exist_ok=True)
+    wl = FileLock(os.path.join(a.out_dir, f"worker{a.worker}.lock"))
+    if not wl.try_acquire():
+        sys.exit(f"worker {a.worker} already running")
+    out = os.path.join(a.out_dir, f"gen_worker{a.worker}.jsonl")
+    repair_tail(out)
+    t_load0 = time.time()
+    torch, proc, model = load_model()
+    t_load = time.time() - t_load0
+    env = env_info(torch, proc, model)
+    eos = env["eos_token_id"]
+    eos_ids = set(eos if isinstance(eos, list) else [eos])
+    envp = os.path.join(a.out_dir, f"worker{a.worker}.env.json")
+    attempt_id = f"{int(time.time())}"
+    with open(envp, "a") as f:
+        f.write(json.dumps({"attempt": attempt_id, "env": env, "load_s": t_load, "t_loaded": time.time(), "pid": os.getpid()}) + "\n")
+    validate_existing(a.out_dir, rows, pdig)
+    cdir = os.path.join(a.out_dir, "claims")
+    os.makedirs(cdir, exist_ok=True)
+    log = open(out + ".log", "a")
+    n_new, t0 = 0, time.time()
+    # 긴 요청(DENSE)을 먼저 배정하지 않는다: rid 정렬 순서 유지
+    for row in rows:
+        if a.max_requests is not None and n_new >= a.max_requests:
+            break
+        cl = FileLock(os.path.join(cdir, row["rid"] + ".claim"))
+        if not cl.try_acquire():
+            continue
+        try:
+            done = validate_existing(a.out_dir, rows, pdig)
+            if row["rid"] in done:
+                continue
+            try:
+                rec = run_request(torch, proc, model, eos_ids, row)
+            except torch.cuda.OutOfMemoryError as e:
+                log.write(json.dumps({"event": "oom", "rid": row["rid"], "n_images": len(row["images"]), "err": str(e)[:200]}) + "\n")
+                log.flush()
+                raise
+            rec.update({"protocol_digest": pdig, "worker": a.worker, "attempt_id": attempt_id, "ts": time.time(),
+                        "gpu_uuid": env["gpu_uuid"]})
+            with open(out, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            n_new += 1
+            log.write(json.dumps({"event": "done", "rid": row["rid"], "n_images": rec["n_images"], "n_out": len(rec["suffix_ids"]),
+                                  "ans": rec["answer"], "eos": rec["ended_eos"], "s": round(rec["runtime_s_total"], 2),
+                                  "peak_gb": round(rec["peak_mem_alloc_gb_max"], 2), "elapsed": round(time.time() - t0, 1)}) + "\n")
+            log.flush()
+        finally:
+            cl.release()
+    json.dump({"worker": a.worker, "attempt": attempt_id, "n_new": n_new, "load_s": t_load, "elapsed_s": time.time() - t0},
+              open(os.path.join(a.out_dir, f"worker{a.worker}.attempt_{attempt_id}.done.json"), "w"))
+    print(f"worker {a.worker}: {n_new} new", flush=True)
+
+
+def gpu_free_mib():
+    o = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used,memory.total", "--format=csv,noheader,nounits"],
+                       capture_output=True, text=True, check=True).stdout
+    return {int(l.split(",")[0]): int(l.split(",")[2]) - int(l.split(",")[1]) for l in o.strip().splitlines()}
+
+
+def cmd_launch(a):
+    rows = load_requests(a.requests)
+    verify_protocol(a.protocol, a.requests)
+    gpus = [int(x) for x in a.gpus.split(",")]
+    allowed = {int(x) for x in os.environ.get("CUDA_VISIBLE_DEVICES", "0,1").split(",")}
+    if not set(gpus) <= allowed:
+        sys.exit(f"gpus {gpus} not in allowed {allowed}")
+    free = gpu_free_mib()
+    need = {}
+    for g in gpus:
+        need[g] = need.get(g, 0) + (a.peak_gb + 2.0) * 1024
+    for g, n in need.items():
+        if n > free[g]:
+            sys.exit(f"GPU {g}: need {n:.0f} MiB (peak {a.peak_gb} GB + 2GiB per worker) > free {free[g]} MiB")
+    os.makedirs(a.out_dir, exist_ok=True)
+    ll = FileLock(os.path.join(a.out_dir, "launch.lock"))
+    if not ll.try_acquire():
+        sys.exit("launcher already running")
+    t0 = time.time()
+    procs = []
+    for k, g in enumerate(gpus):
+        env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(g))
+        cmd = [sys.executable, "msd56_run.py", "worker", "--requests", a.requests, "--protocol", a.protocol,
+               "--out-dir", a.out_dir, "--worker", str(k + a.worker_offset)]
+        if a.max_requests is not None:
+            cmd += ["--max-requests", str(a.max_requests)]
+        lg = open(os.path.join(a.out_dir, f"worker{k + a.worker_offset}.stdout.log"), "a")
+        procs.append((k + a.worker_offset, g, subprocess.Popen(cmd, env=env, stdout=lg, stderr=subprocess.STDOUT)))
+    samples = []
+    while any(p.poll() is None for _, _, p in procs):
+        time.sleep(5)
+        try:
+            o = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used", "--format=csv,noheader,nounits"],
+                               capture_output=True, text=True).stdout
+            samples.append({"t": time.time(), "used_mib": {int(l.split(",")[0]): int(l.split(",")[1]) for l in o.strip().splitlines()}})
+        except Exception:
+            pass
+    rcs = {k: p.returncode for k, _, p in procs}
+    peak = {}
+    for s in samples:
+        for g, u in s["used_mib"].items():
+            peak[g] = max(peak.get(g, 0), u)
+    comp = {"gpus": gpus, "worker_exit_codes": rcs, "wall_s": time.time() - t0, "t_start": t0, "t_end": time.time(),
+            "peak_gpu_used_mib_sampled": peak, "n_samples": len(samples), "peak_gb_assumed": a.peak_gb}
+    name = f"launch_{int(t0)}.json"
+    json.dump(comp, open(os.path.join(a.out_dir, name), "w"), indent=1)
+    ll.release()
+    print(comp)
+    if any(rc != 0 for rc in rcs.values()):
+        sys.exit(1)
+
+
+def cmd_verify(a):
+    rows = load_requests(a.requests)
+    pdig, _ = verify_protocol(a.protocol, a.requests)
+    seen = validate_existing(a.out_dir, rows, pdig)
+    miss = [r["rid"] for r in rows if r["rid"] not in seen]
+    launches = sorted(glob.glob(os.path.join(a.out_dir, "launch_*.json")))
+    bad = [(f, json.load(open(f))["worker_exit_codes"]) for f in launches
+           if any(rc != 0 for rc in json.load(open(f))["worker_exit_codes"].values())]
+    res = {"n_requests": len(rows), "n_records": len(seen), "missing": miss, "launches": launches, "bad_exit_launches": bad,
+           "ok": not miss and len(seen) == len(rows)}
+    print(json.dumps({k: (v if k != "missing" else len(v)) for k, v in res.items()}))
+    if not res["ok"]:
+        sys.exit(1)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    b = sp.add_parser("build-requests")
+    b.add_argument("--split", required=True)
+    b.add_argument("--out", required=True)
+    b.add_argument("--cond-map", required=True)
+    lk = sp.add_parser("lock")
+    lk.add_argument("--requests", required=True)
+    lk.add_argument("--out", required=True)
+    lk.add_argument("--extra", default="")
+    for n in ("worker", "launch", "verify"):
+        s = sp.add_parser(n)
+        s.add_argument("--requests", required=True)
+        s.add_argument("--protocol", required=True)
+        s.add_argument("--out-dir", required=True)
+        if n == "worker":
+            s.add_argument("--worker", type=int, required=True)
+            s.add_argument("--max-requests", type=int, default=None)
+        if n == "launch":
+            s.add_argument("--gpus", required=True)
+            s.add_argument("--peak-gb", type=float, default=14.0)
+            s.add_argument("--worker-offset", type=int, default=0)
+            s.add_argument("--max-requests", type=int, default=None)
+    a = ap.parse_args()
+    {"build-requests": cmd_build_requests, "lock": cmd_lock, "worker": cmd_worker, "launch": cmd_launch,
+     "verify": cmd_verify}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/s64_data.py b/s64_data.py
new file mode 100644
index 0000000..44ef5da
--- /dev/null
+++ b/s64_data.py
@@ -0,0 +1,118 @@
+"""iter_064 target-slice 대조 자료: 기존 MSD D6/E48(cases.json)에서 case별 양성 P/음성 N slice를 mask로 고정 규칙 선택하고
+S/R/C 요청을 만든다. msd56_data.py(원 SHA da6e755 반입)는 load_case/render/mask_slice만 사용한다.
+
+선택 규칙(결과 보기 전 고정)
+ P: mask>0 단면적 최대 axial slice(동률 작은 z). 합>0이어야 함.
+ N: mask 합=0 slice 중 FLAIR nonzero pixel 수 최대(동률 작은 z). 합=0이어야 함.
+ 둘 중 하나가 없으면 부적격(대체 없음).
+GT(정답)는 labels_*.json에만 둔다. 요청에는 case ID/좌표/slice index를 넣지 않고 영상은 anon 파일명으로 저장한다.
+서브명령: audit | build --split D|E
+"""
+import hashlib, json, os, sys
+import numpy as np
+import msd56_data as MD
+
+ROOT = 'results/iter_064'
+SRC = 'results/iter_056/data'
+PROMPT = ('The images are axial FLAIR slices from the same brain MRI. Consider only image {k} in the supplied order. '
+          'Is a glioma-related lesion, including peritumoral edema, visible in that image? '
+          'Answer with exactly one word: PRESENT or ABSENT.')
+CONDS = ['S', 'R1', 'R2', 'C1', 'C2']
+
+
+def sha_file(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for ch in iter(lambda: f.read(1 << 22), b''):
+            h.update(ch)
+    return h.hexdigest()
+
+
+def sha_b(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def select_targets(flair, mask):
+    """returns (P_z, N_z, info) 또는 부적격 시 (None|z, None|z, info). 순수 함수(합성 검사용)."""
+    ann = mask > 0
+    areas = np.array([int(ann[:, :, k].sum()) for k in range(ann.shape[2])])
+    nz = np.array([int((flair[:, :, k] != 0).sum()) for k in range(flair.shape[2])])
+    P = None
+    if areas.max() > 0:
+        P = int(np.flatnonzero(areas == areas.max())[0])
+    zero = np.flatnonzero(areas == 0)
+    N = None
+    if len(zero):
+        zn = nz[zero]
+        N = int(zero[np.flatnonzero(zn == zn.max())[0]])
+        if nz[N] == 0:
+            N = None
+    return P, N, {'area_P': int(areas[P]) if P is not None else None, 'area_N': int(areas[N]) if N is not None else None,
+                  'nz_P': int(nz[P]) if P is not None else None, 'nz_N': int(nz[N]) if N is not None else None}
+
+
+def png_name(cid, kind, z):
+    # 영상 파일명에 case ID를 쓰지 않는다 (processor는 경로를 보지 않지만 기록 분리).
+    return f'{ROOT}/png/{sha_b(f"{cid}|{kind}|{z}".encode())[:16]}.png'
+
+
+def build_requests(rows):
+    """rows: [{case, split, P:{png,z}, N:{png,z}}]. 요청과 정답 생성(순수)."""
+    reqs, labels = [], {}
+    for r in rows:
+        for tk, ok in (('P', 'N'), ('N', 'P')):
+            t, o = r[tk]['png'], r[ok]['png']
+            spec = {'S': ([t], 1), 'R1': ([t, t], 1), 'R2': ([t, t], 2), 'C1': ([t, o], 1), 'C2': ([o, t], 2)}
+            for cond in CONDS:
+                ims, k = spec[cond]
+                rid = f"{r['case']}__{tk}__{cond}"
+                reqs.append({'rid': rid, 'case': r['case'], 'target': tk, 'cond': cond, 'k': k, 'images': ims,
+                             'prompt': PROMPT.format(k=k)})
+                labels[rid] = {'answer': 'PRESENT' if tk == 'P' else 'ABSENT', 'case': r['case'], 'target': tk, 'cond': cond}
+    return reqs, labels
+
+
+def cmd_build(split):
+    cs = [c for c in json.load(open(f'{SRC}/cases.json'))['chosen'] if c['split'] == split]
+    co = json.load(open(f'{SRC}/case_order.json'))
+    os.makedirs(f'{ROOT}/png', exist_ok=True)
+    os.makedirs(f'{ROOT}/data', exist_ok=True)
+    from PIL import Image
+    rows, inelig, tm = [], [], []
+    for c in cs:
+        cid = c['case']
+        ip, lp = MD.case_paths(cid)
+        # raw hash 대조 (cases.json / case_order.json)
+        assert MD.sha256(open(ip, 'rb').read()) == c['img_sha256'] == co['file_hashes'][f'images/{cid}']['sha256'], cid
+        assert MD.sha256(open(lp, 'rb').read()) == c['lbl_sha256'] == co['file_hashes'][f'labels/{cid}']['sha256'], cid
+        flair, mask, info = MD.load_case(cid)
+        assert info['shape'] == c['info']['shape'] and abs(float(flair.min()) - c['vmin']) < 1e-4 and abs(float(flair.max()) - c['vmax']) < 1e-4
+        P, N, inf = select_targets(flair, mask)
+        if P is None or N is None:
+            inelig.append({'case': cid, 'P': P, 'N': N, 'info': inf})
+            continue
+        ent = {'case': cid, 'split': split, 'img_sha256': c['img_sha256'], 'lbl_sha256': c['lbl_sha256'], **inf}
+        row = {'case': cid}
+        for kind, z in (('P', P), ('N', N)):
+            p = png_name(cid, kind, z)
+            Image.fromarray(MD.render(flair, z, c['vmin'], c['vmax'])).save(p + '.tmp.png')
+            os.replace(p + '.tmp.png', p)
+            row[kind] = {'png': p, 'z': z}
+            ent[f'{kind}_z'] = z
+            ent[f'{kind}_png'] = p
+            ent[f'{kind}_png_sha256'] = sha_file(p)
+            ent[f'{kind}_mask_sum'] = int(MD.mask_slice(mask, z).sum())
+        assert ent['P_mask_sum'] > 0 and ent['N_mask_sum'] == 0, cid
+        rows.append(row); tm.append(ent)
+    reqs, labels = build_requests(rows)
+    with open(f'{ROOT}/data/requests_{split}.jsonl', 'w') as f:
+        for r in reqs:
+            f.write(json.dumps(r) + '\n')
+    json.dump(labels, open(f'{ROOT}/data/labels_{split}.json', 'w'), indent=1)
+    json.dump({'targets': tm, 'ineligible': inelig, 'rule': 'P=max mask area (tie small z); N=mask sum 0 with max FLAIR nonzero (tie small z)',
+               'prompt': PROMPT}, open(f'{ROOT}/data/target_manifest_{split}.json', 'w'), indent=1)
+    print(split, 'eligible', len(tm), 'ineligible', len(inelig), 'requests', len(reqs))
+
+
+if __name__ == '__main__':
+    cmd_build(sys.argv[2]) if sys.argv[1] == 'build' else sys.exit('usage')
diff --git a/s64_eval.py b/s64_eval.py
new file mode 100644
index 0000000..9f0ff8c
--- /dev/null
+++ b/s64_eval.py
@@ -0,0 +1,157 @@
+"""iter_064 평가: 모델별 S/R/C BA, sens/spec, invalid·비EOS, L_count/L_content/L_total(case paired bootstrap seed64, 10,000).
+진입 전 s64_run verify 통과(verify.json의 protocol digest·파일 hash 일치)를 요구한다. invalid는 오답으로 계산(주분석), valid-only는 보조.
+사용: python s64_eval.py --requests R --labels L --target-manifest M --gen-dir D --verify D/verify.json --model m --out report.json"""
+import argparse, glob, hashlib, json, os, sys
+import numpy as np
+import msd56_run as M
+import s64_run as R
+
+SEED, NB = 64, 10000
+
+
+def ba(y, p):
+    """y,p in {0,1} 배열(1=PRESENT). balanced accuracy."""
+    y, p = np.asarray(y), np.asarray(p)
+    return 0.5 * ((p[y == 1] == 1).mean() + (p[y == 0] == 0).mean())
+
+
+def load(a):
+    v = json.load(open(a.verify))
+    assert v['n_problems'] == 0 and v['n_records'] == v['n_requests'], 'verify not clean'
+    for f, h in v['record_file_sha256'].items():
+        assert R.sha_file(f) == h, 'record file changed after verify ' + f
+    lab = json.load(open(a.labels))
+    reqs = {r['rid']: r for r in R.read_jsonl(a.requests)}
+    recs = {}
+    for f in sorted(glob.glob(f'{a.gen_dir}/worker*.jsonl')):
+        for r in R.read_jsonl(f):
+            assert r['rid'] not in recs, 'dup'
+            recs[r['rid']] = r
+    assert set(recs) == set(reqs) == set(lab)
+    return lab, reqs, recs, v
+
+
+def table(lab, recs):
+    """case -> cond -> target -> dict(pred in {1,0,None}, correct, eos, text)"""
+    T = {}
+    for rid, r in recs.items():
+        l = lab[rid]
+        txt = r['attempts'][-1]['text']
+        pa = M.parse_answer(txt)
+        pred = None if pa is None else (1 if pa == 'PRESENT' else 0)
+        gt = 1 if l['answer'] == 'PRESENT' else 0
+        T.setdefault(l['case'], {}).setdefault(l['cond'], {})[l['target']] = {
+            'pred': pred, 'gt': gt, 'correct': int(pred == gt), 'eos': bool(r['attempts'][-1]['ended_eos']), 'text': txt, 'retried': len(r['attempts']) > 1}
+    return T
+
+
+GROUPS = {'S': ['S'], 'R': ['R1', 'R2'], 'C': ['C1', 'C2'], 'R1': ['R1'], 'R2': ['R2'], 'C1': ['C1'], 'C2': ['C2']}
+
+
+def case_arrays(T, cases, valid_only=False):
+    """returns dict group -> (sens_c, spec_c) arrays per case (위치 평균). valid_only면 모든 비교 응답이 valid인 case만(호출자가 cases 제한)."""
+    out = {}
+    for g, cs in GROUPS.items():
+        se = np.array([np.mean([T[c][k]['P']['correct'] for k in cs]) for c in cases])
+        sp = np.array([np.mean([T[c][k]['N']['correct'] for k in cs]) for c in cases])
+        out[g] = (se, sp)
+    return out
+
+
+def ba_arr(arr, idx=None):
+    se, sp = arr
+    if idx is not None:
+        se, sp = se[idx], sp[idx]
+    return 0.5 * (se.mean() + sp.mean())
+
+
+def boot(arrs, pairs, n_cases):
+    rng = np.random.default_rng(SEED)
+    idx = rng.integers(0, n_cases, size=(NB, n_cases))
+    res = {}
+    for name, (g1, g2) in pairs.items():
+        d = []
+        for g in (g1, g2):
+            se, sp = arrs[g]
+            d.append(0.5 * (se[idx].mean(axis=1) + sp[idx].mean(axis=1)))
+        diff = d[0] - d[1]
+        res[name] = {'ci95': [float(np.percentile(diff, 2.5)), float(np.percentile(diff, 97.5))]}
+    return res
+
+
+PAIRS = {'L_count': ('S', 'R'), 'L_content': ('R', 'C'), 'L_total': ('S', 'C'), 'L_content_pos1': ('R1', 'C1'), 'L_content_pos2': ('R2', 'C2')}
+
+
+def analyze(T, valid_only=False):
+    cases = sorted(T)
+    if valid_only:
+        cases = [c for c in cases if all(T[c][k][t]['pred'] is not None for k in T[c] for t in T[c][k])]
+    arrs = case_arrays(T, cases)
+    out = {'n_cases': len(cases), 'groups': {}, 'diffs': {}}
+    for g, a in arrs.items():
+        out['groups'][g] = {'BA': float(ba_arr(a)), 'sens': float(a[0].mean()), 'spec': float(a[1].mean())}
+    point = {k: out['groups'][g1]['BA'] - out['groups'][g2]['BA'] for k, (g1, g2) in PAIRS.items()}
+    cis = boot(arrs, PAIRS, len(cases)) if len(cases) else {}
+    for k in PAIRS:
+        out['diffs'][k] = {'point': point[k], **cis.get(k, {})}
+    # case 분포: R보다 C가 나쁜 case 수 (case BA 기준)
+    ba_c = {g: 0.5 * (arrs[g][0] + arrs[g][1]) for g in arrs}
+    out['cases_C_worse_than_R'] = int((ba_c['R'] - ba_c['C'] > 0).sum())
+    out['cases_C_better_than_R'] = int((ba_c['R'] - ba_c['C'] < 0).sum())
+    out['cases_R_worse_than_S'] = int((ba_c['S'] - ba_c['R'] > 0).sum())
+    out['position_diff_both_positive'] = bool(point['L_content_pos1'] > 0 and point['L_content_pos2'] > 0)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    for k in ('requests', 'labels', 'target-manifest', 'gen-dir', 'verify', 'model', 'out'):
+        ap.add_argument('--' + k, required=True)
+    a = ap.parse_args()
+    a.target_manifest = getattr(a, 'target_manifest')
+    assert not os.path.exists(a.out), 'report exists'
+    lab, reqs, recs, v = load(a)
+    T = table(lab, recs)
+    rep = {'model': a.model, 'requests_sha256': R.sha_file(a.requests), 'labels_sha256': R.sha_file(a.labels), 'verify_sha256': R.sha_file(a.verify),
+           'protocol_digest': v['protocol_digest'], 'seed': SEED, 'n_boot': NB}
+    rep['primary_invalid_as_wrong'] = analyze(T)
+    rep['conditional_all_valid_cases'] = analyze(T, valid_only=True)
+    # 형식·cap
+    fmt = {}
+    for g in ('S', 'R1', 'R2', 'C1', 'C2'):
+        rows = [T[c][g][t] for c in T for t in ('P', 'N')]
+        fmt[g] = {'n': len(rows), 'invalid': sum(r['pred'] is None for r in rows), 'non_eos_final': sum(not r['eos'] for r in rows),
+                  'retried_2048': sum(r['retried'] for r in rows),
+                  'exact_PRESENT_ABSENT_uppercase': sum(r['text'].strip() in ('PRESENT', 'ABSENT') for r in rows)}
+    rep['format'] = fmt
+    # P/N·위치별 정답률, confusion
+    byt = {}
+    for g in ('S', 'R1', 'R2', 'C1', 'C2'):
+        for t in ('P', 'N'):
+            rows = [T[c][g][t] for c in T]
+            byt[f'{g}_{t}'] = {'acc': float(np.mean([r['correct'] for r in rows])), 'pred_present': sum(r['pred'] == 1 for r in rows),
+                               'pred_absent': sum(r['pred'] == 0 for r in rows), 'invalid': sum(r['pred'] is None for r in rows)}
+    rep['by_target_cond'] = byt
+    # S 정답 사례(target 단위)에서 C가 틀리는 비율 (보조, 사전 충분성 집단 아님)
+    s_ok = [(c, t) for c in T for t in ('P', 'N') if T[c]['S'][t]['correct']]
+    rep['aux_S_correct_then_C_wrong'] = {'n_S_correct_targets': len(s_ok),
+        'C_wrong_frac_pos_avg': float(np.mean([1 - np.mean([T[c][k][t]['correct'] for k in ('C1', 'C2')]) for c, t in s_ok])) if s_ok else None,
+        'R_wrong_frac_pos_avg': float(np.mean([1 - np.mean([T[c][k][t]['correct'] for k in ('R1', 'R2')]) for c, t in s_ok])) if s_ok else None}
+    # routing 동일성: S 출력 공유 근거(요청 k번째 영상 == S 영상)
+    rep['routing'] = {'rule': 'image index k in prompt -> that file only == S input', 'same_image_requests': sum(
+        R.sha_file(r['images'][r['k'] - 1]) == R.sha_file(reqs[f"{r['case']}__{r['target']}__S"]['images'][0]) for r in reqs.values()),
+        'n_requests': len(reqs), 'note': 'routed 입력은 S 입력과 동일 파일/처리 tensor(tech 검사); routed 성능=S 출력 공유로 정의, 별도 생성 없음'}
+    # 비용(실측): 조건별 평균 입력 token·요청 처리 시간
+    cost = {}
+    for g in ('S', 'R1', 'R2', 'C1', 'C2'):
+        rs = [recs[r] for r in recs if lab[r]['cond'] == g]
+        cost[g] = {'mean_input_tokens': float(np.mean([r['n_input_tokens'] for r in rs])), 'mean_read_to_flush_s': float(np.mean([r['total_read_to_flush_s'] for r in rs])),
+                   'mean_gen_s': float(np.mean([sum(x['runtime_s'] for x in r['attempts']) for r in rs]))}
+    rep['cost_measured_per_request'] = cost
+    json.dump(rep, open(a.out, 'w'), indent=1)
+    p = rep['primary_invalid_as_wrong']
+    print(a.model, {g: round(p['groups'][g]['BA'], 4) for g in ('S', 'R', 'C')}, {k: round(v['point'], 4) for k, v in p['diffs'].items() if k in ('L_count', 'L_content', 'L_total')})
+
+
+if __name__ == '__main__':
+    main()
