--- /dev/null
+++ b/mr127_assets.py
@@ -0,0 +1,81 @@
+"""공식 FreeSurfer annex 가중치를 고정 SHA로 확보하고 UCL 공식 소스를 분리한다."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import time
+import zipfile
+import requests
+from mr127_select import save, sha
+
+ROOT=Path('/home/test/.local/share/medgemma/mr_rate/iter127')
+FS_REV='4f8728e5132e8d39a8f1bf3d24d15fed62f4fc9d'
+UCL_REV='2a2aa3bbfccb83f8253a51ca8b329b9938a2646d'
+SOURCE=ROOT/'SynthSeg'
+ENVPY=Path('results/environments/synthseg125/bin/python').absolute()
+
+
+def main():
+    ROOT.mkdir(parents=True,exist_ok=True)
+    attempts=[]
+    # 먼저 원 README에 명시된 UCL 배포 링크의 실제 상태를 기록한다.
+    urls=['https://liveuclac-my.sharepoint.com/:u:/g/personal/rmappmb_ucl_ac_uk/EctEe3hOP8dDh1hYHlFS_rUBo80yFg7MQY5WnagHlWcS6A?e=e8bK0f',
+          'https://liveuclac-my.sharepoint.com/:f:/g/personal/rmappmb_ucl_ac_uk/EtlNnulBSUtAvOP6S99KcAIBYzze7jTPsmFk2_iHqKDjEw?e=rBP0RO']
+    for u in urls:
+        r=requests.get(u,stream=True,timeout=40)
+        attempts.append(dict(url=u,final_url=r.url,status=r.status_code))
+        r.close()
+    assert not SOURCE.exists()
+    SOURCE.mkdir()
+    archive=Path('results/external/synthseg_2a2aa3b.zip')
+    files={}
+    with zipfile.ZipFile(archive) as z:
+        prefix='SynthSeg-'+UCL_REV+'/'
+        for info in z.infolist():
+            assert info.filename.startswith(prefix)
+            rel=Path(info.filename[len(prefix):])
+            assert not rel.is_absolute() and '..' not in rel.parts
+            assert (info.external_attr>>16)&0o170000 != 0o120000
+            if info.is_dir() or not rel.parts or rel.parts[0]=='models': continue
+            dest=SOURCE/rel
+            dest.parent.mkdir(parents=True,exist_ok=True)
+            with z.open(info) as a,dest.open('xb') as b: shutil.copyfileobj(a,b)
+            files[str(dest)]=sha(dest)
+    weights={}
+    for name in ['synthseg_2.0.h5','synthseg_qc_2.0.h5']:
+        pointer_url=f'https://raw.githubusercontent.com/freesurfer/freesurfer/{FS_REV}/mri_synthseg/{name}'
+        r=requests.get(pointer_url,timeout=40)
+        r.raise_for_status()
+        pointer=r.text.strip()
+        key=pointer.split('/')[-1]
+        m=re.fullmatch(r'SHA256E-s(\d+)--([0-9a-f]{64})\.0\.h5',key)
+        assert m, pointer
+        size=int(m[1]); digest=m[2]
+        h=hashlib.md5(key.encode()).hexdigest()
+        u=f'https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/repo/annex.git/annex/objects/{h[:3]}/{h[3:6]}/{key}/{key}'
+        dst=SOURCE/'models'/name
+        dst.parent.mkdir(exist_ok=True)
+        t=time.monotonic()
+        with requests.get(u,stream=True,timeout=90) as response:
+            response.raise_for_status()
+            with dst.open('xb') as f:
+                for chunk in response.iter_content(4<<20): f.write(chunk)
+            assert dst.stat().st_size==size and sha(dst)==digest
+            weights[name]=dict(path=str(dst),size=size,sha256=digest,url=u,final_url=response.url,
+                 pointer_url=pointer_url,pointer=pointer,pointer_sha256=hashlib.sha256(r.content).hexdigest(),
+                 seconds=time.monotonic()-t,etag=response.headers.get('ETag'))
+        print('verified',name,size,flush=True)
+    freeze=subprocess.run([str(ENVPY),'-m','pip','freeze'],capture_output=True,text=True,check=True)
+    save('results/iter_127/assets.json',dict(created_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),
+         ucl_revision=UCL_REV,freesurfer_revision=FS_REV,ucl_archive=str(archive),ucl_archive_sha256=sha(archive),
+         source_files=files,weights=weights,access_attempts=attempts,environment_python=str(ENVPY),
+         environment_reused_without_modification=True,pip_freeze=freeze.stdout,
+         source_license=(SOURCE/'LICENSE.txt').read_text(),
+         training_overlap='합성 입력으로 학습한 공개 모델. MR-RATE 환자별 학습·선택 노출은 미검증.',
+         source_sha256=sha(__file__)))
+
+
+if __name__=='__main__': main()
diff --git a/mr127_seg.py b/mr127_seg.py
new file mode 100644
index 0000000..57b3694
--- /dev/null
+++ b/mr127_seg.py
@@ -0,0 +1,159 @@
+"""고정 SynthSeg2.0 기술 실행. stage 잠금, GPU mapping, raw/volume/QC 검증 및 종료 보존."""
+import argparse
+import csv
+import fcntl
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+import nibabel as nib
+import numpy as np
+from mr127_select import read,save,sha,OUT
+from mr127_assets import ROOT,SOURCE,ENVPY
+
+
+def gpu_info():
+    rows=subprocess.check_output(['nvidia-smi','--query-gpu=index,uuid,memory.total,memory.used,memory.free','--format=csv,noheader,nounits'],text=True)
+    return [dict(index=p[0].strip(),uuid=p[1].strip(),total_mib=int(p[2]),used_mib=int(p[3]),free_mib=int(p[4]))
+            for p in csv.reader(rows.splitlines())]
+
+
+def csv_result(p):
+    with open(p) as f: rows=list(csv.reader(f))
+    assert len(rows)==2 and len(rows[0])==len(rows[1]),(str(p),rows)
+    out={k:float(v) for k,v in zip(rows[0][1:],rows[1][1:])}
+    assert len(out)==len(rows[0])-1 and all(np.isfinite(list(out.values())))
+    return out
+
+
+def verify_result(directory):
+    segmentation=nib.load(directory/'seg.nii.gz')
+    vox=np.asarray(segmentation.dataobj)
+    vol=csv_result(directory/'vol.csv'); qc=csv_result(directory/'qc.csv')
+    keys=['left lateral ventricle','right lateral ventricle','total intracranial']
+    assert all(k in vol and vol[k]>0 for k in keys), ('공식 부피 누락/0',vol)
+    assert np.isfinite(vox).all() and np.any(vox) and np.isin(vox,[4,43]).any(), 'zero mask'
+    assert np.allclose(segmentation.header.get_zooms()[:3],1,atol=1e-5)
+    assert np.isfinite(segmentation.affine).all()
+    assert all(0<=v<=1 for v in qc.values())
+    return dict(volumes_mm3=vol,qc_scores=qc,S=(vol[keys[0]]+vol[keys[1]])/vol[keys[2]],
+                foreground_voxels=int(np.count_nonzero(vox)),left_voxels=int(np.count_nonzero(vox==4)),
+                right_voxels=int(np.count_nonzero(vox==43)),shape=list(vox.shape),affine=segmentation.affine.tolist(),
+                artifacts={str(directory/n):sha(directory/n) for n in ['seg.nii.gz','vol.csv','qc.csv']})
+
+
+def main(stage):
+    out=Path('results/iter_127/seg')/stage
+    out.mkdir(parents=True,exist_ok=True)
+    assets=read('results/iter_127/assets.json')
+    inp=read(OUT/'tech_inputs.json')
+    assert inp['selection_sha256']==sha(OUT/'selection_lock.json')
+    for p,h in assets['source_files'].items(): assert sha(p)==h,p
+    for v in assets['weights'].values(): assert sha(v['path'])==v['sha256']
+    allowed=os.environ.get('CUDA_VISIBLE_DEVICES','').split(',')
+    assert len(allowed)==len(set(allowed)) and all(g.isdigit() for g in allowed)
+    fs_mode=stage.startswith('fs_')
+    fs_assets=read('results/iter_127/fs_assets.json') if fs_mode else None
+    if fs_mode:
+        for p,h in fs_assets['files'].items():assert sha(p)==h,p
+    selected=['7ISDTZ2JVG','5SWPQWD3DD'] if stage.endswith('pilot') else [s for s in inp['inputs'] if s not in ['7ISDTZ2JVG','5SWPQWD3DD']]
+    if stage.endswith('rest'):
+        prior=read(f'results/iter_127/seg/{stage[:-4]+"pilot"}/completion.json')
+        assert prior['status']=='complete' and prior['checks_passed']
+        for p,h in prior['artifacts'].items(): assert sha(p)==h
+    with (out/'stage.lock').open('a') as lock:
+        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+        attempts=len(list(out.glob('launch_*.json')))
+        tag=f'{attempts:03d}'
+        cfg=dict(stage=stage,selected=selected,inputs_sha256=sha(OUT/'tech_inputs.json'),
+                 assets_sha256=sha('results/iter_127/assets.json'),code={p:sha(p) for p in ['mr127_seg.py','mr127_seg_entry.py']},
+                 official_flags=['--vol','--qc','--threads','4'],version='2.0 default',allowed_physical_gpus=allowed,
+                 backend='FreeSurfer official' if fs_mode else 'UCL official',gpu_memory_limit_mib=20000,
+                 fs_assets_sha256=sha('results/iter_127/fs_assets.json') if fs_mode else None,
+                 mapping={str(i):g for i,g in enumerate(allowed)})
+        save(out/f'launch_{tag}.json',cfg)
+        pending=list(selected); active={}; done={}; failures={}; peaks={g:0 for g in allowed}
+        t0=time.monotonic(); stopped=False
+        def stop(sig,frame):
+            nonlocal stopped
+            stopped=True
+            for p,_,_,_ in active.values(): p.terminate()
+        old_handlers={s:signal.signal(s,stop) for s in [signal.SIGTERM,signal.SIGINT]}
+        try:
+            with (out/f'resources_{tag}.jsonl').open('x') as resources:
+                while pending or active:
+                    gpu=gpu_info()
+                    resources.write(json.dumps(dict(time=time.time(),gpus=gpu))+'\n');resources.flush()
+                    # pending 큐가 비어도 실행 중인 모든 GPU의 peak를 집계한다.
+                    for g in gpu:
+                        if g['index'] in peaks:
+                            peaks[g['index']]=max(peaks[g['index']],g['used_mib'])
+                    available=sorted([g for g in gpu if g['index'] in allowed],key=lambda g:g['free_mib'],reverse=True)
+                    occupied={v[2] for v in active.values()}
+                    for g in available:
+                        if not pending or stopped: break
+                        if g['index'] in occupied: continue
+                        assert g['free_mib']>=20000, ('기술 실행 여유 부족',g)
+                        s=pending.pop(0)
+                        directory=ROOT/'seg'/stage/s/f'attempt_{tag}'
+                        directory.mkdir(parents=True,exist_ok=False)
+                        v=inp['inputs'][s]
+                        for x in v['files'].values(): assert sha(x['path'])==x['sha256']
+                        python=ROOT/'env_freesurfer/bin/python' if fs_mode else ENVPY
+                        script=ROOT/'freesurfer/mri_synthseg.py' if fs_mode else SOURCE/'scripts/commands/SynthSeg_predict.py'
+                        cmd=[str(python),str(Path('mr127_seg_entry.py').absolute()),str(script),
+                             '--i',v['files']['img.nii.gz']['path'],'--o',str(directory/'seg.nii.gz'),
+                             '--vol',str(directory/'vol.csv'),'--qc',str(directory/'qc.csv'),'--threads','4']
+                        env=dict(os.environ,CUDA_VISIBLE_DEVICES=g['index'],TF_FORCE_GPU_ALLOW_GROWTH='true',
+                                 TF_CPP_MIN_LOG_LEVEL='1',PYTHONDONTWRITEBYTECODE='1',PYTHONUNBUFFERED='1',SYNTHSEG_GPU_LIMIT_MIB='20000')
+                        if fs_mode:
+                            cmd.append('--noaddctab')
+                            env['FREESURFER_HOME']=str(ROOT/'freesurfer')
+                            env['TF_USE_LEGACY_KERAS']='1'
+                        libs=sorted(str(p) for p in ENVPY.parent.parent.glob('lib/python*/site-packages/nvidia/*/lib'))
+                        env['LD_LIBRARY_PATH']=':'.join(libs+[str(ENVPY.parent.parent/'lib')]+[env.get('LD_LIBRARY_PATH','')])
+                        h=(directory/'official.log').open('x')
+                        save(directory/'execution.json',dict(command=cmd,physical_gpu=g['index'],logical_gpu_inside_child=0,
+                             input=v,config=cfg,environment={k:env[k] for k in ['CUDA_VISIBLE_DEVICES','LD_LIBRARY_PATH','TF_FORCE_GPU_ALLOW_GROWTH']},
+                             started_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())))
+                        p=subprocess.Popen(cmd,env=env,stdout=h,stderr=subprocess.STDOUT)
+                        active[s]=(p,h,g['index'],directory)
+                        print('started',s,'gpu',g['index'],'pid',p.pid,flush=True)
+                    for s,(p,h,g,directory) in list(active.items()):
+                        rc=p.poll()
+                        if rc is None: continue
+                        h.close()
+                        try:
+                            assert rc==0, f'official rc={rc}'
+                            result=verify_result(directory)
+                            done[s]=dict(**result,gpu=g,returncode=rc,directory=str(directory))
+                            save(directory/'verified.json',done[s])
+                            print('verified',s,flush=True)
+                        except Exception as e:
+                            failures[s]=dict(returncode=rc,error=str(e),directory=str(directory))
+                            print('failed',s,str(e)[:300],flush=True)
+                        del active[s]
+                    if failures or stopped:
+                        pending=[]
+                        for p,_,_,_ in active.values(): p.terminate()
+                    if active: time.sleep(2)
+        finally:
+            for p,h,_,_ in active.values():
+                if p.poll() is None: p.terminate()
+                p.wait(); h.close()
+            for s,handler in old_handlers.items(): signal.signal(s,handler)
+        result=dict(status='complete' if set(done)==set(selected) and not failures else 'failed',checks_passed=not failures and set(done)==set(selected),
+             results=done,failures=failures,expected_studies=selected,peak_gpu_total_mib=peaks,wall_s=time.monotonic()-t0,
+             config=cfg,artifacts={str(out/f'launch_{tag}.json'):sha(out/f'launch_{tag}.json')})
+        for v in done.values(): result['artifacts'].update(v['artifacts'])
+        save(out/'completion.json',result)
+        return 0 if result['checks_passed'] else 2
+
+
+if __name__=='__main__':
+    ap=argparse.ArgumentParser();ap.add_argument('stage',choices=['pilot','rest','fs_pilot','fs_rest','fs_recovery_pilot','fs_recovery_rest','fs_compat_pilot','fs_compat_rest']);a=ap.parse_args()
+    raise SystemExit(main(a.stage))
diff --git a/mr127_select.py b/mr127_select.py
new file mode 100644
index 0000000..43c8d33
--- /dev/null
+++ b/mr127_select.py
@@ -0,0 +1,196 @@
+"""iter127 전용 원문 검토/선정. 의미 판정은 저장한 사례별 판단만 사용한다."""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import time
+
+import pandas as pd
+import mr125_select as candidate
+
+OUT = Path('results/iter_127/data')
+META = Path(candidate.M)
+
+
+def sha(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for chunk in iter(lambda: f.read(4 << 20), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def read(p):
+    return json.loads(Path(p).read_text())
+
+
+def save(p, value):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with p.open('x') as f:
+        json.dump(value, f, ensure_ascii=False, indent=2, allow_nan=False)
+
+
+def prepare():
+    old = read('results/iter_125/data/selection_lock.json')
+    sources = {str(META / p): sha(META / p) for p in old['source_sha256']}
+    assert all(sources[str(META / p)] == h for p, h in old['source_sha256'].items())
+    baseline = read('../agent/runs/iter_127/code_baseline.json')
+    for p, v in baseline['files'].items():
+        if p.startswith(('mr123_', 'mr125_', 'mr126_')):
+            assert sha(p) == v['hash'], p
+    plans = {'125': '477a1c817abfe198e25c14f64a487fbd6f53d5ab0c4a7e5fab91e36f2b705a47',
+             '126': '632a6090c0246dde0e0d8d80c18fee007d3f0625bae6d4320ffe1d67972e4070'}
+    for i, h in plans.items():
+        p = f'../agent/runs/iter_{i}/plan.md'
+        assert sha(p) == h
+        sources[p] = h
+    for p in ['../agent/runs/iter_127/plan.md', '../agent/runs/iter_127/plan.json',
+              '../agent/runs/iter_125/reuse_manifest.json', 'results/iter_125/data/candidates_raw.json',
+              'results/iter_125/data/ordered_candidates.json', 'results/iter_125/data/selection_lock.json']:
+        sources[p] = sha(p)
+    splits = pd.read_csv(META / 'splits.csv')
+    old_pids = candidate.old_patients()
+    joined, reports = [], {}
+    for b in ['batch04', 'batch23']:
+        meta = pd.read_csv(META / f'metadata/{b}_metadata.csv', low_memory=False)
+        t = meta[(meta.classified_modality == 'T2w') & (meta.acquisition_plane == 'AXIAL') &
+                 (meta.is_derived.astype(str) == 'False') & (meta.is_localizer.astype(str) == 'False')].copy()
+        spacing = t.array_spacing_mm.map(json.loads)
+        t['dz'] = spacing.map(lambda x: x[2])
+        t['area'] = spacing.map(lambda x: x[0] * x[1])
+        t = t.sort_values(['study_uid', 'dz', 'area', 'series_id']).groupby('study_uid').head(1)
+        t = t.merge(splits[splits.batch_id == b][['study_uid', 'split']], on='study_uid', validate='one_to_one')
+        r = pd.read_csv(META / f'reports/{b}_reports.csv').fillna('')
+        assert not r.study_uid.duplicated().any()
+        reports[b] = {x['study_uid']: dict(csv_row_index=i, **x) for i, x in enumerate(r.to_dict('records'))}
+        t = t[t.split == 'train'].merge(r, on='study_uid', validate='one_to_one')
+        t['batch_id'] = b
+        joined.append(t)
+    d = pd.concat(joined)
+    d = d[~d.patient_uid.isin(old_pids)].sort_values(['patient_uid', 'study_uid']).groupby('patient_uid').head(1)
+    rebuilt = []
+    for _, x in d.iterrows():
+        hits = [(k, s) for k in ['findings', 'impression'] for s in candidate.sents(x[k]) if candidate.LV.search(s)]
+        if not hits:
+            continue
+        pos = [h for h in hits if candidate.ENL.search(h[1]) and not candidate.NEGENL.search(h[1])]
+        neg = [h for h in hits if h not in pos and (candidate.NORM.search(h[1]) or candidate.NEGENL.search(h[1]))]
+        rebuilt.append(dict(batch_id=x.batch_id, patient_uid=int(x.patient_uid), study_uid=x.study_uid,
+                            series_id=x.series_id, array_shape=x.array_shape, array_spacing_mm=x.array_spacing_mm,
+                            hits=hits, pos=pos, neg=neg))
+    # JSON 직렬화로 tuple/list 표현을 정규화한다. 후보 검색 규칙 변경을 허용하지 않는다.
+    assert json.loads(json.dumps(rebuilt)) == read('results/iter_125/data/candidates_raw.json')
+    ordered = {}
+    for c in rebuilt:
+        lab = 'positive' if c['pos'] and not c['neg'] else 'negative' if c['neg'] and not c['pos'] else None
+        if lab:
+            c.update(cand_label=lab, h=hashlib.sha256(f"125|{c['patient_uid']}".encode()).hexdigest())
+            ordered.setdefault(c['batch_id'] + '|' + lab, []).append(c)
+    for v in ordered.values():
+        v.sort(key=lambda c: c['h'])
+    assert json.loads(json.dumps(ordered)) == read('results/iter_125/data/ordered_candidates.json')
+    inherited = {str(p): sha(p) for i in [125, 126] for p in Path(f'results/iter_{i}').rglob('*') if p.is_file()}
+    save(OUT / 'provenance.json', dict(created_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
+         inputs=sources, inherited_outputs=inherited, baseline_sha=baseline['sha'],
+         baseline_sources={p: v['hash'] for p,v in baseline['files'].items() if p.startswith(('mr123_', 'mr125_', 'mr126_'))},
+         candidate_reconstruction_equal=True, original_order_equal=True,
+         excluded_previous_patients=sorted(old_pids), sizes={k: len(v) for k,v in ordered.items()}))
+    save(OUT / 'ordered_candidates.json', ordered)
+    save(OUT / 'full_reports.json', reports)
+    print({k: len(v) for k,v in ordered.items()})
+
+
+def show(cell, start, end):
+    rows = read(OUT / 'ordered_candidates.json')[cell]
+    reports = read(OUT / 'full_reports.json')
+    for rank, c in enumerate(rows[start:end], start):
+        r = reports[c['batch_id']][c['study_uid']]
+        print(f"\n[{rank}] patient={c['patient_uid']} study={c['study_uid']} cell={cell} CSVrow={r['csv_row_index']}")
+        print('REPORT:', r['report'])
+        # 원 report에 이미 표시된 문장은 비교 결과와 함께 중복 표시만 생략한다.
+        norm = lambda s: re.sub(r'\s+', ' ', s).strip()
+        for section in ['findings', 'impression']:
+            lines = [re.sub(r'^[—•*·]\s*','',line).strip() for line in r[section].splitlines() if line.strip()]
+            new = [line for line in lines if norm(line) not in norm(r['report'])]
+            print(section.upper(), '원 report와 중복인 행', len(lines)-len(new), '/',len(lines))
+            for line in new:
+                print('추가 구조화 문구:',line)
+
+
+def lock():
+    provenance = read(OUT / 'provenance.json')
+    assert all(sha(p) == h for p,h in provenance['inputs'].items())
+    ordered = read(OUT / 'ordered_candidates.json')
+    reports = read(OUT / 'full_reports.json')
+    judgments = read(OUT / 'judgments.json')
+    old = read('results/iter_125/data/selection_lock.json')
+    manifest, traces = [], {}
+    required = {m['patient_uid'] for m in old['manifest']}
+    for cell, rows in ordered.items():
+        old_ids = {m['patient_uid'] for m in old['manifest'] if m['batch_id']+'|'+m['label'] == cell}
+        last = max(i for i,c in enumerate(rows) if c['patient_uid'] in old_ids)
+        required.update(c['patient_uid'] for c in rows[:last+1])
+        selected = []
+        for rank,c in enumerate(rows):
+            pid = str(c['patient_uid'])
+            if pid not in judgments:
+                raise ValueError(f'의미 검토 누락: {cell} rank={rank} patient={pid}')
+            j = judgments[pid]
+            r = reports[c['batch_id']][c['study_uid']]
+            assert j['full_fields_reviewed'] == ['report','findings','impression']
+            assert j['decision'] in ['include','exclude','unknown'] and j['reason_ko']
+            assert j['target'] and j['polarity'] and isinstance(j['conflict'], bool)
+            anchors = []
+            for a in j['quotes']:
+                text = r[a['section']]
+                start = text.find(a['quote'])
+                assert start >= 0, (pid,a)
+                anchors.append(dict(**a,start=start,end=start+len(a['quote'])))
+            assert anchors
+            if j['decision'] == 'include':
+                assert j['polarity'] == c['cand_label'] and not j['conflict']
+                selected.append(dict(**c, rank_zero_based=rank, review=j,
+                                     anchors=anchors, source_csv=str(META/f"reports/{c['batch_id']}_reports.csv"),
+                                     source_sha256=sha(META/f"reports/{c['batch_id']}_reports.csv"),
+                                     csv_row_index=r['csv_row_index'],
+                                     source_row_sha256=hashlib.sha256(json.dumps(r,sort_keys=True).encode()).hexdigest()))
+            if len(selected) == 15:
+                break
+        traces[cell] = dict(last_reviewed_rank=rank, selected_patients=[m['patient_uid'] for m in selected])
+        assert len(selected) == 15, ('층별 적격 표본 부족',cell)
+        for i,m in enumerate(selected):
+            m['label'] = m.pop('cand_label')
+            m['role'] = 'tech' if i < 2 else 'calib' if i < 5 else 'explore'
+            manifest.append(m)
+    assert required <= {int(p) for p in judgments}, ('기존/선행 후보 검토 누락',required-{int(p) for p in judgments})
+    assert len(manifest) == len({m['patient_uid'] for m in manifest}) == len({m['study_uid'] for m in manifest}) == 60
+    assert not {m['patient_uid'] for m in manifest} & set(provenance['excluded_previous_patients'])
+    oldby = {m['patient_uid']: m for m in old['manifest']}
+    newby = {m['patient_uid']: m for m in manifest}
+    diff = [dict(patient_uid=pid, old_role=oldby.get(pid,{}).get('role'), new_role=newby.get(pid,{}).get('role'),
+                 reason_ko=judgments[str(pid)]['reason_ko'] if pid not in newby else '원 hash 순서 첫15 적격자 재선정과 역할 재배정')
+            for pid in sorted(oldby.keys()|newby.keys()) if oldby.get(pid,{}).get('role') != newby.get(pid,{}).get('role')]
+    assert all(sha(p)==h for p,h in provenance['inherited_outputs'].items())
+    save(OUT / 'selection_diff.json',diff)
+    save(OUT / 'selection_lock.json',dict(seed=125, manifest=manifest, traces=traces,
+          created_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),
+          judgments_sha256=sha(OUT/'judgments.json'), provenance_sha256=sha(OUT/'provenance.json'),
+          source_code_sha256=sha(__file__), reviewed_patients=len(judgments),
+          semantic_review_scope='기록된 개별 후보만; 후순위 미검토 후보는 미인증', inherited_results_unchanged=True))
+    print('locked',len(manifest),Counter(m['role'] for m in manifest),'diff',len(diff))
+
+
+if __name__ == '__main__':
+    ap=argparse.ArgumentParser()
+    ap.add_argument('action',choices=['prepare','show','lock'])
+    ap.add_argument('--cell')
+    ap.add_argument('--start',type=int,default=0)
+    ap.add_argument('--end',type=int,default=5)
+    a=ap.parse_args()
+    if a.action=='prepare': prepare()
+    elif a.action=='show': show(a.cell,a.start,a.end)
+    else: lock()
