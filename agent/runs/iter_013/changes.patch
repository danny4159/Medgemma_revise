--- /dev/null
+++ b/rsna_diag/adapt_pipeline.py
@@ -0,0 +1,287 @@
+"""iter_013 실행 파이프라인 (재개 가능, 단계별 근거 재검증). 사용: python -m rsna_diag.adapt_pipeline --stage explore|full_s17|full_s29|full_s43 [--conds C,D,H] [--lrs ...]
+
+한 stage = 여러 trajectory(조건 x LR)의 추가 적응 학습 + V200 milestone 검증 + V400 완성(V200 응답을 부모로 재사용해 나머지 200만 생성) + 보고.
+- 학습은 GPU lane별로 순차 실행한다 (학습 worker는 GPU당 1개: microbatch 실측 peak + 2GiB 여유로 한 장에 2개가 안 들어감; decisions/exec_config.json).
+- 건너뛰기는 파일 존재가 아니라 select.verify_epoch / eval_gate.verify_gen 재검증을 통과할 때만이다. 불일치는 예외 (조용히 재사용하지 않음).
+- 보고서 report.json은 원시 응답에서 재계산한 결정적 내용만 담고 write_or_verify로 기존 파일과 일치를 강제한다. 시간·자원은 usage.json에 따로 기록한다.
+- pipeline.lock으로 stage당 단일 소유를 강제한다.
+"""
+import argparse
+import glob
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+
+from . import adapt_eval as AE, eval_gate, inputs, lock_protocol, queue_lock, select as SEL, sft_eval
+from .run_shards import gpu_snapshot
+
+R = "results/iter_013"
+PROT = f"{R}/protocols/main_protocol.json"
+EXEC = f"{R}/decisions/exec_config.json"
+MAN = AE.MANIFEST
+FREE_BEFORE_MIB = 2000
+
+
+def lrs(x):
+    return f"{x:g}"
+
+
+class Ctx:
+    def __init__(self, stage):
+        self.stage = stage
+        self.cfg = json.load(open(f"{R}/stage/{stage}.json"))
+        self.dir = f"{R}/{stage}"
+        os.makedirs(self.dir, exist_ok=True)
+        self.logp = f"{self.dir}/pipeline.log"
+        self.ex = json.load(open(EXEC))
+        self.pdig = lock_protocol.verify(PROT)
+        self.val_items, self.gt = inputs.load_items(MAN, AE.GT, self.cfg["val_ids"], "validation", exact=False)
+        self.v_in = inputs.inputs_digest(self.val_items, self.gt)
+        self.v400_items, _ = inputs.load_items(MAN, AE.GT, AE.V400_IDS, "validation", exact=True)
+        self.tr_ids = [i for i in self.gt if self.gt[i]["split"] == "train"]
+        self.aed = sft_eval.area_edges(self.gt, self.tr_ids)
+        self.bed = AE.box_edges_train(self.gt, self.tr_ids)
+        self.spe = None
+
+    def log(self, msg):
+        line = f"[{time.strftime('%F %T')}] {msg}"
+        print(line, flush=True)
+        with open(self.logp, "a") as f:
+            f.write(line + "\n")
+
+
+def wait_gpu_free(ctx, gpu):
+    while True:
+        rows, apps = gpu_snapshot({gpu})
+        if rows and rows[0]["mem_used_mib"] <= FREE_BEFORE_MIB:
+            ctx.log(f"gpu {gpu} free: {rows[0]}")
+            return
+        ctx.log(f"waiting for gpu {gpu}: {rows} apps={apps}")
+        time.sleep(120)
+
+
+def run_dir(ctx, cond, lr, seedtag=""):
+    return f"{ctx.dir}/{cond}_lr{lrs(lr)}"
+
+
+def trained_ok(ctx, d):
+    """done.json + epoch 1..E 전체 검증 (원시 응답 재계산). 파일이 없으면 False, 근거 불일치는 예외."""
+    if not os.path.exists(os.path.join(d, "train_config.json")):
+        return False
+    tc = json.load(open(os.path.join(d, "train_config.json")))
+    E = ctx.cfg["epochs"]
+    if not os.path.exists(os.path.join(d, "done.json")):
+        return False
+    for e in range(1, E + 1):
+        if not os.path.exists(os.path.join(d, f"epoch_{e:02d}", "val_metrics.json")):
+            return False
+        SEL.verify_epoch(d, e, tc, ctx.v_in, PROT, ctx.val_items, ctx.gt)
+    return True
+
+
+def train_cmd(ctx, cond, lr, d):
+    return [sys.executable, "-m", "rsna_diag.adapt", "--run-dir", d, "--stage-config", f"{R}/stage/{ctx.stage}.json", "--loss", cond, "--lr", str(lr),
+            "--protocol", PROT, "--microbatch", str(ctx.ex["train_microbatch"]), "--workers", "3"]
+
+
+def train_traj(ctx, gpu, cond, lr):
+    d = run_dir(ctx, cond, lr)
+    if trained_ok(ctx, d):
+        ctx.log(f"{d}: verified complete")
+        return
+    wait_gpu_free(ctx, gpu) if not os.path.exists(os.path.join(d, "train.lock")) else None
+    ctx.log(f"train {cond} lr={lr} on gpu {gpu} -> {d}")
+    t0 = time.time()
+    rc = subprocess.run(train_cmd(ctx, cond, lr, d), env=dict(os.environ, CUDA_VISIBLE_DEVICES=str(gpu)), stdout=open(f"{d}.log", "a"), stderr=subprocess.STDOUT).returncode
+    ctx.log(f"train {cond} lr={lr} rc={rc} wall={time.time() - t0:.0f}s")
+    if rc != 0 or not trained_ok(ctx, d):
+        raise RuntimeError(f"{d}: training failed or not verified (rc={rc})")
+
+
+def v200_detail(ctx, d, e):
+    tc = json.load(open(os.path.join(d, "train_config.json")))
+    SEL.verify_epoch(d, e, tc, ctx.v_in, PROT, ctx.val_items, ctx.gt)
+    ed = os.path.join(d, f"epoch_{e:02d}")
+    recs = eval_gate.verify_gen(os.path.join(ed, "val_gen"), ctx.val_items, ["concise"], ed, PROT)
+    ids = [i["id"] for i in ctx.val_items]
+    return AE.detail(AE.preds_of(recs, ids), ctx.gt, ids, ctx.aed, ctx.bed), tc["config"]["steps_per_epoch"]
+
+
+def b0_details(ctx):
+    recs = AE.b0_records(PROT, ctx.v400_items)
+    ids400 = [i["id"] for i in ctx.v400_items]
+    p400 = AE.preds_of(recs, ids400)
+    v200 = [i["id"] for i in ctx.val_items]
+    return p400, AE.detail(p400, ctx.gt, ids400, ctx.aed, ctx.bed), AE.detail({i: p400[i] for i in v200}, ctx.gt, v200, ctx.aed, ctx.bed)
+
+
+def gen_v400(ctx, gpu_list, d, e):
+    """epoch e adapter의 V400 완성. V200 val_gen을 부모로 재사용하고 나머지만 새로 생성한다. returns records."""
+    ed = os.path.join(d, f"epoch_{e:02d}")
+    out = os.path.join(d, f"v400_epoch{e:02d}")
+    par = os.path.join(ed, "val_gen")
+    try:
+        return eval_gate.verify_gen(out, ctx.v400_items, ["concise"], ed, PROT, par, PROT)
+    except (eval_gate.GateError, FileNotFoundError) as ex:
+        ctx.log(f"{out}: not complete/verified ({str(ex)[:120]}) -> run_shards")
+    for g in gpu_list:
+        wait_gpu_free(ctx, g)
+    nw = ctx.ex["gen_workers_per_gpu"] * len(gpu_list)
+    cmd = [sys.executable, "-m", "rsna_diag.run_shards", "--manifest", MAN, "--ids", AE.V400_IDS, "--out-dir", out, "--protocol", PROT, "--prompts", "concise",
+           "--workers", str(nw), "--gpus", ",".join(map(str, gpu_list)), "--adapter", ed, "--parent-dir", par, "--parent-protocol", PROT]
+    rc = subprocess.run(cmd, env=dict(os.environ, CUDA_VISIBLE_DEVICES=",".join(map(str, gpu_list))), stdout=open(f"{out}.log", "a"), stderr=subprocess.STDOUT).returncode
+    ctx.log(f"gen {out} rc={rc}")
+    if rc != 0:
+        raise RuntimeError(f"{out}: run_shards failed rc={rc}")
+    return eval_gate.verify_gen(out, ctx.v400_items, ["concise"], ed, PROT, par, PROT)
+
+
+def select_traj(ctx, d, b0_v200):
+    """trajectory의 milestone(epoch 1..E)별 V200 detail과 guardrail 통과 최대 S_loc 선택 (동률은 이른 update)."""
+    cands, det = {}, {}
+    for e in range(1, ctx.cfg["epochs"] + 1):
+        dt, spe = v200_detail(ctx, d, e)
+        cands[e * spe], det[e] = dt, dt
+    sel_upd, table = AE.select_checkpoint(cands, b0_v200)
+    return {"update_to_epoch": {u: u // spe for u in cands}, "selected_update": sel_upd,
+            "selected_epoch": (sel_upd // spe if sel_upd else None), "table": {str(u): t for u, t in table.items()}}, det, spe
+
+
+def compare(preds_by, gt, ids, pairs):
+    return {f"{a}-{b}": AE.paired_ci(preds_by[a], preds_by[b], gt, ids) for a, b in pairs if a in preds_by and b in preds_by}
+
+
+def report(ctx, trajs):
+    """trajs: [(cond, lr)] 모두 학습·검증 완료 상태. V400 완성 후 report.json (결정적 내용)."""
+    ids400 = [i["id"] for i in ctx.v400_items]
+    p400_b0, d400_b0, d200_b0 = b0_details(ctx)
+    rep = {"stage": ctx.stage, "protocol_digest": ctx.pdig, "b0": {"v400": d400_b0, "v200": d200_b0}, "trajectories": {}}
+    preds = {"B0": p400_b0}
+    dets = {"B0": d400_b0}
+    for cond, lr in trajs:
+        d = run_dir(ctx, cond, lr)
+        name = f"{cond}@{lrs(lr)}"
+        sel, det200, spe = select_traj(ctx, d, d200_b0)
+        E = ctx.cfg["epochs"]
+        entry = {"lr": lr, "cond": cond, "steps_per_epoch": spe, "selection_v200": sel, "v200_detail_by_epoch": {str(e): det200[e] for e in det200}}
+        for tag, e in (("final", E), ("selected", sel["selected_epoch"])):
+            if e is None:
+                entry[tag] = None
+                continue
+            recs = gen_v400(ctx, [int(g) for g in ctx.ex["gen_gpus"]], d, e)
+            p = AE.preds_of(recs, ids400)
+            entry[tag] = {"epoch": e, "update": e * spe, "v400": AE.detail(p, ctx.gt, ids400, ctx.aed, ctx.bed),
+                          "guardrail_v400": AE.guardrail(AE.detail(p, ctx.gt, ids400, ctx.aed, ctx.bed), d400_b0)}
+            preds[f"{name}/{tag}"] = p
+            dets[f"{name}/{tag}"] = entry[tag]["v400"]
+        rep["trajectories"][name] = entry
+    rep["pairwise_v400_paired_bootstrap"] = {}
+    names = [n for n in preds if n != "B0"]
+    for tag in ("selected", "final"):
+        pb = {"B0": preds["B0"], **{n.split("/")[0]: p for n, p in preds.items() if n.endswith("/" + tag)}}
+        cs = sorted(k for k in pb if k != "B0")
+        pairs = [(a, "B0") for a in cs] + [(a, b) for a in cs for b in cs if a != b and a.split("@")[0] in ("D", "H") and b.split("@")[0] in ("C", "H") and not (a[0] == b[0])]
+        rep["pairwise_v400_paired_bootstrap"][tag] = compare(pb, ctx.gt, ids400, pairs)
+    del names
+    return rep, preds
+
+
+def write_or_verify(path, obj):
+    return SEL.write_or_verify(path, obj)
+
+
+def lane(ctx, gpu, items):
+    for fn in items:
+        fn()
+
+
+def run_lanes(lanes):
+    """lanes: {gpu: [callable...]}. 각 lane은 순차, lane 간 병렬. 예외는 모두 수집해 다시 던진다."""
+    errs = []
+
+    def w(fns):
+        try:
+            for f in fns:
+                f()
+        except BaseException as e:  # noqa
+            errs.append(e)
+            ABORT.set()
+
+    ths = [threading.Thread(target=w, args=(fns,)) for fns in lanes.values()]
+    [t.start() for t in ths]
+    [t.join() for t in ths]
+    if errs:
+        raise errs[0]
+
+
+_B0 = {}
+_LOCK = threading.Lock()
+ABORT = threading.Event()
+
+
+def b0_cached(ctx):
+    with _LOCK:
+        if "v" not in _B0:
+            _B0["v"] = b0_details(ctx)
+        return _B0["v"]
+
+
+def prefetch(ctx, gpu, pending, trajs_dirs):
+    """이 lane이 학습을 마친 뒤, 학습이 끝난 trajectory부터 하나씩 claim해 final/selected checkpoint의 V400 나머지 200요청을 자기 GPU에서 생성한다.
+    (다른 lane이 아직 학습 중이면 그 trajectory가 끝날 때까지 기다린다.) 결과는 report()가 재검증하므로 여기서는 생성만 한다."""
+    while True:
+        with _LOCK:
+            ready = [t for t in pending if os.path.exists(os.path.join(trajs_dirs[t], "done.json"))]
+            if not pending:
+                return
+            claim = ready[0] if ready else None
+            if claim:
+                pending.remove(claim)
+        if claim is None:
+            if ABORT.is_set():
+                return
+            time.sleep(60)
+            continue
+        d = trajs_dirs[claim]
+        _, _, d200_b0 = b0_cached(ctx)
+        sel, _, _ = select_traj(ctx, d, d200_b0)
+        for e in sorted({ctx.cfg["epochs"], sel["selected_epoch"]} - {None}):
+            gen_v400(ctx, [gpu], d, e)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--trajs", required=True, help="예: C:2e-5,D:2e-5,H:2e-5 (lane 배정: 순서대로 gpu0, gpu1 번갈아)")
+    ap.add_argument("--report-name", default="report")
+    a = ap.parse_args()
+    ctx = Ctx(a.stage)
+    lk, own, _ = queue_lock.try_lock(os.path.join(os.path.realpath(ctx.dir), "pipeline.lock"), queue_lock.my_info(role="adapt_pipeline"))
+    if lk is None:
+        sys.exit(f"another pipeline owns {ctx.dir}: {own}")
+    try:
+        trajs = [(c, float(l)) for c, l in (x.split(":") for x in a.trajs.split(","))]
+        gpus = [int(g) for g in ctx.ex["train_gpus"]]
+        lanes = {g: [] for g in gpus}
+        dirs = {(c, l): run_dir(ctx, c, l) for c, l in trajs}
+        pending = list(dirs)
+        for k, (c, l) in enumerate(trajs):
+            g = gpus[k % len(gpus)]
+            lanes[g].append(lambda g=g, c=c, l=l: train_traj(ctx, g, c, l))
+        for g in gpus:
+            lanes[g].append(lambda g=g: prefetch(ctx, g, pending, dirs))
+        t0 = time.time()
+        run_lanes(lanes)
+        ctx.log(f"all trainings verified; wall={time.time() - t0:.0f}s")
+        rep, preds = report(ctx, trajs)
+        ctx.log(f"report {write_or_verify(f'{ctx.dir}/{a.report_name}.json', json.loads(json.dumps(rep)))}")
+        ctx.log("STAGE COMPLETE")
+    finally:
+        lk.release()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/adapt_stages.py b/rsna_diag/adapt_stages.py
new file mode 100644
index 0000000..9652be8
--- /dev/null
+++ b/rsna_diag/adapt_stages.py
@@ -0,0 +1,59 @@
+"""iter_013 stage config 생성 (결과를 보기 전에 고정). 사용: python -m rsna_diag.adapt_stages --out-dir results/iter_013/stage
+
+sanity / pilot_mb : 동작 확인·처리량 pilot (train sanity16). 본실험 weight로 이월하지 않는다.
+explore           : 가능성 탐색. train1200, V200(val_ids), seed17, 3 epochs x 75 updates, peak LR 2e-5.
+full_s17          : 확대. train 2,400 전체, seed17, 3 epochs x 150 updates, LR 2e-5/5e-5 (C·D, 그리고 D의 선택 LR에서 H).
+full_s29 / s43    : 조건부 재현. 각 seed의 부모 epoch_05 adapter에서 시작 (부모 학습 seed까지 바뀐다).
+공통: alpha=0.1, tau=1.0, 자리 가중 1,2,3,4, 5% warmup + cosine(0), effective batch 16 (sanity는 4). 부모 optimizer는 이어받지 않는다.
+"""
+import argparse
+import hashlib
+import json
+import os
+
+from . import lora
+
+MI = "results/iter_010/manifests/"
+S = "results/iter_013/subsets/"
+PARENT = "results/iter_012/train/lr2e-4_s{}/epoch_05/adapter.pt"
+
+
+def parent(seed):
+    import torch
+    p = PARENT.format(seed)
+    b = torch.load(p, map_location="cpu", weights_only=True)
+    dg = lora.state_digest(b["state"])
+    assert b["digest"] == dg
+    return {"parent_adapter": p, "parent_adapter_sha256": hashlib.sha256(open(p, "rb").read()).hexdigest(), "parent_adapter_digest": dg}
+
+
+def stage(sid, seed, train_ids, val_ids, epochs, eff, lrs, validate, note):
+    return {"stage_id": sid, "seed": seed, "train_ids": train_ids, "val_ids": val_ids, "epochs": epochs, "eff_batch": eff, "allowed_lrs": lrs,
+            "warmup_frac": 0.05, "validate": validate, "alpha": 0.1, "tau": 1.0, "schedule": "5% warmup then cosine to 0 over this stage's total updates",
+            "note": note, **parent(seed)}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out-dir", required=True)
+    a = ap.parse_args()
+    os.makedirs(a.out_dir, exist_ok=True)
+    cfgs = {
+        "sanity": stage("sanity", 17, S + "sanity16_ids.json", S + "val8_ids.json", 2, 4, [2e-5], True, "동작·재개 검사 (결정적 kernel), 본실험 미사용"),
+        "pilot_mb": stage("pilot_mb", 17, S + "sanity16_ids.json", S + "val8_ids.json", 3, 16, [2e-5], False, "microbatch 2 vs 4 처리량·메모리 pilot"),
+        "explore": stage("explore", 17, S + "train1200_ids.json", S + "v200_ids.json", 3, 16, [2e-5], True, "가능성 탐색 (1,200 train, V200)"),
+        "full_s17": stage("full_s17", 17, MI + "train_ids.json", S + "v200_ids.json", 3, 16, [2e-5, 5e-5], True, "확대 (train 2,400, V200)"),
+        "full_s29": stage("full_s29", 29, MI + "train_ids.json", S + "v200_ids.json", 3, 16, [2e-5, 5e-5], True, "조건부 재현 (부모 seed29)"),
+        "full_s43": stage("full_s43", 43, MI + "train_ids.json", S + "v200_ids.json", 3, 16, [2e-5, 5e-5], True, "조건부 재현 (부모 seed43)"),
+    }
+    for k, v in cfgs.items():
+        p = os.path.join(a.out_dir, f"{k}.json")
+        if os.path.exists(p):
+            assert json.load(open(p)) == v, f"{p} exists and differs (not overwritten)"
+        else:
+            json.dump(v, open(p, "w"), indent=1)
+        print(k, "written" if not os.path.exists(p) else "ok")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/adapt_subsets.py b/rsna_diag/adapt_subsets.py
new file mode 100644
index 0000000..198e8b9
--- /dev/null
+++ b/rsna_diag/adapt_subsets.py
@@ -0,0 +1,114 @@
+"""iter_013: 결과를 보기 전에 고정하는 결정적 subset 추출. 사용: python -m rsna_diag.adapt_subsets --out-dir results/iter_013/subsets
+
+- train1200 = train 2,400 중 opacity 600 (n_box{1,2,3+} x 환자 union 면적 삼분위 strata, 최대잉여법 비례 배분, strata 안은 sha256 순),
+  Normal 300, NoOpacity/NotNormal 300 (sha256 순). 작은 층을 제외하지 않고 추출 수와 원분포를 기록한다. 동일 환자 중복 없음.
+- v200 = validation 400 중 양성 100 (같은 strata 방식), Normal 50, NoOpacity/NotNormal 50. V400의 부분집합 (개발 subset).
+- sanity16 = train1200 안에서 양성 8 (단일 box 크기 3층 각 1 + 복수 box 5), 각 음성 층 4. thr48 = train1200 밖 train에서 양성 24, 음성 12+12 (추론 처리량 비교용).
+- 면적 삼분위 경계는 기존 train 전체(select/sft_eval.area_edges)의 값을 쓴다.
+"""
+import argparse
+import hashlib
+import json
+import os
+
+import numpy as np
+
+from . import sft_eval
+
+GT = "results/iter_010/manifests/gt_manifest.json"
+SEED = "iter013-subsets-v1"
+
+
+def h(i, salt=""):
+    return hashlib.sha256(f"{SEED}|{salt}|{i}".encode()).hexdigest()
+
+
+def allocate(sizes, total):
+    """strata 크기 dict -> 합이 total인 비례 배분 (최대잉여법, 결정적). 각 strata 크기를 넘지 않는다."""
+    tot = sum(sizes.values())
+    raw = {k: v * total / tot for k, v in sizes.items()}
+    base = {k: int(np.floor(r)) for k, r in raw.items()}
+    left = total - sum(base.values())
+    for k in sorted(raw, key=lambda k: (-(raw[k] - base[k]), str(k)))[:left]:
+        base[k] += 1
+    return base
+
+
+def strata(gt, ids, edges):
+    out = {}
+    for i in ids:
+        nb = len(gt[i]["boxes"])
+        t = int(np.digitize(sft_eval.gt_area_frac(gt[i]), edges))
+        out.setdefault((min(nb, 3), t), []).append(i)
+    return out
+
+
+def pick_pos(gt, ids, n, edges, salt):
+    st = strata(gt, ids, edges)
+    al = allocate({k: len(v) for k, v in st.items()}, n)
+    chosen = []
+    for k in sorted(st):
+        chosen += sorted(st[k], key=lambda i: h(i, salt))[:al[k]]
+    return sorted(chosen), {str(k): {"available": len(st[k]), "chosen": al[k]} for k in sorted(st)}
+
+
+def pick_neg(ids, n, salt):
+    return sorted(sorted(ids, key=lambda i: h(i, salt))[:n])
+
+
+def box_area_hist(gt, ids, cuts):
+    a = np.array([(b["yxyx_norm"][2] - b["yxyx_norm"][0]) * (b["yxyx_norm"][3] - b["yxyx_norm"][1]) / 1e6 for i in ids for b in gt[i]["boxes"]])
+    return {"n_boxes": int(len(a)), "share_below_cut1": float((a < cuts[0]).mean()), "share_below_cut2": float((a < cuts[1]).mean())}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out-dir", required=True)
+    a = ap.parse_args()
+    gt = json.load(open(GT))
+    ids = lambda s: sorted(json.load(open(f"results/iter_010/manifests/{s}_ids.json")))
+    tr, va = ids("train"), ids("validation")
+    edges = sft_eval.area_edges(gt, tr)
+    cat = lambda pool, c: [i for i in pool if gt[i]["category"] == c]
+    tr_pos_pool = cat(tr, "opacity")
+    tp, tp_rep = pick_pos(gt, tr_pos_pool, 600, edges, "train")
+    t1200 = sorted(tp + pick_neg(cat(tr, "normal"), 300, "train_normal") + pick_neg(cat(tr, "not_normal_no_opacity"), 300, "train_nn"))
+    vp, vp_rep = pick_pos(gt, cat(va, "opacity"), 100, edges, "val")
+    v200 = sorted(vp + pick_neg(cat(va, "normal"), 50, "val_normal") + pick_neg(cat(va, "not_normal_no_opacity"), 50, "val_nn"))
+    # sanity16: 단일 box 크기 3층 각 1 + 복수 box 5 + 음성 4+4
+    s1 = strata(gt, [i for i in t1200 if gt[i]["category"] == "opacity"], edges)
+    san = []
+    for t in range(3):
+        san.append(sorted(s1[(1, t)], key=lambda i: h(i, "san"))[0])
+    multi = [i for k in sorted(s1) if k[0] >= 2 for i in s1[k]]
+    san += sorted(multi, key=lambda i: h(i, "san"))[:5]
+    san += sorted([i for i in t1200 if gt[i]["category"] == "normal"], key=lambda i: h(i, "san"))[:4]
+    san += sorted([i for i in t1200 if gt[i]["category"] == "not_normal_no_opacity"], key=lambda i: h(i, "san"))[:4]
+    rest = [i for i in tr if i not in set(t1200)]
+    tp48, _ = pick_pos(gt, cat(rest, "opacity"), 24, edges, "thr48")
+    thr48 = sorted(tp48 + pick_neg(cat(rest, "normal"), 12, "thr48n") + pick_neg(cat(rest, "not_normal_no_opacity"), 12, "thr48nn"))
+    os.makedirs(a.out_dir, exist_ok=True)
+    cuts = [0.02, 0.06]  # 개별 box 면적 참고 경계 (보고용 분포 비교 전용, 추출에는 쓰이지 않음)
+    hv = lambda c: sorted([i for i in v200 if gt[i]["category"] == c], key=lambda i: h(i, "val8"))
+    val8 = sorted(hv("opacity")[:4] + hv("normal")[:2] + hv("not_normal_no_opacity")[:2])  # 재개 검사용 validation 8명 (v200의 부분집합)
+    outs = {"train1200": t1200, "v200": v200, "sanity16": sorted(san), "thr48": thr48, "val8": val8}
+    for k, v in outs.items():
+        assert len(set(v)) == len(v)
+        p = os.path.join(a.out_dir, f"{k}_ids.json")
+        json.dump(v, open(p, "w"))
+    assert not set(t1200) & set(v200) and set(v200) <= set(va) and set(t1200) <= set(tr) and not set(thr48) & set(t1200)
+    assert set(outs["sanity16"]) <= set(t1200) and len(outs["sanity16"]) == 16
+    rep = {"seed": SEED, "area_tertile_edges_train": edges,
+           "sizes": {k: len(v) for k, v in outs.items()},
+           "categories": {k: {c: sum(gt[i]["category"] == c for i in v) for c in ("opacity", "normal", "not_normal_no_opacity")} for k, v in outs.items()},
+           "train_pos_strata": tp_rep, "val_pos_strata": vp_rep,
+           "box_area_shares_full_train_pos": box_area_hist(gt, tr_pos_pool, cuts), "box_area_shares_train1200_pos": box_area_hist(gt, tp, cuts),
+           "n_box_dist_full_train_pos": {str(k): int(v) for k, v in zip(*np.unique([len(gt[i]["boxes"]) for i in tr_pos_pool], return_counts=True))},
+           "n_box_dist_train1200_pos": {str(k): int(v) for k, v in zip(*np.unique([len(gt[i]["boxes"]) for i in tp], return_counts=True))},
+           "sha256": {k: hashlib.sha256(open(os.path.join(a.out_dir, f"{k}_ids.json"), "rb").read()).hexdigest() for k in outs}}
+    json.dump(rep, open(os.path.join(a.out_dir, "subsets_report.json"), "w"), indent=1)
+    print(json.dumps({k: rep[k] for k in ("sizes", "categories", "n_box_dist_full_train_pos", "n_box_dist_train1200_pos", "box_area_shares_full_train_pos", "box_area_shares_train1200_pos")}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/coord_loss.py b/rsna_diag/coord_loss.py
new file mode 100644
index 0000000..cb01055
--- /dev/null
+++ b/rsna_diag/coord_loss.py
@@ -0,0 +1,158 @@
+"""iter_013: 좌표 숫자 token 연결과 H/D 추가 loss.
+
+- number_spans: JSON 문자열을 작은 scanner로 읽어 모든 숫자 literal의 (경로, 문자 구간)을 얻는다. `box_2d`의 네 정수만 좌표로 인정한다
+  (key의 `2`, label, 괄호, 공백, <end_of_turn>은 절대 잡지 않는다). 값은 sft_data.target_boxes와 대조한다.
+- coord_weights: assistant 본문 token의 offset으로 좌표 숫자 문자 -> 실제 chat sequence token 위치를 연결한다. 각 좌표 숫자는 정확히 한 자리
+  숫자 token(id가 DIGIT_IDS)이어야 하며 아니면 예외 (조용히 제외하지 않는다). 자리 가중 = 숫자 오른쪽부터 1,2,3,4.
+- loss_sums: 한 microbatch의 (CE 합, 추가 항 합). L_H = CE + alpha*sum_E w*CE_t, L_D = CE + alpha*sum_E w*KL(q_t || p_t),
+  q_t(v) = softmax_v(-(v-g_t)^2/tau) (v=0..9), p_t는 전체 vocabulary softmax에서 숫자 10개 열의 확률 (재정규화 안 함).
+  분모는 호출자가 effective-batch assistant token 수 N으로 나눈다. 이 loss는 39<->40 같은 자릿수 올림·내림 관계를 표현하지 않는다.
+"""
+import json
+import re
+
+PLAN_DIGIT_IDS = [236771, 236770, 236778, 236800, 236812, 236810, 236825, 236832, 236828, 236819]
+ALPHA = 0.1
+TAU = 1.0
+_NUM = re.compile(r"-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?")
+_WS = " \t\n\r"
+
+
+class SpanError(RuntimeError):
+    pass
+
+
+def number_spans(text):
+    """returns [(path tuple, start, end, literal)] for every number literal (경로: 리스트 index / dict key)."""
+    out = []
+
+    def ws(i):
+        while i < len(text) and text[i] in _WS:
+            i += 1
+        return i
+
+    def value(i, path):
+        i = ws(i)
+        c = text[i]
+        if c == "[":
+            i = ws(i + 1)
+            k = 0
+            if text[i] == "]":
+                return i + 1
+            while True:
+                i = value(i, path + (k,))
+                i = ws(i)
+                k += 1
+                if text[i] == ",":
+                    i += 1
+                    continue
+                if text[i] == "]":
+                    return i + 1
+                raise SpanError(f"bad list at {i}")
+        if c == "{":
+            i = ws(i + 1)
+            if text[i] == "}":
+                return i + 1
+            while True:
+                key, i = json.decoder.scanstring(text, i + 1)
+                i = ws(i)
+                if text[i] != ":":
+                    raise SpanError(f"bad dict at {i}")
+                i = value(i + 1, path + (key,))
+                i = ws(i)
+                if text[i] == ",":
+                    i = ws(i + 1)
+                    continue
+                if text[i] == "}":
+                    return i + 1
+                raise SpanError(f"bad dict at {i}")
+        if c == '"':
+            return json.decoder.scanstring(text, i + 1)[1]
+        m = _NUM.match(text, i)
+        if m:
+            out.append((path, m.start(), m.end(), m.group()))
+            return m.end()
+        for lit in ("true", "false", "null"):
+            if text.startswith(lit, i):
+                return i + len(lit)
+        raise SpanError(f"bad value at {i}")
+
+    end = ws(value(0, ()))
+    if end != len(text):
+        raise SpanError("trailing text")
+    return out
+
+
+def coord_spans(target):
+    """box_2d의 정수 literal 구간 [(start, end, int)] (문서 순서). 값은 target_boxes와 같아야 한다 (호출자가 대조)."""
+    res = []
+    for path, s, e, lit in number_spans(target):
+        if len(path) == 3 and path[1] == "box_2d" and isinstance(path[0], int) and isinstance(path[2], int):
+            if not lit.isdigit():
+                raise SpanError(f"non-integer coordinate literal {lit!r}")
+            res.append((s, e, int(lit)))
+    return res
+
+
+def digit_ids(tok):
+    ids = [tok.convert_tokens_to_ids(str(d)) for d in range(10)]
+    if ids != PLAN_DIGIT_IDS:
+        raise SpanError(f"digit token ids {ids} != plan {PLAN_DIGIT_IDS}")
+    return ids
+
+
+def coord_weights(tok, target, full_ids, n_prefix, dig_ids):
+    """full_ids: 실제 chat sequence 1-D list(int). returns list[float] (len(full_ids)): 좌표 숫자 token 위치에 자리 가중, 나머지 0."""
+    enc = tok(target + "<end_of_turn>", add_special_tokens=False, return_offsets_mapping=True)
+    ids, offs = enc["input_ids"], enc["offset_mapping"]
+    if list(full_ids[n_prefix:n_prefix + len(ids)]) != list(ids):
+        raise SpanError("assistant tokens in chat sequence != standalone tokenization of target")
+    spans = coord_spans(target)
+    want = [v for e in json.loads(target) for v in e["box_2d"]]
+    if [v for _, _, v in spans] != want:
+        raise SpanError("scanned coordinate values != json.loads box_2d values")
+    w = [0.0] * len(full_ids)
+    char_to_tok = {}
+    for t, (s, e) in enumerate(offs):
+        for c in range(s, e):
+            char_to_tok[c] = t
+    dset = {d: i for i, d in enumerate(dig_ids)}
+    for s, e, val in spans:
+        nd = e - s
+        for c in range(s, e):
+            t = char_to_tok.get(c)
+            if t is None or tuple(offs[t]) != (c, c + 1):
+                raise SpanError(f"coordinate digit at char {c} of {target[:60]!r} is not a single-character token")
+            if ids[t] not in dset or str(dset[ids[t]]) != target[c]:
+                raise SpanError(f"token {ids[t]} at char {c} is not digit {target[c]!r}")
+            w[n_prefix + t] = float(e - c)  # 오른쪽 자리부터 1,2,3,4
+    return w
+
+
+def loss_sums(torch, logits, y, w, mode, dig_ids, alpha=ALPHA, tau=TAU):
+    """logits [M,V] float32(softcap 이후), y [M] long, w [M] float(좌표 자리 가중, 그 외 0).
+    returns (ce_sum, extra_sum). extra_sum은 alpha를 곱하기 전 sum_E w * (CE 또는 KL). C는 0."""
+    lse = torch.logsumexp(logits, dim=-1)
+    ce = lse - logits.gather(1, y[:, None]).squeeze(1)
+    ce_sum = ce.sum()
+    zero = ce_sum.new_zeros(())
+    if mode == "C":
+        return ce_sum, zero
+    E = w > 0
+    if not bool(E.any()):
+        return ce_sum, zero
+    if mode == "H":
+        return ce_sum, (w[E] * ce[E]).sum()
+    if mode == "D":
+        di = torch.as_tensor(dig_ids, device=logits.device)
+        lp = logits[E][:, di] - lse[E][:, None]  # 전체 vocabulary 정규화 log p (숫자 10개 열)
+        inv = torch.full((int(logits.shape[1]),), -1, dtype=torch.long, device=logits.device)
+        inv[di] = torch.arange(10, device=logits.device)
+        g = inv[y[E]]
+        if bool((g < 0).any()):
+            raise SpanError("coordinate label token is not a digit")
+        v = torch.arange(10, device=logits.device, dtype=logits.dtype)
+        logq = torch.log_softmax(-((v[None, :] - g[:, None].to(logits.dtype)) ** 2) / tau, dim=-1)
+        kl = (logq.exp() * (logq - lp)).sum(-1)
+        return ce_sum, (w[E] * kl).sum()
+    raise ValueError(mode)
