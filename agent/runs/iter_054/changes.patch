diff --git a/mc54_build.py b/mc54_build.py
new file mode 100644
index 0000000..87ff969
--- /dev/null
+++ b/mc54_build.py
@@ -0,0 +1,210 @@
+"""iter_054 자료 구축: source 검증 → 영상 hash/mode → 의존성 component → 사전 의심 선별 → 기술 표본 → 요청·eval 매핑.
+출력(모두 새 파일, 덮어쓰기 금지): results/iter_054/data/{images_info,eval_manifest,data_report}.json, requests.jsonl.
+모델 출력은 읽지 않는다. 의심 선별은 어휘 규칙이며 임상 재판독이 아니다 (원 점수에서 제거하지 않고 민감도 분석에만 사용)."""
+import json
+import os
+import re
+import sys
+from collections import Counter
+
+os.environ.setdefault("HF_HOME", "/SSD1_1TB/home/milab/daniel/08_medgemma/hf_cache")
+os.environ.setdefault("HF_HUB_OFFLINE", "1")
+import numpy as np
+from PIL import Image
+
+import mc54_requests as R
+import mc54_spec as S
+
+SRC = "results/iter_054/source"
+DATA = "results/iter_054/data"
+STOP = set("a an the of in on with and or to is are was were be by for at as from this that these those it its into no not "
+           "there showing shows show seen image images view after before without within between over under left right "
+           "arrow arrows".split())
+
+
+def jload(p):
+    return json.load(open(p))
+
+
+def verify_source():
+    man = jload(f"{SRC}/source_manifest.json")
+    for f, m in man["files"].items():
+        if S.sha(open(m["saved"], "rb").read()) != m["sha256"]:
+            sys.exit(f"source changed: {f}")
+    return man
+
+
+def words(t):
+    return {w for w in re.findall(r"[a-z]+", t.lower()) if w not in STOP and len(w) > 2}
+
+
+def frac(opt, cap):
+    w = words(opt)
+    return len(w & words(cap)) / len(w) if w else 0.0
+
+
+def suspicion(d):
+    """pair별 사전 의심 규칙: 어느 영상이든 (틀린 선택지의 caption 어휘 포함률 − 정답 선택지의 포함률) ≥ 0.25."""
+    out = []
+    for k in ("1", "2"):
+        cor = d[f"im_{k}_correct"]
+        o_c = d["option_A"] if cor == "A" else d["option_B"]
+        o_w = d["option_B"] if cor == "A" else d["option_A"]
+        cap = d[f"cap_{k}"]
+        out.append(round(frac(o_w, cap) - frac(o_c, cap), 4))
+    return out
+
+
+def load_rgb(path):
+    """JPEG → RGB. L은 3채널 복제(값 보존), RGB는 그대로. 그 외 mode는 거부(조용한 정규화 금지)."""
+    im = Image.open(path)
+    im.load()
+    if im.mode == "RGB":
+        arr = np.asarray(im)
+    elif im.mode == "L":
+        arr = np.asarray(im.convert("RGB"))
+    else:
+        raise ValueError(f"unsupported mode {im.mode} {path}")
+    return im.mode, Image.fromarray(arr), arr
+
+
+def components(pairs, dataset, imginfo, pmc_of):
+    """공유 영상 local / PMC / 동일 pixel hash로 pair를 연결한 union-find 성분."""
+    par = {p: p for p in pairs}
+
+    def f(x):
+        while par[x] != x:
+            par[x] = par[par[x]]
+            x = par[x]
+        return x
+
+    key_owner = {}
+    for p in pairs:
+        d = dataset[p]
+        keys = []
+        for k in ("im_1_local", "im_2_local"):
+            loc = d[k]
+            keys += [("img", loc), ("pmc", pmc_of[loc])]
+            if loc in imginfo:
+                keys.append(("px", imginfo[loc]["pixel_sha256"]))
+        for kk in keys:
+            if kk in key_owner:
+                par[f(p)] = f(key_owner[kk])
+            else:
+                key_owner[kk] = p
+    comp = {}
+    for p in pairs:
+        comp.setdefault(f(p), []).append(p)
+    return sorted((sorted(v) for v in comp.values()), key=lambda v: (-len(v), v[0]))
+
+
+def main():
+    man = verify_source()
+    dataset = jload(f"{SRC}/data__dataset.json")
+    idict = jload(f"{SRC}/data__image_dict.json")
+    fetch = jload(f"{DATA}/fetch_manifest.json")
+    assert len(dataset) == 176
+    if any(os.path.exists(f"{DATA}/{n}") for n in ("images_info.json", "eval_manifest.json", "data_report.json", "requests.jsonl")):
+        sys.exit("build outputs exist; refusing to overwrite")
+    local_of = {v["local"]: v for v in idict.values()}
+    pmc_of = {v["local"]: re.search(r"(PMC\d+)", v["dlink"]).group(1) for v in idict.values()}
+    # im_x_local ↔ image_dict 일치 검사
+    for pid, d in dataset.items():
+        for k in ("1", "2"):
+            ent = idict.get(d[f"im_{k}"])
+            if ent is None or ent["local"] != d[f"im_{k}_local"]:
+                sys.exit(f"pair {pid}: im_{k} not consistent with image_dict")
+    # 영상 정보
+    imginfo, missing = {}, {}
+    for r in fetch:
+        loc = r["local"]
+        if r["status"] != "ok":
+            missing[loc] = {"status": r["status"], "candidates": r.get("candidates")}
+            continue
+        if S.sha(open(r["saved"], "rb").read()) != r["sha256"]:
+            sys.exit(f"image changed {r['saved']}")
+        mode, pil, arr = load_rgb(r["saved"])
+        imginfo[loc] = {"path": r["saved"], "file_sha256": r["sha256"], "mode": mode, "size": list(pil.size),
+                        "pixel_sha256": S.sha(arr.tobytes() + str(arr.shape).encode()), "pmc": r["pmc"],
+                        "file_name": r["file_name"], "s3_key": r["s3_key"]}
+    all_locals = {d[f"im_{k}_local"] for d in dataset.values() for k in ("1", "2")}
+    assert all_locals == set(imginfo) | set(missing), (len(all_locals), len(imginfo), len(missing))
+    avail = sorted(p for p, d in dataset.items() if d["im_1_local"] in imginfo and d["im_2_local"] in imginfo)
+    unavailable = sorted(set(dataset) - set(avail))
+    # 중복 pixel (서로 다른 local이 같은 pixel)
+    pxc = Counter(v["pixel_sha256"] for v in imginfo.values())
+    dup_px = {h: [l for l, v in imginfo.items() if v["pixel_sha256"] == h] for h, c in pxc.items() if c > 1}
+    comps = components(sorted(dataset), dataset, imginfo, pmc_of)
+    comp_of = {p: i for i, c in enumerate(comps) for p in c}
+    avail_comp_sizes = Counter(comp_of[p] for p in avail)
+    # 기술 표본: seed 54, ID hash 순서, category 포함
+    order = sorted(avail, key=lambda p: S.sha(f"{S.SEED}|{p}"))
+    cats = lambda p: set(dataset[p]["category_1"]) | set(dataset[p]["category_2"])
+    tech, covered = [], set()
+    for p in order:
+        if len(tech) >= 12:
+            break
+        if cats(p) - covered:
+            tech.append(p)
+            covered |= cats(p)
+    for p in order:
+        if len(tech) >= 12:
+            break
+        if p not in tech:
+            tech.append(p)
+    # 추가 포함(자원 검사): 원본 크기 최대 영상 pair, 답변 token 최장 pair
+    import transformers
+    from rsna_diag import generate as G
+    os.environ.setdefault("HF_HOME", G.HF_HOME)
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    tk = transformers.AutoProcessor.from_pretrained(G.MODEL_ID, revision=G.MODEL_REVISION).tokenizer
+    biggest = max(imginfo, key=lambda l: (imginfo[l]["size"][0] * imginfo[l]["size"][1], l))
+    p_big = min(p for p in avail if biggest in (dataset[p]["im_1_local"], dataset[p]["im_2_local"]))
+    ntok = {p: max(len(tk.encode(dataset[p]["option_A"], add_special_tokens=False)),
+                   len(tk.encode(dataset[p]["option_B"], add_special_tokens=False))) for p in avail}
+    p_long = max(avail, key=lambda p: (ntok[p], p))
+    extras = [p for p in (p_big, p_long) if p not in tech]
+    tech_all = sorted(set(tech) | set(extras))
+    rows, evalmap = R.build(dataset, imginfo, set(avail), set(tech_all))
+    R.write_jsonl(f"{DATA}/requests.jsonl", rows)
+    susp = {p: suspicion(dataset[p]) for p in dataset}
+    flagged = sorted(p for p, v in susp.items() if max(v) >= 0.25)
+    pairs_meta = {}
+    for p in sorted(dataset):
+        d = dataset[p]
+        pairs_meta[p] = {"im1_local": d["im_1_local"], "im2_local": d["im_2_local"], "im1_correct": d["im_1_correct"],
+                         "im2_correct": d["im_2_correct"], "categories": sorted(cats(p)), "component": comp_of[p],
+                         "available": p in avail, "suspect_scores": susp[p], "suspect_flag": p in flagged,
+                         "tech": p in tech_all, "tech_role": ("sample" if p in tech else ("extra_big_image" if p == p_big else
+                                                              "extra_long_answer") if p in tech_all else None)}
+    ev = {"source_revision": man["revision"], "pairs": pairs_meta, "requests": evalmap,
+          "components": [{"id": i, "pairs": c, "n": len(c), "n_available": avail_comp_sizes.get(i, 0)} for i, c in enumerate(comps)]}
+    comp_sz = [len(c) for c in comps]
+    rep = {"n_pairs_official": len(dataset), "n_pairs_available": len(avail), "unavailable_pairs": unavailable,
+           "missing_images": {str(k): v for k, v in missing.items()}, "n_unique_images_official": len(all_locals),
+           "n_unique_images_acquired": len(imginfo), "n_unique_pmc": len(set(pmc_of.values())),
+           "n_unique_pixel_hash": len(pxc), "duplicate_pixel_groups": dup_px,
+           "n_components_all_pairs": len(comps), "component_sizes_top10": comp_sz[:10], "max_component_share_all": comp_sz[0] / len(dataset),
+           "n_components_available": len(avail_comp_sizes),
+           "max_component_share_available": max(avail_comp_sizes.values()) / len(avail),
+           "image_modes": dict(Counter(v["mode"] for v in imginfo.values())),
+           "tech_pairs": tech_all, "tech_sample": tech, "tech_extras": {"big_image_pair": p_big, "big_image_local": biggest,
+                                                                           "long_answer_pair": p_long, "max_answer_tokens": ntok[p_long]},
+           "tech_categories_covered": sorted(covered), "n_requests": len(rows), "n_requests_by_kind": dict(Counter(r["kind"] for r in rows)),
+           "n_requests_tech": sum(r["stage"] == "tech" for r in rows),
+           "n_text_only_requests": sum(r["modality"] == "text" for r in rows),
+           "suspect_rule": "any image: frac(wrong option content words in caption) - frac(correct option) >= 0.25",
+           "n_suspect_flagged": len(flagged), "suspect_pairs": flagged,
+           "repeated_question_options": sum(c > 1 for c in Counter((d["question"], d["option_A"], d["option_B"]) for d in dataset.values()).values()),
+           "license_note": "figures from PMC Open Access subset via AWS pmc-oa-opendata (per-article licenses vary, e.g. CC BY-NC); research diagnostic use only",
+           "note": "ambiguous image (two different PMC versions) kept missing; pair not substituted"}
+    for n, o in (("images_info.json", imginfo), ("eval_manifest.json", ev), ("data_report.json", rep)):
+        with open(f"{DATA}/{n}", "x") as f:
+            json.dump(o, f, indent=1)
+    print(json.dumps({k: rep[k] for k in ("n_pairs_available", "n_unique_images_acquired", "n_unique_pmc", "n_components_available",
+                                          "max_component_share_available", "n_requests", "n_requests_tech", "n_suspect_flagged",
+                                          "duplicate_pixel_groups", "tech_extras")}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mc54_decide.py b/mc54_decide.py
new file mode 100644
index 0000000..d1183fe
--- /dev/null
+++ b/mc54_decide.py
@@ -0,0 +1,66 @@
+"""iter_054 사전 고정 판정 규칙(plan.md Evaluation). 결과를 보고 문턱을 바꾸지 않는다.
+입력: eval report.json + verify.json(PASS 필수). 출력: decision.json (입력 digest 포함, 덮어쓰기 금지)."""
+import json
+import os
+import sys
+
+import mc54_eval as E
+import mc54_run as RUN
+
+TH = {"O_min": 0.70, "O_ci_lo_gt": 0.50, "G_min": 0.15, "G_ci_lo_gt": 0.05, "ACC_min": 0.05, "ACC_ci_lo_gt": 0.0,
+      "simple_dS_min": 0.10, "simple_resid_max": 0.05}
+
+
+def decide(rep, verify_ok):
+    b = rep["bootstrap_cluster"]
+    p = rep["point"]
+    c = {}
+    c["integrity_valid"] = bool(verify_ok)
+    c["O"] = p["O"] >= TH["O_min"] and b["O"]["ci95"][0] > TH["O_ci_lo_gt"]
+    c["G"] = p["G"] >= TH["G_min"] and b["G"]["ci95"][0] > TH["G_ci_lo_gt"]
+    c["ACC_vs_text"] = p["ACC_gd_minus_text"] >= TH["ACC_min"] and b["ACC_gd_minus_text"]["ci95"][0] > TH["ACC_ci_lo_gt"]
+    se = rep["suspect_excluded"]
+    c["suspect_excluded_direction"] = se["O"] > 0.5 and se["G"] > 0 and se["ACC_gd_minus_text"] > 0
+    ls = rep["loco_summary"]
+    c["loco_direction"] = ls["O_min"] > 0.5 and ls["G_min"] > 0 and ls["ACC_min"] > 0
+    c["component_inference_ok"] = not rep["component_inference_limited"]
+    positive_all = all(c.values())
+    simple = []
+    for n in E.BASE:
+        if n == "MC_orig":
+            continue
+        if p[f"dS:{n}"] >= TH["simple_dS_min"] and b[f"dS:{n}"]["ci95"][0] > 0 and p[f"O_minus_S:{n}"] <= TH["simple_resid_max"]:
+            simple.append(n)
+    negative = b["O"]["ci95"][1] < TH["O_min"] or b["G"]["ci95"][1] < TH["G_min"]
+    if not verify_ok:
+        label, action = "execution_invalid", "fix_and_remeasure_affected_requests_only"
+    elif simple:
+        label, action = "simple_alternative_explains", "close_new_calibration_investment_keep_baseline"
+    elif positive_all:
+        label, action = "positive", "next_full_review_may_consider_minimal_method_test_value_only"
+    elif negative:
+        label, action = "negative", "hold_single_image_calibration_candidate"
+    else:
+        label, action = "indeterminate", "hold_no_automatic_extension"
+    return {"label": label, "action": action, "criteria": c, "positive_all_criteria_met": positive_all, "positive_blocked_by_inference_limits_only":
+            bool(not positive_all and all(v for k, v in c.items() if k != "component_inference_ok") and not c["component_inference_ok"]),
+            "simple_alternative_systems": simple, "negative_condition": bool(negative), "thresholds": TH,
+            "key": {"O": p["O"], "O_ci95": b["O"]["ci95"], "G": p["G"], "G_ci95": b["G"]["ci95"], "max_S": p["max_S"],
+                    "ACC_gd_minus_text": p["ACC_gd_minus_text"], "ACC_ci95": b["ACC_gd_minus_text"]["ci95"]}}
+
+
+def main(rep_path, ver_path, out_path):
+    rep = json.load(open(rep_path))
+    ver = json.load(open(ver_path))
+    if os.path.exists(out_path):
+        sys.exit("decision exists")
+    ok = ver.get("all_pass") is True and ver.get("report_sha256") == RUN.file_sha(rep_path)
+    d = decide(rep, ok)
+    d["inputs"] = {"report": rep_path, "report_sha256": RUN.file_sha(rep_path), "verify": ver_path, "verify_sha256": RUN.file_sha(ver_path),
+                   "verify_all_pass": ver.get("all_pass")}
+    json.dump(d, open(out_path, "x"), indent=1)
+    print(json.dumps({k: d[k] for k in ("label", "action", "criteria", "simple_alternative_systems")}, indent=1))
+
+
+if __name__ == "__main__":
+    main(*sys.argv[1:4])
diff --git a/mc54_eval.py b/mc54_eval.py
new file mode 100644
index 0000000..aad786f
--- /dev/null
+++ b/mc54_eval.py
@@ -0,0 +1,274 @@
+"""iter_054 평가: raw record → 시스템별 답/margin → 지표, orientation O, G = O − max_b S_b, 연결 성분 cluster bootstrap, LOCO, 의심 제외, 최악/최선 범위.
+평가 입력은 verify_completion(main)으로 재검증한 raw만 쓴다. 정답·pair 대응은 eval_manifest에서만 읽는다.
+사용: python mc54_eval.py --out-dir results/iter_054/eval   (eval_lock.json이 현재 평가 소스·raw와 일치해야 실행)"""
+import argparse
+import glob
+import json
+import os
+import sys
+
+import numpy as np
+
+import mc54_run as RUN
+import mc54_spec as S
+
+REQ = "results/iter_054/data/requests.jsonl"
+PROTO = "results/iter_054/protocol/protocol_main.json"
+MAIN = "results/iter_054/raw/main"
+EVM = "results/iter_054/data/eval_manifest.json"
+BASE = ["MC_orig", "MC_swap", "GD_orig", "GD_swap", "GD_avg", "GD_cal", "PS", "PS_cal"]
+NREP, SEED = 10000, 54
+PRIMARY_PARSER = "strict"
+EVAL_CODE = ["mc54_eval.py", "mc54_decide.py", "mc54_verify.py", "mc54_spec.py", "mc54_run.py"]
+
+
+def mc_letter(rec, order, parser):
+    txt = rec["payload"]["suffix_text_raw"]
+    ok_eos = rec["payload"]["ended_eos"]
+    shown = S.parse_strict(txt) if parser == "strict" else S.parse_official_manual(txt)
+    if not ok_eos:
+        shown = "-"  # 비EOS 최종 출력은 invalid로 유지
+    return S.to_canonical_letter(shown, order)
+
+
+def observations(recs, evm):
+    """pair → {mc:{(slot,order):rec}, gd:{...}, ps:{(slot,opt):rec}}"""
+    obs = {}
+    for r in recs:
+        m = evm["requests"][r["request_id"]]
+        o = obs.setdefault(m["pair"], {"mc": {}, "gd": {}, "ps": {}})
+        key = (m["slot"], m["order"]) if m["kind"] != "ps" else (m["slot"], m["option"])
+        assert key not in o[m["kind"]], (m, key)
+        o[m["kind"]][key] = r
+    return obs
+
+
+def systems_for_pair(o, parser):
+    """returns dict system → {'ans':(a1,a2) canonical, 'margin':(m1,m2) or None}; text-only systems under 'T_*'."""
+    out = {}
+    for order in S.ORDERS:
+        out[f"MC_{order}"] = {"ans": tuple(mc_letter(o["mc"][(s, order)], order, parser) for s in ("im1", "im2")), "margin": None}
+        out[f"T_MC_{order}"] = {"ans": (mc_letter(o["mc"][("text", order)], order, parser),) * 2, "margin": None}
+    gm = {}
+    for order in S.ORDERS:
+        for s in ("im1", "im2", "text"):
+            gm[(s, order)] = S.canonical_margin(o["gd"][(s, order)]["payload"]["shown_margin"], order)
+    for order in S.ORDERS:
+        mg = (gm[("im1", order)], gm[("im2", order)])
+        out[f"GD_{order}"] = {"ans": tuple(S.pick_from_margin(x) for x in mg), "margin": mg}
+        t = gm[("text", order)]
+        out[f"T_GD_{order}"] = {"ans": (S.pick_from_margin(t),) * 2, "margin": (t, t)}
+    avg = tuple((gm[(s, "orig")] + gm[(s, "swap")]) / 2 for s in ("im1", "im2"))
+    tavg = (gm[("text", "orig")] + gm[("text", "swap")]) / 2
+    out["GD_avg"] = {"ans": tuple(S.pick_from_margin(x) for x in avg), "margin": avg}
+    out["T_GD_avg"] = {"ans": (S.pick_from_margin(tavg),) * 2, "margin": (tavg, tavg)}
+    cal = tuple(a - tavg for a in avg)
+    out["GD_cal"] = {"ans": tuple(S.pick_from_margin(x) for x in cal), "margin": cal}
+    ps = {k: o["ps"][k]["payload"]["mean_ll"] for k in o["ps"]}
+    d = tuple(ps[(s, "A")] - ps[(s, "B")] for s in ("im1", "im2"))
+    dt = ps[("text", "A")] - ps[("text", "B")]
+    out["PS"] = {"ans": tuple(S.pick_from_margin(x) for x in d), "margin": d}
+    out["T_PS"] = {"ans": (S.pick_from_margin(dt),) * 2, "margin": (dt, dt)}
+    c = tuple(x - dt for x in d)
+    out["PS_cal"] = {"ans": tuple(S.pick_from_margin(x) for x in c), "margin": c}
+    return out
+
+
+def orient(margin, truth):
+    """정답 A 영상 margin vs 정답 B 영상 margin. truth=(t1,t2) 가 서로 다를 때만."""
+    if truth[0] == truth[1] or margin is None:
+        return None
+    ia = 0 if truth[0] == "A" else 1
+    return S.orientation(margin[ia], margin[1 - ia])
+
+
+def per_pair_table(recs, evm, parser=PRIMARY_PARSER):
+    obs = observations(recs, evm)
+    pairs = sorted(obs)
+    tab = {}
+    for p in pairs:
+        pm = evm["pairs"][p]
+        truth = (pm["im1_correct"], pm["im2_correct"])
+        sy = systems_for_pair(obs[p], parser)
+        row = {"truth": truth, "component": pm["component"], "suspect": pm["suspect_flag"], "systems": {}}
+        for name, v in sy.items():
+            c1, i1, c2, i2, conf = S.set_outcome(v["ans"][0], v["ans"][1], truth[0], truth[1])
+            row["systems"][name] = {"ans": v["ans"], "c1": c1, "c2": c2, "i1": int(i1), "i2": int(i2), "conf": conf, "set": int(c1 and c2),
+                                    "near_tie": (None if v["margin"] is None else int(any(abs(x) < 0.125 for x in v["margin"]))),
+                                    "margin": v["margin"]}
+        row["orient"] = {n: orient(sy[n]["margin"], truth) for n in ("GD_avg", "GD_cal", "PS", "PS_cal", "T_GD_avg", "T_PS")}
+        tab[p] = row
+    return tab
+
+
+def summarize(tab, names):
+    pairs = sorted(tab)
+    N = len(pairs)
+    out = {}
+    for n in names:
+        v = [tab[p]["systems"][n] for p in pairs]
+        nvalid_pair = sum(1 for x in v if not x["i1"] and not x["i2"])
+        conf = sum(x["conf"] for x in v)
+        out[n] = {"individual_acc": sum(x["c1"] + x["c2"] for x in v) / (2 * N), "set_acc": sum(x["set"] for x in v) / N,
+                  "invalid_or_abstain_rate": sum(x["i1"] + x["i2"] for x in v) / (2 * N), "image_coverage": 1 - sum(x["i1"] + x["i2"] for x in v) / (2 * N),
+                  "valid_pair_coverage": nvalid_pair / N, "same_answer_rate_all_pairs": conf / N,
+                  "confusion_among_valid_pairs": (conf / nvalid_pair if nvalid_pair else None),
+                  "near_tie_slots": (None if v[0]["near_tie"] is None else sum(x["near_tie"] for x in v))}
+    return out
+
+
+def pair_vectors(tab, pairs):
+    """bootstrap용 pair 수준 벡터."""
+    vec = {}
+    for n in BASE:
+        vec[f"S:{n}"] = np.array([tab[p]["systems"][n]["set"] for p in pairs], float)
+    vec["ACC:GD_avg"] = np.array([(tab[p]["systems"]["GD_avg"]["c1"] + tab[p]["systems"]["GD_avg"]["c2"]) / 2 for p in pairs], float)
+    vec["ACC:T_GD_avg"] = np.array([(tab[p]["systems"]["T_GD_avg"]["c1"] + tab[p]["systems"]["T_GD_avg"]["c2"]) / 2 for p in pairs], float)
+    vec["O:GD_avg"] = np.array([tab[p]["orient"]["GD_avg"] for p in pairs], float)
+    return vec
+
+
+def stats_from(means):
+    """means: dict vec-key → 값. returns O, G, 각 baseline S, ΔS vs MC_orig, 정확도 차."""
+    s = {n: means[f"S:{n}"] for n in BASE}
+    mx = max(s.values())
+    o = means["O:GD_avg"]
+    d = {"O": o, "G": o - mx, "max_S": mx, "ACC_gd_minus_text": means["ACC:GD_avg"] - means["ACC:T_GD_avg"]}
+    d.update({f"S:{n}": s[n] for n in BASE})
+    d.update({f"dS:{n}": s[n] - s["MC_orig"] for n in BASE})
+    d.update({f"O_minus_S:{n}": o - s[n] for n in BASE})
+    return d
+
+
+def cluster_bootstrap(tab, pairs, nrep=NREP, seed=SEED):
+    comps = sorted({tab[p]["component"] for p in pairs})
+    K = len(comps)
+    ci = {c: i for i, c in enumerate(comps)}
+    vec = pair_vectors(tab, pairs)
+    N_k = np.zeros(K)
+    A = {k: np.zeros(K) for k in vec}
+    for j, p in enumerate(pairs):
+        k = ci[tab[p]["component"]]
+        N_k[k] += 1
+        for key, v in vec.items():
+            A[key][k] += v[j]
+    rs = np.random.RandomState(seed)
+    reps = []
+    for _ in range(nrep):
+        cnt = np.bincount(rs.randint(0, K, size=K), minlength=K).astype(float)
+        den = cnt @ N_k
+        reps.append(stats_from({k: (cnt @ A[k]) / den for k in vec}))
+    keys = reps[0].keys()
+    res = {}
+    for k in keys:
+        a = np.array([r[k] for r in reps])
+        res[k] = {"ci95": [float(np.percentile(a, 2.5)), float(np.percentile(a, 97.5))], "ci975": [float(np.percentile(a, 1.25)), float(np.percentile(a, 98.75))]}
+    return res, K
+
+
+def point(tab, pairs):
+    vec = pair_vectors(tab, pairs)
+    return stats_from({k: float(np.mean(v)) for k, v in vec.items()})
+
+
+def loco(tab, pairs):
+    comps = sorted({tab[p]["component"] for p in pairs})
+    rows = []
+    for c in comps:
+        sub = [p for p in pairs if tab[p]["component"] != c]
+        s = point(tab, sub)
+        rows.append({"dropped_component": c, "n_pairs_dropped": len(pairs) - len(sub), "O": s["O"], "G": s["G"],
+                     "ACC_gd_minus_text": s["ACC_gd_minus_text"]})
+    return rows
+
+
+def missing_range(point_s, n_avail, n_total, o_pairs_avail):
+    """미확보 pair를 최악/최선으로 채웠을 때 O, G의 가능한 범위 (모든 시스템 S는 0 또는 1 가능, O는 0 또는 1)."""
+    k = n_total - n_avail
+    mxS = point_s["max_S"] * n_avail
+    O_sum = point_s["O"] * n_avail
+    lo = (O_sum) / n_total - (mxS + k) / n_total
+    hi = (O_sum + k) / n_total - (mxS) / n_total
+    return {"n_missing_pairs": k, "O_range": [O_sum / n_total, (O_sum + k) / n_total], "G_range": [lo, hi]}
+
+
+def lock_check(lock_path):
+    lk = json.load(open(lock_path))
+    for f, h in lk["eval_code"].items():
+        if RUN.file_sha(f) != h:
+            raise SystemExit(f"eval lock violated: {f} changed")
+    if RUN.file_sha(EVM) != lk["eval_manifest_sha256"] or RUN.file_sha(os.path.join(MAIN, "completion.json")) != lk["completion_sha256"]:
+        raise SystemExit("eval lock violated: manifest/completion")
+    return lk
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--lock", required=True)
+    a = ap.parse_args()
+    lk = lock_check(a.lock)
+    recs = RUN.verify_completion(MAIN, REQ, PROTO)  # raw–protocol–요청 연결 재검증
+    evm = json.load(open(EVM))
+    os.makedirs(a.out_dir, exist_ok=True)
+    rep_path = os.path.join(a.out_dir, "report.json")
+    if os.path.exists(rep_path):
+        sys.exit("report exists; refusing to overwrite")
+    tab = per_pair_table(recs, evm, PRIMARY_PARSER)
+    tab_off = per_pair_table(recs, evm, "official")
+    pairs = sorted(tab)
+    names_all = BASE + ["T_MC_orig", "T_MC_swap", "T_GD_orig", "T_GD_swap", "T_GD_avg", "T_PS"]
+    summ = summarize(tab, names_all)
+    summ_off = summarize(tab_off, ["MC_orig", "MC_swap", "T_MC_orig", "T_MC_swap"])
+    pt = point(tab, pairs)
+    boot, K = cluster_bootstrap(tab, pairs)
+    n_comp = K
+    comp_sizes = {}
+    for p in pairs:
+        comp_sizes[tab[p]["component"]] = comp_sizes.get(tab[p]["component"], 0) + 1
+    max_share = max(comp_sizes.values()) / len(pairs)
+    # O 계열 및 회귀 검사
+    orient = {n: float(np.mean([tab[p]["orient"][n] for p in pairs])) for n in ("GD_avg", "GD_cal", "PS", "PS_cal", "T_GD_avg", "T_PS")}
+    cal_eq = all(tab[p]["orient"]["GD_cal"] == tab[p]["orient"]["GD_avg"] for p in pairs)
+    pscal_eq = all(tab[p]["orient"]["PS_cal"] == tab[p]["orient"]["PS"] for p in pairs)
+    text_half = all(tab[p]["orient"]["T_GD_avg"] == 0.5 and tab[p]["orient"]["T_PS"] == 0.5 for p in pairs)
+    n_same_truth = sum(tab[p]["truth"][0] == tab[p]["truth"][1] for p in pairs)
+    lo = loco(tab, pairs)
+    nosus = [p for p in pairs if not tab[p]["suspect"]]
+    pt_nosus = point(tab, nosus)
+    # 사전 의심 제외 민감도: 점추정만 (CI는 보조)
+    rng_missing = missing_range(pt, len(pairs), len(evm["pairs"]), None)
+    # MC 출력 형식 통계
+    mc_recs = [r for r in recs if r["kind"] == "mc"]
+    parse_diff = sum(S.parse_strict(r["payload"]["suffix_text_raw"]) != S.parse_official_manual(r["payload"]["suffix_text_raw"]) for r in mc_recs)
+    mc_stats = {"n_mc": len(mc_recs), "n_retry": sum(len(r["payload"]["attempts"]) > 1 for r in mc_recs),
+                "n_non_eos_final": sum(not r["payload"]["ended_eos"] for r in mc_recs), "strict_vs_official_differ": parse_diff,
+                "max_output_tokens": max(r["payload"]["n_output_tokens"] for r in mc_recs)}
+    comp = json.load(open(os.path.join(MAIN, "completion.json")))
+    report = {"n_pairs_evaluated": len(pairs), "n_pairs_official": len(evm["pairs"]), "n_components": n_comp, "max_component_share": max_share,
+              "component_inference_limited": bool(n_comp < 20 or max_share > 0.20), "parser_primary": PRIMARY_PARSER,
+              "systems": summ, "systems_official_parser_sensitivity": summ_off, "orientation_point": orient, "orientation_regression": {
+                  "GD_cal_equals_GD_avg_per_pair": cal_eq, "PS_cal_equals_PS_per_pair": pscal_eq, "text_only_orientation_exactly_half": text_half,
+                  "n_pairs_same_truth_letter_excluded_from_orientation": n_same_truth},
+              "point": pt, "bootstrap_cluster": boot, "bootstrap_config": {"n_rep": NREP, "seed": SEED, "unit": "connected component (shared image/PMC/pixel)", "n_units": K},
+              "loco": lo, "loco_summary": {"O_min": min(r["O"] for r in lo), "G_min": min(r["G"] for r in lo), "G_max": max(r["G"] for r in lo),
+                                           "ACC_min": min(r["ACC_gd_minus_text"] for r in lo)},
+              "suspect_excluded": {"n_excluded": len(pairs) - len(nosus), "O": pt_nosus["O"], "G": pt_nosus["G"], "ACC_gd_minus_text": pt_nosus["ACC_gd_minus_text"]},
+              "missing_pairs_range": rng_missing, "mc_stats": mc_stats,
+              "cost": {k: comp.get(k) for k in ("sum_request_wall_s_all_records", "peak_mem_reserved_gb_max", "by_kind_mean_wall_s", "n_mc_retries",
+                                               "n_forward_calls", "n_generate_calls_all_attempts", "wall_s_this_attempt")},
+              "cost_all_attempts": comp["cost_all_attempts"], "cost_this_dir_only": comp["cost_this_dir_only"],
+              "provenance": {"eval_lock_sha256": RUN.file_sha(a.lock), "eval_code": lk["eval_code"], "completion_sha256": lk["completion_sha256"],
+                             "eval_manifest_sha256": lk["eval_manifest_sha256"], "protocol_main_sha256": RUN.file_sha(PROTO)}}
+    pp = {p: {"truth": tab[p]["truth"], "component": tab[p]["component"], "suspect": tab[p]["suspect"], "orient": tab[p]["orient"],
+              "systems": {n: {k: v for k, v in tab[p]["systems"][n].items()} for n in names_all}} for p in pairs}
+    tmp = rep_path + f".{os.getpid()}.tmp"
+    with open(os.path.join(a.out_dir, "per_pair.json"), "x") as f:
+        json.dump(pp, f)
+    json.dump(report, open(tmp, "w"), indent=1)
+    os.replace(tmp, rep_path)
+    print(json.dumps({"n": len(pairs), "O": pt["O"], "G": pt["G"], "max_S": pt["max_S"]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mc54_fetch_images.py b/mc54_fetch_images.py
new file mode 100644
index 0000000..6874148
--- /dev/null
+++ b/mc54_fetch_images.py
@@ -0,0 +1,83 @@
+"""iter_054: MediConfusion figure 확보. 공식 download.py(NCBI oa_package tar.gz; 2026-10 현재 404)와 달리
+PMC Open Access AWS 공개 버킷(pmc-oa-opendata)에서 image_dict의 file_name figure 하나씩만 받는다.
+- 기존 파일 덮어쓰기 금지(xb), basename만 허용(경로 이탈 거부), 전송 MD5(ETag/media_urls)와 크기 검증.
+- 출력: results/iter_054/data/images/<local>.jpg, results/iter_054/data/fetch_manifest.json
+"""
+import hashlib
+import json
+import os
+import re
+import sys
+import urllib.parse
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+
+SRC = "results/iter_054/source/data__image_dict.json"
+OUT = "results/iter_054/data"
+S3 = "https://pmc-oa-opendata.s3.amazonaws.com"
+
+
+def get(url):
+    with urllib.request.urlopen(url, timeout=120) as r:
+        return r.read(), dict(r.headers)
+
+
+def pmcid(dlink):
+    m = re.search(r"/(PMC\d+)\.tar\.gz$", dlink)
+    if not m:
+        raise ValueError(dlink)
+    return m.group(1)
+
+
+def article(pmc):
+    """S3에서 PMC 문서 prefix의 object 목록과 json 메타를 읽는다."""
+    xml, _ = get(f"{S3}/?prefix={pmc}.&max-keys=1000")
+    keys = re.findall(r"<Key>(.*?)</Key>.*?<ETag>&quot;(.*?)&quot;</ETag>.*?<Size>(\d+)</Size>", xml.decode(), flags=re.S)
+    return {k: (e, int(s)) for k, e, s in keys}
+
+
+def fetch_one(item):
+    path, v = item
+    local, fname, pmc = v["local"], v["file_name"], pmcid(v["dlink"])
+    if os.path.basename(fname) != fname or fname.startswith("."):
+        raise ValueError(f"unsafe file_name {fname}")
+    keys = article(pmc)
+    cand = [k for k in keys if k.endswith("/" + fname)]
+    if len(cand) != 1:
+        return {"roco_path": path, "local": local, "pmc": pmc, "file_name": fname, "status": "not_found", "candidates": cand}
+    key = cand[0]
+    etag, size = keys[key]
+    data, hdr = get(f"{S3}/{urllib.parse.quote(key)}")
+    md5 = hashlib.md5(data).hexdigest()
+    ok = (len(data) == size) and (md5 == etag or "-" in etag)
+    dst = os.path.join(OUT, "images", f"{local}.jpg")
+    rec = {"roco_path": path, "local": local, "pmc": pmc, "file_name": fname, "s3_key": key, "etag": etag, "size": size,
+           "md5": md5, "sha256": hashlib.sha256(data).hexdigest(), "status": "ok" if ok else "checksum_mismatch"}
+    if ok:
+        with open(dst, "xb") as f:
+            f.write(data)
+        rec["saved"] = dst
+    return rec
+
+
+def main():
+    d = json.load(open(SRC))
+    os.makedirs(os.path.join(OUT, "images"), exist_ok=True)
+    items = sorted(d.items(), key=lambda kv: kv[1]["local"])
+    locals_ = [v["local"] for _, v in items]
+    if len(set(locals_)) != len(locals_):
+        sys.exit("duplicate local ids in image_dict")
+    todo = [it for it in items if not os.path.exists(os.path.join(OUT, "images", f"{it[1]['local']}.jpg"))]
+    print("to fetch", len(todo), "of", len(items))
+    with ThreadPoolExecutor(6) as ex:
+        res = list(ex.map(fetch_one, todo))
+    mf = os.path.join(OUT, "fetch_manifest.json")
+    prev = json.load(open(mf)) if os.path.exists(mf) else []
+    json.dump(prev + res, open(mf + ".tmp", "w"), indent=1)
+    os.replace(mf + ".tmp", mf)
+    from collections import Counter
+    print(Counter(r["status"] for r in res))
+
+
+if __name__ == "__main__":
+    main()
