+"""평가 실행 전에 평가 소스·manifest·completion digest를 잠근다 (결과를 보기 전)."""
+import json
+import os
+import sys
+
+import mc54_eval as E
+import mc54_run as RUN
+
+out = sys.argv[1]
+if os.path.exists(out):
