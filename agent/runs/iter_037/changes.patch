+    chk("c800 sft17 rematch rate (old transfer_rate)", ps["sft17"]["gt_hit_by_independent_rematch_0.5_rate"], op["sft"]["transfer_rate_to_iou0.5"])
+    for nm, key in (("detector17", "det17__selected"), ("sft17", "sft17")):
