+                            ("no_box", {"boxes": []}, "no_box"), ("unmapped", {"labels": ["zz"]}, "label_unmapped")]:
+    f = {"abnormal": True, "sentence_en": "Nodule in the right upper lobe.", "boxes": [[.1, .1, .3, .3]], "labels": ["a"],
