+sel2 = D.select(pool, "train", [("D", 24), ("E", 288)])
+check("select_deterministic", [c["PatientID"] for c in sel["E"]["chosen"]] == [c["PatientID"] for c in sel2["E"]["chosen"]])
+q = D.apportion({"a": 100, "b": 30, "c": 5}, 24)
