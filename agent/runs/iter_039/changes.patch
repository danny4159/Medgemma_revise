+
+
+px = lambda p: "x"
+ok = R.validate_records({"f0": [mk(0), mk(1)]}, rb, "P", "C", px)
+check("validate_accepts_partial", len(ok) == 2)
+
+
+def rejects(files, pxf=px):
+    try:
+        R.validate_records(files, rb, "P", "C", pxf)
+        return False
+    except R.RunError:
+        return True
+
