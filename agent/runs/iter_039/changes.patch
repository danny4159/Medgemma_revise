+check("parse_truncated", S.parse_ids('Final Answer: [{"box_2d": [1,2', False, {"qA"})["status"] == "truncated")
+check("parse_nonfinite", S.parse_ids('Final Answer: [{"box_2d": [1,2,NaN,4], "label": "qA"}]<end_of_turn>', True, {"qA"})["status"]
