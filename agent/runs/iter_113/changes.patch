+    chk["capture_D"] = sum(ents[i]["e"] for i in sd) == rep["capture_D"]
+    chk["capture_B"] = sum(ents[i]["e"] for i in sb) == rep["capture_B"]
+    chk["diff"] = d == rep["diff"]
