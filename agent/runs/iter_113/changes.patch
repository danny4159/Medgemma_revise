+    K = kk(len(ents))
+    vals = sorted((e[f] for e in ents), reverse=True)
+    rk = vals[K - 1]
+    forced = [i for i, e in enumerate(ents) if e[f] > rk]
+    tied = [i for i, e in enumerate(ents) if e[f] == rk]
+    need = K - len(forced)
+    return [set(forced) | set(c) for c in itertools.combinations(tied, need)]
+
+
+def main():
