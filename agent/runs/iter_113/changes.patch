+    chk["selected_B_ids"] = sorted(ents[i]["key"] for i in sb) == sorted(rep["selected_B"])
+    chk["excluded"] = sorted(k for k, _ in ex) == sorted(x["item_key"] for x in rep["excluded_from_ranking"])
+    # annotation status
+    def st(e):
