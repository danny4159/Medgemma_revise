diff --git a/det_jobs.py b/det_jobs.py
new file mode 100644
index 0000000..d2049d8
--- /dev/null
+++ b/det_jobs.py
@@ -0,0 +1,146 @@
+"""detector 작업 실행기 (기본 medgemma Python에서 실행).
+
+계획(iter_033 §0, iter_035 §1·§6)에 따라 detector 코드는 기존 detector 전용 환경
+(/home/test/.conda/envs/natten_py310/bin/python)을 subprocess로 명시 호출해 실행한다.
+이 실행기는 임의 명령 전달기가 아니다: research/rsna_diag/det_*.py와 research/tests_det/*.py만 실행하고,
+상속된 CUDA_VISIBLE_DEVICES 허용 집합 안에서 논리 index→물리 GPU를 배정한다.
+
+spec(JSON): {"name": str, "out_dir": str, "stages": [[job, ...], ...]}
+  job: {"name", "script"(research 기준 상대경로), "args": [...], "gpu": 논리 index 또는 null,
+        "ok_rc": [0], "env": {"DET_TEST_SOURCE_SALT": ...}(허용 키만)}
+stage 안의 job은 동시에, stage는 순서대로 실행한다. job 실패 시 이후 stage를 시작하지 않는다.
+진행 상태는 out_dir/status.json(60초 주기)에 GPU 메모리·마지막 로그와 함께 기록하고, 모든 자식의 실제
+종료 코드를 out_dir/result.json에 남긴다. SIGTERM/SIGINT를 받으면 자식에게 SIGTERM을 전달하고 기다린다.
+"""
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+BASE = "/SSD1_1TB/home/milab/daniel/08_medgemma/research"
+DET_PY = "/home/test/.conda/envs/natten_py310/bin/python"
+ALLOWED_PREFIX = ("rsna_diag/det_", "tests_det/")
+ALLOWED_ENV = {"DET_TEST_SOURCE_SALT"}
+_STOP = {"flag": False}
+
+
+def _h(signum, frame):
+    _STOP["flag"] = True
+
+
+def allowed_gpus():
+    v = os.environ.get("CUDA_VISIBLE_DEVICES")
+    if v is None or v.strip() == "":
+        raise RuntimeError("CUDA_VISIBLE_DEVICES not set; refusing to pick GPUs outside the inherited set")
+    return [x.strip() for x in v.split(",") if x.strip()]
+
+
+def gpu_mem():
+    try:
+        out = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,memory.used,memory.total,utilization.gpu",
+                              "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=30).stdout
+        return [dict(zip(["index", "uuid", "used_mib", "total_mib", "util"], [s.strip() for s in l.split(",")]))
+                for l in out.strip().splitlines()]
+    except Exception as e:  # noqa: BLE001
+        return str(e)
+
+
+def tail(path, n=2):
+    try:
+        with open(path, "rb") as f:
+            f.seek(0, 2)
+            size = f.tell()
+            f.seek(max(0, size - 4000))
+            return f.read().decode(errors="replace").strip().splitlines()[-n:]
+    except Exception:
+        return []
+
+
+def launch(job, out_dir, gpus):
+    script = job["script"]
+    if not script.startswith(ALLOWED_PREFIX) or ".." in script or not script.endswith(".py"):
+        raise RuntimeError(f"script not allowed: {script}")
+    path = os.path.join(BASE, script)
+    if not os.path.isfile(path):
+        raise FileNotFoundError(path)
+    env = dict(os.environ)
+    if job.get("gpu") is not None:
+        g = int(job["gpu"])
+        if g < 0 or g >= len(gpus):
+            raise RuntimeError(f"gpu index {g} outside inherited set {gpus}")
+        env["CUDA_VISIBLE_DEVICES"] = gpus[g]
+    for k, v in (job.get("env") or {}).items():
+        if k not in ALLOWED_ENV:
+            raise RuntimeError(f"env key not allowed: {k}")
+        env[k] = v
+    env["PYTHONUNBUFFERED"] = "1"
+    log = os.path.join(out_dir, f"{job['name']}.log")
+    fh = open(log, "a")
+    fh.write(f"\n=== launch {time.strftime('%Y-%m-%d %H:%M:%S')} gpu_logical={job.get('gpu')} "
+             f"physical={env.get('CUDA_VISIBLE_DEVICES')} ===\n")
+    fh.flush()
+    p = subprocess.Popen([DET_PY, path] + [str(a) for a in job.get("args", [])], cwd=BASE, env=env,
+                         stdout=fh, stderr=subprocess.STDOUT, start_new_session=False)
+    return {"job": job, "proc": p, "log": log, "fh": fh, "t0": time.time(),
+            "physical_gpu": env.get("CUDA_VISIBLE_DEVICES")}
+
+
+def main():
+    spec = json.load(open(sys.argv[1]))
+    out_dir = spec["out_dir"]
+    os.makedirs(out_dir, exist_ok=True)
+    gpus = allowed_gpus()
+    signal.signal(signal.SIGTERM, _h)
+    signal.signal(signal.SIGINT, _h)
+    results = []
+    status_path = os.path.join(out_dir, "status.json")
+    t_start = time.time()
+    failed = False
+    for si, stage in enumerate(spec["stages"]):
+        if failed or _STOP["flag"]:
+            for job in stage:
+                results.append({"name": job["name"], "stage": si, "rc": None, "skipped": True})
+            continue
+        running = [launch(j, out_dir, gpus) for j in stage]
+        last_status = 0.0
+        while True:
+            alive = [r for r in running if r["proc"].poll() is None]
+            if _STOP["flag"]:
+                for r in alive:
+                    r["proc"].send_signal(signal.SIGTERM)
+            if time.time() - last_status >= 60 or not alive:
+                st = {"spec": spec["name"], "stage": si, "elapsed_s": round(time.time() - t_start),
+                      "gpus_inherited": gpus, "gpu": gpu_mem(), "stop_requested": _STOP["flag"],
+                      "jobs": [{"name": r["job"]["name"], "pid": r["proc"].pid, "rc": r["proc"].poll(),
+                                "physical_gpu": r["physical_gpu"], "elapsed_s": round(time.time() - r["t0"]),
+                                "tail": tail(r["log"])} for r in running]}
+                tmp = status_path + ".tmp"
+                with open(tmp, "w") as f:
+                    json.dump(st, f, indent=1)
+                os.replace(tmp, status_path)
+                last_status = time.time()
+            if not alive:
+                break
+            time.sleep(5)
+        for r in running:
+            rc = r["proc"].wait()
+            r["fh"].close()
+            ok = rc in r["job"].get("ok_rc", [0])
+            results.append({"name": r["job"]["name"], "stage": si, "rc": rc, "ok": ok, "pid": r["proc"].pid,
+                            "physical_gpu": r["physical_gpu"], "wall_s": round(time.time() - r["t0"], 1),
+                            "log": r["log"]})
+            if not ok:
+                failed = True
+    res = {"spec": spec["name"], "all_ok": (not failed) and not _STOP["flag"]
+           and all(r.get("ok") for r in results), "stopped": _STOP["flag"],
+           "wall_s": round(time.time() - t_start, 1), "jobs": results}
+    with open(os.path.join(out_dir, "result.json"), "w") as f:
+        json.dump(res, f, indent=2)
+    print(json.dumps(res, indent=1))
+    sys.exit(0 if res["all_ok"] else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/det_audit.py b/rsna_diag/det_audit.py
new file mode 100644
index 0000000..d5eff6e
--- /dev/null
+++ b/rsna_diag/det_audit.py
@@ -0,0 +1,125 @@
+"""train2400+validation400+confirm800(=3600명) 전체 file/pixel hash 및 분할 중복 감사.
+iter_033 data_audit.json은 60명 표본만 재계산했다; 이번에는 전체를 재계산한다. default env, torch 불필요.
+원본: results/iter_034/data_audit_full.py (sha256 59dd08cf...). iter_035: 출력 경로를 iter_035로 바꾸고,
+detector 학습·평가 manifest(train2400_full/V100/V400/D32/L64/D24)가 iter_010 분할의 부분집합인지와
+iter_034 감사 결과와의 불변성을 함께 기록한다. 기존 결과 파일은 덮어쓰지 않는다."""
+import hashlib
+import json
+import os
+
+import numpy as np
+from PIL import Image
+
+BASE = "/SSD1_1TB/home/milab/daniel/08_medgemma/research"
+IT010 = f"{BASE}/results/iter_010/manifests"
+OUT = f"{BASE}/results/iter_035/data"
+
+
+def main():
+    gt = json.load(open(f"{IT010}/gt_manifest.json"))
+    train_ids = json.load(open(f"{IT010}/train_ids.json"))
+    val_ids = json.load(open(f"{IT010}/validation_ids.json"))
+    confirm_ids = json.load(open(f"{IT010}/confirm_ids.json"))
+    infer = {}
+    with open(f"{IT010}/infer_manifest.jsonl") as f:
+        for line in f:
+            r = json.loads(line)
+            infer[r["id"]] = r
+
+    all_ids = train_ids + val_ids + confirm_ids
+    overlaps = {
+        "train_val": sorted(set(train_ids) & set(val_ids)),
+        "train_confirm": sorted(set(train_ids) & set(confirm_ids)),
+        "val_confirm": sorted(set(val_ids) & set(confirm_ids)),
+    }
+    dup_within = len(all_ids) - len(set(all_ids))
+
+    hash_mismatches = []
+    missing_gt = []
+    missing_infer = []
+    pixel_hash_all = {}
+    n_checked = 0
+    for pid in all_ids:
+        if pid not in gt:
+            missing_gt.append(pid)
+            continue
+        if pid not in infer:
+            missing_infer.append(pid)
+            continue
+        rec = infer[pid]
+        path = f"{BASE}/{rec['image']}"
+        with open(path, "rb") as f:
+            data = f.read()
+        file_sha = hashlib.sha256(data).hexdigest()
+        arr = np.array(Image.open(path))
+        pixel_sha = hashlib.sha256(arr.tobytes()).hexdigest()
+        pixel_hash_all[pid] = pixel_sha
+        n_checked += 1
+        if file_sha != rec.get("file_sha256"):
+            hash_mismatches.append({"id": pid, "kind": "file", "expected": rec.get("file_sha256"), "got": file_sha})
+        if pixel_sha != gt[pid].get("pixel_sha256"):
+            hash_mismatches.append({"id": pid, "kind": "pixel", "expected": gt[pid].get("pixel_sha256"), "got": pixel_sha})
+
+    # cross-split decoded-pixel duplicate check across the FULL 3600 (not just a sample)
+    by_pixel = {}
+    id_to_split = {}
+    for pid in train_ids:
+        id_to_split[pid] = "train"
+    for pid in val_ids:
+        id_to_split[pid] = "validation"
+    for pid in confirm_ids:
+        id_to_split[pid] = "confirm"
+    for pid, h in pixel_hash_all.items():
+        by_pixel.setdefault(h, []).append(pid)
+    dup_pixel_groups = {h: ids for h, ids in by_pixel.items() if len(ids) > 1}
+    cross_split_dup = {h: ids for h, ids in dup_pixel_groups.items()
+                        if len(set(id_to_split[i] for i in ids)) > 1}
+
+    issues = []
+    if any(overlaps.values()):
+        issues.append("patient id overlap across splits")
+    if dup_within:
+        issues.append(f"{dup_within} duplicate ids within the concatenated 3600 list")
+    if hash_mismatches:
+        issues.append(f"{len(hash_mismatches)} file/pixel hash mismatches")
+    if missing_gt or missing_infer:
+        issues.append(f"missing_gt={len(missing_gt)} missing_infer={len(missing_infer)}")
+    if cross_split_dup:
+        issues.append(f"{len(cross_split_dup)} cross-split decoded-pixel duplicate groups")
+    if dup_pixel_groups and not cross_split_dup:
+        issues.append(f"{len(dup_pixel_groups)} within-split decoded-pixel duplicate groups (not cross-split)")
+
+    mans = {}
+    for nm, p in (("train2400_full", f"{BASE}/results/iter_033/data/train2400_full.json"), ("V100", f"{BASE}/results/iter_033/data/V100.json"),
+                  ("D32", f"{BASE}/results/iter_033/data/D32.json"), ("L64", f"{BASE}/results/iter_033/data/L64.json"),
+                  ("V400", f"{BASE}/results/iter_034/data/V400.json"), ("D24", f"{BASE}/results/iter_035/data/D24.json")):
+        mids = json.load(open(p))["ids"]
+        mans[nm] = {"n": len(mids), "n_unique": len(set(mids)),
+                    "subset_of": [s for s, ss in (("train", train_ids), ("validation", val_ids), ("confirm", confirm_ids)) if set(mids) <= set(ss)]}
+    issues += [f"manifest {k} not within a single split" for k, v in mans.items() if len(v["subset_of"]) != 1 or v["n"] != v["n_unique"]]
+    if set(json.load(open(f"{BASE}/results/iter_033/data/train2400_full.json"))["ids"]) != set(train_ids):
+        issues.append("train2400_full != iter_010 train ids")
+    prev = json.load(open(f"{BASE}/results/iter_034/data/data_audit_full_3600.json"))
+    result = {
+        "detector_manifests": mans,
+        "iter034_audit_same_counts": {k: prev.get(k) == v for k, v in (("n_checked", n_checked), ("duplicate_pixel_groups_total", len(dup_pixel_groups)))},
+        "n_train": len(train_ids), "n_validation": len(val_ids), "n_confirm": len(confirm_ids),
+        "n_total": len(all_ids), "n_checked": n_checked,
+        "overlaps": {k: len(v) for k, v in overlaps.items()},
+        "overlap_ids": overlaps,
+        "duplicate_ids_within_concat": dup_within,
+        "hash_mismatches": hash_mismatches,
+        "missing_gt": missing_gt, "missing_infer": missing_infer,
+        "duplicate_pixel_groups_total": len(dup_pixel_groups),
+        "cross_split_duplicate_pixel_groups": cross_split_dup,
+        "sop_linkage_note": "infer_manifest.jsonl에는 SOPInstanceUID 등 DICOM 식별자 필드가 없어 "
+                             "환자 ID(파일명 기반) 외의 SOP 수준 연결 여부는 이번 감사에서 검증하지 못했다 (미검증 범위).",
+        "issues": issues, "ok": len(issues) == 0,
+    }
+    with open(f"{OUT}/data_audit_full_3600.json", "w") as f:
+        json.dump(result, f, indent=2)
+    print(json.dumps({k: v for k, v in result.items() if k not in ("overlap_ids", "hash_mismatches", "cross_split_duplicate_pixel_groups")}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/det_compare.py b/rsna_diag/det_compare.py
new file mode 100644
index 0000000..ecd026a
--- /dev/null
+++ b/rsna_diag/det_compare.py
@@ -0,0 +1,342 @@
+"""개발비교800(iter_010 confirm) detector vs 저장 base/SFT 비교 (기본 medgemma env).
+
+원본: results/iter_034/analyze_confirm800.py (sha256 88342a8d...)와 그 원본 iter_033 analyze_confirm800.py,
+results/iter_034/verify_confirm_sft.py (sha256 c11799c8...). metric·parser·utility는 기존 승인 모듈(sft_eval·metrics·parse)을 쓴다.
+iter_035 변경:
+- 저장 SFT/base 출력: 중복을 덮어쓰지 않고 오류, 예상 (id,prompt) 집합·adapter·protocol·completion·영상 hash 대조,
+  iter_012 확인 주수치(seed별 F1@0.3) 재현.
+- detector: det_eval.load_verified로 completion·checkpoint·manifest 연결을 검사하고, 잠긴 선택 파일의 checkpoint·
+  threshold만 사용한다. 누락 record는 오류.
+- 주비교: 양성 400명 환자 평균 F1@0.3·F1@0.5의 detector17−B0 차이에 실제 97.5% paired bootstrap CI
+  (1.25/98.75 percentile, 10,000회 공통 환자 resample). 원본은 95% 함수를 97.5 label로 불렀다. 기존 metrics.paired_boot_ci는
+  수정하지 않는다.
+- FP/환자(전체 N 하한, valid-only), FP 보유율과 차이의 95% CI, lesion recall, 전체 미검출, invalid, GT 개수·union 면적·
+  개별 GT 면적(train 기준 삼분위) 층, FP budget별 detector recall.
+- 상보성: exhaustive matching(metrics.match)의 GT identity로 both/det-only/SFT-only/both-miss, 비율 CI는 resample마다
+  분자·분모 재계산. 민감도: 동점 규칙 반대(높은 pred index 우선), best-IoU cover, 다른 SFT seed·detector seed·FP budget.
+"""
+import argparse
+import glob
+import hashlib
+import json
+import os
+import sys
+
+import numpy as np
+
+BASE = "/SSD1_1TB/home/milab/daniel/08_medgemma/research"
+sys.path.insert(0, BASE)
+from rsna_diag import geometry as G, metrics as M, parse as PA, sft_eval as SE  # noqa: E402
+
+IT010 = f"{BASE}/results/iter_010/manifests"
+IT012 = f"{BASE}/results/iter_012"
+ADAPTERS = {17: "e13f3c4461b826a060c90dfe4e4ee4c2ebac36a08f84be1a45a37495816cec11",
+            29: "9185488c82b6efd6fe53df3c92ca5f4b6efb3e059d0f36eeb3c9ee9f911a99cc",
+            43: "881ca7fda81669374993893f85b26ff91a74b9762a10edbb1c428c991ad735b7"}
+PROTOCOL = "797ae7074325d714cf1c54c2d4fb1cc6904dc0f5babd18e817195d219b4d4a92"
+B = 10000
+BOOT_SEED = 20260924
+
+
+def sha(p):
+    return hashlib.sha256(open(p, "rb").read()).hexdigest()
+
+
+def load_stored(run_dir, ids, prompts, adapter, infer):
+    recs = {}
+    files = sorted(glob.glob(f"{run_dir}/gen_worker*.jsonl"))
+    for p in files:
+        for l in open(p):
+            r = json.loads(l)
+            k = (r["id"], r["prompt_name"])
+            if k in recs:
+                raise ValueError(f"duplicate stored record {k} in {run_dir}")
+            recs[k] = r
+    exp = {(i, pr) for i in ids for pr in prompts}
+    if set(recs) != exp:
+        raise ValueError(f"{run_dir}: stored set != expected (missing {len(exp - set(recs))}, extra {len(set(recs) - exp)})")
+    bad = [k for k, r in recs.items() if r["adapter_digest"] != adapter or r["protocol_digest"] != PROTOCOL
+           or r["image_file_sha256"] != infer[k[0]]["file_sha256"]]
+    if bad:
+        raise ValueError(f"{run_dir}: provenance mismatch for {len(bad)} records e.g. {bad[:2]}")
+    comp = json.load(open(f"{run_dir}/completion.json"))
+    if comp["n_actual_unique"] != len(exp) or comp["n_missing"] or comp["n_duplicate"] or comp["adapter_digest"] != adapter:
+        raise ValueError(f"{run_dir}: completion inconsistent")
+    return recs, {"files": {os.path.basename(p): sha(p) for p in files}, "n": len(recs)}
+
+
+def boot_ci(d, idx, lo, hi):
+    m = d[idx].mean(axis=1)
+    return [float(np.percentile(m, lo)), float(np.percentile(m, hi))]
+
+
+def ratio_ci(num, den, idx):
+    rs = num[idx].sum(axis=1) / den[idx].sum(axis=1)
+    return [float(np.percentile(rs, 2.5)), float(np.percentile(rs, 97.5))]
+
+
+def boxes_valid(pred):
+    return pred["boxes"] if pred["status"] in PA.VALID else []
+
+
+def match_rev(pred, gt, thr):
+    """동점 민감도: pred 순서를 뒤집어 metrics.match를 적용(높은 index 우선) 후 원래 index로 환원."""
+    n = len(pred)
+    pairs = M.match(list(reversed(pred)), gt, thr)
+    return [(gi, n - 1 - pi) for gi, pi in pairs]
+
+
+def gt_hits(pred, g, thr, mode):
+    if not pred or not g:
+        return set()
+    if mode == "exact":
+        return {gi for gi, _ in M.match(pred, g, thr)}
+    if mode == "rev":
+        return {gi for gi, _ in match_rev(pred, g, thr)}
+    if mode == "cover":
+        return {gi for gi, gb in enumerate(g) if any(M.iou(p, gb) >= thr for p in pred)}
+    raise ValueError(mode)
+
+
+def complementarity(det, sft, gt, pos, thr, idx, mode="exact"):
+    rows = []
+    for i in pos:
+        g = [b["yxyx_norm"] for b in gt[i]["boxes"]]
+        dh, sh = gt_hits(boxes_valid(det[i]), g, thr, mode), gt_hits(boxes_valid(sft[i]), g, thr, mode)
+        n = len(g)
+        rows.append([len(dh & sh), len(dh - sh), len(sh - dh), n - len(dh | sh), n])
+    a = np.array(rows, float)
+    tot = a[:, 4].sum()
+    out = {"total_gt": int(tot), "both_hit": int(a[:, 0].sum()), "detector_only": int(a[:, 1].sum()),
+           "sft_only": int(a[:, 2].sum()), "both_miss": int(a[:, 3].sum()),
+           "n_patients_with_det_only": int((a[:, 1] > 0).sum()), "n_patients_with_sft_only": int((a[:, 2] > 0).sum())}
+    for k, c in (("detector_only", 1), ("sft_only", 2), ("both_miss", 3), ("both_hit", 0)):
+        out[f"{k}_rate"] = float(a[:, c].sum() / tot)
+        out[f"{k}_rate_ci95"] = ratio_ci(a[:, c], a[:, 4], idx)
+    out["gt_union_recall"] = float((a[:, 0] + a[:, 1] + a[:, 2]).sum() / tot)
+    return out, a
+
+
+def fp_stats(preds, gt, ids, thr=0.3):
+    allv, validv = [], []
+    for i in ids:
