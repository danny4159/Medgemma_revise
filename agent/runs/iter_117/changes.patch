new file mode 100644
index 0000000..f45ce48
--- /dev/null
+++ b/ed117_analyze.py
@@ -0,0 +1,136 @@
+"""iter_117 본 분석 (iter_116 평가 산술 그대로 재사용): 검증된 MAIN completion → 환자별 표, 그룹별 report, 사전 투자 분기. 결과는 새 경로에만 쓴다 ('x' 모드).
+사용: python ed116_analyze.py --gen results/iter_116/gen/MAIN --requests ... --protocol ... --out results/iter_116/eval
+"""
+import argparse
+import json
+import os
+import sys
+
+import ed116_eval as EV
+import ed116_spec as ES
+import ev109_extract as X
+import pg43_run as RUN
+
+PROV = "results/iter_116/provenance"
+LOCKDIR = "results/iter_116/lock"
+EVALLOCK = "results/iter_117/lock/eval_lock.json"
+
+
+def observations(patients, per_patient, byid):
+    """본생성 전 고정한 네 집단과 대조 교차표. 임상 의미 재판정은 하지 않는다."""
+    out = dict(strata={}, paired={}, category_transitions={}, auxiliary_T=True,
+               note="반복 개발 RSNA의 사전 선택 집단. 표의 차이를 인과 효과·신규성으로 해석하지 않는다.")
+    for g, pats in patients.items():
+        for kc in (True, False):
+            sub = [p for p in pats if (p['base']['K'] == p['y']) == kc]
+            counts = {q: dict(correct=sum(p['base'][q] == p['y'] for p in sub),
+                              wrong=sum(p['base'][q] is not None and p['base'][q] != p['y'] for p in sub),
+                              unresolved=sum(p['base'][q] is None for p in sub)) for q in EV.POL}
+            out['strata'][g + ('_Kcorrect' if kc else '_Kwrong')] = dict(group=g, K_correct=kc, n=len(sub),
+                                                                                    ids=[p['id'] for p in sub], policies=counts)
+        def state(p, q):
+            return 'unresolved' if p['base'][q] is None else 'correct' if p['base'][q] == p['y'] else 'wrong'
+        out['paired'][g] = {}
+        for q in ('N', 'E'):
+            cells = {f'{r}/{c}': [p['id'] for p in pats if state(p, 'R') == r and state(p, q) == c]
+                     for r in ('correct', 'wrong', 'unresolved') for c in ('correct', 'wrong', 'unresolved')}
+            out['paired'][g]['R_vs_' + q] = {k: dict(n=len(ids), ids=ids) for k, ids in cells.items()}
+        out['category_transitions'][g] = {}
+        for cat in ('opacity', 'normal', 'not_normal_no_opacity'):
+            sub = [p for p in pats if p['cat'] == cat]
+            out['category_transitions'][g][cat] = dict(n=len(sub), policies={
+                q: dict(to_yes=sum(p['base']['K'] == 'no' and p['base'][q] == 'yes' for p in sub),
+                        to_no=sum(p['base']['K'] == 'yes' and p['base'][q] == 'no' for p in sub),
+                        unresolved=sum(p['base'][q] is None for p in sub)) for q in EV.POL})
+    gt = json.load(open(f"{PROV}/gt.json"))
+    for r in per_patient:
+        source = byid[r['id']]
+        r['K_correct'] = r['correct']['K']
+        r['B_correct'] = r['correct']['B']
+        r['correction'] = {q: bool(not r['K_correct'] and r['correct'][q]) for q in EV.POL}
+        r['resolved_harm'] = {q: bool(r['K_correct'] and r['answers'][q] is not None and not r['correct'][q]) for q in EV.POL}
+        r['wrong_advice_adopted_R'] = bool(r['group'] == 'mismatch' and r['K_correct'] and r['answers']['R'] == r['answers']['B'])
+        r['useful_advice_not_adopted_R'] = bool(r['group'] == 'mismatch' and not r['K_correct'] and r['answers']['R'] == r['answers']['K'])
+        r['image'] = source['image']
+        r['image_sha256'] = source['file_sha256']
+        r['draft_source_request_id'] = source['O']['request_id']
+        r['detector_packet'] = ES.packet_text(source)
+        r['detector_boxes_xyxy_px'] = [b for s, b in ES.det_boxes(source)]
+        r['gt_boxes_yxyx_norm'] = gt[r['id']]['gt_yxyx_norm']
+    return out
+
+
+def load_inputs():
+    rows = json.load(open(f"{PROV}/ledger_nogt.json"))["rows"]
+    gt = json.load(open(f"{PROV}/gt.json"))
+    sel = json.load(open(f"{LOCKDIR}/selection.json"))
+    return {r["id"]: r for r in rows}, gt, sel
+
+
+def model_answers(recs):
+    """records → {patient: {cond: (answer|None, resolve dict, record)}}"""
+    out = {}
+    for r in recs:
+        res = X.resolve("O", r["suffix_text_raw"], r["ended_eos"])
+        out.setdefault(r["patient"], {})[r["cond"]] = (res["answer"], res, r)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--gen", required=True)
+    ap.add_argument("--requests", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    lock = json.load(open(EVALLOCK))
+    bad = [f for f, h in lock["files"].items() if RUN.file_sha(f) != h]
+    if bad:
+        sys.exit(f"평가 잠금 파일이 변경됨: {bad}")
+    recs = RUN.verify_completion(a.gen, a.requests, a.protocol)  # 요청 집합·record digest·영상 hash·보호 필드 재검증
+    byid, gt, sel = load_inputs()
+    ma = model_answers(recs)
+    groups = {"mismatch": sel["mismatch"], "control": sel["control"]}
+    for g, ids in groups.items():
+        for i in ids:
+            if set(ma.get(i, {})) != set(ES.COND_ORDER):
+                sys.exit(f"조건 누락: {g} {i}")
+    if set(ma) != set(sel["mismatch"]) | set(sel["control"]):
+        sys.exit("분석 대상 외 환자 record가 있다")
+    patients, per_patient = {}, []
+    for g, ids in groups.items():
+        patients[g] = []
+        for i in ids:
+            p = EV.make_patient(byid[i], gt[i], {c: ma[i][c][0] for c in ES.COND_ORDER})
+            patients[g].append(p)
+            pt = EV.point_scalars(p)
+            per_patient.append(dict(id=i, group=g, category=p["cat"], gt=p["y"], answers=p["base"],
+                                    correct={q: p["base"][q] == p["y"] for q in EV.POL},
+                                    resolve={c: dict(source=ma[i][c][1]["source"], reason=ma[i][c][1]["reason"], rule=ma[i][c][1]["rule"]) for c in ES.COND_ORDER},
+                                    raw={c: ma[i][c][2]["suffix_text_raw"] for c in ES.COND_ORDER},
+                                    ended_eos={c: ma[i][c][2]["ended_eos"] for c in ES.COND_ORDER},
+                                    joint03={q: pt[f"joint03_{q}"] for q in EV.JOINT_POL}, n_det=p["n_det"], n_gt=p["n_gt"],
+                                    tp03=p["tp03"], request_ids={c: ma[i][c][2]["request_id"] for c in ES.COND_ORDER}))
+    rep_mm = EV.group_report(patients["mismatch"])
+    rep_ag = EV.group_report(patients["control"])
+    dec = EV.decide(rep_mm, rep_ag)
+    fmt = {}
+    for g, ids in groups.items():
+        fmt[g] = EV.format_report({c: [ma[i][c][2] for i in ids] for c in ES.COND_ORDER})
+    comp = json.load(open(os.path.join(a.gen, "completion.json")))
+    obs = observations(patients, per_patient, byid)
+    unresolved = [dict(id=i, raw=byid[i]["O"]["raw"], request_id=byid[i]["O"]["request_id"]) for i in sel["unresolved"]]
+    report = dict(spec_version=ES.SPEC_VERSION, eval_lock_sha256=RUN.file_sha(EVALLOCK), protocol_sha256=RUN.file_sha(a.protocol),
+                  requests_sha256=RUN.file_sha(a.requests), n_records=len(recs), mismatch=rep_mm, control=rep_ag, decision=dec, format=fmt,
+                  cost=comp["cost"], cost_this_attempt=comp.get("cost_this_attempt"), wall_s=comp["wall_s"], workers=comp["workers"],
+                  mapping=comp["mapping"], unresolved_excluded_E600_K=unresolved,
+                  note="불일치 87명은 K/B 중 하나가 맞는 구조로 선정한 집단이다. 자연 모집단 오류율·실용 이득으로 외삽하지 않는다.")
+    os.makedirs(a.out, exist_ok=True)
+    for name, obj in (("report.json", report), ("per_patient.json", per_patient), ("observations.json", obs)):
+        with open(os.path.join(a.out, name), "x") as f:
+            json.dump(obj, f, indent=1, sort_keys=True)
+    print(json.dumps(dict(label=dec["label"], point=dec["point"], worst=dec["worst"]), indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ed117_processor.py b/ed117_processor.py
new file mode 100644
index 0000000..3a42306
--- /dev/null
+++ b/ed117_processor.py
@@ -0,0 +1,61 @@
+"""기존 직접 대조와 같은 TECH 4입력의 processor tensor 비교. 모델 생성 없음."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+os.environ.setdefault('HF_HUB_OFFLINE', '1')
+os.environ.setdefault('HF_HUB_DISABLE_TELEMETRY', '1')
+import torch
+import transformers
+from rsna_diag import generate as G
+from ed116_directcheck import indep_pad
+
+
+def main():
+    from pg43_run import read_requests, read_records
+    rows = read_requests('results/iter_116/requests/TECH.jsonl')
+    byk = {(r['patient'], r['cond']): r for r in rows}
+    pats = sorted({r['patient'] for r in rows})
+    pick = [byk[pats[0], 'R'], byk[pats[1], 'N'], byk[pats[0], 'T'], byk[pats[2], 'T']]
+    records = {r['request_id']: r for fn in Path('results/iter_116/gen/TECH_w2').glob('gen_worker*.jsonl') for r in read_records(fn)}
+    proc = transformers.AutoProcessor.from_pretrained(G.MODEL_ID, revision=G.MODEL_REVISION, local_files_only=True)
+    config = transformers.AutoConfig.from_pretrained(G.MODEL_ID, revision=G.MODEL_REVISION, local_files_only=True)
+    result = []
+    for row in pick:
+        if row['modality'] == 'image':
+            image, affine, px = G.load_image(row['image'])
+            worker = G.build_inputs(proc, image, row['prompt'])
+            independent_image, independent_sha = indep_pad(row['image'])
+            content = [{'type': 'image', 'image': independent_image}, {'type': 'text', 'text': row['prompt']}]
+            assert px == independent_sha == row['input_pixel_sha256']
+        else:
+            worker = G.build_inputs_text(proc, row['prompt'])
+            content = [{'type': 'text', 'text': row['prompt']}]
+        official = proc.apply_chat_template([{'role': 'user', 'content': content}], add_generation_prompt=True,
+                                           tokenize=True, return_dict=True, return_tensors='pt')
+        checks = {}
+        for k in set(worker) | set(official):
+            checks[k] = k in worker and k in official and worker[k].shape == official[k].shape and worker[k].dtype == official[k].dtype and torch.equal(worker[k], official[k])
+        ids = worker['input_ids'][0].tolist()
+        rec = records[row['request_id']]
+        image_count = ids.count(config.image_token_index)
+        checks['input_ids_equal_old_record'] = hashlib.sha256(json.dumps(ids).encode()).hexdigest() == rec['input_ids_sha256']
+        checks['text_no_image_or_image_present'] = (image_count > 0 and 'pixel_values' in worker) if row['modality'] == 'image' else (
+            image_count == 0 and not any(k.startswith('pixel') or 'image' in k for k in worker))
+        checks['bf16_pixel_values_equal'] = row['modality'] != 'image' or torch.equal(worker['pixel_values'].to(torch.bfloat16), official['pixel_values'].to(torch.bfloat16))
+        result.append(dict(request_id=row['request_id'], cond=row['cond'], checks=checks,
+                           tensors={k: dict(shape=list(v.shape), dtype=str(v.dtype), sha256=hashlib.sha256(v.contiguous().numpy().tobytes()).hexdigest()) for k, v in worker.items()}))
+    out = dict(all_pass=all(all(r['checks'].values()) for r in result), n=len(result), results=result,
+               model_loaded=False, new_generate_requests=0, torch=torch.__version__, transformers=transformers.__version__,
+               note='공식 processor CPU tensor 및 bf16 pixel cast 대조. 기존 padding hash 검사와 구분.')
+    path = Path('results/iter_117/tests/processor.json')
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open('x') as f:
+        json.dump(out, f, indent=1)
+    print('processor all_pass', out['all_pass'])
+    raise SystemExit(0 if out['all_pass'] else 1)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ed117_run.py b/ed117_run.py
new file mode 100644
index 0000000..554e9eb
--- /dev/null
+++ b/ed117_run.py
@@ -0,0 +1,264 @@
+"""iter_117 한정 복구: 원 자산 확인 → 새 평가 잠금 → MAIN 감독 → 검증 봉인.
+
+생성 pg43_run과 모든 기존 산출물을 변경하지 않는다. 원 평가·관찰 규약을
+본생성 이전에 잠그고 실제 실행 경로에서 확인한다.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+import ed116_build as BUILD
+import ed116_link as LINK
+import ed116_spec as SPEC
+import ed116_eval as EV
+import pg43_run as RUN
+from ed117_verify import sha
+
+ROOT = Path('results/iter_117')
+SOURCE_SHA = '66cd4542720d0efe69b2fbbdfabbe24ebe0253a0'
+PLAN116 = '../agent/runs/iter_116/plan.md'
+PLANHASH = 'be752099da4cd90c2b14fe16ac4659b054de1cb114111364c8dcf8b93a46d009'
+REQ = 'results/iter_116/requests/MAIN.jsonl'
+PROTO = str(ROOT / 'protocol/MAIN.json')
+GEN = str(ROOT / 'gen/MAIN')
+CODE = list(dict.fromkeys(BUILD.EVAL_CODE + ['ed116_verify.py', 'ed116_directcheck.py', 'ed116_baselines.py',
+    'ed116_verify_selection.py', 'ed117_run.py', 'ed117_verify.py', 'ed117_analyze.py', 'ed117_processor.py', 'test_ed117.py']))
+
+
+def read(p):
+    return json.loads(Path(p).read_text())
+
+
+def write(p, obj):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with p.open('x') as f:
+        json.dump(obj, f, indent=1, ensure_ascii=False)
+
+
+def event(name, **kw):
+    ROOT.mkdir(exist_ok=True)
+    with (ROOT / 'events.jsonl').open('a') as f:
+        f.write(json.dumps(dict(event=name, epoch=time.time(), **kw)) + '\n')
+
+
+def technical_gate(recs, ids):
+    # 원 문턱과 원 완전성 검사를 유지. T의 응답 성공만 보조 조건으로 분리한다.
+    old = EV.tech_gate(recs, ids)
+    required = {c: old['per_condition'][c]['passes'] for c in 'NER'}
+    complete = len(ids) == 12 and len(recs) == 48 and len({(r['patient'], r['cond']) for r in recs}) == 48
+    complete = complete and all(old['per_condition'][c]['n_missing'] == 0 and old['per_condition'][c]['n_records'] == 12 for c in 'NERT')
+    return dict(run=bool(complete and all(required.values())), per_condition=old['per_condition'],
+                min_resolved_required=6, required_response_conditions=list('NER'), all_four_inputs_complete=complete,
+                auxiliary_T=True, original_gate_run=old['run'])
+
+
+def prepare():
+    t0 = time.monotonic()
+    assert sha(PLAN116) == PLANHASH
+    original = read('results/iter_116/RESULT_MANIFEST.json')
+    inputs = {}
+    def check(p, expected=None):
+        current = sha(p)
+        if expected is not None and current != expected:
+            raise RuntimeError(f'출처 hash 변경: {p}')
+        inputs[str(p)] = current
+    for p, h in read('results/iter_116/lock/eval_lock.json')['files'].items():
+        check(p, h)
+    for p, h in original['outputs'].items():
+        check(p, h)
+    prov = read('results/iter_116/provenance/provenance.json')
+    paths = dict(sets=LINK.SETS, labels=LINK.LABELS, infer=LINK.INFER, det_lock=LINK.DET_LOCK,
+                 det_sel=LINK.DET_SEL, sft_reuse=LINK.SFT_REUSE, det_raw=LINK.DET_DIR + '/raw_preds.json',
+                 det_completion=LINK.DET_DIR + '/completion.json')
+    for k, p in paths.items():
+        check(p, prov['inputs'][k])
+    for stage, d in prov['O'].items():
+        check(LINK.O_PROTO[stage], d['protocol']['protocol_sha256'])
+        check(LINK.O_REQ[stage], d['requests_sha256'])
+        for fn, h in d['worker_files'].items():
+            check(LINK.O_STAGES[stage] + '/' + fn, h)
+    check(LINK.SFT_PROTO, prov['SFT']['protocol']['protocol_sha256'])
+    for fn, h in prov['SFT']['worker_files'].items():
+        check(LINK.SFT_DIR + '/' + fn, h)
+    # 기존 검증된 protocol의 입력은 불변 hash 근거를 연결한다. 전수 임상/코드 감사를 반복하지 않는다.
+    for p in [LINK.SFT_PROTO, *LINK.O_PROTO.values()]:
+        locked = read(p)['locked']
+        for f, h in locked['files'].items():
+            if not f.endswith('.py'):
+                check(f, h)
+    sel = read('results/iter_116/lock/selection.json')
+    rows = read('results/iter_116/provenance/ledger_nogt.json')['rows']
+    assert SPEC.select(rows) == {k: sel[k] for k in SPEC.select(rows)}
+    req = RUN.read_requests(REQ)
+    group_of = {**{i: 'mismatch' for i in sel['mismatch']}, **{i: 'control' for i in sel['control']}}
+    expected = BUILD.make_rows(rows, sel['mismatch'] + sel['control'], 'MAIN', group_of)
+    assert req == expected and len(req) == 696
+    assert len({r['patient'] for r in req}) == 174
+    source_code = {}
+    for f in list(dict.fromkeys(BUILD.EVAL_CODE + ['ed116_directcheck.py', 'ed116_verify_selection.py', 'ed116_baselines.py'])):
+        blob = subprocess.run(['git', 'show', SOURCE_SHA + ':' + f], capture_output=True, check=True).stdout
+        assert blob == Path(f).read_bytes(), f
+        source_code[f] = sha(f)
+    # 실제 가중치 내용 대조. 원 캐시에 쓰지 않는다.
+    weights = read('results/iter_116/lock/weights_check.json')
+    for name, d in weights['files'].items():
+        path = Path(weights['snapshot']) / name
+        assert path.stat().st_size == d['size'] and sha(path) == d['sha256'], name
+    techs = {}
+    for stage, reqname in [('TECH_w2', 'TECH'), ('TECH_w4', 'TECH'), ('RESUME8', 'RESUME8')]:
+        techs[stage] = RUN.verify_completion('results/iter_116/gen/' + stage,
+            'results/iter_116/requests/' + reqname + '.jsonl', 'results/iter_116/protocol/protocol_' + reqname + '.json')
+    a = {r['request_id']: r['suffix_ids'] for r in techs['TECH_w2']}
+    b = {r['request_id']: r['suffix_ids'] for r in techs['TECH_w4']}
+    assert a == b and len(a) == 48
+    for r in techs['RESUME8']:
+        assert r['suffix_ids'] == a[r['request_id']]
+    gate = technical_gate(techs['TECH_w2'], sel['tech'])
+    assert gate['run']
+    assert {c: gate['per_condition'][c]['n_resolved'] for c in 'NERT'} == dict(N=12, E=9, R=9, T=5)
+    write(ROOT / 'tech/gate.json', gate)
+    write(ROOT / 'reuse_manifest.json', dict(original_source_sha=SOURCE_SHA, original_plan_sha256=PLANHASH,
+        original_plan=PLAN116, current_plan_sha256=sha('../agent/runs/iter_117/plan.md'), inputs=inputs, source_code=source_code,
+        source_generation_protocol='results/iter_116/protocol/protocol_TECH.json',
+        source_tech_counts={k: len(v) for k, v in techs.items()}, generation_sources_unchanged=True,
+        required_checks='원 출력 hash·현재 입력·원 요청 재구성·TECH 완료/동등성·전체 가중치 hash 통과',
+        elapsed_s=time.monotonic() - t0, new_generate_requests=0))
+    event('prepare_complete', wall_s=time.monotonic() - t0)
+    print('재사용 입력과 TECH 확인 완료. 본요청 696, gate=True')
+
+
+def verify_lock():
+    lock = read(ROOT / 'lock/eval_lock.json')
+    for p, h in lock['files'].items():
+        if sha(p) != h:
+            raise RuntimeError(f'평가 잠금 불일치 {p}')
+    for p, h in read(ROOT / 'reuse_manifest.json')['inputs'].items():
+        if sha(p) != h:
+            raise RuntimeError(f'현재 원본 불일치 {p}')
+    return lock
+
+
+def lock():
+    tests = ['tests/fixtures_inherited.json', 'tests/fixtures_amendment.json', 'tests/processor.json']
+    for p in tests:
+        d = read(ROOT / p)
+        assert d.get('all_pass', d.get('n_pass') == d.get('n')) is True, p
+    assert read(ROOT / 'tech/gate.json')['run'] is True
+    inputs = read(ROOT / 'reuse_manifest.json')['inputs']
+    paths = list(dict.fromkeys(CODE + list(inputs) + [str(ROOT / x) for x in tests] +
+        [str(ROOT / 'reuse_manifest.json'), str(ROOT / 'tech/gate.json'), PLAN116,
+         '../agent/runs/iter_117/plan.md', '../agent/runs/iter_117/plan.json']))
+    t = time.time()
+    d = dict(locked_at_epoch=t, locked_at_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(t)),
