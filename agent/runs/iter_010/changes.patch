index 0000000..cbfbbbf
--- /dev/null
+++ b/rsna_diag/queue_lock.py
@@ -0,0 +1,72 @@
+"""실행 lock과 원자적 작업 claim (iter_010). flock 기반: 소유 프로세스가 종료되어야만 커널이 lock을 놓는다.
+
+- try_lock은 원자적이다 (경쟁하는 여러 프로세스 중 하나만 성공). 살아 있는 소유자의 lock은 절대 빼앗지 않는다.
+- 소유자가 죽으면 커널이 lock을 해제하므로, 다음 acquire가 '종료가 확인된 소유자의 claim 회수'가 된다.
+  파일에 남은 이전 소유자 정보(pid/host/시작시각)는 prev로 반환해 로그에 남긴다 (파일은 삭제하지 않는다).
+- 같은 host의 로컬 파일시스템을 가정한다 (NFS 등 flock 의미가 다른 곳에서는 쓰지 않는다).
+"""
+import fcntl
+import json
+import os
+import socket
+import time
+
+
+def proc_start(pid):
+    """/proc/<pid>/stat의 starttime (clock ticks). 없으면 None."""
+    try:
+        with open(f"/proc/{pid}/stat") as f:
+            s = f.read()
+        return int(s[s.rindex(")") + 2:].split()[19])
+    except (FileNotFoundError, ProcessLookupError, ValueError, IndexError):
+        return None
+
+
+def my_info(**extra):
+    pid = os.getpid()
+    return {"pid": pid, "start": proc_start(pid), "host": socket.gethostname(), "ts": time.time(), **extra}
+
+
+def _read(fd):
+    os.lseek(fd, 0, os.SEEK_SET)
+    txt = os.read(fd, 65536).decode(errors="replace")
+    try:
+        return json.loads(txt) if txt.strip() else None
+    except ValueError:
+        return None
+
+
+class Lock:
+    def __init__(self, path, fd, info):
+        self.path, self.fd, self.info = path, fd, info
+
+    def release(self):
+        if self.fd is not None:
+            os.ftruncate(self.fd, 0)
+            os.lseek(self.fd, 0, os.SEEK_SET)
+            os.write(self.fd, json.dumps({"released": True, "by": self.info}).encode())
+            fcntl.flock(self.fd, fcntl.LOCK_UN)
+            os.close(self.fd)
+            self.fd = None
+
+
+def try_lock(path, info):
+    """returns (Lock 또는 None, prev, reclaimed).
+
+    None이면 다른 살아 있는 프로세스가 보유 중이다 (prev=현재 파일의 소유자 정보, 읽을 수 있으면).
+    reclaimed=True: 이전 소유자가 release 없이 종료(kill 등)한 lock을 이어받았다 (prev=그 소유자 정보).
+    """
+    fd = os.open(path, os.O_CREAT | os.O_RDWR)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError:
+        prev = _read(fd)
+        os.close(fd)
+        return None, prev, False
+    prev = _read(fd)
+    reclaimed = isinstance(prev, dict) and not prev.get("released") and "pid" in prev
+    os.ftruncate(fd, 0)
+    os.lseek(fd, 0, os.SEEK_SET)
+    os.write(fd, json.dumps(info).encode())
+    os.fsync(fd)
+    return Lock(path, fd, info), prev, reclaimed
diff --git a/rsna_diag/rsna_data.py b/rsna_diag/rsna_data.py
new file mode 100644
index 0000000..155e33e
--- /dev/null
+++ b/rsna_diag/rsna_data.py
@@ -0,0 +1,228 @@
+"""RSNA 2018 adjudicated 자료 adapter: annotation/mapping 연결, 감사, 결정적 환자 split (iter_009).
+
+- 최종 라벨은 labelGroup 'Calculated'(adjudication 결과)의 Normal / No Lung Opacity / Not Normal / Lung Opacity(local bbox)만 쓴다.
+  Team 1/2/2a/QA/Adjudication 그룹의 개별 판독 라벨은 사용하지 않는다. 라벨 누락은 음성이 아니다.
+- bbox: data.{x,y,width,height} pixel (annotation height/width=1024 canvas) -> xyxy.
+- patient: mapping img_id `NNNNNNNN_SSS.png`의 8자리 접두어(NIH Patient ID). RSNA의 PatientID(DICOM)는 검사별 무작위라 쓰지 않는다.
+"""
+import collections
+import hashlib
+import json
+import re
+import zipfile
+
+from . import dicom_min, geometry
+
+SEED = 20260925
+CAT_POS, CAT_NORMAL, CAT_NLONN = "opacity", "normal", "not_normal_no_opacity"
+PRIORITY = [CAT_POS, CAT_NORMAL, CAT_NLONN]
+LABEL_TO_CAT = {"Lung Opacity": CAT_POS, "Normal": CAT_NORMAL, "No Lung Opacity / Not Normal": CAT_NLONN}
+# iter_010 분할 목표 (train / validation / 독립 확인)
+SPLIT_TARGETS = {"train": {CAT_POS: 1200, CAT_NORMAL: 600, CAT_NLONN: 600},
+                 "validation": {CAT_POS: 200, CAT_NORMAL: 100, CAT_NLONN: 100},
+                 "confirm": {CAT_POS: 400, CAT_NORMAL: 200, CAT_NLONN: 200}}
+IMG_RE = re.compile(r"(\d{8})_(\d{3})\.png")
+
+
+def h(seed, key):
+    return hashlib.sha1(f"{seed}:{key}".encode()).hexdigest()
+
+
+def load_annotations(path):
+    a = json.load(open(path))
+    label = {}
+    for g in a["labelGroups"]:
+        for l in g["labels"]:
+            label[l["id"]] = {"group": g["name"], "name": l["name"].strip(), "type": l["type"],
+                              "mode": l["annotationMode"]}
+    ann = a["datasets"][0]["annotations"]
+    by = collections.defaultdict(lambda: {"cats": set(), "boxes": [], "exclude": False, "study": None, "series": None,
+                                          "n_ann": 0})
+    for x in ann:
+        if "SOPInstanceUID" not in x:
+            continue
+        info = label[x["labelId"]]
+        r = by[x["SOPInstanceUID"]]
+        r["n_ann"] += 1
+        r["study"], r["series"] = x["StudyInstanceUID"], x["SeriesInstanceUID"]
+        if info["name"] == "Exclude":
+            r["exclude"] = True
+        if info["group"] != "Calculated":
+            continue
+        if info["name"] in LABEL_TO_CAT:
+            r["cats"].add(LABEL_TO_CAT[info["name"]])
+        if info["type"] == "local":
+            d = x["data"]
+            r["boxes"].append({"ann_id": x["id"], "n": x["annotationNumber"], "canvas": [x["width"], x["height"]],
+                               "xywh": [d["x"], d["y"], d["width"], d["height"]]})
+    return label, dict(by)
+
+
+def load_mapping(path):
+    m = json.load(open(path))
+    sop_map, dups = {}, []
+    for e in m:
+        s = e["SOPInstanceUID"]
+        if s in sop_map:
+            dups.append(s)
+        sop_map[s] = e
+    return sop_map, dups
+
+
+class RsnaZip:
+    """전체 ZIP의 full member path <-> SOP UID. basename 충돌을 검출한다."""
+
+    def __init__(self, path):
+        self.path = path
+        self.z = zipfile.ZipFile(path)
+        self.members = {}
+        self.collisions = []
+        for n in self.z.namelist():
+            if not n.endswith(".dcm"):
+                continue
+            sop = n.rsplit("/", 1)[-1][:-4]
+            if sop in self.members:
+                self.collisions.append((sop, self.members[sop], n))
+            self.members[sop] = n
+
+    def read(self, sop):
+        return self.z.read(self.members[sop])
+
+    def info(self, sop):
+        i = self.z.getinfo(self.members[sop])
+        return {"member": i.filename, "crc32": f"{i.CRC:08x}", "file_size": i.file_size}
+
+
+def box_checks(rec):
+    """local bbox 범위/면적 검사. returns list of problems."""
+    prob = []
+    for b in rec["boxes"]:
+        cw, ch = b["canvas"]
+        x, y, w, hh = b["xywh"]
+        if (cw, ch) != (1024, 1024):
+            prob.append(f"canvas {cw}x{ch}")
+        if not (w > 0 and hh > 0):
+            prob.append("nonpositive area")
+        if x < 0 or y < 0 or x + w > cw + 1e-3 or y + hh > ch + 1e-3:
+            prob.append("out of canvas")
+    return prob
+
+
+class AuditError(RuntimeError):
+    pass
+
+
+def audit_all(label, ann, sop_map, dups, rz):
+    """30000 영상 전체 연결/태그 감사. returns (per-image dict sop->eligibility record, summary dict).
+
+    mapping SOP 중복 또는 ZIP basename 충돌이 있으면 연결이 모호하므로 AuditError로 중단한다 (집계만 하지 않는다).
+    """
+    if dups or rz.collisions:
+        raise AuditError(f"mapping duplicate SOP={len(dups)} zip basename collisions={len(rz.collisions)}")
+    summary = {"n_annotation_images": len(ann), "n_mapping": len(sop_map), "mapping_duplicate_sop": len(dups),
+               "zip_members": len(rz.members), "zip_basename_collisions": len(rz.collisions),
+               "excluded_reasons": collections.Counter(), "category_counts_eligible": collections.Counter(),
+               "dicom_tag_signatures": collections.Counter()}
+    recs = {}
+    for sop, r in ann.items():
+        reasons = []
+        m = sop_map.get(sop)
+        if m is None:
+            reasons.append("not_in_mapping")
+        if sop not in rz.members:
+            reasons.append("not_in_zip")
+        if r["exclude"]:
+            reasons.append("exclude_label")
+        if len(r["cats"]) != 1:
+            reasons.append(f"calculated_cats={sorted(r['cats'])}")
+        cat = next(iter(r["cats"])) if len(r["cats"]) == 1 else None
+        if cat == CAT_POS and not r["boxes"]:
+            reasons.append("opacity_without_box")
+        if cat in (CAT_NORMAL, CAT_NLONN) and r["boxes"]:
+            reasons.append("negative_with_box")
+        reasons += box_checks(r)
+        patient = None
+        if m is not None:
+            mm = IMG_RE.fullmatch(m["img_id"])
+            if not mm:
+                reasons.append("bad_img_id")
+            else:
+                patient = mm.group(1)
+            if m["StudyInstanceUID"] != r["study"] or m["SeriesInstanceUID"] != r["series"]:
+                reasons.append("study_series_uid_mismatch")
+        if sop in rz.members:
+            tags, _ = dicom_min.parse(rz.read(sop))
+            sig = tuple(tags.get(k) for k in ("Rows", "Columns", "BitsStored", "PixelRepresentation", "PhotometricInterpretation",
+                                              "SamplesPerPixel", "RescaleSlope", "RescaleIntercept", "WindowCenter", "WindowWidth",
+                                              "NumberOfFrames", "PresentationLUTShape", "TransferSyntaxUID"))
+            summary["dicom_tag_signatures"][str(sig)] += 1
+            if tags.get("SOPInstanceUID") != sop:
+                reasons.append("dicom_sop_tag_mismatch")
+            reasons += dicom_min.display_problems(tags)
+        recs[sop] = {"sop": sop, "img_id": m["img_id"] if m else None, "patient": patient, "category": cat,
+                     "boxes": r["boxes"], "reasons": reasons, "orig_labels": m.get("orig_labels") if m else None}
+        for x in reasons:
+            summary["excluded_reasons"][x.split("=")[0]] += 1
+        if not reasons:
+            summary["category_counts_eligible"][cat] += 1
+    summary["excluded_reasons"] = dict(summary["excluded_reasons"])
+    summary["category_counts_eligible"] = dict(summary["category_counts_eligible"])
+    summary["dicom_tag_signatures"] = dict(summary["dicom_tag_signatures"])
+    return recs, summary
+
+
+def patient_choice(recs, excluded_patients, seed=SEED):
+    """eligible 영상에서 환자별 1영상을 고정 우선순위(양성->Normal->NLONN)와 seed 해시 순서로 고른다.
+
+    returns (choice: patient -> rec, bias summary).
+    """
+    per = collections.defaultdict(list)
+    for r in recs.values():
+        if r["reasons"] or r["patient"] in excluded_patients:
+            continue
+        per[r["patient"]].append(r)
+    choice, mixed = {}, 0
+    for p, rs in per.items():
+        cats = {r["category"] for r in rs}
+        if len(cats) > 1:
+            mixed += 1
+        for c in PRIORITY:
+            cand = sorted([r for r in rs if r["category"] == c], key=lambda r: h(seed, r["sop"]))
+            if cand:
+                choice[p] = cand[0]
+                break
+    bias = {"n_eligible_patients": len(per), "n_patients_multi_category": mixed,
+            "note": "다중 category 환자는 양성>Normal>NLONN 우선순위로 배정되어 Normal/NLONN 풀은 양성 영상이 없는 환자로 편향된다"}
+    return choice, bias
+
+
+def make_split(choice, seed=SEED, targets=SPLIT_TARGETS):
+    """환자 ID 해시 순으로 category 풀에서 split별로 순차 배정. 부족하면 예외 (과거 환자·중복으로 채우지 않는다).
+
+    returns (splits: name -> sorted patients, pool sizes, reserve: category -> patients 남은 적격 환자).
+    """
+    pools = {c: sorted([p for p, r in choice.items() if r["category"] == c], key=lambda p: h(seed, "pat" + p))
+             for c in PRIORITY}
+    splits = {k: [] for k in targets}
+    reserve = {}
+    for c in PRIORITY:
+        need = sum(t[c] for t in targets.values())
+        if len(pools[c]) < need:
+            raise RuntimeError(f"insufficient eligible patients for {c}: {len(pools[c])} < {need}")
+        pos = 0
+        for k, t in targets.items():
+            splits[k] += pools[c][pos:pos + t[c]]
+            pos += t[c]
+        reserve[c] = pools[c][pos:]
+    return {k: sorted(v) for k, v in splits.items()}, {c: len(v) for c, v in pools.items()}, reserve
+
+
+def gt_entry(rec):
+    """padding canvas(1024 정사각, offset 0) 기준 정규화 GT + 원본 xyxy."""
+    top, left, side = geometry.pad_offsets(1024, 1024)
+    out = []
+    for b in rec["boxes"]:
+        x, y, w, hh = b["xywh"]
+        xyxy = [x, y, x + w, y + hh]
+        out.append({"ann_id": b["ann_id"], "xyxy_px": xyxy, "yxyx_norm": geometry.canvas_to_norm(xyxy, top, left, side)})
+    return out
diff --git a/rsna_diag/run_shards.py b/rsna_diag/run_shards.py
new file mode 100644
index 0000000..b2afe9e
--- /dev/null
+++ b/rsna_diag/run_shards.py
@@ -0,0 +1,120 @@
+"""생성 worker 병렬 실행 orchestrator (iter_010). worker 수와 GPU 수를 분리한다.
+
+- 상속된 CUDA_VISIBLE_DEVICES(허용 집합) 안에서만 GPU를 배정한다: worker k -> gpus[k % len(gpus)] (같은 GPU에 여러 worker 가능).
+- 각 worker는 `python -m rsna_diag.generate`(원자적 claim 큐, worker별 출력 gen_worker{k}.jsonl). 기존 claim은 지우지 않는다
+  (죽은 소유자의 claim만 worker가 스스로 회수). 같은 out-dir에 대한 동시 orchestrator는 run.lock으로 거부한다.
+- 종료 후 예상 요청 집합 == 실제 집합(중복·누락·잉여 0)일 때만 completion.json을 쓴다.
+- 자원 로그: GPU별 memory.used/util과 프로세스별 사용량을 resource_log.jsonl에 주기적으로 append한다.
+사용: python -m rsna_diag.run_shards --manifest M --ids IDS --out-dir D --protocol P --prompts a,b --workers N [--adapter DIR]
+"""
+import argparse
+import glob
+import json
+import os
+import subprocess
+import sys
+import time
+
+from . import generate, lock_protocol, prompts as P, queue_lock
+
+
+def gpu_snapshot(idx_list):
+    q = lambda cmd: subprocess.run(cmd, capture_output=True, text=True).stdout
+    out = q(["nvidia-smi", "--query-gpu=index,uuid,memory.used,memory.total,utilization.gpu", "--format=csv,noheader,nounits"])
+    rows = []
+    for ln in out.strip().splitlines():
+        i, u, mu, mt, ut = [x.strip() for x in ln.split(",")]
+        if int(i) in idx_list:
+            rows.append({"index": int(i), "uuid": u, "mem_used_mib": int(mu), "mem_total_mib": int(mt), "util": int(ut)})
+    apps = q(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory", "--format=csv,noheader,nounits"])
+    procs = [ln.strip() for ln in apps.strip().splitlines() if ln.strip()]
+    return rows, procs
+
+
+def finalize(out_dir, items, pnames, prompts_used, adapter_digest, protocol_digest):
+    """예상 요청 집합과 실제 집합을 대조한다. returns (complete, report)."""
+    files = {f: generate.read_records(f) for f in sorted(glob.glob(os.path.join(out_dir, "gen_worker*.jsonl")))}
+    expected = {(i["id"], p) for i in items for p in pnames}
+    got, dup, extra = {}, [], []
+    for fn, recs in files.items():
+        for r in recs:
+            k = (r["id"], r["prompt_name"])
+            if k not in expected:
+                extra.append(k)
+            if k in got:
+                dup.append(k)
+            got[k] = r
+    missing = sorted(expected - set(got))
+    rep = {"n_expected": len(expected), "n_actual_unique": len(got), "n_missing": len(missing), "n_duplicate": len(dup),
+           "n_extra": len(extra), "missing_head": missing[:5], "per_file": {os.path.basename(f): len(r) for f, r in files.items()},
+           "adapter_digest": adapter_digest, "protocol_digest": protocol_digest, "prompts": pnames}
+    return (not missing and not dup and not extra), rep
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--manifest", required=True)
+    ap.add_argument("--ids", default=None)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--protocol", required=True)
+    ap.add_argument("--prompts", required=True)
+    ap.add_argument("--workers", type=int, default=2)
+    ap.add_argument("--gpus", default=None, help="허용 집합의 부분집합 (기본: CUDA_VISIBLE_DEVICES 전체)")
+    ap.add_argument("--adapter", default=None)
+    ap.add_argument("--time-limit", type=float, default=None)
+    ap.add_argument("--max-requests", type=int, default=None, help="worker별 (pilot/test용)")
+    a = ap.parse_args()
+    pdig = lock_protocol.verify(a.protocol)
+    allowed = [int(x) for x in os.environ.get("CUDA_VISIBLE_DEVICES", "0,1").split(",")]
+    gpus = [int(x) for x in a.gpus.split(",")] if a.gpus else allowed
+    if not set(gpus) <= set(allowed):
+        sys.exit(f"gpus {gpus} not within allowed {allowed}")
+    os.makedirs(a.out_dir, exist_ok=True)
+    info = queue_lock.my_info(role="run_shards")
+    rl_path = os.path.join(a.out_dir, "run.lock")
+    rlk, own, _ = queue_lock.try_lock(rl_path, info)
+    if rlk is None:
+        sys.exit(f"another run_shards owns {a.out_dir}: {own}")
+    try:
+        procs = []
+        for k in range(a.workers):
+            env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(gpus[k % len(gpus)]))
+            cmd = [sys.executable, "-m", "rsna_diag.generate", "--manifest", a.manifest, "--prompts", a.prompts,
+                   "--worker", str(k), "--out-dir", a.out_dir, "--protocol", a.protocol]
+            if a.ids:
+                cmd += ["--ids", a.ids]
+            if a.adapter:
+                cmd += ["--adapter", a.adapter]
+            if a.time_limit:
+                cmd += ["--time-limit", str(a.time_limit)]
+            if a.max_requests is not None:
+                cmd += ["--max-requests", str(a.max_requests)]
+            procs.append(subprocess.Popen(cmd, env=env, stdout=open(f"{a.out_dir}/worker{k}.stdout.log", "a"),
+                                          stderr=open(f"{a.out_dir}/worker{k}.stderr.log", "a")))
+        t0 = time.time()
+        rl = open(f"{a.out_dir}/resource_log.jsonl", "a")
+        while any(p.poll() is None for p in procs):
+            rows, apps = gpu_snapshot(set(gpus))
+            rl.write(json.dumps({"t": time.time() - t0, "gpus": rows, "compute_apps": apps}) + "\n")
+            rl.flush()
+            time.sleep(30)
+        codes = [p.returncode for p in procs]
+        items = [json.loads(ln) for ln in open(a.manifest) if ln.strip()]
+        if a.ids:
+            keep = set(json.load(open(a.ids)))
+            items = [i for i in items if i["id"] in keep]
+        pnames = a.prompts.split(",")
+        complete, rep = finalize(a.out_dir, items, pnames, {p: P.all_prompts()[p] for p in pnames}, a.adapter, pdig)
+        rep.update({"returncodes": codes, "wall_s": time.time() - t0, "allowed_gpus": allowed, "gpus_used": gpus,
+                    "n_workers": a.workers, "worker_gpu": [gpus[k % len(gpus)] for k in range(a.workers)]})
+        json.dump(rep, open(f"{a.out_dir}/last_run.json", "w"), indent=1)
+        if complete and all(c == 0 for c in codes):
+            json.dump(rep, open(f"{a.out_dir}/completion.json", "w"), indent=1)
+        print("returncodes", codes, "wall_s", round(rep["wall_s"]), "complete", complete, {k: rep[k] for k in ("n_expected", "n_actual_unique", "n_missing")})
+        sys.exit(0 if complete and all(c == 0 for c in codes) else 2)
+    finally:
+        rlk.release()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/select.py b/rsna_diag/select.py
