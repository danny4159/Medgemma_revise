--- /dev/null
+++ b/rsna_diag/baselines.py
@@ -0,0 +1,164 @@
+"""영상 비의존/고정 보정 baseline (iter_010).
+
+1. coord_correction: iter_009의 기존 개발 자료(dev80+eval300=380명)의 실제 생성 출력에서 prompt별로 800개 고정 후보 변환 중
+   양성 end-to-end F1@0.3 최대인 것을 선택한다 (동률: identity에 가까운 변환). 새 split은 선택에 쓰지 않는다.
+   변환 순서: (선택) y/x 축 교환 -> 높이·너비 배율(중심 유지) -> 중심 이동(dy,dx) -> [0,1000] canvas 교집합. 면적 0이 되면 box 소멸(기록).
+2. box 집합 prior: train 양성의 실제 GT box 집합 중 train 양성 평균 F1@0.3 최대 하나 (단일 box prior 함께). 확인 환자는 선택에 쓰지 않는다.
+사용: python -m rsna_diag.baselines --out results/iter_010/baselines
+"""
+import argparse
+import glob
+import itertools
+import json
+import multiprocessing as mp
+import os
+
+import numpy as np
+
+from . import metrics as M, parse as PA, sft_eval
+
+IT9 = "results/iter_009"
+SHIFTS = [-150, -75, 0, 75, 150]
+SCALES = [0.4, 0.6, 0.8, 1.0]
+PROMPTS = ["official_long", "concise"]
+CANDIDATES = [(sw, dy, dx, sh, sc_w) for sw in (0, 1) for dy in SHIFTS for dx in SHIFTS for sh in SCALES for sc_w in SCALES]
+assert len(CANDIDATES) == 800
+_G = {}
+
+
+def apply_box(b, spec):
+    sw, dy, dx, sh, scw = spec
+    y0, x0, y1, x1 = b
+    if sw:
+        y0, x0, y1, x1 = x0, y0, x1, y1
+    cy, cx = (y0 + y1) / 2 + dy, (x0 + x1) / 2 + dx
+    h, w = (y1 - y0) * sh, (x1 - x0) * scw
+    ny0, ny1, nx0, nx1 = max(0.0, cy - h / 2), min(1000.0, cy + h / 2), max(0.0, cx - w / 2), min(1000.0, cx + w / 2)
+    if ny1 - ny0 <= 0 or nx1 - nx0 <= 0:
+        return None
+    return [ny0, nx0, ny1, nx1]
+
+
+def apply_pred(pred, spec):
+    """valid 출력의 모든 box에 같은 변환. 실패 출력은 그대로(구제하지 않음). returns (new pred, n_vanished)."""
+    if pred["status"] not in PA.VALID:
+        return pred, 0
+    nb = [apply_box(b, spec) for b in pred["boxes"]]
+    kept = [b for b in nb if b is not None]
+    st = "valid_nonempty" if kept else "valid_empty"
+    return {"status": st, "boxes": kept}, len(nb) - len(kept)
+
+
+def identity_distance(spec):
+    sw, dy, dx, sh, scw = spec
+    return (sw, abs(dy) + abs(dx), abs(1 - sh) + abs(1 - scw), spec)
+
+
+def load_iter9_records(ids, prompts=PROMPTS):
+    """iter_009의 pilot/dev/eval 생성 record를 (id,prompt)로 모은다. 중복은 suffix가 동일할 때만 허용한다."""
+    recs = {}
+    for f in sorted(glob.glob(f"{IT9}/*/run/gen_shard*.jsonl")):
+        if f.endswith((".env.json", ".log")):
+            continue
+        for ln in open(f):
+            if not ln.strip():
+                continue
+            r = json.loads(ln)
+            if r["id"] not in ids or r["prompt_name"] not in prompts:
+                continue
+            k = (r["id"], r["prompt_name"])
+            if k in recs:
+                if recs[k]["suffix_ids"] != r["suffix_ids"] or recs[k]["input_ids_sha256"] != r["input_ids_sha256"]:
+                    raise ValueError(f"conflicting duplicate {k}")
+                continue
+            recs[k] = r
+    return recs
+
+
+def _f1_for_spec(args):
+    spec, items = args
+    tot = 0.0
+    for pred, g in items:
+        p, _ = apply_pred(pred, spec)
+        tot += M.patient_metrics(p["boxes"] if p["status"] in PA.VALID else [], g, 0.3)["f1"]
+    return tot / len(items)
+
+
+def select_correction(preds_pos, gts_pos, pool):
+    items = list(zip(preds_pos, gts_pos))
+    scores = pool.map(_f1_for_spec, [(s, items) for s in CANDIDATES], chunksize=20)
+    best = max(scores)
+    tied = [c for c, s in zip(CANDIDATES, scores) if s >= best - 1e-12]
+    chosen = min(tied, key=identity_distance)
+    ident = CANDIDATES.index((0, 0, 0, 1.0, 1.0))
+    return {"spec": list(chosen), "score": best, "identity_score": scores[ident], "n_tied": len(tied),
+            "top5": sorted(([s, list(c)] for c, s in zip(CANDIDATES, scores)), key=lambda x: -x[0])[:5]}, scores
+
+
+def _prior_score(args):
+    cand, gts = args
+    return float(np.mean([M.patient_metrics(cand, g, 0.3)["f1"] for g in gts]))
+
+
+def select_prior(gts_train_pos, pool):
+    # 실제 GT 집합 후보 (중복 제거, 등장 순서 고정)
+    seen, sets = set(), []
+    for g in gts_train_pos:
+        key = json.dumps(sorted(g))
+        if key not in seen:
+            seen.add(key)
+            sets.append(g)
+    sc = pool.map(_prior_score, [(c, gts_train_pos) for c in sets], chunksize=10)
+    k = int(np.argmax(sc))
+    boxes = [b for g in gts_train_pos for b in g]
+    sb, s2 = set(), []
+    for b in boxes:
+        t = tuple(b)
+        if t not in sb:
+            sb.add(t)
+            s2.append([b])
+    sc1 = pool.map(_prior_score, [(c, gts_train_pos) for c in s2], chunksize=10)
+    k1 = int(np.argmax(sc1))
+    return {"set": sets[k], "score": sc[k], "n_candidates": len(sets), "n_gt": len(sets[k])}, \
+           {"box": s2[k1][0], "score": sc1[k1], "n_candidates": len(s2)}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--gt", default="results/iter_010/manifests/gt_manifest.json")
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    gt9 = json.load(open(f"{IT9}/manifests/gt_manifest.json"))
+    ids9 = sorted(gt9)
+    assert len(ids9) == 380
+    recs = load_iter9_records(set(ids9))
+    miss = [(i, p) for i in ids9 for p in PROMPTS if (i, p) not in recs]
+    if miss:
+        raise RuntimeError(f"iter_009 records missing: {len(miss)} e.g. {miss[:3]}")
+    pos9 = [i for i in ids9 if gt9[i]["category"] == "opacity"]
+    gts9 = [[b["yxyx_norm"] for b in gt9[i]["boxes"]] for i in pos9]
+    pool = mp.Pool(min(16, os.cpu_count() or 4))
+    out = {"n_dev_patients": len(ids9), "n_dev_positive": len(pos9), "candidates": len(CANDIDATES),
+           "transform_order": "swap -> scale about center -> shift -> clip to [0,1000]"}
+    for p in PROMPTS:
+        parsed = sft_eval.parse_records(recs, pos9, p)
+        sel, scores = select_correction([parsed[i] for i in pos9], gts9, pool)
+        # 선택 변환의 소멸 box 수 (개발 양성)
+        van = sum(apply_pred(parsed[i], tuple(sel["spec"]))[1] for i in pos9)
+        sel["n_vanished_boxes_dev_positive"] = van
+        sel["spec_fields"] = ["swap_axes", "dy", "dx", "h_scale", "w_scale"]
+        out[p] = sel
+        print(p, sel["spec"], round(sel["score"], 4), "identity", round(sel["identity_score"], 4), flush=True)
+    gt = json.load(open(a.gt))
+    train_pos = sorted(i for i in gt if gt[i]["split"] == "train" and gt[i]["category"] == "opacity")
+    g_tr = [[b["yxyx_norm"] for b in gt[i]["boxes"]] for i in train_pos]
+    pset, pbox = select_prior(g_tr, pool)
+    out["prior_set"], out["prior_single_box"] = pset, pbox
+    out["prior_selection"] = {"split": "train", "n_positive": len(train_pos)}
+    json.dump(out, open(f"{a.out}/baselines.json", "w"), indent=1)
+    print("prior set", pset["set"], round(pset["score"], 4), "single", pbox["box"], round(pbox["score"], 4))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/build_data.py b/rsna_diag/build_data.py
new file mode 100644
index 0000000..407857f
--- /dev/null
+++ b/rsna_diag/build_data.py
@@ -0,0 +1,200 @@
+"""RSNA 감사 -> exclusion -> 결정적 train/validation/confirm split + reserve -> 영상/manifest (iter_010).
+
+iter_009 대비 변경: 신규 gate(DICOM 표시 태그, mapping/ZIP 충돌 중단), 원본 hash를 provenance와 대조, iter_009의 380명과
+과거 환자 167명 및 legacy NIH 10장 exact/near-duplicate 후보 환자를 제외, 3분할 + 미사용 reserve. GT는 추론 manifest와 분리한다.
+
+사용: python -m rsna_diag.build_data
+"""
+import glob
+import hashlib
+import json
+import os
+import re
+
+import numpy as np
+from PIL import Image
+
+from . import dicom_min, overlay, rsna_data as rd
+
+RAW = "results/iter_009/source/raw"  # 보존된 원본 (읽기 전용)
+ANN = f"{RAW}/pneumonia-challenge-annotations-adjudicated-kaggle_2018.json"
+MAP = f"{RAW}/pneumonia-challenge-dataset-mappings_2018.json"
+ZIP = f"{RAW}/pneumonia-challenge-dataset-adjudicated-kaggle_2018.zip"
+OUT = "results/iter_010"
+IT9 = "results/iter_009"
+LEGACY_NIH = "/SSD1_1TB/home/milab/daniel/08_medgemma/legacy/eval_samples/not_in_training/nih_chestxray14/*.jpg"
+NEAR_DUP_CORR = 0.97
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def sha_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for blk in iter(lambda: f.read(1 << 24), b""):
+            h.update(blk)
+    return h.hexdigest()
+
+
+def verify_sources():
+    """현재 파일의 size/sha256을 provenance.json과 대조한다. 불일치면 예외."""
+    out = {}
+    for p in (ANN, MAP, ZIP):
+        prov = json.load(open(p + ".provenance.json"))
+        cur = {"size": os.path.getsize(p), "sha256": sha_file(p)}
+        ok = cur["size"] == prov["size"] and cur["sha256"] == prov["sha256"]
+        out[os.path.basename(p)] = {"current": cur, "provenance": {k: prov[k] for k in ("size", "sha256", "url", "etag")}, "match": ok}
+        if not ok:
+            raise RuntimeError(f"source hash mismatch vs provenance: {p}")
+    return out
+
+
+def previous_patients():
+    """이전 반복에서 열어 본/사용한 NIH 환자 (results/iter_003~008 json/jsonl 내 파일명·patient_id) + iter_009의 380명."""
+    pats = {}
+    pat = re.compile(r"(\d{8})_\d{3}\.png")
+    for f in sorted(glob.glob("results/iter_00[3-8]/**/*.json*", recursive=True)):
+        try:
+            txt = open(f).read()
+        except Exception:
+            continue
+        for m in pat.finditer(txt):
+            pats.setdefault(m.group(1), set()).add(f)
+    m5 = json.load(open("results/iter_005/nih_manifest.json"))
+    for e in m5:
+        pats.setdefault(str(e["patient_id"]).zfill(8), set()).add("results/iter_005/nih_manifest.json:patient_id")
+    prev167 = set(json.load(open(f"{IT9}/manifests/exclusion_previous_nih_patients.json")))
+    found = set(pats)
+    if found != prev167:
+        raise RuntimeError(f"previous-patient set differs from iter_009 record: +{sorted(found - prev167)[:5]} -{sorted(prev167 - found)[:5]}")
+    gt9 = json.load(open(f"{IT9}/manifests/gt_manifest.json"))
+    for g in gt9.values():
+        pats.setdefault(g["patient"], set()).add(f"iter_009:{g['split']}")
+    return {p: sorted(s) for p, s in pats.items()}, gt9
+
+
+def thumb(arr):
+    im = Image.fromarray(arr if arr.ndim == 2 else np.asarray(Image.fromarray(arr).convert("L")))
+    t = np.asarray(im.resize((32, 32), Image.BOX), dtype=np.float64).ravel()
+    t = t - t.mean()
+    n = np.linalg.norm(t)
+    return t / n if n > 0 else t
+
+
+def legacy_thumbs():
+    fs = sorted(glob.glob(LEGACY_NIH))
+    assert len(fs) == 10
+    return fs, np.stack([thumb(np.asarray(Image.open(f).convert("L"))) for f in fs])
+
+
+def main():
+    os.makedirs(f"{OUT}/data_audit", exist_ok=True)
+    os.makedirs(f"{OUT}/manifests", exist_ok=True)
+    os.makedirs(f"{OUT}/data/images", exist_ok=True)
+    src = verify_sources()
+    json.dump(src, open(f"{OUT}/data_audit/source_hash_check.json", "w"), indent=1)
+    label, ann = rd.load_annotations(ANN)
+    sop_map, dups = rd.load_mapping(MAP)
+    rz = rd.RsnaZip(ZIP)
+    recs, summary = rd.audit_all(label, ann, sop_map, dups, rz)
+    excl, gt9 = previous_patients()
+    json.dump(excl, open(f"{OUT}/manifests/exclusion_previous_patients.json", "w"), indent=1)
+
+    # legacy 익명 NIH 10장 exact/near-duplicate 후보: 후보(환자별 선택) 영상 전체의 32x32 thumbnail 상관
+    lf, lt = legacy_thumbs()
+    choice, bias = rd.patient_choice(recs, set(excl))
+    tcache = f"{OUT}/data_audit/thumbs32.npz"
+    if os.path.exists(tcache):
+        z = np.load(tcache, allow_pickle=True)
+        tsop, tarr = list(z["sops"]), z["thumbs"]
+    else:
+        tsop, tl = [], []
+        for p in sorted(choice):
+            r = choice[p]
+            _, arr = dicom_min.read_pixels(rz.read(r["sop"]))
+            tsop.append(r["sop"])
+            tl.append(thumb(arr))
+        tarr = np.stack(tl)
+        np.savez_compressed(tcache, sops=np.array(tsop), thumbs=tarr)
+    corr = tarr @ lt.T  # (n_cand, 10)
+    hit = np.argwhere(corr >= NEAR_DUP_CORR)
+    legacy_hits = [{"legacy_file": os.path.basename(lf[j]), "sop": tsop[i], "corr": float(corr[i, j])} for i, j in hit]
+    sop2pat = {r["sop"]: p for p, r in choice.items()}
+    legacy_excl = sorted({sop2pat[h["sop"]] for h in legacy_hits})
+    top = [{"legacy_file": os.path.basename(lf[j]), "max_corr": float(corr[:, j].max()), "sop": tsop[int(corr[:, j].argmax())]} for j in range(10)]
+    if legacy_excl:  # 의심 환자 제외 후 재선택
+        excl2 = set(excl) | set(legacy_excl)
+        choice, bias = rd.patient_choice(recs, excl2)
+    for p in legacy_excl:
+        excl.setdefault(p, []).append("legacy_nih_near_duplicate_candidate")
+
+    splits, pool_sizes, reserve = rd.make_split(choice)
+    all_pats = [p for v in splits.values() for p in v]
+    assert len(all_pats) == len(set(all_pats))
+    summary["n_previous_patients_excluded_list"] = len(excl)
+    summary["patient_choice"] = bias
+    summary["eligible_patient_pool_sizes_after_exclusion"] = pool_sizes
+    summary["reserve_sizes"] = {c: len(v) for c, v in reserve.items()}
+    summary["legacy_nih_check"] = {"method": "32x32 BOX thumbnail, 0-mean unit-norm correlation, threshold %.2f" % NEAR_DUP_CORR,
+                                   "n_candidates_compared": len(tsop), "hits": legacy_hits, "excluded_patients": legacy_excl,
+                                   "per_legacy_image_max_corr": top,
+                                   "note": "익명 파일명이라 환자 ID 대응은 불가. 다른 표시 변환·크롭 하의 중복과 모델 사전학습 노출은 미확인."}
+    json.dump(summary, open(f"{OUT}/data_audit/audit_summary.json", "w"), indent=1)
+
+    px9 = {g["pixel_sha256"]: i for i, g in gt9.items()}
+    infer, gt, dedup = [], {}, {}
+    for split, pats in splits.items():
+        for p in pats:
+            r = choice[p]
+            meta, arr = dicom_min.read_pixels(rz.read(r["sop"]))
+            assert arr.shape == (1024, 1024) and arr.dtype == np.uint8
+            px = sha(arr.tobytes())
+            dedup.setdefault(px, []).append(r["sop"])
+            img_path = f"{OUT}/data/images/{r['sop']}.png"
+            Image.fromarray(arr, "L").save(img_path)
+            fid = f"{split[:3]}_{p}"
+            infer.append({"id": fid, "split": split, "image": img_path, "pixel_sha256": px,
+                          "file_sha256": sha(open(img_path, "rb").read())})
+            gt[fid] = {"id": fid, "split": split, "patient": p, "sop": r["sop"], "img_id": r["img_id"],
+                       "category": r["category"], "orig_labels": r["orig_labels"], "zip": rz.info(r["sop"]),
+                       "boxes": rd.gt_entry(r), "pixel_sha256": px}
+    dup_px = {k: v for k, v in dedup.items() if len(v) > 1}
+    overlap9 = sorted(set(dedup) & set(px9))
+    sops = [g["sop"] for g in gt.values()]
+    sop9 = {g["sop"] for g in gt9.values()}
+    checks = {"split_sizes": {k: len(v) for k, v in splits.items()},
+              "unique_patients": len(all_pats), "unique_sop": len(set(sops)),
+              "pairwise_patient_overlap": {f"{a}&{b}": len(set(splits[a]) & set(splits[b])) for a in splits for b in splits if a < b},
+              "patient_overlap_with_previous_or_iter009": len(set(all_pats) & set(excl)),
+              "sop_overlap_with_iter009": len(set(sops) & sop9),
+              "decoded_pixel_overlap_with_iter009": len(overlap9),
+              "duplicate_decoded_pixels_within": dup_px,
+              "category_counts": {s: {c: sum(1 for g in gt.values() if g["split"] == s and g["category"] == c) for c in rd.PRIORITY}
+                                  for s in splits},
+              "reserve_positive_n": len(reserve[rd.CAT_POS])}
+    assert not any(checks["pairwise_patient_overlap"].values()) and checks["patient_overlap_with_previous_or_iter009"] == 0
+    assert checks["unique_sop"] == len(sops) and not dup_px and not overlap9 and checks["sop_overlap_with_iter009"] == 0
+    for s, t in rd.SPLIT_TARGETS.items():
+        assert checks["category_counts"][s] == t, (s, checks["category_counts"][s])
+    json.dump(checks, open(f"{OUT}/data_audit/split_checks.json", "w"), indent=1)
+    with open(f"{OUT}/manifests/infer_manifest.jsonl", "w") as f:
+        for e in infer:
+            f.write(json.dumps(e) + "\n")
+    json.dump(gt, open(f"{OUT}/manifests/gt_manifest.json", "w"), indent=1)
+    json.dump({c: v for c, v in reserve.items()}, open(f"{OUT}/manifests/reserve_patients.json", "w"), indent=1)
+    for s, v in splits.items():
+        json.dump([f"{s[:3]}_{p}" for p in v], open(f"{OUT}/manifests/{s}_ids.json", "w"))
+    # train/validation overlay 검사용 montage (고정 순서 앞 16명 양성)
+    os.makedirs(f"{OUT}/overlays", exist_ok=True)
+    for s in ("train", "validation"):
+        ids = [i for i in sorted(gt) if gt[i]["split"] == s and gt[i]["category"] == "opacity"][:16]
+        ims = [overlay.draw(f"{OUT}/data/images/{gt[i]['sop']}.png", [b["yxyx_norm"] for b in gt[i]["boxes"]], [], 384, i) for i in ids]
+        overlay.montage(ims, 4).save(f"{OUT}/overlays/{s}_positive_gt_first16.png")
+    print(json.dumps(checks, indent=1))
+    print(json.dumps({k: v for k, v in summary.items() if k != "dicom_tag_signatures"}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/data_gate.py b/rsna_diag/data_gate.py
new file mode 100644
index 0000000..76aebe3
--- /dev/null
+++ b/rsna_diag/data_gate.py
@@ -0,0 +1,51 @@
+"""SFT target gate (iter_010): 모든 split의 GT를 학습 target으로 바꿔 정수 반올림 유효성, box 수, token 길이, 표본 pixel hash를 점검한다.
+
+실패(반올림으로 유효성이 깨지는 표본)는 조용히 고치지 않고 목록으로 기록한 뒤 종료 코드 1로 끝낸다.
+사용: python -m rsna_diag.data_gate
+"""
+import collections
+import json
+import sys
+
+import numpy as np
+
+from . import generate, prompts as P, sft_data
+
+OUT = "results/iter_010/data_audit/target_gate.json"
+
+
+def main():
+    gt = json.load(open("results/iter_010/manifests/gt_manifest.json"))
+    man = {json.loads(l)["id"]: json.loads(l) for l in open("results/iter_010/manifests/infer_manifest.jsonl") if l.strip()}
+    import os
+    os.environ.setdefault("HF_HOME", generate.HF_HOME)
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    import transformers
+    tok = transformers.AutoProcessor.from_pretrained(generate.MODEL_ID, revision=generate.MODEL_REVISION).tokenizer
+    bad, res = [], {}
+    for split in ("train", "validation", "confirm"):
+        ids = sorted(i for i in gt if gt[i]["split"] == split)
+        nb, ntok = collections.Counter(), []
+        for i in ids:
+            boxes = [b["yxyx_norm"] for b in gt[i]["boxes"]]
+            try:
+                t = sft_data.target_text(boxes)
+            except ValueError as e:
+                bad.append({"id": i, "err": str(e)})
+                continue
+            nb[len(boxes)] += 1
+            ntok.append(len(tok(t + "<end_of_turn>", add_special_tokens=False)["input_ids"]))
+        res[split] = {"n": len(ids), "n_boxes_dist": dict(sorted(nb.items())), "target_tokens_max": int(max(ntok)),
+                      "target_tokens_mean": float(np.mean(ntok)), "target_tokens_p99": float(np.percentile(ntok, 99))}
+    # 파일 hash 재검증 (manifest vs 디스크)
+    import hashlib
+    mism = [i for i in man if hashlib.sha256(open(man[i]["image"], "rb").read()).hexdigest() != man[i]["file_sha256"]]
+    res["file_sha_mismatch"] = mism
+    res["rounding_failures"] = bad
+    json.dump(res, open(OUT, "w"), indent=1)
+    print(json.dumps(res, indent=1))
+    sys.exit(1 if bad or mism else 0)
+
+
+if __name__ == "__main__":
+    main()
