index 0000000..05c1753
--- /dev/null
+++ b/rsna_diag/dicom_min.py
@@ -0,0 +1,148 @@
+"""최소 DICOM 리더 (pydicom 미설치, pip 불가). RSNA 배포본(Explicit VR LE, JPEG baseline 1.2.840.10008.1.2.4.50)만 지원.
+
+지원하지 않는 전송 구문·태그 조합은 예외를 던져 입력 gate를 실패시킨다 (조용히 추정하지 않는다).
+"""
+import io
+import struct
+
+from PIL import Image
+
+EXPLICIT_LE = "1.2.840.10008.1.2.1"
+JPEG_BASELINE = "1.2.840.10008.1.2.4.50"
+LONG_VR = {"OB", "OW", "OF", "SQ", "UT", "UN", "OD", "OL", "UC", "UR"}
+WANT = {
+    (0x0002, 0x0010): "TransferSyntaxUID",
+    (0x0008, 0x0018): "SOPInstanceUID",
+    (0x0010, 0x0020): "PatientID",
+    (0x0028, 0x0002): "SamplesPerPixel",
+    (0x0028, 0x0004): "PhotometricInterpretation",
+    (0x0028, 0x0010): "Rows",
+    (0x0028, 0x0011): "Columns",
+    (0x0028, 0x0100): "BitsAllocated",
+    (0x0028, 0x0101): "BitsStored",
+    (0x0028, 0x0102): "HighBit",
+    (0x0028, 0x0103): "PixelRepresentation",
+    (0x0028, 0x1050): "WindowCenter",
+    (0x0028, 0x1051): "WindowWidth",
+    (0x0028, 0x1052): "RescaleIntercept",
+    (0x0028, 0x1053): "RescaleSlope",
+    (0x0028, 0x0030): "PixelSpacing",
+    (0x0028, 0x2110): "LossyImageCompression",
+    (0x0018, 0x5101): "ViewPosition",
+    (0x0008, 0x0060): "Modality",
+    (0x0028, 0x0008): "NumberOfFrames",
+    (0x0028, 0x1054): "RescaleType",
+    (0x0028, 0x1056): "VOILUTFunction",
+    (0x0028, 0x3010): "VOILUTSequence",
+    (0x2050, 0x0020): "PresentationLUTShape",
+}
+
+# 신규 입력 gate: 이 조건 밖의 표시 관련 태그는 자동 추정하지 않고 exclusion 사유로 기록한다.
+STANDARD_SIG = {"Rows": 1024, "Columns": 1024, "BitsAllocated": 8, "BitsStored": 8, "HighBit": 7, "PixelRepresentation": 0,
+                "PhotometricInterpretation": "MONOCHROME2", "SamplesPerPixel": 1, "TransferSyntaxUID": JPEG_BASELINE}
+ABSENT_TAGS = ("WindowCenter", "WindowWidth", "VOILUTFunction", "VOILUTSequence")
+
+
+def _num(v):
+    try:
+        return float(str(v).split("\\")[0])
+    except ValueError:
+        return None
+
+
+def display_problems(tags):
+    """표시 관련 태그 검사. 빈 list면 'decoded 8-bit == 표시값' 가정이 성립한다.
+
+    RescaleSlope/Intercept는 없거나 항등(1/0), Window*/VOI LUT는 없어야 하고, 단일 frame이며, Presentation LUT는 없거나 IDENTITY.
+    """
+    prob = []
+    for k, v in STANDARD_SIG.items():
+        if tags.get(k) != v:
+            prob.append(f"dicom_{k}={tags.get(k)!r}")
+    for k in ABSENT_TAGS:
+        if k in tags:
+            prob.append(f"dicom_{k}_present")
+    if "RescaleSlope" in tags and _num(tags["RescaleSlope"]) != 1.0:
+        prob.append(f"dicom_RescaleSlope={tags['RescaleSlope']!r}")
+    if "RescaleIntercept" in tags and _num(tags["RescaleIntercept"]) != 0.0:
+        prob.append(f"dicom_RescaleIntercept={tags['RescaleIntercept']!r}")
+    if "NumberOfFrames" in tags and _num(tags["NumberOfFrames"]) != 1.0:
+        prob.append(f"dicom_NumberOfFrames={tags['NumberOfFrames']!r}")
+    if tags.get("PresentationLUTShape", "IDENTITY") != "IDENTITY":
+        prob.append(f"dicom_PresentationLUTShape={tags['PresentationLUTShape']!r}")
+    return prob
+
+
+def _val(vr, raw):
+    if vr in ("US",):
+        return struct.unpack("<H", raw[:2])[0]
+    if vr in ("UL",):
+        return struct.unpack("<I", raw[:4])[0]
+    return raw.decode("latin-1").rstrip("\x00 ").strip()
+
+
+def parse(data):
+    """returns (tags dict, pixel_fragments list[bytes] or native bytes)."""
+    if data[128:132] != b"DICM":
+        raise ValueError("not DICOM part-10")
+    pos, n = 132, len(data)
+    tags = {}
+    pixel = None
+    while pos + 8 <= n:
+        g, e = struct.unpack("<HH", data[pos:pos + 4])
+        vr = data[pos + 4:pos + 6].decode("latin-1")
+        if vr in LONG_VR:
+            ln = struct.unpack("<I", data[pos + 8:pos + 12])[0]
+            hdr = 12
+        else:
+            ln = struct.unpack("<H", data[pos + 6:pos + 8])[0]
+            hdr = 8
+        if g == 0x7FE0 and e == 0x0010:
+            body = pos + hdr
+            if ln == 0xFFFFFFFF:
+                frags, p = [], body
+                while True:
+                    tg, te, tl = struct.unpack("<HHI", data[p:p + 8])
+                    p += 8
+                    if (tg, te) == (0xFFFE, 0xE0DD):
+                        break
+                    if (tg, te) != (0xFFFE, 0xE000):
+                        raise ValueError("bad encapsulated item")
+                    frags.append(data[p:p + tl])
+                    p += tl
+                pixel = frags
+            else:
+                pixel = data[body:body + ln]
+            break
+        if ln == 0xFFFFFFFF:  # 정의 안 된 길이 시퀀스: 지원하지 않는다 (관심 태그 밖이면 전체 스캔 실패로 처리)
+            raise ValueError(f"undefined-length element ({g:04x},{e:04x}) unsupported")
+        if (g, e) in WANT:
+            tags[WANT[(g, e)]] = _val(vr, data[pos + hdr:pos + hdr + ln])
+        pos += hdr + ln
+    return tags, pixel
+
+
+def read_pixels(data):
+    """DICOM bytes -> (meta dict, np.uint8 array (H,W) 또는 (H,W,3))."""
+    import numpy as np
+    tags, pixel = parse(data)
+    if tags.get("TransferSyntaxUID") != JPEG_BASELINE:
+        raise ValueError(f"unsupported transfer syntax {tags.get('TransferSyntaxUID')}")
+    prob = display_problems(tags)
+    if prob:
+        raise ValueError(f"unsupported display tags: {prob}")
+    if not isinstance(pixel, list) or len(pixel) < 1:
+        raise ValueError("expected encapsulated pixel data")
+    # 첫 item은 basic offset table일 수 있다 (길이 0이면 빈 table). 단일 frame: JPEG SOI(FFD8)로 시작하는 fragment를 이어붙인다.
+    frames = [f for f in pixel if len(f) > 0]
+    jpeg = b"".join(frames)
+    if jpeg[:2] != b"\xff\xd8":
+        raise ValueError("no JPEG SOI")
+    im = Image.open(io.BytesIO(jpeg))
+    im.load()
+    arr = np.asarray(im)
+    meta = dict(tags)
+    meta["pil_mode"] = im.mode
+    meta["array_shape"] = list(arr.shape)
+    meta["array_dtype"] = str(arr.dtype)
+    return meta, arr
diff --git a/rsna_diag/evaluate.py b/rsna_diag/evaluate.py
new file mode 100644
index 0000000..ab50c41
--- /dev/null
+++ b/rsna_diag/evaluate.py
@@ -0,0 +1,240 @@
+"""생성 결과 평가 (iter_009): parse -> 환자별 metric -> 주지표(공통 위치 불일치) -> baseline -> paired bootstrap.
+
+사용: python -m rsna_diag.evaluate --gen "results/iter_009/dev/run/gen_shard*.jsonl" --split development --out results/iter_009/dev/eval
+      python -m rsna_diag.evaluate --gen "..." --split independent_eval --out ... --prior-from-dev
+"""
+import argparse
+import collections
+import glob
+import json
+import os
+
+import numpy as np
+
+from . import metrics as M, overlay, parse as PA
+
+PROMPTS = ["official_long", "concise", "legacy_detect"]
+NORMAL_PROMPTS = ["official_long", "concise"]
+SEED = 20260924
+HARD_IOU = 0.3
+GT_CAT_NAMES = {"opacity": "positive", "normal": "Normal", "not_normal_no_opacity": "NoOpacity/NotNormal"}
+
+
+def load_gen(pattern):
+    recs = {}
+    files = [f for pat in pattern.split(",") for f in sorted(glob.glob(pat))]
+    for f in files:
+        if f.endswith((".env.json", ".log")):
+            continue
+        for ln in open(f):
+            if ln.strip():
+                r = json.loads(ln)
+                k = (r["id"], r["prompt_name"])
+                if k in recs:
+                    raise ValueError(f"duplicate generation record {k} in {f} (already loaded from {recs[k].get('_file')})")
+                r["_file"] = f
+                recs[k] = r
+    return recs
+
+
+def gt_boxes(g):
+    return [b["yxyx_norm"] for b in g["boxes"]]
+
+
+def rate(k, n):
+    lo, hi = M.wilson(k, n)
+    return {"k": k, "n": n, "rate": (k / n if n else None), "wilson95": [lo, hi]}
+
+
+def evaluate(recs, gt, split, prior_box=None, B=10000):
+    ids = sorted(i for i, g in gt.items() if g["split"] == split)
+    pos = [i for i in ids if gt[i]["category"] == "opacity"]
+    out = {"split": split, "n_patients": len(ids), "n_positive": len(pos), "prompts": {}, "missing_requests": []}
+    parsed = {}
+    for i in ids:
+        for p in PROMPTS:
+            r = recs.get((i, p))
+            if r is None:
+                out["missing_requests"].append([i, p])
+                parsed[(i, p)] = {"status": "missing", "boxes": [], "flags": [], "problems": []}
+            else:
+                parsed[(i, p)] = PA.parse_response(r["suffix_text_raw"], r["ended_eos"])
+    per = {}
+    for p in PROMPTS:
+        st_all = collections.Counter(parsed[(i, p)]["status"] for i in ids)
+        st_pos = collections.Counter(parsed[(i, p)]["status"] for i in pos)
+        valid = lambda i: parsed[(i, p)]["status"] in PA.VALID
+        d = {"status_all": dict(st_all), "status_positive": dict(st_pos),
+             "valid_rate_positive": rate(sum(valid(i) for i in pos), len(pos)),
+             "valid_rate_all": rate(sum(valid(i) for i in ids), len(ids))}
+        for thr in (0.3, 0.5):
+            f1s, recs_, precs = [], [], []
+            for i in pos:
+                pb = parsed[(i, p)]["boxes"] if valid(i) else []
+                m = M.patient_metrics(pb, gt_boxes(gt[i]), thr)
+                f1s.append(m["f1"]); recs_.append(m["recall"]); precs.append(m["precision"])
+            d[f"f1@{thr}_end_to_end"] = float(np.mean(f1s)) if f1s else None
+            d[f"recall@{thr}_end_to_end"] = float(np.mean(recs_)) if recs_ else None
+            d[f"precision@{thr}_end_to_end"] = float(np.mean(precs)) if precs else None
+            vi = [k for k, i in enumerate(pos) if valid(i)]
+            d[f"f1@{thr}_valid_only"] = {"mean": float(np.mean([f1s[k] for k in vi])) if vi else None, "n": len(vi)}
+            per[(p, f"f1@{thr}")] = np.array(f1s)
+        uis = [M.union_iou(parsed[(i, p)]["boxes"] if valid(i) else [], gt_boxes(gt[i])) for i in pos]
+        d["union_iou_end_to_end"] = float(np.mean(uis)) if uis else None
+        per[(p, "union_iou")] = np.array(uis)
+        vne = [i for i in pos if parsed[(i, p)]["status"] == "valid_nonempty"]
+        hard = [i for i in vne if M.max_iou_all(parsed[(i, p)]["boxes"], gt_boxes(gt[i])) < HARD_IOU]
+        d["hard_mismatch"] = {"k": len(hard), "n_positive": len(pos), "n_valid_nonempty": len(vne),
+                              "rate_over_positives": rate(len(hard), len(pos)),
+                              "rate_over_valid_nonempty": rate(len(hard), len(vne)), "ids": hard}
+        d["positive_valid_empty"] = rate(st_pos.get("valid_empty", 0), len(pos))
+        d["positive_n_pred_dist"] = dict(collections.Counter(len(parsed[(i, p)]["boxes"]) for i in vne))
+        # 음성 층
+        for cat, nm in (("normal", "Normal"), ("not_normal_no_opacity", "NoOpacity/NotNormal")):
+            neg = [i for i in ids if gt[i]["category"] == cat]
+            d[f"neg_{nm}"] = {"valid_empty": rate(sum(parsed[(i, p)]["status"] == "valid_empty" for i in neg), len(neg)),
+                              "valid_nonempty": rate(sum(parsed[(i, p)]["status"] == "valid_nonempty" for i in neg), len(neg)),
+                              "format_fail": rate(sum(parsed[(i, p)]["status"] not in PA.VALID for i in neg), len(neg))}
+        d["flags_all"] = dict(collections.Counter(f for i in ids for f in parsed[(i, p)]["flags"]))
+        d["duplicate_boxes_total"] = int(sum(PA.duplicates([b for b in parsed[(i, p)]["boxes"] if b]) for i in ids))
+        gen_recs = [recs[(i, p)] for i in ids if (i, p) in recs]
+        d["generation"] = {"n_requests": len(gen_recs),
+                           "n_cap_extended": sum(1 for r in gen_recs if len(r["attempts"]) > 1),
+                           "n_final_cap_1000_2000_4000": [sum(1 for r in gen_recs if r["final_cap"] == c) for c in (1000, 2000, 4000)],
+                           "mean_out_tokens": float(np.mean([r["n_output_tokens"] for r in gen_recs])) if gen_recs else None,
+                           "max_out_tokens": max((r["n_output_tokens"] for r in gen_recs), default=None),
+                           "mean_runtime_s": float(np.mean([r["runtime_s_total"] for r in gen_recs])) if gen_recs else None,
+                           "peak_mem_gb_max": max((r["peak_mem_alloc_gb_max"] for r in gen_recs), default=None),
+                           "prefix_mismatch_across_caps": sum(1 for r in gen_recs for a in r["attempts"] if a.get("prefix_matches_previous") is False)}
+        out["prompts"][p] = d
+    # 주지표: 두 정상 prompt 공통 위치 불일치
+    common = [i for i in pos if all(i in out["prompts"][p]["hard_mismatch"]["ids"] for p in NORMAL_PROMPTS)]
+    valid95 = {p: {"positive": out["prompts"][p]["valid_rate_positive"]["rate"], "all": out["prompts"][p]["valid_rate_all"]["rate"]}
+               for p in NORMAL_PROMPTS}
+    lo, hi = M.wilson(len(common), len(pos))
+    out["primary"] = {"definition": "양성 환자 중 official_long과 concise 모두 유효·비어있지 않은 출력이고 모든 예측-GT IoU < 0.3",
+                      "common_hard_mismatch": {"k": len(common), "n": len(pos), "rate": len(common) / len(pos) if pos else None,
+                                               "wilson95": [lo, hi]}, "common_ids": common,
+                      "valid_output_rate_normal_prompts": valid95,
+                      "criterion_valid_ge_95pct_both_prompts_positive_and_all": all(v["positive"] >= .95 and v["all"] >= .95 for v in valid95.values()),
+                      "criterion_wilson_lower_gt_20pct": bool(lo > 0.20)}
+    prim = out["primary"]
+    if prim["criterion_valid_ge_95pct_both_prompts_positive_and_all"]:
+        prim["verdict"] = ("supported" if prim["criterion_wilson_lower_gt_20pct"] else
+                           ("not_supported" if hi <= 0.20 else "inconclusive"))
+    else:
+        prim["verdict"] = "not_evaluable_valid_output_rate_below_95pct"
+    # baselines
+    base = {}
+    if prior_box is not None:
+        for thr in (0.3, 0.5):
+            base[f"prior_f1@{thr}"] = float(np.mean([M.patient_metrics([prior_box], gt_boxes(gt[i]), thr)["f1"] for i in pos]))
+        pf = np.array([M.patient_metrics([prior_box], gt_boxes(gt[i]), 0.3)["f1"] for i in pos])
+        per[("prior", "f1@0.3")] = pf
+        per[("prior", "union_iou")] = np.array([M.union_iou([prior_box], gt_boxes(gt[i])) for i in pos])
+        base["prior_box"] = prior_box
+        base["prior_union_iou"] = float(per[("prior", "union_iou")].mean())
+        base["prior_hard_mismatch_rate"] = float(np.mean([M.max_iou_all([prior_box], gt_boxes(gt[i])) < HARD_IOU for i in pos]))
+    swap = {}
+    for k, p in enumerate(PROMPTS):
+        perm = M.derangement(len(pos), SEED + 100 + k)
+        f1, hard, uis = [], 0, []
+        for a, i in enumerate(pos):
+            donor = pos[perm[a]]
+            pr = parsed[(donor, p)]
+            pb = pr["boxes"] if pr["status"] in PA.VALID else []
+            f1.append(M.patient_metrics(pb, gt_boxes(gt[i]), 0.3)["f1"])
+            uis.append(M.union_iou(pb, gt_boxes(gt[i])))
+            hard += int(pr["status"] == "valid_nonempty" and M.max_iou_all(pb, gt_boxes(gt[i])) < HARD_IOU)
+        per[(f"swap_{p}", "f1@0.3")] = np.array(f1)
+        per[(f"swap_{p}", "union_iou")] = np.array(uis)
+        swap[p] = {"f1@0.3": float(np.mean(f1)), "union_iou": float(np.mean(uis)), "hard_mismatch_rate_over_positives": hard / len(pos),
+                   "permutation_seed": SEED + 100 + k, "scope": "within positives (donor = 다른 양성 환자의 전체 예측)"}
+        # 전체 집단 derangement: 음성 추가 예측률 비교용
+        permA = M.derangement(len(ids), SEED + 200 + k)
+        ne = {}
+        for cat, nm in (("normal", "Normal"), ("not_normal_no_opacity", "NoOpacity/NotNormal")):
+            idx = [a for a, i in enumerate(ids) if gt[i]["category"] == cat]
+            ne[nm] = float(np.mean([parsed[(ids[permA[a]], p)]["status"] == "valid_nonempty" for a in idx]))
+        swap[p]["whole_population_negative_valid_nonempty_rate"] = ne
+    base["image_swap"] = swap
+    out["baselines"] = base
+    # paired bootstrap (양성 환자 단위)
+    idx = M.bootstrap_indices(len(pos), B, SEED)
+    comps = [("official_long", "concise", "f1@0.3"), ("official_long", "legacy_detect", "f1@0.3"), ("concise", "legacy_detect", "f1@0.3")]
+    for p in NORMAL_PROMPTS:
+        comps += [(p, "prior", "f1@0.3"), (p, f"swap_{p}", "f1@0.3")]
+    for p in PROMPTS:
+        comps += [(p, "prior", "f1@0.3")] if p not in NORMAL_PROMPTS else []
+    boot = {}
+    for a, b, met in comps:
+        if (a, met) in per and (b, met) in per:
+            m, lo_, hi_ = M.paired_boot_ci(per[(a, met)], per[(b, met)], idx)
+            boot[f"{a} - {b} [{met}]"] = {"mean_diff": m, "ci95": [lo_, hi_]}
+    out["paired_bootstrap"] = {"B": B, "seed": SEED, "unit": "positive patient", "diffs": boot}
+    return out, parsed, idx, pos
+
+
+def size_stats(parsed, gt, pos):
+    """위치 불일치의 크기/위치 분포 (기술 통계)."""
+    rows = []
+    for i in pos:
+        g = gt_boxes(gt[i])
+        garea = M.union_area(g)
+        row = {"id": i, "n_gt": len(g), "gt_union_area_frac": garea / 1e6}
+        for p in PROMPTS:
+            pr = parsed[(i, p)]
+            pb = pr["boxes"] if pr["status"] in PA.VALID else []
+            row[p] = {"status": pr["status"], "n_pred": len(pb), "pred_union_area_frac": M.union_area(pb) / 1e6 if pb else 0.0,
+                      "max_iou": M.max_iou_all(pb, g) if pb else 0.0}
+        rows.append(row)
+    return rows
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--gen", required=True)
+    ap.add_argument("--split", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--gt", default="results/iter_010/manifests/gt_manifest.json")
+    ap.add_argument("--images-dir", default="results/iter_010/data/images")
+    ap.add_argument("--B", type=int, default=10000)
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    gt = json.load(open(a.gt))
+    recs = load_gen(a.gen)
+    dev_pos = [gt_boxes(g) for i, g in sorted(gt.items()) if g["split"] == "train" and g["category"] == "opacity"]
+    prior_box, prior_score = M.medoid_box(dev_pos)
+    res, parsed, idx, pos = evaluate(recs, gt, a.split, prior_box, a.B)
+    res["baselines"]["prior_selection_mean_best_iou_on_dev_positives"] = prior_score
+    json.dump(res, open(f"{a.out}/metrics.json", "w"), indent=1)
+    np.savez_compressed(f"{a.out}/bootstrap_indices.npz", idx=idx, positive_ids=np.array(pos))
+    json.dump(size_stats(parsed, gt, pos), open(f"{a.out}/positive_case_table.json", "w"), indent=1)
+    # 사례: 공통 오류/성공 최대 20명씩 (고정 ID 순서)
+    ok = [i for i in pos if all(parsed[(i, p)]["status"] == "valid_nonempty" and M.max_iou_all(parsed[(i, p)]["boxes"], gt_boxes(gt[i])) >= 0.5
+                                for p in NORMAL_PROMPTS)]
+    cases = {"common_error": res["primary"]["common_ids"][:20], "success_iou_ge_0.5_both": ok[:20]}
+    os.makedirs(f"{a.out}/cases", exist_ok=True)
+    detail = {}
+    for kind, lst in cases.items():
+        for i in lst:
+            g = gt[i]
+            ims = []
+            for p in NORMAL_PROMPTS:
+                pb = [b for b in parsed[(i, p)]["boxes"] if b]
+                ims.append(overlay.draw(f"{a.images_dir}/{g['sop']}.png", gt_boxes(g), pb, 512, f"{i} {p}"))
+            overlay.montage(ims, 2).save(f"{a.out}/cases/{kind}_{i}.png")
+            detail[f"{kind}/{i}"] = {"gt": gt_boxes(g), **{p: {"status": parsed[(i, p)]["status"], "boxes": parsed[(i, p)]["boxes"],
+                                                            "response": recs[(i, p)]["suffix_text_raw"] if (i, p) in recs else None} for p in NORMAL_PROMPTS}}
+    json.dump(detail, open(f"{a.out}/case_details.json", "w"), indent=1)
+    pm = res["primary"]
+    print(json.dumps({"split": a.split, "n_pos": res["n_positive"], "missing": len(res["missing_requests"]), "primary": {k: pm[k] for k in pm if k != "common_ids"}}, indent=1))
+    for p in PROMPTS:
+        d = res["prompts"][p]
+        print(p, "valid_pos", round(d["valid_rate_positive"]["rate"], 3), "f1@.3", round(d["f1@0.3_end_to_end"], 3), "f1@.5", round(d["f1@0.5_end_to_end"], 3),
+              "hard/pos", d["hard_mismatch"]["k"], "/", d["hard_mismatch"]["n_positive"], "status_pos", d["status_positive"])
+    print("prior f1@.3", res["baselines"].get("prior_f1@0.3"), "swap", {p: round(v["f1@0.3"], 3) for p, v in res["baselines"]["image_swap"].items()})
+
+
+if __name__ == "__main__":
+    main()
diff --git a/rsna_diag/final_eval.py b/rsna_diag/final_eval.py
new file mode 100644
index 0000000..ab80e62
--- /dev/null
+++ b/rsna_diag/final_eval.py
@@ -0,0 +1,129 @@
+"""iter_010 비교 평가. 두 단계:
+
+  comparator: validation(400)의 base 생성·보정·prior 중 양성 F1@0.3 최대인 단순 비교군 1개를 주 비교군으로 고정 (확인 결과를 보기 전에).
+  confirm:    고정된 주 비교군과 SFT 3개 seed를 확인 800명에서 같은 metric으로 비교 (paired bootstrap 10,000회, seed 20260925).
+사용: python -m rsna_diag.final_eval comparator --val-base DIR --out FILE
+      python -m rsna_diag.final_eval confirm --comparator FILE --conf-base DIR --sft seed=DIR ... --out FILE
+"""
+import argparse
+import json
+import os
+
+import numpy as np
+
+from . import baselines as B, evaluate as EV, metrics as M, parse as PA, sft_eval
+
+GT = "results/iter_010/manifests/gt_manifest.json"
+BASE_JSON = "results/iter_010/baselines/baselines.json"
+BOOT_SEED, BOOT_B = 20260925, 10000
+
+
+def split_ids(gt, split):
+    return sorted(i for i in gt if gt[i]["split"] == split)
+
+
+def base_predictions(recs, ids, bl):
+    """base 생성 record -> {이름: preds}. 보정은 prompt별 고정 변환 (실패 출력은 그대로)."""
+    out = {}
+    for p in ("official_long", "concise"):
+        raw = sft_eval.parse_records(recs, ids, p)
+        out[p] = raw
+        spec = tuple(bl[p]["spec"])
+        out[p + "+corr"] = {i: B.apply_pred(raw[i], spec)[0] for i in ids}
+    return out
+
+
+def prior_predictions(ids, bl):
+    return {"prior_set": {i: {"status": "valid_nonempty", "boxes": bl["prior_set"]["set"]} for i in ids},
+            "prior_single": {i: {"status": "valid_nonempty", "boxes": [bl["prior_single_box"]["box"]]} for i in ids}}
+
+
+def all_simple(recs, ids, bl):
+    d = base_predictions(recs, ids, bl)
+    d.update(prior_predictions(ids, bl))
+    return d
+
+
+def cmd_comparator(a):
+    gt = json.load(open(GT))
+    bl = json.load(open(BASE_JSON))
+    ids = split_ids(gt, "validation")
+    recs = EV.load_gen(os.path.join(a.val_base, "gen_worker*.jsonl"))
+    tr = [i for i in gt if gt[i]["split"] == "train"]
+    edges = sft_eval.area_edges(gt, tr)
+    preds = all_simple(recs, ids, bl)
+    summ = {k: sft_eval.summarize(v, gt, ids, edges) for k, v in preds.items()}
+    best = max(summ, key=lambda k: (round(summ[k]["f1@0.3"], 12), k))
+    json.dump({"comparator": best, "selection": "validation positive mean F1@0.3 (end-to-end)", "n_val": len(ids),
+               "val_f1@0.3": {k: v["f1@0.3"] for k, v in summ.items()}, "val_summaries": summ}, open(a.out, "w"), indent=1)
+    print("comparator", best, {k: round(v["f1@0.3"], 4) for k, v in summ.items()})
+
+
+def cmd_confirm(a):
+    comp = json.load(open(a.comparator))
+    gt = json.load(open(GT))
+    bl = json.load(open(BASE_JSON))
+    ids = split_ids(gt, "confirm")
+    pos = [i for i in ids if gt[i]["category"] == "opacity"]
+    tr = [i for i in gt if gt[i]["split"] == "train"]
+    edges = sft_eval.area_edges(gt, tr)
+    recs = EV.load_gen(os.path.join(a.conf_base, "gen_worker*.jsonl"))
+    preds = all_simple(recs, ids, bl)
+    sft = {}
+    for kv in a.sft:
+        seed, d = kv.split("=")
+        r = EV.load_gen(os.path.join(d, "gen_worker*.jsonl"))
+        sft[f"sft_seed{seed}"] = sft_eval.parse_records(r, ids, "concise")
+        adg = {x["adapter_digest"] for x in r.values()}
+        assert len(adg) == 1, f"seed {seed}: multiple adapter digests {adg}"
+    preds.update(sft)
+    summ = {k: sft_eval.summarize(v, gt, ids, edges) for k, v in preds.items()}
+    per = {k: sft_eval.per_patient(v, gt, ids)[1]["f1@0.3"] for k, v in preds.items()}
+    idx = M.bootstrap_indices(len(pos), BOOT_B, BOOT_SEED)
+    cname = comp["comparator"]
+    seeds = sorted(sft)
+    mean_sft = np.mean([per[s] for s in seeds], axis=0)
+    m, lo, hi = M.paired_boot_ci(mean_sft, per[cname], idx)
+    diffs = {s: float(per[s].mean() - per[cname].mean()) for s in seeds}
+    boot_all = {}
+    for k in preds:
+        if k in sft or k == cname:
+            continue
+        mm, l_, h_ = M.paired_boot_ci(mean_sft, per[k], idx)
+        boot_all[k] = {"mean_diff": mm, "ci95": [l_, h_]}
+    base_c = summ["concise"]
+    neg_ok = {}
+    for s in seeds:
+        neg_ok[s] = {nm: (base_c[f"neg_{nm}"]["valid_empty"]["rate"] - summ[s][f"neg_{nm}"]["valid_empty"]["rate"]) <= 0.05
+                     for nm in ("Normal", "NoOpacity/NotNormal")}
+    crit = {"mean_diff_ge_0.05": m >= 0.05, "ci_lower_gt_0": lo > 0, "all_seed_diffs_positive": all(v > 0 for v in diffs.values()),
+            "valid_output_rate_all_ge_95pct_each_seed": all(summ[s]["valid_rate_all"]["rate"] >= 0.95 for s in seeds),
+            "negative_valid_empty_not_worse_than_5pp_vs_base_concise": all(all(v.values()) for v in neg_ok.values())}
+    verdict = "success" if all(crit.values()) else ("partial_improvement" if m > 0 else "no_improvement")
+    res = {"comparator": cname, "n_confirm_positive": len(pos), "primary": {"mean_sft_minus_comparator_f1@0.3": m, "ci95": [lo, hi],
+           "bootstrap": {"B": BOOT_B, "seed": BOOT_SEED, "unit": "positive patient", "note": "학습 seed 불확실성을 충분히 추정하지 않는다"},
+           "per_seed_diff": diffs, "per_seed_f1@0.3": {s: float(per[s].mean()) for s in seeds},
+           "seed_range_f1@0.3": [min(per[s].mean() for s in seeds), max(per[s].mean() for s in seeds)]},
+           "criteria": crit, "negative_layer_detail": neg_ok, "verdict_preregistered_criteria": verdict,
+           "diff_vs_other_baselines": boot_all, "summaries": summ}
+    json.dump(res, open(a.out, "w"), indent=1)
+    print(json.dumps({k: res["primary"][k] for k in ("mean_sft_minus_comparator_f1@0.3", "ci95", "per_seed_diff")}), crit, verdict)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    c = sp.add_parser("comparator")
+    c.add_argument("--val-base", required=True)
+    c.add_argument("--out", required=True)
+    f = sp.add_parser("confirm")
+    f.add_argument("--comparator", required=True)
+    f.add_argument("--conf-base", required=True)
+    f.add_argument("--sft", nargs="+", required=True)
+    f.add_argument("--out", required=True)
+    a = ap.parse_args()
+    {"comparator": cmd_comparator, "confirm": cmd_confirm}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
