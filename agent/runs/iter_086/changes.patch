index 0000000..db1c3c3
--- /dev/null
+++ b/report86_tput.py
@@ -0,0 +1,42 @@
+"""D8 처리량 비교 집계: 같은 24개 계승 CURE 요청을 GPU당 1 worker(A)와 GPU당 2 worker(B)로 재생성한 실행을 비교한다.
+생성 구간 = 첫 request_start ~ 마지막 request_saved(모델 로딩 제외). 로딩은 별도 보고. token 동등성은 계승 행과 비교한 값이다.
+python report86_tput.py <out.json> <label=glob_of_dirs> [...]
+"""
+import glob
+import json
+import sys
+
+from report86_common import R86, save, read_jsonl_complete
+
+
+def summarize(dirs):
+    ev, recs, loads, peaks = [], [], [], []
+    for d in dirs:
+        e = read_jsonl_complete(d + '/executions.jsonl')
+        ev += [x for x in e if x['event'] in ('request_start', 'request_saved')]
+        loads += [x['loading_s'] for x in e if x['event'] == 'start' and 'loading_s' in x]
+        r = read_jsonl_complete(d + '/outputs.jsonl')
+        recs += r
+        peaks += [a['peak_mem_reserved_gb'] for x in r for a in x['attempts']]
+        rr = sorted(glob.glob(d + '/regress_result_*.json'))
+        assert len(rr) == 1, d
+    t0 = min(x['time'] for x in ev if x['event'] == 'request_start')
+    t1 = max(x['time'] for x in ev if x['event'] == 'request_saved')
+    res_eq = []
+    for d in dirs:
+        res_eq += [i['equal'] for i in json.load(open(sorted(glob.glob(d + '/regress_result_*.json'))[0]))['items']]
+    secs = sorted(sum(a['runtime_s'] for a in x['attempts']) for x in recs)
+    return {'dirs': [d.split('/')[-1] for d in dirs], 'n_requests': len(recs), 'window_s': t1 - t0, 'req_per_min': 60 * len(recs) / (t1 - t0),
+            'loading_s': loads, 'tokens_equal_to_inherited': sum(res_eq), 'of': len(res_eq),
+            'p50_s': secs[len(secs) // 2], 'p95_s': secs[int(0.95 * (len(secs) - 1))], 'max_s': secs[-1],
+            'peak_reserved_gib_max': max(peaks)}
+
+
+if __name__ == '__main__':
+    out = sys.argv[1]
+    res = {}
+    for a in sys.argv[2:]:
+        label, g = a.split('=')
+        res[label] = summarize(sorted(glob.glob(g)))
+    save(out, res)
+    print(json.dumps(res, indent=1))
diff --git a/report86_verify.py b/report86_verify.py
new file mode 100644
index 0000000..8fd787d
--- /dev/null
+++ b/report86_verify.py
@@ -0,0 +1,126 @@
+"""평가 결과의 독립 재계산(report86_eval.py를 import하지 않는다). 판정 원문과 reference 사실·blind key에서 환자별 지표와 요약 평균을 다시 계산하고
+저장된 report.json과 대조한다. bootstrap CI는 별도 난수·별도 구현으로 다시 계산해 끝점 차이가 몬테카를로 허용오차 안인지 본다.
+python report86_verify.py <stage> <judgments.txt> <report.json> <out.json>
+"""
+import hashlib
+import json
+import re
+import sys
+
+import numpy as np
+
+from report86_common import R86, R85, STAGES, save, sha
+
+CONDS = ['M15-R', 'M15-S', 'B0-R', 'B0-S', 'M1-R', 'M1-G', 'C-G', 'C-H']
+POS = {'pos_def', 'pos_hedged', 'pos_temporal', 'pos_ambiguous'}
+COMPS = [('B0-R', 'M15-R'), ('M15-S', 'M15-R'), ('B0-S', 'M15-S'), ('C-G', 'M1-G'), ('C-H', 'C-G')]
+
+
+def main():
+    stage, jpath, rpath, outp = sys.argv[1:5]
+    rows = json.load(open(STAGES[stage]['inputs']))
+    if stage == 'D8':
+        sys.path.insert(0, '.')
+        import report86_facts as F
+        refs = {r['ImageID']: {'facts': F.facts_for(r)} for r in json.load(open(R85 / 'D8/reference_private.json'))}
+    else:
+        refs = json.load(open(R86 / 'E/reference_facts_E_private.json'))
+    key = json.load(open(R86 / stage / 'blind_key_private.json'))
+    reads = {}
+    for ln in open(R86 / stage / 'readings.jsonl'):
+        r = json.loads(ln)
+        reads[(r['ImageID'], r['condition'])] = r
+    # 판정 원문을 줄 단위로 직접 파싱
+    pid, per = None, {}
+    for ln in open(jpath):
+        ln = ln.strip()
+        if not ln or ln[0] == '#':
+            continue
+        if re.fullmatch(r'P\d{3}', ln):
+            pid = rows[int(ln[1:])]['ImageID']
+            continue
+        head, rest = ln.split(':', 1)
+        cond = key[pid][head]
+        sec = rest.split(' ; ')
+        facts = {}
+        for tok in re.finditer(r'F(\d+)=([DPNU])([+\-~]?)', sec[0]):
+            facts['F' + tok.group(1)] = (tok.group(2), tok.group(3))
+        contra = [] if sec[1].strip() == 'C=-' else [x.strip() for x in sec[1].strip()[2:].split(',')]
+        internal = int(sec[2].strip()[2:])
+        xd, xp = [int(x.split('=')[1]) for x in sec[3].split()]
+        per[(pid, cond)] = (facts, contra, internal, xd, xp)
+    rep = json.load(open(rpath))
+    mism, nchecked = [], 0
+    mine = {}
+    for (img, c), (facts, contra, internal, xd, xp) in per.items():
+        cl = {x['fact_id']: x['fact_class'] for x in refs[img]['facts']}
+        pdef = [f for f in facts if cl[f] == 'pos_def']
+        n = len(pdef)
+        D = [f for f in pdef if facts[f][0] == 'D']
+        Pn = [f for f in pdef if facts[f][0] == 'P']
+        Nn = [f for f in pdef if facts[f][0] == 'N']
+        Dm = [f for f in D if facts[f][1] == '-']
+        Dnotstrict = [f for f in D if facts[f][1] in ('-', '~')]  # 엄격 recall: 위치가 맞거나 reference가 위치를 지정하지 않은 D만 (계획의 '위치·명시 속성까지 맞는' 정의)
+        a_d = sum(1 for x in contra if x.startswith('d:'))
+        nneg = sum(1 for v in cl.values() if v == 'neg_specific')
+        v = {'recall_def': len(D) / n if n else None, 'recall_strict': (len(D) - len(Dnotstrict)) / n if n else None,
+             'recall_incl_possible': (len(D) + len(Pn)) / n if n else None,
+             'contra_primary': int(a_d > 0 or len(Nn) > 0 or len(Dm) > 0) if (n or nneg) else None, 'internal': internal, 'xd': xd, 'xp': xp}
+        wide = [f for f in facts if cl[f] in ('pos_def', 'pos_hedged', 'pos_temporal')]
+        v['recall_wide_D'] = sum(facts[f][0] == 'D' for f in wide) / len(wide) if wide else None
+        mine[(img, c)] = v
+        saved = rep['per_output'][f'{img}|{c}']
+        for k, x in v.items():
+            nchecked += 1
+            y = saved[k]
+            if (x is None) != (y is None) or (x is not None and abs(x - y) > 1e-12):
+                mism.append({'id': f'{img}|{c}', 'metric': k, 'mine': x, 'saved': y})
+        # 보고서 정합성: 토큰/요청 수가 readings와 일치
+        for k, val in (('n_tokens', reads[(img, c)]['n_tokens']), ('n_requests', len(reads[(img, c)]['request_ids']))):
+            nchecked += 1
+            if saved[k] != val:
+                mism.append({'id': f'{img}|{c}', 'metric': k, 'mine': val, 'saved': saved[k]})
+    # 요약 평균 대조
+    strata = {r['ImageID']: r.get('stratum', 'D8') for r in rows}
+    sets = {'all': list(strata)}
+    for s in sorted(set(strata.values())):
+        sets[s] = [i for i in strata if strata[i] == s]
+    sum_mism = []
+    for sname, imgs in sets.items():
+        for c in CONDS:
+            for m in ('recall_def', 'recall_strict', 'recall_incl_possible', 'contra_primary', 'internal', 'xd', 'xp'):
+                vals = [mine[(i, c)][m] for i in imgs if mine[(i, c)][m] is not None]
+                mv = float(np.mean(vals)) if vals else None
+                sv = rep['summary'][sname]['conditions'][c][m]['mean']
+                nchecked += 1
+                if (mv is None) != (sv is None) or (mv is not None and abs(mv - sv) > 1e-12):
+                    sum_mism.append({'set': sname, 'cond': c, 'metric': m, 'mine': mv, 'saved': sv})
+    # bootstrap CI 별도 재계산(다른 seed·다른 구현; 허용오차 0.02)
+    rng = np.random.RandomState(20261007)
+    ci_checks, ci_bad = 0, []
+    for sname, imgs in sets.items():
+        for a, b in COMPS:
+            for m in ('recall_def', 'contra_primary', 'internal'):
+                d = [mine[(i, a)][m] - mine[(i, b)][m] for i in imgs if mine[(i, a)][m] is not None and mine[(i, b)][m] is not None]
+                if len(d) < 2:
+                    continue
+                d = np.array(d, float)
+                boots = np.array([d[rng.randint(0, len(d), len(d))].mean() for _ in range(10000)])
+                lo, hi = np.percentile(boots, [2.5, 97.5])
+                saved = rep['comparisons'][sname][f'{a}-{b}'][m]
+                ci_checks += 1
+                tol = 0.035 if len(d) >= 30 else 0.05  # 표본이 작으면 bootstrap 분포가 이산적이라 끝점 허용오차를 넓힌다
+                ok = abs(saved['diff'] - d.mean()) < 1e-12 and abs(saved['ci95'][0] - lo) < tol and abs(saved['ci95'][1] - hi) < tol
+                if not ok:
+                    ci_bad.append({'set': sname, 'cmp': f'{a}-{b}', 'metric': m, 'saved': saved, 'mine': [float(lo), float(hi), float(d.mean())]})
+    res = {'stage': stage, 'n_values_checked': nchecked, 'n_mismatch_per_output': len(mism), 'mismatches': mism[:20],
+           'n_summary_mismatch': len(sum_mism), 'summary_mismatches': sum_mism[:20], 'n_ci_checked': ci_checks, 'n_ci_mismatch': len(ci_bad), 'ci_mismatches': ci_bad[:10],
+           'judgments_sha256': sha(jpath), 'report_sha256': sha(rpath), 'pass': not mism and not sum_mism and not ci_bad,
+           'independence': 'judgment text parsed by separate code; no import of report86_eval; CI via RandomState(20261007) loop'}
+    save(outp, res)
+    print(json.dumps({k: v for k, v in res.items() if k not in ('mismatches', 'summary_mismatches', 'ci_mismatches')}, indent=1))
+    sys.exit(0 if res['pass'] else 1)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/report86_view.py b/report86_view.py
new file mode 100644
index 0000000..be6671d
--- /dev/null
+++ b/report86_view.py
@@ -0,0 +1,103 @@
+"""의미 평가용 눈가림 view 생성(읽기 전용 CPU). 모델명을 숨긴 출력 ID(O1..O8)와 reference 사실 ID(F#)를 보여 준다.
+python report86_view.py <stage> <start> <end>        # 환자 index 범위를 stdout으로 출력
+python report86_view.py <stage> key                   # blind key(private)를 새 파일로 저장
+눈가림은 불완전하다: CURE 영역 출력·MedGemma 1 문체는 형식으로 식별될 수 있다(규약에 명시).
+"""
+import hashlib
+import json
+import re
+import sys
+
+from report86_common import R86, STAGES, R85, save
+import report86_facts as F
+
+BBOX = re.compile(r"\s*\[\s*-?[\d.]+\s*,\s*-?[\d.]+\s*,\s*-?[\d.]+\s*,\s*-?[\d.]+\s*\]")
+CONDS = ['M15-R', 'M15-S', 'B0-R', 'B0-S', 'M1-R', 'M1-G', 'C-G', 'C-H']
+
+
+def blind_order(img):
+    return sorted(CONDS, key=lambda c: hashlib.sha256(f'blind86|{img}|{c}'.encode()).hexdigest())
+
+
+def load(stage):
+    rows = json.loads(STAGES[stage]['inputs'].read_text())
+    reads = {}
+    for ln in (R86 / stage / 'readings.jsonl').read_text().splitlines():
+        r = json.loads(ln)
+        reads[(r['ImageID'], r['condition'])] = r
+    if stage == 'D8':
+        refs = {r['ImageID']: {'facts': F.facts_for(r)} for r in json.loads((R85 / 'D8/reference_private.json').read_text())}
+    else:
+        refs = json.loads((R86 / 'E/reference_facts_E_private.json').read_text())
+    return rows, reads, refs
+
+
+def collapse_repeats(t):
+    """4096-token 반복 루프 같은 퇴행 출력은 중복 문장을 (xN)으로 접어 보여 준다(원문은 readings.jsonl에 그대로 있음)."""
+    sents = re.split(r'(?<=[.!?])\s+', t)
+    if len(t) < 1500 or len(set(sents)) > 0.5 * len(sents):
+        return t
+    seen, order = {}, []
+    for x in sents:
+        if x not in seen:
+            order.append(x)
+        seen[x] = seen.get(x, 0) + 1
+    return ' '.join(f"{x} (x{seen[x]})" if seen[x] > 1 else x for x in order) + f"\n[view: degenerate repetition collapsed; original {len(t)} chars, {len(sents)} sentences, {len(order)} distinct]"
+
+
+def clean(t):
+    t = BBOX.sub('', t)
+    t = re.sub(r'[ \t]+\n', '\n', t).strip()
+    return collapse_repeats(t)
+
+
+def render_ch(segs):
+    seen, out = {}, []
+    for s in segs:
+        src = s['source'].split('|')[1]
+        t = clean(s['text'])
+        t = re.sub(r'^Location of the [^:]*:\s*\.?\s*', '', t)
+        t = re.sub(r'^Description:\s*', '', t)
+        t = t.replace('Description:', '').strip()
+        if src == 'G':
+            out.append(('GRG', t))
+            continue
+        seen.setdefault(t, []).append(src)
+    lines = [f"[{', '.join(v)}] {k}" for k, v in seen.items()]
+    return '\n'.join(lines) + '\nGRG-part: ' + [t for k, t in out][0]
+
+
+def show(stage, a, b, idx=None):
+    rows, reads, refs = load(stage)
+    for pi, row in ([(i, rows[i]) for i in idx] if idx else enumerate(rows[a:b], a)):
+        img = row['ImageID']
+        print(f"==== P{pi:03d} {img[:8]} stratum={row.get('stratum', 'D8')} ====")
+        for x in refs[img]['facts']:
+            if x['fact_class'] in ('generic_normal', 'neg_scoped', 'excluded'):
+                continue
+            loc = ','.join(x['locations'])
+            print(f"  {x['fact_id']} [{x['fact_class']}] {x['sentence_en']}  (labels={','.join(x['labels'])}; loc={loc})")
+        gen = [x for x in refs[img]['facts'] if x['fact_class'] in ('generic_normal',)]
+        if gen:
+            print('  (generic normal statements present: ' + ' / '.join(x['sentence_en'] for x in gen) + ')')
+        for i, c in enumerate(blind_order(img), 1):
+            r = reads[(img, c)]
+            body = render_ch(r['segments']) if c == 'C-H' else clean(r['text'])
+            print(f"--- O{i} ---\n{body}")
+
+
+def key(stage):
+    rows, reads, refs = load(stage)
+    k = {row['ImageID']: {f'O{i}': c for i, c in enumerate(blind_order(row['ImageID']), 1)} for row in rows}
+    save(R86 / stage / 'blind_key_private.json', k)
+    print('saved', len(k))
+
+
+if __name__ == '__main__':
+    st = sys.argv[1]
+    if sys.argv[2] == 'key':
+        key(st)
+    elif ',' in sys.argv[2]:
+        show(st, 0, 0, [int(x) for x in sys.argv[2].split(',')])
+    else:
+        show(st, int(sys.argv[2]), int(sys.argv[3]))
