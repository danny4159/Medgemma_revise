+"""실제 자식 Python 두 개(기본 medgemma, CURE 격리 환경)의 캐시 경로·버전·GPU 가시성을 격리 환경 변수로 확인한다.
+설치·변경은 하지 않는다. 인증 값은 읽지 않는다(토큰 경로 상속 여부만 bool). 결과: results/iter_086/environment_state.json
+"""
+import json
+import subprocess
+import sys
+
+from report86_common import R86, ROOT, CURE_PY, isolated_env, save, sha
+
+CODE = r"""
+import json, os, sys
+from pathlib import Path
+import huggingface_hub.constants as c
+import torch, transformers
+root = Path(os.environ['HF_HOME']).resolve().parents[1] if False else None
+cache_root = Path(os.environ['XDG_CACHE_HOME']).resolve().parent
+paths = {'HF_HOME': c.HF_HOME, 'HF_HUB_CACHE': c.HF_HUB_CACHE, 'HF_XET_CACHE': c.HF_XET_CACHE,
+         'TORCH_HOME': os.environ['TORCH_HOME'], 'TMPDIR': os.environ['TMPDIR'], 'TRITON_CACHE_DIR': os.environ['TRITON_CACHE_DIR'],
+         'XDG_CACHE_HOME': os.environ['XDG_CACHE_HOME'], 'CUDA_CACHE_PATH': os.environ['CUDA_CACHE_PATH']}
+res = {'python': sys.executable, 'torch': torch.__version__, 'transformers': transformers.__version__,
+       'cuda_available': torch.cuda.is_available(), 'visible_devices': os.environ.get('CUDA_VISIBLE_DEVICES'),
+       'n_cuda_devices': torch.cuda.device_count(), 'paths': paths, 'cache_root': str(cache_root),
+       'all_under_cache_root': all(Path(v).resolve().is_relative_to(cache_root) for v in paths.values()),
+       'token_path_inherited': bool(os.environ.get('HF_TOKEN_PATH')), 'hf_hub_offline': os.environ.get('HF_HUB_OFFLINE')}
+for m in ['peft', 'bitsandbytes', 'accelerate', 'albumentations', 'timm']:
+    try:
+        res[m] = __import__(m).__version__
+    except Exception as e:
+        res[m] = 'absent:' + type(e).__name__
+print(json.dumps(res))
+"""
+
+
+def main():
+    env = isolated_env()
+    out = {}
+    for name, py in (('medgemma_default', sys.executable), ('cure085', str(CURE_PY))):
+        p = subprocess.run([py, '-c', CODE], cwd=ROOT, env=env, capture_output=True, text=True)
+        out[name] = json.loads(p.stdout.strip().splitlines()[-1]) if p.returncode == 0 else {'error': p.stderr[-500:]}
+    old = json.loads((ROOT / 'results/iter_085/environment_final.json').read_text())
+    out['iter_085_environment_final_json_torch_record'] = json.dumps(old)[:300]
+    out['reconciliation'] = ('environment_final.json의 오래된 torch 2.5.1 기록과 달리 실제 cure085 Python은 위 값을 보고한다. '
+                             '최종 D8 CURE/M1G 출력 protocol에는 2.7.1+cu126이 기록돼 있다. 재설치는 하지 않았다.')
+    out['d8_protocol_torch'] = {s: json.loads((ROOT / f'results/iter_085/D8/{d}/protocol.json').read_text()).get('torch')
+                                for s, d in {'M15': 'M15', 'B0': 'B0', 'M1': 'M1', 'M1G_official': 'M1G_official', 'C': 'C', 'M1G_failed': 'M1G'}.items()}
+    save(R86 / 'environment_state.json', out)
+    print(json.dumps(out, indent=1, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/report86_eval.py b/report86_eval.py
new file mode 100644
index 0000000..1867f41
--- /dev/null
+++ b/report86_eval.py
@@ -0,0 +1,212 @@
+"""iter_086 의미 판정표 평가기(CPU). 입력: 잠긴 reference 사실, 판독 산출물, 눈가림 key, 판정 파일(DSL).
+python report86_eval.py <stage> <judgments.txt> <out_dir>
+판정 DSL(semantic_protocol.md):  P### 줄 다음에  O#: F1=D+:"span" F2=U ... ; C=<d:F4,p:F4|-> ; I=<0|1> ; xd=<n> xp=<n>
+지표(환자 단위): 확정 recall(D/#pos_def), 엄격 recall(D이고 위치 표기 '-' 아님), possible 포함 recall, 모순 3성분,
+내부 모순, 추가 주장 수, 표현 정보. 주 비교는 환자 단위 paired bootstrap(10,000회, seed 84017).
+"""
+import json
+import re
+import sys
+from pathlib import Path
+
+import numpy as np
+
+from report86_common import R86, STAGES, R85, save, sha
+import report86_facts as F
+from report86_view import CONDS, blind_order, load as load_stage
+
+POS_CLASSES = ('pos_def', 'pos_hedged', 'pos_temporal', 'pos_ambiguous')
+COMPARISONS = [('B0-R', 'M15-R'), ('M15-S', 'M15-R'), ('B0-S', 'M15-S'), ('C-G', 'M1-G'), ('C-H', 'C-G')]
+SEED = 84017
+NBOOT = 10000
+FACT_RE = re.compile(r'F(\d+)=([DPNU])([+\-~]?)(?::"([^"]*)")?')
+
+
+class JudgmentError(ValueError):
+    pass
+
+
+def parse_judgments(text, rows, refs, subset=False):
+    """returns {ImageID: {condition: record}}. 형식·ID·완전성 위반은 JudgmentError."""
+    out, cur, seen_p = {}, None, set()
+    for ln_no, raw in enumerate(text.splitlines(), 1):
+        ln = raw.strip()
+        if not ln or ln.startswith('#'):
+            continue
+        m = re.fullmatch(r'P(\d{3})', ln)
+        if m:
+            idx = int(m.group(1))
+            if idx >= len(rows) or idx in seen_p:
+                raise JudgmentError(f'line {ln_no}: bad or duplicate patient {ln}')
+            seen_p.add(idx)
+            cur = rows[idx]['ImageID']
+            out[cur] = {}
+            order = blind_order(cur)
+            continue
+        m = re.match(r'O(\d):\s*(.*)', ln)
+        if not m or cur is None:
+            raise JudgmentError(f'line {ln_no}: cannot parse {ln[:60]}')
+        oi = int(m.group(1))
+        if not 1 <= oi <= 8:
+            raise JudgmentError(f'line {ln_no}: output id')
+        cond = order[oi - 1]
+        if cond in out[cur]:
+            raise JudgmentError(f'line {ln_no}: duplicate output {oi}')
+        parts = [p.strip() for p in re.split(r'\s;\s', m.group(2))]
+        if len(parts) != 4:
+            raise JudgmentError(f'line {ln_no}: expected 4 ;-separated sections, got {len(parts)}')
+        facts_txt, c_txt, i_txt, x_txt = parts
+        if facts_txt.strip() == '-':  # positive 사실이 없는 환자
+            facts_txt = ''
+        facts = {}
+        consumed = 0
+        for fm in FACT_RE.finditer(facts_txt):
+            fid = f'F{fm.group(1)}'
+            if fid in facts:
+                raise JudgmentError(f'line {ln_no}: duplicate {fid}')
+            suffix = fm.group(3)
+            if fm.group(2) in 'NU' and suffix:
+                raise JudgmentError(f'line {ln_no}: suffix on {fm.group(2)}')
+            if fm.group(2) in 'DPN' and not fm.group(4):
+                raise JudgmentError(f'line {ln_no}: {fid} needs an evidence span')
+            facts[fid] = {'s': fm.group(2), 'loc': suffix, 'span': fm.group(4)}
+            consumed += 1
+        if consumed != len(re.findall(r'F\d+=', facts_txt)):
+            raise JudgmentError(f'line {ln_no}: malformed fact token')
+        pos_ids = {x['fact_id'] for x in refs[cur]['facts'] if x['fact_class'] in POS_CLASSES}
+        if set(facts) != pos_ids:
+            raise JudgmentError(f'line {ln_no}: facts judged {sorted(facts)} != required {sorted(pos_ids)}')
+        neg_ids = {x['fact_id'] for x in refs[cur]['facts'] if x['fact_class'] == 'neg_specific'}
+        contra = []
+        if c_txt != 'C=-':
+            if not c_txt.startswith('C='):
+                raise JudgmentError(f'line {ln_no}: C section')
+            for it in c_txt[2:].split(','):
+                mm = re.fullmatch(r'([dp]):(F\d+)', it.strip())
+                if not mm or mm.group(2) not in neg_ids:
+                    raise JudgmentError(f'line {ln_no}: contradiction item {it} (must cite a neg_specific fact {sorted(neg_ids)})')
+                contra.append({'strength': mm.group(1), 'fact': mm.group(2)})
+        mi = re.fullmatch(r'I=([01])', i_txt)
+        mx = re.fullmatch(r'xd=(\d+) xp=(\d+)', x_txt)
+        if not mi or not mx:
+            raise JudgmentError(f'line {ln_no}: I/x section')
+        out[cur][cond] = {'facts': facts, 'contra': contra, 'internal': int(mi.group(1)), 'xd': int(mx.group(1)), 'xp': int(mx.group(2))}
+    if not subset and seen_p != set(range(len(rows))):
+        raise JudgmentError(f'patients judged {len(seen_p)} != {len(rows)}')
+    for img, d in out.items():
+        if set(d) != set(CONDS):
+            raise JudgmentError(f'{img}: outputs {sorted(d)}')
+    return out
+
+
+def per_output(img, cond, j, refs, reads):
+    facts = {x['fact_id']: x for x in refs[img]['facts']}
+    cls = lambda c: [fid for fid, x in facts.items() if x['fact_class'] == c]
+    pd = cls('pos_def')
+    n = len(pd)
+    st = {fid: j['facts'][fid] for fid in j['facts']}
+    D = sum(st[f]['s'] == 'D' for f in pd)
+    P = sum(st[f]['s'] == 'P' for f in pd)
+    N = sum(st[f]['s'] == 'N' for f in pd)
+    U = sum(st[f]['s'] == 'U' for f in pd)
+    Ds = sum(st[f]['s'] == 'D' and st[f]['loc'] in ('', '+') for f in pd)
+    Dwrong = sum(st[f]['s'] == 'D' and st[f]['loc'] == '-' for f in pd)
+    wide = [f for f in cls('pos_def') + cls('pos_hedged') + cls('pos_temporal')]
+    ca_d = sum(c['strength'] == 'd' for c in j['contra'])
+    ca_p = sum(c['strength'] == 'p' for c in j['contra'])
+    n_neg = len(cls('neg_specific'))
+    S = sum(st[f]['s'] in 'DP' for f in st)
+    cc = Dwrong
+    rec = reads[(img, cond)]
+    return {'n_pos_def': n, 'n_neg_specific': n_neg, 'D': D, 'P': P, 'N': N, 'U': U, 'D_strict': Ds, 'D_wrongloc': Dwrong,
+            'recall_def': D / n if n else None, 'recall_strict': Ds / n if n else None, 'recall_incl_possible': (D + P) / n if n else None,
+            'recall_wide_D': (sum(st[f]['s'] == 'D' for f in wide) / len(wide)) if wide else None,
+            'contra_a_def': ca_d, 'contra_a_poss': ca_p, 'contra_b_neg_of_positive': N, 'contra_c_wrong_loc': cc,
+            'contra_primary': (int(ca_d > 0 or N > 0 or cc > 0) if (n or n_neg) else None),
+            'contra_a_only': (int(ca_d > 0) if n_neg else None),
+            'internal': j['internal'], 'xd': j['xd'], 'xp': j['xp'],
+            'claims_supported': S, 'claims_contradicted': ca_d + ca_p + cc, 'claims_unverifiable': j['xd'] + j['xp'],
+            'n_tokens': rec['n_tokens'], 'final_non_eos': int(not all(rec['final_eos'])), 'n_requests': len(rec['request_ids']),
+            'n_attempts': rec['n_attempts']}
+
+
+def boot_ci(diffs, rng, nboot=NBOOT):
+    d = np.asarray(diffs, float)
+    idx = rng.integers(0, len(d), size=(nboot, len(d)))
+    m = d[idx].mean(axis=1)
+    return [float(np.percentile(m, 2.5)), float(np.percentile(m, 97.5))]
+
+
+def evaluate(stage, jtext, out_dir=None):
+    rows, reads, refs = load_stage(stage)
+    jud = parse_judgments(jtext, rows, refs)
+    strata = {r['ImageID']: r.get('stratum', 'D8') for r in rows}
+    per = {}
+    for img in jud:
+        for c in CONDS:
+            per[(img, c)] = per_output(img, c, jud[img][c], refs, reads)
+    metrics = ['recall_def', 'recall_strict', 'recall_incl_possible', 'recall_wide_D', 'contra_primary', 'contra_a_only', 'internal', 'xd', 'xp']
+    sets = {'all': list(strata)}
+    for s in sorted(set(strata.values())):
+        sets[s] = [i for i in strata if strata[i] == s]
+    rng = np.random.default_rng(SEED)
+    summary = {}
+    for sname, imgs in sets.items():
+        summary[sname] = {'n_patients': len(imgs), 'conditions': {}}
+        for c in CONDS:
+            sub = [per[(i, c)] for i in imgs]
+            agg = {}
+            for m in metrics:
+                vals = [x[m] for x in sub if x[m] is not None]
+                agg[m] = {'mean': float(np.mean(vals)) if vals else None, 'n': len(vals)}
+            S = sum(x['claims_supported'] for x in sub)
+            Cc = sum(x['claims_contradicted'] for x in sub)
+            V = sum(x['claims_unverifiable'] for x in sub)
+            agg['claims'] = {'supported': S, 'contradicted': Cc, 'unverifiable': V, 'precision_lower': S / (S + Cc + V) if S + Cc + V else None,
+                             'precision_upper': (S + V) / (S + Cc + V) if S + Cc + V else None, 'note': 'unverifiable를 전부 틀림/맞음으로 둔 범위; 임상 precision 아님'}
+            agg['status_counts_pos_def'] = {k: sum(x[k] for x in sub) for k in ('D', 'P', 'N', 'U', 'D_strict', 'D_wrongloc', 'n_pos_def')}
+            agg['contra_components_patients'] = {'a_def': sum(x['contra_a_def'] > 0 for x in sub), 'a_poss': sum(x['contra_a_poss'] > 0 for x in sub),
+                                                  'b_neg_of_positive': sum(x['contra_b_neg_of_positive'] > 0 for x in sub), 'c_wrong_loc': sum(x['contra_c_wrong_loc'] > 0 for x in sub)}
+            agg['final_non_eos_outputs'] = sum(x['final_non_eos'] for x in sub)
+            agg['tokens_mean'] = float(np.mean([x['n_tokens'] for x in sub]))
+            agg['requests_total'] = sum(x['n_requests'] for x in sub)
+            agg['attempts_total'] = sum(x['n_attempts'] for x in sub)
+            summary[sname]['conditions'][c] = agg
+    comps = {}
+    for sname, imgs in sets.items():
+        comps[sname] = {}
+        for a, b in COMPARISONS:
+            res = {}
+            for m in metrics:
+                pairs = [(per[(i, a)][m], per[(i, b)][m]) for i in imgs if per[(i, a)][m] is not None and per[(i, b)][m] is not None]
+                if not pairs:
+                    res[m] = None
+                    continue
+                d = [x - y for x, y in pairs]
+                res[m] = {'diff': float(np.mean(d)), 'ci95': boot_ci(d, rng) if len(d) > 1 else None, 'n': len(d)}
+            comps[sname][f'{a}-{b}'] = res
+    both = [i for i in strata if per[(i, 'M15-R')]['n_pos_def'] and per[(i, 'M15-R')]['n_neg_specific']]
+    result = {'stage': stage, 'summary': summary, 'comparisons': comps, 'bootstrap': {'n': NBOOT, 'seed': SEED, 'unit': 'patient (paired, within stratum set)'},
+              'operating_point_patients_with_pos_def_and_neg_specific': len(both),
+              'judgments_sha256': None, 'per_output': {f'{i}|{c}': v for (i, c), v in per.items()}}
+    return result
+
+
+def main():
+    stage, jpath, out = sys.argv[1], sys.argv[2], Path(sys.argv[3])
+    jtext = Path(jpath).read_text()
+    res = evaluate(stage, jtext)
+    res['judgments_sha256'] = sha(jpath)
+    res['inputs'] = {'readings_sha256': sha(R86 / stage / 'readings.jsonl'), 'blind_key_sha256': sha(R86 / stage / 'blind_key_private.json') if (R86 / stage / 'blind_key_private.json').exists() else None,
+                     'facts_rules_sha256': F.rules_sha(), 'eval_code_sha256': sha(__file__)}
+    out.mkdir(parents=True, exist_ok=True)
+    save(out / 'report.json', res)
+    s = res['summary']
+    for sname in s:
+        print(sname, s[sname]['n_patients'])
+        for c, a in s[sname]['conditions'].items():
+            print(f"  {c:6s} recall_def={a['recall_def']['mean']} strict={a['recall_strict']['mean']} contra={a['contra_primary']['mean']} internal={a['internal']['mean']:.2f} xd={a['xd']['mean']:.2f} xp={a['xp']['mean']:.2f} tok={a['tokens_mean']:.0f}")
+
+
+if __name__ == '__main__':
+    main()
diff --git a/report86_exposure.py b/report86_exposure.py
new file mode 100644
index 0000000..14e8553
--- /dev/null
+++ b/report86_exposure.py
@@ -0,0 +1,74 @@
+"""CURE 학습 노출 신호 점검(CPU): C-G(공식 GRG) 출력 문장이 reference 문장과 글자 그대로 일치하는 비율.
+원문 일치는 암기·학습 노출의 징후일 뿐 증명이 아니다. D8(PadChest-GR train split)과 E(validation split)를 비교한다.
+python report86_exposure.py <out.json>
+"""
+import glob
+import json
+import re
+import sys
+
+from report86_common import R86, R85, STAGES, save, read_jsonl_complete
+import report86_facts as F
+
+BBOX = re.compile(r"\s*\[\s*-?[\d.]+\s*,\s*-?[\d.]+\s*,\s*-?[\d.]+\s*,\s*-?[\d.]+\s*\]")
+
+
+def norm(s):
+    return re.sub(r'[^a-z0-9 ]', '', s.lower()).strip()
+
+
+def sentences(t):
+    t = BBOX.sub('. ', t)
+    return [norm(x) for x in re.split(r'(?<=[.])\s+|\.\s*$', t) if norm(x)]
+
+
+def stage_stats(stage):
+    rows = json.loads(STAGES[stage]['inputs'].read_text())
+    if stage == 'D8':
+        refs = {r['ImageID']: r['findings'] for r in json.loads((R85 / 'D8/reference_private.json').read_text())}
+        recs = {}
+        from report86_inherit import load_verified
+        recs.update({k: v for k, v in load_verified('C')[0].items() if k.endswith('|G')})
+        for p in glob.glob(str(R86 / 'D8/C/shard*/outputs.jsonl')):
+            recs.update({r['id']: r for r in read_jsonl_complete(p) if r['id'].endswith('|G')})
+    else:
+        refs = {k: v['findings_raw'] for k, v in json.loads((R86 / 'E/reference_facts_E_private.json').read_text()).items()}
+        recs = {}
+        for p in glob.glob(str(R86 / stage / 'C/shard*/outputs.jsonl')):
+            recs.update({r['id']: r for r in read_jsonl_complete(p) if r['id'].endswith('|G')})
+    per = []
+    for row in rows:
+        k = row['ImageID'] + '|C|G'
+        if k not in recs:
+            continue
+        out_s = sentences(recs[k]['text'])
+        ref_abn = [norm(f['sentence_en']) for f in refs[row['ImageID']] if f.get('abnormal')]
+        ref_all = [norm(f['sentence_en']) for f in refs[row['ImageID']]]
+        hit_abn = sum(any(r == o for o in out_s) for r in ref_abn)
+        hit_all = sum(any(r == o for o in out_s) for r in ref_all)
+        match_out = sum(o in ref_all for o in out_s)
+        per.append({'ImageID': row['ImageID'], 'stratum': row.get('stratum', 'D8'), 'n_ref_abn': len(ref_abn), 'abn_exact': hit_abn,
+                    'n_ref_all': len(ref_all), 'all_exact': hit_all, 'n_out_sent': len(out_s), 'out_exact_in_ref': match_out})
+    return per
+
+
+def summarize(per):
+    out = {}
+    for name, sub in [('all', per)] + [(s, [p for p in per if p['stratum'] == s]) for s in sorted({p['stratum'] for p in per})]:
+        if not sub:
+            continue
+        ra = sum(p['n_ref_abn'] for p in sub)
+        out[name] = {'n_patients': len(sub), 'ref_abnormal_sentences': ra, 'ref_abnormal_exact_reproduced': sum(p['abn_exact'] for p in sub),
+                     'frac_ref_abnormal_exact': sum(p['abn_exact'] for p in sub) / ra if ra else None,
+                     'out_sentences': sum(p['n_out_sent'] for p in sub), 'out_sentences_exact_in_ref': sum(p['out_exact_in_ref'] for p in sub),
+                     'frac_out_exact_in_ref': sum(p['out_exact_in_ref'] for p in sub) / max(1, sum(p['n_out_sent'] for p in sub))}
+    return out
+
+
+if __name__ == '__main__':
+    res = {}
+    for stage in ('D8', 'E96'):
+        per = stage_stats(stage)
+        res[stage] = {'summary': summarize(per), 'per_patient': per}
+    save(sys.argv[1], res)
+    print(json.dumps({s: v['summary'] for s, v in res.items()}, indent=1))
diff --git a/report86_facts.py b/report86_facts.py
new file mode 100644
index 0000000..7447e20
--- /dev/null
+++ b/report86_facts.py
@@ -0,0 +1,81 @@
+"""PadChest-GR reference 문장 -> 평가 사실 분류(CPU, 모델 출력을 보지 않음). E 생성 전에 규칙과 수동 override를 hash로 잠근다.
+
+fact class:
+  pos_def        abnormal==True, 시간 변화 표현·불확실 표현·부정문이 아닌 현재 양성 소견 (주 recall 분모)
+  pos_hedged     reference 자체가 probable/likely/suggestive 등 (민감도 분석에서만 recall 분모)
+  pos_temporal   progression 필드 또는 시간 비교 표현이 있는 양성 소견 (현재 존재는 암시되나 주분석 제외, 민감도에 포함)
+  pos_ambiguous  경계 사례(정상 상한 등)로 사람이 표시한 사실 (모든 분모 제외, 기록만)
+  excluded       abnormal 표기와 문장 내용이 모순되거나 부재·해결 문장 (현재 양성 사실로 쓰지 않음)
+  neg_specific   명시적·특정 소견의 부정(예: no pleural effusion) -> 모순 판정의 근거
+  generic_normal 'no relevant findings' 등 범위 불명확한 정상/메타 문구 (질환별 음성으로 확장하지 않음)
+  neg_scoped     '나머지에서'처럼 범위가 한정된 부정 (모순 근거로 쓰지 않음)
+"""
+import hashlib
+import json
+import re
+
+from report86_common import ROOT, sha
+
+NEG_START = re.compile(r"^\s*(no\b|there is no\b|without\b|not\b|i do not\b|rest\b|no other)", re.I)
+NEG_ANY = re.compile(r"\b(no|not|without|free|clear|absence|absent|do not|does not|don't)\b", re.I)
+HEDGE = re.compile(r"\b(probable|probably|likely|suggest\w*|compatible|possible|possibly|suspicio\w*|suspect\w*|may|could|might|perhaps|appear\w* to|rule out)\b", re.I)
+# pg39의 TEMPORAL_RE는 QA 적격성용으로 'changes'·'increased'(크기 표현)까지 잡아 과도하다. 판독 사실에는 명시적 비교 표현만 쓴다.
+TEMPORAL = re.compile(
+    r"\b(unchanged|previous\w*|prior|compar\w*|new|resolv\w*|stable|worsen\w*|improv\w*|persist\w*|progress\w*|interval|again|"
+    r"remain\w*|since|follow-?up|reduc\w*|ago|evolution|evolv\w*|decreas\w*|no (significant |major )?changes?|has increased|have increased|"
+    r"increase in size|increased in size)\b", re.I)
+ORIGIN_HEDGE = re.compile(r"\b(of|with)\s+(probable|possible)\s+\w+\s+(origin|etiology|aetiology|character)\b", re.I)
+LIMIT_OF_NORMAL = re.compile(r"limit of normal", re.I)
+SPECIFIC_NEG_TERMS = re.compile(r"(consolidat|infiltrat|effusion|nodul|mass|fractur|tubercul|condensation|opacit|sinus|angle|pneumothorax|pneumonia)", re.I)
+SCOPED = re.compile(r"\b(rest of|remaining|other)\b", re.I)
+
+# 사람이 reference 문장을 읽고 지정한 override: (ImageID 앞 8자, 문장 index) -> (class, 이유). 모델 출력 확인 전에 작성한다.
+OVERRIDES = {}
+
+
+def classify(f):
+    s = f['sentence_en'].strip()
+    abn = f.get('abnormal') is True
+    prog = f.get('progression')
+    if abn:
+        if prog == 'resolved':
+            return 'excluded', 'progression resolved (현재 부재)'
+        if NEG_START.search(s) or re.search(r"\b(not appreciated|not mentioned|without (radiological )?alterations|without appreciating)\b", s, re.I):
+            if SPECIFIC_NEG_TERMS.search(s) and re.search(r"without appreciating", s, re.I):
+                return 'neg_specific', 'abnormal 표기가 있으나 특정 소견의 명시적 부정문'
+            return 'excluded', 'abnormal 표기와 부정문 불일치'
+        if prog is not None or TEMPORAL.search(s):
+            return 'pos_temporal', 'progression/시간 표현'
+        if LIMIT_OF_NORMAL.search(s):
+            return 'pos_ambiguous', '정상 상한 경계 표현'
+        if HEDGE.search(ORIGIN_HEDGE.sub('', s)):
+            return 'pos_hedged', 'reference 불확실 표현'
+        return 'pos_def', ''
+    if NEG_ANY.search(s) and SPECIFIC_NEG_TERMS.search(s):
+        if re.search(r"\b(rest of the study)\b", s, re.I):
+            return 'neg_scoped', '범위 한정(나머지)'
+        return 'neg_specific', ''
+    return 'generic_normal', ''
+
+
+def facts_for(cand):
+    """cand: {ImageID, findings}. returns list of facts with stable ids F1.. in sentence order."""
+    out = []
+    for idx, f in enumerate(cand['findings']):
+        cls, why = classify(f)
+        ov = OVERRIDES.get((cand['ImageID'][:8], idx))
+        if ov:
+            cls, why = ov
+        out.append({'fact_id': f'F{idx + 1}', 'sentence_idx': idx, 'sentence_en': f['sentence_en'], 'sentence_es': f.get('sentence_es'),
+                    'abnormal_flag': f.get('abnormal'), 'labels': f.get('labels') or [], 'locations': f.get('locations') or [],
+                    'progression': f.get('progression'), 'n_boxes': len(f.get('boxes') or []), 'fact_class': cls, 'class_reason': why,
+                    'override': bool(ov)})
+    return out
+
+
+def eligible_abnormal(facts):
+    return any(x['fact_class'] == 'pos_def' for x in facts)
+
+
+def rules_sha():
+    return sha(__file__)
diff --git a/report86_facts_show.py b/report86_facts_show.py
new file mode 100644
index 0000000..bb2edbf
--- /dev/null
+++ b/report86_facts_show.py
@@ -0,0 +1,26 @@
+"""분류 결과 점검용 출력(자료 점검, CPU). python report86_facts_show.py <abnormal|no_abnormal> <start> <end> [only_nondef]"""
+import json
+import sys
+from collections import Counter
+
+from report86_common import R86
+import report86_facts as F
+
+d = json.loads((R86 / 'E/enumeration.json').read_text())['ordered_candidates']
+which, a, b = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
+only = len(sys.argv) > 4
+sel = [c for c in d if c['has_abnormal_flag'] == (which == 'abnormal')]
+cnt = Counter()
+elig = 0
+for i, c in enumerate(sel):
+    fx = F.facts_for(c)
+    ok = F.eligible_abnormal(fx)
+    elig += ok
+    for x in fx:
+        cnt[x['fact_class']] += 1
+    if a <= i < b:
+        for x in fx:
+            if only and x['fact_class'] in ('pos_def', 'generic_normal'):
+                continue
+            print(f"#{i} {c['ImageID'][:8]} {x['fact_id']} {x['fact_class']:14s} {x['sentence_en'][:100]} | {x['class_reason']}")
+print('class counts', dict(cnt), 'eligible_abnormal', elig, 'of', len(sel))
diff --git a/report86_gen.py b/report86_gen.py
new file mode 100644
index 0000000..cead628
--- /dev/null
+++ b/report86_gen.py
@@ -0,0 +1,248 @@
+"""iter_086 생성 runner (D8/E96/E192x). report85_d8.py의 모델 로딩·입력·생성 경로를 유지한다.
+
+변경점: 새 결과 경로, 검증된 계승 manifest, 과학적 protocol(모델 로딩 전 대조)과 execution 기록의 분리,
+shard 분할, 계승 행 회귀 비교(--regress N). 모델·prompt·변환·정밀도·adapter·seed·cap은 report85_d8과 동일하다.
+"""
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+from report86_common import (ROOT, UP, R85, R86, STAGES, SYSTEMS, SEED, CAPS, B0_DIGEST, sha, sha_obj, save,
+                             read_jsonl_complete, record_digest, scientific_protocol, expected_ids, prompts_for,
+                             base_path, adapter_path_C)
+
+EXEC_SOURCES = ['report86_gen.py', 'report86_common.py', 'rsna_diag/generate.py', 'rsna_diag/lora.py', 'rsna_diag/geometry.py']
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--stage', choices=list(STAGES), required=True)
+    p.add_argument('--system', choices=SYSTEMS, required=True)
+    p.add_argument('--gpu', required=True)
+    p.add_argument('--out', required=True)
+    p.add_argument('--shard', type=int, default=0)
+    p.add_argument('--nshards', type=int, default=1)
+    p.add_argument('--resume', action='store_true')
+    p.add_argument('--regress', type=int, default=0, help='계승 행 N개를 새 경로로 재생성해 token을 비교(출력은 --out, stage 출력 아님)')
+    p.add_argument('--limit', type=int, default=0, help='이번 실행에서 저장할 최대 요청 수(통제된 중단 시험용)')
+    p.add_argument('--regress-offset', type=int, default=0)
+    a = p.parse_args()
+    out = Path(a.out).resolve()
+    out.relative_to(R86)
+    assert 0 <= a.shard < a.nshards
+    # ---- 모델 로딩 전: 입력·protocol·계승·소유권 검사 ----
+    allowed = os.environ['CUDA_VISIBLE_DEVICES'].split(',')
+    assert a.gpu in allowed, f'gpu {a.gpu} not in inherited CUDA_VISIBLE_DEVICES {allowed}'
+    os.environ['CUDA_VISIBLE_DEVICES'] = a.gpu
+    os.environ['TOKENIZERS_PARALLELISM'] = 'false'
+    os.environ['HF_HUB_OFFLINE'] = '1'
+    st = STAGES[a.stage]
+    all_rows = json.loads(st['inputs'].read_text())
+    for row in all_rows:
+        assert sha(row['image']) == row['file_sha256'], f"input image changed {row['ImageID']}"
+    raw = {r['ImageID']: r for r in json.loads(st['raw'].read_text())}
+    sci = scientific_protocol(a.system, a.stage)
+    sci_digest = sha_obj(sci)
+    inherited, inh_meta = {}, None
+    if a.stage == 'D8':
+        from report86_inherit import load_verified
+        inherited, inh_meta = load_verified(a.system)
+        assert inh_meta['protocol_sha256'] and not inh_meta['scientific_differences']
+    out.mkdir(parents=True, exist_ok=a.resume)
+    lock = (out / 'worker.lock').open('a')
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    from pg43_run import repair_tail
+    repair_tail(str(out / 'outputs.jsonl'))
+    mypath = out / 'scientific_protocol.json'
+    meta = {'scientific': sci, 'scientific_digest': sci_digest, 'stage': a.stage, 'shard': a.shard, 'nshards': a.nshards,
+            'mode': 'regress' if a.regress else 'generate'}
+    if mypath.exists():
+        assert a.resume, 'output dir already has a protocol; use --resume'
+        old = json.loads(mypath.read_text())
+        assert old == json.loads(json.dumps(meta)), 'resume: scientific protocol/shard/mode mismatch (detected before model load)'
+    else:
+        save(mypath, meta)
+    # 이 shard의 대상 행
+    rows = [r for i, r in enumerate(all_rows) if i % a.nshards == a.shard]
+    exp_shard = expected_ids(rows, a.system)
+    if a.regress:
+        pool = sorted(inherited, key=lambda i: sha_obj(['regress86', i]))[a.regress_offset:a.regress_offset + a.regress]
+        assert len(pool) == a.regress
+        target_ids = set(pool)
+    else:
+        target_ids = exp_shard
+    # 이미 완료된 id: 계승(검증됨) + 같은 stage·system의 모든 shard 디렉터리 출력(자신 포함)
+    sibling = []
+    if not a.regress:
+        sibling_root = out.parent
+        for d in sibling_root.glob('shard*'):
+            if d.resolve() != out and (d / 'outputs.jsonl').exists():
+                sibling += read_jsonl_complete(d / 'outputs.jsonl')
+    mine = read_jsonl_complete(out / 'outputs.jsonl')
+    for rec in mine:
+        assert rec['id'] in target_ids and rec['protocol_digest'] == sci_digest and rec['record_digest'] == record_digest(rec), 'own record invalid'
+    assert len(mine) == len({r['id'] for r in mine}), 'duplicate in own output'
+    done = {r['id'] for r in mine}
+    if not a.regress:
+        done |= set(inherited) | {r['id'] for r in sibling}
+    todo_ids = sorted(target_ids - done)
+    if a.limit:
+        todo_ids = todo_ids[:a.limit]
+    execution = {'event': 'start', 'time': time.time(), 'pid': os.getpid(), 'gpu_physical': a.gpu, 'python': sys.executable,
+                 'source_sha256': {f: sha(ROOT / f) for f in EXEC_SOURCES}, 'n_todo': len(todo_ids), 'n_inherited_skipped': len(set(inherited) & target_ids),
+                 'cuda_visible_devices_set': os.environ['CUDA_VISIBLE_DEVICES'],
+                 'cache_env': {k: os.environ.get(k) for k in ['HF_HOME', 'HF_HUB_CACHE', 'HF_XET_CACHE', 'TORCH_HOME', 'TMPDIR']}}
+    if not todo_ids:
+        with (out / 'executions.jsonl').open('a') as f:
+            f.write(json.dumps({**execution, 'event': 'nothing_to_do'}) + '\n')
+        print(json.dumps({'nothing_to_do': True, 'stage': a.stage, 'system': a.system, 'shard': a.shard}))
+        finish(out, a, sci_digest, target_ids, regress=a.regress, inherited=inherited)
+        return
+    import numpy as np
+    import torch
+    from transformers import AutoProcessor, AutoModelForImageTextToText, BitsAndBytesConfig
+    from rsna_diag import generate as G, lora
+    torch.set_num_threads(4)
+    torch.manual_seed(SEED)
+    is15 = a.system in ['M15', 'B0']
+    base = base_path(a.system)
+    processor = AutoProcessor.from_pretrained(base, local_files_only=True)
+    processor.tokenizer.padding_side = 'left'
+    if is15:
+        processor.image_processor.do_pan_and_scan = False
+    kw = dict(torch_dtype=torch.bfloat16, device_map={'': 0}, local_files_only=True, attn_implementation='sdpa')
+    if a.system in ['M1G', 'C']:
+        kw['quantization_config'] = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_use_double_quant=True,
+            bnb_4bit_quant_type='nf4', bnb_4bit_compute_dtype=torch.bfloat16, bnb_4bit_quant_storage=torch.bfloat16)
+    t0 = time.monotonic()
+    model = AutoModelForImageTextToText.from_pretrained(base, **kw)
+    adapter_digest = None
+    if a.system == 'B0':
+        blob = torch.load(ROOT / 'results/iter_012/train/lr2e-4_s17/epoch_05/adapter.pt', map_location='cpu', weights_only=True)
+        cfg = blob['config']
+        lora.apply_lora(model, cfg['r'], cfg['alpha'], 0.)
+        own = {n: v for n, v in model.named_parameters() if 'lora_' in n}
+        assert set(own) == set(blob['state'])
+        assert all(own[n].shape == v.shape for n, v in blob['state'].items())
+        lora.load_lora_state(model, blob['state'])
+        adapter_digest = lora.state_digest(lora.lora_state_dict(model))
+        assert adapter_digest == B0_DIGEST
+    elif a.system == 'C':
+        from peft import PeftModel
+        ap = adapter_path_C()
+        model = PeftModel.from_pretrained(model, str(ap), local_files_only=True)
+        assert set(model.peft_config['default'].modules_to_save) == {'lm_head', 'embed_tokens'}
+        adapter_digest = sha(ap / 'adapter_model.safetensors')
+    assert adapter_digest == sci['adapter_digest'], 'adapter digest differs from pre-load protocol'
+    model.eval()
+    assert not any(m.training for m in model.modules())
+    loading_s = time.monotonic() - t0
+    transform = None
+    if a.system in ['M1G', 'C']:
+        sys.path.insert(0, str(R85 / 'official/minimal'))
+        from vlm_research_kit.data.transforms_factory import create_image_transforms
+        transform = create_image_transforms(use_model_specific_transforms=True, model_name='pil_with_augmentations',
+            bbox_format='cxcywh', image_size=[448, 448], is_train=False,
+            augmenter_override_params={'apply_clahe': True, 'clahe_clip_limit': [3., 3.]})
+    prompts = dict(prompts_for(a.system))
+    eos = model.generation_config.eos_token_id
+    eos = [eos] if isinstance(eos, int) else eos
+    execution.update({'torch': torch.__version__, 'loading_s': loading_s})
+    events = (out / 'executions.jsonl').open('a', buffering=1)
+    events.write(json.dumps(execution) + '\n')
+    row_by_img = {r['ImageID']: r for r in all_rows}
+    by_img = {}
+    for rid in todo_ids:
+        img, _, name = rid.split('|')
+        by_img.setdefault(img, []).append(name)
+    saved = 0
+    t_start = time.monotonic()
+    with (out / 'outputs.jsonl').open('a', buffering=1) as f:
+        for img in [r['ImageID'] for r in rows if r['ImageID'] in by_img] if not a.regress else sorted(by_img):
+            row = row_by_img[img]
+            assert sha(row['image']) == row['file_sha256']
+            if transform:
+                rr = raw[img]
+                assert sha(rr['raw_path']) == rr['sha256']
+                im = transform(rr['raw_path'])['pixel_values']
+                assert np.array_equal(np.asarray(im), np.asarray(transform(rr['raw_path'])['pixel_values']))
+            else:
+                im, _, _ = G.load_image(row['image'])
+            for name in prompts_for_order(a.system, by_img[img]):
+                prompt = prompts[name]
+                rid = img + '|' + a.system + '|' + name
+                events.write(json.dumps({'event': 'request_start', 'id': rid, 'time': time.time()}) + '\n')
+                inp = G.build_inputs(processor, im, prompt)
+                official = processor.apply_chat_template([{'role': 'user', 'content': [{'type': 'image', 'image': im}, {'type': 'text', 'text': prompt}]}],
+                    add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors='pt', padding=True)
+                assert set(inp) == set(official) and all(torch.equal(inp[k], official[k]) for k in inp)
+                attempts = []
+                for cap in CAPS:
+                    result = G.generate(torch, processor, model, inp, cap, eos)
+                    attempts.append(result)
+                    if result['ended_eos']:
+                        break
+                rec = {'id': rid, 'ImageID': img, 'condition': name, 'protocol_digest': sci_digest,
+                       'image_sha256': row['file_sha256'], 'text': processor.decode(result['suffix_ids'], skip_special_tokens=True),
+                       'attempts': attempts, 'input_ids': inp['input_ids'][0].tolist(),
+                       'pixel_sha256': hashlib.sha256(np.asarray(im).tobytes()).hexdigest(),
+                       'exec': {'gpu': a.gpu, 'shard': a.shard, 'pid': os.getpid(), 'torch': torch.__version__}}
+                rec['record_digest'] = record_digest(rec)
+                f.write(json.dumps(rec, ensure_ascii=False) + '\n')
+                f.flush()
+                os.fsync(f.fileno())
+                saved += 1
+                events.write(json.dumps({'event': 'request_saved', 'id': rid, 'time': time.time(), 'seconds': result['runtime_s'],
+                                         'n_new': result['n_new'], 'attempts': len(attempts)}) + '\n')
+                print(json.dumps({'saved': saved, 'of': len(todo_ids), 'system': a.system, 'shard': a.shard, 'tokens': result['n_new'],
+                                  'seconds': round(result['runtime_s'], 2)}), flush=True)
+    events.write(json.dumps({'event': 'end', 'time': time.time(), 'saved': saved, 'wall_s': time.monotonic() - t_start,
+                             'peak_reserved_gib_max': max(max(a_['peak_mem_reserved_gb'] for a_ in r['attempts']) for r in read_jsonl_complete(out / 'outputs.jsonl'))}) + '\n')
+    events.close()
+    finish(out, a, sci_digest, target_ids, regress=a.regress, inherited=inherited)
+
+
+def prompts_for_order(system, names):
+    order = [n for n, _ in prompts_for(system)]
+    return [n for n in order if n in set(names)]
+
+
+def finish(out, a, sci_digest, target_ids, regress, inherited):
+    recs = read_jsonl_complete(out / 'outputs.jsonl')
+    got = {r['id'] for r in recs}
+    if regress:
+        diffs = []
+        for r in recs:
+            old = inherited[r['id']]
+            same = r['attempts'][-1]['suffix_ids'] == old['attempts'][-1]['suffix_ids'] and r['input_ids'] == old['input_ids'] \
+                and r['pixel_sha256'] == old['pixel_sha256']
+            diffs.append({'id': r['id'], 'tokens_equal': r['attempts'][-1]['suffix_ids'] == old['attempts'][-1]['suffix_ids'],
+                          'input_ids_equal': r['input_ids'] == old['input_ids'], 'pixel_equal': r['pixel_sha256'] == old['pixel_sha256'],
+                          'n_new_old': old['attempts'][-1]['n_new'], 'n_new_new': r['attempts'][-1]['n_new'],
+                          'old_gpu_seconds': sum(x['runtime_s'] for x in old['attempts']), 'new_seconds': sum(x['runtime_s'] for x in r['attempts']), 'equal': same})
+        res = {'n': len(recs), 'n_equal': sum(d['equal'] for d in diffs), 'complete': got == target_ids, 'items': diffs,
+               'exec': recs[0]['exec'] if recs else None}
+        rp = out / f'regress_result_{int(time.time())}.json'
+        save(rp, res)
+        print(json.dumps({'regress_equal': res['n_equal'], 'of': res['n'], 'result': str(rp)}))
+        return
+    complete = target_ids <= (got | set(inherited))
+    cp = out / 'completion.json'
+    if complete and not cp.exists():
+        events = read_jsonl_complete(out / 'executions.jsonl') if False else [json.loads(l) for l in (out / 'executions.jsonl').read_text().splitlines() if l]
+        save(cp, {'stage': a.stage, 'system': a.system, 'shard': a.shard, 'nshards': a.nshards, 'n_own_records': len(recs),
+                  'n_inherited_in_shard_scope': len(set(inherited) & target_ids), 'n_expected_in_shard': len(target_ids),
+                  'files': {'scientific_protocol.json': sha(out / 'scientific_protocol.json'), 'outputs.jsonl': sha(out / 'outputs.jsonl')},
+                  'final_not_eos': sum(not r['attempts'][-1]['ended_eos'] for r in recs),
+                  'executions': len([e for e in events if e['event'] == 'start']),
+                  'generation_s_total': sum(sum(x['runtime_s'] for x in r['attempts']) for r in recs),
+                  'cost_scope': 'generation seconds of records in this shard dir; loading/interrupted cost in executions.jsonl'})
+
+
+if __name__ == '__main__':
+    main()
diff --git a/report86_inherit.py b/report86_inherit.py
new file mode 100644
index 0000000..2161861
--- /dev/null
+++ b/report86_inherit.py
@@ -0,0 +1,131 @@
+"""iter_085 D8 부분 출력의 계승 검증. 원본 파일·protocol은 수정하지 않고 iter_086에 manifest만 만든다.
+
+- 구버전(record_digest 없음): protocol 과학적 설정 일치 + completion.json의 파일 봉인(hash) 일치가 있을 때만 수용.
+- 신버전(record_digest 있음): 행별 digest 재계산 + protocol 일치. completion이 없으면 '부분 결과'로만 수용.
+- 근거 부족·불일치 행은 삭제하지 않고 quarantined로 기록하며 새로 생성한다.
+python report86_inherit.py build   # inheritance_manifest.json 작성(이미 있으면 거부)
+python report86_inherit.py verify  # 현재 원본 파일이 manifest와 같은지 재확인
+"""
+import json
+import sys
+import time
+from pathlib import Path
+
+from report86_common import (R85, R86, SYSTEMS, sha, sha_obj, save, read_jsonl_complete, record_digest,
+                             scientific_protocol, expected_ids)
+
+SOURCES = {'M15': R85 / 'D8/M15', 'B0': R85 / 'D8/B0', 'M1': R85 / 'D8/M1', 'M1G': R85 / 'D8/M1G_official', 'C': R85 / 'D8/C'}
+SCI_KEYS = ['system', 'base', 'adapter_digest', 'seed', 'caps', 'prompts', 'input_sha256', 'raw_sha256']
+EXEC_KEYS = ['gpu', 'logical_gpu', 'python', 'torch']
+MANIFEST = R86 / 'inheritance_manifest.json'
+
+
+def verify_source(system, d, rows_in):
+    """returns dict with accepted ids / quarantined / provenance. 원본 파일은 읽기만 한다."""
+    out = {'system': system, 'dir': str(d), 'accepted_ids': [], 'quarantined': [], 'problems': []}
+    proto_p = d / 'protocol.json'
+    old = json.loads(proto_p.read_text())
+    new = scientific_protocol(system, 'D8')
+    sci_diff = {k: {'old': old.get(k), 'new': new[k]} for k in SCI_KEYS if json.loads(json.dumps(old.get(k))) != json.loads(json.dumps(new[k]))}
+    out['protocol_sha256'] = sha(proto_p)
+    out['scientific_differences'] = sci_diff
+    out['execution_old'] = {k: old.get(k) for k in EXEC_KEYS}
+    out['source_sha256_old'] = old.get('source_sha256')
+    out['outputs_sha256'] = sha(d / 'outputs.jsonl')
+    out['outputs_bytes'] = (d / 'outputs.jsonl').stat().st_size
+    if sci_diff:
+        out['problems'].append('scientific protocol differs: ' + ','.join(sci_diff))
+    recs = read_jsonl_complete(d / 'outputs.jsonl')
+    ids = [r['id'] for r in recs]
+    out['n_rows'] = len(recs)
+    if len(ids) != len(set(ids)):
+        out['problems'].append('duplicate ids')
+    exp = expected_ids(rows_in, system)
+    img_sha = {r['ImageID']: r['file_sha256'] for r in rows_in}
+    comp_p = d / 'completion.json'
+    seal_ok = None
+    if comp_p.exists():
+        comp = json.loads(comp_p.read_text())
+        seal_ok = all(sha(d / n) == h for n, h in comp['files'].items())
+        out['completion_sha256'] = sha(comp_p)
+        out['completion_files_match'] = seal_ok
+        out['completion_experiment_complete_flag'] = comp.get('experiment_complete')
+    has_digest = [('record_digest' in r) for r in recs]
+    out['record_digest_present'] = sum(has_digest)
+    for r in recs:
+        why = []
+        if r['id'] not in exp:
+            why.append('id not in expected set')
+        if r.get('image_sha256') != img_sha.get(r.get('ImageID')):
+            why.append('image sha mismatch')
+        if r.get('protocol_digest') != out['protocol_sha256']:
+            why.append('protocol digest mismatch')
+        if not r['attempts'][-1]['ended_eos']:
+            why.append('last attempt not EOS (kept? no: quarantined for regeneration)')
+        if 'record_digest' in r:
+            if r['record_digest'] != record_digest(r):
+                why.append('record digest mismatch')
+            method = 'record_digest'
+        else:
+            if not seal_ok:
+                why.append('legacy row without record_digest and no matching completion file seal')
+            method = 'legacy_file_seal'
+        if sci_diff:
+            why.append('scientific protocol differs')
+        if why:
+            out['quarantined'].append({'id': r['id'], 'reasons': why})
+        else:
+            out['accepted_ids'].append(r['id'])
+            out.setdefault('methods', {})[method] = out.setdefault('methods', {}).get(method, 0) + 1
+    out['partial_without_completion'] = not comp_p.exists()
+    return out
+
+
+def build():
+    if MANIFEST.exists():
+        sys.exit('inheritance_manifest.json exists; use a new attempt path')
+    from report86_common import STAGES
+    rows_in = json.loads(STAGES['D8']['inputs'].read_text())
+    res = {'created': time.time(), 'stage': 'D8', 'input_sha256': sha(STAGES['D8']['inputs']),
+           'rule': 'accepted only with protocol-scientific equality + (row digest | completion file seal); originals never modified',
+           'systems': {s: verify_source(s, d, rows_in) for s, d in SOURCES.items()}}
+    res['n_accepted'] = sum(len(v['accepted_ids']) for v in res['systems'].values())
+    res['n_quarantined'] = sum(len(v['quarantined']) for v in res['systems'].values())
+    res['reference_files'] = {
+        'iter_085_handoff_final': sha(R85 / 'handoff_final.json'),
+        'iter_085_plan': sha(Path('/SSD1_1TB/home/milab/daniel/08_medgemma/agent/runs/iter_085/plan.md'))}
+    save(MANIFEST, res)
+    print(json.dumps({s: {'n': v['n_rows'], 'accepted': len(v['accepted_ids']), 'quarantined': len(v['quarantined']),
+                          'methods': v.get('methods'), 'problems': v['problems'], 'complete_seal': v.get('completion_files_match')}
+                      for s, v in res['systems'].items()}, indent=1, ensure_ascii=False))
+
+
+def load_verified(system):
+    """원본 파일이 manifest 작성 시점과 같을 때만 수용된 행을 {id: record}로 돌려준다. 다르면 예외."""
+    m = json.loads(MANIFEST.read_text())
+    v = m['systems'][system]
+    d = Path(v['dir'])
+    # 원본이 이후 커지면(다른 프로세스 추가 기록) 앞 outputs_bytes까지의 prefix만 신뢰한다.
+    data = (d / 'outputs.jsonl').read_bytes()[:v['outputs_bytes']]
+    import hashlib
+    if hashlib.sha256(data).hexdigest() != v['outputs_sha256']:
+        raise RuntimeError(f'{system}: inherited outputs prefix hash mismatch')
+    acc = set(v['accepted_ids'])
+    recs = {}
+    for ln in data.split(b'\n')[:-1]:
+        if ln.strip():
+            r = json.loads(ln)
+            if r['id'] in acc:
+                recs[r['id']] = r
+    assert set(recs) == acc
+    return recs, v
+
+
+def verify():
+    for s in SYSTEMS:
+        recs, v = load_verified(s)
+        print(s, len(recs), 'ok')
+
+
+if __name__ == '__main__':
+    {'build': build, 'verify': verify}[sys.argv[1]]()
diff --git a/report86_launch.py b/report86_launch.py
new file mode 100644
index 0000000..24cd878
--- /dev/null
+++ b/report86_launch.py
@@ -0,0 +1,88 @@
+"""iter_086 병렬 실행기. worker 수와 GPU 수를 분리해 같은 허용 GPU에 여러 worker를 배치한다.
+
+plan.json: {"name": ..., "jobs": [{"stage","system","shard","nshards","gpu","out", "resume":bool, "extra":[...]}]}
+- 시작 직전 nvidia-smi 여유(다른 프로세스 포함)가 (추정 peak + worker당 2 GiB)를 만족해야 시작한다. 같은 GPU에 이미 이번
+  launcher가 띄운 worker는 아직 메모리가 올라오지 않았을 수 있으므로 그 worker의 예상 peak를 선점치로 합산한다.
+- 자식 환경은 results/iter_086/runtime_cache로 격리하며 system에 맞는 Python을 사용한다. 종료 코드를 수집해 기록한다.
+- 실패한 worker가 있어도 다른 worker를 임의로 죽이지 않는다(각 shard는 독립 재개 가능).
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+from report86_common import ROOT, R86, CURE_PY, isolated_env, save, sha
+
+# worker 1개의 nvidia-smi 실측 점유(MiB). C·M1G는 iter_086 D8 처리량 시험(resource.jsonl)에서 실측했다.
+# M15/B0/M1은 iter_085 reserved peak 8.3-8.4 GiB + CUDA context 추정치이며 E 실행의 resource log로 확인한다.
+PEAK_MIB = {'M15': 9000, 'B0': 9100, 'M1': 9000, 'M1G': 4700, 'C': 10100}
+MARGIN_MIB = 2048
+
+
+def smi():
+    q = subprocess.check_output(['nvidia-smi', '--query-gpu=index,memory.used,memory.total', '--format=csv,noheader,nounits'], text=True)
+    return {x.split(',')[0].strip(): (int(x.split(',')[1]), int(x.split(',')[2])) for x in q.splitlines()}
+
+
+def need_mib(system):
+    return PEAK_MIB[system] + MARGIN_MIB
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--plan', required=True)
+    ap.add_argument('--stagger', type=float, default=25.0)
+    a = ap.parse_args()
+    plan = json.loads(Path(a.plan).read_text())
+    allowed = os.environ['CUDA_VISIBLE_DEVICES'].split(',')
+    launch_dir = R86 / 'launches' / f"{plan['name']}_{time.time_ns()}"
+    launch_dir.mkdir(parents=True)
+    save(launch_dir / 'plan.json', plan)
+    env = isolated_env()
+    procs = []
+    log = []
+    for i, j in enumerate(plan['jobs']):
+        g = j['gpu']
+        assert g in allowed, f'gpu {g} outside inherited allowed set {allowed}'
+        py = str(CURE_PY) if j['system'] in ('M1G', 'C') else sys.executable
+        Path(j['out']).resolve().relative_to(R86)
+        # 이미 올라온 이번 worker의 실제 사용량은 smi에 포함되므로, 선점치 중 실제 반영분은 중복될 수 있어 보수적이다.
+        s = smi()
+        used, total = s[g]
+        need = need_mib(j['system'])
+        # 직전 worker가 아직 적재 중일 수 있어 선점치(이번 launcher가 앞서 띄운 worker의 추정 요구량)와 실측 중 큰 값을 쓴다.
+        prior_planned = sum(need_mib(jj['system']) for jj in plan['jobs'][:i] if jj['gpu'] == g)
+        ok = max(used, prior_planned) + need <= total
+        log.append({'job': i, 'gpu': g, 'used_mib': used, 'total_mib': total, 'need_mib': need, 'prior_planned_mib': prior_planned, 'admit': ok})
+        if not ok:
+            save(launch_dir / 'admission_refused.json', {'log': log})
+            print(json.dumps({'refused': j, 'log': log[-1]}))
+            break
+        cmd = [py, str(ROOT / 'report86_gen.py'), '--stage', j['stage'], '--system', j['system'], '--gpu', g, '--out', j['out'],
+               '--shard', str(j['shard']), '--nshards', str(j['nshards'])] + (['--resume'] if j.get('resume') else []) + j.get('extra', [])
+        so = (launch_dir / f'job{i}.stdout.log').open('x')
+        se = (launch_dir / f'job{i}.stderr.log').open('x')
+        e = dict(env)
+        procs.append((i, j, subprocess.Popen(cmd, cwd=ROOT, env=e, stdout=so, stderr=se), time.monotonic(), cmd))
+        time.sleep(a.stagger)
+    rcs = {}
+    # 완료 대기 중 GPU 점유를 주기적으로 기록한다.
+    with (launch_dir / 'resource.jsonl').open('x') as rf:
+        while any(p.poll() is None for _, _, p, _, _ in procs):
+            rf.write(json.dumps({'t': time.time(), 'smi': smi()}) + '\n')
+            rf.flush()
+            time.sleep(30)
+    for i, j, p, t0, cmd in procs:
+        rcs[i] = p.returncode
+    res = {'plan': a.plan, 'plan_sha256': sha(a.plan), 'admission': log, 'returncodes': rcs, 'cmds': {i: c for i, _, _, _, c in procs},
+           'script_sha256': sha(__file__)}
+    save(launch_dir / 'launch_result.json', res)
+    print(json.dumps({'launch_dir': str(launch_dir), 'returncodes': rcs}))
+    return 0 if all(v == 0 for v in rcs.values()) and len(rcs) == len(plan['jobs']) else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
