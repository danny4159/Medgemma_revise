+
+def expect(name, fn, needle, res):
+    try:
+        fn()
+        res.append({"name": name, "pass": False, "why": "no error"})
+    except Exception as e:  # noqa: BLE001
+        res.append({"name": name, "pass": needle in str(e), "error": str(e)[:200], "expected_branch": needle})
+
+
