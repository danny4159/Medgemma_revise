+"""iter_111 fixture: 합성 사례 + 변조 거부 + 재개/덮어쓰기 거부. 실제 결과 비교는 하지 않는다. results/iter_111/tests/fixtures.json 새 파일."""
+import itertools
+import json
+import os
+import shutil
+import sys
+import tempfile
