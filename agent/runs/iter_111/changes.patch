+"""iter_109 추출 규칙의 합성 fixture. 실제 출력·GT를 쓰지 않는다. 통과 후 규칙 파일 hash를 lock 파일로 저장한다(기존 파일 덮어쓰기 금지)."""
+import hashlib
+import json
+import os
