+    'Q03': {3:([4],'irregular 형상이 patchy와 같은지 미판정')},
+    'Q04': {},
+    'Q05': {},
+    'Q06': {2:([0,13],'여러 영역/symmetric hyperintensities를 scattered로 추정하지 않음'),
+            3:([83],'irregular 형상이 plaque-like와 같은지 미판정'),
+            5:([85,86],'right posterior hemisphere만으로 right occipital lobe를 추정하지 않음')},
+    'Q07': {3:([1],'irregular 형상이 patchy와 같은지 미판정')},
+    'Q08': {2:([0,1],'multiple foci를 scattered로 확정하지 않음'),
+            3:([11],'small foci를 punctate로 확정하지 않음')},
+    'Q09': {2:([10],'multiple foci를 scattered로 확정하지 않음'),
+            3:([11,38],'rounded/ill-defined 형상과 patchy 대응 미판정')},
+    'Q10': {2:([79,80],'several focal areas를 scattered로 확정하지 않음'),
+            3:([13,81],'irregular/rounded 형상과 patchy 대응 미판정')},
+    'Q11': {3:([62],'roughly circular 형상이 patchy와 같은지 미판정')},
+}
+PARTIAL = {
+    'Q03': {6:([64],'right thalamus만 기술됨. bilateral의 왼쪽 회복은 미언급'),
+            7:([140,141],'posterior/likely parietal만 기술됨. left+occipital 연결은 미언급')},
+    'Q09': {5:([13,15],'frontal/parietal만 기술됨. temporal을 포함한 전체 복합 위치는 미언급')},
+    'Q10': {5:([80],'두 lobe의 별도 병변을 frontoparietal border로 만들지 않음')},
+    'Q11': {5:([74,79],'frontal/parietal만 기술됨. temporal 포함 전체 복합 위치는 미언급')},
+}
+EXTRAS = {
+    'Q00': [0,7,25,37,49,55,56],
+    'Q01': [0,2,27,33,35,37,68],
+    'Q02': [0,1,15,32,34,42,46],
+    'Q03': [6,8,25,70,71,81,92,100,114,117],
+    'Q04': [0,22,36],
+    'Q05': [3,5,25,31],
+    'Q06': [0,2,9,13,14,33,80,82,85],
+    'Q07': [0,12,14,45,91,92],
+    'Q08': [0,1,11,22,34,35],
+    'Q09': [0,10,11,23,27,28,37,39],
+    'Q10': [4,8,9,15,16,50,58,69,76,82,114],
+    'Q11': [5,6,9,54,57,62,73,74,79,87,116,118,133,135],
+}
+INTERNAL = {
+    'Q00': [('unresolved',[25,26,28],'increased/hyperintense와 dark가 같은 묶음에서 나옴. dark의 상대 기준이 없어 확정 반대 신호로 해석하지 않음')],
+    'Q01': [('unresolved',[19,20,21],'같은 slice의 high/dark 기술. dark의 상대 기준 미확인')],
+    'Q02': [('confirmed',[0,3],'같은 5장 묶음에서 병변 존재와 brain parenchyma에 visible abnormality 없음이 함께 기술됨')],
+    'Q03': [('unresolved',[23],'dark를 high signal의 근거로 기술. 상대 밝기 기준 미확인'),
+            ('unresolved',[145],'increased signal과 appearing dark를 같은 영역에 기술. 상대 기준 미확인')],
+    'Q10': [('unresolved',[114],'increased signal과 appearing dark를 같은 영역에 기술. 상대 기준 미확인'),
+            ('unresolved',[116,118],'동일 slice에서 no abnormality와 likely lesion이 함께 있으나 양성이 hedge되어 확정 모순으로 세지 않음')],
+    'Q11': [('unresolved',[121,122,123],'동일 slice의 high/dark 기술. 상대 기준 미확인')],
+}
+
+
+def main():
+    path=RES/'eval/blinded_packages.json'
+    packages=read(path)
+    assert {x['id'] for x in packages}==set(MATCHED)==set(UNRESOLVED)
+    result={}
+    review=[]
+    for p in packages:
+        q=p['id']
+        def quotes(indices):
+            return [p['package']['sentences'][i]['text'] for i in indices]
+        row={'atoms':{},'reference_contradictions':[], 'internal_contradictions':[],
+             'report_unverified_claims':[], 'review_note':'일반 finding/signal과 구체 위치·속성을 분리한 텍스트 일치도다. 같은 실제 병변의 시각적 회복이나 임상 정확도를 인증하지 않음.'}
+        for i,atom in enumerate(p['reference']['positive_atoms']):
+            if i in MATCHED[q]:
+                value={'state':'matched','output_quotes':quotes(MATCHED[q][i]),
+                       'reason':'공개 항목을 명시적으로 기술. 위치의 요구 범위/좌우가 충족됨. generic 항목은 위치 회복과 별도.'}
+            elif i in UNRESOLVED[q]:
+                inds,reason=UNRESOLVED[q][i]
+                value={'state':'unresolved','output_quotes':quotes(inds),'reason':reason}
+            elif i in PARTIAL.get(q,{}):
+                inds,reason=PARTIAL[q][i]
+                value={'state':'unmentioned','output_quotes':quotes(inds),'reason':reason}
+            else:
+                value={'state':'unmentioned','output_quotes':[],'reason':'해당 완전한 소견/위치/속성이 기술되지 않음. 미언급을 임상 부재로 바꾸지 않음.'}
+            value['reference_span']={k:atom[k] for k in ['quote','start','end']}
+            row['atoms'][atom['id']]=value
+        for status,indices,reason in INTERNAL.get(q,[]):
+            qs=quotes(indices)
+            same=[r for r in p['outputs'] if all(s in r['final_text'] for s in qs)]
+            assert same,'서로 다른 slice 범위를 내부 모순으로 합치지 않는다: '+q
+            row['internal_contradictions'].append({'status':status,'quotes':qs,'reason':reason,
+                'scopes':[{'id':r['id'],'slice_indices':r['slice_indices']} for r in same]})
+        for i in EXTRAS[q]:
+            text=quotes([i])[0]
+            row['report_unverified_claims'].append({'quote':text,'sentence_index':i,
+                'status':'report_unverified_or_input_unsupported',
+                'reason':'reference에 없는 위치/형상·원인/병기·확산 제한·제공되지 않은 sequence 관찰 또는 비판독 문구의 원문 예시. 임상 허위 판정 아님.'})
+        # 위 예시는 독특한 추가 위치·속성·원인 기술을 묶은 것이다. 전체 임상 FP 수가 아니다.
+        row['extra_claim_coverage']='원문 기반 대표 추가 기술 목록. 반복과 동의어를 임상 FP로 전수 계산하지 않음.'
+        row['reference_contradiction_note']='각 출력의 정상/부재 기술은 해당 slice/묶음 범위. 다른 범위의 양성 reference와 자동 충돌로 세지 않음. 추가 위치를 reference 미언급만으로 반박하지 않음.'
+        result[q]=row
+        review.append({'package':q,'reviewed_exact_deduplicated_sentences':len(p['package']['sentences']),
+                       'same_scope_conflicts_checked':len(row['internal_contradictions']),
+                       'reference_atoms':len(row['atoms']),'conditional_clinical_truth_invented':False})
+    for q,row in result.items():
+        package=next(p for p in packages if p['id']==q)
+        text=package['package']['raw_concatenation']
+        assert all(v['quote'] in text for v in row['report_unverified_claims'])
+    save(RES/'eval/judgments.json',result)
+    save(RES/'eval/assistant_review_record.json',{'created_at':now(),'packages_sha256':sha(path),
+         'reference_sha256':sha(RES/'reference_locked.json'),'adjudication_source_sha256':sha(__file__),
+         'post_generation':True,'independent_clinician':False,'rules_changed_after_generation':False,
+         'scope':'고정 reference atom과 소견 집합 대응. unclear 동의어/범위는 unresolved. 추가 임상 정답 생성 없음.',
+         'reviews':review})
+    print({'judged_packages':len(result),'source_span_quotes_checked':True})
+
+
+if __name__=='__main__':
+    main()
diff --git a/i141_preflight.py b/i141_preflight.py
new file mode 100644
index 0000000..cf7d220
--- /dev/null
+++ b/i141_preflight.py
@@ -0,0 +1,161 @@
+"""iter_141 고정 ISLES22 후보의 공식 자료를 확인하고 원본을 보존한다."""
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / 'results/iter_141'
+REV = '0348ba42fad134da57b50e736ba858a8e73eb086'
+IDS = ['sub-strokecase' + x for x in ['0001', '0003', '0004', '0006', '0007', '0008', '0009', '0010']]
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def sha(p):
+    h = hashlib.sha256()
+    with Path(p).open('rb') as f:
+        for b in iter(lambda: f.read(4 << 20), b''):
+            h.update(b)
+    return h.hexdigest()
+
+
+def save(p, obj):
+    with Path(p).open('x') as f:
+        json.dump(obj, f, ensure_ascii=False, indent=2, allow_nan=False)
+        f.write('\n')
+        f.flush()
+        os.fsync(f.fileno())
+
+
+def fetch():
+    import requests
+    if OUT.exists():
+        raise FileExistsError('기존 결과 보존: ' + str(OUT))
+    OUT.mkdir(parents=True)
+    official = OUT / 'official'
+    official.mkdir()
+    session = requests.Session()
+    session.trust_env = False
+    records = []
+    for name in ['ISLES22/modal_wise_finding.json', 'ISLES22/global_finding.json',
+                 'ISLES22/impression.json', 'train_val_test_split.json', 'README.md']:
+        url = f'https://huggingface.co/datasets/JiayuLei/RadGenome-Brain_MRI/resolve/{REV}/{name}'
+        dest = official / name
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        start = now()
+        r = session.get(url, timeout=60)
+        rec = {'path': name, 'requested_at': start, 'url': url, 'final_url': r.url,
+               'status_code': r.status_code, 'bytes': len(r.content),
+               'response_sha256': hashlib.sha256(r.content).hexdigest()}
+        records.append(rec)
+        if r.status_code == 200:
+            with dest.open('xb') as f:
+                f.write(r.content)
+        else:
+            with (official / (name.replace('/', '__') + '.error.txt')).open('x') as f:
+                f.write(r.text)
+    save(OUT / 'fetch_manifest.json', {'created_at': now(), 'revision': REV, 'records': records})
+    print(json.dumps({'downloads': len(records), 'statuses': [x['status_code'] for x in records]}))
+
+
+def inspect():
+    official = OUT / 'official'
+    split = json.loads((official / 'train_val_test_split.json').read_text())
+    docs = {name: json.loads((official / f'ISLES22/{name}.json').read_text())
+            for name in ['modal_wise_finding', 'global_finding', 'impression']}
+    train = split['train']
+    rows = []
+    for pid in IDS:
+        # 공식 key를 그대로 보존하며 문자열 유사 연결은 하지 않는다.
+        keys = [k for k in train if k.startswith(pid + '_') or k.startswith(pid + '-') or k == pid]
+        row = {'patient_id': pid, 'role': 'technical' if pid in IDS[:2] else 'exploration',
+               'train_keys': keys, 'documents': {}}
+        for name, d in docs.items():
+            matches = {k: v for k, v in d.items() if k.startswith(pid + '_') or k.startswith(pid + '-') or k == pid}
+            row['documents'][name] = matches
+        rows.append(row)
+    result = {'created_at': now(), 'schema': {n: {'type': type(d).__name__, 'count': len(d),
+              'value_types': sorted(set(type(v).__name__ for v in d.values()))} for n, d in docs.items()},
+              'candidate_order': IDS, 'rows': rows}
+    save(OUT / 'report_schema_candidates.json', result)
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+
+def archive():
+    import requests
+    import shutil
+    import zipfile
+    session = requests.Session()
+    session.trust_env = False
+    meta_path = ROOT / 'results/iter_140/preflight_a2/isles_zenodo_metadata.json'
+    prior = json.loads(meta_path.read_text())
+    meta = json.loads(prior['body'])
+    info = next(f for f in meta['files'] if f['key'] == 'ISLES-2022.zip')
+    dest = OUT / 'official/ISLES-2022.zip'
+    if dest.exists():
+        raise FileExistsError('기존 archive 보존')
+    assert shutil.disk_usage(OUT).free > info['size'] + 2 * 1024 ** 3
+    started = time.monotonic()
+    url = info['links']['self']
+    response = session.get(url, stream=True, timeout=(30, 120))
+    response.raise_for_status()
+    md5 = hashlib.md5()
+    count = 0
+    with dest.open('xb') as f:
+        for b in response.iter_content(4 << 20):
+            f.write(b)
+            md5.update(b)
+            count += len(b)
+        f.flush()
+        os.fsync(f.fileno())
+    record = {'created_at': now(), 'metadata_path': str(meta_path), 'metadata_sha256': sha(meta_path),
+              'url': url, 'final_url': response.url, 'status_code': response.status_code,
+              'bytes': count, 'expected_bytes': info['size'], 'md5': md5.hexdigest(),
+              'expected_checksum': info['checksum'], 'sha256': sha(dest),
+              'elapsed_seconds': time.monotonic() - started}
+    save(OUT / 'archive_download.json', record)
+    assert count == info['size'] and 'md5:' + md5.hexdigest() == info['checksum']
+    selected = []
+    with zipfile.ZipFile(dest) as z:
+        catalog = [{'name': i.filename, 'bytes': i.file_size, 'compressed_bytes': i.compress_size,
+                    'crc': i.CRC} for i in z.infolist()]
+        save(OUT / 'archive_catalog.json', catalog)
+        for i in z.infolist():
+            parts = Path(i.filename).parts
+            if not (any(pid in parts for pid in IDS) or Path(i.filename).name in
+                    ['dataset_description.json', 'README', 'README.md', 'participants.tsv']):
+                continue
+            if not (i.filename.endswith(('_dwi.nii.gz', '_dwi.json', '_msk.nii.gz')) or
+                    Path(i.filename).name in ['dataset_description.json', 'README', 'README.md', 'participants.tsv']):
+                continue
+            assert not Path(i.filename).is_absolute() and '..' not in parts
+            target = OUT / 'data' / i.filename
+            assert target.resolve().is_relative_to((OUT / 'data').resolve())
+            target.parent.mkdir(parents=True, exist_ok=True)
+            with z.open(i) as source, target.open('xb') as f:
+                shutil.copyfileobj(source, f)
+            selected.append({'member': i.filename, 'path': str(target), 'bytes': i.file_size,
+                             'sha256': sha(target)})
+    save(OUT / 'extraction_manifest.json', {'created_at': now(), 'files': selected,
+         'archive_sha256': record['sha256'], 'total_selected_bytes': sum(x['bytes'] for x in selected)})
+    print(json.dumps({'archive_bytes': count, 'selected_files': len(selected),
+                      'elapsed_seconds': record['elapsed_seconds']}))
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('stage', choices=['fetch', 'inspect', 'archive'])
+    args = p.parse_args()
+    if args.stage == 'fetch':
+        fetch()
+    elif args.stage == 'inspect':
+        inspect()
+    else:
+        archive()
