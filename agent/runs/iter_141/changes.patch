diff --git a/i141_cap_control.py b/i141_cap_control.py
new file mode 100644
index 0000000..79e73cd
--- /dev/null
+++ b/i141_cap_control.py
@@ -0,0 +1,74 @@
+"""사전 계획의 1024→2048 기술 재실행을 관리한다. prompt·관측·metric을 변경하지 않는다."""
+from datetime import datetime
+from pathlib import Path
+import subprocess
+import sys
+import time
+import numpy as np
+from i141_common import HERE,RES,read,save,sha,now
+import i141_run as run
+import i141_prepare as prep
+
+
+def call(job,workers,peak):
+    with (RES/'tests'/('launch_'+job.name+'_'+str(time.time_ns())+'.log')).open('xb') as f:
+        cmd=[sys.executable,str(HERE/'i141_run.py'),'launch','--stage','technical2048','--job',str(job),
+             '--workers',str(workers),'--peak',str(peak)]
+        process=subprocess.Popen(cmd,stdout=f,stderr=subprocess.STDOUT)
+        print({'supervisor_pid':process.pid,'job':str(job)},flush=True)
+        rc=process.wait()
+    assert rc==0,'기술 재실행 실패: '+str(job)
+    return run.verify_job(job,'technical2048')
+
+
+def wall(job):
+    c=read(job/'completion.json')
+    start=read(job/('start_'+c['attempt']+'.json'))['created_at']
+    records=run.verify_job(job,'technical2048')
+    end=max(datetime.fromisoformat(r['completed_at']).timestamp() for r in records)
+    return end-datetime.fromisoformat(start).timestamp()
+
+
+def main():
+    initial=run.verify_job(RES/'jobs/tech_w2','technical')
+    assert any(r['n_tokens']>=1024 and not r['eos'] for r in initial)
+    assert read(RES/'tests/runtime_checks.json')['all_pass']
+    # 이전 잠금·출력을 유지하고 새 stage의 정확한 2048 설정을 본출력 전에 잠근다.
+    prep.CODE=prep.CODE+['i141_cap_control.py']
+    prep.lock('technical2048')
+    a=call(RES/'jobs/tech2048_w2',2,12000)
+    peak=int(np.ceil(max(r['peak_reserved_mib'] for r in a)))+256
+    free={r['index']:int(r['free']) for r in run.smi()}
+    assert all(free[g]>=2*(peak+2048) for g in run.allowed()), '4 worker 메모리 불충분; 본실행은 보류'
+    b=call(RES/'jobs/tech2048_w4',4,peak)
+    same=all(r['tokens']==next(x['tokens'] for x in a if x['id']==r['id']) for r in b)
+    w2,w4=wall(RES/'jobs/tech2048_w2'),wall(RES/'jobs/tech2048_w4')
+    chosen=4 if same and w4<w2 else 2
+    throughput={'created_at':now(),'stage':'technical2048','measured_worker_peak_mib':peak-256,
+                'admission_peak_mib':peak,'worker_margin_mib':2048,'two_workers_per_gpu_need_mib':2*(peak+2048),
+                'gpu_free_before':free,'w2_generation_wall_s':w2,'w4_generation_wall_s':w4,
+                'w2_requests_per_min':len(a)*60/w2,'w4_requests_per_min':len(b)*60/w4,
+                'tokens_equal':same,'selected_workers':chosen,
+                'reason':'같은 개발 요청의 생성 처리량과 greedy token 정합성. 로딩 비용은 별도 기록.',
+                'truncated_w2':sum(not r['eos'] for r in a),'truncated_w4':sum(not r['eos'] for r in b),
+                'output_max_tokens':2048,
+                'main_requests':len(read(RES/'requests/main.json')),
+                'estimated_main_generation_wall_s':len(read(RES/'requests/main.json'))*(w4 if chosen==4 else w2)/len(a),
+                'estimate_limit':'개발 8건의 단순 처리량 외삽. 본요청 길이·S/A 비율 차이로 불확실.'}
+    save(RES/'tests/throughput_choice.json',throughput)
+    valid=read(RES/'tests/tensors_v2.json')['all_pass'] and read(RES/'tests/runtime_checks.json')['all_pass']
+    valid=valid and all(r['boundary_status']!='invalid_boundary' for r in a)
+    gate={'created_at':now(),'passed':valid,'main_max_new_tokens':2048,
+          'initial_1024_cap_reached':True,'2048_recheck_done_both_conditions':True,
+          'n_2048_records':len(a)+len(b),'cap_reached_again':any(not r['eos'] and r['n_tokens']>=2048 for r in a),
+          'boundary_invalid':sum(r['boundary_status']=='invalid_boundary' for r in a),
+          'EOS_100_percent_not_required_by_plan':True,
+          'truncation_policy':'본출력 재생성 없음; 미완결·미판정 범위 별도. 반복문을 정답으로 정리하지 않음.',
+          'evidence':{str(RES/'tests'/p):sha(RES/'tests'/p) for p in ['tensors_v2.json','runtime_checks.json','throughput_choice.json']}}
+    save(RES/'tests/technical_gate.json',gate)
+    assert valid
+    print({'gate':gate,'throughput':throughput},flush=True)
+
+
+if __name__=='__main__':
+    main()
diff --git a/i141_common.py b/i141_common.py
new file mode 100644
index 0000000..89a3da0
--- /dev/null
+++ b/i141_common.py
@@ -0,0 +1,39 @@
+"""iter_141 출처·배타 저장 유틸리티. i136_common.py의 작은 hash/save 경로를 파생."""
+import hashlib
+import json
+import os
+from pathlib import Path
+from datetime import datetime, timezone
+
+HERE = Path(__file__).resolve().parent
+RES = HERE / 'results/iter_141'
+
+
+def sha(p):
+    h = hashlib.sha256()
+    with Path(p).open('rb') as f:
+        for b in iter(lambda: f.read(4 << 20), b''):
+            h.update(b)
+    return h.hexdigest()
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def digest(obj):
+    return hashlib.sha256(json.dumps(obj, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()).hexdigest()
+
+
+def read(p):
+    return json.loads(Path(p).read_text())
+
+
+def save(p, obj):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with p.open('x') as f:
+        json.dump(obj, f, ensure_ascii=False, indent=2, sort_keys=True, allow_nan=False)
+        f.write('\n')
+        f.flush()
+        os.fsync(f.fileno())
diff --git a/i141_data.py b/i141_data.py
new file mode 100644
index 0000000..a2481ba
--- /dev/null
+++ b/i141_data.py
@@ -0,0 +1,169 @@
+"""고정 8명의 원 DWI–global 문장 연결·공간 검사와 동일 관측 요청을 구성한다."""
+from collections import Counter
+from pathlib import Path
+import json
+import math
+import re
+import nibabel as nib
+import numpy as np
+from PIL import Image, ImageOps, ImageDraw
+from i141_common import HERE, RES, read, save, sha, digest, now
+from i141_preflight import IDS
+from i141_spec import QUESTION, RENDER, SEMANTIC_CONTRACT
+
+LOCATIONS = {
+    '0001': ['left frontal-parietal lobes', 'bilateral occipital lobes', 'near the left lateral ventricle', 'thalamus', 'bilateral cerebellum'],
+    '0003': ['left frontal-parietal-temporal-occipital lobes'],
+    '0004': ['vicinity of the right frontal lobe', 'border of the frontal and parietal lobes', 'insular cortex', 'adjacent to the lateral ventricle'],
+    '0006': ['cerebral peduncles'],
+    '0007': ['left cerebellum', 'right occipital lobe', 'brainstem'],
+    '0008': ['left frontal lobe', 'corpus callosum', 'basal ganglia region'],
+    '0009': ['left basal ganglia', 'frontal-parietal-temporal lobes'],
+    '0010': ['brainstem', 'right cerebellum', 'bilateral thalami', 'left parieto-occipital lobe'],
+}
+
+
+def span(text, quote):
+    assert text.count(quote) == 1, quote
+    start = text.index(quote)
+    return {'quote': quote, 'start': start, 'end': start + len(quote)}
+
+
+def build():
+    completion = read(RES / 'selected_download_complete.json')
+    assert completion['selected_members_crc32_verified'] is True
+    for f in completion['files']:
+        assert sha(f['path']) == f['sha256']
+    official = RES / 'official'
+    reports = read(official / 'ISLES22/global_finding.json')
+    modal = read(official / 'ISLES22/modal_wise_finding.json')
+    split = read(official / 'train_val_test_split.json')['train']
+    raw = RES / 'data_selected/ISLES-2022'
+    print((raw / 'README').read_text(), flush=True)
+    print((raw / 'dataset_description.json').read_text(), flush=True)
+    assert not (RES / 'data_manifest.json').exists()
+    rows, reference, requests, hashes = [], [], {'technical': [], 'main': []}, []
+    for index, pid in enumerate(IDS):
+        key = pid + '_ses-0001_dwi'
+        global_key = pid + '_ses-0001'
+        assert key in split and global_key in reports
+        p = raw / pid / 'ses-0001/dwi' / (key + '.nii.gz')
+        assert p.is_file(), '선택 원영상 누락'
+        img = nib.load(p)
+        original = np.asanyarray(img.dataobj)
+        assert original.ndim == 3 and np.isfinite(original).all(), '임의 4D channel 선택 금지'
+        canonical = nib.as_closest_canonical(img)
+        arr = np.asanyarray(canonical.dataobj)
+        assert nib.aff2axcodes(canonical.affine) == ('R', 'A', 'S')
+        orientation = nib.orientations.ornt_transform(nib.orientations.io_orientation(img.affine),
+                                                     nib.orientations.io_orientation(canonical.affine))
+        voxel_map = nib.orientations.inv_ornt_aff(orientation, img.shape)
+        checks = []
+        for q in [(0, 0, 0), tuple(x-1 for x in arr.shape), tuple(x//2 for x in arr.shape)]:
+            qh = np.array([*q, 1.])
+            native = voxel_map @ qh
+            physical_old, physical_new = img.affine @ native, canonical.affine @ qh
+            v = original[tuple(np.rint(native[:3]).astype(int))]
+            checks.append({'canonical_index': list(q), 'native_index': native[:3].tolist(),
+                           'physical_error_mm': float(np.max(np.abs(physical_old-physical_new))),
+                           'voxel_equal': bool(v == arr[q])})
+        assert all(c['physical_error_mm'] < 1e-5 and c['voxel_equal'] for c in checks)
+        lo, hi = float(arr.min()), float(arr.max())
+        assert hi > lo
+        nonzero = np.where(np.any(arr != 0, axis=(0, 1)))[0]
+        assert len(nonzero)
+        zs = list(range(int(nonzero[0]), int(nonzero[-1]) + 1))
+        mask_path = raw / 'derivatives' / pid / 'ses-0001' / (global_key + '_msk.nii.gz')
+        mask = nib.load(mask_path)
+        maskarr = np.asanyarray(mask.dataobj)
+        labels = [float(x) for x in np.unique(maskarr)]
+        geometry_ok = mask.shape == img.shape and np.allclose(mask.affine, img.affine, atol=1e-5)
+        # mask 정합은 검사만 하며 입력·선정·정규화에는 사용하지 않는다.
+        meta_path = p.with_suffix('').with_suffix('.json')
+        sidecar = read(meta_path) if meta_path.is_file() else None
+        images = []
+        for z in zs:
+            pixels = np.round(np.clip((arr[:, :, z]-lo)/(hi-lo), 0, 1)*255).astype(np.uint8)
+            displayed = np.flip(pixels.T, axis=(0, 1))
+            ph = digest({'shape': list(displayed.shape), 'bytes_hex': displayed.tobytes().hex()})
+            im = Image.fromarray(displayed).convert('RGB')
+            zoom = canonical.header.get_zooms()
+            width = max(1, round(displayed.shape[1]*float(zoom[0])))
+            height = max(1, round(displayed.shape[0]*float(zoom[1])))
+            im = im.resize((width, height), Image.Resampling.BILINEAR)
+            im = ImageOps.pad(im, (RENDER['side'], RENDER['side']), method=Image.Resampling.BILINEAR, color=0)
+            dest = RES / 'png' / pid / f'z{z:04d}.png'
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            assert not dest.exists()
+            im.save(dest)
+            physical = canonical.affine @ np.array([(arr.shape[0]-1)/2, (arr.shape[1]-1)/2, z, 1])
+            images.append({'path': str(dest), 'sha256': sha(dest), 'pixel_sha256': digest({'shape':[256,256,3], 'bytes_hex':np.asarray(im).tobytes().hex()}),
+                           'native_display_pixel_digest': ph, 'canonical_z': z, 'physical_center_RAS_mm': physical[:3].tolist()})
+        hashes.extend(im['pixel_sha256'] for im in images)
+        stage = 'technical' if index < 2 else 'main'
+        condition_rows = []
+        for condition, size in [('S', 1), ('A', 5)]:
+            for pos in range(0, len(images), size):
+                chunk = images[pos:pos+size]
+                req = {'id': pid + f'__{condition}__{pos:04d}', 'patient_id': pid, 'condition': condition,
+                       'kind': 'findings', 'images': chunk, 'slice_indices': [x['canonical_z'] for x in chunk],
+                       'roles': ['DWI']*len(chunk), 'prompt': QUESTION}
+                req['request_digest'] = digest(req)
+                requests[stage].append(req)
+                condition_rows.append(req)
+        multisets = {c: Counter(im['sha256'] for r in condition_rows if r['condition']==c for im in r['images']) for c in ['S','A']}
+        assert multisets['S'] == multisets['A']
+        # global 문장 내부의 같은 병변에 대한 DWI 절만 연결. ADC·병인·병기는 제외.
+        text = reports[global_key]
+        atom_quotes = [('finding', 'abnormal signal' if 'abnormal signal' in text else 'abnormal signals'),
+                       ('signal', 'high signal on DWI' if 'high signal on DWI' in text else 'hyperintense on DWI')]
+        for quote in ['Scattered', 'scattered']:
+            if quote in text:
+                atom_quotes.append(('distribution', quote))
+                break
+        for quote in ['patchy', 'punctate', 'plaque-like']:
+            if quote in text:
+                atom_quotes.append(('morphology', quote))
+                break
+        atom_quotes += [('location', q) for q in LOCATIONS[pid[-4:]]]
+        atoms = [{'id': f'{pid}__atom{j:02d}', 'type': kind, **span(text, quote)} for j, (kind,quote) in enumerate(atom_quotes)]
+        reference.append({'patient_id': pid, 'source_path': str(official/'ISLES22/global_finding.json'),
+                          'source_sha256': sha(official/'ISLES22/global_finding.json'), 'source_key': global_key,
+                          'original_text': text, 'positive_atoms': atoms,
+                          'negative_reference': [span(text, m.group()) for m in re.finditer(r'no (?:midline shift|displacement of midline structures)', text, re.I)],
+                          'excluded': ['ADC low signal', 'diffusion restriction', 'etiology', 'timing'],
+                          'DWI_modal_key_present': key in modal,
+                          'link_basis': '같은 BIDS patient/session global key. 문장 자체가 해당 병변의 DWI 신호를 명시한다.',
+                          'supervision_unit': 'whole sequence; regional/slice mapping not provided'})
+        rows.append({'patient_id':pid, 'role':stage, 'DWI_key':key, 'global_key':global_key,
+                     'source_path':str(p), 'source_sha256':sha(p), 'native_shape':list(img.shape),
+                     'canonical_shape':list(arr.shape), 'native_affine':img.affine.tolist(), 'canonical_affine':canonical.affine.tolist(),
+                     'native_axcodes':list(nib.aff2axcodes(img.affine)), 'stored_spacing_mm':[float(x) for x in img.header.get_zooms()],
+                     'canonical_to_native_voxel':voxel_map.tolist(), 'physical_checks':checks,
+                     'sidecar_path':str(meta_path) if sidecar is not None else None, 'sidecar':sidecar,
+                     'DWI_b_value_basis':'공식 ISLES2022 record 7960856: b=1000; 3D image, no channel selection',
+                     'slice_indices':zs, 'trimmed_exact_zero_exterior_slices':list(range(0,zs[0]))+list(range(zs[-1]+1,arr.shape[2])),
+                     'volume_minmax':[lo,hi], 'images':images, 'same_observation_multiset':True,
+                     'mask':{'path':str(mask_path),'sha256':sha(mask_path),'shape':list(mask.shape),'affine':mask.affine.tolist(),
+                             'numeric_labels':labels, 'geometry_matches_DWI':bool(geometry_ok), 'used_for_input_selection':False},
+                     'new_patient_independence':'new development cases; prior global metadata access and model training exposure not excluded'})
+    assert len(set(r['source_sha256'] for r in rows)) == len(rows), '환자간 원영상 중복'
+    # 작은 pad slice의 pixel 중복은 표시하며 환자를 제거하지 않는다.
+    save(RES/'data_manifest.json', {'created_at':now(),'source_release':'ISLES2022 v2.3.1 record 7960856',
+         'use_basis':'public CC-BY-4.0 source MRI; RadGenome text MIT card', 'rows':rows, 'render':RENDER,
+         'cross_patient_raw_duplicate_count':len(rows)-len(set(r['source_sha256'] for r in rows)),
+         'rendered_pixel_unique':len(set(hashes)), 'rendered_slices':len(hashes)})
+    save(RES/'reference_locked.json', {'created_at':now(),'rows':reference,'evaluation_contract':SEMANTIC_CONTRACT})
+    for stage, rr in requests.items():
+        save(RES/'requests'/f'{stage}.json', rr)
+    save(RES/'data_gate.json', {'created_at':now(),'passed':True, 'candidates':len(rows),'eligible':len(rows),
+         'DWI_modal_report_links':0, 'explicit_global_DWI_links':len(rows),
+         'mask_geometry_matches':sum(r['mask']['geometry_matches_DWI'] for r in rows),
+         'supervision':'whole DWI sequence from explicit global DWI clauses; no slice-specific target',
+         'restriction':'global report linkage is text-grounded; clinical image truth and prior model exposure remain unverified',
+         'requests':{s:len(v) for s,v in requests.items()}, 'new_model_requests':0})
+    print(json.dumps({'patients':len(rows),'requests':{s:len(v) for s,v in requests.items()},'slices':[len(r['slice_indices']) for r in rows]}))
+
+
+if __name__ == '__main__':
+    build()
diff --git a/i141_eval.py b/i141_eval.py
new file mode 100644
index 0000000..57fad71
--- /dev/null
+++ b/i141_eval.py
@@ -0,0 +1,132 @@
+"""사전 고정 내용 판정표의 근거 span 연결과 paired 지표를 계산한다. 임상 정답 생성기는 아니다."""
+import argparse
+from collections import Counter
+import random
+import numpy as np
+from i141_common import HERE, RES, read, save, sha, now
+from i141_spec import integrate
+import i141_run as run
+
+
+def packages():
+    records=run.verify_job(RES/'jobs/main','main')
+    patients=[x['patient_id'] for x in read(RES/'data_manifest.json')['rows'] if x['role']=='main']
+    pairs=[(pid,c) for pid in patients for c in ['S','A']]
+    random.Random(141).shuffle(pairs)
+    references={x['patient_id']:x for x in read(RES/'reference_locked.json')['rows']}
+    items,mapping=[],{}
+    for i,(pid,cond) in enumerate(pairs):
+        selected=[r for r in records if r['patient_id']==pid and r['condition']==cond]
+        package=integrate(selected)
+        qid=f'Q{i:02d}'
+        mapping[qid]={'patient_id':pid,'condition':cond}
+        items.append({'id':qid,'reference':references[pid], 'package':package,
+                      'outputs':[{'id':r['id'].split('__')[0]+f'__part{j:03d}',
+                                  'slice_indices':r['slice_indices'],'final_text':r['final_text'],'eos':r['eos'],
+                                  'boundary_status':r['boundary_status'],'raw_text':r['text_marked']}
+                                 for j,r in enumerate(sorted(selected,key=lambda x:x['slice_indices'][0]))],
+                      'n_outputs':len(selected),'truncated_outputs':sum(not r['eos'] for r in selected),
+                      'invalid_boundary_outputs':sum(r['boundary_status']=='invalid_boundary' for r in selected)})
+        # 중복 제거의 source request ID에서도 조건 라벨을 숨긴다.
+        for j,sent in enumerate(items[-1]['package']['sentences']):
+            sent['request_id']=qid+f'__sentence{j:03d}'
+    save(RES/'eval/blinded_packages.json',items)
+    save(RES/'eval/condition_mapping.json',mapping)
+    save(RES/'eval/package_provenance.json', {'created_at':now(),
+         'main_completion_sha256':sha(RES/'jobs/main/completion.json'),
+         'reference_sha256':sha(RES/'reference_locked.json'),
+         'package_sha256':sha(RES/'eval/blinded_packages.json'),
+         'blinding_scope':'condition labels removed; same assistant, not independent blinded clinician'})
+    print({'packages':len(items),'model_outputs':len(records)})
+
+
+def analyze():
+    run.verify_job(RES/'jobs/main','main')
+    packages={x['id']:x for x in read(RES/'eval/blinded_packages.json')}
+    mapping=read(RES/'eval/condition_mapping.json')
+    judgments=read(RES/'eval/judgments.json')
+    assert set(judgments)==set(packages)
+    rows=[]
+    for qid,p in packages.items():
+        j=judgments[qid]
+        refs={a['id']:a for a in p['reference']['positive_atoms']}
+        assert set(j['atoms'])==set(refs)
+        text=p['package']['raw_concatenation']
+        counts=Counter()
+        evidence=[]
+        for aid,a in j['atoms'].items():
+            assert a['state'] in ['matched','contradicted','unmentioned','unresolved']
+            counts[a['state']]+=1
+            for quote in a.get('output_quotes',[]):
+                assert quote and quote in text, '생성문 근거 없음: '+qid+' '+aid
+                evidence.append({'atom_id':aid,'reference_span':refs[aid], 'output_quote':quote,
+                                 'output_start':text.index(quote),'output_end':text.index(quote)+len(quote)})
+            assert a['state'] not in ['matched','contradicted'] or a.get('output_quotes'), '확정 판정에는 원문 근거 필요'
+        for field in ['reference_contradictions','internal_contradictions']:
+            for item in j[field]:
+                assert item['status'] in ['confirmed','unresolved']
+                for quote in item['quotes']:
+                    assert quote in text
+        n=len(refs)
+        truncated=p['truncated_outputs']>0 or p['invalid_boundary_outputs']>0
+        unknown=counts['unresolved']+(counts['unmentioned'] if truncated else 0)
+        contra=j['reference_contradictions']
+        internal=j['internal_contradictions']
+        row=dict(mapping[qid],blinded_id=qid,n_positive_atoms=n,states=dict(counts),
+                 recall=counts['matched']/n if n else None,
+                 recall_min=counts['matched']/n if n else None,
+                 recall_max=(counts['matched']+unknown)/n if n else None,
+                 reference_contradiction_min=int(any(x['status']=='confirmed' for x in contra)),
+                 reference_contradiction_max=int(bool(contra)),
+                 internal_contradiction_min=int(any(x['status']=='confirmed' for x in internal)),
+                 internal_contradiction_max=int(bool(internal)),
+                 unresolved_rate=counts['unresolved']/n if n else None,
+                 truncated_outputs=p['truncated_outputs'], n_outputs=p['n_outputs'],
+                 report_unverified_claims=j['report_unverified_claims'], evidence=evidence,
+                 judgments=j)
+        rows.append(row)
+    systems={}
+    for cond in ['S','A']:
+        rr=[r for r in rows if r['condition']==cond]
+        systems[cond]={'patients':len(rr),'recall_denominator_patients':sum(r['n_positive_atoms']>0 for r in rr),
+                       'excluded_no_positive_atoms':sum(r['n_positive_atoms']==0 for r in rr)}
+        for key in ['recall','recall_min','recall_max','reference_contradiction_min','reference_contradiction_max',
+                    'internal_contradiction_min','internal_contradiction_max','unresolved_rate']:
+            systems[cond][key]=float(np.mean([r[key] for r in rr if r[key] is not None]))
+        systems[cond]['truncation_rate']=sum(r['truncated_outputs'] for r in rr)/sum(r['n_outputs'] for r in rr)
+    delta=systems['A']['recall']-systems['S']['recall']
+    dmin=systems['A']['recall_min']-systems['S']['recall_max']
+    dmax=systems['A']['recall_max']-systems['S']['recall_min']
+    cmin=systems['A']['reference_contradiction_min']-systems['S']['reference_contradiction_max']
+    cmax=systems['A']['reference_contradiction_max']-systems['S']['reference_contradiction_min']
+    if dmin>=0.05 and cmax<=0.05:
+        decision='positive_exploration'
+    elif dmax<0.05 or cmin>0.05:
+        decision='negative_frozen_adjacent_advantage_not_established'
+    else:
+        decision='inconclusive'
+    pairs=[]
+    for pid in sorted(set(r['patient_id'] for r in rows)):
+        s=next(r for r in rows if r['patient_id']==pid and r['condition']=='S')
+        a=next(r for r in rows if r['patient_id']==pid and r['condition']=='A')
+        pairs.append({'patient_id':pid,'recall_S':s['recall'],'recall_A':a['recall'],
+                      'delta':a['recall']-s['recall'],'delta_range':[a['recall_min']-s['recall_max'],a['recall_max']-s['recall_min']]})
+    rng=np.random.default_rng(141)
+    values=np.array([p['delta'] for p in pairs])
+    bootstrap=values[rng.integers(0,len(values),size=(10000,len(values)))].mean(1)
+    report={'created_at':now(),'systems':systems,'delta_recall_A_minus_S':delta,'delta_recall_range':[dmin,dmax],
+            'delta_reference_contradiction_range':[cmin,cmax], 'paired_patients':pairs,
+            'exploratory_paired_bootstrap_95CI':np.quantile(bootstrap,[.025,.975]).tolist(),
+            'bootstrap_used_as_new_gate':False,'decision':decision,'valid_experiment':True,
+            'evaluation_scope':'explicit public DWI text agreement; assistant textual judgment, no clinical false-positive truth',
+            'provenance':{str(p):sha(p) for p in [RES/'eval/judgments.json',RES/'eval/blinded_packages.json',RES/'reference_locked.json',RES/'jobs/main/completion.json']}}
+    save(RES/'eval/per_patient.json',rows)
+    save(RES/'eval/report.json',report)
+    print({k:v for k,v in report.items() if k not in ['provenance','paired_patients']})
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser()
+    p.add_argument('command',choices=['packages','analyze'])
+    a=p.parse_args()
+    globals()[a.command]()
diff --git a/i141_execute.py b/i141_execute.py
new file mode 100644
index 0000000..3292c25
--- /dev/null
+++ b/i141_execute.py
@@ -0,0 +1,58 @@
+"""기술 판단 경계 후 고정 6명의 paired 본생성을 실행하고 완료까지 소유한다."""
+from collections import Counter
+import signal
+import subprocess
+import sys
+import time
+from i141_common import HERE,RES,read,save,now
+import i141_prepare as prep
+import i141_run as run
+
+
+def main():
+    gate=read(RES/'tests/technical_gate.json')
+    choice=read(RES/'tests/throughput_choice.json')
+    assert gate['passed'] is True
+    assert gate['main_max_new_tokens']==2048
+    rr=read(RES/'requests/main.json')
+    assert len(set(r['patient_id'] for r in rr))==6
+    count=Counter(r['condition'] for r in rr)
+    tech=run.verify_job(RES/'jobs/tech2048_w2','technical2048')
+    means={c:sum(r['wall_s'] for r in tech if r['condition']==c)/sum(r['condition']==c for r in tech) for c in count}
+    workers=choice['selected_workers']
+    wall_ratio=choice['w4_generation_wall_s']/choice['w2_generation_wall_s'] if workers==4 else 1.
+    weighted_wall=sum(count[c]*means[c] for c in count)/2*wall_ratio
+    save(RES/'pre_main_decision.json',{'created_at':now(),'patients':6,'requests':dict(count),'total_requests':len(rr),
+         'workers':workers,'GPU_permitted':run.allowed(),'admission_peak_mib':choice['admission_peak_mib'],
+         'max_new_tokens':2048,'estimated_generation_wall_s':weighted_wall,'estimate':True,
+         'estimated_basis':'2048 기술 출력의 조건별 평균 처리시간과 개발 병렬 처리량 비율. 대기/로딩/평가 별도.',
+         'stop_conditions':'자식 오류/OOM/입력 또는 source hash 불일치 시 중단. 고정 요청 미완료는 완료 아님.',
+         'scope_changes':'없음; 고정6명/385개 slice multiset/동일 prompt·metric 유지',
+         'resume':'동일 protocol 아래 고유 claim과 worker JSONL에 저장된 완료 요청 재생성 안 함'})
+    prep.CODE=prep.CODE+['i141_cap_control.py','i141_execute.py','i141_finish.py']
+    prep.lock('main')
+    cmd=[sys.executable,str(HERE/'i141_run.py'),'launch','--stage','main','--job',str(RES/'jobs/main'),
+         '--workers',str(workers),'--peak',str(choice['admission_peak_mib'])]
+    with (RES/'main_supervisor.log').open('xb') as f:
+        proc=subprocess.Popen(cmd,stdout=f,stderr=subprocess.STDOUT)
+        print({'main_supervisor_pid':proc.pid,'requests':len(rr),'workers':workers,
+               'estimated_generation_minutes':weighted_wall/60},flush=True)
+        try:
+            rc=proc.wait()
+        finally:
+            if proc.poll() is None:
+                proc.send_signal(signal.SIGINT)
+                try:
+                    proc.wait(timeout=60)
+                except subprocess.TimeoutExpired:
+                    proc.terminate()
+                    proc.wait()
+    save(RES/'main_exit.json',{'created_at':now(),'returncode':rc,'supervisor_pid':proc.pid})
+    assert rc==0,'본생성 오류: main_supervisor.log 확인'
+    result=run.verify_job(RES/'jobs/main','main')
+    assert len(result)==len(rr)
+    print({'generation_complete':len(result),'exit_code':rc},flush=True)
+
+
+if __name__=='__main__':
+    main()
