+    rows = [json.loads(l) for l in open("results/iter_041/requests/requests_V96_JBA.jsonl")][:3]
+    check("JBA_rows_targets_and_cond", all(r["targets"] == ["qA", "qB"] and r["cond"] == "J-short-rev" for r in rows))
