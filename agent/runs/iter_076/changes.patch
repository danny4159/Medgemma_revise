@@ -0,0 +1,77 @@
+"""iter_076 비용 보고: results/iter_076/cost/{F,R,C,H}_block{1..4}.json (+blocks_ledger.json)에서 paired block 비율을 계산한다.
+
+- 전체 시간 = 원 T2 읽기부터 답변 저장까지 + 모델/RF 적재 포함(wall_incl_load_s) / 적재 제외(process_s)를 모두 보고. VLM best는 eval report의 held primary가 더 좋은 적응 VLM.
+- 원 계획 음성 투자 판단의 비용 조건: 네 block 모두 (C 전체 시간 / best VLM 전체 시간) <= 0.5 (적재 포함 기준을 정식 flag로, 제외 기준은 보조).
+- 정합성: 같은 시스템의 block 간 답변 동일 여부, F/R 답변이 V8 생성 출력(같은 adapter)과 일치하는지.
+- GPU device-seconds: F/R/C는 GPU 1장 점유(wall x 1), H는 CPU 작업(GPU 0)으로 표기. GT anatomy(mask) 획득 비용은 미측정 oracle 비용.
+결과: results/iter_076/cost/cost_report.json (존재하면 중단).
+"""
+import glob, json, os, sys
+
+import numpy as np
+
+OUT = 'results/iter_076'
+COST = f'{OUT}/cost'
+
+
+def main():
+    dst = f'{COST}/cost_report.json'
+    if os.path.exists(dst):
+        sys.exit('exists')
+    blk = {s: {} for s in 'FRCH'}
+    for f in sorted(glob.glob(f'{COST}/*_block*.json')):
+        d = json.load(open(f))
+        if 'system' in d:
+            blk[d['system']][d['block']] = d
+    nb = sorted(set(blk['F']) & set(blk['R']) & set(blk['C']) & set(blk['H']))
+    if len(nb) != 4:
+        sys.exit(f'need 4 complete blocks, have {nb}')
+    ledger = json.load(open(f'{COST}/blocks_ledger.json'))
+    if any(x['rc'] != 0 for x in ledger):
+        sys.exit('a cost worker failed')
+    rep = json.load(open(f'{OUT}/eval/report.json'))
+    held = {n: rep['systems'][n]['held']['class_std_mae'] for n in ('F_adapted', 'R_adapted')}
+    best = min(held, key=lambda n: (held[n], n))
+    bv = best[0]
+    res = {'best_vlm': best, 'held_primary': held, 'blocks': {}, 'n_requests': {s: blk[s][nb[0]]['n_requests'] for s in 'FRCH'}}
+    for b in nb:
+        r = {}
+        for s in 'FRCH':
+            d = blk[s][b]
+            r[s] = {'wall_incl_load_s': d['wall_incl_load_s'], 'process_s': d['process_s'], 'load_s': d['load_s'], 'per_request_s_mean': d['per_request_s_mean'],
+                    'gpu_device_seconds_incl_load': d['wall_incl_load_s'] if s != 'H' else 0.0, 'gpu_device_seconds_excl_load': d['process_s'] if s != 'H' else 0.0}
+        for s in 'CH':
+            r[f'{s}_over_bestVLM_incl_load'] = r[s]['wall_incl_load_s'] / r[bv]['wall_incl_load_s']
+            r[f'{s}_over_bestVLM_excl_load'] = r[s]['process_s'] / r[bv]['process_s']
+        res['blocks'][str(b)] = r
+    res['flags'] = {'C_le_half_of_bestVLM_all4_blocks_incl_load': all(res['blocks'][str(b)]['C_over_bestVLM_incl_load'] <= 0.5 for b in nb),
+                    'C_le_half_of_bestVLM_all4_blocks_excl_load': all(res['blocks'][str(b)]['C_over_bestVLM_excl_load'] <= 0.5 for b in nb),
+                    'H_le_half_of_bestVLM_all4_blocks_incl_load': all(res['blocks'][str(b)]['H_over_bestVLM_incl_load'] <= 0.5 for b in nb),
+                    'H_le_half_of_bestVLM_all4_blocks_excl_load': all(res['blocks'][str(b)]['H_over_bestVLM_excl_load'] <= 0.5 for b in nb)}
+    res['ratio_ranges'] = {k: [min(res['blocks'][str(b)][k] for b in nb), max(res['blocks'][str(b)][k] for b in nb)] for k in
+                           ('C_over_bestVLM_incl_load', 'C_over_bestVLM_excl_load', 'H_over_bestVLM_incl_load', 'H_over_bestVLM_excl_load')}
+    # 정합성
+    res['answers_identical_across_blocks'] = {s: all(blk[s][b]['answers'] == blk[s][nb[0]]['answers'] for b in nb) for s in 'FRCH'}
+    sel = json.load(open(f'{OUT}/select_final.json'))['final']
+    agree = {}
+    for v in 'FR':
+        gdir = f"{OUT}/gen/V8/{v}_lr{sel[v]['lr']}_ep{sel[v]['epoch']:02d}"
+        recs = {}
+        for f in glob.glob(f'{gdir}/gen_worker*.jsonl'):
+            for ln in open(f):
+                if ln.strip():
+                    x = json.loads(ln)
+                    recs[x['id']] = x['parsed']
+        ans = blk[v][nb[0]]['answers']
+        agree[v] = {'n': len(ans), 'n_equal_to_v8_generation_same_adapter': sum(1 for k, a in ans.items() if recs.get(k) == a)}
+    res['f_r_answers_vs_v8_generation'] = agree
+    res['notes'] = ['GT anatomy(mask) 획득 비용은 모든 시스템에서 미측정(oracle 영역 사용)', 'H는 원 volume의 image+mask read, PyRadiomics, RF predict를 포함하며 RF 학습/적재는 load로 분리',
+                    'GPU device-seconds는 점유 GPU 1장 x wall 기준이며 H는 CPU 작업']
+    tmp = dst + '.tmp'
+    json.dump(res, open(tmp, 'w'), indent=1)
+    os.replace(tmp, dst)
+    print(json.dumps({'flags': res['flags'], 'ratio_ranges': res['ratio_ranges'], 'agree': agree, 'identical': res['answers_identical_across_blocks']}, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp76_cpred.py b/sp76_cpred.py
new file mode 100644
index 0000000..4d1cc3b
--- /dev/null
+++ b/sp76_cpred.py
@@ -0,0 +1,98 @@
+"""iter_076: iter_075에서 선택·고정한 C(ResNet18)/H(radiomics RF)의 E24 예측을 새 결과 경로에 생성한다. 선택·학습은 재실행하지 않는다.
+
+sp75_c.py / sp75_h.py는 수정하지 않고 import해서 같은 함수를 쓴다(선택 파일의 code hash가 현재 파일과 같을 때만 실행 = 읽기 전용 재사용).
+사용: python sp76_cpred.py C|H --out results/iter_076/pred --lock results/iter_076/eval/eval_lock.json [--gpu 0]
+E24 예측은 사전 eval_lock이 있을 때만 생성한다. 출력이 존재하면 중단.
+"""
+import argparse, hashlib, json, os, sys, time
+
+SEL_DIR = {'C': 'results/iter_075/C', 'H': 'results/iter_075/H'}
+
+
+def sha_file(p):
+    return hashlib.sha256(open(p, 'rb').read()).hexdigest()
+
+
+def check_lock(path):
+    lock = json.load(open(path))
+    for f, h in lock['files'].items():
+        if sha_file(f) != h:
+            sys.exit(f'locked file changed: {f}')
+    return lock
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('system', choices=['C', 'H'])
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--lock', required=True)
+    ap.add_argument('--split', default='E24')
+    ap.add_argument('--gpu', default=None)
+    a = ap.parse_args()
+    lock = check_lock(a.lock)
+    if a.gpu is not None:
+        inh = os.environ.get('CUDA_VISIBLE_DEVICES', '').split(',')
+        if a.gpu not in inh:
+            sys.exit(f'gpu {a.gpu} not in inherited {inh}')
+        os.environ['CUDA_VISIBLE_DEVICES'] = a.gpu
+    out_path = f'{a.out}/pred_{a.system}_{a.split}.json'
+    if lock['json_systems'].get(a.system) != out_path:
+        sys.exit(f'{out_path} not registered in lock')
+    if os.path.exists(out_path):
+        sys.exit('prediction exists')
+    os.makedirs(a.out, exist_ok=True)
+    sel_dir = SEL_DIR[a.system]
+    sel = json.load(open(f'{sel_dir}/selection.json'))
+    for f, h in sel['code'].items():
+        if sha_file(f) != h:
+            sys.exit(f'code changed since selection: {f}')
+    t0 = time.time()
+    import numpy as np
+    import sp75_data as D
+    if sel['manifest_sha256'] != sha_file(f'{D.DATA}/manifest.json'):
+        sys.exit('manifest changed since selection')
+    rows_all = D.load_manifest()['rows']
+    D.load_split()
+    rows = sorted([r for r in rows_all if r['split'] == a.split and not r['excluded']], key=lambda r: (int(r['patient']), r['ordinal']))
+    if a.system == 'C':
+        import torch
+        import sp75_c as C
+        s = sel['selected']
+        ck = f"{sel_dir}/lr{s['lr']}/epoch_{s['epoch']:02d}.pt"
+        C.check_rows(rows)
+        net = C.Net(torch)
+        blob = torch.load(ck, map_location='cpu', weights_only=True)
+        net.trunk.load_state_dict(blob['trunk'])
+        net.head.load_state_dict(blob['head'])
+        for m in net.modules():
+            m.cuda()
+        tens = [C.row_tensor(r) for r in rows]
+        pr = C.evaluate(torch, net, rows, tens)
+        meta = {'checkpoint': ck, 'checkpoint_sha256': sha_file(ck)}
+    else:
+        import sp75_h as H
+        from sklearn.ensemble import RandomForestClassifier
+        s = sel['selected']
+        tr = sorted([r for r in rows_all if r['split'] == 'T24' and r['position_set'] == 'supervised' and not r['excluded']], key=lambda r: (int(r['patient']), r['ordinal']))
+        cache = json.load(open(f'{sel_dir}/features_T24_V8.json'))
+        Xtr, names = H.matrix(tr, cache)
+        med, keep = H.prep_fit(Xtr)
+        rf = RandomForestClassifier(n_estimators=500, random_state=17, n_jobs=4, **s['cfg']).fit(H.prep_apply(Xtr, med, keep), np.array([r['grade'] for r in tr]))
+        ec = H.feats_for(rows, H.extractor(), f'{a.out}/features_{a.split}.json')
+        X, _ = H.matrix(rows, ec, names)
+        p_ = rf.predict_proba(H.prep_apply(X, med, keep))
+        pr = np.zeros((len(rows), 5))
+        for j, c in enumerate(list(rf.classes_)):
+            pr[:, c - 1] = p_[:, j]
+        meta = {'features_T24_V8_sha256': sha_file(f'{sel_dir}/features_T24_V8.json')}
+    preds = [{'id': r['id'], 'patient': r['patient'], 'ordinal': r['ordinal'], 'position_set': r['position_set'], 'probs': [float(x) for x in pr[i]],
+              'pred': int(np.argmax(pr[i])) + 1} for i, r in enumerate(rows)]
+    tmp = out_path + '.tmp'
+    json.dump({'system': a.system, 'selected': s, 'selection_sha256': sha_file(f'{sel_dir}/selection.json'), 'split': a.split, 'n': len(preds), 'preds': preds,
+               'elapsed_s': time.time() - t0, **meta}, open(tmp, 'w'), indent=1)
+    os.replace(tmp, out_path)
+    print('wrote', len(preds), out_path)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp76_freeze.py b/sp76_freeze.py
new file mode 100644
index 0000000..68490ce
--- /dev/null
+++ b/sp76_freeze.py
@@ -0,0 +1,90 @@
+"""iter_076 동결 검사 (GPU 1장): LoRA parameter 객체와 비LoRA parameter를 정확히 분리하고 실제 update 전후 전체 byte digest를 비교한다.
+
+PASS 조건(모두): 이름 정규화 충돌 없음, 비LoRA/LoRA parameter 수·numel·byte > 0, 비LoRA requires_grad=0, optimizer가 LoRA 전체만 포함(비LoRA 0),
+3회 실제 optimizer update 후 비LoRA exact digest 불변 + LoRA digest 변화 + LoRA parameter 일부 값 변화, 이전 base_digest(정규화 이름) 도 불변.
+또 iter_075 tech_F.json의 base_frozen digest(e3e19f4387647450)가 표준 빈 입력 SHA256(e3b0c44298fc1c14...)이 아님을 대조하고 현재 정확한 parameter 집합·byte 수를 기록한다.
+결과 파일이 존재하면 중단. 실패(FAIL)이면 비정상 종료.
+사용: python sp76_freeze.py --out results/iter_076/tests/freeze_check.json --gpu 0
+"""
+import argparse, hashlib, json, os, sys
+
+import sp75_data as D
+import sp75_vlm as V
+from rsna_diag import generate, lora
+from rsna_diag import train as T
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--gpu', default=None)
+    a = ap.parse_args()
+    if a.gpu is not None:
+        inh = os.environ.get('CUDA_VISIBLE_DEVICES', '').split(',')
+        if a.gpu not in inh:
+            sys.exit(f'gpu {a.gpu} not in inherited {inh}')
+        os.environ['CUDA_VISIBLE_DEVICES'] = a.gpu
+    if os.path.exists(a.out):
+        sys.exit('exists')
+    import torch
+    T.seed_all(torch, 17)
+    man = D.load_manifest()
+    rows = sorted([r for r in man['rows'] if r['split'] == 'T24' and r['position_set'] == 'supervised' and not r['excluded']], key=lambda r: (int(r['patient']), r['ordinal']))[:2]
+    _, proc, model = generate.load_model()
+    res = {'empty_sha256': hashlib.sha256(b'').hexdigest()}
+    base_pre = lora.base_digest(model)
+    res['iter075_style_base_digest_prefix'] = base_pre[:16]
+    res['iter075_digest_equals_empty_input_sha256'] = base_pre == res['empty_sha256']
+    res['iter075_recorded_digest_prefix_e3e19f4387647450_matches_now'] = base_pre[:16] == 'e3e19f4387647450'
+    names = lora.apply_lora(model, 16, 32, 0.0, seed=17)
+    params = list(lora.lora_params(model).values())
+    opt = torch.optim.AdamW(params, lr=2e-4, weight_decay=0.01)
+    res['split'] = lora.split_report(model, params)
+    res['n_lora_targets'] = len(names)
+    n0, c0, b0 = lora.exact_digest(model)
+    l0, lc0, lb0 = lora.exact_digest(model, lora=True)
+    res['non_lora'] = {'digest_before': n0[:16], 'n_params': c0, 'n_bytes': b0}
+    res['lora_before'] = {'digest': l0[:16], 'n_params': lc0, 'n_bytes': lb0}
+    snap0 = lora.lora_state_dict(model)
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={'use_reentrant': False})
+    model.config.use_cache = False
+    model.train()
+    losses = []
+    for it in range(3):
+        for r in rows:
+            ex = V.build_example(proc, V.load_images(r['inputs']['F']), V.PROMPTS['F'], str(r['grade']))
+            ls, n = V.loss_sum(torch, model, V.to_cuda(V.collate([ex], proc.tokenizer.pad_token_id)))
+            (ls / (2 * len(rows))).backward()
+            losses.append(float(ls) / n)
+        gn = float(torch.nn.utils.clip_grad_norm_(params, 1.0))
+        assert gn == gn and gn < float('inf')
+        opt.step()
+        opt.zero_grad(set_to_none=True)
+    n1, c1, b1 = lora.exact_digest(model)
+    l1, _, _ = lora.exact_digest(model, lora=True)
+    snap1 = lora.lora_state_dict(model)
+    res['non_lora']['digest_after'] = n1[:16]
+    res['non_lora']['unchanged'] = n1 == n0 and (c1, b1) == (c0, b0)
+    res['lora_after'] = {'digest': l1[:16], 'changed': l1 != l0, 'n_tensors_changed': sum(1 for k in snap0 if not torch.equal(snap0[k], snap1[k]))}
+    base_post = lora.base_digest(model)
+    res['iter075_style_base_digest_unchanged_after_lora_and_updates'] = base_pre == base_post
+    res['losses'] = losses
+    sp = res['split']
+    res['checks'] = {'counts_positive': all(sp[k] > 0 for k in ('n_lora', 'n_non_lora', 'numel_lora', 'numel_non_lora', 'bytes_lora', 'bytes_non_lora')),
+                     'non_lora_requires_grad_zero': sp['non_lora_requires_grad'] == 0 and sp['lora_requires_grad_false'] == 0,
+                     'optimizer_only_lora': sp['optimizer_contains_non_lora'] == 0 and sp['optimizer_lora_covered'] and sp['optimizer_n_params'] == sp['n_lora'],
+                     'non_lora_exact_digest_unchanged': res['non_lora']['unchanged'], 'lora_changed': res['lora_after']['changed'] and res['lora_after']['n_tensors_changed'] > 0,
+                     'iter075_style_digest_unchanged': res['iter075_style_base_digest_unchanged_after_lora_and_updates'],
+                     'finite_losses': all(x == x and abs(x) < 1e6 for x in losses)}
+    res['PASS'] = all(res['checks'].values())
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    tmp = a.out + '.tmp'
+    json.dump(res, open(tmp, 'w'), indent=1)
+    os.replace(tmp, a.out)
+    print(json.dumps({'PASS': res['PASS'], 'checks': res['checks'], 'split': sp, 'non_lora': res['non_lora'], 'e3e19f_vs_empty': [res['iter075_digest_equals_empty_input_sha256'],
+                                                                                                                                res['iter075_recorded_digest_prefix_e3e19f4387647450_matches_now']]}, indent=1))
+    sys.exit(0 if res['PASS'] else 1)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/sp76_recover.py b/sp76_recover.py
new file mode 100644
index 0000000..e0366ad
--- /dev/null
+++ b/sp76_recover.py
@@ -0,0 +1,63 @@
+"""iter_076 복구 manifest: 기준 계획 hash, 코드 HEAD, 호스트 프로세스·GPU 상태, iter_075 보존 산출물의 sha256과 lock 소유권을 기록한다.
+원본(iter_075)은 읽기만 한다. 결과: results/iter_076/recovery_manifest.json (존재하면 중단).
+"""
+import hashlib, json, os, subprocess, sys, time
+
+OUT = 'results/iter_076/recovery_manifest.json'
+BASE_PLAN = '../agent/runs/iter_075/plan.md'
+BASE_PLAN_SHA = 'ea40768f17ae65b10f0027ca9ca9423205bb106198ebf891af7ec0bf17a73b8b'
+
+
+def sha(p):
+    h = hashlib.sha256()
+    with open(p, 'rb') as f:
+        for b in iter(lambda: f.read(1 << 22), b''):
+            h.update(b)
+    return h.hexdigest()
+
+
+def procs():
+    out = []
+    for p in os.listdir('/proc'):
+        if p.isdigit():
+            try:
+                cmd = open(f'/proc/{p}/cmdline', 'rb').read().replace(b'\0', b' ').decode()[:200]
+                st = open(f'/proc/{p}/stat').read().split()
+            except Exception:
+                continue
+            if any(k in cmd for k in ('sp75_', 'sp76_', 'rsna_diag')):
+                out.append({'pid': int(p), 'cmd': cmd, 'start_ticks': st[21]})
+    return out
+
+
+def main():
+    if os.path.exists(OUT):
+        sys.exit('exists')
+    res = {'ts': time.time(), 'base_plan': BASE_PLAN, 'base_plan_sha256_expected': BASE_PLAN_SHA, 'base_plan_sha256_actual': sha(BASE_PLAN)}
+    res['base_plan_matches'] = res['base_plan_sha256_actual'] == BASE_PLAN_SHA
+    res['git_head'] = subprocess.check_output(['git', 'rev-parse', 'HEAD']).decode().strip()
+    res['git_status_short'] = subprocess.check_output(['git', 'status', '--short']).decode().splitlines()
+    res['host_related_processes'] = procs()
+    res['nvidia_compute_apps'] = subprocess.run(['nvidia-smi', '--query-compute-apps=pid,used_memory,gpu_uuid', '--format=csv,noheader'], capture_output=True, text=True).stdout.strip().splitlines()
+    res['nvidia_gpus'] = subprocess.run(['nvidia-smi', '--query-gpu=index,uuid,memory.used,memory.total', '--format=csv,noheader'], capture_output=True, text=True).stdout.strip().splitlines()
+    res['cuda_visible_devices'] = os.environ.get('CUDA_VISIBLE_DEVICES')
+    keep = {}
+    base = 'results/iter_075'
+    for root, _, files in os.walk(base):
+        for f in files:
+            p = os.path.join(root, f)
+            if f.endswith('.lock'):
+                keep[p] = {'lock_file_present': True, 'content': open(p).read()[:300]}
+            elif any(x in p for x in ('/tests/resume/', '/tests/tech_', '/C/selection', '/H/selection', '/data/manifest', 'env_record', 'fixtures_cpu')) and os.path.getsize(p) < (2 << 30):
+                keep[p] = {'sha256': sha(p), 'bytes': os.path.getsize(p)}
+    res['iter_075_preserved_files'] = keep
+    res['iter_075_missing_expected'] = [p for p in ('results/iter_075/tests/resume/ref/epoch_02/val_ce.json', 'results/iter_075/tests/resume/A/epoch_02/val_ce.json',
+                                                    'results/iter_075/tests/resume/B') if not os.path.exists(p)]
