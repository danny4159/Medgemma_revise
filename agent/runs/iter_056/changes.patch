diff --git a/msd56_breakdown.py b/msd56_breakdown.py
new file mode 100644
index 0000000..c115cf5
--- /dev/null
+++ b/msd56_breakdown.py
@@ -0,0 +1,68 @@
+"""iter_056 사후 탐색 분해(사전 판정 규칙에 쓰지 않음): 구간 위치(slab index)별 prevalence·조건별 정답률, 위치-only in-sample 상한 prior,
+양성 구간의 병변 크기·coverage 층별 민감도, FN/FP 사례 목록.  python msd56_breakdown.py EVAL_DIR
+"""
+import json
+import sys
+
+import numpy as np
+
+d = sys.argv[1]
+T = json.load(open(f"{d}/per_slab.json"))
+conds = sorted({t["cond"] for t in T})
+out = {"note": "post-hoc exploratory; E is development data"}
+out["by_slab_index"] = {}
+for s in range(6):
+    row = {}
+    for cn in conds:
+        tt = [t for t in T if t["cond"] == cn and t["slab"] == s]
+        P = [t for t in tt if t["present"]]
+        N = [t for t in tt if not t["present"]]
+        row[cn] = {"n": len(tt), "P": len(P), "N": len(N), "TP": sum(t["answer"] == "PRESENT" for t in P),
+                   "TN": sum(t["answer"] == "ABSENT" for t in N)}
+    out["by_slab_index"][s] = row
+# 위치-only in-sample 상한: 각 slab index에서 다수 class를 예측
+tt = [t for t in T if t["cond"] == conds[0]]
+pos_pred = {}
+for s in range(6):
+    x = [t for t in tt if t["slab"] == s]
+    pos_pred[s] = sum(t["present"] for t in x) >= len(x) / 2
+P = [t for t in tt if t["present"]]
+N = [t for t in tt if not t["present"]]
+sens = np.mean([pos_pred[t["slab"]] for t in P])
+spec = np.mean([not pos_pred[t["slab"]] for t in N])
+out["position_only_insample_prior"] = {"pred_present_by_slab_index": {str(k): bool(v) for k, v in pos_pred.items()},
+                                         "sens": float(sens), "spec": float(spec), "BA": float((sens + spec) / 2),
+                                         "caveat": "E 자체에서 맞춘 in-sample 상한이며 실제 baseline 아님"}
+# 병변 크기 분위
+pos = [t for t in tt if t["present"]]
+q = np.quantile([t["ann_voxels"] for t in pos], [0.25, 0.5, 0.75])
+out["ann_voxels_quartiles_pos"] = q.tolist()
+out["sens_by_voxel_quartile"] = {}
+for cn in conds:
+    if cn == "TEXT":
+        continue
+    pp = [t for t in T if t["cond"] == cn and t["present"]]
+    bins = [(0, q[0]), (q[0], q[1]), (q[1], q[2]), (q[2], 1e12)]
+    out["sens_by_voxel_quartile"][cn] = [{"range": [float(lo), float(hi)], "n": sum(lo < t["ann_voxels"] <= hi or (lo == 0 and t["ann_voxels"] <= hi) for t in pp),
+                                          "TP": sum(((lo < t["ann_voxels"] <= hi) or (lo == 0 and t["ann_voxels"] <= hi)) and t["answer"] == "PRESENT" for t in pp)}
+                                         for lo, hi in bins]
+# FN / FP 사례 (DENSE)
+for cn in ("DENSE", "U8", "O8"):
+    c = [t for t in T if t["cond"] == cn]
+    out[f"{cn}_FN"] = [{"case": t["case"], "slab": t["slab"], "ann_voxels": t["ann_voxels"], "n_pos_slices": t["n_pos_slices"],
+                        "missed_by_selection": t["missed_positive"]} for t in c if t["present"] and t["answer"] != "PRESENT"]
+    out[f"{cn}_FP_cases"] = sorted({t["case"] for t in c if (not t["present"]) and t["answer"] == "PRESENT"})
+# 구간 단위 DENSE vs U8 불일치 중 coverage 손실과 일치하는 것
+dn = {(t["case"], t["slab"]): t for t in T if t["cond"] == "DENSE"}
+u8 = {(t["case"], t["slab"]): t for t in T if t["cond"] == "U8"}
+o8 = {(t["case"], t["slab"]): t for t in T if t["cond"] == "O8"}
+ok = lambda t: (t["answer"] == "PRESENT") == t["present"]
+lost = [k for k in dn if dn[k]["present"] and ok(dn[k]) and not ok(u8[k])]
+out["U8_loses_DENSE_correct_positive"] = {"n": len(lost), "of_which_selection_missed_all_annotation": sum(bool(u8[k]["missed_positive"]) for k in lost)}
+lost_o = [k for k in dn if dn[k]["present"] and ok(dn[k]) and not ok(o8[k])]
+out["O8_loses_DENSE_correct_positive"] = {"n": len(lost_o)}
+out["answer_flips_DENSE_vs_U8_all"] = sum(dn[k]["answer"] != u8[k]["answer"] for k in dn)
+out["answer_flips_U8_vs_O8_all"] = sum(u8[k]["answer"] != o8[k]["answer"] for k in dn)
+out["U8_O8_identical_request_rows"] = sum(u8[k]["rid"] == o8[k]["rid"] for k in dn)
+json.dump(out, open(f"{d}/breakdown.json", "w"), indent=1, default=int)
+print(json.dumps(out, indent=1, default=int))
diff --git a/msd56_data.py b/msd56_data.py
new file mode 100644
index 0000000..142c67d
--- /dev/null
+++ b/msd56_data.py
@@ -0,0 +1,220 @@
+"""iter_056 MSD Task01_BrainTumour FLAIR 구간 자료: 선택·추출·구간/정답/조건 생성.
+
+원칙
+- 채널은 dataset.json(modality["0"]=="FLAIR")에서 읽는다. 정답=모든 비배경 label(1,2,3)의 합집합 (전부 tumour/oedema 계열; dataset.json labels).
+- image·mask는 동일 함수(canonical RAS 재배열 + 동일 축 변환)로 처리한다. 구간은 FLAIR nonzero 범위만으로 정한다(mask 미사용).
+- 렌더링: FLAIR volume 전체 min/max로 uint8 선형 정규화(구간별/slice별 재정규화 없음), 동일 RGB 3채널.
+- 표시 방향: slice[k] = arr_RAS[::-1, :, k].T[::-1]  -> 행: anterior가 위, 열: patient right가 영상 왼쪽(radiological).
+사용: python msd56_data.py select | extract | build
+"""
+import hashlib
+import io
+import json
+import os
+import random
+import sys
+import tarfile
+
+import numpy as np
+
+ROOT = "results/iter_056"
+TAR = f"{ROOT}/source/Task01_BrainTumour.tar"
+DATA = f"{ROOT}/data"
+SEED = 56
+N_D, N_E, N_SLAB, MIN_SLAB = 6, 48, 6, 8
+VERSION = "msd56_data_v1"
+
+
+def sha256(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def training_ids():
+    d = json.load(open(f"{ROOT}/source/dataset.json"))
+    assert d["modality"]["0"] == "FLAIR", d["modality"]
+    ids = []
+    for e in d["training"]:
+        assert e["image"].startswith("./imagesTr/") and e["label"].startswith("./labelsTr/")
+        a, b = e["image"].rsplit("/", 1)[1], e["label"].rsplit("/", 1)[1]
+        assert a == b and not a.startswith("._")
+        ids.append(a[:-len(".nii.gz")])
+    assert len(ids) == len(set(ids)) == 484
+    return sorted(ids)
+
+
+def case_paths(cid):
+    return f"{DATA}/raw/{cid}_img.nii.gz", f"{DATA}/raw/{cid}_lbl.nii.gz"
+
+
+def load_case(cid):
+    """returns flair float32 (RAS canonical), mask uint8 (same), header info dict."""
+    import nibabel as nib
+    ip, lp = case_paths(cid)
+    img, lbl = nib.load(ip), nib.load(lp)
+    if img.shape[:3] != lbl.shape[:3] or not np.allclose(img.affine, lbl.affine, atol=1e-4):
+        raise ValueError(f"{cid}: image/label grid mismatch {img.shape} {lbl.shape}")
+    assert img.ndim == 4 and img.shape[3] == 4
+    info = {"shape": list(img.shape), "label_shape": list(lbl.shape), "zooms": [float(z) for z in img.header.get_zooms()[:3]],
+            "orig_axcodes": "".join(nib.aff2axcodes(img.affine)), "affine": img.affine.round(4).tolist(),
+            "dtype": str(img.get_data_dtype())}
+    can = nib.as_closest_canonical(img)
+    canl = nib.as_closest_canonical(lbl)
+    info["canon_axcodes"] = "".join(nib.aff2axcodes(can.affine))
+    assert info["canon_axcodes"] == "RAS"
+    flair = np.asarray(can.dataobj[..., 0], dtype=np.float32)
+    mask = np.asarray(canl.dataobj).astype(np.uint8)
+    if not np.isfinite(flair).all():
+        raise ValueError(f"{cid}: non-finite FLAIR")
+    return flair, mask, info
+
+
+def nonzero_range(flair):
+    nz = np.where((flair != 0).reshape(-1, flair.shape[2]).any(axis=0))[0]
+    return int(nz[0]), int(nz[-1])
+
+
+def make_slabs(z0, z1, n=N_SLAB):
+    L = z1 - z0 + 1
+    base, rem = divmod(L, n)
+    out, s = [], z0
+    for i in range(n):
+        ln = base + (1 if i < rem else 0)
+        out.append([s, s + ln - 1])
+        s += ln
+    assert out[-1][1] == z1
+    return out
+
+
+def render(flair, k, vmin, vmax):
+    sl = flair[::-1, :, k].T[::-1]
+    u = np.clip((sl - vmin) / (vmax - vmin), 0, 1) * 255.0
+    g = np.round(u).astype(np.uint8)
+    return np.repeat(g[:, :, None], 3, axis=2)
+
+
+def mask_slice(mask, k):
+    return (mask[::-1, :, k].T[::-1] > 0)
+
+
+def equi(n, m):
+    """양 끝 포함 결정적 등간격 m개 index (0..n-1), 중복 없어야 함."""
+    idx = [int(round(i * (n - 1) / (m - 1))) for i in range(m)]
+    assert len(set(idx)) == m, (n, m, idx)
+    return idx
+
+
+def conditions_for_slab(z0, z1, area):
+    """area: slab 내 slice별 annotation voxel 수(단면적) list. returns dict cond -> absolute slice list (inferior->superior)."""
+    n = z1 - z0 + 1
+    dense = list(range(z0, z1 + 1))
+    dense_note = "all"
+    if n > 85:
+        dense = [z0 + i for i in equi(n, 85)]
+        dense_note = "equispaced85"
+    u8 = [z0 + i for i in equi(n, 8)]
+    if sum(area) > 0:
+        order = sorted(range(n), key=lambda i: (-area[i], i))[:8]
+        o8 = sorted(z0 + i for i in order)
+    else:
+        o8 = list(u8)
+    return {"DENSE": dense, "U8": u8, "O8": o8}, dense_note
+
+
+def cmd_select():
+    os.makedirs(f"{DATA}/raw", exist_ok=True)
+    ids = training_ids()
+    t = tarfile.open(TAR)
+    hashes = {}
+    for cid in ids:
+        for kind in ("images", "labels"):
+            m = t.getmember(f"Task01_BrainTumour/{kind}Tr/{cid}.nii.gz")
+            hashes[f"{kind}/{cid}"] = (sha256(t.extractfile(m).read()), m.size)
+    img_dups = {}
+    for k, (h, _) in hashes.items():
+        if k.startswith("images/"):
+            img_dups.setdefault(h, []).append(k)
+    dup_groups = [v for v in img_dups.values() if len(v) > 1]
+    order = list(ids)
+    random.Random(SEED).shuffle(order)
+    json.dump({"seed": SEED, "n_training": len(ids), "shuffled_order": order,
+               "file_hashes": {k: {"sha256": h, "bytes": s} for k, (h, s) in hashes.items()},
+               "duplicate_image_file_groups": dup_groups, "version": VERSION},
+              open(f"{DATA}/case_order.json", "w"), indent=1)
+    print("n", len(ids), "dup groups", dup_groups)
+
+
+def extract_case(t, cid):
+    ip, lp = case_paths(cid)
+    for kind, p in (("images", ip), ("labels", lp)):
+        if os.path.exists(p):
+            continue
+        b = t.extractfile(f"Task01_BrainTumour/{kind}Tr/{cid}.nii.gz").read()
+        with open(p + ".part", "wb") as f:
+            f.write(b)
+        os.replace(p + ".part", p)
+
+
+def cmd_extract():
+    """고정 순서에서 FLAIR nonzero 범위만으로 적격(6 구간 각 >=8 slice)한 case를 D6, E48 순으로 채운다. mask는 정하는 데 사용하지 않는다."""
+    co = json.load(open(f"{DATA}/case_order.json"))
+    t = tarfile.open(TAR)
+    chosen, skipped = [], []
+    for cid in co["shuffled_order"]:
+        if len(chosen) >= N_D + N_E:
+            break
+        extract_case(t, cid)
+        flair, _, info = load_case(cid)
+        z0, z1 = nonzero_range(flair)
+        slabs = make_slabs(z0, z1)
+        if min(b - a + 1 for a, b in slabs) < MIN_SLAB:
+            skipped.append({"case": cid, "reason": f"slab<{MIN_SLAB}", "range": [z0, z1]})
+            continue
+        chosen.append({"case": cid, "split": "D" if len(chosen) < N_D else "E", "z_range": [z0, z1], "slabs": slabs,
+                       "vmin": float(flair.min()), "vmax": float(flair.max()), "info": info,
+                       "img_sha256": co["file_hashes"][f"images/{cid}"]["sha256"],
+                       "lbl_sha256": co["file_hashes"][f"labels/{cid}"]["sha256"]})
+    json.dump({"chosen": chosen, "skipped": skipped, "version": VERSION}, open(f"{DATA}/cases.json", "w"), indent=1)
+    print("chosen", len(chosen), "skipped", len(skipped))
+
+
+def cmd_build():
+    """구간별 정답·coverage·조건별 slice 선택과 PNG 렌더, requests 원본(manifest) 생성. GT는 manifest_gt.json에만 둔다."""
+    cs = json.load(open(f"{DATA}/cases.json"))["chosen"]
+    os.makedirs(f"{DATA}/png", exist_ok=True)
+    gt, inputs = [], {}
+    for c in cs:
+        flair, mask, _ = load_case(c["case"])
+        ann = mask > 0
+        for si, (a, b) in enumerate(c["slabs"]):
+            area = [int(ann[:, :, k].sum()) for k in range(a, b + 1)]
+            conds, dn = conditions_for_slab(a, b, area)
+            tot = sum(area)
+            row = {"case": c["case"], "split": c["split"], "slab": si, "z0": a, "z1": b, "n_slices": b - a + 1,
+                   "present": bool(tot > 0), "ann_voxels": tot, "n_pos_slices": int(sum(x > 0 for x in area)),
+                   "pos_slice_frac": float(sum(x > 0 for x in area)) / (b - a + 1), "max_slice_area": max(area),
+                   "dense_note": dn, "cond": {}}
+            for cn, sl in conds.items():
+                ar = [area[k - a] for k in sl]
+                row["cond"][cn] = {"slices": sl, "n": len(sl), "cov_pos_slices": int(sum(x > 0 for x in ar)),
+                                   "cov_voxels": int(sum(ar)),
+                                   "cov_max_area": max(ar),
+                                   "cov_frac_voxels": (sum(ar) / tot) if tot else None,
+                                   "cov_frac_pos_slices": (sum(x > 0 for x in ar) / row["n_pos_slices"]) if tot else None,
+                                   "cov_frac_max_area": (max(ar) / max(area)) if tot else None,
+                                   "missed_positive": bool(tot > 0 and sum(ar) == 0)}
+            gt.append(row)
+            for k in sorted({k for sl in conds.values() for k in sl}):
+                p = f"{DATA}/png/{c['case']}_z{k:03d}.png"
+                if not os.path.exists(p):
+                    from PIL import Image
+                    Image.fromarray(render(flair, k, c["vmin"], c["vmax"])).save(p + ".tmp.png")
+                    os.replace(p + ".tmp.png", p)
+                if p not in inputs:
+                    inputs[p] = sha256(open(p, "rb").read())
+    json.dump({"rows": gt, "version": VERSION}, open(f"{DATA}/gt_slabs.json", "w"), indent=1)
+    json.dump(inputs, open(f"{DATA}/png_sha256.json", "w"), indent=1)
+    print("slabs", len(gt), "pos", sum(r["present"] for r in gt), "pngs", len(inputs))
+
+
+if __name__ == "__main__":
+    {"select": cmd_select, "extract": cmd_extract, "build": cmd_build}[sys.argv[1]]()
diff --git a/msd56_eval.py b/msd56_eval.py
new file mode 100644
index 0000000..4939599
--- /dev/null
+++ b/msd56_eval.py
@@ -0,0 +1,239 @@
+"""iter_056 평가: 구간 단위 confusion/BA/sens/spec/invalid, case-cluster bootstrap, coverage 층별, 비용, 사전 규칙 판정.
+
+사용: python msd56_eval.py --split D|E --out-dir results/iter_056/eval_X --gen-dirs DIR[,DIR] [--model-tag medgemma]
+- 완료 검증(요청 전수 존재·중복 없음)을 evaluator 안에서 강제한다. invalid는 해당 class의 오답.
+- 판정 규칙 (사전 고정, plan Evaluation): basic_signal = (DENSE|O8) BA>=0.70 & sens,spec>=0.60 & TEXT 대비 BA>=0.10.
+"""
+import argparse
+import glob
+import json
+import os
+
+import numpy as np
+
+import msd56_run as R
+
+CONDS = ["DENSE", "U8", "O8", "TEXT"]
+B = 10000
+SEED = 56
+
+
+def load_records(gen_dirs, rows):
+    recs = {}
+    for d in gen_dirs:
+        for fn in sorted(glob.glob(os.path.join(d, "gen_worker*.jsonl"))):
+            for r in R.read_jsonl(fn):
+                if r["rid"] in recs:
+                    raise R.RunError(f"duplicate rid {r['rid']}")
+                recs[r["rid"]] = r
+    need = {r["rid"] for r in rows}
+    miss = need - set(recs)
+    extra = set(recs) - need
+    if miss or extra:
+        raise R.RunError(f"incomplete/extra records: missing={len(miss)} extra={len(extra)}")
+    return recs
+
+
+def confusion(items):
+    """items: list of (present_bool, answer or None)."""
+    tp = sum(1 for p, a in items if p and a == "PRESENT")
+    fn_ = sum(1 for p, a in items if p and a != "PRESENT")
+    tn = sum(1 for p, a in items if (not p) and a == "ABSENT")
+    fp = sum(1 for p, a in items if (not p) and a != "ABSENT")
+    inv_p = sum(1 for p, a in items if p and a is None)
+    inv_n = sum(1 for p, a in items if (not p) and a is None)
+    return tp, fn_, tn, fp, inv_p, inv_n
+
+
+def metrics(items):
+    tp, fn_, tn, fp, ip, in_ = confusion(items)
+    P, N = tp + fn_, tn + fp
+    sens = tp / P if P else None
+    spec = tn / N if N else None
+    ba = (sens + spec) / 2 if (P and N) else None
+    return {"n": len(items), "P": P, "N": N, "TP": tp, "FN": fn_, "TN": tn, "FP": fp, "invalid_pos": ip, "invalid_neg": in_,
+            "sens": sens, "spec": spec, "BA": ba, "invalid_rate": (ip + in_) / len(items) if items else None,
+            "acc": (tp + tn) / len(items) if items else None}
+
+
+def cluster_boot(by_case, fn, seed=SEED, b=B):
+    """by_case: {case: list of row dicts}; fn(list_of_rows)->float or None. 환자 대응이 불명확하므로 case를 cluster로 재표집."""
+    rng = np.random.default_rng(seed)
+    cases = sorted(by_case)
+    vals = []
+    for _ in range(b):
+        pick = rng.integers(0, len(cases), len(cases))
+        rows = [r for i in pick for r in by_case[cases[i]]]
+        v = fn(rows)
+        if v is not None:
+            vals.append(v)
+    if not vals:
+        return None
+    return [float(np.percentile(vals, 2.5)), float(np.percentile(vals, 97.5)), len(vals)]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--split", required=True)
+    ap.add_argument("--gen-dirs", required=True)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--model-tag", default="medgemma")
+    ap.add_argument("--requests", default=None)
+    ap.add_argument("--cond-map", default=None)
+    ap.add_argument("--conds", default=",".join(CONDS))
+    a = ap.parse_args()
+    conds = a.conds.split(",")
+    req_path = a.requests or f"results/iter_056/data/requests_{a.split}.jsonl"
+    cmap_path = a.cond_map or f"results/iter_056/data/cond_map_{a.split}.json"
+    rows = [json.loads(ln) for ln in open(req_path)]
+    cmap = json.load(open(cmap_path))
+    gt = {(r["case"], r["slab"]): r for r in json.load(open("results/iter_056/data/gt_slabs.json"))["rows"] if r["split"] == a.split}
+    recs = load_records(a.gen_dirs.split(","), rows)
+    table = []
+    for c in cmap:
+        if c["cond"] not in conds:
+            continue
+        g = gt[(c["case"], c["slab"])]
+        r = recs[c["rid"]]
+        cov = g["cond"].get(c["cond"])
+        table.append({"case": c["case"], "slab": c["slab"], "cond": c["cond"], "rid": c["rid"], "present": g["present"],
+                      "answer": r["answer"], "ended_eos": r["ended_eos"], "final_cap": r["final_cap"], "raw": r["suffix_text_raw"][:120],
+                      "n_images": r["n_images"], "n_input_tokens": r["n_input_tokens"], "runtime_s": r["runtime_s_total"],
+                      "ann_voxels": g["ann_voxels"], "n_pos_slices": g["n_pos_slices"],
+                      "missed_positive": (cov or {}).get("missed_positive"),
+                      "cov_frac_voxels": (cov or {}).get("cov_frac_voxels"),
+                      "cov_frac_pos_slices": (cov or {}).get("cov_frac_pos_slices"),
+                      "cov_frac_max_area": (cov or {}).get("cov_frac_max_area")})
+    n_expect = len(gt) * len(conds)
+    if len(table) != n_expect or len({(t["case"], t["slab"], t["cond"]) for t in table}) != n_expect:
+        raise R.RunError("evaluation matrix incomplete/duplicated")
+    os.makedirs(a.out_dir, exist_ok=True)
+    rep = {"split": a.split, "model_tag": a.model_tag, "n_slabs": len(gt), "n_cases": len({k[0] for k in gt}),
+           "prevalence": sum(g["present"] for g in gt.values()) / len(gt), "cond": {}, "paired": {}, "coverage": {}, "cost": {}}
+    by = {cn: [t for t in table if t["cond"] == cn] for cn in conds}
+    for cn in conds:
+        items = [(t["present"], t["answer"]) for t in by[cn]]
+        m = metrics(items)
+        bc = {}
+        for t in by[cn]:
+            bc.setdefault(t["case"], []).append(t)
+        m["BA_ci95"] = cluster_boot(bc, lambda rr: metrics([(t["present"], t["answer"]) for t in rr])["BA"])
+        m["sens_ci95"] = cluster_boot(bc, lambda rr: metrics([(t["present"], t["answer"]) for t in rr])["sens"])
+        m["spec_ci95"] = cluster_boot(bc, lambda rr: metrics([(t["present"], t["answer"]) for t in rr])["spec"])
+        m["non_eos"] = sum(1 for t in by[cn] if not t["ended_eos"])
+        m["answers"] = {k: sum(1 for t in by[cn] if t["answer"] == k) for k in ("PRESENT", "ABSENT", None)}
+        m["answers"] = {str(k): v for k, v in m["answers"].items()}
+        rep["cond"][cn] = m
+    allp = [(g["present"], "PRESENT") for g in gt.values()]
+    alla = [(g["present"], "ABSENT") for g in gt.values()]
+    rep["cond"]["CONST_PRESENT"] = metrics(allp)
+    rep["cond"]["CONST_ABSENT"] = metrics(alla)
+
+    def key(t):
+        return (t["case"], t["slab"])
+    pairs = [("DENSE", "TEXT"), ("O8", "TEXT"), ("U8", "TEXT"), ("U8", "DENSE"), ("O8", "DENSE"), ("O8", "U8")]
+    for x, y in pairs:
+        if x not in conds or y not in conds:
+            continue
+        bx = {key(t): t for t in by[x]}
+        by_ = {key(t): t for t in by[y]}
+        cl = {}
+        for k in bx:
+            cl.setdefault(k[0], []).append((bx[k], by_[k]))
+
+        def diff(rr):
+            mx = metrics([(p["present"], p["answer"]) for p, _ in rr])["BA"]
+            my = metrics([(q["present"], q["answer"]) for _, q in rr])["BA"]
+            return None if mx is None or my is None else mx - my
+        d = diff([pq for v in cl.values() for pq in v])
+        # 사건: x만 정답 / y만 정답, 사건이 분포한 case 수
+        def ok(t):
+            return (t["answer"] == "PRESENT") if t["present"] else (t["answer"] == "ABSENT")
+        better = {k[0] for k in bx if ok(bx[k]) and not ok(by_[k])}
+        worse = {k[0] for k in bx if ok(by_[k]) and not ok(bx[k])}
+        nb = sum(1 for k in bx if ok(bx[k]) and not ok(by_[k]))
+        nw = sum(1 for k in bx if ok(by_[k]) and not ok(bx[k]))
+        rep["paired"][f"{x}-{y}"] = {"BA_diff": d, "ci95": cluster_boot(cl, diff), "x_only_correct": nb, "y_only_correct": nw,
+                                      "n_cases_x_only": len(better), "n_cases_y_only": len(worse),
+                                      "n_cases_event": len(better | worse)}
+    # coverage / 층별
+    pos = [g for g in gt.values() if g["present"]]
+    med = float(np.median([g["ann_voxels"] for g in pos])) if pos else None
+    for cn in conds:
+        if cn == "TEXT":
+            continue
+        pt = [t for t in by[cn] if t["present"]]
+        cv = {"n_pos_slabs": len(pt), "missed_positive": sum(1 for t in pt if t["missed_positive"]),
+              "mean_cov_frac_voxels": float(np.mean([t["cov_frac_voxels"] for t in pt])) if pt else None,
+              "mean_cov_frac_pos_slices": float(np.mean([t["cov_frac_pos_slices"] for t in pt])) if pt else None,
+              "mean_cov_frac_max_area": float(np.mean([t["cov_frac_max_area"] for t in pt])) if pt else None}
+        sm = [t for t in pt if t["ann_voxels"] <= med]
+        lg = [t for t in pt if t["ann_voxels"] > med]
+        cv["sens_small_lesion(<=median voxels)"] = {"n": len(sm), "TP": sum(1 for t in sm if t["answer"] == "PRESENT")}
+        cv["sens_large_lesion(>median voxels)"] = {"n": len(lg), "TP": sum(1 for t in lg if t["answer"] == "PRESENT")}
+        cv["sens_missed_positive_slabs"] = {"n": sum(1 for t in pt if t["missed_positive"]),
+                                           "TP": sum(1 for t in pt if t["missed_positive"] and t["answer"] == "PRESENT")}
+        cv["median_ann_voxels_pos"] = med
+        rep["coverage"][cn] = cv
+    # 비용: 고유 요청 단위 (U8/O8 공유 요청은 한 번만 생성). 조건별 평균은 조건 행 기준.
+    for cn in conds:
+        rep["cost"][cn] = {"mean_runtime_s_per_condition_row": float(np.mean([t["runtime_s"] for t in by[cn]])),
+                           "mean_n_images": float(np.mean([t["n_images"] for t in by[cn]])),
+                           "mean_input_tokens": float(np.mean([t["n_input_tokens"] for t in by[cn]]))}
+    rep["cost"]["unique_requests"] = len(rows)
+    rep["cost"]["sum_runtime_s_unique"] = float(sum(r["runtime_s_total"] for r in recs.values()))
+    rep["cost"]["retries_to_2048"] = sum(1 for r in recs.values() if len(r["attempts"]) > 1)
+    rep["cost"]["peak_mem_alloc_gb_max"] = max(r["peak_mem_alloc_gb_max"] for r in recs.values())
+    rep["cost"]["peak_mem_reserved_gb_max"] = max(r["peak_mem_reserved_gb_max"] for r in recs.values())
+    # per-case 분포 (case별 정답 수)
+    rep["per_case_correct"] = {cn: {} for cn in conds}
+    for cn in conds:
+        for t in by[cn]:
+            ok_ = (t["answer"] == "PRESENT") if t["present"] else (t["answer"] == "ABSENT")
+            rep["per_case_correct"][cn][t["case"]] = rep["per_case_correct"][cn].get(t["case"], 0) + int(ok_)
+    # 사전 규칙
+    dec = decide(rep, conds)
+    rep["decision"] = dec
+    json.dump(rep, open(os.path.join(a.out_dir, "report.json"), "w"), indent=1)
+    json.dump(table, open(os.path.join(a.out_dir, "per_slab.json"), "w"))
+    print(json.dumps({"cond": {k: {kk: v[kk] for kk in ("n", "P", "N", "TP", "FN", "TN", "FP", "sens", "spec", "BA", "invalid_rate")} for k, v in rep["cond"].items()},
+                      "decision": dec}, indent=1))
+
+
+def decide(rep, conds):
+    c = rep["cond"]
+    out = {}
+
+    def ba(cn):
+        return c[cn]["BA"] if cn in c else None
+    if any(ba(x) is None for x in conds if x in c):
+        out["note"] = "BA undefined (single class) -> no automatic branch"
+        return out
+    sig = {}
+    for cn in ("DENSE", "O8"):
+        if cn in c and "TEXT" in c:
+            sig[cn] = bool(c[cn]["BA"] >= 0.70 and c[cn]["sens"] >= 0.60 and c[cn]["spec"] >= 0.60 and c[cn]["BA"] - c["TEXT"]["BA"] >= 0.10)
+    out["basic_signal_by_cond"] = sig
+    out["basic_signal"] = any(sig.values())
+    # Qwen 분기: DENSE와 O8 모두 BA<0.65 이거나 둘 다 TEXT 대비 BA 이득 <0.05
+    if "DENSE" in c and "O8" in c and "TEXT" in c:
+        both_low = c["DENSE"]["BA"] < 0.65 and c["O8"]["BA"] < 0.65
+        both_nogain = (c["DENSE"]["BA"] - c["TEXT"]["BA"] < 0.05) and (c["O8"]["BA"] - c["TEXT"]["BA"] < 0.05)
+        out["qwen_branch_triggered"] = bool(both_low or both_nogain)
+        out["qwen_branch_reason"] = {"both_BA_lt_0.65": bool(both_low), "both_gain_vs_text_lt_0.05": bool(both_nogain)}
+    if "DENSE" in c and "O8" in c and "U8" in c:
+        mx = max(c[x]["BA"] for x in ("DENSE", "U8", "O8"))
+        mn = min(c[x]["BA"] for x in ("DENSE", "U8", "O8"))
+        ev = {k: rep["paired"].get(k, {}).get("n_cases_event") for k in ("U8-DENSE", "O8-DENSE", "O8-U8")}
+        out["max_pairwise_BA_gap(DENSE,U8,O8)"] = mx - mn
+        out["residual_difference"] = bool(out["basic_signal"] and (mx - mn) >= 0.10 and any((v or 0) >= 5 for v in ev.values()))
+        out["events_cases"] = ev
+        out["u8_within_0.05_of_dense"] = bool(abs(c["U8"]["BA"] - c["DENSE"]["BA"]) <= 0.05)
+        ratio = rep["cost"]["U8"]["mean_runtime_s_per_condition_row"] / rep["cost"]["DENSE"]["mean_runtime_s_per_condition_row"]
+        out["u8_cost_ratio_runtime_vs_dense"] = ratio
+        out["negative_action_uniform_baseline"] = bool(out["u8_within_0.05_of_dense"] and ratio <= 0.5)
+    return out
+
+
+if __name__ == "__main__":
+    main()
diff --git a/msd56_fetch.py b/msd56_fetch.py
new file mode 100644
index 0000000..daed055
--- /dev/null
+++ b/msd56_fetch.py
@@ -0,0 +1,65 @@
+"""iter_056 MSD Task01_BrainTumour 공식 archive 다운로드(재개 가능) + md5 검증.
+
+URL/md5는 MONAI DecathlonDataset 소스(monai/apps/datasets.py)의 값. 같은 ETag/크기가 아니면 중단한다.
+사용: python msd56_fetch.py [--budget-s 540]   (시간 내 끝나지 않으면 같은 명령으로 재개)
+"""
+import argparse
+import hashlib
+import json
+import os
+import time
+import urllib.request
+
+URL = "https://msd-for-monai.s3-us-west-2.amazonaws.com/Task01_BrainTumour.tar"
+MD5 = "240a19d752f0d9e9101544901065d872"
+SIZE = 7608266240
+ETAG = '"dfd1b5a5df62dadb48cad3d347148c70-907"'
+OUT = "results/iter_056/source"
+TAR = f"{OUT}/Task01_BrainTumour.tar"
+
+
+def md5_file(path, bs=1 << 24):
+    h = hashlib.md5()
+    with open(path, "rb") as f:
+        while True:
+            b = f.read(bs)
+            if not b:
+                break
+            h.update(b)
+    return h.hexdigest()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--budget-s", type=float, default=540)
+    a = ap.parse_args()
+    os.makedirs(OUT, exist_ok=True)
+    have = os.path.getsize(TAR) if os.path.exists(TAR) else 0
+    t0 = time.time()
+    if have < SIZE:
+        req = urllib.request.Request(URL, headers={"Range": f"bytes={have}-", "If-Match": ETAG})
+        resp = urllib.request.urlopen(req)
+        if resp.status not in (200, 206):
+            raise SystemExit(f"unexpected status {resp.status}")
+        if have and resp.status != 206:
+            raise SystemExit("server ignored Range")
+        with open(TAR, "ab") as f:
+            while time.time() - t0 < a.budget_s:
+                b = resp.read(1 << 22)
+                if not b:
+                    break
+                f.write(b)
+        have = os.path.getsize(TAR)
+    print(f"bytes {have}/{SIZE} elapsed {time.time()-t0:.0f}s", flush=True)
+    if have == SIZE:
+        m = md5_file(TAR)
+        ok = m == MD5
+        json.dump({"url": URL, "etag": ETAG, "size": SIZE, "md5_expected": MD5, "md5_actual": m, "ok": ok,
+                   "t": time.strftime("%Y-%m-%dT%H:%M:%S")}, open(f"{OUT}/fetch_verify.json", "w"), indent=1)
+        print("md5", m, "OK" if ok else "MISMATCH")
+        if not ok:
+            raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
