+"""iter_112: 기술 집단의 모델 입력 box(MedRegA 0-999 좌표를 영상으로 되돌림, 적색)와 GT(녹색), 원 detector box(황색 점선 대신 얇은 선)를 겹친 확인용 montage."""
+import json
+
+from PIL import Image, ImageDraw
+
+man = json.load(open("results/iter_112/data/manifest.json"))
+gt = json.load(open("results/iter_112/data/gt.json"))
+rows = {r["id"]: r for r in man["rows"]}
+reg = [q for q in man["requests"] if q["group"] == "tech" and q["kind"] == "region"][:12]
+tiles = []
+for q in reg:
+    r = rows[q["id"]]
+    im = Image.open(r["image"]).convert("RGB")
+    w, h = im.size
+    d = ImageDraw.Draw(im)
+    for g in gt[q["id"]]["boxes_xyxy_px"]:
+        d.rectangle(g, outline=(0, 255, 0), width=4)
+    b = next(x for x in r["boxes"] if x["det_index"] == q["det_index"])
+    d.rectangle(b["xyxy_px"], outline=(255, 255, 0), width=1)
+    x1, y1, x2, y2 = q["box"]
+    d.rectangle((x1 / 1000 * w, y1 / 1000 * h, x2 / 1000 * w, y2 / 1000 * h), outline=(255, 0, 0), width=3)
+    tiles.append(im.resize((340, 340)))
+W = Image.new("RGB", (340 * 4, 340 * 3))
+for i, t in enumerate(tiles):
+    W.paste(t, ((i % 4) * 340, (i // 4) * 340))
+W.save("results/iter_112/data/overlay_tech12.png")
+print("ok", len(tiles))
diff --git a/mr112_run.py b/mr112_run.py
new file mode 100644
index 0000000..67104c4
--- /dev/null
+++ b/mr112_run.py
@@ -0,0 +1,108 @@
+"""iter_112 실행기: 한 프로세스가 모델을 두 GPU에 분산해 manifest 요청을 순서대로 처리한다.
+--mode tech: region 요청은 공식 생성(greedy, max_new_tokens400)+scoring, full 요청은 scoring. --mode main: scoring만.
+기록은 요청 단위 JSONL 한 줄(원자적 append+fsync). 같은 protocol digest의 완료 요청만 재사용한다. GT는 읽지 않는다."""
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+import sys
+import time
+
+import torch
+
+import mr112_model as MM
+import mr112_spec as S
+
+D = "results/iter_112"
+CODE = ["mr112_spec.py", "mr112_model.py", "mr112_run.py"]
+
+
+def fsha(p):
+    return hashlib.sha256(open(p, "rb").read()).hexdigest()
+
+
+def protocol_digest(man_path):
+    d = {p: fsha(p) for p in CODE}
+    d["manifest"] = fsha(man_path)
+    d["weights_manifest"] = fsha(f"{D}/weights_manifest.json")
+    return hashlib.sha256(json.dumps(d, sort_keys=True).encode()).hexdigest(), d
+
+
+def peak_mib():
+    return [round(torch.cuda.max_memory_allocated(i) / 2**20) for i in range(torch.cuda.device_count())]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--mode", required=True, choices=["tech", "main"])
+    ap.add_argument("--limit", type=int, default=0)
+    ap.add_argument("--tag", default="")
+    ap.add_argument("--checks", action="store_true")
+    a = ap.parse_args()
+    man_path = f"{D}/data/manifest.json"
+    man = json.load(open(man_path))
+    pd, files = protocol_digest(man_path)
+    out_dir = f"{D}/scores"
+    os.makedirs(out_dir, exist_ok=True)
+    out = f"{out_dir}/{a.mode}{a.tag}_scores.jsonl"
+    lock = open(out + ".lock", "w")
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)  # 동일 출력 단일 소유
+    done = set()
+    if os.path.exists(out):
+        for l in open(out):
+            try:
+                r = json.loads(l)
+            except json.JSONDecodeError:
+                continue  # torn tail
+            if r["protocol_digest"] != pd:
+                sys.exit("기존 출력의 protocol digest 불일치: 재사용 거부")
+            done.add(r["request_id"])
+    reqs = [q for q in man["requests"] if q["group"] == a.mode]
+    if a.limit:
+        reqs = reqs[:a.limit]
+    todo = [q for q in reqs if q["request_id"] not in done]
+    print(f"mode={a.mode} total={len(reqs)} done={len(done)} todo={len(todo)}", flush=True)
+    if not todo:
+        return
+    rows = {r["id"]: r for r in man["rows"]}
+    model, tok, load_s = MM.load()
+    print(f"loaded {load_s:.0f}s peak_MiB={peak_mib()}", flush=True)
+    if a.checks:
+        import mr112_checks
+        os.makedirs(f"{D}/tech", exist_ok=True)
+        ok = mr112_checks.run_checks(model, tok, man, f"{D}/tech/checks{a.tag}.json")
+        print("checks_ok", ok, "peak_MiB", peak_mib(), flush=True)
+    cache = {}
+    for q in todo:
+        r = rows[q["id"]]
+        # 영상 로딩 시 file/pixel hash 재검증 (manifest 연결)
+        if q["id"] not in cache:
+            if hashlib.sha256(open(r["image"], "rb").read()).hexdigest() != r["file_sha256"]:
+                raise RuntimeError(f"영상 hash 불일치 {q['id']}")
+            cache.clear()
+            pv = MM.load_image(r["image"])
+            cache[q["id"]] = (pv, MM.vit_features(model, pv))
+        pv, vit = cache[q["id"]]
+        t0 = time.time()
+        rec = dict(request_id=q["request_id"], id=q["id"], group=q["group"], kind=q["kind"], det_index=q["det_index"], box=q["box"],
+                   protocol_digest=pd, prompt_sha256=hashlib.sha256(q["prompt"].encode()).hexdigest(), target=q["target"],
+                   file_sha256=r["file_sha256"], pixel_values_sha256=hashlib.sha256(pv.numpy().tobytes()).hexdigest())
+        rec.update(MM.score(model, tok, q["prompt"], vit, q["target"]))
+        rec["score_s"] = time.time() - t0
+        if a.mode == "tech" and q["kind"] == "region":
+            t1 = time.time()
+            txt = MM.generate(model, tok, q["prompt"], pv)
+            rec["generated"] = txt
+            rec["gen_s"] = time.time() - t1
+        rec["peak_mib"] = peak_mib()
+        rec["wall_s"] = time.time() - t0
+        with open(out, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+            f.flush()
+            os.fsync(f.fileno())
+        print(q["request_id"], q["kind"], round(rec["mean_logprob"], 4), f"{rec['wall_s']:.1f}s", rec["peak_mib"], flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mr112_spec.py b/mr112_spec.py
new file mode 100644
index 0000000..c180afa
--- /dev/null
+++ b/mr112_spec.py
@@ -0,0 +1,39 @@
+"""iter_112 고정 규칙 (결과를 보기 전 lock). 순수 함수만 둔다. GT는 여기서 다루지 않는다.
+MedRegA 좌표는 원 영상 기준 xyxy 0-999 정수, 기존 평가 좌표(yxyx 0-1000 canvas)와 혼용하지 않는다."""
+import hashlib
+import math
+
+HEAD = ("You are a helpful medical assistant. Your task is object recognition. You are required to recognize "
+        "the object in the given region. The region is represented in the form of bounding box, [x1, y1, x2, y2], "
+        "with integers ranging from 0 to 999. These values correspond to the top left x, top left y, bottom right x, "
+        "and bottom right y. <image>\n")
+# 공식 demo_data id=7 (CT)의 영역 식별 template. modality 어구만 'CT scan' -> 'chest X-ray scan'.
+TAIL = "What is <ref>this</ref><box>[[{x1}, {y1}, {x2}, {y2}]]</box> in this chest X-ray scan?"
+TARGET = "lung opacity"
+FULL_BOX = (0, 0, 999, 999)
+THR, EPOCH = 0.70, 18
+GEN_MAX_NEW_TOKENS = 400
+TECH_N = 12
+K_FRAC = 0.25
+IOU_MAIN, IOU_AUX = 0.3, 0.5
+
+
+def q999(v, size):
+    return min(999, max(0, int(round(v / size * 1000))))
+
+
+def box_to_medrega(box_px, w, h):
+    x1, y1, x2, y2 = box_px
+    return (q999(x1, w), q999(y1, h), q999(x2, w), q999(y2, h))
+
+
+def prompt(box):
+    return HEAD + TAIL.format(x1=box[0], y1=box[1], x2=box[2], y2=box[3])
+
+
+def tech_key(patient):
+    return hashlib.sha256(("iter112:" + patient).encode()).hexdigest()
+
+
+def n_review(n):
+    return math.ceil(K_FRAC * n)
