new file mode 100644
index 0000000..6fe1810
--- /dev/null
+++ b/mt52_audit.py
@@ -0,0 +1,79 @@
+"""CT 의미 감사 순서·명시적 판정·고정 D/E 집합. 미확인은 자동 유지하지 않는다."""
+import argparse
+import json
+from mt52_prepare import ROOT, OUT, save, safe, sha256_file
+from mt52_cluster import rank
+
+def load():
+    order=json.loads((OUT/'audit/representative_order.json').read_text())
+    raw={r['title']:r for r in json.loads((OUT/'audit/candidates_private.json').read_text())}
+    decisions={}
+    for p in sorted((OUT/'audit/decisions').glob('*.json')):
+        for r in json.loads(p.read_text()):
+            if r['case_key'] in decisions: raise ValueError('duplicate decision')
+            decisions[r['case_key']]=r
+    return order,raw,decisions
+
+def choose(order,dec):
+    def good(r):
+        d=dec.get(r['case_key'],{})
+        return d.get('visual')=='keep' and d.get('history')=='keep'
+    def pending(r): return r['case_key'] not in dec
+    selected=[]
+    # 최장 적격을 먼저 확정하며 동률은 고정 hash 순서다.
+    longest=sorted(order,key=lambda r:(-r['n_images'],r['rank']))
+    for r in longest:
+        if pending(r): return selected,[r],'D_longest'
+        if good(r): selected.append(r);break
+    strata={ (r['subtype'],0 if r['n_images']<=3 else 1 if r['n_images']<=7 else 2) for r in order}
+    for st in sorted(strata):
+        pool=[r for r in order if (r['subtype'],0 if r['n_images']<=3 else 1 if r['n_images']<=7 else 2)==st]
+        if any(r in selected for r in pool):continue
+        for r in pool:
+            if pending(r): return selected,[r],'D_stratum'
+            if good(r): selected.append(r);break
+    for r in order:
+        if len(selected)>=24:break
+        if r in selected:continue
+        if pending(r):return selected,[r],'D_fill'
+        if good(r):selected.append(r)
+    if len(selected)<24:return selected,[],'D_insufficient'
+    e=[]
+    for r in order:
+        if r in selected:continue
+        if len(e)==280:break
+        if pending(r):return selected+e,[r],'E'
+        if good(r):e.append(r)
+    return selected+e,[],'ready' if len(e)==280 else 'E_insufficient'
+
+def next_batch(n):
+    order,raw,dec=load(); selected,_,stage=choose(order,dec)
+    batch=[]
+    # pending 예측을 keep으로 두어 조회 후보만 선택한다. 실제 판정/선택에는 저장하지 않는다.
+    temporary=dict(dec)
+    for _ in range(n):
+        _,pending,s=choose(order,temporary)
+        if not pending:break
+        r=pending[0];batch.append(r)
+        temporary[r['case_key']]={'visual':'keep','history':'keep'}
+    for r in batch:
+        c=raw[r['case_key']]
+        print(json.dumps({**r,'history':c['CLINICAL_HISTORY'],'answer':c['correct_answer_text'],
+                          'options':c['options']},ensure_ascii=False))
+    print('STATUS',stage,'audited',len(dec),'selected',len(selected))
+
+def record(name,entries,call_id):
+    order,raw,dec=load(); by={r['case_key']:r for r in order}
+    result=[]
+    for cid,visual,history,note in entries:
+        key='Case number '+cid.removeprefix('c')
+        assert key not in dec and visual in ('keep','exclude','pending') and history in ('keep','exclude','pending')
+        r=by[key];assert sha256_file(safe(ROOT/r['sheet']))==r['sheet_sha256']
+        result.append({'case_key':key,'visual':visual,'history':history,'note':note,
+                       'image_return_call_id':call_id,'sheet':r['sheet'],'sheet_sha256':r['sheet_sha256'],
+                       'raw_source_sha256':sha256_file(OUT/'audit/candidates_private.json')})
+    save(OUT/'audit/decisions'/f'{name}.json',result)
+    print('recorded',len(result))
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser();p.add_argument('--next',type=int,default=6);a=p.parse_args();next_batch(a.next)
diff --git a/mt52_audit_finish.py b/mt52_audit_finish.py
new file mode 100644
index 0000000..5e72324
--- /dev/null
+++ b/mt52_audit_finish.py
@@ -0,0 +1,84 @@
+"""전체 대표 감사와 실제 이미지 반환을 연결하고 자료 gate를 봉인한다."""
+import base64
+import hashlib
+import io
+import json
+import re
+from pathlib import Path
+from collections import Counter
+import numpy as np
+from PIL import Image
+from mt52_prepare import ROOT, OUT, save, sha256_file
+from mt52_audit import load, choose
+from mt52_provenance import pixels
+
+ROLLOUT=Path('/home/test/.codex/sessions/2026/10/03/rollout-2026-10-03T03-55-07-01a0fdf8-5e99-7c83-a778-8e11764ea36f.jsonl')
+
+def bind(snapshot, order):
+    by={r['case_key']:r for r in order}; expected={}; found={}; calls={}
+    for r in order:
+        assert sha256_file(ROOT/r['sheet'])==r['sheet_sha256']
+        with Image.open(ROOT/r['sheet']) as im:expected[pixels(im)]=r['case_key']
+    for ln,line in enumerate(snapshot.open()):
+        p=json.loads(line).get('payload',{})
+        if p.get('type')=='custom_tool_call':calls[p['call_id']]=p.get('input','')
+        if p.get('type')!='custom_tool_call_output':continue
+        for i,item in enumerate(p.get('output',[])):
+            if item.get('type')!='input_image':continue
+            data=base64.b64decode(item['image_url'].split(',',1)[1]); call=calls.get(p['call_id'],'')
+            with Image.open(io.BytesIO(data)) as im:
+                ph=pixels(im); key=expected.get(ph); mode='exact_rgb'; error=0.
+                if key is None:
+                    for cid in re.findall(r'/sheets/c(\d+)\.png',call):
+                        ck='Case number '+cid
+                        if ck not in by:continue
+                        with Image.open(ROOT/by[ck]['sheet']) as src:
+                            if src.size==im.size:continue
+                            if abs(src.width/src.height-im.width/im.height)>.002:continue
+                            error=float(np.abs(np.asarray(src.convert('RGB').resize(im.size,Image.Resampling.BILINEAR)).astype(float)-np.asarray(im.convert('RGB'))).mean())
+                        if error<.1:key=ck;mode='tool_resize_bilinear_mae_lt_0.1';break
+                if key is None:continue
+                # Match both the actual returned pixels and the requested path.
+                assert call,('missing call',key,p['call_id'])
+                found.setdefault(key,[]).append({'call_id':p['call_id'],'line':ln+1,'output_index':i,
+                    'returned_sha256':hashlib.sha256(data).hexdigest(),'pixels_sha256':ph,
+                    'mode':mode,'rgb_mae':error,'literal_path_in_call':by[key]['sheet'] in call,'call_input':call})
+    return found
+
+def validate(order,dec,found):
+    keys={r['case_key'] for r in order}
+    assert keys==set(dec),'missing/extra audit decision'
+    assert keys<=set(found),'missing actual image return'
+    for r in order:
+        d=dec[r['case_key']]
+        assert d['sheet_sha256']==r['sheet_sha256'],'audit sheet mismatch'
+        assert d['raw_source_sha256']==sha256_file(OUT/'audit/candidates_private.json'),'audit source mismatch'
+
+def main():
+    order,raw,dec=load();snap=OUT/'provenance/iter052_complete_audit_rollout_v2.jsonl'
+    if not snap.exists():
+        data=ROLLOUT.read_bytes();data=data[:data.rfind(b'\n')+1]
+        with snap.open('xb') as f:f.write(data)
+    found=bind(snap,order)
+    save(OUT/'provenance/all_image_returns_v2.json',{'snapshot':str(snap.relative_to(ROOT)),
+        'snapshot_sha256':sha256_file(snap),'returns':found,'missing':sorted(set(dec)-set(found))})
+    validate(order,dec,found)
+    selected,pending,stage=choose(order,dec);assert not pending
+    d=json.loads((OUT/'data/D_inference.json').read_text())
+    assert [r['case_key'] for r in selected[:24]]==[r['case_key'] for r in d]
+    e=selected[24:];assert not ({r['case_key'] for r in e}&{r['case_key'] for r in d})
+    sources=['mt52_audit_finish.py','mt52_audit.py','mt52_cluster.py','mt52_prepare.py']
+    inputs=['audit/representative_order.json','audit/candidates_private.json','data/clusters.json',
+        'data/image_manifest.json','data/D_selection.json','provenance/all_image_returns_v2.json']
+    files=[ROOT/p for p in sources]+[OUT/p for p in inputs]+sorted((OUT/'audit/decisions').glob('*.json'))
+    result={'status':stage,'run_E':stage=='ready','candidates':607,'representatives':len(order),
+        'audited':len(dec),'eligible':len(selected),'D':24,'E_available':len(e),'E_required':280,
+        'shortfall':max(0,280-len(e)),'eligible_images':sum(r['n_images'] for r in selected),
+        'E_images':sum(r['n_images'] for r in e),'visual':dict(Counter(r['visual'] for r in dec.values())),
+        'history':dict(Counter(r['history'] for r in dec.values())),
+        'selected':selected,'source_digests':{str(p.relative_to(ROOT)):sha256_file(p) for p in files},
+        'scope':'CT-only fixed representative primary audit. No model hypothesis judgment; E not shortened.'}
+    save(OUT/'audit/data_gate.json',result)
+    print({k:v for k,v in result.items() if k not in ('selected','source_digests')})
+
+if __name__=='__main__':main()
diff --git a/mt52_cluster.py b/mt52_cluster.py
new file mode 100644
index 0000000..d0707d2
--- /dev/null
+++ b/mt52_cluster.py
@@ -0,0 +1,85 @@
+"""모델 실행 및 의미 감사 전 중복 후보와 대표 순서를 고정한다."""
+import collections
+import hashlib
+import json
+import numpy as np
+from PIL import Image, ImageDraw, ImageOps
+from mt52_prepare import ROOT, OUT, safe, save, candidates, norm_text, sha256_file
+
+def rank(key): return hashlib.sha256(('5201|'+key).encode()).hexdigest()
+
+def dctn(a, norm='ortho'):
+    """32x32 orthonormal DCT-II. scipy 없는 기본 환경에서 NumPy 수식을 사용한다."""
+    n=a.shape[0]
+    basis=np.cos(np.pi*np.arange(n)[:,None]*(np.arange(n)[None,:]+0.5)/n)*np.sqrt(2/n)
+    basis[0]/=np.sqrt(2)
+    return basis@a@basis.T
+
+def main():
+    cs=candidates(); by={r['title']:r for r in cs}
+    manifest=json.loads((OUT/'data/image_manifest.json').read_text())
+    assert len(manifest)==607 and sum(len(c['images']) for c in manifest)==2909
+    parent={k:k for k in by}; edges=[]
+    def find(x):
+        while parent[x]!=x:
+            parent[x]=parent[parent[x]]; x=parent[x]
+        return x
+    def join(a,b,reason,detail):
+        if a==b:return
+        parent[find(a)]=find(b)
+        edges.append({'a':a,'b':b,'reason':reason,'detail':detail})
+    seen={}; allims=[]
+    for r in manifest:
+        key=r['case_key']; ims=[]
+        c=by[key]
+        sig=norm_text(c['CLINICAL_HISTORY'])+'|'+str(sorted(norm_text(x) for x in c['options'].values()))
+        if sig in seen: join(key,seen[sig],'same_normalized_history_options',sig)
+        seen[sig]=key
+        for rec in r['images']:
+            p=safe(ROOT/rec['path']); assert sha256_file(p)==rec['sha256']
+            with Image.open(p) as im:
+                rgb=im.convert('RGB'); ims.append(rgb.copy())
+                assert hashlib.sha256(str(rgb.size).encode()+rgb.tobytes()).hexdigest()==rec['rgb_sha256']
+                freq=dctn(np.asarray(rgb.convert('L').resize((32,32)),dtype=float),norm='ortho')[:8,:8]
+                ph=int(''.join('1' if x>np.median(freq.flatten()[1:]) else '0' for x in freq.flat),2)
+            for kind in ['sha256','rgb_sha256','id']:
+                sig=kind+'|'+rec[kind]
+                if sig in seen: join(key,seen[sig],'exact_'+kind,rec['path'])
+                seen[sig]=key
+            allims.append((key,rec['path'],ph,int(rec['dhash'],16)))
+        # aspect ratio를 유지하며 감사용 사본에만 index를 표시한다.
+        cols=min(4,len(ims)); tile=384
+        sheet=Image.new('RGB',(cols*tile,((len(ims)+cols-1)//cols)*tile),(35,35,35))
+        draw=ImageDraw.Draw(sheet)
+        for i,im in enumerate(ims):
+            thumb=ImageOps.contain(im,(tile,tile-22))
+            x=(i%cols)*tile; y=(i//cols)*tile
+            sheet.paste(thumb,(x+(tile-thumb.width)//2,y+22))
+            draw.text((x+4,y+3),f'{key} / {i+1}',fill='yellow')
+        dest=safe(OUT/'audit/sheets'/(key.replace('Case number ','c')+'.png'),True)
+        dest.parent.mkdir(parents=True,exist_ok=True)
+        if dest.exists(): raise ValueError('sheet exists')
+        with dest.open('xb') as f: sheet.save(f,format='PNG')
+    near=[]
+    for i,(a,pa,ha,da) in enumerate(allims):
+        for b,pb,hb,db in allims[i+1:]:
+            if a!=b and (ha^hb).bit_count()<=4 and (da^db).bit_count()<=4:
+                detail={'paths':[pa,pb],'phash_distance':(ha^hb).bit_count(),'dhash_distance':(da^db).bit_count()}
+                near.append(detail)
+                join(a,b,'unresolved_near_duplicate_conservative_cluster',detail)
+    groups=collections.defaultdict(list)
+    for k in by:groups[find(k)].append(k)
+    clusters=[{'representative':min(v,key=rank),'members':sorted(v)} for v in groups.values()]
+    clusters.sort(key=lambda r:rank(r['representative']))
+    save(OUT/'data/clusters.json',{'clusters':clusters,'edges':edges,'near_pairs':near,
+        'manifest_sha256':sha256_file(OUT/'data/image_manifest.json'),
+        'rule':'exact bytes/RGB/id or history+options; unresolved pHash<=4 AND dHash<=4 conservatively merged; not patient identity',
+        'code_sha256':sha256_file(__file__)})
+    reps=[by[r['representative']] for r in clusters]
+    save(OUT/'audit/representative_order.json',[{'case_key':r['title'],'rank':rank(r['title']),
+        'n_images':r['image_count'],'subtype':r['image_01_sub_modality'],
+        'sheet':str((OUT/'audit/sheets'/(r['title'].replace('Case number ','c')+'.png')).relative_to(ROOT)),
+        'sheet_sha256':sha256_file(OUT/'audit/sheets'/(r['title'].replace('Case number ','c')+'.png'))} for r in reps])
+    print('clusters',len(clusters),'near pairs',len(near),'edges',len(edges))
+
+if __name__=='__main__':main()
diff --git a/mt52_d_report.py b/mt52_d_report.py
