+++ b/ed118_build.py
@@ -0,0 +1,170 @@
+"""iter_118 요청·ledger·weights·평가 잠금 (결과는 results/iter_118 아래에만, 기존 파일 덮어쓰기 거부).
+
+ ledger   : ledger_nogt(PNG 정보) + detector raw preds → data/ledger_det.json (정답 없음, label==1만, 원 score 보존)
+ requests : TECH(6×3=18), MAIN(192×3=576), RESUME6(TECH 처음 6행). 요청에는 불투명 slot(s0..s2)만 있고 C/W 정오·category는 없다.
+            정오 매핑은 private/cond_map.json (부모/평가 전용).
+ weights  : 현재 가중치 snapshot sha256을 iter_116 weights_check와 대조한다.
+ lock     : 평가 코드·fixture·정답/매핑 digest를 잠금 시각과 함께 private/eval_lock.json에 기록한다 (생성 전).
+ protocol : 생성 전용 protocol — 정답/평가 파일을 잠금 목록에 넣지 않는다 (worker가 읽지 않는다).
+"""
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import ed118_gen as RUN
+import ed118_spec as S
+from rsna_diag import generate as G
+
+OUT = "results/iter_118"
+DATA = f"{OUT}/data"
+PRIV = f"{OUT}/private"
+REQ = f"{OUT}/requests"
+PROTO = f"{OUT}/protocol"
+SNAP = Path("../hf_cache/hub/models--google--medgemma-1.5-4b-it/snapshots") / G.MODEL_REVISION
+WCHECK116 = "results/iter_116/lock/weights_check.json"
+GEN_LOCK_CODE = ["ed118_gen.py", "ed118_guard.py", "ed118_spec.py", "ed116_spec.py", "ev108_spec.py", "ev109_extract.py", "ed118_build.py",
+                 "rsna_diag/__init__.py", "rsna_diag/generate.py", "rsna_diag/geometry.py", "rsna_diag/prompts.py", "rsna_diag/qa_spec.py"]
+EVAL_CODE = ["ed118_spec.py", "ed118_eval.py", "ed118_verify.py", "ed118_tests.py", "ed118_build.py", "ed118_data.py", "ed118_det.py",
+             "ed118_guard.py", "ed118_run.py", "ed116_spec.py", "ev108_spec.py", "ev109_extract.py", "rsna_diag/metrics.py", "rsna_diag/geometry.py",
+             "rsna_diag/qa_spec.py", "ed118_gen.py"]
+
+
+def fsha(p):
+    return RUN.file_sha(p)
+
+
+def wr(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "x") as f:
+        json.dump(obj, f, indent=1, sort_keys=True)
+
+
+def cmd_ledger():
+    led = json.load(open(f"{DATA}/ledger_nogt.json"))["rows"]
+    raw = json.load(open(f"{OUT}/det/raw_preds.json"))
+    assert raw["ledger_sha256"] == fsha(f"{DATA}/ledger_nogt.json") and raw["checkpoint_sha256"] == "576b8d789ef5f9e1924d7ad6e56954d51589dc437eaa12215874ce77cd3cc76c"
+    rows = []
+    for r in led:
+        p = raw["preds"][r["id"]]
+        keep = [i for i, l in enumerate(p["labels"]) if l == 1]
+        h, w = r["size_hw"]
+        assert p["img_hw"] == [h, w]
+        rows.append(dict(r, det=dict(boxes_xyxy_px=[p["boxes_xyxy_px"][i] for i in keep], scores=[p["scores"][i] for i in keep])))
+    wr(f"{DATA}/ledger_det.json", dict(rows=rows, raw_preds_sha256=fsha(f"{OUT}/det/raw_preds.json"), threshold=S.THR))
+    print("ledger_det", len(rows))
+
+
+def make_rows(rows, labels, stage, cond_map):
+    out = []
+    for rank, r in enumerate(rows):
+        pid = r["id"]
+        gt = labels[pid]["gt_answer"]
+        _, _, pxs = G.load_image(r["image"])
+        if fsha(r["image"]) != r["file_sha256"] or pxs is None:
+            raise RuntimeError(f"image hash changed {pid}")
+        order = S.rotation(pid)
+        cond_map[pid] = {f"s{k}": c for k, c in enumerate(order)}
+        for k, c in enumerate(order):
+            prompt = S.build_prompt(S.cond_draft(c, gt), r)
+            psha = S.sha(prompt)
+            row = dict(stage=stage, cond=f"s{k}", patient=pid, targets=["O"], kind="draft_probe", donor_patient=None, modality="image",
+                       image=r["image"], image_file_sha256=r["file_sha256"], input_pixel_sha256=pxs, prompt=prompt, prompt_sha256=psha,
+                       caps=S.CAPS, order_key=f"{stage}|{rank:04d}|{k}")
+            row["request_id"] = S.request_id(pid, f"s{k}", psha, pxs, G.MODEL_REVISION)
+            out.append(row)
+    return out
+
+
+def write_jsonl(path, rows):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "x") as f:
+        for r in rows:
+            f.write(json.dumps(r, sort_keys=True) + "\n")
+
+
+def cmd_requests():
+    led = json.load(open(f"{DATA}/ledger_det.json"))["rows"]
+    labels = json.load(open(f"{PRIV}/labels.json"))
+    cond_map = {}
+    tech = make_rows([r for r in led if r["stage"] == "TECH"], labels, "TECH", cond_map)
+    main = make_rows([r for r in led if r["stage"] == "MAIN"], labels, "MAIN", cond_map)
+    resume6 = sorted(tech, key=lambda r: r["order_key"])[:6]
+    for name, rr in (("TECH", tech), ("MAIN", main), ("RESUME6", resume6)):
+        write_jsonl(f"{REQ}/{name}.jsonl", rr)
+        assert len({r["request_id"] for r in rr}) == len(rr)
+        print(name, len(rr), fsha(f"{REQ}/{name}.jsonl"))
+    wr(f"{PRIV}/cond_map.json", cond_map)
+    txt = open(f"{REQ}/MAIN.jsonl").read() + open(f"{REQ}/TECH.jsonl").read()
+    for bad in ("category", "gt_answer", "opacity\"", "correct_draft", "wrong_draft", "labels"):
+        assert bad not in txt.replace("Use the information", "").replace("pulmonary opacity", ""), bad
+    # 환자별 세 요청: 영상·packet·공통 지시 동일, draft 줄만 다름
+    for rows in (tech, main):
+        by = {}
+        for r in rows:
+            by.setdefault(r["patient"], []).append(r)
+        for pid, rs in by.items():
+            assert len(rs) == 3 and len({r["image"] for r in rs}) == 1 and len({r["input_pixel_sha256"] for r in rs}) == 1, pid
+            stripped = {r["prompt"].replace("\n\n" + S.draft_line("yes"), "").replace("\n\n" + S.draft_line("no"), "") for r in rs}
+            assert len(stripped) == 1, pid
+    print("요청 검사 통과: 정답/조건 이름 없음, 환자별 영상·packet·공통 지시 동일")
+
+
+def cmd_weights():
+    now = {p.name: {"sha256": fsha(str(p.resolve())), "size": p.resolve().stat().st_size} for p in sorted(SNAP.iterdir())}
+    ref = json.load(open(WCHECK116))["files"]
+    diff = sorted(k for k in set(now) | set(ref) if now.get(k) != ref.get(k))
+    res = dict(snapshot=str(SNAP), revision=G.MODEL_REVISION, n_files=len(now), reference=WCHECK116, reference_sha256=fsha(WCHECK116),
+               differences_vs_reference=diff, files=now, checked_at=time.time())
+    wr(f"{DATA}/weights_check.json", res)
+    print("weights files", len(now), "diff", diff)
+    if diff:
+        sys.exit(1)
+
+
+def cmd_lock(tests):
+    t = time.time()
+    files = {f: fsha(f) for f in EVAL_CODE}
+    for p in (f"{PRIV}/labels.json", f"{PRIV}/cond_map.json", f"{DATA}/ledger_nogt.json", f"{DATA}/ledger_det.json", f"{DATA}/data_provenance.json",
+              f"{DATA}/dedup_raw_check.json", f"{DATA}/weights_check.json", f"{OUT}/det/raw_preds.json", f"{OUT}/det/regress.json", tests,
+              f"{REQ}/TECH.jsonl", f"{REQ}/MAIN.jsonl", f"{REQ}/RESUME6.jsonl", "../agent/runs/iter_118/plan.md", "../agent/runs/iter_118/plan.json"):
+        files[p] = fsha(p)
+    d = dict(locked_at_epoch=t, locked_at_utc=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t)), files=files,
+             classifier_version=S.CLASSIFIER_VERSION, spec_digest=S.rules_digest(),
+             note="TECH/MAIN 생성 시작 전 작성. 평가 분류·정책·통계 코드와 정답·매핑 파일 hash. 생성 결과를 보고 수정하지 않는다.")
+    wr(f"{PRIV}/eval_lock.json", d)
+    print("locked", d["locked_at_utc"], len(files))
+
+
+def gen_lock_files():
+    return GEN_LOCK_CODE + [f"{DATA}/ledger_nogt.json", f"{DATA}/ledger_det.json", f"{DATA}/weights_check.json", f"{OUT}/det/raw_preds.json"]
+
+
+def cmd_protocol(stage):
+    wd = json.load(open(f"{DATA}/weights_check.json"))
+    extra = dict(spec_version=S.SPEC_VERSION, model_revision=G.MODEL_REVISION, n_weight_files=wd["n_files"],
+                 weights_check_sha256=fsha(f"{DATA}/weights_check.json"),
+                 note="생성 protocol은 정답/평가 파일을 잠그지 않는다. 평가 잠금은 부모가 private/eval_lock.json으로 검증한다.")
+    d = RUN.make_protocol(f"{REQ}/{stage}.jsonl", f"{PROTO}/protocol_{stage}.json", extra=extra, lock=gen_lock_files())
+    bad = [f for f in d["locked_files"] if "private" in f]
+    assert not bad, bad
+    print("protocol", stage, fsha(f"{PROTO}/protocol_{stage}.json"), d["n_requests"])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("cmd", choices=["ledger", "requests", "weights", "lock", "protocol"])
+    ap.add_argument("--stage")
+    ap.add_argument("--tests")
+    a = ap.parse_args()
+    {"ledger": cmd_ledger, "requests": cmd_requests, "weights": cmd_weights}.get(a.cmd, lambda: None)()
+    if a.cmd == "lock":
+        cmd_lock(a.tests)
+    if a.cmd == "protocol":
+        cmd_protocol(a.stage)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ed118_data.py b/ed118_data.py
new file mode 100644
index 0000000..42bb64b
--- /dev/null
+++ b/ed118_data.py
@@ -0,0 +1,197 @@
+"""iter_118 자료 선별: 미사용 RSNA 환자 (reserve) → 공식 Calculated 정답 연결 → 값 보존 PNG → ledger(정답 없음) + private(정답).
+
+- 결과는 results/iter_118 아래에만 쓰며 기존 파일을 덮어쓰지 않는다 ('x' 모드).
+- 정답(category, box)은 results/iter_118/private/ 에만 둔다. 생성 worker는 이 경로를 열 수 없다(ed118_gen의 audit hook).
+- 환자: mapping img_id의 NIH 8자리 접두어. 미표기는 음성으로 바꾸지 않는다 (Calculated 라벨이 정확히 1개인 영상만).
+- 선택: category별 sha256('iter118|'+patient) 오름차순 → 적격 영상이 있는 환자 순서로 TECH 2명, 그 다음 MAIN.
+  환자당 영상은 해당 category와 Calculated가 일치하는 적격 SOP 중 SOP 문자열 오름차순 첫 번째.
+- 모델 출력·detector 정오는 선택에 사용하지 않는다 (이 모듈은 모델을 실행하지 않는다).
+"""
+import hashlib
+import json
+import os
+import sys
+import time
+
+import numpy as np
+from PIL import Image
+
+from rsna_diag import dicom_min, geometry, rsna_data
+
+R = "results"
+OUT = f"{R}/iter_118"
+RAW = f"{R}/iter_009/source/raw"
+ANN = f"{RAW}/pneumonia-challenge-annotations-adjudicated-kaggle_2018.json"
+MAP = f"{RAW}/pneumonia-challenge-dataset-mappings_2018.json"
+ZIP = f"{RAW}/pneumonia-challenge-dataset-adjudicated-kaggle_2018.zip"
+RESERVE = f"{R}/iter_010/manifests/reserve_patients.json"
+EXCL_SOURCES = [f"{R}/iter_010/manifests/gt_manifest.json", f"{R}/iter_010/manifests/exclusion_previous_patients.json",
+                f"{R}/iter_009/manifests/gt_manifest.json", f"{R}/iter_009/manifests/exclusion_previous_nih_patients.json"]
+OLD_INFER = [f"{R}/iter_010/manifests/infer_manifest.jsonl", f"{R}/iter_009/manifests/infer_manifest.jsonl"]
+CATS = [rsna_data.CAT_POS, rsna_data.CAT_NORMAL, rsna_data.CAT_NLONN]
+N_TECH_PER_CAT = 2
+N_MAIN = {rsna_data.CAT_POS: 96, rsna_data.CAT_NORMAL: 48, rsna_data.CAT_NLONN: 48}
+AUDIT_WINDOW = {rsna_data.CAT_POS: 520, rsna_data.CAT_NORMAL: 260, rsna_data.CAT_NLONN: 260}
+SALT = "iter118|"
+
+
+def sha(b):
+    return hashlib.sha256(b if isinstance(b, bytes) else b.encode()).hexdigest()
+
+
+def fsha(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def sel_key(p):
+    return sha(SALT + p)
+
+
+def wr(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "x") as f:
+        json.dump(obj, f, indent=1, sort_keys=True)
+
+
+def excluded_patients():
+    used, by_src = set(), {}
+    for p in EXCL_SOURCES:
+        d = json.load(open(p))
+        if p.endswith("gt_manifest.json"):
+            ids = {v["patient"] for v in d.values()}
+        else:
+            ids = set(d)
+        by_src[p] = len(ids)
+        used |= ids
+    return used, by_src
+
+
+def old_hashes():
+    pix, sops = set(), set()
+    for p in OLD_INFER:
+        for ln in open(p):
+            if ln.strip():
+                r = json.loads(ln)
+                pix.add(r["pixel_sha256"])
+                sops.add(os.path.basename(r["image"])[:-4])
+    for p in EXCL_SOURCES[:1] + EXCL_SOURCES[2:3]:
+        for v in json.load(open(p)).values():
+            sops.add(v["sop"])
+    return pix, sops
+
+
+def padded_pixel_sha(arr):
+    rgb = geometry.to_uint8_rgb_preserving(arr)
+    padded, aff = geometry.pad_square(rgb)
+    return sha(padded.tobytes()), aff
+
+
+def build():
+    t0 = time.monotonic()
+    if os.path.exists(f"{OUT}/private/labels.json"):
+        sys.exit("이미 선별됨: 덮어쓰지 않는다")
+    reserve = json.load(open(RESERVE))
+    used, excl_by_src = excluded_patients()
+    old_pix, old_sop = old_hashes()
+    label, ann = rsna_data.load_annotations(ANN)
+    sop_map, dups = rsna_data.load_mapping(MAP)
+    rz = rsna_data.RsnaZip(ZIP)
+    if dups or rz.collisions:
+        raise rsna_data.AuditError(f"mapping 중복 {len(dups)} / ZIP 충돌 {len(rz.collisions)} → 중단")
+    by_patient = {}
+    for sop, m in sop_map.items():
+        mm = rsna_data.IMG_RE.fullmatch(m["img_id"])
+        if mm and sop in ann:
+            by_patient.setdefault(mm.group(1), []).append(sop)
+    cand, cand_info = {}, {}
+    for c in CATS:
+        allc = list(reserve[c])
+        free = [p for p in allc if p not in used]
+        cand[c] = sorted(free, key=sel_key)[:AUDIT_WINDOW[c]]
+        cand_info[c] = dict(reserve=len(allc), excluded_by_prior_use=len(allc) - len(free), unused=len(free),
+                            audit_window=len(cand[c]))
+    chosen, skipped, seen_pix, seen_sop = {}, {}, set(), set()
+    os.makedirs(f"{OUT}/data/images", exist_ok=True)
+    need = {c: N_TECH_PER_CAT + N_MAIN[c] for c in CATS}
+    eligible = {c: [] for c in CATS}
+    for c in CATS:
+        for p in cand[c]:
+            if len(eligible[c]) >= need[c]:
+                break
+            sops = sorted(by_patient.get(p, []))
+            if not sops:
+                skipped[p] = "no_annotated_images"
+                continue
+            recs, _ = rsna_data.audit_all(label, {s: ann[s] for s in sops}, sop_map, [], rz)
+            ok = [s for s in sops if not recs[s]["reasons"] and recs[s]["category"] == c and recs[s]["patient"] == p]
+            if not ok:
+                skipped[p] = "no_eligible_image_in_category:" + ";".join(sorted({r for s in sops for r in recs[s]["reasons"]})[:3])
+                continue
+            sop = ok[0]
+            if sop in old_sop or sop in seen_sop:
+                skipped[p] = "sop_duplicate"
+                continue
+            meta, arr = dicom_min.read_pixels(rz.read(sop))
+            psha, aff = padded_pixel_sha(arr)
+            rsha = sha(arr.tobytes())  # 기존 manifest의 pixel_sha256은 padding 전 raw uint8 array hash다 (iter_118 정정)
+            if rsha in old_pix or rsha in seen_pix:
+                skipped[p] = "pixel_duplicate"
+                continue
+            png = f"{OUT}/data/images/{sop}.png"
+            Image.fromarray(arr).save(png)
+            rb = np.asarray(Image.open(png))
+            if not np.array_equal(rb, arr) or padded_pixel_sha(rb)[0] != psha:
+                raise RuntimeError(f"PNG 왕복 불일치 {sop}")
+            seen_pix.add(rsha)
+            seen_sop.add(sop)
+            r = recs[sop]
+            eligible[c].append(dict(patient=p, sop=sop, category=c, image=png, file_sha256=fsha(png), pixel_sha256=psha,
+                                    size_hw=[int(arr.shape[0]), int(arr.shape[1])], zip=rz.info(sop), img_id=r["img_id"],
+                                    boxes_xyxy_px=[[b["xywh"][0], b["xywh"][1], b["xywh"][0] + b["xywh"][2], b["xywh"][1] + b["xywh"][3]]
+                                                   for b in r["boxes"]], dicom_tags={k: meta.get(k) for k in
+                                    ("TransferSyntaxUID", "PhotometricInterpretation", "Rows", "Columns", "BitsStored", "ViewPosition")}))
+    tech = [e for c in CATS for e in eligible[c][:N_TECH_PER_CAT]]
+    rest = {c: eligible[c][N_TECH_PER_CAT:] for c in CATS}
+    m = min(48, len(rest[CATS[0]]) // 2, len(rest[CATS[1]]), len(rest[CATS[2]]))
+    n_main = {CATS[0]: 2 * m, CATS[1]: m, CATS[2]: m}
+    main = [e for c in CATS for e in rest[c][:n_main[c]]]
+    if m == 0 or any(len(eligible[c]) < N_TECH_PER_CAT for c in CATS):
+        raise RuntimeError("표본 부족: m=0 또는 TECH 불가 — 생성하지 않는다")
+    unused_extra = {c: len(rest[c]) - n_main[c] for c in CATS}
+    # PNG는 사용하지 않는 추가 환자 몫도 만들었을 수 있다 → 선택에 포함되지 않은 파일은 selection에서 제외 표시
+    selected = {e["patient"] for e in tech + main}
+    for c in CATS:
+        for e in eligible[c]:
+            if e["patient"] not in selected:
+                e["unused_extra"] = True
+    ledger_rows, labels = [], {}
+    for stage, lst in (("TECH", tech), ("MAIN", main)):
+        for rank, e in enumerate(lst):
+            ledger_rows.append(dict(id=e["patient"], stage=stage, rank=rank, image=e["image"], file_sha256=e["file_sha256"],
+                                    pixel_sha256=e["pixel_sha256"], size_hw=e["size_hw"], sop=e["sop"]))
+            labels[e["patient"]] = dict(category=e["category"], sop=e["sop"], boxes_xyxy_px=e["boxes_xyxy_px"],
+                                        gt_answer="yes" if e["category"] == rsna_data.CAT_POS else "no", zip=e["zip"],
+                                        img_id=e["img_id"], dicom_tags=e["dicom_tags"])
+    wr(f"{OUT}/private/labels.json", labels)
+    wr(f"{OUT}/data/ledger_nogt.json", dict(rows=ledger_rows, rule=f"category별 sha256('{SALT}'+patient) 오름차순, 적격 영상이 있는 환자 순서; "
+                                           "TECH=각 category 앞 2명, MAIN=그 다음. 환자당 영상=적격 SOP 오름차순 첫째."))
+    prov = dict(created_at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), n_tech=len(tech), n_main=len(main), m=m,
+                n_main_by_category=n_main, candidates=cand_info, excluded_sources=excl_by_src, n_excluded_union=len(used),
+                skipped_candidates=skipped, unused_extra_eligible=unused_extra,
+                inputs=dict(annotation=fsha(ANN), mapping=fsha(MAP), zip=fsha(ZIP), reserve=fsha(RESERVE),
+                            **{os.path.basename(p): fsha(p) for p in EXCL_SOURCES + OLD_INFER}),
+                checks=dict(mapping_duplicates=len(dups), zip_collisions=len(rz.collisions), n_old_pixel_hashes=len(old_pix),
+                            n_old_sops=len(old_sop), note="legacy 익명 영상 중복은 검사하지 않았다(미검증)."),
+                elapsed_s=time.monotonic() - t0)
+    wr(f"{OUT}/data/data_provenance.json", prov)
+    print(json.dumps({k: prov[k] for k in ("n_tech", "n_main", "m", "n_main_by_category", "n_excluded_union")}), len(skipped), "skipped")
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] != ["build"]:
+        sys.exit("usage: ed118_data.py build")
+    build()
diff --git a/ed118_det.py b/ed118_det.py
new file mode 100644
index 0000000..0beeda4
--- /dev/null
+++ b/ed118_det.py
@@ -0,0 +1,115 @@
+"""iter_118 detector17 epoch18 추론 (GT 없는 loader). natten_py310 환경에서 `conda run -p ... python ed118_det.py ...` 로 실행한다.
+
+- 체크포인트 SHA256을 확인한다 (576b8d78...). threshold/NMS/cap은 변경하지 않는다 (box_score_thresh 0.001 원시 출력 저장, 0.70 적용은 평가 명세에서).
+- 입력은 ledger의 PNG만 읽는다. ed118_guard로 private 경로 접근이 거부·기록된다.
+- 명령: infer --ledger L --out raw_preds.json   /  regress --out R.json  (기존 확인 영상 2개의 threshold 후 box/score 회귀 대조)
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+
+BASE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, BASE)
+import ed118_guard  # noqa: E402
+
+CKPT = f"{BASE}/results/iter_035/train/seed17/epoch_18/model.pt"
+CKPT_SHA = "576b8d789ef5f9e1924d7ad6e56954d51589dc437eaa12215874ce77cd3cc76c"
+THR = 0.70
+OLD_RAW = f"{BASE}/results/iter_035/confirm800/det17/raw_preds.json"
+OLD_INFER = f"{BASE}/results/iter_010/manifests/infer_manifest.jsonl"
+
+
+def fsha(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def load_model(device):
+    import torch
+    from rsna_diag import det_lib
+    if fsha(CKPT) != CKPT_SHA:
+        raise RuntimeError("checkpoint sha256 불일치")
+    ck = torch.load(CKPT, map_location="cpu", weights_only=False)
+    model = det_lib.build_model()
+    model.load_state_dict(ck["model"])
+    model.to(device).eval()
+    return torch, model
+
+
+def run(paths):
+    import numpy as np
+    from PIL import Image
+    from rsna_diag import geometry as G
+    device = "cuda"
+    torch, model = load_model(device)
+    out = {}
+    with torch.no_grad():
+        for key, path in paths:
+            arr = np.array(Image.open(path))
+            rgb = G.to_uint8_rgb_preserving(arr)
+            h, w = rgb.shape[:2]
+            img = torch.from_numpy(rgb).permute(2, 0, 1).float() / 255.0
+            pr = model([img.to(device)])[0]
+            out[key] = {"boxes_xyxy_px": pr["boxes"].cpu().numpy().tolist(), "scores": pr["scores"].cpu().numpy().tolist(),
+                        "labels": pr["labels"].cpu().numpy().tolist(), "img_hw": [h, w]}
+    return out, torch
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("cmd", choices=["infer", "regress"])
+    ap.add_argument("--ledger")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--log", required=True)
+    a = ap.parse_args()
+    for p in (a.out, a.log):
+        os.makedirs(os.path.dirname(os.path.abspath(p)), exist_ok=True)
+    ed118_guard.install([f"{BASE}/results/iter_118/private", f"{BASE}/results/iter_010/manifests/gt_manifest.json",
+                         f"{BASE}/results/iter_009/manifests/gt_manifest.json"], a.log)
+    if os.path.exists(a.out):
+        sys.exit("출력 존재: 덮어쓰지 않는다")
+    t0 = time.time()
+    if a.cmd == "infer":
+        rows = json.load(open(a.ledger))["rows"]
+        pred, torch = run([(r["id"], os.path.join(BASE, r["image"])) for r in rows])
+        res = dict(checkpoint_sha256=CKPT_SHA, ledger_sha256=fsha(a.ledger), threshold_applied_later=THR, n=len(pred), preds=pred,
+                   torch=torch.__version__, device=torch.cuda.get_device_name(0), wall_s=time.time() - t0,
+                   cuda_visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES"))
+    else:
+        old = json.load(open(OLD_RAW))
+        inf = {}
+        for ln in open(OLD_INFER):
+            r = json.loads(ln)
+            inf[r["id"]] = r["image"]
+        ids = []
+        for k in sorted(old):  # 임계값 이상 box가 있는 영상 1개 + 없는 영상 1개 (결정적 선택: 정렬 순 첫 항목)
+            has = any(s >= THR for s in old[k]["scores"])
+            if has and sum(1 for i in ids if i[1]) == 0:
+                ids.append((k, True))
+            elif not has and sum(1 for i in ids if not i[1]) == 0:
+                ids.append((k, False))
+            if len(ids) == 2:
+                break
+        pred, torch = run([(k, os.path.join(BASE, inf[k])) for k, _ in ids])
+        cmp = []
+        for k, has in ids:
+            o, n = old[k], pred[k]
+            oo = [(s, b) for s, b in zip(o["scores"], o["boxes_xyxy_px"]) if s >= THR]
+            nn = [(s, b) for s, b in zip(n["scores"], n["boxes_xyxy_px"]) if s >= THR]
+            md = max((abs(x - y) for (s1, b1), (s2, b2) in zip(oo, nn) for x, y in list(zip(b1, b2)) + [(s1, s2)]), default=0.0)
+            cmp.append(dict(id=k, old_has_box=has, n_old=len(oo), n_new=len(nn), max_abs_diff=md,
+                            n_all_old=len(o["scores"]), n_all_new=len(n["scores"])))
+        res = dict(cmp=cmp, ok=all(c["n_old"] == c["n_new"] and c["max_abs_diff"] < 0.05 for c in cmp), tolerance="box px/score abs <0.05")
+    with open(a.out, "x") as f:
+        json.dump(res, f, indent=1)
+    print(json.dumps({k: v for k, v in res.items() if k not in ("preds",)}, default=str)[:1500])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ed118_eval.py b/ed118_eval.py
new file mode 100644
index 0000000..011514a
--- /dev/null
+++ b/ed118_eval.py
@@ -0,0 +1,263 @@
+"""iter_118 평가 (생성 전에 잠금). 입력은 검증된 record, cond_map, labels, ledger_det.
+
+정의 (계획 Evaluation만 구현; 계획에 없는 사건 수 문턱은 추가하지 않는다):
+ - 정답 gt: category=='opacity' → yes, 그 외 → no. outcome(X) = ok|bad|unk (direction이 gt와 같음/반대/unknown).
+ - 주 지표 H_W = [n(E ok, W bad) − n(E bad, W ok)] / N (명시 방향 전환만; unknown 전이는 별도 표에 모두 보고). H_C 동일.
+ - bootstrap: category 층별 환자 resample 10,000회 seed 11817 (세 조건·정책을 같은 환자 단위로), percentile 95%. 주검정은 H_W 하나.
+ - unknown 범위: unknown 셀을 환자별로 모든 ok/bad 배정으로 열거한 합의 최소/최대 (환자 간 독립이므로 합산이 정확).
+ - 정책: B(detector≥0.70 box 있으면 yes), D_C/D_W(초안 유지), S_X = E 명시 답이 B와 같으면 그 답, 아니면 초안 X (E unknown→초안).
+ - 공동 지표: 최종 yes → detector box 유지, no → 제거. 양성: yes이고 IoU0.3 최대 일대일 matching에서 tp==n_gt==n_pred, 음성: no.
+   unknown은 공동 성공이 아니다. box 경계 개선·위치 정보의 인과 사용은 평가하지 않는다.
+ - 판정 라벨(사전): H_W≥0.10 & CI 하한>0 → content_harm_signal; CI 상한<0.10 → no_large_content_harm; 그 외 inconclusive.
+"""
+import itertools
+import json
+import os
+
+import numpy as np
+
+import ed118_spec as S
+from rsna_diag import geometry as GEO
+from rsna_diag import metrics as MET
+
+H_THRESHOLD = 0.10
+CATS = ("opacity", "normal", "not_normal_no_opacity")
+
+
+def outcome(direction, gt):
+    if direction == "unknown":
+        return "unk"
+    return "ok" if direction == gt else "bad"
+
+
+def det_answer(row):
+    return "yes" if any(s >= S.THR for s in row["det"]["scores"]) else "no"
+
+
+def det_norm(row):
+    h, w = row["size_hw"]
+    top, left, side = GEO.pad_offsets(h, w)
+    boxes = [b for s, b in zip(row["det"]["scores"], row["det"]["boxes_xyxy_px"]) if s >= S.THR]
+    return [GEO.canvas_to_norm(b, top, left, side) for b in boxes]
+
+
+def gt_norm(row, lab):
+    h, w = row["size_hw"]
+    top, left, side = GEO.pad_offsets(h, w)
+    return [GEO.canvas_to_norm(b, top, left, side) for b in lab["boxes_xyxy_px"]]
+
+
+def joint_success(ans, row, lab):
+    """ans: yes|no|unknown (최종 답). 계획의 공동 성공 정의."""
+    if ans not in ("yes", "no"):
+        return False
+    if lab["gt_answer"] == "no":
+        return ans == "no"
+    if ans != "yes":
+        return False
+    pred, gt = det_norm(row), gt_norm(row, lab)
+    return len(pred) > 0 and len(MET.match(pred, gt, 0.3)) == len(gt) == len(pred)
+
+
+def build_patients(recs, cond_map, labels, ledger):
+    """recs: record 목록(검증됨). returns 환자별 dict 목록 (id 정렬)."""
+    byrow = {r["id"]: r for r in ledger}
+    raw = {}
+    for r in recs:
+        raw.setdefault(r["patient"], {})[cond_map[r["patient"]][r["cond"]]] = r
+    out = []
+    for pid in sorted(raw):
+        lab, row = labels[pid], byrow[pid]
+        gt = lab["gt_answer"]
+        b = det_answer(row)
+        p = dict(id=pid, cat=lab["category"], gt=gt, B=b, n_det=len(det_norm(row)), n_gt=len(lab["boxes_xyxy_px"]))
+        cls = {}
+        for c in S.CONDS:
+            r = raw[pid][c]
+            k = S.classify(r["suffix_text_raw"], r["ended_eos"])
+            cls[c] = k
+            p[c] = dict(direction=k["direction"], outcome=outcome(k["direction"], gt),
+                        outcome_conf=outcome(k["direction"], gt) if k["confirmed"] else "unk",
+                        flags={f: k[f] for f in ("hedged", "conditional", "contradictory", "refusal", "parse_failure", "non_eos", "confirmed")},
+                        note=k["note"], n_tokens=r["n_output_tokens"], text=r["suffix_text_raw"][:400])
+        drafts = {"C": gt, "W": S.opposite(gt)}
+        pol = {"B": b, "D_C": drafts["C"], "D_W": drafts["W"], "E": cls["E"]["direction"], "C": cls["C"]["direction"], "W": cls["W"]["direction"],
+               "S_C": S.synth_policy(cls["E"], b, drafts["C"]), "S_W": S.synth_policy(cls["E"], b, drafts["W"])}
+        p["policy"] = pol
+        p["policy_outcome"] = {k: outcome(v, gt) for k, v in pol.items()}
+        p["joint"] = {k: joint_success(v, row, lab) for k, v in pol.items()}
+        p["e_unconfirmed_fallback"] = not (cls["E"]["direction"] in ("yes", "no") and cls["E"]["direction"] == b)
+        out.append(p)
+    return out
+
+
+def vec(ps, fn):
+    return np.array([fn(p) for p in ps], dtype=float)
+
+
+def stat_vectors(ps, key="outcome"):
+    """각 통계의 환자별 기여 벡터. 합/N이 통계다."""
+    o = lambda p, c: p[c][key]
+    v = {}
+    for c in ("W", "C"):
+        v[f"H_{c}"] = vec(ps, lambda p: (o(p, "E") == "ok" and o(p, c) == "bad") - (o(p, "E") == "bad" and o(p, c) == "ok"))
+    v["H_W_minus_H_C"] = v["H_W"] - v["H_C"]
+    for c in S.CONDS:
+        v[f"ok_{c}"] = vec(ps, lambda p: o(p, c) == "ok")
+        v[f"bad_{c}"] = vec(ps, lambda p: o(p, c) == "bad")
+        v[f"unk_{c}"] = vec(ps, lambda p: o(p, c) == "unk")
+    for c in ("W", "C"):
+        v[f"dAcc_{c}_minus_E"] = v[f"ok_{c}"] - v["ok_E"]
+        v[f"dBad_{c}_minus_E"] = v[f"bad_{c}"] - v["bad_E"]
+        v[f"dUnk_{c}_minus_E"] = v[f"unk_{c}"] - v["unk_E"]
+    for k in ("B", "D_C", "D_W", "S_C", "S_W"):
+        v[f"ok_{k}"] = vec(ps, lambda p: p["policy_outcome"][k] == "ok")
+    v["dAcc_S_W_minus_W"] = v["ok_S_W"] - v["ok_W"]
+    v["dAcc_S_W_minus_E"] = v["ok_S_W"] - v["ok_E"]
+    v["dAcc_S_C_minus_E"] = v["ok_S_C"] - v["ok_E"]
+    v["dAcc_E_minus_B"] = v["ok_E"] - v["ok_B"]
+    v["dAcc_S_W_minus_B"] = v["ok_S_W"] - v["ok_B"]
+    for k in ("E", "C", "W", "S_C", "S_W", "B"):
+        v[f"joint_{k}"] = vec(ps, lambda p: p["joint"][k])
+    return v
+
+
+def bootstrap(ps, seed=S.SEED_BOOT, B=S.N_BOOT, key="outcome"):
+    rng = np.random.default_rng(seed)
+    vs = stat_vectors(ps, key)
+    idx_by_cat = {c: np.array([i for i, p in enumerate(ps) if p["cat"] == c]) for c in CATS}
+    n = len(ps)
+    samples = {k: np.zeros(B) for k in vs}
+    for c in CATS:
+        ids = idx_by_cat[c]
+        if len(ids) == 0:
+            continue
+        draw = ids[rng.integers(0, len(ids), size=(B, len(ids)))]
+        for k, v in vs.items():
+            samples[k] += v[draw].sum(axis=1)
+    out = {}
+    for k, v in vs.items():
+        s = samples[k] / n
+        out[k] = dict(point=float(v.sum() / n), lo=float(np.percentile(s, 2.5)), hi=float(np.percentile(s, 97.5)))
+    return out
+
+
+def transition_table(ps, c, key="outcome"):
+    t = {a: {b: 0 for b in ("ok", "bad", "unk")} for a in ("ok", "bad", "unk")}
+    for p in ps:
+        t[p["E"][key]][p[c][key]] += 1
+    return t  # t[E outcome][X outcome]
+
+
+def h_range(ps, c, key="outcome"):
+    """H_c의 unknown 배정 범위 (환자별 열거)."""
+    lo = hi = 0
+    for p in ps:
+        es = ("ok", "bad") if p["E"][key] == "unk" else (p["E"][key],)
+        xs = ("ok", "bad") if p[c][key] == "unk" else (p[c][key],)
+        vals = [(e == "ok" and x == "bad") - (e == "bad" and x == "ok") for e in es for x in xs]
+        lo += min(vals)
+        hi += max(vals)
+    n = len(ps)
+    return [lo / n, hi / n]
+
+
+def acc_range(ps, getter):
+    n = len(ps)
+    ok = sum(getter(p) == "ok" for p in ps)
+    unk = sum(getter(p) == "unk" for p in ps)
+    return [ok / n, (ok + unk) / n]
+
+
+def diff_range(a, b):
+    return [a[0] - b[1], a[1] - b[0]]
+
+
+def wilson(k, n, z=1.959964):
+    if n == 0:
+        return [None, None]
+    p = k / n
+    d = 1 + z * z / n
+    c = p + z * z / (2 * n)
+    h = z * (p * (1 - p) / n + z * z / (4 * n * n)) ** 0.5
+    return [(c - h) / d, (c + h) / d]
+
+
+def cond_summary(ps, c):
+    n = len(ps)
+    f = lambda name: sum(p[c]["flags"][name] for p in ps)
+    return dict(n=n, explicit_ok=sum(p[c]["outcome"] == "ok" for p in ps), explicit_bad=sum(p[c]["outcome"] == "bad" for p in ps),
+                unknown=sum(p[c]["outcome"] == "unk" for p in ps), confirmed=f("confirmed"),
+                confirmed_ok=sum(p[c]["outcome_conf"] == "ok" for p in ps), confirmed_bad=sum(p[c]["outcome_conf"] == "bad" for p in ps),
+                hedged=f("hedged"), conditional=f("conditional"), contradictory=f("contradictory"), refusal=f("refusal"),
+                parse_failure=f("parse_failure"), non_eos=f("non_eos"),
+                direction_yes=sum(p[c]["direction"] == "yes" for p in ps), direction_no=sum(p[c]["direction"] == "no" for p in ps),
+                mean_output_tokens=float(np.mean([p[c]["n_tokens"] for p in ps])))
+
+
+def subgroup_block(ps):
+    n = len(ps)
+    d = dict(n=n, E=cond_summary(ps, "E") if n else None)
+    if n:
+        for c in ("C", "W"):
+            d[c] = cond_summary(ps, c)
+        d["H_W_point"] = (sum((p["E"]["outcome"] == "ok" and p["W"]["outcome"] == "bad") - (p["E"]["outcome"] == "bad" and p["W"]["outcome"] == "ok")
+                              for p in ps)) / n
+        d["H_C_point"] = (sum((p["E"]["outcome"] == "ok" and p["C"]["outcome"] == "bad") - (p["E"]["outcome"] == "bad" and p["C"]["outcome"] == "ok")
+                              for p in ps)) / n
+    return d
+
+
+def report(ps, extra=None):
+    n = len(ps)
+    boot = bootstrap(ps)
+    bootc = bootstrap(ps, key="outcome_conf")
+    rep = dict(n=n, n_by_category={c: sum(p["cat"] == c for p in ps) for c in CATS}, conditions={c: cond_summary(ps, c) for c in S.CONDS},
+               transitions={c: transition_table(ps, c) for c in ("W", "C")}, transitions_confirmed={c: transition_table(ps, c, "outcome_conf") for c in ("W", "C")},
+               H=dict(W=boot["H_W"], C=boot["H_C"], W_minus_C=boot["H_W_minus_H_C"]), H_confirmed=dict(W=bootc["H_W"], C=bootc["H_C"]),
+               H_unknown_range=dict(W=h_range(ps, "W"), C=h_range(ps, "C")), bootstrap=boot, bootstrap_confirmed_only=bootc)
+    rng = {c: acc_range(ps, lambda p, c=c: p[c]["outcome"]) for c in S.CONDS}
+    rep["acc_range_unknown_as_wrong_or_right"] = rng
+    rep["acc_diff_range"] = dict(W_minus_E=diff_range(rng["W"], rng["E"]), C_minus_E=diff_range(rng["C"], rng["E"]))
+    rep["policies"] = {k: dict(n_ok=sum(p["policy_outcome"][k] == "ok" for p in ps), n_bad=sum(p["policy_outcome"][k] == "bad" for p in ps),
+                               n_unk=sum(p["policy_outcome"][k] == "unk" for p in ps), joint_success=sum(p["joint"][k] for p in ps))
+                       for k in ("B", "D_C", "D_W", "E", "C", "W", "S_C", "S_W")}
+    rep["S_fallback_to_draft_n"] = sum(p["e_unconfirmed_fallback"] for p in ps)
+    rep["category_subgroups"] = {c: subgroup_block([p for p in ps if p["cat"] == c]) for c in CATS}
+    rep["detector_subgroups"] = {k: subgroup_block([p for p in ps if (p["B"] == p["gt"]) == (k == "detector_correct")]) for k in ("detector_correct", "detector_wrong")}
+    rep["E_subgroups"] = {k: subgroup_block([p for p in ps if p["E"]["outcome"] == k]) for k in ("ok", "bad", "unk")}
+    eok = [p for p in ps if p["E"]["outcome"] == "ok"]
+    rep["conditional_on_E_ok"] = dict(
+        n=len(eok), W_bad=sum(p["W"]["outcome"] == "bad" for p in eok), W_unk=sum(p["W"]["outcome"] == "unk" for p in eok),
+        C_bad=sum(p["C"]["outcome"] == "bad" for p in eok), C_unk=sum(p["C"]["outcome"] == "unk" for p in eok),
+        W_bad_wilson=wilson(sum(p["W"]["outcome"] == "bad" for p in eok), len(eok)),
+        E_ok_and_B_ok=sum(p["B"] == p["gt"] for p in eok),
+        E_ok_B_ok_W_bad_ids=[p["id"] for p in eok if p["B"] == p["gt"] and p["W"]["outcome"] == "bad"],
+        reverse_transitions_E_bad_W_ok=sum(p["E"]["outcome"] == "bad" and p["W"]["outcome"] == "ok" for p in ps))
+    d = rep["bootstrap"]["dAcc_W_minus_E"]
+    dbad, dunk = rep["bootstrap"]["dBad_W_minus_E"], rep["bootstrap"]["dUnk_W_minus_E"]
+    rep["W_vs_E_decomposition"] = dict(dAcc_strict=d, dExplicitBad=dbad, dUnknown=dunk,
