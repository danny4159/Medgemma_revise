+
+GUARD_DENY = ["results/iter_118/private", "results/iter_010/manifests/gt_manifest.json", "results/iter_009/manifests/gt_manifest.json",
+              "results/iter_116/provenance/gt.json"]
+
+
+def worker_main(a):
