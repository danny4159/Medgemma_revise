+"""iter_114: CURE–MG 위치 불일치(D_cure), 의료 적응 MedGrounder MSPC–MG 불일치(D_mspc), MG confidence(B)의 오류 검토 포착 비교 (CPU 분석).
+
+고정 규칙(iter_113 에서 이어받음, 새 결과 전에 protocol.json 에 코드·입력 hash 와 함께 잠근다):
+- 대상 M = MedGrounder A_U_e5 의 선택 운영점 0.8 출력. 오류 E_G=1[union IoU(M, 공식 GT)<0.3], 빈 M 은 오류.
+- 위험 B=1-min(M scores)(M 비면 1). D_cure=1-unionIoU(M,CURE), D_mspc=1-unionIoU(M,MSPC) (둘 다 빈 출력이면 0, 한쪽만 비면 1).
+- CURE truncated/malformed/coord_invalid, MSPC 비유한/범위 밖 box, MG 기술 결함은 세 순위에서 공통 제외(원 분모·이유 보존). CURE no_box 는 빈 집합.
+- 순위: 위험 내림차순, 동률은 (sha256("iter113|item_key"), 복제 순번) 오름차순. K=ceil(N/4).
+- ΔA=(cap_D_cure-cap_B)/N, ΔB=(cap_D_cure-cap_D_mspc)/N. 환자 bootstrap 20000회 seed 113, 매 복제마다 N/K/세 순위 재계산,
+  양측 98.75% percentile(= 0.625, 99.375). 확대: 초기에서 A 또는 B 가 (상한>=0.05 and 반폭>0.05) 이면 최대 집단까지 한 번.
+- 두 순위의 합집합 포착은 같은 K 의 성능으로 제시하지 않는다.
+"""
+import json
+import random
+
+import numpy as np
+
+import nr113_core as B
+import nr107_geom as G
+
+TAG = "iter114"
+SEED = 113
+BOOT_N = 20000
+CI_Q = (0.625, 99.375)
+MIN_EFFECT = 0.05
+FIELDS = ("B", "D", "P")  # confidence / cure / mspc
+
+
+class LinkError(B.LinkError):
+    pass
+
+
+def mspc_defects(det):
+    bad = []
+    if len(det["boxes_orig_xyxy"]) != len(det["scores"]):
+        return ["mspc_scores_length"]
+    if any(not B.box_ok(b) for b in det["boxes_orig_xyxy"]):
+        bad.append("mspc_invalid_box")
+    if any((not isinstance(s, (int, float)) or s != s or s in (float("inf"), float("-inf"))) for s in det["scores"]):
+        bad.append("mspc_score_nonfinite")
+    elif any(s < float(B.THR_KEY) for s in det["scores"]):
+        bad.append("mspc_score_below_thr")
+    return bad
+
+
+def mg_target_defects(det):
+    """대상 MG(A) 한 출력의 기술 결함. iter_113 link 의 check_boxes("mg", ...) 규칙(범위 밖·퇴화 box = 연결 결함 → 항목 공통 제외)을 이어받는다."""
+    bad = [x.replace("mg_", "mg_A_") for x in B.mg_defects(det)]
+    if not bad and any(not B.box_ok(b) for b in det["boxes_orig_xyxy"]):
+        bad.append("mg_A_invalid_box")
+    return bad
+
+
+def build_entries(ledger, require=("cure", "mspc")):
+    """ledger 항목 -> 순위 entry. excluded_from_ranking 이 있는 항목은 제외 목록으로."""
+    ent, excl = [], []
+    for l in ledger:
+        why = l.get("excluded_from_ranking")
+        if why:
+            excl.append({"item_key": l["item_key"], "reason": why})
+            continue
+        eg = B.is_error(l["M"], l["GT"])
+        eh = B.is_error(l["M"], l["ALT"]) if l["ALT"] else None
+        e = {"item_key": l["item_key"], "patient": l["PatientID"], "tk": B.tie_key(l["item_key"]),
+             "D": B.risk_d(l["M"], l["C"]), "B": B.risk_b(l["M_scores"]), "e": eg, "eh": eh, "annot": B.annot_status(eg, eh),
+             "iou_M_GT": G.union_iou(l["M"], l["GT"]) if l["M"] else 0.0}
+        e["P"] = B.risk_d(l["M"], l["P"]) if "P" in l else None
+        ent.append(e)
+    return ent, excl
+
+
+def captures(entries):
+    sel = {f: B.select(entries, f)[0] for f in FIELDS}
+    K = B.k_of(len(entries))
+    cap = {f: sum(entries[i]["e"] for i in sel[f]) for f in FIELDS}
+    return cap, sel, K
+
+
+def deltas(entries):
+    cap, sel, K = captures(entries)
+    return cap["D"] - cap["B"], cap["D"] - cap["P"], cap, sel, K
+
+
+def bounds_pair(entries, fx, fy, und):
+    n = len(entries)
+    sx, _ = B.select(entries, fx)
+    sy, _ = B.select(entries, fy)
+    ox, rx = B.tie_options(entries, fx)
+    oy, ry = B.tie_options(entries, fy)
+    fxo, fyo = B.fixed_options(entries, sx), B.fixed_options(entries, sy)
+    none = [False] * n
+    free = list(und)
+    return {"tie_only": (B.extreme(entries, ox, rx, oy, ry, none, False), B.extreme(entries, ox, rx, oy, ry, none, True)),
+            "annot_only": (B.extreme(entries, fxo, 0, fyo, 0, free, False), B.extreme(entries, fxo, 0, fyo, 0, free, True)),
+            "tie_and_annot": (B.extreme(entries, ox, rx, oy, ry, free, False), B.extreme(entries, ox, rx, oy, ry, free, True))}
+
+
+def side_range(entries, field):
+    n = len(entries)
+    zero = [0] * n
+    free = [False] * n
+    opt, r = B.tie_options(entries, field)
+    lo = B.extreme(entries, opt, r, zero, 0, free, False)
+    hi = B.extreme(entries, opt, r, zero, 0, free, True)
+    return (lo, hi)
+
+
+def complementarity(entries, sel, a, b):
+    sa, sb = sel[a], sel[b]
+    cats = {"a_only": [i for i in sorted(sa) if i not in sb], "b_only": [i for i in sorted(sb) if i not in sa], "both": [i for i in sorted(sa) if i in sb],
+            "neither": [i for i in range(len(entries)) if i not in sa and i not in sb]}
+    out = {}
+    for k, idx in cats.items():
+        err = [i for i in idx if entries[i]["e"]]
+        out[k + "_errors"] = [entries[i]["item_key"] for i in err]
+        out[k + "_error_patients"] = len({entries[i]["patient"] for i in err})
+    return out
+
+
+def bootstrap(entries, n_boot=BOOT_N, seed=SEED):
+    pats = sorted({e["patient"] for e in entries})
+    by_p = {p: [e for e in entries if e["patient"] == p] for p in pats}
+    rng = random.Random(seed)
+    out = []
+    for _ in range(n_boot):
+        draws = [rng.randrange(len(pats)) for _ in pats]
+        rep = []
+        for j, di in enumerate(draws):
+            for e in by_p[pats[di]]:
+                ne = dict(e)
+                ne["tk"] = (e["tk"][0], j)
+                rep.append(ne)
+        dA, dB, cap, _, K = deltas(rep)
+        out.append((dA, dB, len(rep)))
+    return out
+
+
+def summarize(boot):
+    res = {}
+    for name, idx in (("A", 0), ("B", 1)):
+        v = np.array([x[idx] / x[2] for x in boot])
+        lo, hi = (float(np.percentile(v, q)) for q in CI_Q)
+        res[name] = {"ci_9875": [lo, hi], "half_width": (hi - lo) / 2, "ci95_descriptive": [float(np.percentile(v, 2.5)), float(np.percentile(v, 97.5))],
+                     "mean": float(v.mean()), "p_gt0": float((v > 0).mean()), "p_lt0": float((v < 0).mean()), "n": len(v)}
+    return res
+
+
+def leave_one_patient_out(entries):
+    out = {}
+    for p in sorted({e["patient"] for e in entries}):
+        sub = [e for e in entries if e["patient"] != p]
+        dA, dB, cap, _, K = deltas(sub)
+        out[p] = {"N": len(sub), "K": K, "dA": dA, "dB": dB}
+    return out
+
+
+def analyze(ledger, n_boot=BOOT_N, seed=SEED):
+    ent, excl = build_entries(ledger)
+    N = len(ent)
+    dA, dB, cap, sel, K = deltas(ent)
+    und = [e["annot"].startswith("undetermined") for e in ent]
+    bA = bounds_pair(ent, "D", "B", und)
+    bB = bounds_pair(ent, "D", "P", und)
+    boot = bootstrap(ent, n_boot, seed)
+    s = summarize(boot)
+    loo = leave_one_patient_out(ent)
+    res = {"N": N, "K": K, "n_patients": len({e["patient"] for e in ent}), "n_errors_official": sum(e["e"] for e in ent),
+           "excluded_from_ranking": excl, "capture": {"cure": cap["D"], "mspc": cap["P"], "confidence": cap["B"]},
+           "precision": {"cure": cap["D"] / K, "mspc": cap["P"] / K, "confidence": cap["B"] / K},
+           "dA_count": dA, "dB_count": dB, "dA": dA / N, "dB": dB / N,
+           "selected": {"cure": [ent[i]["item_key"] for i in sorted(sel["D"])], "mspc": [ent[i]["item_key"] for i in sorted(sel["P"])],
+                        "confidence": [ent[i]["item_key"] for i in sorted(sel["B"])]},
+           "complementarity_A": complementarity(ent, sel, "D", "B"), "complementarity_B": complementarity(ent, sel, "D", "P"),
+           "annotation_status_counts": {k: sum(1 for e in ent if e["annot"] == k) for k in ("confirmed_error", "confirmed_ok", "undetermined_disagree", "undetermined_no_alt")},
+           "bounds_A": bA, "bounds_B": bB,
+           "side_tie_ranges": {"cure": side_range(ent, "D"), "mspc": side_range(ent, "P"), "confidence": side_range(ent, "B")},
+           "bootstrap": s, "leave_one_patient_out": {"A": {"min": min(v["dA"] for v in loo.values()), "max": max(v["dA"] for v in loo.values()), "n_negative": sum(v["dA"] < 0 for v in loo.values())},
+                                                       "B": {"min": min(v["dB"] for v in loo.values()), "max": max(v["dB"] for v in loo.values()), "n_negative": sum(v["dB"] < 0 for v in loo.values())},
+                                                       "per_patient": loo}}
+    res["positive_checks"] = {"A": positive_checks(res, "A"), "B": positive_checks(res, "B")}
+    return res, ent, boot
+
+
+def positive_checks(res, which):
+    d = res["dA" if which == "A" else "dB"]
+    b = res["bounds_" + which]
+    ci = res["bootstrap"][which]["ci_9875"]
+    loo = res["leave_one_patient_out"][which]
+    return {"delta_ge_min": d >= MIN_EFFECT, "ci_lower_gt0": ci[0] > 0, "conservative_tie_annot_min_gt0": b["tie_and_annot"][0] > 0,
+            "loo_no_negative": loo["n_negative"] == 0}
+
+
+def expansion_decision(res_init, n_remaining_patients):
+    """사전 규칙: 초기 평가에서 A 또는 B 중 하나라도 (상한>=0.05 and 반폭>0.05) 이면 확대. 남은 환자가 없으면 종료."""
+    cond = {}
+    for w in ("A", "B"):
+        b = res_init["bootstrap"][w]
+        cond[w] = {"ci_upper": b["ci_9875"][1], "half_width": b["half_width"], "upper_ge_0.05": b["ci_9875"][1] >= MIN_EFFECT, "half_width_gt_0.05": b["half_width"] > MIN_EFFECT}
+        cond[w]["meets"] = cond[w]["upper_ge_0.05"] and cond[w]["half_width_gt_0.05"]
+    expand = (cond["A"]["meets"] or cond["B"]["meets"]) and n_remaining_patients > 0
+    return {"conditions": cond, "n_remaining_patients": n_remaining_patients, "expand": bool(expand)}
+
+
+def judge(res, cost_mspc_le_cure):
+    """최종 투자 판정 입력. cost_mspc_le_cure: True/False/None(불확정)."""
+    out = {}
+    for w in ("A", "B"):
+        pc = res["positive_checks"][w]
+        ci = res["bootstrap"][w]["ci_9875"]
+        if all(pc.values()):
+            st = "positive"
+        elif ci[1] < MIN_EFFECT:
+            st = "min_useful_effect_excluded_opposite_direction" if ci[1] <= 0 else "min_useful_effect_excluded"
+        else:
+            st = "inconclusive"
+        out[w] = {"status": st, "checks": pc, "ci_9875": ci}
+    b_hi = res["bootstrap"]["B"]["ci_9875"][1]
+    general_sufficient = b_hi < MIN_EFFECT and cost_mspc_le_cure is True
+    out["general_control_sufficient"] = general_sufficient
+    out["general_control_cost_unresolved"] = (b_hi < MIN_EFFECT and cost_mspc_le_cure is None)
+    if out["A"]["status"] == "positive" and out["B"]["status"] == "positive":
+        out["summary"] = "A_and_B_positive"
+    elif out["A"]["status"] == "positive":
+        out["summary"] = "A_only_positive"
+    elif general_sufficient:
+        out["summary"] = "general_control_sufficient_hold_specific_investment"
+    else:
+        out["summary"] = "inconclusive_or_excluded"
+    return out
diff --git a/nr114_cost.py b/nr114_cost.py
new file mode 100644
index 0000000..6909962
--- /dev/null
+++ b/nr114_cost.py
@@ -0,0 +1,68 @@
+"""iter_114 모델별 추가 비용 집계(실측 로그 기반, 새 모델 호출 없음). 사전 규칙: MSPC 추가 비용이 CURE 추가 비용 이하라고 말하려면
+warm(적재 제외 생성 구간)과 cold(적재 포함) device-seconds 가 모두 이하여야 한다. 하나라도 어긋나면 False, 측정 불완전하면 None.
+측정 범위: worker 프로세스별 모델 적재 후 요청 처리 구간(영상 전처리·forward·후처리·fsync 포함) = executions 'end'.wall_s, 적재 = 'start'.load_s(CURE는 loading_s).
+worker 1개 = GPU 1장이므로 합이 device-seconds. 중단·재개된 실행은 'end' 이벤트가 없는 시작을 unmeasured 로 표시한다.
+MG 대상(A)의 비용은 두 조합에 공통이다. 서비스 전체 비용(영상 입력부터 순위까지)의 일부이며 임상 처리량이 아니다.
+사용: python nr114_cost.py <init|final>  → analysis/cost_<stage>.json (새 파일)
+"""
+import json
+import sys
+from pathlib import Path
+
+R = Path("results/iter_114")
+AN = R / "analysis_r1"
+
+
+def read_events(path):
+    return [json.loads(l) for l in open(path) if l.strip()]
+
+
+def agg(files, load_key):
+    starts = ends = 0
+    warm = load = 0.0
+    n_saved = 0
+    for f in files:
+        for e in read_events(f):
+            if e["event"] == "start":
+                starts += 1
+                load += e[load_key]
+            elif e["event"] == "end":
+                ends += 1
+                warm += e["wall_s"]
+                n_saved += e["saved"]
+    return {"warm_s": warm, "load_s": load, "n_start": starts, "n_end": ends, "n_saved_in_ends": n_saved, "complete_measurement": starts == ends}
+
+
+def main(stage):
+    names = ["init"] if stage == "init" else ["init", "expand"]
+    tot = {k: {"warm_s": 0.0, "load_s": 0.0, "n_start": 0, "n_end": 0, "n_saved_in_ends": 0, "complete_measurement": True} for k in ("A", "MSPC", "CURE")}
+    attempts = 0
+    for nm in names:
+        runs = json.load(open(AN / f"runs_{nm}.json"))
+        parts = {"A": agg(sorted((Path(runs["A"])).glob("executions*.jsonl")), "load_s"),
+                 "MSPC": agg(sorted((Path(runs["MSPC"])).glob("executions*.jsonl")), "load_s"),
+                 "CURE": agg(sorted((Path(runs["CURE"]) / "cure").glob("shard*/executions.jsonl")), "loading_s")}
+        for k, v in parts.items():
+            for f in ("warm_s", "load_s", "n_start", "n_end", "n_saved_in_ends"):
+                tot[k][f] += v[f]
+            tot[k]["complete_measurement"] &= v["complete_measurement"]
+        for rec in (Path(runs["CURE"]) / "cure").glob("shard*/outputs.jsonl"):
+            for l in open(rec):
+                if l.strip():
+                    attempts += len(json.loads(l)["attempts"])
+    complete = all(v["complete_measurement"] for v in tot.values())
+    res = {"stage": stage, "per_model": tot, "cure_total_generate_calls_incl_cap_retries": attempts,
+           "added_cost": {"mspc_warm_s": tot["MSPC"]["warm_s"], "mspc_cold_s": tot["MSPC"]["warm_s"] + tot["MSPC"]["load_s"],
+                          "cure_warm_s": tot["CURE"]["warm_s"], "cure_cold_s": tot["CURE"]["warm_s"] + tot["CURE"]["load_s"]},
+           "shared_target_A_cold_s": tot["A"]["warm_s"] + tot["A"]["load_s"], "complete_measurement": complete}
+    ac = res["added_cost"]
+    res["mspc_cost_le_cure"] = (ac["mspc_warm_s"] <= ac["cure_warm_s"] and ac["mspc_cold_s"] <= ac["cure_cold_s"]) if complete else None
+    res["scope"] = __doc__
+    out = AN / f"cost_{stage}.json"
+    with out.open("x") as f:
+        json.dump(res, f, indent=1)
+    print(json.dumps({k: v for k, v in res.items() if k != "scope"}, indent=1))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/nr114_cure.py b/nr114_cure.py
new file mode 100644
index 0000000..a2746c1
--- /dev/null
+++ b/nr114_cure.py
@@ -0,0 +1,413 @@
+"""iter_114 CURE 단일 phrase grounding runner + launcher (nr107_run.py 를 iter_114 새 환자 입력·결과 경로에 맞춰 분리한 판본; iter_107 개발 T4 회귀 + 새 환자 INIT/EXPAND).
+
+유지: 공식 processor/chat template, CURE CLAHE 448 transform, greedy, cap 1024→2048→4096 비EOS 재시도, 요청 단위 append·fsync,
+부분 행 복구(pg43_run.repair_tail), shard completion, 전 shard 정확한 요청 ID 집합 검사, protocol/source/asset digest 잠금.
+보완: 큰 가중치 sha256+size+mtime 잠금(launcher는 매번 전체 hash 재계산), admission 실패도 launch 기록에 저장.
+출력은 results/iter_114 아래에만 쓴다. GT/extra는 요청에 들어가지 않는다(요청에는 원문 문장만).
+"""
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import nr107_spec as S
+from report86_common import (ROOT, CAPS, SEED, sha, sha_obj, save, read_jsonl_complete, record_digest, adapter_path_C, base_path, CURE_PY, R85,
+                             BASE_REV, ADAPTER_REV)
+
+R114 = ROOT / "results/iter_114"
+DEV_DATA = ROOT / "results/iter_107/data"  # 개발 T4 회귀 전용(읽기)
+NEW_DATA = R114 / "data"
+LOCKFILE = R114 / "protocol/weights_lock.json"
+EXEC_SOURCES = ["nr114_cure.py", "nr107_spec.py", "nr107_geom.py", "report86_common.py", "pg43_run.py", "rsna_diag/generate.py",
+                "rsna_diag/geometry.py", "rsna_diag/parse.py"]
+OFFICIAL_DIR = R85 / "official/minimal/vlm_research_kit"
+MARGIN_MIB = 2048
+PEAK_MIB = 10100  # iter_114 T4 실측: GPU 점유 최대 10069 MiB(peak reserved 9.43 GiB). 2 worker/GPU 는 2*10100+2*2048=24296 > 24039 MiB free 라 admission 불가 → GPU당 1 worker.
+STAGES = ("T4", "INIT", "EXPAND")
+
+
+def data_dir(stage):
+    return DEV_DATA if stage == "T4" else NEW_DATA
+
+
+def stage_items(stage):
+    items = json.loads((data_dir(stage) / "items.json").read_text())
+    if stage == "T4":
+        keys = json.loads((DEV_DATA / "cohort_summary.json").read_text())["tech_first4_item_keys"]
+        m = {it["item_key"]: it for it in items}
+        return [m[k] for k in keys]
+    want = "init" if stage == "INIT" else "expand"
+    return [it for it in items if it["stage"] == want]
+
+
+def raw_map(stage):
+    return {r["ImageID"]: r for r in json.loads((data_dir(stage) / "raw_manifest.json").read_text())}
+
+
+def requests(stage):
+    return S.requests_for(stage_items(stage))
+
+
+def small_asset_digests():
+    d = {}
+    snap = Path(base_path("C"))
+    assert snap.name == BASE_REV and adapter_path_C().name == ADAPTER_REV
+    for p in sorted(snap.iterdir()):
+        if (p.suffix in (".json", ".jinja", ".model") and "safetensors.index" not in p.name) or p.name == "model.safetensors.index.json":
+            d[f"base/{p.name}"] = sha(p)
+    for p in sorted(adapter_path_C().iterdir()):
+        if p.name != "adapter_model.safetensors" and p.suffix in (".json", ".jinja"):
+            d[f"adapter/{p.name}"] = sha(p)
+    for p in sorted(OFFICIAL_DIR.rglob("*.py")):
+        d[f"official/{p.relative_to(OFFICIAL_DIR)}"] = sha(p)
+    d["official/source_manifest.json"] = sha(R85 / "official/source_manifest.json")
+    return d
+
+
+def weights_files():
+    fs = sorted(Path(base_path("C")).glob("*.safetensors"))
+    fs.append(adapter_path_C() / "adapter_model.safetensors")
+    return fs
+
+
+def weight_stat(f):
+    st = f.resolve().stat()
+    return {"size": st.st_size, "mtime_ns": st.st_mtime_ns}
+
+
+def make_weights_lock():
+    """실제 base/adapter 가중치 sha256 을 새로 계산한다(이전 lock 계승 없음). 이미 있으면 FileExistsError."""
+    w = {}
+    for f in weights_files():
+        w[f.resolve().name] = {"sha256": sha(f.resolve()), **weight_stat(f)}
+    out = {"created": time.time(), "base_revision": BASE_REV, "adapter_revision": ADAPTER_REV, "weights": w, "small": small_asset_digests()}
+    save(LOCKFILE, out)
+    return out
+
+
+def check_weights_lock(full=False):
+    lock = json.loads(LOCKFILE.read_text())
+    assert small_asset_digests() == lock["small"], "asset digest (processor/config/chat template/official transform) changed"
+    for f in weights_files():
+        n = f.resolve().name
+        assert n in lock["weights"], f"unlocked weight {n}"
+        st = weight_stat(f)
+        assert st["size"] == lock["weights"][n]["size"] and st["mtime_ns"] == lock["weights"][n]["mtime_ns"], f"weight file changed {n}"
+        if full:
+            assert sha(f.resolve()) == lock["weights"][n]["sha256"], f"weight sha256 changed {n}"
+    return lock
+
+
+def scientific_protocol(stage, nshards):
+    reqs = requests(stage)
+    return {"system": "CURE", "stage": stage, "nshards": nshards, "seed": SEED, "caps": CAPS, "precision": "nf4_bf16_clahe448",
+            "requests_sha256": sha_obj(reqs), "n_requests": len(reqs), "items_sha256": sha(data_dir(stage) / "items.json"),
+            "raw_sha256": sha(data_dir(stage) / "raw_manifest.json"), "cohort_summary_sha256": sha(data_dir(stage) / "cohort_summary.json"),
+            "stage_items_sha256": sha_obj([{k: it[k] for k in ("item_key", "ImageID", "finding_index", "sentence_sha256")} for it in stage_items(stage)]),
+            "weights_lock_sha256": sha(LOCKFILE), "source_sha256": {f: sha(ROOT / f) for f in EXEC_SOURCES}}
+
+
+def isolated_env():
+    env = dict(os.environ)
+    cache = R114 / "runtime_cache"
+    for key, name in {"HF_HOME": "hf", "HF_HUB_CACHE": "hf/hub", "HF_XET_CACHE": "hf/xet", "XDG_CACHE_HOME": "xdg", "TORCH_HOME": "torch",
+                      "TORCHINDUCTOR_CACHE_DIR": "inductor", "TRITON_CACHE_DIR": "triton", "CUDA_CACHE_PATH": "cuda",
+                      "MPLCONFIGDIR": "matplotlib", "TMPDIR": "tmp"}.items():
+        p = cache / name
+        p.mkdir(parents=True, exist_ok=True)
+        env[key] = str(p)
+    env.update({"HF_HUB_OFFLINE": "1", "TOKENIZERS_PARALLELISM": "false", "NO_ALBUMENTATIONS_UPDATE": "1"})
+    return env
+
+
+def shard_dir(out, s):
+    return Path(out) / "cure" / f"shard{s}"
+
+
+def shard_target(stage, s, nshards):
+    items = stage_items(stage)
+    mine = {it["item_key"] for i, it in enumerate(items) if i % nshards == s}
+    return [q for q in requests(stage) if q["item_key"] in mine]
+
+
+def load_own(d, reqmap, sci_digest):
+    mine = read_jsonl_complete(Path(d) / "outputs.jsonl")
+    ids = [r["id"] for r in mine]
+    assert len(ids) == len(set(ids)), "duplicate id in own output"
+    for r in mine:
+        q = reqmap.get(r["id"])
+        assert q is not None, f"record outside request set {r['id']}"
+        assert r["protocol_digest"] == sci_digest, "record protocol digest mismatch"
+        assert r["record_digest"] == record_digest(r), "record digest mismatch (tampered)"
+        for k in ("prompt", "ImageID", "modality", "kind", "cond", "item_key"):
+            assert r[k] == q[k], f"record {k} differs from request"
+        assert r["n_pixel_values"] > 0 and r["n_image_tokens"] > 0, "image request lacks image tokens/pixels"
+    return mine
+
+
+def verify_completion(d, stage, s, nshards, sci_digest):
+    d = Path(d)
+    c = json.loads((d / "completion.json").read_text())
+    for name, h in c["files"].items():
+        assert sha(d / name) == h, f"completion file hash differs: {d}/{name}"
+    target = shard_target(stage, s, nshards)
+    reqmap = {q["id"]: q for q in target}
+    recs = load_own(d, reqmap, sci_digest)
+    assert {r["id"] for r in recs} == set(reqmap), "record set != expected request set (missing/extra)"
+    assert len(recs) == len(target) == c["n_own_records"]
+    return c, recs
+
+
+def worker(a):
+    out = Path(a.out).resolve()
+    out.relative_to(R114)
+    allowed = os.environ["CUDA_VISIBLE_DEVICES"].split(",")
+    assert a.gpu in allowed, f"gpu {a.gpu} not in inherited CUDA_VISIBLE_DEVICES {allowed}"
+    os.environ["CUDA_VISIBLE_DEVICES"] = a.gpu
+    check_weights_lock()
+    raw = raw_map(a.stage)
+    for it in stage_items(a.stage):
+        assert sha(raw[it["ImageID"]]["raw_path"]) == raw[it["ImageID"]]["sha256"], "raw image changed"
+    sci = scientific_protocol(a.stage, a.nshards)
+    sci_digest = sha_obj(sci)
+    d = shard_dir(out, a.shard)
+    d.mkdir(parents=True, exist_ok=True)
+    lock = (d / "worker.lock").open("a")
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    from pg43_run import repair_tail
+    repair_tail(str(d / "outputs.jsonl"))
+    meta = {"scientific": sci, "scientific_digest": sci_digest, "stage": a.stage, "shard": a.shard, "nshards": a.nshards}
+    mypath = d / "scientific_protocol.json"
+    if mypath.exists():
+        assert json.loads(mypath.read_text()) == json.loads(json.dumps(meta)), "resume: protocol/source/shard mismatch (before model load)"
+    else:
+        save(mypath, meta)
+    target = shard_target(a.stage, a.shard, a.nshards)
+    reqmap = {q["id"]: q for q in target}
+    if (d / "completion.json").exists():
+        verify_completion(d, a.stage, a.shard, a.nshards, sci_digest)
+        return 0
+    mine = load_own(d, reqmap, sci_digest)
+    done = {r["id"] for r in mine}
+    todo = [q for q in target if q["id"] not in done]
+    if a.limit:
+        todo = todo[:a.limit]
+    events = (d / "executions.jsonl").open("a", buffering=1)
+    execution = {"event": "start", "time": time.time(), "pid": os.getpid(), "gpu_physical": a.gpu, "python": sys.executable,
+                 "n_todo": len(todo), "n_target": len(target), "n_done_before": len(done)}
+    if todo:
+        generate(a, d, events, execution, todo, raw, sci_digest)
+    finish(d, a, target, reqmap, sci_digest)
+    return 0
+
+
+def load_model():
+    import torch
+    from transformers import AutoProcessor, AutoModelForImageTextToText, BitsAndBytesConfig
+    from peft import PeftModel
+    torch.set_num_threads(4)
+    torch.manual_seed(SEED)
+    base = base_path("C")
+    processor = AutoProcessor.from_pretrained(base, local_files_only=True)
+    kw = dict(torch_dtype=torch.bfloat16, device_map={"": 0}, local_files_only=True, attn_implementation="sdpa",
+              quantization_config=BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_use_double_quant=True, bnb_4bit_quant_type="nf4",
+                                                     bnb_4bit_compute_dtype=torch.bfloat16, bnb_4bit_quant_storage=torch.bfloat16))
+    model = AutoModelForImageTextToText.from_pretrained(base, **kw)
+    model = PeftModel.from_pretrained(model, str(adapter_path_C()), local_files_only=True)
+    assert set(model.peft_config["default"].modules_to_save) == {"lm_head", "embed_tokens"}
+    processor.tokenizer.padding_side = "left"
+    model.eval()
+    assert not any(m.training for m in model.modules())
+    return torch, processor, model
+
+
+def generate(a, d, events, execution, todo, raw, sci_digest):
+    import numpy as np
+    from rsna_diag import generate as G
+    t0 = time.monotonic()
+    torch, processor, model = load_model()
+    loading_s = time.monotonic() - t0
+    sys.path.insert(0, str(OFFICIAL_DIR.parent))
+    from vlm_research_kit.data.transforms_factory import create_image_transforms
+    transform = create_image_transforms(use_model_specific_transforms=True, model_name="pil_with_augmentations", bbox_format="cxcywh",
+                                        image_size=[448, 448], is_train=False, augmenter_override_params={"apply_clahe": True, "clahe_clip_limit": [3., 3.]})
+    eos = model.generation_config.eos_token_id
+    eos = [eos] if isinstance(eos, int) else eos
+    img_tok = getattr(processor, "image_token_id", None)
+    assert img_tok is not None
+    import transformers
+    events.write(json.dumps({**execution, "torch": torch.__version__, "transformers": transformers.__version__, "loading_s": loading_s}) + "\n")
+    saved = 0
+    t_start = time.monotonic()
+    with (d / "outputs.jsonl").open("a", buffering=1) as f:
+        for q in todo:
+            img = q["ImageID"]
+            im = transform(raw[img]["raw_path"])["pixel_values"]
+            px_sha = hashlib.sha256(np.asarray(im).tobytes()).hexdigest()
+            events.write(json.dumps({"event": "request_start", "id": q["id"], "time": time.time()}) + "\n")
+            inp = G.build_inputs(processor, im, q["prompt"])
+            official = processor.apply_chat_template([{"role": "user", "content": [{"type": "image", "image": im}, {"type": "text", "text": q["prompt"]}]}],
+                                                     add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors="pt", padding=True)
+            assert set(inp) == set(official) and all(torch.equal(inp[k], official[k]) for k in inp), "builder != official chat template"
+            n_img_tok = int((inp["input_ids"] == img_tok).sum())
+            n_pix = int(inp["pixel_values"].shape[0])
+            assert n_pix > 0 and n_img_tok > 0
+            attempts = []
+            for cap in CAPS:
+                result = G.generate(torch, processor, model, inp, cap, eos)
+                attempts.append(result)
+                if result["ended_eos"]:
+                    break
+            rec = {"id": q["id"], "ImageID": img, "item_key": q["item_key"], "system": "CURE", "kind": q["kind"], "modality": q["modality"],
+                   "cond": q["cond"], "order": q["order"], "prompt": q["prompt"], "protocol_digest": sci_digest, "image_sha256": raw[img]["sha256"],
+                   "text": processor.decode(result["suffix_ids"], skip_special_tokens=True), "attempts": attempts,
+                   "input_ids": inp["input_ids"][0].tolist(), "n_image_tokens": n_img_tok, "n_pixel_values": n_pix, "pixel_sha256": px_sha,
+                   "exec": {"gpu": a.gpu, "shard": a.shard, "pid": os.getpid(), "torch": torch.__version__}}
+            rec["record_digest"] = record_digest(rec)
+            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
+            f.flush()
+            os.fsync(f.fileno())
+            saved += 1
+            events.write(json.dumps({"event": "request_saved", "id": q["id"], "time": time.time(), "seconds": result["runtime_s"],
+                                     "n_new": result["n_new"], "attempts": len(attempts)}) + "\n")
+            print(json.dumps({"saved": saved, "of": len(todo), "shard": a.shard, "tokens": result["n_new"], "seconds": round(result["runtime_s"], 2)}), flush=True)
+    allrecs = read_jsonl_complete(d / "outputs.jsonl")
+    events.write(json.dumps({"event": "end", "time": time.time(), "saved": saved, "wall_s": time.monotonic() - t_start,
+                             "peak_reserved_gib_max": max(max(x["peak_mem_reserved_gb"] for x in r["attempts"]) for r in allrecs)}) + "\n")
+
+
+def finish(d, a, target, reqmap, sci_digest):
+    recs = load_own(d, reqmap, sci_digest)
+    got = {r["id"] for r in recs}
+    want = {q["id"] for q in target}
+    cp = d / "completion.json"
+    if want == got and not cp.exists():
+        events = [json.loads(l) for l in (d / "executions.jsonl").read_text().splitlines() if l]
+        save(cp, {"stage": a.stage, "system": "CURE", "shard": a.shard, "nshards": a.nshards, "n_own_records": len(recs), "n_expected_in_shard": len(want),
+                  "files": {"scientific_protocol.json": sha(d / "scientific_protocol.json"), "outputs.jsonl": sha(d / "outputs.jsonl")},
+                  "final_not_eos": sum(not r["attempts"][-1]["ended_eos"] for r in recs),
+                  "executions": len([e for e in events if e["event"] == "start"]),
+                  "generation_s_total": sum(sum(x["runtime_s"] for x in r["attempts"]) for r in recs),
+                  "cost_scope": "generation seconds of records in this shard dir; loading/interrupted cost in executions.jsonl"})
+
+
+def smi_free():
+    raw = subprocess.check_output(["nvidia-smi", "--query-gpu=index,memory.free,memory.used,memory.total", "--format=csv,noheader,nounits"], text=True)
+    return {x.split(",")[0].strip(): [int(v) for v in x.split(",")[1:]] for x in raw.splitlines()}
+
+
+def next_attempt(out):
+    nums = [int(m.group(1)) for p in Path(out).glob("launch*_*.stdout.log") for m in [re.match(r"launch(\d+)_", p.name)] if m]
+    nums += [int(m.group(1)) for p in Path(out).glob("launch_*.json") for m in [re.match(r"launch_(\d+)\.json", p.name)] if m]
+    return max(nums) + 1 if nums else 0
+
+
+def launch(a):
+    out = Path(a.out).resolve()
+    out.relative_to(R114)
+    out.mkdir(parents=True, exist_ok=True)
+    allowed = os.environ["CUDA_VISIBLE_DEVICES"].split(",")
+    check_weights_lock(full=True)
+    with (out / "launcher.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        sd = sha_obj(scientific_protocol(a.stage, a.workers))
+        mp = out / "mapping.json"
+        want_map = {"stage": a.stage, "workers": a.workers, "scientific_digest": sd}
+        if mp.exists():
+            assert json.loads(mp.read_text()) == want_map, "launcher mapping/protocol changed (source or inputs differ)"
+        else:
+            save(mp, want_map)
+        jobs = list(range(a.workers))
+        pending = [k for k in jobs if not (shard_dir(out, k) / "completion.json").exists()]
+        for k in jobs:
+            if k not in pending:
+                verify_completion(shard_dir(out, k), a.stage, k, a.workers, sd)
+        if not pending:
+            return 0
+        procs, logs, admission, codes, status, err = [], [], [], {}, "started", None
+        attempt = next_attempt(out)
+        start = time.monotonic()
+        env = isolated_env()
+        # worker -> GPU 배치: --placement "0,1,0,1" 형태(논리 index, 허용 집합 안에서만) 또는 여유 메모리 순 자동 배정
+        placement = a.placement.split(",") if a.placement else None
+        if placement:
+            assert len(placement) >= len(pending) and set(placement) <= set(allowed), ("placement outside allowed GPUs", placement, allowed)
+
+        def stop(*args):
+            raise KeyboardInterrupt("supervisor stopped; terminating owned children")
+        signal.signal(signal.SIGTERM, stop)
+        try:
+            for n, k in enumerate(pending):
+                st = smi_free()
+                apps = subprocess.check_output(["nvidia-smi", "--query-compute-apps=pid,used_memory", "--format=csv,noheader,nounits"], text=True)
+                actual = {int(x.split(",")[0]): int(x.split(",")[1]) for x in apps.splitlines() if x.strip()}
+                choices = {g: st[g][0] - sum(max(0, PEAK_MIB - actual.get(p.pid, 0)) + MARGIN_MIB for kk, p, gg in procs if gg == g and p.poll() is None)
+                           for g in allowed}
+                gpu = placement[n] if placement else max(choices, key=choices.get)
+                need = PEAK_MIB + MARGIN_MIB
+                admission.append({"job": k, "choices_free_mib": choices, "chosen": gpu, "need_mib": need, "smi": st})
+                assert choices[gpu] >= need, ("memory admission refused", choices)
+                cmd = [sys.executable, str(ROOT / "nr114_cure.py"), "worker", "--stage", a.stage, "--out", str(out), "--gpu", gpu, "--shard", str(k),
+                       "--nshards", str(a.workers)] + (["--limit", str(a.limit)] if a.limit else [])
+                cmd[0] = str(CURE_PY)
+                so = (out / f"launch{attempt}_cure{k}.stdout.log").open("x")
+                se = (out / f"launch{attempt}_cure{k}.stderr.log").open("x")
+                logs.extend([so, se])
+                procs.append((k, subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=so, stderr=se), gpu))
+                time.sleep(a.stagger)
+            with (out / f"launch{attempt}_resource.jsonl").open("x") as rf:
+                while any(p.poll() is None for _, p, _ in procs):
+                    rf.write(json.dumps({"t": time.time(), "smi": smi_free()}) + "\n")
+                    rf.flush()
+                    time.sleep(10)
+            codes = {f"cure{k}": p.wait() for k, p, _ in procs}
+            status = "finished"
+        except BaseException as e:  # admission 거부·중단도 기록으로 남긴다
+            status, err = "failed", repr(e)
+            raise
+        finally:
+            for _, p, _ in procs:
+                if p.poll() is None:
+                    p.terminate()
+            for _, p, _ in procs:
+                p.wait()
+            for f in logs:
+                f.close()
+            save(out / f"launch_{attempt:03}.json", dict(status=status, error=err, codes=codes, wall_s=time.monotonic() - start,
+                                                          mapping={f"cure{k}": g for k, _, g in procs}, scientific_digest=sd, allowed=allowed,
+                                                          admission=admission, peak_mib=PEAK_MIB, script_sha256=sha(__file__)))
+        assert all(c == 0 for c in codes.values()), codes
+        if all((shard_dir(out, k) / "completion.json").exists() for k in jobs):
+            for k in jobs:
+                verify_completion(shard_dir(out, k), a.stage, k, a.workers, sd)
+            save(out / "completion.json", {"stage": a.stage, "workers": a.workers, "scientific_digest": sd,
+                                           "files": {f"cure/shard{k}/completion.json": sha(shard_dir(out, k) / "completion.json") for k in jobs}})
+            return 0
+        return 0 if a.limit else 2
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("command", choices=["worker", "launch", "lock_weights"])
+    p.add_argument("--stage", choices=STAGES)
+    p.add_argument("--out")
+    p.add_argument("--gpu")
+    p.add_argument("--shard", type=int, default=0)
+    p.add_argument("--nshards", type=int, default=1)
+    p.add_argument("--workers", type=int, default=1)
+    p.add_argument("--placement", default="", help="worker별 GPU 논리 index 쉼표 목록(허용 집합 안)")
+    p.add_argument("--limit", type=int, default=0, help="통제된 중단 시험용: 이번 실행 저장 최대 요청 수")
+    p.add_argument("--stagger", type=float, default=15.0)
+    a = p.parse_args()
+    if a.command == "lock_weights":
+        lk = make_weights_lock()
+        print(json.dumps({"weights": {k: v["sha256"] for k, v in lk["weights"].items()}}))
+        raise SystemExit(0)
+    raise SystemExit(worker(a) if a.command == "worker" else launch(a))
diff --git a/nr114_curecheck.py b/nr114_curecheck.py
new file mode 100644
index 0000000..ad773c1
--- /dev/null
+++ b/nr114_curecheck.py
@@ -0,0 +1,43 @@
+"""iter_114 CURE 개발 회귀: 새 경로(nr114_cure)의 T4 출력과 iter_107 M47 저장 출력의 입력 token·pixel hash·생성 token·parser 결과를 대조한다 (CPU).
+새 결과 파일 results/iter_114/dev/cure_regress.json (기존 파일 덮어쓰기 금지)."""
+import json
+import sys
+from pathlib import Path
+
+import nr107_spec as S
+import nr114_cure as C
+from report86_common import read_jsonl_complete, sha_obj
+
+OLD = C.ROOT / "results/iter_107/gen/M47/cure"
+
+
+def main(run):
+    out = C.ROOT / run
+    sd = sha_obj(C.scientific_protocol("T4", 2))
+    new = []
+    for s in (0, 1):
+        _, recs = C.verify_completion(C.shard_dir(out, s), "T4", s, 2, sd)
+        new += recs
+    old = {}
+    for s in (0, 1):
+        for r in read_jsonl_complete(OLD / f"shard{s}/outputs.jsonl"):
+            old[r["id"]] = r
+    rows = []
+    for r in new:
+        o = old[r["id"]]
+        pn = S.parse_pg(r["text"], r["attempts"][-1]["ended_eos"])
+        po = S.parse_pg(o["text"], o["attempts"][-1]["ended_eos"])
+        rows.append({"id": r["id"], "input_ids_equal": r["input_ids"] == o["input_ids"], "pixel_sha_equal": r["pixel_sha256"] == o["pixel_sha256"],
+                     "suffix_ids_equal": r["attempts"][-1]["suffix_ids"] == o["attempts"][-1]["suffix_ids"], "text_equal": r["text"] == o["text"],
+                     "parse_equal": pn == po, "status": pn["status"], "n_image_tokens": r["n_image_tokens"], "n_pixel_values": r["n_pixel_values"],
+                     "ended_eos": r["attempts"][-1]["ended_eos"], "n_attempts": len(r["attempts"])})
+    res = {"run": run, "n": len(rows), "all_equal": all(x["input_ids_equal"] and x["pixel_sha_equal"] and x["suffix_ids_equal"] and x["parse_equal"] for x in rows),
+           "rows": rows, "builder_vs_official_chat_template": "asserted inside nr114_cure.generate() for every request (processor.apply_chat_template tensors torch.equal)"}
+    p = C.R114 / "dev/cure_regress.json"
+    with p.open("x") as f:
+        json.dump(res, f, indent=1)
+    print(json.dumps(res, indent=1))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/nr114_curetests.py b/nr114_curetests.py
new file mode 100644
index 0000000..da7f880
--- /dev/null
+++ b/nr114_curetests.py
@@ -0,0 +1,116 @@
+"""iter_114 nr114_cure 실행 경로 실제 검사 (T4: 개발 4개 요청): 중단·재개(완료 행 보존)+손상 tail, 동시 launcher 거부, 요청 집합/digest 변조 거부, 허용 GPU 밖 배치 거부.
+결과 results/iter_114/tests/cure_runtime_checks.json (새 파일)."""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import nr114_cure as C
+from report86_common import sha_obj, read_jsonl_complete
+
+RES = {}
+PY = sys.executable
+BASE = ["launch", "--stage", "T4", "--workers", "1", "--placement", "0", "--stagger", "1"]
+
+
+def run(out, extra=()):
+    return subprocess.run([PY, str(C.ROOT / "nr114_cure.py")] + BASE + ["--out", out] + list(extra), cwd=C.ROOT, capture_output=True, text=True)
+
+
+def expect_fail(fn, label):
+    try:
+        fn()
+    except BaseException as e:
+        RES[label] = {"rejected": True, "error": repr(e)[:160]}
+        return
+    RES[label] = {"rejected": False}
+
+
+def main():
+    out = C.R114 / "cure/T4_resume"
+    p = run(str(out), ["--limit", "2"])
+    f = C.shard_dir(out, 0) / "outputs.jsonl"
+    rows1 = read_jsonl_complete(f)
+    RES["resume_part1"] = {"rc": p.returncode, "n_records": len(rows1), "completion_exists": (C.shard_dir(out, 0) / "completion.json").exists()}
+    with f.open("ab") as fh:
+        fh.write(b'{"id": "torn')
+    p = run(str(out))
+    partials = list(C.shard_dir(out, 0).glob("outputs.jsonl.partial.*"))
+    recs = read_jsonl_complete(f)
+    ref = {}
+    for s in (0, 1):
+        for r in read_jsonl_complete(C.R114 / f"cure/T4_w2/cure/shard{s}/outputs.jsonl"):
+            ref[r["id"]] = r
+    RES["resume_part2"] = {"rc": p.returncode, "n_partial_files": len(partials), "completion": (out / "completion.json").exists(), "n_records": len(recs),
+                          "first_rows_preserved": [r["record_digest"] for r in recs[:len(rows1)]] == [r["record_digest"] for r in rows1],
+                          "suffix_ids_equal_to_T4_w2": all(r["attempts"][-1]["suffix_ids"] == ref[r["id"]]["attempts"][-1]["suffix_ids"] for r in recs),
+                          "executions": sum(1 for l in (C.shard_dir(out, 0) / "executions.jsonl").read_text().splitlines() if '"start"' in l),
+                          "stderr_tail": p.stderr[-200:]}
+    # 동시 launcher
+    out2 = C.R114 / "cure/T4_concurrent"
+    cmd = [PY, str(C.ROOT / "nr114_cure.py")] + BASE + ["--out", str(out2)]
+    p1 = subprocess.Popen(cmd, cwd=C.ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    time.sleep(8)
+    p2 = subprocess.run(cmd, cwd=C.ROOT, capture_output=True, text=True)
+    p1.communicate()
+    RES["concurrent_launcher"] = {"second_rc": p2.returncode, "blocked": "BlockingIOError" in p2.stderr, "first_rc": p1.returncode,
+                                  "first_complete": (out2 / "completion.json").exists()}
+    # 변조
+    t = C.R114 / "cure/T4_tamper"
+    if t.exists():
+        shutil.rmtree(t)
+    shutil.copytree(out, t)
+    sd = sha_obj(C.scientific_protocol("T4", 1))
+    d = C.shard_dir(t, 0)
+    rows = (d / "outputs.jsonl").read_text().splitlines()
+
+    def write(r):
+        (d / "outputs.jsonl").write_text("\n".join(r) + "\n")
+
+    def verify():
+        c = json.loads((d / "completion.json").read_text())
+        c["files"]["outputs.jsonl"] = C.sha(d / "outputs.jsonl")
+        (d / "completion.json").write_text(json.dumps(c))
+        C.verify_completion(d, "T4", 0, 1, sd)
+
+    r0 = json.loads(rows[0])
+    r0["text"] = r0["text"] + " [0.1,0.1,0.2,0.2]"
+    write([json.dumps(r0)] + rows[1:])
+    expect_fail(verify, "tamper_text_edit")
+    write(rows[1:])
+    expect_fail(verify, "tamper_missing_request")
+    write(rows + [rows[0]])
+    expect_fail(verify, "tamper_duplicate")
+    r1 = json.loads(rows[1])
+    r1["id"] = "x|CURE|pg-f9"
+    r1["record_digest"] = C.record_digest(r1)
+    write(rows[:1] + [json.dumps(r1)] + rows[2:])
+    expect_fail(verify, "tamper_foreign_id")
+    r2 = json.loads(rows[2])
+    r2["protocol_digest"] = "f" * 64
+    r2["record_digest"] = C.record_digest(r2)
+    write(rows[:2] + [json.dumps(r2)] + rows[3:])
+    expect_fail(verify, "tamper_protocol_digest")
+    write(rows)
+    # 저장된 scientific protocol 의 source hash 변조 → worker 거부(모델 적재 전)
+    sp = json.loads((d / "scientific_protocol.json").read_text())
+    sp["scientific"]["source_sha256"]["pg43_run.py"] = "0" * 64
+    (d / "scientific_protocol.json").write_text(json.dumps(sp))
+    env = dict(os.environ)
+    env["CUDA_VISIBLE_DEVICES"] = "0,1"
+    pw = subprocess.run([str(C.CURE_PY), str(C.ROOT / "nr114_cure.py"), "worker", "--stage", "T4", "--out", str(t), "--gpu", "0", "--shard", "0", "--nshards", "1"],
+                        cwd=C.ROOT, capture_output=True, text=True, env=env)
+    RES["tamper_stored_protocol_source"] = {"rc": pw.returncode, "rejected_before_model_load": "protocol/source/shard mismatch" in pw.stderr}
+    p = subprocess.run([PY, str(C.ROOT / "nr114_cure.py"), "launch", "--stage", "T4", "--workers", "1", "--placement", "7", "--out", str(C.R114 / "cure/T4_badgpu")],
+                       cwd=C.ROOT, capture_output=True, text=True)
+    RES["placement_outside_allowed"] = {"rc": p.returncode, "rejected": "placement outside allowed" in p.stderr or "AssertionError" in p.stderr}
+    with (C.R114 / "tests/cure_runtime_checks.json").open("x") as fh:
+        json.dump(RES, fh, indent=1)
+    print(json.dumps(RES, indent=1))
+
+
+if __name__ == "__main__":
+    main()
