@@ -0,0 +1,87 @@
+"""iter_095 병렬 실행기. worker 수와 GPU 수를 분리하고, 각 worker 시작 직전에 실제 점유와 예약 합산을 다시 확인한다.
+
+plan.json: {"name", "jobs": [{"stage","shard","nshards","gpu"("auto"=허용 GPU 중 여유 최대),"out","resume"?,"extra"?}]}
+admission: (실제 사용 MiB, 시작 시점 외부 점유+실행 중 worker 예약 합) 중 큰 쪽 + worker peak + 2 GiB <= 장치 용량.
+ - 예약은 실행 중인 worker만 합산한다(끝난 worker 제외). 시작 직전 매번 nvidia-smi를 읽는다.
+ - 거부되면 해당 job은 시작하지 않고 기록한다(실행 중 worker는 건드리지 않는다).
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+from report95_common import ROOT, R95, CURE_PY, isolated_env, save, sha
+
+PEAK_MIB = 10100      # C worker 실측 nvidia-smi 점유(iter_086 D8 처리량 시험). Describe 출력 길이는 D8에서 재확인한다.
+MARGIN_MIB = 2048
+
+
+def smi():
+    q = subprocess.check_output(['nvidia-smi', '--query-gpu=index,memory.used,memory.total', '--format=csv,noheader,nounits'], text=True)
+    return {x.split(',')[0].strip(): (int(x.split(',')[1]), int(x.split(',')[2])) for x in q.splitlines()}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--plan', required=True)
+    ap.add_argument('--stagger', type=float, default=20.0)
+    a = ap.parse_args()
+    plan = json.loads(Path(a.plan).read_text())
+    allowed = os.environ['CUDA_VISIBLE_DEVICES'].split(',')
+    launch_dir = R95 / 'launches' / f"{plan['name']}_{time.time_ns()}"
+    launch_dir.mkdir(parents=True)
+    save(launch_dir / 'plan.json', plan)
+    env = isolated_env()
+    procs, log = [], []
+    t_launch = time.monotonic()
+    base = {g: v[0] for g, v in smi().items()}  # launcher 시작 시점의 외부 점유
+    for i, j in enumerate(plan['jobs']):
+        Path(j['out']).resolve().relative_to(R95)
+        s = smi()
+        live = [(k, jj, pp, t0) for k, jj, pp, t0, _ in procs if pp.poll() is None]
+
+        cand = allowed if j['gpu'] == 'auto' else [j['gpu']]
+        assert all(g in allowed for g in cand), f'gpu {cand} outside inherited allowed set {allowed}'
+        best = None
+        for g in cand:
+            used, total = s[g]
+            # 실행 중 worker는 적재 중이면 실제 점유에 아직 덜 반영돼 있다: 시작 시점 외부 점유(base)+실행 중 worker 예약합과 실측 중 큰 값.
+            young = sum(PEAK_MIB for _, jj, _, t0 in live if jj['_gpu'] == g)
+            commit = max(used, base[g] + young)
+            free = total - commit
+            if best is None or free > best[1]:
+                best = (g, free, used, total, young)
+        g, free, used, total, young = best
+        ok = free >= PEAK_MIB + MARGIN_MIB
+        log.append({'job': i, 'gpu': g, 'used_mib': used, 'live_reserved_mib': young, 'total_mib': total, 'need_mib': PEAK_MIB + MARGIN_MIB,
+                    'free_after_commit_mib': free, 'admit': ok})
+        if not ok:
+            save(launch_dir / f'admission_refused_job{i}.json', {'log': log})
+            print(json.dumps({'refused': j, 'log': log[-1]}))
+            continue
+        j = {**j, '_gpu': g}
+        cmd = [str(CURE_PY), str(ROOT / 'report95_gen.py'), '--stage', j['stage'], '--gpu', g, '--out', j['out'],
+               '--shard', str(j['shard']), '--nshards', str(j['nshards'])] + (['--resume'] if j.get('resume') else []) + j.get('extra', [])
+        so = (launch_dir / f'job{i}.stdout.log').open('x')
+        se = (launch_dir / f'job{i}.stderr.log').open('x')
+        procs.append((i, j, subprocess.Popen(cmd, cwd=ROOT, env=dict(env), stdout=so, stderr=se), time.monotonic(), cmd))
+        time.sleep(a.stagger)
+    with (launch_dir / 'resource.jsonl').open('x') as rf:
+        while any(p.poll() is None for _, _, p, _, _ in procs):
+            rf.write(json.dumps({'t': time.time(), 'smi': smi()}) + '\n')
+            rf.flush()
+            time.sleep(15)
+    rcs = {i: p.returncode for i, _, p, _, _ in procs}
+    res = {'plan': a.plan, 'plan_sha256': sha(a.plan), 'admission': log, 'returncodes': rcs, 'cmds': {i: c for i, _, _, _, c in procs},
+           'wall_s': time.monotonic() - t_launch, 'script_sha256': sha(__file__), 'n_jobs_planned': len(plan['jobs']),
+           'n_jobs_started': len(procs)}
+    save(launch_dir / 'launch_result.json', res)
+    print(json.dumps({'launch_dir': str(launch_dir), 'returncodes': rcs, 'wall_s': res['wall_s']}))
+    return 0 if all(v == 0 for v in rcs.values()) and len(rcs) == len(plan['jobs']) else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/report95_lock.py b/report95_lock.py
new file mode 100644
index 0000000..a0041d0
--- /dev/null
+++ b/report95_lock.py
@@ -0,0 +1,69 @@
+"""iter_095 reference 잠금 + 초기 32/나머지 64 선택. 새 Describe 출력 생성 전에 실행한다.
+
+규칙(출력·모델 조건과 무관하게 reference 문장만 사용; 이미 본 E96 개발 자료이며 사후 탐색 설계임을 기록):
+- 주 대상: 폐 opacity/infiltrate/consolidation 및 atelectasis. 임상적으로 동일 진단으로 합치지 않고 원 소견 종류 유지.
+- 현재 확정 양성: amendment v2_class가 pos_def/pos_temporal(현재 존재 포함)인 사실 중 label이 {infiltrates, consolidation,
+  atelectasis, laminar atelectasis}이거나 문장이 'pulmonary opacit'을 포함. temporal은 현재 존재만 평가(변화 정확도 아님).
+- 명시적 부재: v2_class가 neg_specific/neg_scoped이고 문장이 infiltrat|consolidat|opacit|condensat 중 하나를 부정.
+  generic_normal·normal_scoped(예: 'Pulmonary parenchyma within normal limits')는 명시적 부재로 쓰지 않는다.
+- 층: pos(최대12) / neg(최대10) / rest(10). 부족한 층은 전원, 남은 자리는 rest의 hash 순 미선택자로 채운다.
+- 환자 hash 순서: sha256(['report95', seed95017, ImageID]).
+"""
+import json
+import re
+
+from report95_common import R86, LOCK, ROOT, sha, sha_obj, save, hash_order
+
+SEED_LOCK = 95017
+TARGET_LABELS = {'infiltrates', 'consolidation', 'atelectasis', 'laminar atelectasis'}
+NEG_RE = re.compile(r'infiltrat|consolidat|opacit|condensat', re.I)
+
+
+def build():
+    facts = json.loads((R86 / 'E/reference_facts_E_private.json').read_text())
+    amend = json.loads((ROOT / 'results/iter_087/reference_amend_E96.json').read_text())['patients']
+    rows = json.loads((R86 / 'E/inputs_E96.json').read_text())
+    ids = [r['ImageID'] for r in rows]
+    layer, detail = {}, {}
+    for idx, img in enumerate(ids):
+        by = {f['fact_id']: f for f in facts[img]['facts']}
+        pos, neg = [], []
+        for af in amend[img]['facts']:
+            f = by[af['fact_id']]
+            cls, text = af['v2_class'], af['sentence_en']
+            if cls in ('pos_def', 'pos_temporal') and (set(f['labels']) & TARGET_LABELS or re.search(r'pulmonary opacit', text, re.I)):
+                pos.append({'fact_id': af['fact_id'], 'class': cls, 'sentence': text, 'labels': f['labels'], 'loc_req': af['loc_req'],
+                            'attr_req': af['attr_req']})
+            if cls in ('neg_specific', 'neg_scoped') and NEG_RE.search(text):
+                neg.append({'fact_id': af['fact_id'], 'class': cls, 'sentence': text})
+        layer[img] = 'pos' if pos else ('neg' if neg else 'rest')
+        detail[img] = {'patient_index': idx, 'layer': layer[img], 'pos_facts': pos, 'neg_facts': neg}
+    pos_ids = hash_order([i for i in ids if layer[i] == 'pos'], ['report95', SEED_LOCK])
+    neg_ids = hash_order([i for i in ids if layer[i] == 'neg'], ['report95', SEED_LOCK])
+    rest_ids = hash_order([i for i in ids if layer[i] == 'rest'], ['report95', SEED_LOCK])
+    p, n = pos_ids[:12], neg_ids[:10]
+    r = rest_ids[:10]
+    short = 32 - len(p) - len(n) - len(r)
+    r = rest_ids[:10 + max(short, 0)]
+    # 양성/음성 층이 12/10을 넘어 남는 환자는 나머지 64로 이동(여기서는 해당 없음)
+    e32 = p + n + r
+    assert len(e32) == 32 and len(set(e32)) == 32
+    e64 = [i for i in ids if i not in set(e32)]
+    sel = {'seed': SEED_LOCK, 'E32': e32, 'E64': e64,
+           'strata_counts_E96': {k: sum(v == k for v in layer.values()) for k in ('pos', 'neg', 'rest')},
+           'E32_strata': {'pos': len(p), 'neg': len(n), 'rest': len(r)},
+           'E64_remaining_strata': {k: sum(layer[i] == k for i in e64) for k in ('pos', 'neg', 'rest')},
+           'opportunity_note': '남은 64명에는 reference 지지 양성/명시적 부재 평가 기회가 각각 이 수만큼만 있다.',
+           'inputs_E96_sha256': sha(R86 / 'E/inputs_E96.json'),
+           'reference_amend_sha256': sha(ROOT / 'results/iter_087/reference_amend_E96.json'),
+           'reference_facts_sha256': sha(R86 / 'E/reference_facts_E_private.json'),
+           'code_sha256': sha(__file__), 'status': '출력 생성 전 잠금. 이미 본 E96 개발 자료의 사후 탐색 설계(독립 확인 아님).'}
+    return sel, detail
+
+
+if __name__ == '__main__':
+    sel, detail = build()
+    save(LOCK / 'reference_target.json', detail)
+    sel['reference_target_sha256'] = sha(LOCK / 'reference_target.json')
+    save(LOCK / 'selection.json', sel)
+    print(json.dumps({k: sel[k] for k in ('strata_counts_E96', 'E32_strata', 'E64_remaining_strata')}))
diff --git a/report95_resume_test.py b/report95_resume_test.py
new file mode 100644
index 0000000..08c0807
--- /dev/null
+++ b/report95_resume_test.py
@@ -0,0 +1,56 @@
+"""iter_095 실제 wrapper의 통제된 중단·재개 시험 (D8, 1 worker, 16요청).
+1) --limit 6으로 정상 중단(저장 후 종료)  2) torn tail 행을 붙인 뒤 --resume  3) 완료 후 재실행(덮어쓰기·추가 저장 없음)
+4) 같은 out를 --resume 없이 시작하면 거부. 기준: D8/w4 출력과 token/입력 동일. 결과는 tests/resume_result.json(새 파일)."""
+import json
+import os
+import subprocess
+import sys
+
+from report95_common import ROOT, R95, CURE_PY, isolated_env, sha, save, read_jsonl_complete
+
+OUT = R95 / 'D8/resume/shard0'
+
+
+def run(args):
+    env = isolated_env()
+    env['CUDA_VISIBLE_DEVICES'] = os.environ['CUDA_VISIBLE_DEVICES']
+    return subprocess.run([str(CURE_PY), str(ROOT / 'report95_gen.py'), '--stage', 'D8', '--gpu', sys.argv[1], '--out', str(OUT),
+                           '--shard', '0', '--nshards', '1'] + args, cwd=ROOT, env=env, capture_output=True, text=True)
+
+
+def main():
+    res = {}
+    r1 = run(['--limit', '6'])
+    n1 = len(read_jsonl_complete(OUT / 'outputs.jsonl'))
+    res['step1_limit6'] = {'rc': r1.returncode, 'n_saved': n1, 'completion_exists': (OUT / 'completion.json').exists()}
+    with (OUT / 'outputs.jsonl').open('a') as f:
+        f.write('{"id": "partial-torn-row')
+    r2 = run(['--resume'])
+    recs = read_jsonl_complete(OUT / 'outputs.jsonl')
+    res['step2_resume'] = {'rc': r2.returncode, 'n_complete': len(recs), 'completion_exists': (OUT / 'completion.json').exists(),
+                           'stderr_tail': r2.stderr[-200:]}
+    before = {f: sha(OUT / f) for f in ('outputs.jsonl', 'completion.json')}
+    r3 = run(['--resume'])
+    after = {f: sha(OUT / f) for f in ('outputs.jsonl', 'completion.json')}
+    res['step3_rerun_completed'] = {'rc': r3.returncode, 'unchanged': before == after}
+    r4 = run([])
+    res['step4_no_resume_refused'] = {'rc': r4.returncode, 'refused': r4.returncode != 0 and 'FileExistsError' in r4.stderr}
+    # 비교: w4 기준 출력
+    ref = {}
+    for s in (R95 / 'D8/w4').glob('shard*'):
+        for r in read_jsonl_complete(s / 'outputs.jsonl'):
+            ref[r['id']] = r
+    diff = [r['id'] for r in recs if r['attempts'][-1]['suffix_ids'] != ref[r['id']]['attempts'][-1]['suffix_ids']
+            or r['input_ids'] != ref[r['id']]['input_ids']]
+    res['compare_to_w4'] = {'n': len(recs), 'n_ids_equal_set': {r['id'] for r in recs} == set(ref), 'n_mismatch': len(diff), 'mismatch': diff,
+                            'ids_unique': len({r['id'] for r in recs}) == len(recs)}
+    res['all_pass'] = (res['step1_limit6']['rc'] == 0 and n1 == 6 and not res['step1_limit6']['completion_exists']
+                       and res['step2_resume']['rc'] == 0 and res['step2_resume']['n_complete'] == 16 and res['step2_resume']['completion_exists']
+                       and res['step3_rerun_completed']['unchanged'] and res['step4_no_resume_refused']['refused']
+                       and not diff and res['compare_to_w4']['ids_unique'])
+    save(R95 / 'tests/resume_result.json', res)
+    print(json.dumps(res, indent=1))
+
+
+if __name__ == '__main__':
+    main()
