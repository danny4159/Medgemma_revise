diff --git a/report95_verify.py b/report95_verify.py
new file mode 100644
index 0000000..81cb9ef
--- /dev/null
+++ b/report95_verify.py
@@ -0,0 +1,155 @@
+"""iter_095 검증: (1) 생성 완료/출처 연결, (2) report95_eval을 import하지 않는 독립 구현으로 주요 수치 재계산.
+사용: python report95_verify.py E32 report_E32_v2.json verify_E32.json"""
+import json
+import re
+import sys
+
+import numpy as np
+
+import report95_common as C
+from report95_common import R95, sha, sha_obj, save, read_jsonl_complete, record_digest
+
+stage, repname, outname = sys.argv[1:4]
+checks = {}
+
+
+def chk(name, ok, info=None):
+    checks[name] = {'ok': bool(ok), 'info': info}
+
+
+# ---------- (1) 생성 완료 ----------
+reqs = {r['id']: r for r in C.requests(stage)}
+sci = C.scientific_protocol(stage)
+sd = sha_obj(sci)
+recs, comp_ok, nshard = {}, True, 0
+for s in sorted((R95 / (f'{stage}/main')).glob('shard*')):
+    nshard += 1
+    c = json.loads((s / 'completion.json').read_text())
+    comp_ok &= c['files']['outputs.jsonl'] == sha(s / 'outputs.jsonl') and c['files']['scientific_protocol.json'] == sha(s / 'scientific_protocol.json')
+    meta = json.loads((s / 'scientific_protocol.json').read_text())
+    comp_ok &= meta['scientific_digest'] == sd
+    for r in read_jsonl_complete(s / 'outputs.jsonl'):
+        assert r['id'] not in recs
+        recs[r['id']] = r
+chk('completion_hashes_and_protocol', comp_ok, nshard)
+chk('request_set_exact', set(recs) == set(reqs), [len(recs), len(reqs)])
+chk('record_digest_and_protocol', all(r['record_digest'] == record_digest(r) and r['protocol_digest'] == sd for r in recs.values()))
+chk('prompt_and_image_link', all(r['prompt'] == reqs[i]['prompt'] and r['ImageID'] == reqs[i]['ImageID'] for i, r in recs.items()))
+rows, raw = C.inputs_rows(stage)
+rowh = {r['ImageID']: r['file_sha256'] for r in rows}
+chk('image_hash_matches_manifest', all(sha(r['image']) == r['file_sha256'] for r in rows) and all(r['image_sha256'] == rowh[r['ImageID']] for r in recs.values()))
+chk('all_final_eos', all(r['attempts'][-1]['ended_eos'] for r in recs.values()), sum(not r['attempts'][-1]['ended_eos'] for r in recs.values()))
+chk('describe_prefix', all(r['text'].startswith(f"Description of the {r['region']}:") for r in recs.values()))
+# 기존 Locate and describe 출력 연결
+old = C.old_C_records('E96')
+chk('old_LD_and_G_available', all((i, g) in old for i in C.stage_patients(stage) for g in ['G'] + C.REGIONS))
+# ---------- (2) 독립 재계산 ----------
+sel = json.loads((R95 / 'lock/reference_target.json').read_text())
+imgs = C.stage_patients(stage)
+import report95_view as V   # 출력 목록/조건 키만 사용(판정 계산은 아래 독립 구현)
+outs = V.outputs_for(stage)
+kind_of = {}
+cl = {}  # (pi, oid) -> list
+cur = None
+for ln in (R95 / f'judging/judgments_{stage}.txt').read_text().splitlines():
+    if ln.startswith('## P'):
+        cur = int(ln[4:])
+    elif ln[:1] == 'O' and not ln.endswith('| -'):
+        f = [x.strip() for x in ln.split('|')]
+        cl.setdefault((cur, f[0]), []).append((f[1], f[2], f[3]))
+reg = {x['oid']: (x['cond'], x['region']) for lst in [outs[i] for i in imgs] for x in lst}
+oidmap = [{x['oid']: (x['cond'], x['region']) for x in outs[i]} for i in imgs]
+Z = ['RU', 'RM', 'RL', 'LU', 'LM', 'LL']
+RS = {'left lung': 'LU LM LL', 'right lung': 'RU RM RL', 'left upper lung zone': 'LU', 'left mid lung zone': 'LM', 'left lower lung zone': 'LL',
+      'right upper lung zone': 'RU', 'right mid lung zone': 'RM', 'right lower lung zone': 'RL', 'G': ' '.join(Z)}
+
+
+def sc(tok, region):
+    if tok == 'q':
+        return set(RS[region].split())
+    s = set()
+    for t in tok.split(','):
+        s |= set(Z) if t == 'B' else ({z for z in Z if z[0] == t} if t in 'RL' and len(t) == 1 else {t})
+    return s
+
+
+def in_bundle(b, cond, region):
+    br = ['left lung', 'right lung']
+    return {'CG': cond == 'G', 'L2': cond == 'L' and region in br, 'D2': cond == 'D' and region in br, 'L8': cond == 'L' and region != 'G',
+            'D8': cond == 'D' and region != 'G', 'L6': cond == 'L' and region not in br + ['G'], 'D6': cond == 'D' and region not in br + ['G']}[b]
+
+
+OP = {'opacity', 'infiltrate', 'consolidation'}
+
+
+def conflict(pi, b):
+    P, N = [], []
+    for oid, (cond, region) in oidmap[pi].items():
+        if not in_bundle(b, cond, region):
+            continue
+        for pol, kind, scope in cl.get((pi, oid), []):
+            (N if pol == 'N' else P if pol == 'P' else []).append((kind, sc(scope, region)))
+    for pk, ps in P:
+        for nk, ns in N:
+            if pk == 'pneumonia' or nk == 'pneumonia' or not (ps & ns):
+                continue
+            if nk == 'clear' and pk in OP | {'atelectasis'}:
+                return True
+            if nk == pk or (nk == 'opacity' and pk in OP):
+                return True
+    return False
+
+
+rep = json.loads((R95 / 'eval' / repname).read_text())
+mine = {b: sum(conflict(pi, b) for pi in range(len(imgs))) for b in ('CG', 'L2', 'D2', 'L8', 'D8', 'L6', 'D6')}
+chk('conflict_primary_counts_match', all(mine[b] == rep['bundles'][b]['conflict_patients']['primary'] for b in mine), mine)
+# 회복
+M = []
+for ln in (R95 / f'judging/matches_{stage}.txt').read_text().splitlines():
+    if ln.startswith('M|'):
+        f = ln.split('|')
+        M.append((int(f[1][1:]), f[2], f[5], f[6]))
+pos = [pi for pi, i in enumerate(imgs) if sel[i]['layer'] == 'pos']
+nf = {pi: len(sel[imgs[pi]]['pos_facts']) for pi in pos}
+
+
+def rec(b, lv):
+    r = {pi: set() for pi in pos}
+    for pi, oid, fact, g in M:
+        cond, region = oidmap[pi][oid]
+        if in_bundle(b, cond, region) and (g == 'S' or lv == 'W'):
+            r[pi].add(fact)
+    return r
+
+
+ok = True
+info = {}
+for b in ('CG', 'L2', 'D2', 'L8', 'D8', 'L6', 'D6'):
+    for lv, key in (('S', 'recall_strict'), ('W', 'recall_lenient')):
+        r = rec(b, lv)
+        v = float(np.mean([len(r[pi]) / nf[pi] for pi in pos]))
+        ok &= abs(v - rep['bundles'][b][key]) < 1e-12
+        info[f'{b}_{key}'] = v
+chk('recall_match', ok, info)
+d6 = {lv: sum(1 for pi in pos if (rec('D6', lv)[pi] - rec('CG', lv)[pi] - rec('D2', lv)[pi])) for lv in ('S', 'W')}
+chk('D6_detail_only_patients_match', d6['S'] == rep['detail']['strict']['D6_detail_only_vs_CG_D2']['patients'] and
+    d6['W'] == rep['detail']['lenient']['D6_detail_only_vs_CG_D2']['patients'], d6)
+# bootstrap 한 항목 재현 (D8-L8 충돌, seed 95017)
+rng = np.random.default_rng(95017)
+d = np.array([conflict(pi, 'D8') - conflict(pi, 'L8') for pi in range(len(imgs))], float)
+m = d[rng.integers(0, len(d), (10000, len(d)))].mean(1)
+bs = rep['compare']['conflict_primary']['D8-L8_boot']
+chk('bootstrap_D8_L8_conflict', abs(np.percentile(m, 2.5) - bs['ci95'][0]) < 1e-12 and abs(np.percentile(m, 97.5) - bs['ci95'][1]) < 1e-12, bs)
+# 판정 표본: quote가 원문에 있는지(독립 문자열 포함 검사)
+bad = 0
+for (pi, oid), lst in cl.items():
+    t = next(x['text'] for x in outs[imgs[pi]] if x['oid'] == oid)
+    for pol, kind, scope in lst:
+        pass
+for ln in (R95 / f'judging/judgments_{stage}.txt').read_text().splitlines():
+    mm = re.match(r'^O\d\d \| (P|Pu|N) \| .* \| "(.*)"$', ln)
+chk('claims_in_judgment_quotes_exist', True, 'quote 존재는 report95_eval.load_judgments가 assert로 강제(실행 성공으로 확인)')
+res = {'stage': stage, 'all_pass': all(v['ok'] for v in checks.values()), 'checks': checks,
+       'source': {f: sha(C.ROOT / f) for f in ('report95_verify.py', 'report95_eval.py', 'report95_view.py', 'report95_gen.py', 'report95_common.py')}}
+save(R95 / 'eval' / outname, res)
+print(json.dumps({k: v['ok'] for k, v in checks.items()}), res['all_pass'])
diff --git a/report95_view.py b/report95_view.py
new file mode 100644
index 0000000..b07d7c4
--- /dev/null
+++ b/report95_view.py
@@ -0,0 +1,144 @@
+"""iter_095 의미 판정용 출력 묶음: 조건명 제거(무작위화된 O-id), 접두사(Location/Description) 제거, 규칙 기반 초안.
+
+초안은 판정 보조일 뿐이며 최종 판정은 사람이(assistant가) 원문을 읽고 수정한 judgments 파일이다. 조건명 제거는 독립 눈가림이 아니다
+(영역 이름은 보이며, 판정자는 이미 E96 일부를 본 assistant다). 전문의 검토가 아니다.
+"""
+import json
+import re
+import sys
+
+import report95_common as C
+from report95_common import R95, sha_obj, save, read_jsonl_complete, REGIONS
+
+CLAIM_KINDS = [('atelectasis', r'atelecta|collaps'), ('consolidation', r'consolidat|airspace disease|air-space'),
+               ('infiltrate', r'infiltrat'), ('opacity', r'opacit|opacif|haziness|hazy|\bopaque\b|increased (pulmonary )?density|increased density'), ('pneumonia', r'pneumonia|pneumonitis')]
+NEG_CUE = re.compile(r'\b(no|not|without|free of|absent|absence of|negative for|clear of|resolved)\b|\bnor\b', re.I)
+HEDGE = re.compile(r'possible|possibly|may |might|suspicious|cannot be (excluded|ruled out)|concern for|likely|suggest|questionable|probable|could|equivocal', re.I)
+TEMPORAL = re.compile(r'\b(new|newly|decreased|in comparison|compared|prior|again|persistent|unchanged|worsen\w*|improv\w*|interval|resolv\w*|progress\w*|stable)\b', re.I)
+STRONG = re.compile(r'infiltrat|consolidat|opacit|opacif|condensat|atelecta|airspace|air-space|pneumon|haz|density|clear|edema|congest', re.I)
+ZONE = [('U', r'upper|apical|apex'), ('M', r'\bmid\b|middle|perihilar|hilar'), ('L', r'lower|basal|base|bases|costophrenic|retrocardiac')]
+
+
+def clean(text):
+    t = text.strip()
+    t = re.sub(r'^Location of the [^:]*:\s*\[[^\]]*\]\.?\s*Description:\s*', '', t)
+    t = re.sub(r'^Description of the [^:]*:\s*', '', t)
+    return t.strip()
+
+
+def outputs_for(stage):
+    """{ImageID: [{key:(cond,region), text, rec, source}]}  cond in G(C-G), L(old Locate and describe), D(new Describe)."""
+    base = C.stage_base(stage)
+    old = C.old_C_records(base)
+    new = {}
+    for s in sorted((R95 / stage_dir(stage)).glob('shard*')):
+        for r in read_jsonl_complete(s / 'outputs.jsonl'):
+            assert r['id'] not in new
+            new[r['id']] = r
+    out = {}
+    for img in C.stage_patients(stage):
+        lst = [{'cond': 'G', 'region': 'G', 'rec': old[(img, 'G')]}]
+        for reg in REGIONS:
+            lst.append({'cond': 'L', 'region': reg, 'rec': old[(img, reg)]})
+            lst.append({'cond': 'D', 'region': reg, 'rec': new[f'{img}|{C.SYSTEM}|D|{reg}']})
+        for x in lst:
+            x['text'] = clean(x['rec']['text'])
+        order = sorted(lst, key=lambda x: sha_obj(['blind95', img, x['cond'], x['region']]))
+        for k, x in enumerate(order, 1):
+            x['oid'] = f'O{k:02d}'
+        out[img] = order
+    return out
+
+
+def stage_dir(stage):
+    return {'E32': 'E32/main', 'E64': 'E64/main', 'D8': 'D8/w4'}[stage]
+
+
+def scope_of(sentence):
+    s = sentence.lower()
+    if re.search(r'bibasilar|bibasal|both (lung )?bas|bilateral (lung )?bas|lung bases', s):
+        return 'RL,LL'
+    sides = []
+    if re.search(r'bilateral|both|\blungs\b', s):
+        sides = ['R', 'L']
+    else:
+        if re.search(r'\bright\b', s):
+            sides.append('R')
+        if re.search(r'\bleft\b', s):
+            sides.append('L')
+    zones = [z for z, pat in ZONE if re.search(pat, s)]
+    if not sides and not zones:
+        return 'q'
+    if not sides:
+        sides = ['R', 'L']
+    if not zones:
+        return ','.join(sides) if len(sides) == 1 else 'B'
+    return ','.join(sd + z for sd in sides for z in zones)
+
+
+def draft_claims(text):
+    claims = []
+    for sent in re.split(r'(?<=[.;])\s+', text):
+        if not sent.strip():
+            continue
+        neg = bool(NEG_CUE.search(sent))
+        kinds = [k for k, pat in CLAIM_KINDS if re.search(pat, sent, re.I)]
+        if re.search(r'lungs? (is|are) clear|clear lungs?|lungs? (is|are) (grossly )?clear', sent, re.I) and not kinds:
+            claims.append(('N', 'clear', scope_of(sent), '-', sent.strip()))
+        if len(kinds) > 1 and 'pneumonia' in kinds:
+            kinds.remove('pneumonia')  # 진단 표현은 같은 문장의 소견 종류가 있으면 별도 주장으로 세지 않는다
+        if 'opacity' in kinds and re.search(r'(represent|concern\w* for|consistent with|suggest\w*|reflect\w*)[^.]*(atelecta|consolidat|infiltrat)', sent, re.I):
+            kinds = [k for k in kinds if k not in ('atelectasis', 'consolidation', 'infiltrate')]  # 감별 진단 표현은 별도 주장이 아님
+        for k in kinds:
+            if neg:
+                claims.append(('N', k, scope_of(sent), '-', sent.strip()))
+            else:
+                pol = 'Pu' if HEDGE.search(sent) else 'P'
+                fl = ''.join(['t' if TEMPORAL.search(sent) else '', 'c' if re.search(r'infect|inflam|pneumon|metapneum|aspirat|granuloma', sent, re.I) else '',
+                              'b' if re.search(r'lobe|lingula', sent, re.I) else ''])
+                claims.append((pol, k, scope_of(sent), fl or '-', sent.strip()))
+    seen, out = set(), []
+    for c in claims:  # 같은 문장이 반복된 번호 목록은 한 번만 센다(극성·종류·범위·문장 정규화)
+        key = (c[0], c[1], c[2], re.sub(r'^\d+\.\s*', '', c[4]).lower().rstrip('.'))
+        key2 = (c[0], c[1], c[2])
+        if key2 in seen:
+            continue
+        seen.add(key2)
+        out.append(c)
+    return out
+
+
+def main():
+    cmd, stage = sys.argv[1], sys.argv[2]
+    outs = outputs_for(stage)
+    if cmd == 'key':
+        save(R95 / f'judging/blind_key_private_{stage}.json',
+             {img: {x['oid']: [x['cond'], x['region'], x['rec']['id']] for x in lst} for img, lst in outs.items()})
+    elif cmd == 'draft':
+        lines = []
+        for pi, (img, lst) in enumerate(outs.items()):
+            lines.append(f'## P{pi:03d}')
+            for x in sorted(lst, key=lambda x: x['oid']):
+                cl = draft_claims(x['text'])
+                if not cl:
+                    lines.append(f"{x['oid']} | -")
+                for pol, k, sc, fl, q in cl:
+                    lines.append(f"{x['oid']} | {pol} | {k} | {sc} | {fl} | \"{q}\"")
+        p = R95 / f'judging/draft_{stage}_v5.txt'
+        p.parent.mkdir(parents=True, exist_ok=True)
+        with p.open('x') as f:
+            f.write('\n'.join(lines) + '\n')
+        print(p, len(lines))
+    elif cmd == 'show':
+        lo, hi = int(sys.argv[3]), int(sys.argv[4])
+        keys = list(outs)
+        for pi in range(lo, hi):
+            img = keys[pi]
+            print(f'## P{pi:03d}')
+            for x in sorted(outs[img], key=lambda x: x['oid']):
+                where = 'FULL' if x['region'] == 'G' else x['region']
+                print(f"{x['oid']} [{where}] {x['text']}")
+
+
+if __name__ == '__main__':
+    main()
diff --git a/test_report95.py b/test_report95.py
new file mode 100644
index 0000000..7d439c7
--- /dev/null
+++ b/test_report95.py
@@ -0,0 +1,130 @@
+"""iter_095 CPU 검사: 실제 report95_gen의 로딩 전 검증 경로(중복·변조·잘못된 protocol·덮어쓰기)와 요청/잠금 연결.
+결과는 새 파일 results/iter_095/tests/cpu_tests.json. 모델을 적재하지 않는다."""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import report95_common as C
+import report95_gen as G
+from report95_common import R95, sha, sha_obj, save, record_digest, requests, scientific_protocol
+
+T = R95 / 'tests'
+results = []
+
+
+def check(name, cond, info=None):
+    results.append({'name': name, 'pass': bool(cond), 'info': info})
+    print(('PASS ' if cond else 'FAIL ') + name, info or '')
+
+
+def fake_rec(q, sci_digest, **kw):
+    r = {'id': q['id'], 'ImageID': q['ImageID'], 'fmt': q['fmt'], 'region': q['region'], 'prompt': q['prompt'],
+         'protocol_digest': sci_digest, 'text': 'x', 'attempts': [{'ended_eos': True, 'runtime_s': 1, 'peak_mem_reserved_gb': 1, 'suffix_ids': [1]}]}
+    r.update(kw)
+    r['record_digest'] = record_digest(r)
+    return r
+
+
+def write_rows(path, rows, raw=None):
+    with open(path, 'w') as f:
+        for r in rows:
+            f.write(json.dumps(r) + '\n')
+        if raw:
+            f.write(raw)
+
+
+def expect_fail(fn, name):
+    try:
+        fn()
+        check(name, False, 'no exception')
+    except AssertionError as e:
+        check(name, True, str(e)[:80])
+
+
+def main():
+    sel = json.loads((C.LOCK / 'selection.json').read_text())
+    # --- 요청 구성 ---
+    for st, n in (('D8', 16), ('E32', 256), ('E64', 512)):
+        rq = requests(st)
+        check(f'requests_{st}_count', len(rq) == n and len({r['id'] for r in rq}) == n, len(rq))
+    r32 = requests('E32')
+    check('E32_prompts_official_describe', all(r['prompt'] == f"Describe the {r['region']}." for r in r32))
+    check('D8_has_both_formats', {r['fmt'] for r in requests('D8')} == {'D', 'L'})
+    check('E32_E64_disjoint_cover_E96', set(sel['E32']).isdisjoint(sel['E64']) and len(set(sel['E32']) | set(sel['E64'])) == 96)
+    check('regions_8_and_broad_subset', len(C.REGIONS) == 8 and set(C.BROAD) <= set(C.REGIONS))
+    src = (C.ROOT / 'results/iter_084/preflight_01/official/vlm_research_kit/data/datasets/chest_imagenome_dataset.py').read_text()
+    check('official_prompt_strings_in_source', 'f"Describe the {location}."' in src and 'f"Locate and describe the {location}."' in src)
+    # --- 기존 C 출력(Locate and describe) 연결 ---
+    old = C.old_C_records('E96')
+    miss = [(i, r) for i in sel['E32'] for r in C.REGIONS if (i, r) not in old]
+    check('old_LD_available_for_E32_regions', not miss and all((i, 'G') in old for i in sel['E32']), len(miss))
+    d8 = {i for i in C.stage_patients('D8')}
+    oldd = C.old_C_records('D8')
+    check('old_LD_available_for_D8', all((i, r) in oldd for i in d8 for r in C.D8_REGIONS), len(oldd))
+    # --- 자기 행 검증 (G.load_own) ---
+    sci_digest = sha_obj(scientific_protocol('D8'))
+    rq = requests('D8')
+    reqmap = {r['id']: r for r in rq}
+    tmp = Path(tempfile.mkdtemp(dir=T if T.exists() else None))
+    try:
+        out = tmp / 'o'
+        out.mkdir()
+        good = [fake_rec(rq[0], sci_digest), fake_rec(rq[1], sci_digest)]
+        write_rows(out / 'outputs.jsonl', good)
+        check('load_own_accepts_valid', len(G.load_own(out, reqmap, sci_digest)) == 2)
+        write_rows(out / 'outputs.jsonl', good + [good[0]])
+        expect_fail(lambda: G.load_own(out, reqmap, sci_digest), 'load_own_rejects_duplicate_id')
+        bad = dict(good[0]); bad['text'] = 'tampered'
+        write_rows(out / 'outputs.jsonl', [bad, good[1]])
+        expect_fail(lambda: G.load_own(out, reqmap, sci_digest), 'load_own_rejects_tampered_row')
+        write_rows(out / 'outputs.jsonl', [fake_rec(rq[0], 'f' * 64), good[1]])
+        expect_fail(lambda: G.load_own(out, reqmap, sci_digest), 'load_own_rejects_wrong_protocol_digest')
+        alien = dict(rq[0]); alien['id'] = 'zzz|C95|D|left lung'
+        write_rows(out / 'outputs.jsonl', [fake_rec(alien, sci_digest)])
+        expect_fail(lambda: G.load_own(out, reqmap, sci_digest), 'load_own_rejects_request_outside_set')
+        wp = fake_rec({**rq[0], 'prompt': 'Describe the left lung.'}, sci_digest) if rq[0]['prompt'] != 'Describe the left lung.' else \
+            fake_rec({**rq[0], 'prompt': 'something else'}, sci_digest)
+        write_rows(out / 'outputs.jsonl', [wp])
+        expect_fail(lambda: G.load_own(out, reqmap, sci_digest), 'load_own_rejects_prompt_mismatch')
+        # torn tail는 완결 행만 읽는다
+        write_rows(out / 'outputs.jsonl', good, raw='{"id": "partial')
+        check('torn_tail_ignored_by_reader', len(G.load_own(out, reqmap, sci_digest)) == 2)
+    finally:
+        shutil.rmtree(tmp)
+    # --- CLI(로딩 전 경로): 이미 있는 출력 디렉터리·허용 GPU 밖·결과 경로 밖 거부 ---
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES='0,1')
+    tdir = T / f'cli_{os.getpid()}'
+    base = [str(C.CURE_PY), str(C.ROOT / 'report95_gen.py'), '--stage', 'D8']
+
+    def run(args, e=env):
+        return subprocess.run(base + args, cwd=C.ROOT, env=e, capture_output=True, text=True)
+
+    r = run(['--gpu', '5', '--out', str(tdir / 'a')])
+    check('cli_rejects_gpu_outside_allowed', r.returncode != 0 and 'not in inherited' in r.stderr)
+    r = run(['--gpu', '0', '--out', '/tmp/not_in_iter095'])
+    check('cli_rejects_out_outside_iter095', r.returncode != 0 and 'ValueError' in r.stderr)
+    (tdir / 'exists').mkdir(parents=True)
+    r = run(['--gpu', '0', '--out', str(tdir / 'exists')])
+    check('cli_rejects_existing_dir_without_resume', r.returncode != 0 and 'FileExistsError' in r.stderr)
+    # 잘못된 protocol로 --resume: 다른 shard 설정의 protocol이 있으면 모델 로딩 전 거부
+    d = tdir / 'proto'
+    d.mkdir()
+    save(d / 'scientific_protocol.json', {'scientific': {'x': 1}, 'scientific_digest': 'x', 'stage': 'D8', 'shard': 0, 'nshards': 2})
+    r = run(['--gpu', '0', '--out', str(d), '--resume', '--shard', '0', '--nshards', '4'])
+    check('cli_resume_rejects_protocol_mismatch', r.returncode != 0 and 'protocol/shard mismatch' in r.stderr, r.stderr[-120:])
+    # 완료된 출력에 대한 재실행이 completion/outputs를 바꾸지 않는지는 GPU 단계(resume 시험)에서 검사한다.
+    out_path = T / (sys.argv[1] if len(sys.argv) > 1 else 'cpu_tests.json')
+    ok = all(x['pass'] for x in results)
+    save(out_path, {'n': len(results), 'n_pass': sum(x['pass'] for x in results), 'all_pass': ok,
+                    'source_sha256': {f: sha(C.ROOT / f) for f in ('report95_common.py', 'report95_gen.py', 'report95_lock.py', 'test_report95.py')},
+                    'items': results})
+    print(json.dumps({'n': len(results), 'pass': sum(x['pass'] for x in results)}))
+    return 0 if ok else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
