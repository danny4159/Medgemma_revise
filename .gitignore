hf_cache/

# --- 임시 제외 (MedGemma 평가 작업 산출물) ------------------------------------
# 나중에 커밋하기로 하면 아래 블록을 통째로 지우면 된다.
# 주의: .gitignore는 줄 끝 주석을 지원하지 않으므로 설명은 별도 줄에 둔다.

# 데이터 수집 · 평가 · 진단 · 공식형식 재검증 · 해법 검증 스크립트
scripts/

# 정리 문서 (MEDGEMMA_*.txt)
docs/

# 내려받은 샘플 데이터와 생성된 2D 슬라이스 이미지
eval_samples/

# 전 실험 원본 출력(jsonl/json), 로그, 생성된 png (마커·노이즈 영상 등)
eval_results/

# 파이썬 부산물
__pycache__/
*.pyc
# -----------------------------------------------------------------------------

# 알림 봇 토큰 (비밀)
agent/.notify.env
