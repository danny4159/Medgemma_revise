hf_cache/

# --- legacy/: 오케스트레이터 이전에 Claude와 대화하며 진행한 MedGemma 한계 분석 기록 ---
# 코드·문서·수치 결과(json/jsonl/log)는 추적한다.
# 주의: .gitignore는 줄 끝 주석을 지원하지 않으므로 설명은 별도 줄에 둔다.

# 내려받은 샘플 데이터와 생성된 2D 슬라이스 이미지 (77MB)
legacy/eval_samples/

# 실험 중 생성된 이미지 (마커·노이즈 영상 등, 장당 수 MB)
legacy/eval_results/**/*.png

# --- research/: 오케스트레이터 연구 코드. 자체 git 저장소로 브랜치를 관리한다 ---
research/

# 파이썬 부산물
__pycache__/
*.pyc

# 알림 봇 토큰 (비밀)
agent/.notify.env

# --- agent/runs: 연구 기록 중 원본 로그 (반복당 수백 KB) ---
# 서버에는 남기고, git에는 계획·보고서·리뷰·결정 같은 요약 파일만 올린다.
agent/runs/**/*_codex.log
agent/runs/**/claude_stream.jsonl
agent/runs/**/snapshot_before.json
agent/runs/**/*.raw.json
agent/STOP
